card singleFaced({
    name = "Curse of Vengeance",
    cost = [pip(black)],
    types = [enchantment],
    subtypes = [aura, curse],
    text = [
      enchant(isPlayer),
      whenever(
        does(actor(enchanted(player)), cast(a(spell))),
        putCounters(1, printedKind(spiteCounter), this(aura))),
      when(
        does(actor(enchanted(player)), loseGame),
        sequentially([
            gainLife(letter(x)),
            draw(letter(x)),
            define(x, countersOn(spiteCounter, this(aura)))]))]})
