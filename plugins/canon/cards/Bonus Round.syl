card singleFaced({
    name = "Bonus Round",
    cost = [generic(1), pip(red), pip(red)],
    types = [sorcery],
    text = [
      spell(
        delayWithin(
          does(actor(a(player)), cast(a(nominal(pre = [or([instant, sorcery])], spell)))),
          untilEndOfTurn,
          sequentially([
              instruct(that(player), copyOnStack(it)),
              instruct(that(player), may(chooseNewTargets(that(copy))))])))]})
