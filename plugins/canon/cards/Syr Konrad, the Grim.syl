card singleFaced({
    name = "Syr Konrad, the Grim",
    cost = [generic(3), pip(black), pip(black)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, knight],
    text = [
      whenever(
        or([
            does(actor(a(nominal(pre = [other], creature))), die),
            does(
              any,
              putInto(a(nominal(pre = [creature], card)), graveyard, from = not(battlefield))),
            does(
              actor(a(nominal(pre = [creature], card, post = [in(yourGraveyard)]))),
              leave(from = yourGraveyard))]),
        instruct(this, dealDamage(amount = 1, recipient = eachOpponent))),
      activated(mana([generic(1), pip(black)]), instruct(eachPlayer, mill(1)))],
    power = 5,
    toughness = 4})
