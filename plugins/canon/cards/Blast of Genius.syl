card singleFaced({
    name = "Blast of Genius",
    cost = [generic(4), pip(blue), pip(red)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            choose(target(anyTarget)),
            draw(3),
            discard(a(nominal(card, post = [in(yourHand)]))),
            instruct(
              this,
              dealDamage(
                amount = statOf(stat(manaValue), the(nominal(pre = [was(discard(which))], card))),
                recipient = thatJoin))]))]})
