card singleFaced({
    name = "Brightspear Zealot",
    cost = [generic(2), pip(white)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      vigilance,
      static(
        onlyWhile(
          getsPt(this(creature), up(2), up(0)),
          compareAmt(eventCount(actor(you), cast(a(spell)), soFarThisTurn), atLeast, 2)))],
    power = 2,
    toughness = 4})
