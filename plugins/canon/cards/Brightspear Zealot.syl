card singleFaced({
    name = "Brightspear Zealot",
    cost = [generic(2), pip(white)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      vigilance,
      static(
        onlyWhile(
          getsPt(thisCreature, up(lit(2)), up(lit(0))),
          compareAmt(eventCount(cast(a(isSpell)), actor(you), soFarThisTurn), atLeast, lit(2))))],
    power = lit(2),
    toughness = lit(4)})
