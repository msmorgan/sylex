card singleFaced({
    name = "Consul's Lieutenant",
    cost = [pip(white), pip(white)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      firstStrike,
      renown(1),
      whenever(
        does(actor(thisCreature), attack),
        if = is(it, hasDesignation(renowned)),
        get(
          allOf(nominal(pre = [other, attacking], creature, post = [youControl])),
          up(1),
          up(1),
          duration = untilEndOfTurn))],
    power = 2,
    toughness = 1})
