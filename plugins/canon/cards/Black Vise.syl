card singleFaced({
    name = "Black Vise",
    cost = [generic(1)],
    types = [artifact],
    text = [
      static(entryChoice(thisArtifact, anOpponent)),
      at(
        beginningOfPossessed(the(isChosenPlayer), upkeep),
        sequentially([
            instruct(thisArtifact, dealDamage(amount = letter(x), recipient = that(player))),
            define(x, minus(countOf(cardIn(handOf(they))), 4))]))]})
