card singleFaced({
    name = "Aisling Leprechaun",
    cost = [pip(green)],
    types = [creature],
    subtypes = [faerie],
    text = [
      whenever(
        or([
            does(actor(this(creature)), block(attacker = a(creature))),
            does(by(a(creature)), block(attacker = this(creature)))]),
        becomeColor(that(creature), colors([green])))],
    power = 1,
    toughness = 1})
