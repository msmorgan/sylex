card singleFaced({
    name = "Aisling Leprechaun",
    cost = [pip(green)],
    types = [creature],
    subtypes = [faerie],
    text = [
      whenever(
        or([
            does(actor(thisCreature), block(a(isCreature))),
            does(by(a(isCreature)), block(thisCreature))]),
        action = becomeColor(that(creature), colors([green])))],
    power = 1,
    toughness = 1})
