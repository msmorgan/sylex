card singleFaced({
    name = "Living Hive",
    cost = [generic(6), pip(green), pip(green)],
    types = [creature],
    subtypes = [elemental, insect],
    text = [
      trample,
      whenever(
        does(actor(thisCreature), dealDamage(kind = combat, recipient = a(player))),
        create(thatMuch, written(creatureToken(1, 1, [green], [insect]))))],
    power = 6,
    toughness = 6})
