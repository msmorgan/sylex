card singleFaced({
    name = "Coercive Portal",
    cost = [generic(4)],
    types = [artifact],
    text = [
      willOfTheCouncil(
        at(
          beginningOfYour(upkeep),
          sequentially([
              instruct(eachPlayer, voteStartingWith(you, byLabel(["carnage", "homage"]))),
              doIf(
                getsMoreVotes("carnage"),
                sequentially([
                    sacrifice(this(artifact)),
                    destroy(allOf(nominal(pre = [non(land)], permanent)))])),
              doIf(getsMoreVotesOrTied("homage"), draw(1))])))]})
