card singleFaced({
    name = "Coercive Portal",
    cost = [generic(4)],
    types = [artifact],
    text = [
      willOfTheCouncil(
        at(
          beginningOfYour(upkeep),
          sequentially(
            steps = [
              instruct(eachPlayer, voteStartingWith(you, openly, byLabel(["carnage", "homage"]))),
              doIf(
                getsMoreVotes("carnage"),
                sequentially(
                  steps = [
                    sacrifice(thisArtifact),
                    destroy(allOf(and([isPermanent, non(isLand)])))])),
              doIf(getsMoreVotesOrTied("homage"), draw(1))])))]})
