card singleFaced({
    name = "Aim High",
    cost = [generic(1), pip(green)],
    types = [instant],
    text = [
      spell(
        sequentially([
            untap(target(isCreature)),
            establishFor(
              it,
              [getsPt(it, up(2), up(2)), abilityGrant(it, [reach])],
              untilEndOfTurn)]))]})
