card singleFaced({
    name = "Bramble Elemental",
    cost = [generic(3), pip(green), pip(green)],
    types = [creature],
    subtypes = [elemental],
    text = [
      whenever(
        does(any, attachment(attached, a(hasSubtype(aura)), host = thisCreature)),
        create(2, written(creatureToken(1, 1, [green], [saproling]))))],
    power = 4,
    toughness = 4})
