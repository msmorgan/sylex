card singleFaced({
    name = "Bramble Elemental",
    cost = [generic(3), pip(green), pip(green)],
    types = [creature],
    subtypes = [elemental],
    text = [
      whenever(
        does(any, attachment(attached, a(hasSubtype(aura)), thisCreature)),
        create(lit(2), written(creatureToken(1, 1, [green], [saproling]))))],
    power = lit(4),
    toughness = lit(4)})
