card singleFaced({
    name = "Approach of the Second Sun",
    cost = [generic(6), pip(white)],
    types = [sorcery],
    text = [
      spell(
        doIf(
          and([
              is(this(spell), was(cast(which, from = yourHand), within = thisObject)),
              did(
                actor(you),
                cast(
                  a(
                    nominal(
                      pre = [other],
                      spell,
                      post = [named(printedName("Approach of the Second Sun"))]))),
                within(thisGame))]),
          winGame,
          otherwise = sequentially([putInto(ownName, fromTop(7, library)), gainLife(7)])))]})
