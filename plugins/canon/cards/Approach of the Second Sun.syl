card singleFaced({
    name = "Approach of the Second Sun",
    cost = [generic(6), pip(white)],
    types = [sorcery],
    text = [
      spell(
        doIf(
          and(
            conjuncts = [
              is(this, did(any, cast(which, from = yourHand), within = thisObject)),
              did(
                actor(you),
                cast(a(and([isSpell, isOther, named(printedName("Approach of the Second Sun"))]))),
                within(thisGame))]),
          winGame,
          otherwise = sequentially(steps = [putInto(this, fromTop(7, library)), gainLife(7)])))]})
