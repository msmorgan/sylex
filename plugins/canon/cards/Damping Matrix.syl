card singleFaced({
    name = "Damping Matrix",
    cost = [generic(3)],
    types = [artifact],
    text = [
      static(
        cant(
          any,
          activate(
            allOf(
              nominal(
                abilityHead(anyActivated),
                post = [ofSource(allOf(or([artifact, creature])))]))),
          unless = is(them, noun(a(manaAbility)))))]})
