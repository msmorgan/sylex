card singleFaced({
    name = "Fire Servant",
    cost = [generic(3), pip(red), pip(red)],
    types = [creature],
    subtypes = [elemental],
    text = [
      static(
        replace(
          would(actor(a(and([isInstantOrSorcery, hasColor(red), youControl]))), dealDamage),
          instead(instruct(it, dealDamage(amount = times(2, thatMuch))))))],
    power = 4,
    toughness = 3})
