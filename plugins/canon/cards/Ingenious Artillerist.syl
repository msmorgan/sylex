card singleFaced({
    name = "Ingenious Artillerist",
    cost = [generic(2), pip(red)],
    types = [creature],
    subtypes = [human, artificer],
    text = [
      whenever(
        does(actor(counted(orMore(1), and([isArtifact, youControl]))), enter),
        instruct(thisCreature, dealDamage(groupSize, eachOpponent)))],
    power = 3,
    toughness = 1})
