card singleFaced({
    name = "Aura of Silence",
    cost = [generic(1), pip(white), pip(white)],
    types = [enchantment],
    text = [
      static(
        costShift(
          bare(
            nominal(
              pre = [or([artifact, enchantment])],
              spell,
              post = [did(actor(yourOpponents), cast(which), within = thisObject)])),
          more(2))),
      activated(
        perform(sacrifice(this(enchantment))),
        destroy(target(or([artifact, enchantment]))))]})
