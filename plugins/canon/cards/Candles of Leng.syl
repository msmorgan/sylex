card singleFaced({
    name = "Candles of Leng",
    cost = [generic(2)],
    types = [artifact],
    text = [
      activated(
        compound([mana([generic(4)]), tapSymbol]),
        sequentially([
            reveal(topSlice(lit(1))),
            doIf(
              is(it, shares(cardName, share, a(cardIn(yourGraveyard)))),
              putInto(it, graveyard),
              draw(lit(1)))]))]})
