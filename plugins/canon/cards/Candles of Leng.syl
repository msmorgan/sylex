card {
  name = "Candles of Leng",
  cost = [2],
  types = [artifact],
  text = [
    activated(
      compound([mana([4]), tapSymbol]),
      sequentially([
          reveal(topSlice(1)),
          doIf(
            is(it, shares(cardName, share, a(cardIn(yourGraveyard)))),
            putInto(it, graveyard),
            draw(1))]))]
}
