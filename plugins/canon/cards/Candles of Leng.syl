card singleFaced({
    name = "Candles of Leng",
    cost = [generic(2)],
    types = [artifact],
    text = [
      activated(
        compound(costs = [mana([generic(4)]), tapSymbol]),
        sequentially(
          steps = [
            reveal(topSlice(1)),
            doIf(
              is(it, shares(cardName, share, a(cardIn(yourGraveyard)))),
              putInto(it, graveyard),
              otherwise = draw(1))]))]})
