card singleFaced({
    name = "Nevermore",
    cost = [generic(1), pip(white), pip(white)],
    types = [enchantment],
    text = [
      static(entersChoosingFrom(thisEnchantment, cardName, nameOfCard(non(hasType(land))))),
      static(cant(any, cast(bare(nominal(spell, post = [named(chosenName)])))))]})
