card singleFaced({
    name = "Pippin's Bravery",
    cost = [pip(green)],
    types = [instant],
    text = [
      spell(
        may(
          sacrifice(a(hasSubtype(food))),
          ifDid = get(target(isCreature), up(4), up(4), duration = untilEndOfTurn),
          ifNot = get(that(creature), up(2), up(2), duration = untilEndOfTurn)))]})
