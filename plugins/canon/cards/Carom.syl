card singleFaced({
    name = "Carom",
    cost = [generic(1), pip(white)],
    types = [instant],
    text = [
      spell(
        sequentially([
            establishThroughout(
              replace(
                would(any, dealDamage(recipient = target(creature))),
                instead(redirectDamage(theNext(1), target(nominal(pre = [other], creature))))),
              thisTurn),
            draw(1)]))]})
