card singleFaced({
    name = "Carom",
    cost = [generic(1), pip(white)],
    types = [instant],
    text = [
      spell(
        sequentially(
          steps = [
            establishThroughout(
              replace(
                would(any, dealDamage(recipient = target(isCreature))),
                instead(redirectDamage(theNext(1), target(and([isCreature, isOther]))))),
              thisTurn),
            draw(1)]))]})
