card singleFaced({
    name = "Ghostly Keybearer",
    cost = [generic(3), pip(blue)],
    types = [creature],
    subtypes = [spirit],
    text = [
      flying,
      whenever(
        does(actor(thisCreature), dealDamage(kind = combat, recipient = a(player))),
        unlock(doorOf(locked, targets(upTo(1), nominal(room, post = [youControl])))))],
    power = 3,
    toughness = 3})
