card singleFaced({
    name = "Ghostly Keybearer",
    cost = [generic(3), pip(blue)],
    types = [creature],
    subtypes = [spirit],
    text = [
      flying,
      whenever(
        does(actor(thisCreature), dealDamage(recipient = a(isPlayer), kind = combat)),
        unlock(doorOf(locked, targets(upTo(1), and([hasSubtype(room), youControl])))))],
    power = 3,
    toughness = 3})
