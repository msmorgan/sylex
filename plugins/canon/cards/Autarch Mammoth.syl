card singleFaced({
    name = "Autarch Mammoth",
    cost = [generic(4), pip(green), pip(green)],
    types = [creature],
    subtypes = [elephant, mount],
    text = [
      when(
        does(actor(thisCreature), enter),
        joins = [
          joinedHeadWhile(
            does(actor(thisCreature), attack),
            whileTrue(is(thisCreature, hasDesignation(saddled))))],
        action = create(lit(1), written(creatureToken(3, 3, [green], [elephant])))),
      saddle(lit(5))],
    power = lit(5),
    toughness = lit(5)})
