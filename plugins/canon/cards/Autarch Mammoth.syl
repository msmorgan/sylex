card singleFaced({
    name = "Autarch Mammoth",
    cost = [generic(4), pip(green), pip(green)],
    types = [creature],
    subtypes = [elephant, mount],
    text = [
      triggered(
        and([
            when(does(actor(thisCreature), enter)),
            whenever(
              timed(
                does(actor(thisCreature), attack),
                whileTrue(is(thisCreature, hasDesignation(saddled)))))]),
        create(1, written(creatureToken(3, 3, [green], [elephant])))),
      saddle(5)],
    power = 5,
    toughness = 5})
