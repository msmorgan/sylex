card singleFaced({
    name = "Captain Marvel, Apex Avenger",
    cost = [generic(5), pip(red), pip(white)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, kree, hero],
    text = [
      flying,
      doubleStrike,
      indestructible,
      whenever(
        does(by(you), putCounters(anyAmount, anyKind, a(nominal(pre = [other], creature)))),
        if = is(it, not(a(kree))),
        may(putCounters(thatMuch, thoseCounters, shortenedName)))],
    power = 4,
    toughness = 4})
