card transforming({
    name = "Delver of Secrets",
    cost = [pip(blue)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      at(
        beginningOfYour(upkeep),
        sequentially([
            lookAt(topSlice(1)),
            may(reveal(that(card))),
            doIf(
              did(actor(you), reveal(a(and([isCard, isInstantOrSorcery]))), thisWay),
              transform(thisCreature))]))],
    power = 1,
    toughness = 1},
  {
    name = "Insectile Aberration",
    types = [creature],
    subtypes = [human, insect],
    text = [flying],
    power = 3,
    toughness = 2})
