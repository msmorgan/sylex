card singleFaced({
    name = "Chrome Replicator",
    cost = [generic(5)],
    types = [artifact, creature],
    subtypes = [construct],
    text = [
      when(
        does(actor(thisCreature), enter),
        if = thereAre(
          counted(
            orMore(2),
            nominal(
              pre = [non(land), non(token)],
              permanent,
              post = [youControl, withTheSameName]))),
        create(
          1,
          written({
              characteristics = {
                types = [artifact, creature],
                subtypes = [construct],
                power = 4,
                toughness = 4}})))],
    power = 4,
    toughness = 4})
