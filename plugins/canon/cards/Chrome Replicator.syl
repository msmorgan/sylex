card singleFaced({
    name = "Chrome Replicator",
    cost = [generic(5)],
    types = [artifact, creature],
    subtypes = [construct],
    text = [
      when(
        does(actor(thisCreature), enter),
        if = thereAre(
          withTheSameName(
            counted(orMore(2), and([isPermanent, non(isLand), isNontoken, youControl])))),
        create(
          1,
          written({
              characteristics = {
                types = [artifact, creature],
                subtypes = [construct],
                power = 4,
                toughness = 4}})))],
    power = 4,
    toughness = 4})
