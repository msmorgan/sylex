card {
  name = "Chrome Replicator",
  cost = [generic(5)],
  types = [artifact, creature],
  subtypes = [construct],
  text = [
    when(
      does(actor(thisCreature), enter),
      if = thereAre(
        withTheSameName(
          counted(orMore(2), and([isPermanent, non(isLand), isNontoken, youControl])))),
      action = create(
        lit(1),
        written({
            characteristics = {
              types = [artifact, creature],
              subtypes = [construct],
              power = lit(4),
              toughness = lit(4)}})))],
  power = lit(4),
  toughness = lit(4)
}
