card singleFaced({
    name = "Lucid Dreams",
    cost = [generic(3), pip(blue), pip(blue)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            draw(letter(x)),
            define(
              x,
              distinctCount(cardType, bare(nominal(card, post = [in(yourGraveyard)]))))]))]})
