card singleFaced({
    name = "Fyndhorn Druid",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [elf, druid],
    text = [
      when(
        does(actor(this(creature)), die),
        if = was(becomeBlocked(it), within(soFarThisTurn)),
        gainLife(4))],
    power = 2,
    toughness = 2})
