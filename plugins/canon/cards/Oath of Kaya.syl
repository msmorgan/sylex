card singleFaced({
    name = "Oath of Kaya",
    cost = [generic(1), pip(white), pip(black)],
    supertypes = [legendary],
    types = [enchantment],
    text = [
      when(
        does(actor(this), enter),
        sequentially(
          [instruct(it, dealDamage(amount = 3, recipient = target(anyTarget))), gainLife(3)])),
      whenever(
        does(
          actor(anOpponent),
          attackWith(
            defender = a(nominal(planeswalker, post = [youControl])),
            counted(orMore(1), creature))),
        sequentially(
          [instruct(this, dealDamage(amount = 2, recipient = that(player))), gainLife(2)]))]})
