card singleFaced({
    name = "Oath of Kaya",
    cost = [generic(1), pip(white), pip(black)],
    supertypes = [legendary],
    types = [enchantment],
    text = [
      when(
        does(actor(this), enter),
        sequentially(
          [instruct(this, dealDamage(amount = 3, recipient = target(isAnyTarget))), gainLife(3)])),
      whenever(
        does(
          actor(anOpponent),
          attackWith(
            counted(orMore(1), isCreature),
            defender = a(and([isPlaneswalker, youControl])))),
        sequentially(
          [instruct(this, dealDamage(amount = 2, recipient = that(player))), gainLife(2)]))]})
