card singleFaced({
    name = "Concerted Effort",
    cost = [generic(2), pip(white), pip(white)],
    types = [enchantment],
    text = [
      alsoForKeywords(
        at(
          beginningOfEach(upkeep),
          doOnlyIf(
            establishThroughout(
              keywordGrant(
                bare(nominal(creature, post = [youControl])),
                thatKeyword,
                and([hasType(creature), youControl, hasKeyword(thatKeyword)])),
              untilEndOfTurn),
            exists(nominal(creature, post = [youControl, hasKeyword(thatKeyword)])))),
        [
          theKeyword(flying),
          theKeyword(fear),
          theKeyword(firstStrike),
          theKeyword(doubleStrike),
          anyIn({word = landwalk}),
          anyIn({word = protection}),
          theKeyword(trample),
          theKeyword(vigilance)])]})
