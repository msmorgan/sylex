card singleFaced({
    name = "Snuff Out",
    cost = [generic(3), pip(black)],
    types = [instant],
    text = [
      static(
        onlyWhile(
          altCost(payingInstead(perform(payLife(4))), this),
          exists(and([isLand, hasSubtype(swamp), youControl])))),
      spell(destroyCantRegenerate(target(and([isCreature, non(hasColor(black))]))))]})
