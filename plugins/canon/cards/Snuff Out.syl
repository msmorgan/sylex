card singleFaced({
    name = "Snuff Out",
    cost = [generic(3), pip(black)],
    types = [instant],
    text = [
      static(
        if(
          exists(nominal(swamp, post = [youControl])),
          altCost(payingInstead(perform(payLife(amount = 4))), this(spell)))),
      spell(
        doUnderProhibition(
          destroy(target(nominal(pre = [non(black)], creature))),
          regeneration(it)))]})
