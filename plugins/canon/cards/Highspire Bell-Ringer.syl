card singleFaced({
    name = "Highspire Bell-Ringer",
    cost = [generic(2), pip(blue)],
    types = [creature],
    subtypes = [djinn, monk],
    text = [
      flying,
      static(
        costShift(
          the(
            and([
                isSpell,
                did(
                  actor(you),
                  cast(which),
                  within = thisObject,
                  ordinal = {ordinal = nth(2), per = turn})])),
          less(1)))],
    power = 1,
    toughness = 4})
