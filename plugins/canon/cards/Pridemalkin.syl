card singleFaced({
    name = "Pridemalkin",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [cat],
    text = [
      when(
        does(actor(this(creature)), enter),
        putCounters(1, printedKind(p1p1Counter), target(nominal(creature, post = [youControl])))),
      static(
        abilityGrant(
          each(nominal(creature, post = [youControl, hasCounter(kind = p1p1Counter)])),
          [trample]))],
    power = 2,
    toughness = 1})
