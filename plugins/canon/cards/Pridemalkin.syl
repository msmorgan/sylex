card singleFaced({
    name = "Pridemalkin",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [cat],
    text = [
      when(
        does(actor(thisCreature), enter),
        putCounters(lit(1), printedKind(p1p1Counter), target(and([isCreature, youControl])))),
      static(abilityGrant(each(and([isCreature, youControl, hasCounter(p1p1Counter)])), trample))],
    power = lit(2),
    toughness = lit(1)})
