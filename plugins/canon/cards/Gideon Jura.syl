card singleFaced({
    name = "Gideon Jura",
    cost = [generic(3), pip(white), pip(white)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [gideon],
    text = [
      activated(
        loyaltySymbol(up(lit(2))),
        establishThroughout(
          must(
            actor(allOf(and([isCreature, controlledBy(target(isOpponent))]))),
            attack(thisPlaneswalker)),
          duringNextTurnOf(that(player)))),
      activated(loyaltySymbol(down(lit(2))), destroy(target(and([isCreature, isTapped])))),
      activated(
        loyaltySymbol(up(lit(0))),
        sequentially([
            establishThroughout(
              qualityChange(
                thisPlaneswalker,
                sets,
                bundle({
                    characteristics = {
                      types = [creature],
                      subtypes = [human, soldier],
                      power = lit(6),
                      toughness = lit(6)}},
                  planeswalker)),
              untilEndOfTurn),
            preventAll(it, thisTurn)]))],
    loyalty = lit(6)})
