card singleFaced({
    name = "Gideon Jura",
    cost = [generic(3), pip(white), pip(white)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [gideon],
    text = [
      activated(
        loyaltySymbol(up(2)),
        establishThroughout(
          must(
            actor(allOf(and([isCreature, controlledBy(target(isOpponent))]))),
            attack(defender = thisPlaneswalker)),
          duringNextTurnOf(that(player)))),
      activated(loyaltySymbol(down(2)), destroy(target(and([isCreature, isTapped])))),
      activated(
        loyaltySymbol(up(0)),
        sequentially([
            establishThroughout(
              qualityChange(
                thisPlaneswalker,
                sets,
                bundle({
                    characteristics = {
                      types = [creature],
                      subtypes = [human, soldier],
                      power = 6,
                      toughness = 6}},
                  retained = planeswalker)),
              untilEndOfTurn),
            preventAll(it, thisTurn)]))],
    loyalty = 6})
