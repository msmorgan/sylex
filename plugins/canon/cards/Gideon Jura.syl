card singleFaced({
    name = "Gideon Jura",
    cost = [generic(3), pip(white), pip(white)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [gideon],
    text = [
      activated(
        loyaltySymbol(up(2)),
        establishThroughout(
          must(
            actor(allOf(nominal(creature, post = [controlledBy(target(opponent))]))),
            attack(defender = thisPlaneswalker)),
          duringNextTurnOf(that(player)))),
      activated(loyaltySymbol(down(2)), destroy(target(nominal(pre = [tapped], creature)))),
      activated(
        loyaltySymbol(up(0)),
        sequentially([
            establishThroughout(
              qualityChange(
                thisPlaneswalker,
                sets,
                bundle({
                    characteristics = {
                      types = [creature],
                      subtypes = [human, soldier],
                      power = 6,
                      toughness = 6}},
                  retained = planeswalker)),
              untilEndOfTurn),
            preventAll(to = it, duration = thisTurn)]))],
    loyalty = 6})
