card singleFaced({
    name = "Infernal Vessel",
    cost = [generic(2), pip(black)],
    types = [creature],
    subtypes = [human, cleric],
    text = [
      when(
        does(actor(thisCreature), die),
        if = not(is(it, hasSubtype(demon))),
        returnToBattlefield(
          it,
          riders = [
            under(ownerOf(it)),
            withCounters(2, printedKind(p1p1Counter), fresh),
            withCharacteristicEdits([typeLine(adds, {subtypes = [demon]})])]))],
    power = 2,
    toughness = 1})
