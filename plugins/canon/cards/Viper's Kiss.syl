card {
  name = "Viper's Kiss",
  cost = [pip(black)],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
          getsPt(enchanted(creature), down(lit(1)), down(lit(1))),
          cant(any, activate(allOf(and([abilityHead(anyActivated), abilityOf(it)]))))]))]
}
