card singleFaced({
    name = "Viper's Kiss",
    cost = [pip(black)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(
        conjunction([
            getsPt(enchanted(creature), down(1), down(1)),
            cant(any, activate(possessive(it, abilityHead(anyActivated))))]))]})
