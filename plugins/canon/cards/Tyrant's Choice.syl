card singleFaced({
    name = "Tyrant's Choice",
    cost = [generic(1), pip(black)],
    types = [sorcery],
    text = [
      willOfTheCouncil(
        spell(
          sequentially([
              instruct(eachPlayer, voteStartingWith(you, openly, byLabel(["death", "torture"]))),
              doIf(
                getsMoreVotes("death"),
                instruct(eachOpponent, sacrifice(aTheirChoice(isCreature)))),
              doIf(getsMoreVotesOrTied("torture"), instruct(eachOpponent, loseLife(4)))])))]})
