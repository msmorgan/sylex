card singleFaced({
    name = "Cold Storage",
    cost = [generic(4)],
    types = [artifact],
    text = [
      activated(mana([generic(3)]), exile(target(nominal(creature, post = [youControl])))),
      activated(
        perform(sacrifice(thisArtifact)),
        returnToBattlefield(
          each(nominal(pre = [creature], card, post = [in(exiledWith(thisArtifact))])),
          riders = [underControlOf(you)]))]})
