card singleFaced({
    name = "Cold Storage",
    cost = [generic(4)],
    types = [artifact],
    text = [
      activated(mana([generic(3)]), exile(target(and([isCreature, youControl])))),
      activated(
        perform(sacrifice(thisArtifact)),
        returnToBattlefield(
          each(and([isCreature, cardIn(exiledWith(thisArtifact))])),
          [under(you)]))]})
