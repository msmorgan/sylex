card singleFaced({
    name = "Conspiracy",
    cost = [generic(3), pip(black), pip(black)],
    types = [enchantment],
    text = [
      static(entersChoosing(this(enchantment), subtype(creature))),
      static(
        qualityChange(
          and([
              bare(nominal(creature, post = [youControl])),
              bare(nominal(pre = [creature], spell, post = [youControl])),
              bare(nominal(pre = [creature], card, post = [youOwn, thatIsnt(in(battlefield))]))]),
          sets,
          chosenQuality(ofChosen(subtype(creature)))))]})
