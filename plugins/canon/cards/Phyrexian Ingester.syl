card singleFaced({
    name = "Phyrexian Ingester",
    cost = [generic(6), pip(blue)],
    types = [creature],
    subtypes = [phyrexian, beast],
    text = [
      imprint(
        when(
          does(actor(this(creature)), enter),
          may(exile(target(nominal(pre = [non(token)], creature)))))),
      static(
        conjunction([
            getsPt(this(creature), up(letter(x)), up(letter(y))),
            letterDefinition(x, powerOf(the(nominal(pre = [was(exile(which)), creature], card)))),
            letterDefinition(y, toughnessOf(it))]))],
    power = 3,
    toughness = 3})
