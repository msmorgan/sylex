card singleFaced({
    name = "Blood Reckoning",
    cost = [generic(3), pip(black)],
    types = [enchantment],
    text = [
      whenever(
        does(actor(a(isCreature)), attack(youOr(a(and([isPlaneswalker, youControl]))))),
        instruct(controllerOf(that(creature)), loseLife(lit(1))))]})
