card singleFaced({
    name = "Blood Reckoning",
    cost = [generic(3), pip(black)],
    types = [enchantment],
    text = [
      whenever(
        does(
          actor(a(creature)),
          attack(defender = or([you, a(nominal(planeswalker, post = [youControl]))]))),
        instruct(controllerOf(that(creature)), loseLife(1)))]})
