card singleFaced({
    name = "Wicked Akuba",
    cost = [pip(black), pip(black)],
    types = [creature],
    subtypes = [spirit],
    text = [
      activated(
        mana([pip(black)]),
        instruct(
          target(
            and([
                isPlayer,
                did(
                  actor(thisCreature),
                  dealDamage(recipient = which),
                  within = within(soFarThisTurn))])),
          loseLife(1)))],
    power = 2,
    toughness = 2})
