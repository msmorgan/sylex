card singleFaced({
    name = "Admiral's Order",
    cost = [generic(1), pip(blue), pip(blue)],
    types = [instant],
    text = [
      static(
        if(
          did(actor(you), attack, within(soFarThisTurn)),
          altCost(payingInstead(mana([pip(blue)])), this))),
      spell(counter(target(isSpell)))]})
