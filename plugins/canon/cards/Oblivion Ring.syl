card singleFaced({
    name = "Oblivion Ring",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    text = [
      when(
        does(actor(this(enchantment)), enter),
        exile(target(nominal(pre = [other, non(land)], permanent)))),
      when(
        does(actor(this(enchantment)), leave),
        returnToBattlefield(
          the(nominal(pre = [was(exile(which))], card)),
          riders = [underControlOf(ownerOf(it))]))]})
