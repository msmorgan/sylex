card singleFaced({
    name = "Explosive Singularity",
    cost = [generic(8), pip(red), pip(red)],
    types = [sorcery],
    text = [
      static(
        addedCost(
          this,
          optional,
          plusAdditional(
            perform(tap(counted(anyNumber, and([isCreature, youControl, isUntapped]))))))),
      static(costShift(this, less(times(1, groupSize)))),
      spell(instruct(this, dealDamage(amount = 10, recipient = target(isAnyTarget))))]})
