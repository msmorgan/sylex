card singleFaced({
    name = "Explosive Singularity",
    cost = [generic(8), pip(red), pip(red)],
    types = [sorcery],
    text = [
      static(
        addedCost(
          optional,
          perform(tap(counted(anyNumber, and([isCreature, youControl, isUntapped])))))),
      static(costShift(this, less(times(lit(1), groupSize)))),
      spell(instruct(this, dealDamage(lit(10), target(isAnyTarget))))]})
