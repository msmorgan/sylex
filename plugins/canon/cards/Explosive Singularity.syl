card singleFaced({
    name = "Explosive Singularity",
    cost = [generic(8), pip(red), pip(red)],
    types = [sorcery],
    text = [
      static(
        addedCost(
          this(spell),
          optional,
          plusAdditional(
            perform(
              tap(counted(anyNumber, nominal(pre = [untapped], creature, post = [youControl]))))))),
      static(
        costShift(
          this(spell),
          less(forEach(1, nominal(creature, post = [was(tap(which), within = thisWay)]))))),
      spell(instruct(ownName, dealDamage(amount = 10, recipient = target(anyTarget))))]})
