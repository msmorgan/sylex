# A leveler card [CR#711]: each band is a level symbol's static ability, the abilities and base
# power and toughness this creature has while its level counters are in that range.
card leveler(
  inner = {
    name = "Student of Warfare",
    cost = [pip(white)],
    types = [creature],
    subtypes = [human, knight],
    text = [levelUp(mana([pip(white)]))],
    power = lit(1),
    toughness = lit(1)},
  bands = [
    {range = between(2, 6), power = lit(3), toughness = lit(3), text = [firstStrike]},
    {range = plus(7), power = lit(4), toughness = lit(4), text = [doubleStrike]}])
