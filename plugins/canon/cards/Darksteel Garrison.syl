card singleFaced({
    name = "Darksteel Garrison",
    cost = [generic(2)],
    types = [artifact],
    subtypes = [fortification],
    text = [
      static(abilityGrant(fortified(land), indestructible)),
      whenever(
        does(actor(fortified(land)), setStatus(tapped, actor)),
        get(target(isCreature), up(1), up(1), untilEndOfTurn)),
      fortify(mana([generic(3)]))]})
