card singleFaced({
    name = "Bartered Cow",
    cost = [generic(3), pip(white)],
    types = [creature],
    subtypes = [ox],
    text = [
      triggered(
        and([when(does(actor(this(creature)), die)), when(does(actor(you), discard(this(card))))]),
        create(1, defined(foodToken)))],
    power = 3,
    toughness = 3})
