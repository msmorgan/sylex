card singleFaced({
    name = "Bartered Cow",
    cost = [generic(3), pip(white)],
    types = [creature],
    subtypes = [ox],
    text = [
      triggered(
        and([when(does(actor(thisCreature), die)), when(does(actor(you), discard(thisCard)))]),
