card singleFaced({
    name = "Nightcreep",
    cost = [pip(black), pip(black)],
    types = [instant],
    text = [
      spell(
        establishThroughout(
          conjunction([
              qualityChange(allOf(creature), sets, colored(colors([black]))),
              qualityChange(allOf(land), sets, bundle({characteristics = {subtypes = [swamp]}}))]),
          untilEndOfTurn))]})
