card singleFaced({
    name = "Star Pupil",
    cost = [pip(white)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      static(entersWithCounters(this(creature), 1, p1p1Counter)),
      when(
        does(actor(this(creature)), die),
        doForEachKind(
          counterKind,
          domain = it,
          counterKind,
          putCounters(
            statOf(boundCounter, it),
            thatKind,
            target(nominal(creature, post = [youControl])))))],
    power = 0,
    toughness = 0})
