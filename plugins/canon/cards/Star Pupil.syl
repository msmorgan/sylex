card singleFaced({
    name = "Star Pupil",
    cost = [pip(white)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      static(entersWithCounters(thisCreature, 1, p1p1Counter)),
      when(
        does(actor(thisCreature), die),
        doForEachKind(
          counterKind,
          domain = it,
          counterKind,
          putCounters(statOf(boundCounter, it), thatKind, target(and([isCreature, youControl])))))],
    power = 0,
    toughness = 0})
