card singleFaced({
    name = "Fork",
    cost = [pip(red), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially([
            copyOnStack(
              target(nominal(pre = [or([instant, sorcery])], spell)),
              exceptions = [isColor(red)]),
            may(chooseNewTargets(that(copy)))]))]})
