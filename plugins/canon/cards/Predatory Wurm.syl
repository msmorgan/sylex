card singleFaced({
    name = "Predatory Wurm",
    cost = [generic(3), pip(green)],
    types = [creature],
    subtypes = [wurm],
    text = [
      vigilance,
      static(
        onlyWhile(
          getsPt(this(creature), up(2), up(2)),
          exists(nominal(garruk, post = [youControl]))))],
    power = 4,
    toughness = 4})
