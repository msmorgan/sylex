card singleFaced({
    name = "Rouse",
    cost = [generic(1), pip(black)],
    types = [instant],
    text = [
      static(
        if(
          exists(nominal(swamp, post = [youControl])),
          altCost(payingInstead(perform(payLife(amount = 2))), this(spell)))),
      spell(get(target(creature), up(2), up(0), duration = untilEndOfTurn))]})
