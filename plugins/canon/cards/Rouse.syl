card singleFaced({
    name = "Rouse",
    cost = [generic(1), pip(black)],
    types = [instant],
    text = [
      static(
        if(
          exists(and([isLand, hasSubtype(swamp), youControl])),
          altCost(payingInstead(perform(payLife(2))), this))),
      spell(get(target(isCreature), up(2), up(0), untilEndOfTurn))]})
