card singleFaced({
    name = "Old-Growth Dryads",
    cost = [pip(green)],
    types = [creature],
    subtypes = [dryad],
    text = [
      when(
        does(actor(this(creature)), enter),
        instruct(
          eachOpponent,
          may(
            sequentially([
                search(libraryOf(they), for = a(nominal(pre = [basic, land], card))),
                putOntoBattlefieldTapped(it),
                shuffle]))))],
    power = 3,
    toughness = 3})
