card singleFaced({
    name = "Old-Growth Dryads",
    cost = [pip(green)],
    types = [creature],
    subtypes = [dryad],
    text = [
      when(
        does(actor(thisCreature), enter),
        instruct(
          eachOpponent,
          may(
            sequentially(
              steps = [
                search(libraryOf(they), for = a(and([isLand, hasSupertype(basic)]))),
                putOntoBattlefieldTapped(it),
                shuffle]))))],
    power = 3,
    toughness = 3})
