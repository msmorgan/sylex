card singleFaced({
    name = "Aurelia, the Law Above",
    cost = [generic(3), pip(red), pip(white)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [angel],
    text = [
      flying,
      vigilance,
      haste,
      whenever(does(actor(a(isPlayer)), attackWith(counted(orMore(3), isCreature))), draw(1)),
      whenever(
        does(actor(a(isPlayer)), attackWith(counted(orMore(5), isCreature))),
        sequentially([instruct(this, dealDamage(3, eachOpponent)), gainLife(3)]))],
    power = 4,
    toughness = 4})
