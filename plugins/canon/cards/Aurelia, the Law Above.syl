card singleFaced({
    name = "Aurelia, the Law Above",
    cost = [generic(3), pip(red), pip(white)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [angel],
    text = [
      flying,
      vigilance,
      haste,
      whenever(does(actor(a(player)), attackWith(counted(orMore(3), creature))), draw(1)),
      whenever(
        does(actor(a(player)), attackWith(counted(orMore(5), creature))),
        sequentially([
            instruct(shortenedName, dealDamage(amount = 3, recipient = eachOpponent)),
            gainLife(3)]))],
    power = 4,
    toughness = 4})
