card singleFaced({
    name = "Bard, Heir of Girion",
    cost = [generic(2), pip(white), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, archer],
    text = [
      reach,
      vigilance,
      static(getsPt(allOf(and([isCreature, youControl, isOther])), up(1), up(1))),
      whenever(does(actor(you), attack), draw(1))],
    power = 4,
    toughness = 4})
