card {
  name = "Dread Slaver",
  cost = [3, black, black],
  types = [creature],
  subtypes = [zombie, horror],
  text = [
    whenever(
      does(
        actor(
          a(
            and([
                isCreature,
                did(actor(thisCreature), dealDamage(recipient = which), within(soFarThisTurn))]))),
        die),
      sequentially([
          returnToBattlefield(it, [under(you)]),
          become(that(creature), {characteristics = {colors = [black], subtypes = [zombie]}})]))],
  power = 3,
  toughness = 5
}
