card singleFaced({
    name = "Dread Slaver",
    cost = [generic(3), pip(black), pip(black)],
    types = [creature],
    subtypes = [zombie, horror],
    text = [
      whenever(
        does(
          actor(
            a(
              and([
                  isCreature,
                  did(
                    actor(thisCreature),
                    dealDamage(recipient = which),
                    within = within(soFarThisTurn))]))),
          die),
        returnToBattlefield(
          it,
          riders = [
            under(you),
            withCharacteristicEdits(
              [colors(adds, colors([black])), typeLine(adds, {subtypes = [zombie]})])]))],
    power = 3,
    toughness = 5})
