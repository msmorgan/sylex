card singleFaced({
    name = "Grand Arbiter Augustin IV",
    cost = [generic(2), pip(white), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, advisor],
    text = [
      static(
        costShift(
          allOf(
            nominal(
              pre = [white],
              spell,
              post = [did(actor(you), cast(which), within = thisObject)])),
          less(1))),
      static(
        costShift(
          allOf(
            nominal(
              pre = [blue],
              spell,
              post = [did(actor(you), cast(which), within = thisObject)])),
          less(1))),
      static(
        costShift(
          allOf(
            nominal(spell, post = [did(actor(yourOpponents), cast(which), within = thisObject)])),
          more(1)))],
    power = 2,
    toughness = 3})
