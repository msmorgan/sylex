card singleFaced({
    name = "Rakshasa's Disdain",
    cost = [generic(2), pip(blue)],
    types = [instant],
    text = [
      spell(
        instruct(
          controllerOf(target(spell)),
          doUnless(
            scaledGenericMana(forEach(1, nominal(card, post = [in(yourGraveyard)]))),
            instruct(you, counter(it)))))]})
