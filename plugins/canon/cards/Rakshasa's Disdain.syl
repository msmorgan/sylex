card singleFaced({
    name = "Rakshasa's Disdain",
    cost = [generic(2), pip(blue)],
    types = [instant],
    text = [
      spell(
        instruct(
          controllerOf(target(isSpell)),
          doUnless(
            instruct(you, counter(it)),
            scaledGenericMana(forEach(lit(1), cardIn(yourGraveyard))))))]})
