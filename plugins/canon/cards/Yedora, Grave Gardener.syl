card singleFaced({
    name = "Yedora, Grave Gardener",
    cost = [generic(4), pip(green)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [treefolk, druid],
    text = [
      whenever(
        does(actor(a(nominal(pre = [other, non(token)], creature, post = [youControl]))), die),
        may(
          sequentially([
              returnToBattlefield(
                it,
                riders = [
                  faceDownAs({characteristics = {types = [land], subtypes = [forest]}}),
                  underControlOf(ownerOf(it))])])))],
    power = 5,
    toughness = 5})
