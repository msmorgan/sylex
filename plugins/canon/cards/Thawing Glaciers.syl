card singleFaced({
    name = "Thawing Glaciers",
    types = [land],
    text = [
      static(entersTapped(thisLand)),
      activated(
        compound([mana([generic(1)]), tapSymbol]),
        sequentially([
            search(yourLibrary, for = a(and([isLand, hasSupertype(basic)]))),
            putOntoBattlefieldTapped(that(card)),
            shuffle,
            atNext(beginningOfNext(cleanup), returnToHand(thisLand))]))]})
