card {
  name = "Thawing Glaciers",
  types = [land],
  text = [
    static(entersTapped(thisLand)),
    activated(
      compound([mana([1]), tapSymbol]),
      sequentially([
          search(yourLibrary, a(and([isLand, hasSupertype(basic)]))),
          putOntoBattlefieldTapped(that(card)),
          shuffle,
          atNext(cleanup, returnToHand(thisLand))]))]
}
