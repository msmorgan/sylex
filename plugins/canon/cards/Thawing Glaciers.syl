card singleFaced({
    name = "Thawing Glaciers",
    types = [land],
    text = [
      static(entersTapped(this(land))),
      activated(
        compound([mana([generic(1)]), tapSymbol]),
        sequentially([
            search(yourLibrary, for = a(nominal(pre = [basic, land], card))),
            putOntoBattlefieldTapped(that(card)),
            shuffle,
            atNext(beginningOfNext(cleanup), returnToHand(this(land)))]))]})
