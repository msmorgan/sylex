card singleFaced({
    name = "Deadeye Brawler",
    cost = [generic(2), pip(blue), pip(black)],
    types = [creature],
    subtypes = [human, pirate],
    text = [
      deathtouch,
      ascend,
      whenever(
        does(actor(this(creature)), dealDamage(kind = combat, recipient = a(player))),
        if = is(you, hasDesignation(citysBlessing)),
        draw(1))],
    power = 2,
    toughness = 4})
