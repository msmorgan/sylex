card singleFaced({
    name = "Deadeye Brawler",
    cost = [generic(2), pip(blue), pip(black)],
    types = [creature],
    subtypes = [human, pirate],
    text = [
      deathtouch,
      ascend,
      whenever(
        does(actor(thisCreature), dealDamage(recipient = a(isPlayer), kind = combat)),
        draw(1),
        if = is(you, hasDesignation(citysBlessing)))],
    power = 2,
    toughness = 4})
