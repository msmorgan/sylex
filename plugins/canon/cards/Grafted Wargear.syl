card singleFaced({
    name = "Grafted Wargear",
    cost = [generic(3)],
    types = [artifact],
    subtypes = [equipment],
    text = [
      static(getsPt(equipped(creature), up(3), up(2))),
      whenever(
        does(any, attachment(unattached, thisEquipment, host = a(isPermanent))),
        sacrifice(that(permanent))),
      equip(mana([generic(0)]))]})
