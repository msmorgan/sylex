card singleFaced({
    name = "Haakon, Stromgald Scourge",
    cost = [generic(1), pip(black), pip(black)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [zombie, knight],
    text = [
      static(can(actor(you), cast(this, from = yourGraveyard))),
      static(cant(actor(you), cast(this, from = not(yourGraveyard)))),
      static(
        conditionFirstWhile(
          is(this, in(battlefield)),
          can(actor(you), cast(bare(and([isSpell, hasSubtype(knight)])), from = yourGraveyard)))),
      when(does(actor(thisCreature), die), loseLife(2))],
    power = 3,
    toughness = 3})
