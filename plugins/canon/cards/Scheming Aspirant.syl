card singleFaced({
    name = "Scheming Aspirant",
    cost = [generic(1), pip(black)],
    types = [creature],
    subtypes = [phyrexian, advisor],
    text = [
      whenever(
        does(actor(you), proliferate),
        sequentially([instruct(eachOpponent, loseLife(2)), gainLife(2)]))],
    power = 1,
    toughness = 3})
