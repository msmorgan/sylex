card singleFaced({
    name = "Generator Servant",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [elemental],
    text = [
      activated(
        compound([tapSymbol, perform(sacrifice(thisCreature))]),
        addMana(
          1,
          manaOf([[colorless, colorless]]),
          [
            whenSpentOn(
              affectsIt,
              a(and([isCreature, isSpell])),
              gainHaste(becomes(that(spell)), untilEndOfTurn))]))],
    power = 2,
    toughness = 1})
