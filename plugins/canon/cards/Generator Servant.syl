card singleFaced({
    name = "Generator Servant",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [elemental],
    text = [
      activated(
        compound([tapSymbol, perform(sacrifice(thisCreature))]),
        addMana(
          symbols([colorlessPip, colorlessPip]),
          [
            whenSpentOn(
              affectsIt,
              a(and([isCreature, isSpell])),
              gain(becomes(that(spell)), [haste], untilEndOfTurn))]))],
    power = 2,
    toughness = 1})
