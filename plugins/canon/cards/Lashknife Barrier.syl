card singleFaced({
    name = "Lashknife Barrier",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    text = [
      when(does(actor(this(enchantment)), enter), draw(1)),
      static(
        replace(
          would(
            actor(a(source)),
            dealDamage(recipient = a(nominal(creature, post = [youControl])))),
          instead(
            instruct(it, dealDamage(amount = minus(thatMuch, 1), recipient = that(creature))))))]})
