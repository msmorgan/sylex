card singleFaced({
    name = "Lashknife Barrier",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    text = [
      when(does(actor(thisEnchantment), enter), draw(1)),
      static(
        replace(
          would(actor(a(isSource)), dealDamage(recipient = a(and([isCreature, youControl])))),
          instead(
            instruct(it, dealDamage(amount = minus(thatMuch, 1), recipient = that(creature))))))]})
