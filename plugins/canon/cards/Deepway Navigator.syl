card singleFaced({
    name = "Deepway Navigator",
    cost = [pip(white), pip(blue)],
    types = [creature],
    subtypes = [merfolk, wizard],
    text = [
      flash,
      when(
        does(actor(thisCreature), enter),
        untap(each(and([hasSubtype(merfolk), youControl, isOther])))),
      static(
        onlyWhile(
          getsPt(allOf(and([hasSubtype(merfolk), youControl])), up(lit(1)), up(lit(0))),
          did(
            actor(you),
            attackWith(counted(orMore(3), hasSubtype(merfolk))),
            within(soFarThisTurn))))],
    power = lit(2),
    toughness = lit(2)})
