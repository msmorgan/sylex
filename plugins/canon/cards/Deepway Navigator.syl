card singleFaced({
    name = "Deepway Navigator",
    cost = [pip(white), pip(blue)],
    types = [creature],
    subtypes = [merfolk, wizard],
    text = [
      flash,
      when(
        does(actor(thisCreature), enter),
        untap(each(nominal(pre = [other], merfolk, post = [youControl])))),
      static(
        asLongAs(
          did(actor(you), attackWith(counted(orMore(3), merfolk)), within(soFarThisTurn)),
          getsPt(allOf(nominal(merfolk, post = [youControl])), up(1), up(0))))],
    power = 2,
    toughness = 2})
