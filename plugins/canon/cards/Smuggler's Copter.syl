card singleFaced({
    name = "Smuggler's Copter",
    cost = [generic(2)],
    types = [artifact],
    subtypes = [vehicle],
    text = [
      flying,
      whenever(
        or([does(actor(thisVehicle), attack), does(actor(thisVehicle), block)]),
        may(draw(1), ifDid = discard(a(cardIn(yourHand))))),
      crew(1)],
    power = 3,
    toughness = 3})
