card singleFaced({
    name = "Smuggler's Copter",
    cost = [generic(2)],
    types = [artifact],
    subtypes = [vehicle],
    text = [
      flying,
      whenever(
        or([does(actor(this(vehicle)), attack), does(actor(this(vehicle)), block)]),
        may(draw(1), ifDid = discard(a(nominal(card, post = [in(yourHand)]))))),
      crew(1)],
    power = 3,
    toughness = 3})
