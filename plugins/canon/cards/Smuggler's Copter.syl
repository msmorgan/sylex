card singleFaced({
    name = "Smuggler's Copter",
    cost = [generic(2)],
    types = [artifact],
    subtypes = [vehicle],
    text = [
      flying,
      whenever(
        or([does(actor(thisVehicle), attack), does(actor(thisVehicle), block)]),
        action = may(draw(lit(1)), discard(a(cardIn(yourHand))))),
      crew(lit(1))],
    power = lit(3),
    toughness = lit(3)})
