card {
  name = "Gather Specimens",
  cost = [generic(3), pip(blue), pip(blue), pip(blue)],
  types = [instant],
  text = [
    spell(
      establishThroughout(
        replace(
          would(actor(a(isCreature)), enter(riders = [under(anOpponent)])),
          instead(instruct(it, enter(riders = [under(you)])))),
        thisTurn))]
}
