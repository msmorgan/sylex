card singleFaced({
    name = "Gather Specimens",
    cost = [generic(3), pip(blue), pip(blue), pip(blue)],
    types = [instant],
    text = [
      spell(
        establishThroughout(
          replace(
            would(actor(a(creature)), enter(riders = [underControlOf(anOpponent)])),
            instead(instruct(it, enter(riders = [underControlOf(you)])))),
          thisTurn))]})
