card singleFaced({
    name = "Crack in Time",
    cost = [generic(3), pip(white)],
    types = [enchantment],
    text = [
      vanishing(3),
      triggered(
        and([when(does(actor(thisEnchantment), enter)), at(beginningOfYour(firstMain))]),
        action = exileUntil(
          target(and([isCreature, anOpponentControls])),
          does(actor(thisEnchantment), leave)))]})
