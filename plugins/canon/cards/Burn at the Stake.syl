card singleFaced({
    name = "Burn at the Stake",
    cost = [generic(2), pip(red), pip(red), pip(red)],
    types = [sorcery],
    text = [
      static(
        addedCost(
          this(spell),
          mandatory,
          plusAdditional(
            perform(
              tap(counted(anyNumber, nominal(pre = [untapped], creature, post = [youControl]))))))),
      spell(
        instruct(
          ownName,
          dealDamage(
            amount = times(
              3,
              countOf(nominal(creature, post = [was(tap(which), within = thisWay)]))),
            recipient = target(anyTarget))))]})
