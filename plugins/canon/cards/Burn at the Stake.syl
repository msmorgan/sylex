card singleFaced({
    name = "Burn at the Stake",
    cost = [generic(2), pip(red), pip(red), pip(red)],
    types = [sorcery],
    text = [
      static(
        addedCost(
          this,
          mandatory,
          plusAdditional(
            perform(
              tap(counted(anyNumber, nominal(pre = [untapped], creature, post = [youControl]))))))),
      spell(
        instruct(this, dealDamage(amount = times(3, groupSize), recipient = target(anyTarget))))]})
