card {
  name = "Burn at the Stake",
  cost = [2, red, red, red],
  types = [sorcery],
  text = [
    static(
      addedCost(
        perform(tap(counted(anyNumber, and([isCreature, youControl, isUntapped])))),
        false)),
    spell(instruct(this, dealDamage(times(3, groupSize), target(isAnyTarget))))]
}
