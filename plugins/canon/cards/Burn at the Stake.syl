card singleFaced({
    name = "Burn at the Stake",
    cost = [generic(2), pip(red), pip(red), pip(red)],
    types = [sorcery],
    text = [
      static(
        addedCost(
          this,
          mandatory,
          plusAdditional(
            perform(tap(counted(anyNumber, and([isCreature, youControl, isUntapped]))))))),
      spell(
        instruct(
          this,
          dealDamage(amount = times(3, groupSize), recipient = target(isAnyTarget))))]})
