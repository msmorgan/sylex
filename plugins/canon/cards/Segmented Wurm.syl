card singleFaced({
    name = "Segmented Wurm",
    cost = [generic(3), pip(red), pip(green)],
    types = [creature],
    subtypes = [wurm],
    text = [
      whenever(
        does(actor(a(or([isSpell, abilityHead(anyOnStack)]))), target(thisCreature)),
        putCounters(lit(1), printedKind(m1m1Counter), it))],
    power = lit(5),
    toughness = lit(5)})
