card flip(
  normal = {
    name = "Akki Lavarunner",
    cost = [generic(3), pip(red)],
    types = [creature],
    subtypes = [goblin, warrior],
    text = [
      haste,
      whenever(does(actor(thisCreature), dealDamage(recipient = anOpponent)), flip(thisCreature))],
    power = lit(1),
    toughness = lit(1)},
  alternative = {
    name = "Tok-Tok, Volcano Born",
    supertypes = [legendary],
    types = [creature],
    subtypes = [goblin, shaman],
    text = [
      protection(hasColor(red)),
      static(
        replace(
          would(actor(a(and([isSource, hasColor(red)]))), dealDamage(recipient = a(isPlayer))),
          instead(instruct(it, dealDamage(plus(thatMuch, lit(1)), that(player))))))],
    power = lit(2),
    toughness = lit(2)})
