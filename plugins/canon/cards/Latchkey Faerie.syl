card singleFaced({
    name = "Latchkey Faerie",
    cost = [generic(3), pip(blue)],
    types = [creature],
    subtypes = [faerie, rogue],
    text = [
      flying,
      prowl(mana([generic(2), pip(blue)])),
      when(
        does(actor(thisCreature), enter),
        if = keywordCostPaid(prowl, thisCreature),
        action = draw(1))],
    power = 3,
    toughness = 1})
