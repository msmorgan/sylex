card singleFaced({
    name = "Curator of Destinies",
    cost = [generic(4), pip(blue), pip(blue)],
    types = [creature],
    subtypes = [sphinx],
    text = [
      static(cant(any, counter(thisSpell))),
      flying,
      when(
        does(actor(thisCreature), enter),
        sequentially(
          steps = [
            lookAt(topSlice(5)),
            separateIntoPiles(them, 2, faces = [faceDown, faceUp]),
            instruct(anOpponent, choose(onePile)),
            putInto(that(pile), hand),
            putInto(theOther, graveyard)]))],
    power = 5,
    toughness = 5})
