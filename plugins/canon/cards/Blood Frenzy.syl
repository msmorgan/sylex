card singleFaced({
    name = "Blood Frenzy",
    cost = [generic(1), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially([
            get(
              target(and([isCreature, or([isAttacking, isBlocking])])),
              up(4),
              up(0),
              duration = untilEndOfTurn),
            atNext(beginningOfNext(endStep), destroy(that(creature)))]),
        timing = beforePart(combatDamage))]})
