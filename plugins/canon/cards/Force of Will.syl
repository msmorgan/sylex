card singleFaced({
    name = "Force of Will",
    cost = [generic(3), pip(blue), pip(blue)],
    types = [instant],
    text = [
      static(
        altCost(
          payingInstead(
            compound(
              costs = [
                perform(payLife(amount = 1)),
                perform(exile(a(and([hasColor(blue), in(yourHand)]))))])),
          this)),
      spell(counter(target(isSpell)))]})
