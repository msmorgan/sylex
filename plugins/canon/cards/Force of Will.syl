card singleFaced({
    name = "Force of Will",
    cost = [generic(3), pip(blue), pip(blue)],
    types = [instant],
    text = [
      static(
        altCost(
          payingInstead(
            compound(
              [perform(payLife(1)), perform(exile(a(and([hasColor(blue), in(yourHand)]))))])),
          this)),
      spell(counter(target(isSpell)))]})
