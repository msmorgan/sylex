# "From anywhere" observes Dread after its arrival in the graveyard.
card {
  name = "Dread",
  cost = [3, black, black, black],
  types = [creature],
  subtypes = [elemental, incarnation],
  text = [
    fear,
    whenever(does(actor(a(isCreature)), dealDamage(recipient = you)), destroy(it)),
    when(
      does(any, putInto(this, graveyard, from = anyLocation)),
      instruct(ownerOf(it), shuffleInto(it)))],
  power = 6,
  toughness = 6
}
