# "From anywhere" observes Dread after its arrival in the graveyard.
card singleFaced({
    name = "Dread",
    cost = [generic(3), pip(black), pip(black), pip(black)],
    types = [creature],
    subtypes = [elemental, incarnation],
    text = [
      fear,
      whenever(does(actor(a(isCreature)), dealDamage(recipient = you)), destroy(it)),
      when(does(any, putInto(this, graveyard)), instruct(ownerOf(it), shuffleInto(it)))],
    power = 6,
    toughness = 6})
