card singleFaced({
    name = "Conspicuous Snoop",
    cost = [pip(red), pip(red)],
    types = [creature],
    subtypes = [goblin, rogue],
    text = [
      static(visibility(reveal, you, topOfLibrary)),
      static(can(actor(you), play(bare(nominal(pre = [goblin], spell)), from = onTop))),
      static(
        asLongAs(
          is(topSlice(1), a(nominal(pre = [goblin], card))),
          abilityGrantFrom(this(creature), [anyActivated], topSlice(1))))],
    power = 2,
    toughness = 2})
