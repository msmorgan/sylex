card {
  name = "Seraphic Greatsword",
  cost = [generic(1), pip(white)],
  types = [artifact],
  subtypes = [equipment],
  text = [
    static(getsPt(equipped(creature), up(lit(2)), up(lit(2)))),
    whenever(
      does(
        actor(equipped(creature)),
        attack(a(and([isPlayer, superlative(max, playerStat(lifeTotal), isPlayer)])))),
      createTappedAttacking(
        lit(1),
        {
          characteristics = {
            colors = [white],
            types = [creature],
            subtypes = [angel],
            text = [flying],
            power = lit(4),
            toughness = lit(4)}},
        that(player))),
    equip(mana([generic(4)]))]
}
