card singleFaced({
    name = "Coat of Arms",
    cost = [generic(5)],
    types = [artifact],
    text = [
      static(
        getsBoth(
          each(creature),
          up(
            forEach(
              1,
              nominal(
                pre = [other],
                creature,
                post = [in(battlefield), shares(subtype(creature), share, it)])))))]})
