card singleFaced({
    name = "Dance of the Dead",
    cost = [generic(1), pip(black)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(and([hasType(creature), isCard, in(graveyard)])),
      when(
        does(actor(this(aura)), enter),
        if = is(it, in(battlefield)),
        sequentially([
            establish(
              conjunction([
                  abilityLoss(
                    it,
                    [written(enchant(and([hasType(creature), isCard, in(graveyard)])))]),
                  abilityGrant(
                    it,
                    [
                      enchant(
                        and(
                          [hasType(creature), did(by(this(aura)), putOntoBattlefield(which))]))])],
                subject = it)),
            putOntoBattlefield(
              enchanted(nominal(pre = [creature], card)),
              riders = [entersAs(tapped), underControlOf(you)]),
            attachTo(this(aura), it),
            delay(
              does(actor(this(aura)), leave),
              instruct(controllerOf(that(creature)), sacrifice(it)))])),
      static(
        conjunction(
          [getsPt(enchanted(creature), up(1), up(1)), doesntUntap(it, controllerOf(it))],
          subject = enchanted(creature))),
      at(
        beginningOfPossessed(controllerOf(enchanted(creature)), upkeep),
        instruct(
          that(player),
          may(
            pay(payment(mana([generic(1), pip(black)])), once),
            ifDid = untap(that(creature)))))]})
