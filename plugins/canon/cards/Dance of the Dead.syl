card singleFaced({
    name = "Dance of the Dead",
    cost = [generic(1), pip(black)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(and([isCreature, isCard, in(graveyard)])),
      when(
        does(actor(thisAura), enter),
        if = is(it, in(battlefield)),
        sequentially([
            establish(
              conjunction([
                  abilityLoss(it, [written(enchant(and([isCreature, isCard, in(graveyard)])))]),
                  abilityGrant(
                    it,
                    [enchant(and([isCreature, did(by(thisAura), putOntoBattlefield(which))]))])],
                subject = it)),
            putOntoBattlefield(
              enchanted(ofType(card, creature)),
              riders = [entersAs(tapped), under(you)]),
            attachTo(thisAura, it),
            delay(
              does(actor(thisAura), leave),
              instruct(controllerOf(that(creature)), sacrifice(it)))])),
      static(
        conjunction(
          [getsPt(enchanted(creature), up(1), up(1)), doesntUntap(it, controllerOf(it))],
          subject = enchanted(creature))),
      at(
        beginningOfPossessed(controllerOf(enchanted(creature)), upkeep),
        instruct(
          that(player),
          may(pay(mana([generic(1), pip(black)]), once), ifDid = untap(that(creature)))))]})
