card singleFaced({
    name = "Branching Evolution",
    cost = [generic(2), pip(green)],
    types = [enchantment],
    text = [
      static(
        replace(
          would(
            any,
            putCounters(
              anyAmount,
              printedKind(p1p1Counter),
              a(nominal(creature, post = [youControl])))),
          instead(putCounters(times(2, thatMany), printedKind(p1p1Counter), that(creature)))))]})
