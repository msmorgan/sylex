card singleFaced({
    name = "Chrome Mox",
    cost = [],
    types = [artifact],
    text = [
      imprint(
        when(
          does(actor(this(artifact)), enter),
          may(exile(a(nominal(pre = [non(artifact), non(land)], card, post = [in(yourHand)])))))),
      activated(
        tapSymbol,
        addMana(counted(1, ofAnyColorOf(the(nominal(pre = [was(exile(which))], card))))))]})
