card singleFaced({
    name = "Ancestral Blade",
    cost = [generic(1), pip(white)],
    types = [artifact],
    subtypes = [equipment],
    text = [
      when(
        does(actor(thisEquipment), enter),
        sequentially(
          steps = [
            create(1, written(creatureToken(1, 1, [white], [soldier]))),
            attachTo(thisEquipment, thatToken)])),
      static(getsPt(equipped(creature), up(1), up(1))),
      equip(mana([generic(1)]))]})
