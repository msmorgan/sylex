card singleFaced({
    name = "Ichor Shade",
    cost = [generic(2), pip(black)],
    types = [creature],
    subtypes = [phyrexian, shade],
    text = [
      at(
        beginningOfYour(endStep),
        if = was(
          putInto(a(or([isArtifact, isCreature])), graveyard, from = battlefield),
          within(soFarThisTurn)),
        action = putCounters(1, printedKind(p1p1Counter), thisCreature))],
    power = 2,
    toughness = 3})
