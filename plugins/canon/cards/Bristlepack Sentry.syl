card singleFaced({
    name = "Bristlepack Sentry",
    cost = [generic(1), pip(green)],
    types = [creature],
    subtypes = [plant, wolf],
    text = [
      defender,
      static(
        asLongAs(
          exists(and([isCreature, youControl, hasPower(atLeast, 4)])),
          can(
            actor(thisCreature),
            attack,
            asThough = holds(is(it, not(hasKeyword(theKeyword(defender))))))))],
    power = 3,
    toughness = 3})
