card {
  name = "Arrest",
  cost = [2, white],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
          cant(actor(enchanted(creature)), attack),
          cant(actor(enchanted(creature)), block),
          cant(any, activate(allOf(and([abilityHead(anyActivated), abilityOf(it)]))))]))]
}
