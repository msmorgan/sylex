card singleFaced({
    name = "Arrest",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(
        conjunction([
            cant(actor(enchanted(creature)), attack),
            cant(actor(enchanted(creature)), block),
            cant(any, activate(possessive(it, abilityHead(anyActivated))))]))]})
