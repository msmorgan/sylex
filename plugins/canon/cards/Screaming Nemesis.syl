card singleFaced({
    name = "Screaming Nemesis",
    cost = [generic(2), pip(red)],
    types = [creature],
    subtypes = [spirit],
    text = [
      haste,
      whenever(
        does(any, dealDamage(recipient = this(creature))),
        sequentially([
            instruct(
              it,
              dealDamage(amount = thatMuch, recipient = target(nominal(pre = [other], anyTarget)))),
            doIf(
              was(dealDamage(recipient = a(player)), thisWay),
              establishThroughout(cant(actor(they), gainLife(anyAmount)), restOfGame))]))],
    power = 3,
    toughness = 3})
