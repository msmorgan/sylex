card singleFaced({
    name = "Encroaching Mycosynth",
    cost = [generic(3), pip(blue)],
    types = [artifact],
    text = [
      static(
        qualityChange(
          and([
              allOf(nominal(pre = [non(land)], permanent, post = [youControl])),
              allOf(nominal(pre = [permanent], spell, post = [youControl])),
              allOf(
                nominal(
                  pre = [non(land), permanent],
                  card,
                  post = [youOwn, not(in(battlefield))]))]),
          adds,
          bundle({characteristics = {types = [artifact]}})))]})
