# Pins the planeswalker entry conferral [CR#306.5b] and loyalty costs
# [CR#606.4], with loyalty-ability timing and the once-per-turn restriction [CR#606.3].
# Zero loyalty puts the planeswalker into its owner’s graveyard [CR#704.5i].
card singleFaced({
    name = "Jace Beleren",
    cost = [generic(1), pip(blue), pip(blue)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [jace],
    text = [
      activated(loyaltySymbol(up(lit(2))), instruct(eachPlayer, draw(lit(1)))),
      activated(loyaltySymbol(down(lit(1))), instruct(target(isPlayer), draw(lit(1)))),
      activated(loyaltySymbol(down(lit(10))), instruct(target(isPlayer), mill(lit(20))))],
    loyalty = lit(3)})
