card singleFaced({
    name = "Ghosts of the Innocent",
    cost = [generic(5), pip(white), pip(white)],
    types = [creature],
    subtypes = [spirit],
    text = [
      static(
        replace(
          would(actor(a(isSource)), dealDamage(recipient = a(or([isPermanent, isPlayer])))),
          instead(instruct(it, dealDamage(amount = half(down, thatMuch), recipient = thatJoin)))))],
    power = 4,
    toughness = 5})
