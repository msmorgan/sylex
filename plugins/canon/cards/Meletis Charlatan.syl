card singleFaced({
    name = "Meletis Charlatan",
    cost = [generic(2), pip(blue)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      activated(
        compound([mana([generic(2), pip(blue)]), tapSymbol]),
        sequentially([
            instruct(
              controllerOf(target(nominal(pre = [or([instant, sorcery])], spell))),
              copyOnStack(it)),
            instruct(that(player), may(chooseNewTargets(that(copy))))]))],
    power = 2,
    toughness = 3})
