card transforming(
  front = {
    name = "Neglected Heirloom",
    cost = [generic(1)],
    types = [artifact],
    subtypes = [equipment],
    text = [
      static(getsPt(equipped(creature), up(lit(1)), up(lit(1)))),
      when(does(any, turnOver(equipped(creature))), transform(thisEquipment)),
      equip(mana([generic(1)]))]},
  back = {
    name = "Ashmouth Blade",
    types = [artifact],
    subtypes = [equipment],
    text = [
      static(
        conjunction(
          [getsPt(equipped(creature), up(lit(3)), up(lit(3))), abilityGrant(it, firstStrike)])),
      equip(mana([generic(3)]))]})
