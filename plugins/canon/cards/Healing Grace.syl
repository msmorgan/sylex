card singleFaced({
    name = "Healing Grace",
    cost = [pip(white)],
    types = [instant],
    text = [
      spell(
        sequentially([
            establishThroughout(
              replace(
                would(by(aYourChoice(isSource)), dealDamage(recipient = target(isAnyTarget))),
                instead(preventDamage(theNext(3)))),
              thisTurn),
            gainLife(3)]))]})
