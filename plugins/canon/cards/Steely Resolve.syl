card singleFaced({
    name = "Steely Resolve",
    cost = [generic(1), pip(green)],
    types = [enchantment],
    text = [
      static(entersChoosing(thisEnchantment, subtype(creature))),
      static(
        abilityGrant(allOf(nominal(creature, post = [ofChosen(subtype(creature))])), [shroud]))]})
