card singleFaced({
    name = "Verity Circle",
    cost = [generic(2), pip(blue)],
    types = [enchantment],
    text = [
      whenever(
        does(actor(a(nominal(creature, post = [anOpponentControls]))), setStatus(tapped, subject)),
        if = is(it, not(inCombat(declaredAttacker))),
        may(draw(1))),
      activated(
        mana([generic(4), pip(blue)]),
        tap(target(nominal(creature, post = [withoutKeyword(theKeyword(flying))]))))]})
