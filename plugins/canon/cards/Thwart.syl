card singleFaced({
    name = "Thwart",
    cost = [generic(2), pip(blue), pip(blue)],
    types = [instant],
    text = [
      static(
        altCost(
          payingInstead(
            perform(
              returnToHand(counted(exactly(3), and([isLand, hasSubtype(island), youControl]))))),
          this)),
      spell(counter(target(isSpell)))]})
