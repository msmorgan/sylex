card singleFaced({
    name = "Pariah",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        replace(
          would(any, dealDamage(recipient = you)),
          instead(redirectDamage(allDamage, enchanted(creature)))))]})
