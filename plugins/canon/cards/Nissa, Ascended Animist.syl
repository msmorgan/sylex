card singleFaced({
    name = "Nissa, Ascended Animist",
    cost = [generic(3), pip(green), pip(green), phyrexianPip(green), phyrexianPip(green)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [nissa],
    text = [
      compleated,
      activated(
        loyaltySymbol(up(lit(1))),
        sequentially([
            create(
              lit(1),
              written(creatureTokenOf(letter(x), letter(x), [green], [phyrexian, horror]))),
            define(x, statOf(stat(loyalty), thisPlaneswalker))])),
      activated(loyaltySymbol(down(lit(1))), destroy(target(or([isArtifact, isEnchantment])))),
      activated(
        loyaltySymbol(down(lit(7))),
        establishFor(
          allOf(and([isCreature, youControl])),
          [
            getsBoth(them, up(forEach(lit(1), and([hasSubtype(forest), youControl])))),
            abilityGrant(them, trample)],
          untilEndOfTurn))],
    loyalty = lit(7)})
