card singleFaced({
    name = "Nissa, Ascended Animist",
    cost = [generic(3), pip(green), pip(green), phyrexianPip(green), phyrexianPip(green)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [nissa],
    text = [
      compleated,
      activated(
        loyaltySymbol(up(1)),
        sequentially([
            create(1, written(creatureTokenOf(letter(x), letter(x), [green], [phyrexian, horror]))),
            define(x, statOf(stat(loyalty), shortenedName))])),
      activated(loyaltySymbol(down(1)), destroy(target(or([artifact, enchantment])))),
      activated(
        loyaltySymbol(down(7)),
        establishFor(
          bare(nominal(creature, post = [youControl])),
          [
            getsBoth(them, up(forEach(1, nominal(forest, post = [youControl])))),
            abilityGrant(them, [trample])],
          duration = untilEndOfTurn))],
    loyalty = 7})
