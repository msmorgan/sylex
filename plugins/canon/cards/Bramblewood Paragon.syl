card singleFaced({
    name = "Bramblewood Paragon",
    cost = [generic(1), pip(green)],
    types = [creature],
    subtypes = [elf, warrior],
    text = [
      static(
        entersWithAdditionalCounters(
          each(nominal(pre = [other, warrior], creature, post = [youControl])),
          1,
          p1p1Counter)),
      static(
        abilityGrant(
          each(nominal(creature, post = [youControl, withCounter(kind = p1p1Counter)])),
          [trample]))],
    power = 2,
    toughness = 2})
