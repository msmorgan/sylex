card singleFaced({
    name = "Inferno of the Star Mounts",
    cost = [generic(4), pip(red), pip(red)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [dragon],
    text = [
      static(cant(any, counter(this))),
      flying,
      haste,
      activated(
        mana([pip(red)]),
        triggerThisWay(
          get(thisCreature, up(1), up(0), duration = untilEndOfTurn),
          stateHolds(compareAmt(powerOf(it), equal, 20)),
          instruct(it, dealDamage(amount = 20, recipient = target(isAnyTarget)))))],
    power = 6,
    toughness = 6})
