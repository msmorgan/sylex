card singleFaced({
    name = "Agate-Blade Assassin",
    cost = [generic(1), pip(black)],
    types = [creature],
    subtypes = [lizard, assassin],
    text = [
      whenever(
        does(actor(thisCreature), attack),
        sequentially(steps = [instruct(defendingPlayer, loseLife(1)), gainLife(1)]))],
    power = 1,
    toughness = 3})
