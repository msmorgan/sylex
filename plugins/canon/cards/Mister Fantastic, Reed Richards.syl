card singleFaced({
    name = "Mister Fantastic, Reed Richards",
    cost = [generic(3), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, scientist, hero],
    text = [
      reach,
      whenever(
