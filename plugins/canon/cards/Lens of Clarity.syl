card singleFaced({
    name = "Lens of Clarity",
    cost = [generic(1)],
    types = [artifact],
    text = [
      static(
        conjunction([
            visibility(lookAt, you, topOfLibrary),
            visibility(
              lookAt,
              you,
              objects(allOf(and([isCreature, isFaceDown, youDontControl]))))]))]})
