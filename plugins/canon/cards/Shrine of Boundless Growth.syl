card singleFaced({
    name = "Shrine of Boundless Growth",
    cost = [generic(3)],
    types = [artifact],
    text = [
      triggered(
        and([
            at(beginningOfYour(upkeep)),
            whenever(does(actor(you), cast(a(and([isSpell, hasColor(green)])))))]),
        action = putCounters(1, printedKind(chargeCounter), thisArtifact)),
      activated(
        compound([tapSymbol, perform(sacrifice(thisArtifact))]),
        addMana(
          counted(times(1, countersOn(chargeCounter, thisArtifact)), symbols([colorlessPip]))))]})
