card singleFaced({
    name = "Shrine of Boundless Growth",
    cost = [generic(3)],
    types = [artifact],
    text = [
      triggered(
        and([
            at(beginningOfYour(upkeep)),
            whenever(does(actor(you), cast(a(nominal(pre = [green], spell)))))]),
        putCounters(1, printedKind(chargeCounter), this(artifact))),
      activated(
        compound([tapSymbol, perform(sacrifice(this(artifact)))]),
        addMana(
          counted(times(1, countersOn(chargeCounter, this(artifact))), symbols([colorlessPip]))))]})
