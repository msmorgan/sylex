card singleFaced({
    name = "Stone Haven Outfitter",
    cost = [generic(1), pip(white)],
    types = [creature],
    subtypes = [kor, artificer, ally],
    text = [
      static(
        getsPt(
          allOf(and([and([isCreature, youControl]), isAttached(equipped)])),
          up(lit(1)),
          up(lit(1)))),
      whenever(
        does(actor(a(and([and([isCreature, youControl]), isAttached(equipped)]))), die),
        draw(lit(1)))],
    power = lit(2),
    toughness = lit(2)})
