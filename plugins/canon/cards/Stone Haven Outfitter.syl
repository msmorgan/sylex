card singleFaced({
    name = "Stone Haven Outfitter",
    cost = [generic(1), pip(white)],
    types = [creature],
    subtypes = [kor, artificer, ally],
    text = [
      static(
        getsPt(
          allOf(and([and([isCreature, youControl]), isAttached(word = equipped)])),
          up(1),
          up(1))),
      whenever(
        does(actor(a(and([and([isCreature, youControl]), isAttached(word = equipped)]))), die),
        draw(1))],
    power = 2,
    toughness = 2})
