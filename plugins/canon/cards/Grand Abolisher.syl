card singleFaced({
    name = "Grand Abolisher",
    cost = [pip(white), pip(white)],
    types = [creature],
    subtypes = [human, cleric],
    text = [
      static(
        partScope(
          you,
          turn,
          conjunction([
              cant(actor(yourOpponents), cast(bare(spell))),
              cant(
                actor(yourOpponents),
                activate(
                  allOf(
                    nominal(
                      abilityHead(anyActivated),
                      post = [ofSource(allOf(or([artifact, creature, enchantment])))]))))])))],
    power = 2,
    toughness = 2})
