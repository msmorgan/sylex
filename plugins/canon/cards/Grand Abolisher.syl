card singleFaced({
    name = "Grand Abolisher",
    cost = [pip(white), pip(white)],
    types = [creature],
    subtypes = [human, cleric],
    text = [
      static(
        partScope(
          turn,
          you,
          conjunction([
              cant(actor(yourOpponents), cast(bare(isSpell))),
              cant(
                actor(yourOpponents),
                activate(
                  allOf(
                    and([
                        abilityHead(anyActivated),
                        abilityOf(allOf(or([isArtifact, isCreature, isEnchantment])))]))))])))],
    power = lit(2),
    toughness = lit(2)})
