card sharedLineSplit(
  {types = [enchantment], subtypes = [room]},
  {
    name = "Glassworks",
    cost = [generic(2), pip(red)],
    text = [
      when(
        does(actor(you), unlock(thisDoor)),
        instruct(
          this(room),
          dealDamage(
            amount = 4,
            recipient = target(nominal(creature, post = [anOpponentControls])))))]},
  {
    name = "Shattered Yard",
    cost = [generic(4), pip(red)],
    text = [
      at(
        beginningOfYour(endStep),
        instruct(this(room), dealDamage(amount = 1, recipient = eachOpponent)))]})
