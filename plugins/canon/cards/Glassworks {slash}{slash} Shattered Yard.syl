card sharedLineSplit(
  {types = [enchantment], subtypes = [room]},
  {
    name = "Glassworks",
    cost = [generic(2), pip(red)],
    text = [
      when(
        does(actor(you), unlock(thisDoor)),
        instruct(
          thisRoom,
          dealDamage(amount = 4, recipient = target(and([isCreature, anOpponentControls])))))]},
  {
    name = "Shattered Yard",
    cost = [generic(4), pip(red)],
    text = [
      at(
        beginningOfYour(endStep),
        instruct(thisRoom, dealDamage(amount = 1, recipient = eachOpponent)))]})
