card singleFaced({
    name = "Doubling Season",
    cost = [generic(4), pip(green)],
    types = [enchantment],
    text = [
      static(
        replace(
          causedBy(
            byAnEffect,
            would(
              any,
              createObject(anyAmount, token(copyOf(counted(orMore(1), token)), []), under = you))),
          instead(create(times(2, thatMany), asThose)))),
      static(
        replace(
          causedBy(
            byAnEffect,
            would(
              any,
              putCounters(anyAmount, anyKind, a(nominal(permanent, post = [youControl]))))),
          instead(putCounters(times(2, thatMany), thoseCounters, that(permanent)))))]})
