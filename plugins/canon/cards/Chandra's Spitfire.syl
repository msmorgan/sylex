card singleFaced({
    name = "Chandra's Spitfire",
    cost = [generic(2), pip(red)],
    types = [creature],
    subtypes = [elemental],
    text = [
      flying,
      whenever(
        does(any, dealDamage(kind = noncombat, recipient = anOpponent)),
        get(this(creature), up(3), up(0), duration = untilEndOfTurn))],
    power = 1,
    toughness = 3})
