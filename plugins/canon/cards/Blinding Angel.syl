card singleFaced({
    name = "Blinding Angel",
    cost = [generic(3), pip(white), pip(white)],
    types = [creature],
    subtypes = [angel],
    text = [
      flying,
      whenever(
        does(actor(thisCreature), dealDamage(recipient = a(isPlayer), kind = combat)),
        instruct(that(player), skipPart(combat, 1)))],
    power = 2,
    toughness = 4})
