card singleFaced({
    name = "Blinding Angel",
    cost = [generic(3), pip(white), pip(white)],
    types = [creature],
    subtypes = [angel],
    text = [
      flying,
      whenever(
        does(actor(this(creature)), dealDamage(kind = combat, recipient = a(player))),
        instruct(that(player), skipPart(combat, 1)))],
    power = 2,
    toughness = 4})
