card singleFaced({
    name = "Mishra's Factory",
    types = [land],
    text = [
      activated(tapSymbol, addMana(symbols([colorlessPip]))),
      activated(
        mana([generic(1)]),
        establishThroughout(
          qualityChange(
            thisLand,
            sets,
            bundle({
                characteristics = {
                  types = [artifact, creature],
                  subtypes = [assemblyWorker],
                  power = 2,
                  toughness = 2}},
              retained = land)),
          untilEndOfTurn)),
      activated(
        tapSymbol,
        get(
          target(and([isCreature, hasSubtype(assemblyWorker)])),
          up(1),
          up(1),
          duration = untilEndOfTurn))]})
