card singleFaced({
    name = "Idol of Oblivion",
    cost = [generic(2)],
    types = [artifact],
    text = [
      activatedOnlyIf(
        tapSymbol,
        draw(1),
        did(
          actor(you),
          createObject(anyAmount, token(copyOf(a(isToken)), [])),
          within(soFarThisTurn))),
      activated(
        compound(costs = [mana([generic(8)]), tapSymbol, perform(sacrifice(thisArtifact))]),
        create(1, written(creatureToken(10, 10, [], [eldrazi]))))]})
