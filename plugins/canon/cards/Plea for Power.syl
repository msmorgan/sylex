card singleFaced({
    name = "Plea for Power",
    cost = [generic(3), pip(blue)],
    types = [sorcery],
    text = [
      willOfTheCouncil(
        spell(
          sequentially([
              instruct(eachPlayer, voteStartingWith(you, openly, byLabel(["time", "knowledge"]))),
              doIf(getsMoreVotes("time"), extraTurn(lit(1))),
              doIf(getsMoreVotesOrTied("knowledge"), draw(lit(3)))])))]})
