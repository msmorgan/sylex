card singleFaced({
    name = "Pledge of Loyalty",
    cost = [generic(1), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(
        conjunction([
            abilityGrant(
              enchanted(creature),
              [
                protection(
                  eachKind(color, domain = allOf(nominal(permanent, post = [youControl]))))]),
            doesnt(actor(thisEffect), remove(thisAura))]))]})
