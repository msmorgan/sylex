card singleFaced({
    name = "Death or Glory",
    cost = [generic(4), pip(white)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            separateIntoPiles(
              allOf(nominal(pre = [creature], card, post = [in(yourGraveyard)])),
              2),
            exile(pileOfChoice(anOpponent)),
            returnToBattlefield(theOther)]))]})
