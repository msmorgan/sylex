card singleFaced({
    name = "Retro-Mutation",
    cost = [generic(2), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      flash,
      enchant(isCreature),
      static(
        conjunction([
            qualityChange(
              enchanted(creature),
              sets,
              bundle({characteristics = {subtypes = [turtle]}})),
            getsBase(it, lit(0), lit(1)),
            cant(actor(it), attack),
            allAbilityLoss(it)]))]})
