card {
  name = "Divine Visitation",
  cost = [generic(3), pip(white), pip(white)],
  types = [enchantment],
  text = [
    static(
      replace(
        would(
          any,
          createObject(
            anyAmount,
            token(copyOf(counted(orMore(1), and([isCreature, isToken]))), []),
            you)),
        instead(
          create(
            groupSize,
            written({
                characteristics = {
                  colors = [white],
                  types = [creature],
                  subtypes = [angel],
                  text = [flying, vigilance],
                  power = lit(4),
                  toughness = lit(4)}})))))]
}
