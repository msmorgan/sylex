card singleFaced({
    name = "Reckless Cohort",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [human, warrior, ally],
    text = [
      static(
        must(
          actor(this(creature)),
          attack,
          unless = exists(nominal(pre = [other], ally, post = [youControl]))))],
    power = 2,
    toughness = 2})
