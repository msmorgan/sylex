card transforming(
  front = {
    name = "Midnight Scavengers",
    cost = [generic(4), pip(black)],
    types = [creature],
    subtypes = [human, rogue],
    text = [
      when(
        does(actor(thisCreature), enter),
        may(
          returnToHand(
            target(and([isCreature, in(yourGraveyard), hasManaValue(atMost, lit(3))])),
            yourGraveyard)))],
    power = lit(3),
    toughness = lit(3)},
  back = {
    name = "Chittering Host",
    types = [creature],
    subtypes = [eldrazi, horror],
    text = [
      haste,
      menace,
      when(
        does(actor(thisCreature), enter),
        establishFor(
          allOf(and([isCreature, youControl, isOther])),
          [getsPt(them, up(lit(1)), up(lit(0))), abilityGrant(them, menace)],
          untilEndOfTurn))],
    power = lit(5),
    toughness = lit(6)})
