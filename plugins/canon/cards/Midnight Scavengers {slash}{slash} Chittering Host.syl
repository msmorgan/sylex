card transforming({
    name = "Midnight Scavengers",
    cost = [generic(4), pip(black)],
    types = [creature],
    subtypes = [human, rogue],
    text = [
      when(
        does(actor(this(creature)), enter),
        may(
          returnToHand(
            target(
              nominal(pre = [creature], card, post = [hasManaValue(atMost, 3), in(yourGraveyard)])),
            from = yourGraveyard)))],
    power = 3,
    toughness = 3},
  {
    name = "Chittering Host",
    types = [creature],
    subtypes = [eldrazi, horror],
    text = [
      haste,
      menace,
      when(
        does(actor(this(creature)), enter),
        establishFor(
          bare(nominal(pre = [other], creature, post = [youControl])),
          [getsPt(them, up(1), up(0)), abilityGrant(them, [menace])],
          duration = untilEndOfTurn))],
    power = 5,
    toughness = 6})
