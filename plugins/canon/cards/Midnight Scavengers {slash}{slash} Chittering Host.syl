card transforming(
  front = {
    name = "Midnight Scavengers",
    cost = [generic(4), pip(black)],
    types = [creature],
    subtypes = [human, rogue],
    text = [
      when(
        does(actor(thisCreature), enter),
        may(
          returnToHand(
            target(and([isCreature, in(yourGraveyard), hasManaValue(atMost, 3)])),
            yourGraveyard)))],
    power = 3,
    toughness = 3},
  back = {
    name = "Chittering Host",
    types = [creature],
    subtypes = [eldrazi, horror],
    text = [
      haste,
      menace,
      when(
        does(actor(thisCreature), enter),
        establishFor(
          allOf(and([isCreature, youControl, isOther])),
          [getsPt(them, up(1), up(0)), abilityGrant(them, menace)],
          untilEndOfTurn))],
    power = 5,
    toughness = 6})
