card singleFaced({
    name = "Tidal Flats",
    cost = [pip(blue)],
    types = [enchantment],
    text = [
      activated(
        mana([pip(blue), pip(blue)]),
        doForEach(
          each(nominal(pre = [attacking], creature, post = [not(hasKeyword(theKeyword(flying)))])),
          instruct(
            controllerOf(it),
            doUnless(
              mana([generic(1)]),
              instruct(
                you,
                gain(
                  bare(
                    nominal(
                      creature,
                      post = [youControl, inCombat(blockerOf, counterpart = that(creature))])),
                  [firstStrike],
                  duration = untilEndOfTurn))))))]})
