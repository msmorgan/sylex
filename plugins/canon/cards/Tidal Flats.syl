card singleFaced({
    name = "Tidal Flats",
    cost = [pip(blue)],
    types = [enchantment],
    text = [
      activated(
        mana([pip(blue), pip(blue)]),
        doForEach(
          each(and([isCreature, isAttacking, not(hasKeyword(theKeyword(flying)))])),
          instruct(
            controllerOf(it),
            doUnless(
              instruct(
                you,
                gain(
                  allOf(
                    and(
                      [isCreature, youControl, inCombat(blockerOf, counterpart = that(creature))])),
                  [firstStrike],
                  duration = untilEndOfTurn)),
              mana([generic(1)])))))]})
