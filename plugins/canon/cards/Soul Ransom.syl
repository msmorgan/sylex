card singleFaced({
    name = "Soul Ransom",
    cost = [generic(2), pip(blue), pip(black)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(controlGrant(you, enchanted(creature))),
      activatedBy(
        perform(
          repeatTimes(
            sequentially([choose(a(nominal(card, post = [in(hand)]))), discard(that(card))]),
            2)),
        sequentially([instruct(controllerOf(this(aura)), sacrifice(it)), instruct(they, draw(2))]),
        yourOpponents)]})
