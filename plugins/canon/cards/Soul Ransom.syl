card singleFaced({
    name = "Soul Ransom",
    cost = [generic(2), pip(blue), pip(black)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(controlGrant(you, enchanted(creature))),
      activatedBy(
        perform(
          repeatTimes(2, sequentially(steps = [choose(a(cardIn(hand))), discard(that(card))]))),
        sequentially(
          steps = [instruct(controllerOf(thisAura), sacrifice(it)), instruct(they, draw(2))]),
        yourOpponents)]})
