# "Whenever this creature becomes the target of a spell or ability for the first time each turn,
# put a +1/+1 counter on it": "for the first time each turn" watches only the first matching trigger
# event each turn, and "it" in the effect resolves to `thisCreature` rather than the targeting spell
# or ability.
card singleFaced({
    name = "Angelic Cub",
    cost = [generic(1), pip(white)],
    types = [creature],
    subtypes = [cat, angel],
    text = [
      whenever(
        nthOccurrence(
          nth(1),
          does(actor(a(or([isSpell, abilityHead(anyOnStack)]))), target(thisCreature)),
          turn),
        putCounters(1, printedKind(p1p1Counter), it)),
      static(
        asLongAs(
          compareAmt(countersOn(p1p1Counter, thisCreature), atLeast, 3),
          abilityGrant(it, [flying])))],
    power = 1,
    toughness = 1})
