card singleFaced({
    name = "Chillerpillar",
    cost = [generic(3), pip(blue)],
    supertypes = [snow],
    types = [creature],
    subtypes = [insect],
    text = [
      activated(mana([generic(4), snow, snow]), monstrosity(2)),
      static(asLongAs(is(this(creature), hasDesignation(monstrous)), abilityGrant(it, [flying])))],
