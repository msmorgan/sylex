card flip(
  normal = {
    name = "Orochi Eggwatcher",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [snake, shaman],
    text = [
      activated(
        compound([mana([generic(2), pip(green)]), tapSymbol]),
        sequentially([
            create(lit(1), written(creatureToken(1, 1, [green], [snake]))),
            doIf(
              compareAmt(countOf(and([isCreature, youControl])), atLeast, lit(10)),
              flip(thisCreature))]))],
    power = lit(1),
    toughness = lit(1)},
  alternative = {
    name = "Shidako, Broodmistress",
    supertypes = [legendary],
    types = [creature],
    subtypes = [snake, shaman],
    text = [
      activated(
        compound([mana([pip(green)]), perform(sacrifice(a(isCreature)))]),
        get(target(isCreature), up(lit(3)), up(lit(3)), untilEndOfTurn))],
    power = lit(3),
    toughness = lit(3)})
