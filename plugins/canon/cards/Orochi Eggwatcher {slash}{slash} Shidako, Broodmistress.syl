card flip({
    name = "Orochi Eggwatcher",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [snake, shaman],
    text = [
      activated(
        compound([mana([generic(2), pip(green)]), tapSymbol]),
        sequentially([
            create(1, written(creatureToken(1, 1, [green], [snake]))),
            doIf(
              compareAmt(countOf(nominal(creature, post = [youControl])), atLeast, 10),
              flip(this(creature)))]))],
    power = 1,
    toughness = 1},
  {
    name = "Shidako, Broodmistress",
    supertypes = [legendary],
    types = [creature],
    subtypes = [snake, shaman],
    text = [
      activated(
        compound([mana([pip(green)]), perform(sacrifice(a(creature)))]),
        get(target(creature), up(3), up(3), duration = untilEndOfTurn))],
    power = 3,
    toughness = 3})
