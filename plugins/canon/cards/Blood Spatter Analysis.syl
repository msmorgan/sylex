card singleFaced({
    name = "Blood Spatter Analysis",
    cost = [pip(black), pip(red)],
    types = [enchantment],
    text = [
      when(
        does(actor(thisEnchantment), enter),
        instruct(
          thisEnchantment,
          dealDamage(amount = 3, recipient = target(and([isCreature, anOpponentControls]))))),
      whenever(
        does(actor(counted(orMore(1), isCreature)), die),
        sequentially([
            mill(1),
            putCounters(1, printedKind(bloodstainCounter), thisEnchantment),
            triggerReflexively(
              doOnlyIf(
                sacrifice(thisEnchantment),
                compareAmt(countersOn(bloodstainCounter, thisEnchantment), atLeast, 5)),
              returnToHand(
                target(and([isCreature, isCard, in(yourGraveyard)])),
                from = yourGraveyard))]))]})
