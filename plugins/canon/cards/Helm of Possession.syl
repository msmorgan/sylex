card singleFaced({
    name = "Helm of Possession",
    cost = [generic(4)],
    types = [artifact],
    text = [
      static(mayDeclineUntap(thisArtifact, you)),
      activated(
        compound([mana([generic(2)]), tapSymbol, perform(sacrifice(a(isCreature)))]),
        gainControl(
          target(isCreature),
          forAsLongAs(and([is(thisArtifact, youControl), is(thisArtifact, isTapped)]))))]})
