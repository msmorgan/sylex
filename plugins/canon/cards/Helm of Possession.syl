card singleFaced({
    name = "Helm of Possession",
    cost = [generic(4)],
    types = [artifact],
    text = [
      static(mayDeclineUntap(this(artifact), you)),
      activated(
        compound([mana([generic(2)]), tapSymbol, perform(sacrifice(a(creature)))]),
        gainControl(
          target(creature),
          duration = forAsLongAs(
            and([controls(you, this(artifact)), is(this(artifact), tapped)]))))]})
