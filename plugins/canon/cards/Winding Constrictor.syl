card {
  name = "Winding Constrictor",
  cost = [pip(black), pip(green)],
  types = [creature],
  subtypes = [snake],
  text = [
    static(
      replace(
        would(
          any,
          putCounters(anyAmount, anyKind, a(and([or([isArtifact, isCreature]), youControl])))),
        instead(putCounters(plus(thatMuch, lit(1)), thoseCounters, that(permanent))))),
    static(
      replace(
        would(any, putCounters(anyAmount, anyKind, you)),
        instead(putCounters(plus(thatMuch, lit(1)), thoseCounters, you))))],
  power = lit(2),
  toughness = lit(3)
}
