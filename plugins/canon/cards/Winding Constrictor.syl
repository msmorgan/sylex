card singleFaced({
    name = "Winding Constrictor",
    cost = [pip(black), pip(green)],
    types = [creature],
    subtypes = [snake],
    text = [
      static(
        replace(
          would(
            any,
            putCounters(
              anyAmount,
              anyKind,
              a(nominal(or([artifact, creature]), post = [youControl])))),
          instead(putCounters(plus(thatMany, 1), thoseCounters, that(permanent))))),
      static(
        replace(
          would(any, putCounters(anyAmount, anyKind, you)),
          instead(putCounters(plus(thatMany, 1), thoseCounters, you))))],
    power = 2,
    toughness = 3})
