card singleFaced({
    name = "Floating Shield",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(entersChoosing(thisAura, color)),
      static(
        conjunction([
            abilityGrant(enchanted(creature), protection(ofChosen(color))),
            doesnt(actor(thisEffect), remove(thisAura))])),
      activated(
        perform(sacrifice(thisAura)),
        gain(target(isCreature), protection(ofChosen(color)), untilEndOfTurn))]})
