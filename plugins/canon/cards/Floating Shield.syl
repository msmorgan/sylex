card singleFaced({
    name = "Floating Shield",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(entersChoosing(this(aura), color)),
      static(
        conjunction([
            abilityGrant(enchanted(creature), [protection(ofChosen(color))]),
            doesnt(actor(thisEffect), remove(this(aura)))])),
      activated(
        perform(sacrifice(this(aura))),
        gain(target(creature), [protection(ofChosen(color))], duration = untilEndOfTurn))]})
