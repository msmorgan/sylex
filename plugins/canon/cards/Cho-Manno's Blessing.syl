card singleFaced({
    name = "Cho-Manno's Blessing",
    cost = [pip(white), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      flash,
      enchant(hasType(creature)),
      static(entersChoosing(this(aura), color)),
      static(
        conjunction([
            abilityGrant(enchanted(creature), [protection(ofChosen(color))]),
            doesnt(actor(thisEffect), remove(this(aura)))]))]})
