card singleFaced({
    name = "Cairn Wanderer",
    cost = [generic(4), pip(black)],
    types = [creature],
    subtypes = [shapeshifter],
    text = [
      changeling,
      alsoForKeywords(
        static(
          asLongAs(
            exists(and([isCreature, in(graveyard), hasKeyword(thatKeyword)])),
            keywordGrant(
              thisCreature,
              thatKeyword,
              and([isCreature, in(graveyard), hasKeyword(thatKeyword)])))),
        keywords = [
          theKeyword(flying),
          theKeyword(fear),
          theKeyword(firstStrike),
          theKeyword(doubleStrike),
          theKeyword(deathtouch),
          theKeyword(haste),
          anyIn({word = landwalk}),
          theKeyword(lifelink),
          anyIn({word = protection}),
          theKeyword(reach),
          theKeyword(trample),
          theKeyword(shroud),
          theKeyword(vigilance)])],
    power = 4,
    toughness = 4})
