card singleFaced({
    name = "Patrician Geist",
    cost = [generic(2), pip(blue)],
    types = [creature],
    subtypes = [spirit, knight],
    text = [
      flying,
      static(getsPt(allOf(nominal(pre = [other], spirit, post = [youControl])), up(1), up(1))),
      static(
        costShift(
          allOf(
            nominal(
              spell,
              post = [did(actor(you), cast(which, from = yourGraveyard), within = thisObject)])),
          less(1)))],
    power = 2,
    toughness = 2})
