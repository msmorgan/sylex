card singleFaced({
    name = "Harm's Way",
    cost = [pip(white)],
    types = [instant],
    text = [
      spell(
        establishThroughout(
          replace(
            would(
              actor(aYourChoice(source)),
              dealDamage(recipient = andOr([you, allOf(nominal(permanent, post = [youControl]))]))),
            instead(redirectDamage(theNext(2), target(anyTarget)))),
          thisTurn))]})
