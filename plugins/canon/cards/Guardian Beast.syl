# Fragment: "already" in "Auras already attached to those artifacts" is missing until
# `syl-already-attached`.
card singleFaced({
    name = "Guardian Beast",
    cost = [generic(3), pip(black)],
    types = [creature],
    subtypes = [beast],
    text = [
      static(
        conjunction([
            asLongAs(
              is(thisCreature, isUntapped),
              conjunction([
                  cant(any, attachTo(a(hasSubtype(aura)), them)),
                  abilityGrant(them, indestructible),
                  cant(actor(bare(and([isPlayer, isOther]))), gainControlOf(them))],
                bare(and([non(isCreature), isArtifact, youControl])))),
            doesnt(
              actor(thisEffect),
              remove(bare(and([hasSubtype(aura), attachedTo(those(artifact))]))))]))],
    power = 2,
    toughness = 4})
