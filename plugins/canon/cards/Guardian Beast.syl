card {
  name = "Guardian Beast",
  cost = [3, black],
  types = [creature],
  subtypes = [beast],
  text = [
    static(
      onlyWhile(
        conjunction([
            retention(
              cant(any, attachTo(a(hasSubtype(aura)), them)),
              allOf(and([hasSubtype(aura), attachedTo(those(artifact))]))),
            abilityGrant(them, indestructible),
            cant(actor(bare(and([isPlayer, isOther]))), gainControlOf(them))],
          bare(and([non(isCreature), isArtifact, youControl]))),
        is(thisCreature, isUntapped)))],
  power = 2,
  toughness = 4
}
