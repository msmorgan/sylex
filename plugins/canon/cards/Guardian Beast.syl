# Fragment: "already" in "Auras already attached to those artifacts" is missing until
# `syl-already-attached`.
card singleFaced({
    name = "Guardian Beast",
    cost = [generic(3), pip(black)],
    types = [creature],
    subtypes = [beast],
    text = [
      static(
        conjunction([
            asLongAs(
              is(thisCreature, untapped),
              conjunction([
                  cant(any, attachTo(a(aura), them)),
                  abilityGrant(them, [indestructible]),
                  cant(actor(bare(nominal(pre = [other], player))), gainControlOf(them))],
                subject = bare(nominal(pre = [non(creature)], artifact, post = [youControl])))),
            doesnt(
              actor(thisEffect),
              remove(bare(nominal(aura, post = [attachedTo(those(artifact))]))))]))],
    power = 2,
    toughness = 4})
