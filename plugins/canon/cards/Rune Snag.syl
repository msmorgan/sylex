card singleFaced({
    name = "Rune Snag",
    cost = [generic(1), pip(blue)],
    types = [instant],
    text = [
      spell(
        instruct(
          controllerOf(target(spell)),
          doUnless(
            compound([
                mana([generic(2)]),
                scaledGenericMana(
                  forEach(
                    2,
                    nominal(card, post = [named(printedName("Rune Snag")), in(graveyard)])))]),
            instruct(you, counter(it)))))]})
