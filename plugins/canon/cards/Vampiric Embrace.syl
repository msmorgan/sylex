card singleFaced({
    name = "Vampiric Embrace",
    cost = [generic(2), pip(black), pip(black)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(getsPt(enchanted(creature), up(2), up(2))),
      static(abilityGrant(enchanted(creature), [flying])),
      whenever(
        does(
          actor(
            a(
              and([
                  isCreature,
                  did(
                    actor(attachHost(enchanted, creature)),
                    dealDamage(recipient = which),
                    within = within(soFarThisTurn))]))),
          die),
        putCounters(1, printedKind(p1p1Counter), that(creature)))]})
