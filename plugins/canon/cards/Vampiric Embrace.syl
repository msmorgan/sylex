card {
  name = "Vampiric Embrace",
  cost = [generic(2), pip(black), pip(black)],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(getsPt(enchanted(creature), up(lit(2)), up(lit(2)))),
    static(abilityGrant(enchanted(creature), flying)),
    whenever(
      does(
        actor(
          a(
            and([
                isCreature,
                did(
                  actor(attachHost(enchanted, creature)),
                  dealDamage(recipient = which),
                  within = within(soFarThisTurn))]))),
        die),
      putCounters(lit(1), printedKind(p1p1Counter), that(creature)))]
}
