card singleFaced({
    name = "Call In a Professional",
    cost = [generic(2), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially([
            establishThroughout(cant(actor(bare(isPlayer)), gainLife(anyAmount)), thisTurn),
            establishThroughout(
              cant(any, preventDamage(allDamage, damage = would(any, dealDamage))),
              thisTurn),
            instruct(this, dealDamage(lit(3), target(isAnyTarget)))]))]})
