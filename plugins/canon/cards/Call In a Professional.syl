card singleFaced({
    name = "Call In a Professional",
    cost = [generic(2), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially([
            establishThroughout(cant(actor(bare(player)), gainLife(anyAmount)), thisTurn),
            establishThroughout(
              cant(any, preventDamage(allDamage, damage = would(any, dealDamage))),
              thisTurn),
            instruct(ownName, dealDamage(amount = 3, recipient = target(anyTarget)))]))]})
