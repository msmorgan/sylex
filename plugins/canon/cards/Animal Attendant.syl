card singleFaced({
    name = "Animal Attendant",
    cost = [generic(1), pip(green)],
    types = [creature],
    subtypes = [human, citizen],
    text = [
      activated(
        tapSymbol,
        addMana(
          counted(1, ofAnyColor(sameColor)),
          [
            whenSpentOn(
              affectsIt,
              a(and([non(hasSubtype(human)), isCreature, isSpell])),
              establish(entersWithAdditionalCounters(becomes(that(spell)), 1, p1p1Counter)))]))],
    power = 2,
    toughness = 2})
