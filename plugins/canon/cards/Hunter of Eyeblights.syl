card singleFaced({
    name = "Hunter of Eyeblights",
    cost = [generic(3), pip(black), pip(black)],
    types = [creature],
    subtypes = [elf, assassin],
    text = [
      when(
        does(actor(thisCreature), enter),
        putCounters(1, printedKind(p1p1Counter), target(and([isCreature, youDontControl])))),
      activated(
        compound(costs = [mana([generic(2), pip(black)]), tapSymbol]),
        destroy(target(and([isCreature, hasCounter]))))],
    power = 3,
    toughness = 3})
