card singleFaced({
    name = "Hunter of Eyeblights",
    cost = [generic(3), pip(black), pip(black)],
    types = [creature],
    subtypes = [elf, assassin],
    text = [
      when(
        does(actor(thisCreature), enter),
        putCounters(
          1,
          printedKind(p1p1Counter),
          target(nominal(creature, post = [youDontControl])))),
      activated(
        compound([mana([generic(2), pip(black)]), tapSymbol]),
        destroy(target(nominal(creature, post = [hasCounter]))))],
    power = 3,
    toughness = 3})
