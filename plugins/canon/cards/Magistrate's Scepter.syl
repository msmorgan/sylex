card singleFaced({
    name = "Magistrate's Scepter",
    cost = [generic(3)],
    types = [artifact],
    text = [
      activated(
        compound([mana([generic(4)]), tapSymbol]),
        putCounters(1, printedKind(chargeCounter), thisArtifact)),
      activated(
        compound([
            tapSymbol,
            perform(removeCounters(exactly(3), printedKind(chargeCounter), thisArtifact))]),
        extraTurn(1))]})
