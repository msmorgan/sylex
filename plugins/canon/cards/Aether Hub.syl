# "You get {E}" puts an energy counter on you; paying {E} removes one [CR#107.14].
card singleFaced({
    name = "Aether Hub",
    types = [land],
    text = [
      when(does(actor(thisLand), enter), putCounters(lit(1), printedKind(energy), you)),
      activated(tapSymbol, addMana(lit(1), manaOf([[colorless]]))),
      activated(
        compound([tapSymbol, perform(removeCounters(exactly(1), printedKind(energy), you))]),
        addMana(lit(1), ofAnyColor(sameColor)))]})
