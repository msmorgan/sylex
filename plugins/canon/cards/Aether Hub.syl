# "You get {E}" puts an energy counter on you; paying {E} removes one [CR#107.14].
card singleFaced({
    name = "Aether Hub",
    types = [land],
    text = [
      when(does(actor(thisLand), enter), putCounters(1, printedKind(energy), you)),
      activated(tapSymbol, addMana(symbols([colorlessPip]))),
      activated(
        compound([tapSymbol, perform(removeCounters(exactly(1), printedKind(energy), you))]),
        addMana(counted(1, ofAnyColor(sameColor))))]})
