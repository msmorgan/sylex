card singleFaced({
    name = "Éomer of the Riddermark",
    cost = [generic(4), pip(red)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, knight],
    text = [
      haste,
      whenever(
        does(actor(shortenedName), attack),
        if = exists(
          nominal(
            creature,
            post = [
              youControl,
              superlative(max, stat(power), nominal(creature, post = [in(battlefield)]))])),
        create(1, written(creatureToken(1, 1, [white], [human, soldier]))))],
    power = 5,
    toughness = 4})
