# Loxodon Peacekeeper: "If two or more players are tied for lowest life total, you choose one
# of them, and that player gains control of this creature." "Them" reads the players the counted
# existential introduces (`semantics.md` §2.2, box 2).
card singleFaced({
    name = "Loxodon Peacekeeper",
    cost = [generic(1), pip(white)],
    types = [creature],
    subtypes = [elephant, soldier],
    text = [
      at(
        beginningOfYour(upkeep),
        sequentially([
            gainControl(
              controller = the(
                nominal(player, post = [superlative(min, playerStat(lifeTotal), player)])),
              this(creature)),
            doIf(
              thereAre(
                counted(
                  orMore(2),
                  nominal(player, post = [tiedFor(min, playerStat(lifeTotal), player)]))),
              sequentially([
                  choose(partOf(exactly(1), themPlayers)),
                  gainControl(controller = that(player), this(creature))]))]))],
    power = 4,
    toughness = 4})
