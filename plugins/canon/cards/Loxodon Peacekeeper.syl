# Loxodon Peacekeeper: "If two or more players are tied for lowest life total, you choose one
# of them, and that player gains control of this creature." "Them" reads the players the counted
# existential introduces (`semantics.md` §2.2, box 2).
card {
  name = "Loxodon Peacekeeper",
  cost = [1, white],
  types = [creature],
  subtypes = [elephant, soldier],
  text = [
    at(
      beginningOfYour(upkeep),
      sequentially([
          gainControl(
            thisCreature,
            controller = the(and([isPlayer, superlative(min, playerStat(lifeTotal), isPlayer)]))),
          doIf(
            thereAre(
              counted(orMore(2), and([isPlayer, tiedFor(min, playerStat(lifeTotal), isPlayer)]))),
            sequentially([
                choose(someOf(exactly(1), themPlayers)),
                gainControl(thisCreature, controller = that(player))]))]))],
  power = 4,
  toughness = 4
}
