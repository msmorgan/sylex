card {
  name = "Collected Company",
  cost = [generic(3), pip(green)],
  types = [instant],
  text = [
    spell(
      sequentially([
          lookAt(topSlice(lit(6))),
          putOntoBattlefield(
            fromAmong(upTo(2), and([isCreature, hasManaValue(atMost, lit(3))]), them)),
          putInto(theRest, onBottom, riders = [inOrder(anyOrder)])]))]
}
