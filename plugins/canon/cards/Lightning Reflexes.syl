card singleFaced({
    name = "Lightning Reflexes",
    cost = [generic(1), pip(red)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      asThoughFlashSacrificedAtCleanup,
      enchant(isCreature),
      static(
        conjunction([
            getsPt(enchanted(creature), up(1), up(0)),
            abilityGrant(enchanted(creature), firstStrike)],
          subject = enchanted(creature)))]})
