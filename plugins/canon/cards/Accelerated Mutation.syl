card singleFaced({
    name = "Accelerated Mutation",
    cost = [generic(3), pip(green), pip(green)],
    types = [instant],
    text = [
      spell(
        sequentially([
            get(target(creature), up(letter(x)), up(letter(x)), duration = untilEndOfTurn),
            define(
              x,
              aggregateAll(max, stat(manaValue), nominal(permanent, post = [youControl])))]))]})
