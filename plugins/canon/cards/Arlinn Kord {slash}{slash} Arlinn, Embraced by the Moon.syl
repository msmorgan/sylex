card transforming(
  front = {
    name = "Arlinn Kord",
    cost = [generic(2), pip(red), pip(green)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [arlinn],
    text = [
      activated(
        loyaltySymbol(up(lit(1))),
        establishFor(
          targets(upTo(1), isCreature),
          [
            getsPt(it, up(lit(2)), up(lit(2))),
            abilityGrant(it, vigilance),
            abilityGrant(it, haste)],
          untilEndOfTurn)),
      activated(
        loyaltySymbol(up(lit(0))),
        sequentially([
            create(lit(1), written(creatureToken(2, 2, [green], [wolf]))),
            transform(thisPlaneswalker)]))],
    loyalty = lit(3)},
  back = {
    name = "Arlinn, Embraced by the Moon",
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [arlinn],
    text = [
      activated(
        loyaltySymbol(up(lit(1))),
        establishFor(
          allOf(and([isCreature, youControl])),
          [getsPt(them, up(lit(1)), up(lit(1))), abilityGrant(them, trample)],
          untilEndOfTurn)),
      activated(
        loyaltySymbol(down(lit(1))),
        sequentially(
          [instruct(this, dealDamage(lit(3), target(isAnyTarget))), transform(thisPlaneswalker)])),
      activated(
        loyaltySymbol(down(lit(6))),
        getEmblem([
            static(
              conjunction([
                  abilityGrant(allOf(and([isCreature, youControl])), haste),
                  abilityGrant(
                    them,
                    activated(
                      tapSymbol,
                      dealDamageOwnPower(thisCreature, target(isAnyTarget))))]))]))]})
