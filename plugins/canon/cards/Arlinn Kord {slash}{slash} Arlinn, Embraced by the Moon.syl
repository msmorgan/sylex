card transforming({
    name = "Arlinn Kord",
    cost = [generic(2), pip(red), pip(green)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [arlinn],
    text = [
      activated(
        loyaltySymbol(up(1)),
        establishFor(
          targets(upTo(1), isCreature),
          [getsPt(it, up(2), up(2)), abilityGrant(it, [vigilance, haste])],
          duration = untilEndOfTurn)),
      activated(
        loyaltySymbol(up(0)),
        sequentially([
            create(1, written(creatureToken(2, 2, [green], [wolf]))),
            transform(thisPlaneswalker)]))],
    loyalty = 3},
  {
    name = "Arlinn, Embraced by the Moon",
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [arlinn],
    text = [
      activated(
        loyaltySymbol(up(1)),
        establishFor(
          allOf(and([isCreature, youControl])),
          [getsPt(them, up(1), up(1)), abilityGrant(them, [trample])],
