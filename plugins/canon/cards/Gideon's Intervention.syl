card singleFaced({
    name = "Gideon's Intervention",
    cost = [generic(2), pip(white), pip(white)],
    types = [enchantment],
    text = [
      static(entersChoosing(this(enchantment), cardName)),
      static(cant(actor(yourOpponents), cast(bare(nominal(spell, post = [named(chosenName)]))))),
      static(
        replace(
          would(
            by(bare(nominal(source, post = [named(chosenName)]))),
            dealDamage(recipient = and([you, bare(nominal(permanent, post = [youControl]))]))),
          instead(preventDamage(allDamage))))]})
