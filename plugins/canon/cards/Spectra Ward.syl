card singleFaced({
    name = "Spectra Ward",
    cost = [generic(3), pip(white), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        conjunction([
            conjunction([
                getsPt(enchanted(creature), up(2), up(2)),
                abilityGrant(enchanted(creature), [protection(eachKind(color))])],
              subject = enchanted(creature)),
            doesnt(actor(thisEffect), remove(bare(hasSubtype(aura))))]))]})
