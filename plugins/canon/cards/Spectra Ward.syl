card {
  name = "Spectra Ward",
  cost = [generic(3), pip(white), pip(white)],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
          getsPt(enchanted(creature), up(lit(2)), up(lit(2))),
          retention(
            abilityGrant(enchanted(creature), protection(eachKind(color))),
            allOf(hasSubtype(aura)))],
        subject = enchanted(creature)))]
}
