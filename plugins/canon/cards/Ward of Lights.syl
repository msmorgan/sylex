# Ward of Lights: its protection doesn't remove it, as Flickering Ward's doesn't
# [CR#702.16n].
card singleFaced({
    name = "Ward of Lights",
    cost = [pip(white), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      asThoughFlashSacrificedAtCleanup,
      enchant(hasType(creature)),
      static(entersChoosing(this(aura), color)),
      static(
        conjunction([
            abilityGrant(enchanted(creature), [protection(ofChosen(color))]),
            doesnt(actor(thisEffect), remove(this(aura)))]))]})
