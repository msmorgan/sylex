# Sculpted Sunburst: "if you chose a creature this way" reads back the choice you made earlier
# in the spell (a `did` over `choose`);
# "not chosen by any player this way" excludes every player's chosen creature.
card singleFaced({
    name = "Sculpted Sunburst",
    cost = [generic(3), pip(white), pip(white)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            choose(a(nominal(creature, post = [youControl]))),
            instruct(
              eachOpponent,
              choose(
                a(
                  comparesOwnStat(
                    nominal(creature, post = [controlledBy(they)]),
                    power,
                    atMost,
                    powerOf(it))))),
            doIf(
              did(actor(you), choose(a(creature)), thisWay),
              exile(each(nominal(creature, post = [notChosen]))))]))]})
