card singleFaced({
    name = "Sunscour",
    cost = [generic(5), pip(white), pip(white)],
    types = [sorcery],
    text = [
      static(
        altCost(
          payingInstead(
            perform(
              exile(counted(exactly(2), nominal(pre = [white], card, post = [in(yourHand)]))))),
          this(spell))),
      spell(destroy(allOf(creature)))]})
