card singleFaced({
    name = "Edgewalker",
    cost = [generic(1), pip(white), pip(black)],
    types = [creature],
    subtypes = [human, cleric],
    text = [
      static(
        costShift(
          allOf(and([hasSubtype(cleric), isSpell, did(actor(you), cast(which), thisObject)])),
          lessColoredOnly(symbols([pip(white), pip(black)]))))],
    power = lit(2),
    toughness = lit(2)})
