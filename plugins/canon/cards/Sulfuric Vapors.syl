card singleFaced({
    name = "Sulfuric Vapors",
    cost = [generic(3), pip(red)],
    types = [enchantment],
    text = [
      static(
        replace(
          would(
            actor(a(and([isSpell, hasColor(red)]))),
            dealDamage(recipient = a(or([isPermanent, isPlayer])))),
          instead(instruct(it, dealDamage(plus(thatMuch, lit(1)), thatJoin)))))]})
