card singleFaced({
    name = "Shadowbane",
    cost = [generic(1), pip(white)],
    types = [instant],
    text = [
      spell(
        establishThroughout(
          replace(
            would(
              actor(aYourChoice(source)),
              dealDamage(recipient = andOr([you, allOf(nominal(creature, post = [youControl]))]))),
            instead(
              preventDamage(
                allDamage,
                also = doIf(
                  was(
                    preventDamage(
                      allDamage,
                      damage = would(actor(a(nominal(pre = [black], source))), dealDamage)),
                    thisWay),
                  gainLife(thatMuch)))),
            use = nextTimeOnly),
          thisTurn))]})
