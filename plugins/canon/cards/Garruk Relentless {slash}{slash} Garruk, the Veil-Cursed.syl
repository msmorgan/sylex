card transforming({
    name = "Garruk Relentless",
    cost = [generic(3), pip(green)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [garruk],
    text = [
      when(
        stateHolds(is(thisPlaneswalker, compare(atMost, 2, [counter(loyaltyCounter)]))),
        transform(thisPlaneswalker)),
      activated(
        loyaltySymbol(up(0)),
        sequentially([
            instruct(thisPlaneswalker, dealDamage(amount = 3, recipient = target(creature))),
            dealDamageOwnPower(that(creature), thisPlaneswalker)])),
      activated(loyaltySymbol(up(0)), create(1, written(creatureToken(2, 2, [green], [wolf]))))],
    loyalty = 3},
  {
    name = "Garruk, the Veil-Cursed",
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [garruk],
    text = [
      activated(
        loyaltySymbol(up(1)),
        create(
          1,
          written({
              characteristics = {
                colors = [black],
                types = [creature],
                subtypes = [wolf],
                text = [deathtouch],
                power = 1,
                toughness = 1}}))),
      activated(
        loyaltySymbol(down(1)),
        doIfDone(
          sacrifice(a(creature)),
          ifDid = sequentially([
              search(yourLibrary, for = a(nominal(pre = [creature], card))),
              reveal(it),
              putInto(it, hand),
              shuffle]))),
      activated(
        loyaltySymbol(down(3)),
        sequentially([
            establishFor(
              allOf(nominal(creature, post = [youControl])),
              [abilityGrant(them, [trample]), getsPt(them, up(letter(x)), up(letter(x)))],
              duration = untilEndOfTurn),
            define(x, countOf(nominal(pre = [creature], card, post = [in(yourGraveyard)])))]))]})
