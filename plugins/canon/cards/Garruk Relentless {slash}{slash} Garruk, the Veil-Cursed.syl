card transforming({
    name = "Garruk Relentless",
    cost = [generic(3), pip(green)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [garruk],
    text = [
      when(
        stateHolds(is(thisPlaneswalker, compare(atMost, 2, axes = [counter(loyaltyCounter)]))),
        transform(thisPlaneswalker)),
      activated(
        loyaltySymbol(up(0)),
        sequentially(
          steps = [
            instruct(thisPlaneswalker, dealDamage(amount = 3, recipient = target(isCreature))),
            dealDamageOwnPower(that(creature), thisPlaneswalker)])),
      activated(loyaltySymbol(up(0)), create(1, written(creatureToken(2, 2, [green], [wolf]))))],
    loyalty = 3},
  {
    name = "Garruk, the Veil-Cursed",
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [garruk],
    text = [
      activated(
        loyaltySymbol(up(1)),
        create(
          1,
          written({
              characteristics = {
                colors = [black],
                types = [creature],
                subtypes = [wolf],
                text = [deathtouch],
                power = 1,
                toughness = 1}}))),
      activated(
        loyaltySymbol(down(1)),
        doIfDone(
          sacrifice(a(isCreature)),
          ifDid = sequentially(
            steps = [
              search(yourLibrary, for = a(isCreature)),
              reveal(it),
              putInto(it, hand),
              shuffle]))),
      activated(
        loyaltySymbol(down(3)),
        sequentially(
          steps = [
            establishFor(
              allOf(and([isCreature, youControl])),
              [abilityGrant(them, [trample]), getsPt(them, up(letter(x)), up(letter(x)))],
              duration = untilEndOfTurn),
            define(x, countOf(and([isCreature, in(yourGraveyard)])))]))]})
