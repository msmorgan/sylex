card transforming(
  front = {
    name = "Garruk Relentless",
    cost = [generic(3), pip(green)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [garruk],
    text = [
      when(
        stateHolds(is(thisPlaneswalker, compare(atMost, lit(2), axes = [counter(loyaltyCounter)]))),
        transform(thisPlaneswalker)),
      activated(
        loyaltySymbol(up(lit(0))),
        sequentially([
            instruct(thisPlaneswalker, dealDamage(lit(3), target(isCreature))),
            dealDamageOwnPower(that(creature), thisPlaneswalker)])),
      activated(
        loyaltySymbol(up(lit(0))),
        create(lit(1), written(creatureToken(2, 2, [green], [wolf]))))],
    loyalty = lit(3)},
  back = {
    name = "Garruk, the Veil-Cursed",
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [garruk],
    text = [
      activated(
        loyaltySymbol(up(lit(1))),
        create(
          lit(1),
          written({
              characteristics = {
                colors = [black],
                types = [creature],
                subtypes = [wolf],
                text = [deathtouch],
                power = lit(1),
                toughness = lit(1)}}))),
      activated(
        loyaltySymbol(down(lit(1))),
        doIfDone(
          sacrifice(a(isCreature)),
          sequentially(
            [search(yourLibrary, a(isCreature)), reveal(it), putInto(it, hand), shuffle]))),
      activated(
        loyaltySymbol(down(lit(3))),
        sequentially([
            establishFor(
              allOf(and([isCreature, youControl])),
              [abilityGrant(them, trample), getsPt(them, up(letter(x)), up(letter(x)))],
              untilEndOfTurn),
            define(x, countOf(and([isCreature, in(yourGraveyard)])))]))]})
