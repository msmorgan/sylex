card singleFaced({
    name = "Bioplasm",
    cost = [generic(3), pip(green), pip(green)],
    types = [creature],
    subtypes = [ooze],
    text = [
      whenever(
        does(actor(thisCreature), attack),
        sequentially([
            exile(topSlice(1)),
            doIf(
              is(it, and([isCard, isCreature])),
              get(
                thisCreature,
                up(powerOf(the(and([was(exile(which)), isCreature, isCard])))),
                up(toughnessOf(it)),
                duration = thisTurn))]))],
    power = 4,
    toughness = 4})
