card singleFaced({
    name = "Bioplasm",
    cost = [generic(3), pip(green), pip(green)],
    types = [creature],
    subtypes = [ooze],
    text = [
      whenever(
        does(actor(this(creature)), attack),
        sequentially([
            exile(topSlice(1)),
            doIf(
              is(it, noun(a(nominal(pre = [creature], card)))),
              get(
                this(creature),
                up(powerOf(the(nominal(pre = [was(exile(which)), creature], card)))),
                up(toughnessOf(it)),
                duration = thisTurn))]))],
    power = 4,
    toughness = 4})
