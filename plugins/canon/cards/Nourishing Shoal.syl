card singleFaced({
    name = "Nourishing Shoal",
    cost = [variable, pip(green), pip(green)],
    types = [instant],
    subtypes = [arcane],
    text = [
      static(
        altCost(
          payingInstead(
            perform(
              exile(
                a(
                  nominal(
                    pre = [green],
                    card,
                    post = [hasManaValue(equal, letter(x)), in(yourHand)]))))),
          this(spell))),
      spell(gainLife(letter(x)))]})
