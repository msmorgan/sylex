card singleFaced({
    name = "Nourishing Shoal",
    cost = [variable, pip(green), pip(green)],
    types = [instant],
    subtypes = [arcane],
    text = [
      static(
        altCost(
          payingInstead(
            perform(
              exile(a(and([hasColor(green), hasManaValue(equal, letter(x)), in(yourHand)]))))),
          this)),
      spell(gainLife(letter(x)))]})
