card singleFaced({
    name = "Krosan Druid",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [centaur, druid],
    text = [
      kicker(mana([generic(4), pip(green)])),
      when(does(actor(this(creature)), enter), if = keywordCostPaid(it, kicker), gainLife(10))],
    power = 2,
    toughness = 3})
