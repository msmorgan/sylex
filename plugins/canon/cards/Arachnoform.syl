card singleFaced({
    name = "Arachnoform",
    cost = [generic(1), pip(green)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        conjunction([
            getsPt(enchanted(creature), up(lit(2)), up(lit(2))),
            abilityGrant(enchanted(creature), reach),
            qualityChange(enchanted(creature), adds, everyTypeOf(creature))]))]})
