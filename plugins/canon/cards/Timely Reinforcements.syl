card {
  name = "Timely Reinforcements",
  cost = [generic(2), pip(white)],
  types = [sorcery],
  text = [
    spell(
      sequentially([
          doIf(compareAmt(lifeTotalOf(you), less, lifeTotalOf(anOpponent)), gainLife(lit(6))),
          doIf(
            compareAmt(
              countOf(and([isCreature, youControl])),
              less,
              countOf(and([isCreature, anOpponentControls]))),
            create(lit(3), written(creatureToken(1, 1, [white], [soldier]))))]))]
}
