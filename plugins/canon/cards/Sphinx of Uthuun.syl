card {
  name = "Sphinx of Uthuun",
  cost = [generic(5), pip(blue), pip(blue)],
  types = [creature],
  subtypes = [sphinx],
  text = [
    flying,
    when(
      does(actor(thisCreature), enter),
      sequentially([
          reveal(topSlice(lit(5))),
          instruct(anOpponent, separateIntoPiles(them, 2)),
          putInto(onePile, hand),
          putInto(theOther, graveyard)]))],
  power = lit(5),
  toughness = lit(6)
}
