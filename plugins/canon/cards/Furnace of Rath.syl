card singleFaced({
    name = "Furnace of Rath",
    cost = [generic(1), pip(red), pip(red), pip(red)],
    types = [enchantment],
    text = [
      static(
        replace(
          would(actor(a(isSource)), dealDamage(recipient = a(or([isPermanent, isPlayer])))),
          instead(instruct(it, dealDamage(amount = times(2, thatMuch), recipient = thatJoin)))))]})
