card singleFaced({
    name = "Stupefying Touch",
    cost = [generic(1), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      when(does(actor(thisAura), enter), draw(1)),
      static(
        cant(
          any,
          activate(
            allOf(nominal(abilityHead(anyActivated), post = [ofSource(enchanted(creature))])))))]})
