card singleFaced({
    name = "Stupefying Touch",
    cost = [generic(1), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      when(does(actor(this(aura)), enter), draw(1)),
      static(cant(any, activate(possessive(enchanted(creature), abilityHead(anyActivated)))))]})
