# Radiant Flames (converge is an ability word [CR#207.2c])
card singleFaced({
    name = "Radiant Flames",
    cost = [generic(2), pip(red)],
    types = [sorcery],
    text = [
      spell(
        instruct(
          ownName,
          dealDamage(amount = colorsSpentToCast(this(spell)), recipient = each(creature))))]})
