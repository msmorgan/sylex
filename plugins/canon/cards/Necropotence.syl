card singleFaced({
    name = "Necropotence",
    cost = [pip(black), pip(black), pip(black)],
    types = [enchantment],
    text = [
      static(partSkip(you, drawStep)),
      whenever(does(actor(you), discard(a(card))), exileFrom(that(card), yourGraveyard)),
      activated(
        perform(payLife(amount = 1)),
        sequentially([
            exileFaceDown(topSlice(1)),
            atNext(beginningOf(endStep, you, nextTime), putInto(that(card), hand))]))]})
