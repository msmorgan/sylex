card singleFaced({
    name = "Necropotence",
    cost = [pip(black), pip(black), pip(black)],
    types = [enchantment],
    text = [
      static(partSkip(you, drawStep)),
      whenever(does(actor(you), discard(a(isCard))), exileFrom(that(card), yourGraveyard)),
      activated(
        perform(payLife(amount = 1)),
        sequentially(
          steps = [
            exileFaceDown(topSlice(1)),
            atNext(
              beginningOf(endStep, you, nextTime(player = you)),
              putInto(that(card), hand))]))]})
