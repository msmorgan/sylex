card {
  name = "Ward of Piety",
  cost = [generic(1), pip(white)],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    activated(
      mana([generic(1), pip(white)]),
      establishThroughout(
        replace(
          would(any, dealDamage(recipient = enchanted(creature))),
          instead(redirectDamage(theNext(lit(1)), target(isAnyTarget)))),
        thisTurn))]
}
