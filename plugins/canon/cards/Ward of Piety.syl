card singleFaced({
    name = "Ward of Piety",
    cost = [generic(1), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      activated(
        mana([generic(1), pip(white)]),
        establishThroughout(
          replace(
            would(any, dealDamage(recipient = enchanted(creature))),
            instead(redirectDamage(theNext(1), target(anyTarget)))),
          thisTurn))]})
