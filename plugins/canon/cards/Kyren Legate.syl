card {
  name = "Kyren Legate",
  cost = [generic(1), pip(red)],
  types = [creature],
  subtypes = [goblin],
  text = [
    static(
      onlyWhile(
        altCost(this),
        and([
            exists(and([isLand, hasSubtype(plains), anOpponentControls])),
            exists(and([isLand, hasSubtype(mountain), youControl]))]))),
    haste],
  power = lit(1),
  toughness = lit(1)
}
