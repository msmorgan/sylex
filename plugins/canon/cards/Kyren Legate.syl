card singleFaced({
    name = "Kyren Legate",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [goblin],
    text = [
      static(
        onlyWhile(
          altCost(withoutPaying, this),
          and([
              exists(and([isLand, hasSubtype(plains), anOpponentControls])),
              exists(and([isLand, hasSubtype(mountain), youControl]))]))),
      haste],
    power = 1,
    toughness = 1})
