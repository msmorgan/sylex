card singleFaced({
    name = "Kyren Legate",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [goblin],
    text = [
      static(
        if(
          and([
              exists(nominal(plains, post = [anOpponentControls])),
              exists(nominal(mountain, post = [youControl]))]),
          can(actor(you), cast(thisSpell, altCost = withoutPaying)))),
      haste],
    power = 1,
    toughness = 1})
