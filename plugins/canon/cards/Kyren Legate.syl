card singleFaced({
    name = "Kyren Legate",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [goblin],
    text = [
      static(
        if(
          and(
            conjuncts = [
              exists(and([isLand, hasSubtype(plains), anOpponentControls])),
              exists(and([isLand, hasSubtype(mountain), youControl]))]),
          can(actor(you), cast(thisSpell, altCost = withoutPaying)))),
      haste],
    power = 1,
    toughness = 1})
