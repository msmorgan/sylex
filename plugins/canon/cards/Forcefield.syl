card {
  name = "Forcefield",
  cost = [generic(3)],
  types = [artifact],
  text = [
    activated(
      mana([generic(1)]),
      establishThroughout(
        replace(
          would(
            actor(aYourChoice(and([isCreature, isUnblocked]))),
            dealDamage(recipient = you, kind = combat)),
          instead(preventDamage(allBut(lit(1)))),
          use = nextTimeOnly),
        thisTurn))]
}
