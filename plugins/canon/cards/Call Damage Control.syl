# *Call Damage Control*: each mode writes out the printed header, "Return those cards from your
# graveyard to your hand.", with its bullet's target.
card singleFaced({
    name = "Call Damage Control",
    cost = [generic(1), pip(green)],
    types = [sorcery],
    text = [
      spell(
        chooseModes(
          upTo(2),
          [
            mode(returnToHand(target(nominal(pre = [artifact], card)), from = yourGraveyard)),
            mode(returnToHand(target(nominal(pre = [creature], card)), from = yourGraveyard)),
            mode(returnToHand(target(nominal(pre = [enchantment], card)), from = yourGraveyard)),
            mode(returnToHand(target(nominal(pre = [land], card)), from = yourGraveyard))]))]})
