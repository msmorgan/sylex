# *Call Damage Control*: each mode writes out the printed header, "Return those cards from your
# graveyard to your hand.", with its bullet's target.
card singleFaced({
    name = "Call Damage Control",
    cost = [generic(1), pip(green)],
    types = [sorcery],
    text = [
      spell(
        chooseModes(
          upTo(2),
          [
            mode(none, none, returnToHand(target(and([isArtifact, isCard])), from = yourGraveyard)),
            mode(none, none, returnToHand(target(and([isCreature, isCard])), from = yourGraveyard)),
            mode(
              none,
              none,
              returnToHand(target(and([isEnchantment, isCard])), from = yourGraveyard)),
            mode(
              none,
              none,
              returnToHand(target(and([isLand, isCard])), from = yourGraveyard))]))]})
