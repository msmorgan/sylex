card singleFaced({
    name = "Bifurcate",
    cost = [generic(3), pip(green)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            search(
              yourLibrary,
              for = a(
                nominal(
                  pre = [permanent],
                  card,
                  post = [
                    shares(cardName, share, target(nominal(pre = [non(token)], creature)))]))),
            putOntoBattlefield(that(card)),
            shuffle]))]})
