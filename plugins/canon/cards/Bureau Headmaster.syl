card {
  name = "Bureau Headmaster",
  cost = [pip(red), pip(white)],
  types = [creature],
  subtypes = [human, assassin],
  text = [
    static(
      costShift(
        allOf(and([isSpell, hasSubtype(equipment), did(actor(you), cast(which), thisObject)])),
        less(lit(1)))),
    static(
      costShift(
        allOf(and([abilityHead(keyword(equip)), did(actor(you), activate(which), thisObject)])),
        less(lit(1))))],
  power = lit(2),
  toughness = lit(2)
}
