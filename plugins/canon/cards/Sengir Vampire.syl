card {
  name = "Sengir Vampire",
  cost = [3, black, black],
  types = [creature],
  subtypes = [vampire],
  text = [
    flying,
    whenever(
      does(
        actor(
          a(
            and([
                isCreature,
                did(actor(thisCreature), dealDamage(recipient = which), within(soFarThisTurn))]))),
        die),
      putCounters(1, printedKind(p1p1Counter), thisCreature))],
  power = 4,
  toughness = 4
}
