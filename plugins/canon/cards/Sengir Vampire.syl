card singleFaced({
    name = "Sengir Vampire",
    cost = [generic(3), pip(black), pip(black)],
    types = [creature],
    subtypes = [vampire],
    text = [
      flying,
      whenever(
        does(
          actor(
            a(
              and([
                  isCreature,
                  did(
                    actor(thisCreature),
                    dealDamage(recipient = which),
                    within = within(soFarThisTurn))]))),
          die),
        putCounters(1, printedKind(p1p1Counter), thisCreature))],
    power = 4,
    toughness = 4})
