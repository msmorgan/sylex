card singleFaced({
    name = "Kopala, Warden of Waves",
    cost = [generic(1), pip(blue), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [merfolk, wizard],
    text = [
      static(
        costShift(
          bare(
            nominal(
              spell,
              post = [
                did(actor(yourOpponents), cast(which), within = thisObject),
                targeting(a(nominal(merfolk, post = [youControl])), someTarget)])),
          more(2))),
      static(
        costShift(
          bare(
            nominal(
              abilityHead(anyActivated),
              post = [
                did(actor(yourOpponents), activate(which), within = thisObject),
                targeting(a(nominal(merfolk, post = [youControl])), someTarget)])),
          more(2)))],
    power = 2,
    toughness = 2})
