card singleFaced({
    name = "Kopala, Warden of Waves",
    cost = [generic(1), pip(blue), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [merfolk, wizard],
    text = [
      static(
        costShift(
          allOf(
            and([
                isSpell,
                did(actor(yourOpponents), cast(which), thisObject),
                targeting(a(and([isCreature, hasSubtype(merfolk), youControl])), someTarget)])),
          more(2))),
      static(
        costShift(
          allOf(
            and([
                abilityHead(anyActivated),
                did(actor(yourOpponents), activate(which), thisObject),
                targeting(a(and([isCreature, hasSubtype(merfolk), youControl])), someTarget)])),
          more(2)))],
    power = 2,
    toughness = 2})
