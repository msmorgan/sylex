card singleFaced({
    name = "Lightmine Field",
    cost = [generic(2), pip(white), pip(white)],
    types = [enchantment],
    text = [
      whenever(
        does(actor(counted(orMore(1), creature)), attack),
        instruct(
          thisEnchantment,
          dealDamage(
            amount = countOf(nominal(pre = [attacking], creature)),
            recipient = eachOf(those(creature)))))]})
