card singleFaced({
    name = "Lightmine Field",
    cost = [generic(2), pip(white), pip(white)],
    types = [enchantment],
    text = [
      whenever(
        does(actor(counted(orMore(1), isCreature)), attack),
        instruct(
          thisEnchantment,
          dealDamage(
            amount = countOf(and([isCreature, isAttacking])),
            recipient = eachOf(those(creature)))))]})
