card singleFaced({
    name = "Urborg Scavengers",
    cost = [generic(2), pip(black)],
    types = [creature],
    subtypes = [spirit],
    text = [
      whenever(
        or([does(actor(thisCreature), enter), does(actor(thisCreature), attack)]),
        action = sequentially([
            exile(target(cardIn(graveyard))),
            putCounters(1, printedKind(p1p1Counter), thisCreature)])),
      alsoForKeywords(
        static(
          onlyWhile(
            keywordGrant(
              thisCreature,
              thatKeyword,
              and([in(exiledWith(thisCreature)), hasKeyword(thatKeyword)])),
            exists(and([in(exiledWith(thisCreature)), hasKeyword(thatKeyword)])))),
        [
          theKeyword(flying),
          theKeyword(firstStrike),
          theKeyword(doubleStrike),
          theKeyword(deathtouch),
          theKeyword(haste),
          anyIn({word = hexproof}),
          theKeyword(indestructible),
          theKeyword(lifelink),
          theKeyword(menace),
          theKeyword(reach),
          theKeyword(trample),
          theKeyword(vigilance)])],
    power = 2,
    toughness = 2})
