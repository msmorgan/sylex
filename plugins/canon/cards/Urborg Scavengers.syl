card singleFaced({
    name = "Urborg Scavengers",
    cost = [generic(2), pip(black)],
    types = [creature],
    subtypes = [spirit],
    text = [
      whenever(
        or([does(actor(this(creature)), enter), does(actor(this(creature)), attack)]),
        sequentially([
            exile(target(nominal(card, post = [in(graveyard)]))),
            putCounters(1, printedKind(p1p1Counter), this(creature))])),
      alsoForKeywords(
        static(
          onlyWhile(
            keywordGrant(
              this(creature),
              thatKeyword,
              and([in(exiledWith(it)), hasKeyword(thatKeyword)])),
            exists(nominal(card, post = [in(exiledWith(it)), hasKeyword(thatKeyword)])))),
        [
          theKeyword(flying),
          theKeyword(firstStrike),
          theKeyword(doubleStrike),
          theKeyword(deathtouch),
          theKeyword(haste),
          anyIn({word = hexproof}),
          theKeyword(indestructible),
          theKeyword(lifelink),
          theKeyword(menace),
          theKeyword(reach),
          theKeyword(trample),
          theKeyword(vigilance)])],
    power = 2,
    toughness = 2})
