card singleFaced({
    name = "Cryptic Command",
    cost = [generic(1), pip(blue), pip(blue), pip(blue)],
    types = [instant],
    text = [
      spell(
        chooseModes(
          exactly(2),
          [
            mode(counter(target(isSpell))),
            mode(returnToHand(target(isPermanent))),
            mode(tap(allOf(and([isCreature, opponentsControl])))),
            mode(draw(1))]))]})
