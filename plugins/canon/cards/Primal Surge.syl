card singleFaced({
    name = "Primal Surge",
    cost = [generic(8), pip(green), pip(green)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            exile(topSlice(1)),
            doIf(
              is(it, noun(a(nominal(pre = [permanent], card)))),
              may(putOntoBattlefield(it), ifDid = repeat(again)))]))]})
