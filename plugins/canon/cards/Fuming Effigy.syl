card singleFaced({
    name = "Fuming Effigy",
    cost = [generic(3), pip(red)],
    types = [creature],
    subtypes = [spirit],
    text = [
      whenever(
        does(
          actor(counted(orMore(1), nominal(card, post = [in(yourGraveyard)]))),
          leave(from = yourGraveyard)),
        instruct(this(creature), dealDamage(amount = 1, recipient = eachOpponent)))],
    power = 4,
    toughness = 3})
