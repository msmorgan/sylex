# Disciple of Caelus Nin: "starting with you" overrides the default APNAP choice order
# [CR#101.1,101.4].
card singleFaced({
    name = "Disciple of Caelus Nin",
    cost = [generic(4), pip(white)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      when(
        does(actor(this(creature)), enter),
        sequentially([
            instruct(
              eachPlayer,
              chooseStartingWith(
                you,
                counted(upTo(5), nominal(permanent, post = [controlledBy(they)])))),
            instruct(
              allOf(nominal(permanent, post = [otherThan(this(creature)), notChosen])),
              phaseOut)])),
      static(cant(actor(bare(permanent)), phaseIn))],
    power = 3,
    toughness = 4})
