card singleFaced({
    name = "Bewitching Leechcraft",
    cost = [generic(1), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      when(does(actor(this(aura)), enter), tap(enchanted(creature))),
      static(
        abilityGrant(
          enchanted(creature),
          [
            static(
              replace(
                would(actor(this(creature)), setStatus(untapped, subject)),
                instead(
                  doIfDone(
                    removeCounters(exactly(1), printedKind(p1p1Counter), it),
                    ifDid = untap(it))),
                timing = duringPart(whose = you, untapStep)))]))]})
