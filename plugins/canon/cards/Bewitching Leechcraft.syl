card singleFaced({
    name = "Bewitching Leechcraft",
    cost = [generic(1), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      when(does(actor(thisAura), enter), tap(enchanted(creature))),
      static(
        abilityGrant(
          enchanted(creature),
          static(
            replace(
              would(actor(thisCreature), setStatus(untapped, actor)),
              instead(
                doIfDone(
                  removeCounters(exactly(1), printedKind(p1p1Counter), thisCreature),
                  untap(thisCreature))),
              duringPart(untapStep, you)))))]})
