card singleFaced({
    name = "Fortune's Favor",
    cost = [generic(3), pip(blue)],
    types = [instant],
    text = [
      spell(
        sequentially(
          steps = [
            instruct(target(isOpponent), lookAt(topSlice(4))),
            instruct(they, separateIntoPiles(them, 2, faces = [faceDown, faceUp])),
            putInto(onePile, hand),
            putInto(theOther, graveyard)]))]})
