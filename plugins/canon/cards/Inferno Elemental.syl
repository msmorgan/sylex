card singleFaced({
    name = "Inferno Elemental",
    cost = [generic(4), pip(red), pip(red)],
    types = [creature],
    subtypes = [elemental],
    text = [
      whenever(
        or([
            does(actor(thisCreature), block(a(isCreature))),
            does(by(a(isCreature)), block(thisCreature))]),
        action = instruct(thisCreature, dealDamage(3, that(creature))))],
    power = 4,
    toughness = 4})
