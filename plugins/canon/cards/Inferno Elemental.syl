card singleFaced({
    name = "Inferno Elemental",
    cost = [generic(4), pip(red), pip(red)],
    types = [creature],
    subtypes = [elemental],
    text = [
      whenever(
        or([
            does(actor(thisCreature), block(attacker = a(isCreature))),
            does(by(a(isCreature)), block(attacker = thisCreature))]),
        instruct(thisCreature, dealDamage(amount = 3, recipient = that(creature))))],
    power = 4,
    toughness = 4})
