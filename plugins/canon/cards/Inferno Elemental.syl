card singleFaced({
    name = "Inferno Elemental",
    cost = [generic(4), pip(red), pip(red)],
    types = [creature],
    subtypes = [elemental],
    text = [
      whenever(
        or([
            does(actor(this(creature)), block(attacker = a(creature))),
            does(by(a(creature)), block(attacker = this(creature)))]),
        instruct(this(creature), dealDamage(amount = 3, recipient = that(creature))))],
    power = 4,
    toughness = 4})
