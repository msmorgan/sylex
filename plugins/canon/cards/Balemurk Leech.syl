card singleFaced({
    name = "Balemurk Leech",
    cost = [generic(1), pip(black)],
    types = [creature],
    subtypes = [leech],
    text = [
      eerie(
        triggered(
          and([
              whenever(does(actor(a(and([isEnchantment, youControl]))), enter)),
              whenever(does(actor(you), fullyUnlock(a(hasSubtype(room)))))]),
          instruct(eachOpponent, loseLife(1))))],
    power = 2,
    toughness = 2})
