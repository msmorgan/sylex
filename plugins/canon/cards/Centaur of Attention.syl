card singleFaced({
    name = "Centaur of Attention",
    cost = [generic(3), pip(green), pip(green)],
    types = [creature],
    subtypes = [centaur, performer],
    text = [
      when(
        does(actor(this(creature)), enter),
        sequentially([rollDice(count = 5), storeResults(it)])),
      at(beginningOfYour(combat), may(rerollStored(anyNumber, this(creature)))),
      static(
        conjunction([
            getsPt(this(creature), up(letter(x)), up(letter(x))),
            letterDefinition(x, greatestStoredMatch(it))]))],
    power = 3,
    toughness = 3})
