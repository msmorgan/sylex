card singleFaced({
    name = "Caught in the Crossfire",
    cost = [pip(red), pip(red)],
    types = [instant],
    text = [
      spell(
        chooseSpree([
            plusMode(
              mana([generic(1)]),
              instruct(
                this,
                dealDamage(amount = 2, recipient = each(and([isCreature, isOutlaw]))))),
            plusMode(
              mana([generic(1)]),
              instruct(
                this,
                dealDamage(amount = 2, recipient = each(and([isCreature, non(isOutlaw)])))))]))]})
