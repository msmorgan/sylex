card singleFaced({
    name = "Caught in the Crossfire",
    cost = [pip(red), pip(red)],
    types = [instant],
    text = [
      spell(
        chooseSpree([
            plusMode(
              mana([generic(1)]),
              instruct(
                this,
                dealDamage(amount = 2, recipient = each(nominal(pre = [outlaw], creature))))),
            plusMode(
              mana([generic(1)]),
              instruct(
                this,
                dealDamage(
                  amount = 2,
                  recipient = each(nominal(pre = [non(outlaw)], creature)))))]))]})
