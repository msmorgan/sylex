card singleFaced({
    name = "Tattoo Ward",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        conjunction([
            conjunction([
                getsPt(enchanted(creature), up(lit(1)), up(lit(1))),
                abilityGrant(enchanted(creature), protection(isEnchantment))],
              subject = enchanted(creature)),
            doesnt(actor(thisEffect), remove(thisAura))])),
      activated(perform(sacrifice(thisAura)), destroy(target(isEnchantment)))]})
