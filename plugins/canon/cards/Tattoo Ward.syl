card singleFaced({
    name = "Tattoo Ward",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        conjunction([
            getsPt(enchanted(creature), up(lit(1)), up(lit(1))),
            retention(abilityGrant(enchanted(creature), protection(isEnchantment)), thisAura)],
          subject = enchanted(creature))),
      activated(perform(sacrifice(thisAura)), destroy(target(isEnchantment)))]})
