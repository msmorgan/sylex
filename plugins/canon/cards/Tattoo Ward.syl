card singleFaced({
    name = "Tattoo Ward",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(
        conjunction([
            conjunction([
                getsPt(enchanted(creature), up(1), up(1)),
                abilityGrant(enchanted(creature), [protection(hasType(enchantment))])],
              subject = enchanted(creature)),
            doesnt(actor(thisEffect), remove(this(aura)))])),
      activated(perform(sacrifice(this(aura))), destroy(target(enchantment)))]})
