card singleFaced({
    name = "Pinpoint Avalanche",
    cost = [generic(3), pip(red), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially([
            instruct(this, dealDamage(amount = 4, recipient = target(isCreature))),
            establish(cant(any, preventDamage(allDamage)), duration = modifiesPrecedingAction)]))]})
