card transforming(
  front = {
    name = "Afflicted Deserter",
    cost = [generic(3), pip(red)],
    types = [creature],
    subtypes = [human, werewolf],
    text = [
      at(
        beginningOfEach(upkeep),
        if = not(did(any, cast(a(isSpell)), within(lastTurn))),
        action = transform(thisCreature))],
    power = lit(3),
    toughness = lit(2)},
  back = {
    name = "Werewolf Ransacker",
    types = [creature],
    subtypes = [werewolf],
    text = [
      whenever(
        does(any, transform(thisCreature, into = named(printedName("Werewolf Ransacker")))),
        sequentially([
            may(destroy(target(isArtifact))),
            doIf(
              did(actor(that(artifact)), putInto(theActor, graveyard), thisWay),
              instruct(thisCreature, dealDamage(lit(3), controllerOf(that(artifact)))))])),
      at(
        beginningOfEach(upkeep),
        if = compareAmt(
          aggregateOver(max, isPlayer, eventCount(cast(a(isSpell)), actor(they), lastTurn)),
          atLeast,
          lit(2)),
        action = transform(thisCreature))],
    power = lit(5),
    toughness = lit(4)})
