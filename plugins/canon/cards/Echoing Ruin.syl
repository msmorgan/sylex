card singleFaced({
    name = "Echoing Ruin",
    cost = [generic(1), pip(red)],
    types = [sorcery],
    text = [
      spell(
        destroy(
          and([
              target(artifact),
              allOf(
                nominal(
                  pre = [other],
                  artifact,
                  post = [shares(cardName, share, that(artifact))]))])))]})
