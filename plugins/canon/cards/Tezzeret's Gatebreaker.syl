card singleFaced({
    name = "Tezzeret's Gatebreaker",
    cost = [generic(4)],
    types = [artifact],
    text = [
      when(
        does(actor(thisArtifact), enter),
        sequentially([
            lookAt(topSlice(5)),
            may(
              sequentially([
                  reveal(fromAmong(exactly(1), nominal(pre = [or([blue, artifact])], card), them)),
                  putInto(that(card), hand)])),
            putInto(theRest, onBottom, riders = [inOrder(randomOrder)])])),
      activated(
        compound([mana([generic(5), pip(blue)]), tapSymbol, perform(sacrifice(thisArtifact))]),
        establishThroughout(
          cant(any, block(attacker = bare(nominal(creature, post = [youControl])))),
          thisTurn))]})
