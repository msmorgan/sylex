card singleFaced({
    name = "Mox Diamond",
    cost = [],
    types = [artifact],
    text = [
      static(
        replace(
          would(actor(thisArtifact), enter),
          instead(
            may(
              discard(a(and([isLand, in(yourHand)]))),
              putOntoBattlefield(thisArtifact),
              putInto(it, graveyard))))),
      activated(tapSymbol, addMana(1, ofAnyColor(sameColor)))]})
