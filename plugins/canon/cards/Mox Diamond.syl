card singleFaced({
    name = "Mox Diamond",
    cost = [],
    types = [artifact],
    text = [
      static(
        replace(
          would(actor(this(artifact)), enter),
          instead(
            may(
              discard(a(nominal(pre = [land], card, post = [in(yourHand)]))),
              ifDid = putOntoBattlefield(this(artifact)),
              ifNot = putInto(it, graveyard))))),
      activated(tapSymbol, addMana(counted(1, ofAnyColor(sameColor))))]})
