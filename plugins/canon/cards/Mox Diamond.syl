card singleFaced({
    name = "Mox Diamond",
    cost = [],
    types = [artifact],
    text = [
      static(
        replace(
          would(actor(thisArtifact), enter),
          instead(
            may(
              discard(a(and([isLand, in(yourHand)]))),
              ifDid = putOntoBattlefield(thisArtifact),
              ifNot = putInto(it, graveyard))))),
      activated(tapSymbol, addMana(counted(1, ofAnyColor(sameColor))))]})
