card singleFaced({
    name = "Psychic Possession",
    cost = [generic(2), pip(blue), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isOpponent),
      static(partSkip(you, drawStep)),
      whenever(does(actor(enchanted(opponent)), draw(1)), may(draw(1)))]})
