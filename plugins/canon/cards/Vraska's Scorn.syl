card singleFaced({
    name = "Vraska's Scorn",
    cost = [generic(2), pip(black), pip(black)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            instruct(target(opponent), loseLife(4)),
            may(
              sequentially([
                  searchLibraryOrGraveyard(
                    a(nominal(card, post = [named(printedName("Vraska, Scheming Gorgon"))]))),
                  reveal(it),
                  putInto(it, hand)])),
            doIf(did(actor(you), search(yourLibrary), thisWay), shuffle)]))]})
