card {
  name = "Seasoned Warrenguard",
  cost = [white],
  types = [creature],
  subtypes = [rabbit, warrior],
  text = [
    whenever(
      does(actor(thisCreature), attack),
      while = whileTrue(exists(and([isToken, youControl]))),
      action = get(thisCreature, up(2), up(0), untilEndOfTurn))],
  power = 1,
  toughness = 2
}
