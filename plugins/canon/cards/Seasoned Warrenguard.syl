card singleFaced({
    name = "Seasoned Warrenguard",
    cost = [pip(white)],
    types = [creature],
    subtypes = [rabbit, warrior],
    text = [
      whenever(
        timed(does(actor(thisCreature), attack), whileTrue(exists(and([isToken, youControl])))),
        action = get(thisCreature, up(2), up(0), untilEndOfTurn))],
    power = 1,
    toughness = 2})
