card singleFaced({
    name = "Seasoned Warrenguard",
    cost = [pip(white)],
    types = [creature],
    subtypes = [rabbit, warrior],
    text = [
      whenever(
        timed(
          does(actor(this(creature)), attack),
          whileTrue(exists(nominal(token, post = [youControl])))),
        get(this(creature), up(2), up(0), duration = untilEndOfTurn))],
    power = 1,
    toughness = 2})
