card {
  name = "Mutavault",
  types = [land],
  text = [
    activated(tapSymbol, addMana(lit(1), manaOf([[colorless]]))),
    activated(
      mana([generic(1)]),
      establishThroughout(
        qualityChange(
          thisLand,
          sets,
          bundle({
              characteristics = {types = [creature], power = lit(2), toughness = lit(2)},
              qualities = [withEveryType(creature)]},
            land)),
        untilEndOfTurn))]
}
