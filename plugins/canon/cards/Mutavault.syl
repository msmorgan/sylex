card singleFaced({
    name = "Mutavault",
    types = [land],
    text = [
      activated(tapSymbol, addMana(symbols([colorlessPip]))),
      activated(
        mana([generic(1)]),
        establishThroughout(
          qualityChange(
            thisLand,
            sets,
            bundle({
                characteristics = {types = [creature], power = 2, toughness = 2},
                qualities = [withEveryType(creature)]},
              retained = land)),
          untilEndOfTurn))]})
