card singleFaced({
    name = "Bloodline Pretender",
    cost = [generic(3)],
    types = [artifact, creature],
    subtypes = [shapeshifter],
    text = [
      changeling,
      static(entersChoosing(this(creature), subtype(creature))),
      whenever(
        does(
          actor(
            a(nominal(pre = [other], creature, post = [youControl, ofChosen(subtype(creature))]))),
          enter),
        putCounters(1, printedKind(p1p1Counter), this(creature)))],
    power = 2,
    toughness = 2})
