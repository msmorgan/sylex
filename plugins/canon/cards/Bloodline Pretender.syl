card singleFaced({
    name = "Bloodline Pretender",
    cost = [generic(3)],
    types = [artifact, creature],
    subtypes = [shapeshifter],
    text = [
      changeling,
      static(entersChoosing(thisCreature, subtype(creature))),
      whenever(
        does(actor(a(and([isCreature, youControl, isOther, ofChosen(subtype(creature))]))), enter),
        putCounters(lit(1), printedKind(p1p1Counter), thisCreature))],
    power = lit(2),
    toughness = lit(2)})
