card {
  name = "Stonebinder's Familiar",
  cost = [pip(white)],
  types = [creature],
  subtypes = [spirit, dog],
  text = [
    whenever(
      does(any, putInto(counted(orMore(1), isCard), exileZone)),
      during = duringPart(turn, you),
      action = putCounters(lit(1), printedKind(p1p1Counter), thisCreature),
      limit = oncePerTurn)],
  power = lit(1),
  toughness = lit(1)
}
