card singleFaced({
    name = "Stonebinder's Familiar",
    cost = [pip(white)],
    types = [creature],
    subtypes = [spirit, dog],
    text = [
      whenever(
        timed(
          does(any, putInto(counted(orMore(1), card), exileZone)),
          duringPart(whose = you, turn)),
        putCounters(1, printedKind(p1p1Counter), this(creature)),
        limit = oncePerTurn)],
    power = 1,
    toughness = 1})
