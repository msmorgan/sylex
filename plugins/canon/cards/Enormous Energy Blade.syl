card singleFaced({
    name = "Enormous Energy Blade",
    cost = [generic(2), pip(black)],
    types = [artifact],
    subtypes = [equipment],
    text = [
      static(getsPt(equipped(creature), up(lit(4)), up(lit(0)))),
      whenever(does(any, attachment(attached, thisEquipment, a(isCreature))), tap(that(creature))),
      equip(mana([generic(2)]))]})
