card singleFaced({
    name = "Enormous Energy Blade",
    cost = [generic(2), pip(black)],
    types = [artifact],
    subtypes = [equipment],
    text = [
      static(getsPt(equipped(creature), up(4), up(0))),
      whenever(
        does(any, attachment(attached, this(equipment), host = a(creature))),
        tap(that(creature))),
      equip(mana([generic(2)]))]})
