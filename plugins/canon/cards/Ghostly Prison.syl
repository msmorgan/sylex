card singleFaced({
    name = "Ghostly Prison",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    text = [
      static(
        gatedBy(
          actor(allOf(creature)),
          attack(defender = you),
          scaledGenericMana(
            forEach(
              2,
              nominal(
                creature,
                post = [controlledBy(they), inCombat(attackerOf, counterpart = you)])))))]})
