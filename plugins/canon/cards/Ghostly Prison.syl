card singleFaced({
    name = "Ghostly Prison",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    text = [
      static(
        gatedBy(
          scaledGenericMana(
            forEach(lit(2), and([isCreature, controlledBy(they), inCombat(attackerOf, you)]))),
          actor(allOf(isCreature)),
          attack(you)))]})
