card singleFaced({
    name = "Wormfang Manta",
    cost = [generic(5), pip(blue), pip(blue)],
    types = [creature],
    subtypes = [nightmare, fish, beast],
    text = [
      flying,
      when(does(actor(thisCreature), enter), skipPart(turn, 1)),
      when(does(actor(thisCreature), leave), extraTurn(1))],
    power = 6,
    toughness = 1})
