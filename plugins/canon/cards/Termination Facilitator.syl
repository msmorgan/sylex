card singleFaced({
    name = "Termination Facilitator",
    cost = [generic(1), pip(black)],
    types = [creature],
    subtypes = [human, assassin],
    text = [
      activatedOnlyDuring(
        tapSymbol,
        putCounters(1, printedKind(bountyCounter), target(or([creature, planeswalker]))),
        asSorcery),
      whenever(
        does(
          any,
          dealDamage(
            recipient = a(
              nominal(
                or([creature, planeswalker]),
                post = [anOpponentControls, withCounter(kind = bountyCounter)])))),
        destroy(it))],
    power = 1,
    toughness = 3})
