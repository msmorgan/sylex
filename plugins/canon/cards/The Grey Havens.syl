card singleFaced({
    name = "The Grey Havens",
    supertypes = [legendary],
    types = [land],
    text = [
      when(does(actor(ownName), enter), scry(1)),
      activated(tapSymbol, addMana(symbols([colorlessPip]))),
      activated(
        tapSymbol,
        addMana(
          counted(
            1,
            ofAnyColorAmong(
              bare(nominal(pre = [legendary, creature], card, post = [in(yourGraveyard)]))))))]})
