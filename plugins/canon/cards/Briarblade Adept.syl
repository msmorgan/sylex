card {
  name = "Briarblade Adept",
  cost = [generic(4), pip(black)],
  types = [creature],
  subtypes = [elf, assassin],
  text = [
    whenever(
      does(actor(thisCreature), attack),
      get(target(and([isCreature, opponentsControl])), down(lit(1)), down(lit(1)), untilEndOfTurn)),
    encore(mana([generic(3), pip(black)]))],
  power = lit(3),
  toughness = lit(4)
}
