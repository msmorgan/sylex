card singleFaced({
    name = "Briarblade Adept",
    cost = [generic(4), pip(black)],
    types = [creature],
    subtypes = [elf, assassin],
    text = [
      whenever(
        does(actor(this(creature)), attack),
        get(
          target(nominal(creature, post = [opponentsControl])),
          down(1),
          down(1),
          duration = untilEndOfTurn)),
      encore(mana([generic(3), pip(black)]))],
    power = 3,
    toughness = 4})
