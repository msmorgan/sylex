card singleFaced({
    name = "Skill Borrower",
    cost = [generic(2), pip(blue)],
    types = [artifact, creature],
    subtypes = [human, wizard],
    text = [
      static(visibility(reveal, you, topOfLibrary)),
      static(
        asLongAs(
          is(topSlice(1), or([isArtifact, isCreature])),
          abilityGrantFrom(thisCreature, topSlice(1), classes = [anyActivated])))],
    power = 1,
    toughness = 3})
