# Bruna, Light of Alabaster: Auras already on the battlefield are attached [CR#701.3a]; Aura
# cards are put onto the battlefield attached to it, each one that could enchant it
# [CR#303.4i].
card singleFaced({
    name = "Bruna, Light of Alabaster",
    cost = [generic(3), pip(white), pip(white), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [angel],
    text = [
      flying,
      vigilance,
      whenever(
        or([does(actor(thisCreature), attack), does(actor(thisCreature), block)]),
        sequentially([
            may(attachTo(counted(anyNumber, nominal(aura, post = [in(battlefield)])), it)),
            may(
              putOntoBattlefieldAttachedTo(
                counted(
                  anyNumber,
                  nominal(
                    pre = [aura],
                    card,
                    post = [couldEnchant(it), in(andOr([yourGraveyard, yourHand]))])),
                it))]))],
    power = 5,
    toughness = 5})
