card singleFaced({
    name = "Chainsaw",
    cost = [generic(1), pip(red)],
    types = [artifact],
    subtypes = [equipment],
    text = [
      when(
        does(actor(this(equipment)), enter),
        instruct(it, dealDamage(amount = 3, recipient = targets(upTo(1), creature)))),
      whenever(
        does(actor(counted(orMore(1), creature)), die),
        putCounters(1, printedKind(revCounter), this(equipment))),
      static(
        conjunction([
            getsPt(equipped(creature), up(letter(x)), up(0)),
            letterDefinition(x, countersOn(revCounter, this(equipment)))])),
      equip(mana([generic(3)]))]})
