card singleFaced({
    name = "Harsh Sustenance",
    cost = [generic(1), pip(white), pip(black)],
    types = [instant],
    text = [
      spell(
        sequentially([
            instruct(this, dealDamage(amount = letter(x), recipient = target(isAnyTarget))),
            gainLife(letter(x)),
            define(x, countOf(and([isCreature, youControl])))]))]})
