card singleFaced({
    name = "Blaring Captain",
    cost = [generic(3), pip(black)],
    types = [creature],
    subtypes = [azra, warrior],
    text = [
      partnerWith(named(printedName("Blaring Recruiter"))),
      whenever(
        does(actor(thisCreature), attack),
        get(allOf(and([hasSubtype(warrior), isAttacking])), up(1), up(1), untilEndOfTurn))],
    power = 2,
    toughness = 2})
