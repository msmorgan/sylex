card singleFaced({
    name = "Apathy",
    cost = [pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(doesntUntap(enchanted(creature), controllerOf(enchanted(creature)))),
      at(
        beginningOfPossessed(controllerOf(enchanted(creature)), upkeep),
        instruct(
          that(player),
          may(discard(aAtRandom(cardIn(handOf(that(player))))), untap(that(creature)))))]})
