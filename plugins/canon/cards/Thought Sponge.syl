card singleFaced({
    name = "Thought Sponge",
    cost = [generic(3), pip(blue)],
    types = [creature],
    subtypes = [sponge],
    text = [
      flash,
      static(
        entersWithCounters(
          this(creature),
          aggregateOver(max, opponent, eventCount(actor(they), draw(anyAmount), soFarThisTurn)),
          p1p1Counter)),
      when(does(actor(this(creature)), die), draw(powerOf(it)))],
    power = 1,
    toughness = 1})
