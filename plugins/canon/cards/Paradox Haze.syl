card singleFaced({
    name = "Paradox Haze",
    cost = [generic(2), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isPlayer),
      at(
        nthOccurrence(nth(1), beginningOfPossessed(enchanted(player), upkeep), per = turn),
        instruct(that(player), additionalStep(upkeep, none, 1)))]})
