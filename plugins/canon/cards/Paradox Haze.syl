card singleFaced({
    name = "Paradox Haze",
    cost = [generic(2), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isPlayer),
      at(
        nthOccurrence(nth(1), beginningOfPossessed(upkeep, enchanted(player)), turn),
        instruct(that(player), additionalStep(upkeep, none, lit(1))))]})
