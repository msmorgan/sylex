card singleFaced({
    name = "Green Ward",
    cost = [pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(
        conjunction([
            abilityGrant(enchanted(creature), [protection(hasColor(green))]),
            doesnt(actor(thisEffect), remove(this(aura)))]))]})
