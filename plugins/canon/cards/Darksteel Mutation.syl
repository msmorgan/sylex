card {
  name = "Darksteel Mutation",
  cost = [1, white],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
          qualityChange(
            enchanted(creature),
            sets,
            bundle({characteristics = {types = [artifact, creature], subtypes = [insect]}})),
          getsBase(it, 0, 1),
          abilityGrant(it, indestructible),
          allAbilityLoss(it)]))]
}
