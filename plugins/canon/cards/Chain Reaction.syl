card singleFaced({
    name = "Chain Reaction",
    cost = [generic(2), pip(red), pip(red)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            instruct(this, dealDamage(amount = letter(x), recipient = each(isCreature))),
            define(x, countOf(isCreature))]))]})
