card singleFaced({
    name = "Iymrith, Desert Doom",
    cost = [generic(3), pip(blue), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [dragon],
    text = [
      flying,
      static(onlyWhile(abilityGrant(thisCreature, [ward(mana([generic(4)]))]), is(it, isUntapped))),
      whenever(
        does(actor(thisCreature), dealDamage(recipient = a(isPlayer), kind = combat)),
        sequentially(
          [draw(1), doIf(compareAmt(countOf(cardIn(yourHand)), less, 3), draw(theDifference))]))],
    power = 5,
    toughness = 5})
