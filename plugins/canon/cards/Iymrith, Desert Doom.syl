card singleFaced({
    name = "Iymrith, Desert Doom",
    cost = [generic(3), pip(blue), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [dragon],
    text = [
      flying,
      static(onlyWhile(abilityGrant(thisCreature, [ward(mana([generic(4)]))]), is(it, untapped))),
      whenever(
        does(actor(thisCreature), dealDamage(kind = combat, recipient = a(player))),
        sequentially([
            draw(1),
            doIf(
              compareAmt(countOf(nominal(card, post = [in(yourHand)])), less, 3),
              draw(theDifference))]))],
    power = 5,
    toughness = 5})
