card singleFaced({
    name = "Battlegate Mimic",
    cost = [generic(1), hybridPip(red, white)],
    types = [creature],
    subtypes = [shapeshifter],
    text = [
      whenever(
        does(actor(you), cast(a(nominal(spell, post = [thatIs(both(red, white))])))),
        establishThroughout(
          conjunction(
            [getsBase(this(creature), 4, 2), abilityGrant(this(creature), [firstStrike])]),
          untilEndOfTurn))],
    power = 2,
    toughness = 1})
