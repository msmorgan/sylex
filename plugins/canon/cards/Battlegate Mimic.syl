card {
  name = "Battlegate Mimic",
  cost = [generic(1), hybridPip(red, white)],
  types = [creature],
  subtypes = [shapeshifter],
  text = [
    whenever(
      does(actor(you), cast(a(and([isSpell, hasColor(red), hasColor(white)])))),
      establishThroughout(
        conjunction(
          [getsBase(thisCreature, lit(4), lit(2)), abilityGrant(thisCreature, firstStrike)]),
        untilEndOfTurn))],
  power = lit(2),
  toughness = lit(1)
}
