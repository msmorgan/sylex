card singleFaced({
    name = "Twinshot Sniper",
    cost = [generic(3), pip(red)],
    types = [artifact, creature],
    subtypes = [goblin, archer],
    text = [
      reach,
      when(
        does(actor(thisCreature), enter),
        instruct(it, dealDamage(amount = 2, recipient = target(isAnyTarget)))),
      channel(
        activated(
          compound(costs = [mana([generic(1), pip(red)]), perform(discard(this))]),
          instruct(it, dealDamage(amount = 2, recipient = target(isAnyTarget)))))],
    power = 2,
    toughness = 3})
