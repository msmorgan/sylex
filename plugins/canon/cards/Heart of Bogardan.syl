card singleFaced({
    name = "Heart of Bogardan",
    cost = [generic(2), pip(red), pip(red)],
    types = [enchantment],
    text = [
      cumulativeUpkeep(mana([generic(2)])),
      when(
        does(
          actor(a(isPlayer)),
          pay(
            anyCost,
            once,
            outcome = unpaid,
            whose = thisEnchantment,
            keyword = cumulativeUpkeep)),
        sequentially([
            simultaneously([
                instruct(
                  this,
                  dealDamage(
                    amount = letter(x),
                    recipient = target(or([isPlaneswalker, isPlayer])))),
                instruct(
                  this,
                  dealDamage(
                    amount = letter(x),
                    recipient = each(and([isCreature, controlledBy(splitOverPlaneswalker)]))))]),
            define(x, minus(times(2, countersOn(ageCounter, thisEnchantment)), 2))]))]})
