card singleFaced({
    name = "Heart of Bogardan",
    cost = [generic(2), pip(red), pip(red)],
    types = [enchantment],
    text = [
      cumulativeUpkeep(mana([generic(2)])),
      when(
        does(
          actor(a(player)),
          pay(
            outcome = unpaid,
            whose = this(enchantment),
            keyword = cumulativeUpkeep,
            payment(anyCost),
            once)),
        sequentially([
            instruct(
              this,
              dealDamage(
                amount = letter(x),
                recipient = and([
                    target(or([player, planeswalker])),
                    each(nominal(creature, post = [controlledBy(splitOverPlaneswalker)]))]))),
            define(x, minus(times(2, countersOn(ageCounter, this(enchantment))), 2))]))]})
