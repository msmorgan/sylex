card singleFaced({
    name = "Ash Zealot",
    cost = [pip(red), pip(red)],
    types = [creature],
    subtypes = [human, warrior],
    text = [
      firstStrike,
      haste,
      whenever(
        does(
          actor(a(isPlayer)),
          cast(a(and([isSpell, did(any, cast(which, from = graveyard), within = thisObject)])))),
        instruct(thisCreature, dealDamage(amount = 3, recipient = that(player))))],
    power = 2,
    toughness = 2})
