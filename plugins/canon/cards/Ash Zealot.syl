card singleFaced({
    name = "Ash Zealot",
    cost = [pip(red), pip(red)],
    types = [creature],
    subtypes = [human, warrior],
    text = [
      firstStrike,
      haste,
      whenever(
        does(
          actor(a(player)),
          cast(
            a(nominal(spell, post = [was(cast(which, from = graveyard), within = thisObject)])))),
        instruct(this(creature), dealDamage(amount = 3, recipient = that(player))))],
    power = 2,
    toughness = 2})
