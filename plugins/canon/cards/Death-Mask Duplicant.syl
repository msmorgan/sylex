card singleFaced({
    name = "Death-Mask Duplicant",
    cost = [generic(7)],
    types = [artifact, creature],
    subtypes = [shapeshifter],
    text = [
      imprint(
        activated(
          mana([generic(1)]),
          exile(target(nominal(pre = [creature], card, post = [in(yourGraveyard)]))))),
      alsoForKeywords(
        static(
          asLongAs(
            exists(
              nominal(card, post = [in(exiledWith(this(creature))), withKeyword(thatKeyword)])),
            keywordGrant(
              this(creature),
              thatKeyword,
              and([in(exiledWith(this(creature))), hasKeyword(thatKeyword)])))),
        [
          theKeyword(flying),
          theKeyword(fear),
          theKeyword(firstStrike),
          theKeyword(doubleStrike),
          theKeyword(haste),
          anyIn({word = landwalk}),
          anyIn({word = protection}),
          theKeyword(trample)])],
    power = 5,
    toughness = 5})
