card singleFaced({
    name = "Blind Fury",
    cost = [generic(2), pip(red), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially(
          steps = [
            establishThroughout(abilityLoss(allOf(isCreature), [written(trample)]), untilEndOfTurn),
            establishThroughout(
              replace(
                would(actor(a(isCreature)), dealDamage(recipient = a(isCreature), kind = combat)),
                instead(
                  instruct(
                    it,
                    dealDamage(amount = times(2, thatMuch), recipient = that(creature))))),
              thisTurn)]))]})
