card singleFaced({
    name = "Blind Fury",
    cost = [generic(2), pip(red), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially([
            establishThroughout(abilityLoss(allOf(creature), [written(trample)]), untilEndOfTurn),
            establishThroughout(
              replace(
                would(actor(a(creature)), dealDamage(kind = combat, recipient = a(creature))),
                instead(
                  instruct(
                    it,
                    dealDamage(amount = times(2, thatMuch), recipient = that(creature))))),
              thisTurn)]))]})
