card singleFaced({
    name = "Rings of Brighthearth",
    cost = [generic(3)],
    types = [artifact],
    text = [
      whenever(
        does(actor(you), activate(a(abilityHead(anyActivated)))),
        if = not(is(that(ability), isManaAbility)),
        may(
          pay(mana([generic(2)]), once),
          ifDid = sequentially(
            steps = [copyOnStack(that(ability)), may(chooseNewTargets(that(copied(ability))))])))]})
