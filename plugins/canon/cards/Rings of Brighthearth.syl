card singleFaced({
    name = "Rings of Brighthearth",
    cost = [generic(3)],
    types = [artifact],
    text = [
      whenever(
        does(actor(you), activate(a(abilityHead(anyActivated)))),
        if = not(is(that(ability), noun(a(manaAbility)))),
        may(
          pay(payment(mana([generic(2)])), once),
          ifDid = sequentially([
              copyOnStack(that(ability)),
              may(chooseNewTargets(that(nominal(pre = [copied], ability))))])))]})
