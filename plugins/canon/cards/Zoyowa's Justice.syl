card singleFaced({
    name = "Zoyowa's Justice",
    cost = [generic(1), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially([
            instruct(
              ownerOf(target(and([or([isArtifact, isCreature]), hasManaValue(atLeast, lit(1))]))),
              shuffleInto(it)),
            instruct(that(player), discover(statOf(stat(manaValue), it)))]))]})
