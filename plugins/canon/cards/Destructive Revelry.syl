card singleFaced({
    name = "Destructive Revelry",
    cost = [pip(red), pip(green)],
    types = [instant],
    text = [
      spell(
        sequentially(
          steps = [
            destroy(target(or([isArtifact, isEnchantment]))),
            instruct(this, dealDamage(amount = 2, recipient = controllerOf(that(permanent))))]))]})
