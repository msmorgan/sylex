card singleFaced({
    name = "Requisition Raid",
    cost = [pip(white)],
    types = [sorcery],
    text = [
      spell(
        chooseSpree([
            plusMode(mana([generic(1)]), destroy(target(isArtifact))),
            plusMode(mana([generic(1)]), destroy(target(isEnchantment))),
            plusMode(
              mana([generic(1)]),
              putCounters(
                1,
                printedKind(p1p1Counter),
                each(and([isCreature, controlledBy(target(isPlayer))]))))]))]})
