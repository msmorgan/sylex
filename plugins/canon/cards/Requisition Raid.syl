card singleFaced({
    name = "Requisition Raid",
    cost = [pip(white)],
    types = [sorcery],
    text = [
      spell(
        chooseSpree([
            plusMode(mana([generic(1)]), destroy(target(artifact))),
            plusMode(mana([generic(1)]), destroy(target(enchantment))),
            plusMode(
              mana([generic(1)]),
              putCounters(
                1,
                printedKind(p1p1Counter),
                each(nominal(creature, post = [controls(target(player))]))))]))]})
