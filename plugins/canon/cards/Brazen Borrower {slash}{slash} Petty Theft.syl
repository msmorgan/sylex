    power = 3,
    toughness = 1},
  {
    name = "Petty Theft",
    cost = [generic(1), pip(blue)],
    types = [instant],
    subtypes = [adventure],
    text = [
      spell(
        returnToHand(target(nominal(pre = [non(land)], permanent, post = [anOpponentControls]))))]})
