card adventurer({
    name = "Brazen Borrower",
    cost = [generic(1), pip(blue), pip(blue)],
    types = [creature],
    subtypes = [faerie, rogue],
    text = [
      flash,
      flying,
      static(
        cant(
          actor(thisCreature),
          block(attacker = allOf(and([isCreature, not(hasKeyword(theKeyword(flying)))])))))],
    power = 3,
    toughness = 1},
  {
    name = "Petty Theft",
    cost = [generic(1), pip(blue)],
    types = [instant],
    subtypes = [adventure],
    text = [spell(returnToHand(target(and([non(isLand), isPermanent, anOpponentControls]))))]})
