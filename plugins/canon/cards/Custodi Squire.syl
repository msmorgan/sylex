card singleFaced({
    name = "Custodi Squire",
    cost = [generic(4), pip(white)],
    types = [creature],
    subtypes = [spirit, cleric],
    text = [
      flying,
      willOfTheCouncil(
        when(
          does(actor(thisCreature), enter),
          sequentially([
              instruct(
                eachPlayer,
                voteStartingWith(
                  you,
                  byCandidate(
                    a(
                      nominal(
                        pre = [or([artifact, creature, enchantment])],
                        card,
                        post = [in(yourGraveyard)]))))),
              returnToHand(allOf(nominal(card, post = [withMostVotes])))])))],
    power = 3,
    toughness = 3})
