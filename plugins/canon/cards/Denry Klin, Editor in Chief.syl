card singleFaced({
    name = "Denry Klin, Editor in Chief",
    cost = [generic(2), pip(white), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [cat, advisor],
    text = [
      static(
        enters(
          thisCreature,
          [
            withCounters(
              lit(1),
              chosenKind([p1p1Counter, firstStrikeCounter, vigilanceCounter]),
              fresh)])),
      whenever(
        does(actor(a(and([isNontoken, and([isCreature, youControl])]))), enter),
        if = is(thisCreature, hasCounter),
        action = doForEachKind(
          counterKind,
          thisCreature,
          counterKind,
          putCounters(statOf(boundCounter, thisCreature), thatKind, that(creature))))],
    power = lit(2),
    toughness = lit(2)})
