card singleFaced({
    name = "Denry Klin, Editor in Chief",
    cost = [generic(2), pip(white), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [cat, advisor],
    text = [
      static(
        enters(
          shortenedName,
          [
            withCounters(
              1,
              chosenKind([p1p1Counter, firstStrikeCounter, vigilanceCounter]),
              fresh)])),
      whenever(
        does(actor(a(nominal(pre = [non(token)], creature, post = [youControl]))), enter),
        if = is(shortenedName, hasCounter),
        doForEachKind(
          counterKind,
          domain = thisCreature,
          counterKind,
          putCounters(statOf(boundCounter, thisCreature), thatKind, that(creature))))],
    power = 2,
    toughness = 2})
