card singleFaced({
    name = "Containment Priest",
    cost = [generic(1), pip(white)],
    types = [creature],
    subtypes = [human, cleric],
    text = [
      flash,
      static(
        replace(
          would(
            actor(
              a(
                nominal(
                  pre = [non(token)],
                  creature,
                  post = [not(was(cast(which), within = thisObject))]))),
            enter),
          instead(exile(it))))],
    power = 2,
    toughness = 2})
