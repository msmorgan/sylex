card singleFaced({
    name = "Gloom",
    cost = [generic(2), pip(black)],
    types = [enchantment],
    text = [
      static(costShift(allOf(and([isSpell, hasColor(white)])), more(3))),
      static(
        costShift(
          allOf(
            and([
                abilityHead(anyActivated),
                abilityOf(allOf(and([isEnchantment, hasColor(white)])))])),
          more(3)))]})
