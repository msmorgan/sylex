card {
  name = "Sinister Strength",
  cost = [generic(1), pip(black)],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
          getsPt(enchanted(creature), up(lit(3)), up(lit(1))),
          qualityChange(it, sets, colored(colors([black])))]))]
}
