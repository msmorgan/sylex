card singleFaced({
    name = "Aegis of Honor",
    cost = [pip(white)],
    types = [enchantment],
    text = [
      activated(
        mana([generic(1)]),
        establishThroughout(
          replace(
            would(
              actor(a(nominal(pre = [or([instant, sorcery])], spell))),
              dealDamage(recipient = you)),
            instead(redirectDamage(allDamage, controllerOf(it))),
            use = nextTimeOnly),
          thisTurn))]})
