card singleFaced({
    name = "Awesome Presence",
    cost = [pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(
        gatedBy(
          any,
          block(attacker = enchanted(creature)),
          scaledGenericMana(
            forEach(
              3,
              nominal(
                creature,
                post = [controlledBy(they), inCombat(blockerOf, counterpart = it)])))))]})
