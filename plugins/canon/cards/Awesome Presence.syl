card singleFaced({
    name = "Awesome Presence",
    cost = [pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        gatedBy(
          scaledGenericMana(
            forEach(
              3,
              and([isCreature, controlledBy(they), inCombat(blockerOf, counterpart = it)]))),
          any,
          block(attacker = enchanted(creature))))]})
