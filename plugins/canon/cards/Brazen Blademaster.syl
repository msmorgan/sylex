card singleFaced({
    name = "Brazen Blademaster",
    cost = [generic(2), pip(red)],
    types = [creature],
    subtypes = [orc, pirate],
    text = [
      whenever(
        timed(
          does(actor(thisCreature), attack),
          whileTrue(compareAmt(countOf(and([isArtifact, youControl])), atLeast, 2))),
        get(it, up(2), up(1), duration = untilEndOfTurn))],
    power = 2,
    toughness = 3})
