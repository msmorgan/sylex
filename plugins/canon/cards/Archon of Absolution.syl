card singleFaced({
    name = "Archon of Absolution",
    cost = [generic(3), pip(white)],
    types = [creature],
    subtypes = [archon],
    text = [
      flying,
      protection(hasColor(white)),
      static(
        gatedBy(
          actor(bare(creature)),
          attack(defender = or([you, bare(nominal(planeswalker, post = [youControl]))])),
          scaledGenericMana(forEachOf(1, those(creature)))))],
    power = 3,
    toughness = 2})
