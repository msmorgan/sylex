card {
  name = "Test of Faith",
  cost = [generic(1), pip(white)],
  types = [instant],
  text = [
    spell(
      establishThroughout(
        replace(
          would(any, dealDamage(recipient = target(isCreature))),
          instead(
            preventDamage(
              theNext(lit(3)),
              also = putCounters(preventedThisWay, printedKind(p1p1Counter), that(creature))))),
        thisTurn))]
}
