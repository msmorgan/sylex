card singleFaced({
    name = "Sonic Shrieker",
    cost = [generic(2), pip(red), pip(white), pip(black)],
    types = [creature],
    subtypes = [dragon],
    text = [
      flying,
      when(
        does(actor(thisCreature), enter),
        sequentially([
            instruct(it, dealDamage(lit(2), target(isAnyTarget))),
            gainLife(lit(2)),
            doIf(
              was(dealDamage(recipient = a(isPlayer)), thisWay),
              instruct(they, discard(a(cardIn(hand)))))]))],
    power = lit(4),
    toughness = lit(4)})
