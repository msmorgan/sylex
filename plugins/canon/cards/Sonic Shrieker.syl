card singleFaced({
    name = "Sonic Shrieker",
    cost = [generic(2), pip(red), pip(white), pip(black)],
    types = [creature],
    subtypes = [dragon],
    text = [
      flying,
      when(
        does(actor(this(creature)), enter),
        sequentially([
            instruct(it, dealDamage(amount = 2, recipient = target(anyTarget))),
            gainLife(2),
            doIf(
              was(dealDamage(recipient = a(player)), thisWay),
              instruct(they, discard(a(nominal(card, post = [in(hand)])))))]))],
    power = 4,
    toughness = 4})
