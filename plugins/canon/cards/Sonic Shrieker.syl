card singleFaced({
    name = "Sonic Shrieker",
    cost = [generic(2), pip(red), pip(white), pip(black)],
    types = [creature],
    subtypes = [dragon],
    text = [
      flying,
      when(
        does(actor(thisCreature), enter),
        sequentially(
          steps = [
            instruct(it, dealDamage(amount = 2, recipient = target(isAnyTarget))),
            gainLife(2),
            doIf(
              was(dealDamage(recipient = a(isPlayer)), thisWay),
              instruct(they, discard(a(cardIn(hand)))))]))],
    power = 4,
    toughness = 4})
