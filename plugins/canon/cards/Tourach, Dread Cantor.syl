card {
  name = "Tourach, Dread Cantor",
  cost = [generic(1), pip(black)],
  supertypes = [legendary],
  types = [creature],
  subtypes = [human, cleric],
  text = [
    kicker(mana([pip(black), pip(black)])),
    protection(hasColor(white)),
    whenever(
      does(actor(anOpponent), discard(a(isCard))),
      putCounters(lit(1), printedKind(p1p1Counter), thisCreature)),
    when(
      does(actor(thisCreature), enter),
      if = keywordCostPaid(kicker, thisCreature),
      action = instruct(target(isOpponent), discard(countedAtRandom(exactly(2), isCard))))],
  power = lit(2),
  toughness = lit(1)
}
