card singleFaced({
    name = "Tourach, Dread Cantor",
    cost = [generic(1), pip(black)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, cleric],
    text = [
      kicker(mana([pip(black), pip(black)])),
      protection(hasColor(white)),
      whenever(
        does(actor(anOpponent), discard(a(card))),
        putCounters(1, printedKind(p1p1Counter), shortenedName)),
      when(
        does(actor(shortenedName), enter),
        if = keywordCostPaid(it, kicker),
        instruct(target(opponent), discard(countedAtRandom(exactly(2), card))))],
    power = 2,
    toughness = 1})
