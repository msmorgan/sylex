card singleFaced({
    name = "Linvala, Keeper of Silence",
    cost = [generic(2), pip(white), pip(white)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [angel],
    text = [
      flying,
      static(
        cant(
          any,
          activate(
            allOf(
              and([
                  abilityHead(anyActivated),
                  abilityOf(allOf(and([isCreature, opponentsControl])))])))))],
    power = 3,
    toughness = 4})
