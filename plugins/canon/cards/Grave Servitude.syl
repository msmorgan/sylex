card singleFaced({
    name = "Grave Servitude",
    cost = [generic(1), pip(black)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      asThoughFlashSacrificedAtCleanup,
      enchant(isCreature),
      static(
        conjunction([
            getsPt(enchanted(creature), up(lit(3)), down(lit(1))),
            qualityChange(it, sets, colored(colors([black])))],
          subject = enchanted(creature)))]})
