card singleFaced({
    name = "Ghoulflesh",
    cost = [pip(black)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        conjunction([
            getsPt(enchanted(creature), down(lit(1)), down(lit(1))),
            qualityChange(
              it,
              adds,
              bundle({characteristics = {colors = [black], subtypes = [zombie]}}))]))]})
