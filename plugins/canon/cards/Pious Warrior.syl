card singleFaced({
    name = "Pious Warrior",
    cost = [generic(3), pip(white)],
    types = [creature],
    subtypes = [human, rebel, warrior],
    text = [
      whenever(
        does(any, dealDamage(kind = combat, recipient = this(creature))),
        gainLife(thatMuch))],
    power = 2,
    toughness = 3})
