card singleFaced({
    name = "Odric, Lunarch Marshal",
    cost = [generic(3), pip(white)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      alsoForKeywords(
        at(
          beginningOfPossessed(eachPlayer, combat),
          doOnlyIf(
            establishThroughout(
              keywordGrant(
                allOf(and([isCreature, youControl])),
                thatKeyword,
                and([isCreature, youControl, hasKeyword(thatKeyword)])),
              untilEndOfTurn),
            exists(and([isCreature, youControl, hasKeyword(thatKeyword)])))),
        [
          theKeyword(firstStrike),
          theKeyword(flying),
          theKeyword(deathtouch),
          theKeyword(doubleStrike),
          theKeyword(haste),
          anyIn({word = hexproof}),
          theKeyword(indestructible),
          theKeyword(lifelink),
          theKeyword(menace),
          theKeyword(reach),
          theKeyword(skulk),
          theKeyword(trample),
          theKeyword(vigilance)])],
    power = 3,
    toughness = 3})
