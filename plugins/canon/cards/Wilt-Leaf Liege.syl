card {
  name = "Wilt-Leaf Liege",
  cost = [generic(1), hybridPip(green, white), hybridPip(green, white), hybridPip(green, white)],
  types = [creature],
  subtypes = [elf, knight],
  text = [
    static(
      getsPt(
        allOf(and([isCreature, hasColor(green), youControl, isOther])),
        up(lit(1)),
        up(lit(1)))),
    static(
      getsPt(
        allOf(and([isCreature, hasColor(white), youControl, isOther])),
        up(lit(1)),
        up(lit(1)))),
    static(
      replace(
        causedBy(
          bySource(a(and([or([isSpell, abilityHead(anyOnStack)]), anOpponentControls]))),
          would(actor(you), discard(thisCard))),
        instead(putOntoBattlefield(it))))],
  power = lit(4),
  toughness = lit(4)
}
