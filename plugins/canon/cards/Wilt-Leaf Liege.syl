card singleFaced({
    name = "Wilt-Leaf Liege",
    cost = [generic(1), hybridPip(green, white), hybridPip(green, white), hybridPip(green, white)],
    types = [creature],
    subtypes = [elf, knight],
    text = [
      static(
        getsPt(bare(nominal(pre = [other, green], creature, post = [youControl])), up(1), up(1))),
      static(
        getsPt(bare(nominal(pre = [other, white], creature, post = [youControl])), up(1), up(1))),
      static(
        replace(
          causedBy(
            bySource(a(nominal(or([spell, abilityHead(anyOnStack)]), post = [anOpponentControls]))),
            would(actor(you), discard(this(card)))),
          instead(putOntoBattlefield(it))))],
    power = 4,
    toughness = 4})
