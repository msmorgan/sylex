card singleFaced({
    name = "Cultivator Colossus",
    cost = [generic(4), pip(green), pip(green), pip(green)],
    types = [creature],
    subtypes = [plant, beast],
    text = [
      trample,
      static(definesPt(thisCreature, countOf(nominal(land, post = [youControl])))),
      when(
        does(actor(thisCreature), enter),
        may(
          putOntoBattlefieldTapped(a(nominal(pre = [land], card, post = [in(yourHand)]))),
          ifDid = sequentially([draw(1), repeat(again)])))]})
