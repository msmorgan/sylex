card singleFaced({
    name = "Ahn-Crop Invader",
    cost = [generic(2), pip(red)],
    types = [creature],
    subtypes = [zombie, minotaur, warrior],
    text = [
      static(partScope(turn, you, abilityGrant(thisCreature, [firstStrike]))),
      activated(
        compound([mana([generic(1)]), perform(sacrifice(a(and([isCreature, isOther]))))]),
        get(thisCreature, up(2), up(0), duration = untilEndOfTurn))],
    power = 2,
    toughness = 2})
