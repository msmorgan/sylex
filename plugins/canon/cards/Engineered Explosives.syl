# Engineered Explosives (its sunburst [CR#702.44a] written out)
card singleFaced({
    name = "Engineered Explosives",
    cost = [variable],
    types = [artifact],
    text = [
      static(entersWithCounters(thisArtifact, colorsSpentToCast(it), chargeCounter)),
      activated(
        compound([mana([generic(2)]), perform(sacrifice(thisArtifact))]),
        destroy(
          each(
            nominal(
              pre = [non(land)],
              permanent,
              post = [hasManaValue(equal, countersOn(chargeCounter, thisArtifact))]))))]})
