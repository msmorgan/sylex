card singleFaced({
    name = "Donal, Herald of Wings",
    cost = [generic(2), pip(blue), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      whenever(
        does(
          actor(you),
          cast(
            a(
              and([
                  isCreature,
                  isSpell,
                  not(hasSupertype(legendary)),
                  hasKeyword(theKeyword(flying))])))),
        doOnlyOnceEachTurn(
          may(
            copyOnStack(
              it,
              exceptions = [
                characteristicEdits([
                    stat(power, set(1)),
                    stat(toughness, set(1)),
                    typeLine(adds, {subtypes = [spirit]})])]))))],
    power = 3,
    toughness = 3})
