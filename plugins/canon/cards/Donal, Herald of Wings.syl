card {
  name = "Donal, Herald of Wings",
  cost = [generic(2), pip(blue), pip(blue)],
  supertypes = [legendary],
  types = [creature],
  subtypes = [human, wizard],
  text = [
    whenever(
      does(
        actor(you),
        cast(
          a(
            and([
                isCreature,
                isSpell,
                not(hasSupertype(legendary)),
                hasKeyword(theKeyword(flying))])))),
      doOnlyOnceEachTurn(
        may(
          copyOnStack(
            it,
            exceptions = copyCharacteristics(
              {subtypes = [spirit], power = lit(1), toughness = lit(1)},
              true)))))],
  power = lit(3),
  toughness = lit(3)
}
