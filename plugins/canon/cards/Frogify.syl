card singleFaced({
    name = "Frogify",
    cost = [generic(1), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        conjunction([
            allAbilityLoss(enchanted(creature)),
            qualityChange(
              it,
              sets,
              bundle({characteristics = {colors = [blue], types = [creature], subtypes = [frog]}})),
            getsBase(it, 1, 1)]))]})
