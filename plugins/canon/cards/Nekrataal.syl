card singleFaced({
    name = "Nekrataal",
    cost = [generic(2), pip(black), pip(black)],
    types = [creature],
    subtypes = [human, assassin],
    text = [
      firstStrike,
      when(
        does(actor(thisCreature), enter),
        doUnderProhibition(
          destroy(target(nominal(pre = [non(artifact), non(black)], creature))),
          regeneration(that(creature))))],
    power = 2,
    toughness = 1})
