card singleFaced({
    name = "Black Ward",
    cost = [pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        conjunction([
            abilityGrant(enchanted(creature), [protection(hasColor(black))]),
            doesnt(actor(thisEffect), remove(thisAura))]))]})
