card singleFaced({
    name = "Secrets of the Dead",
    cost = [generic(2), pip(blue)],
    types = [enchantment],
    text = [
      whenever(
        does(
          actor(you),
          cast(
            a(
              nominal(
                spell,
                post = [was(cast(which, from = yourGraveyard), within = thisObject)])))),
        draw(1))]})
