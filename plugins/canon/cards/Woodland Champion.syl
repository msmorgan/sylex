card singleFaced({
    name = "Woodland Champion",
    cost = [generic(1), pip(green)],
    types = [creature],
    subtypes = [elf, scout],
    text = [
      whenever(
        does(actor(counted(orMore(1), nominal(token, post = [youControl]))), enter),
        putCounters(thatMany, printedKind(p1p1Counter), this(creature)))],
    power = 2,
    toughness = 2})
