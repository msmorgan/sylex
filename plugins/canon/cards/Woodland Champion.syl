card singleFaced({
    name = "Woodland Champion",
    cost = [generic(1), pip(green)],
    types = [creature],
    subtypes = [elf, scout],
    text = [
      whenever(
        does(actor(counted(orMore(1), and([isToken, youControl]))), enter),
        putCounters(groupSize, printedKind(p1p1Counter), thisCreature))],
    power = 2,
    toughness = 2})
