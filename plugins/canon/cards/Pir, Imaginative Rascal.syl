card {
  name = "Pir, Imaginative Rascal",
  cost = [2, green],
  supertypes = [legendary],
  types = [creature],
  subtypes = [human],
  text = [
    partnerWith(named(printedName("Toothy, Imaginary Friend"))),
    static(
      replace(
        would(
          any,
          putCounters(
            anyAmount,
            anyKind,
            a(and([isPermanent, controlledBy(youOr(a(isTeammate)))])))),
        instead(putCounters(plus(thatMuch, 1), thoseCounters, that(permanent)))))],
  power = 1,
  toughness = 1
}
