card singleFaced({
    name = "Pir, Imaginative Rascal",
    cost = [generic(2), pip(green)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human],
    text = [
      partnerWith(named(printedName("Toothy, Imaginary Friend"))),
      static(
        replace(
          would(
            any,
            putCounters(
              anyAmount,
              anyKind,
              a(nominal(permanent, post = [controls(or([you, a(teammate)]))])))),
          instead(putCounters(plus(thatMany, 1), thoseCounters, that(permanent)))))],
    power = 1,
    toughness = 1})
