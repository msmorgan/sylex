card singleFaced({
    name = "Ashes of the Fallen",
    cost = [generic(2)],
    types = [artifact],
    text = [
      static(entersChoosing(this(artifact), subtype(creature))),
      static(
        qualityChange(
          each(nominal(pre = [creature], card, post = [in(yourGraveyard)])),
          adds,
          chosenQuality(ofChosen(subtype(creature)))))]})
