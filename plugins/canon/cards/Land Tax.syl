card singleFaced({
    name = "Land Tax",
    cost = [pip(white)],
    types = [enchantment],
    text = [
      at(
        beginningOfYour(upkeep),
        if = exists(
          compareOver(
            opponent,
            countOf(nominal(land, post = [controls(they)])),
            greater,
            countOf(nominal(land, post = [youControl])))),
        may(
          sequentially([
              search(yourLibrary, for = counted(upTo(3), nominal(pre = [basic, land], card))),
              reveal(those(card)),
              putInto(those(card), hand),
              shuffle])))]})
