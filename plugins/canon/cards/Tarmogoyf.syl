card singleFaced({
    name = "Tarmogoyf",
    cost = [generic(1), pip(green)],
    types = [creature],
    subtypes = [lhurgoyf],
    text = [
      static(
        definesPowerAndToughness(
          ownName,
          distinctCount(cardType, allOf(nominal(card, post = [in(graveyard)]))),
          plus(distinctCount(cardType, allOf(nominal(card, post = [in(graveyard)]))), 1)))]})
