# Coveted Falcon: "Draw a card for each one they gained control of this way" reads the grant
# the opponent's "gains control of any number of target permanents you control" recorded
# [CR#608.2c,613.1b].
card singleFaced({
    name = "Coveted Falcon",
    cost = [generic(1), pip(blue), pip(blue)],
    types = [artifact, creature],
    subtypes = [bird],
    text = [
      flying,
      whenever(
        does(actor(this(creature)), attack),
        gainControl(target(nominal(permanent, post = [youOwn, youDontControl])))),
      disguise(mana([generic(1), pip(blue)])),
      when(
        does(any, turnFaceUp(this(creature))),
        sequentially([
            instruct(
              target(opponent),
              gainControl(targets(anyNumber, nominal(permanent, post = [youControl])))),
            draw(
              forEach(
                eventTally(actor(they), gainControlOf(those(permanent)), thisWay, events),
                permanent))]))],
    power = 1,
    toughness = 4})
