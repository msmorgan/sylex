card singleFaced({
    name = "Culling Ritual",
    cost = [generic(2), pip(black), pip(green)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            destroy(each(nominal(pre = [non(land)], permanent, post = [hasManaValue(atMost, 2)]))),
            addMana(
              forEach(
                or([symbols([pip(black)]), symbols([pip(green)])]),
                nominal(permanent, post = [was(destroy(which), within = thisWay)])))]))]})
