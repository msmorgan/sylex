card {
  name = "Gisa and Geralf",
  cost = [2, blue, black],
  supertypes = [legendary],
  types = [creature],
  subtypes = [human, wizard],
  text = [
    when(does(actor(thisCreature), enter), mill(4)),
    static(
      can(
        actor(you),
        cast(
          counted(exactly(1), and([isSpell, isCreature, hasSubtype(zombie)])),
          from = yourGraveyard),
        timing = onEachOfYourTurns))],
  power = 4,
  toughness = 4
}
