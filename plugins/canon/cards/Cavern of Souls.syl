card singleFaced({
    name = "Cavern of Souls",
    types = [land],
    text = [
      static(entersChoosing(this(land), subtype(creature))),
      activated(tapSymbol, addMana(symbols([colorlessPip]))),
      activated(
        tapSymbol,
        addMana(
          counted(1, ofAnyColor(sameColor)),
          riders = spendOnlyToCastAnd(
            and([hasType(creature), isSpell, ofChosen(subtype(creature))]),
            establish(cant(any, counter(that(spell)))))))]})
