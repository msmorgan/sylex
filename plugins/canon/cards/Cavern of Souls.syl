card singleFaced({
    name = "Cavern of Souls",
    types = [land],
    text = [
      static(entersChoosing(thisLand, subtype(creature))),
      activated(tapSymbol, addMana(symbols([colorlessPip]))),
      activated(
        tapSymbol,
        addMana(
          counted(1, ofAnyColor(sameColor)),
          spendOnlyToCastAnd(
            and([isCreature, isSpell, ofChosen(subtype(creature))]),
            establish(cant(any, counter(that(spell)))))))]})
