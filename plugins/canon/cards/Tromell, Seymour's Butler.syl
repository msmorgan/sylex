card singleFaced({
    name = "Tromell, Seymour's Butler",
    cost = [generic(2), pip(green)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [elf, advisor],
    text = [
      static(
        entersWithAdditionalCounters(
          each(nominal(pre = [other, non(token)], creature, post = [youControl])),
          1,
          p1p1Counter)),
      activated(
        compound([mana([generic(1)]), tapSymbol]),
        sequentially([
            repeatTimes(proliferate, letter(x)),
            define(
              x,
              countOf(
                nominal(
                  pre = [non(token)],
                  creature,
                  post = [
                    youControl,
                    did(actor(which), enter, within = within(soFarThisTurn))])))]))],
    power = 2,
    toughness = 3})
