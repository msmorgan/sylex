card singleFaced({
    name = "Stuffy Doll",
    cost = [generic(5)],
    types = [artifact, creature],
    subtypes = [construct],
    text = [
      indestructible,
      static(entryChoice(thisCreature, a(isPlayer))),
      whenever(
        does(any, dealDamage(recipient = thisCreature)),
        instruct(it, dealDamage(amount = thatMuch, recipient = the(isChosenPlayer)))),
      activated(tapSymbol, instruct(thisCreature, dealDamage(amount = 1, recipient = itself)))],
    power = 0,
    toughness = 1})
