card singleFaced({
    name = "Stuffy Doll",
    cost = [generic(5)],
    types = [artifact, creature],
    subtypes = [construct],
    text = [
      indestructible,
      static(entersChoosingPlayer(thisCreature, a(isPlayer))),
      whenever(
        does(any, dealDamage(recipient = thisCreature)),
        instruct(it, dealDamage(amount = thatMuch, recipient = the(isChosenPlayer)))),
      activated(
        tapSymbol,
        instruct(thisCreature, dealDamage(amount = 1, recipient = thisCreature)))],
    power = 0,
    toughness = 1})
