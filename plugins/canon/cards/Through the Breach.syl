card singleFaced({
    name = "Through the Breach",
    cost = [generic(4), pip(red)],
    types = [instant],
    subtypes = [arcane],
    text = [
      spell(
        may(
          putOntoBattlefield(a(and([isCreature, cardIn(yourHand)]))),
          ifDid = sequentially([
              gain(that(creature), [haste]),
              atNext(beginningOfNext(endStep), sacrifice(that(creature)))]))),
      splice(hasSubtype(arcane), mana([generic(2), pip(red), pip(red)]))]})
