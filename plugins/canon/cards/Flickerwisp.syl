card singleFaced({
    name = "Flickerwisp",
    cost = [generic(1), pip(white), pip(white)],
    types = [creature],
    subtypes = [elemental],
    text = [
      flying,
      when(
        does(actor(thisCreature), enter),
        sequentially(
          steps = [
            exile(target(and([isPermanent, isOther]))),
            atNext(
              beginningOfNext(endStep),
              returnToBattlefield(that(card), riders = [under(ownerOf(it))]))]))],
    power = 3,
    toughness = 1})
