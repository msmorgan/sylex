card singleFaced({
    name = "Flickerwisp",
    cost = [generic(1), pip(white), pip(white)],
    types = [creature],
    subtypes = [elemental],
    text = [
      flying,
      when(
        does(actor(thisCreature), enter),
        sequentially([
            exile(target(nominal(pre = [other], permanent))),
            atNext(
              beginningOfNext(endStep),
              returnToBattlefield(that(card), riders = [underControlOf(ownerOf(it))]))]))],
    power = 3,
    toughness = 1})
