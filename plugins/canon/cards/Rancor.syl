card {
  name = "Rancor",
  cost = [pip(green)],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
          getsPt(enchanted(creature), up(lit(2)), up(lit(0))),
          abilityGrant(enchanted(creature), trample)])),
    when(does(any, putIntoFromBattlefield(thisAura, graveyard)), returnToHand(it))]
}
