card singleFaced({
    name = "Rancor",
    cost = [pip(green)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        conjunction([
            getsPt(enchanted(creature), up(2), up(0)),
            abilityGrant(enchanted(creature), [trample])])),
      when(does(any, putInto(thisAura, graveyard, from = battlefield)), returnToHand(it))]})
