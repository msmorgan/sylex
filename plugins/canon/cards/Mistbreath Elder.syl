card singleFaced({
    name = "Mistbreath Elder",
    cost = [pip(green)],
    types = [creature],
    subtypes = [frog, warrior],
    text = [
      at(
        beginningOfYour(upkeep),
        doIfDone(
          returnToHand(a(and([isCreature, youControl, isOther]))),
          putCounters(lit(1), printedKind(p1p1Counter), thisCreature),
          may(returnToHand(thisCreature))))],
    power = lit(2),
    toughness = lit(2)})
