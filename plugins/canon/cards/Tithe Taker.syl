card singleFaced({
    name = "Tithe Taker",
    cost = [generic(1), pip(white)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      static(
        partScope(
          turn,
          you,
          conjunction([
              costShift(
                allOf(and([isSpell, did(actor(yourOpponents), cast(which), within = thisObject)])),
                more(1)),
              costShift(
                allOf(
                  and([
                      abilityHead(anyActivated),
                      did(actor(yourOpponents), activate(which), within = thisObject),
                      not(isManaAbility)])),
                more(1))]))),
      afterlife(1)],
    power = 2,
    toughness = 1})
