card singleFaced({
    name = "Tithe Taker",
    cost = [generic(1), pip(white)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      static(
        partScope(
          you,
          turn,
          conjunction([
              costShift(
                bare(
                  nominal(
                    spell,
                    post = [did(actor(yourOpponents), cast(which), within = thisObject)])),
                more(1)),
              costShift(
                bare(
                  nominal(
                    ability,
                    post = [did(actor(yourOpponents), activate(which), within = thisObject)])),
                more(1),
                unless = is(them, noun(bare(manaAbility))))]))),
      afterlife(1)],
    power = 2,
    toughness = 1})
