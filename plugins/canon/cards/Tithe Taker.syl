card singleFaced({
    name = "Tithe Taker",
    cost = [generic(1), pip(white)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      static(
        partScope(
          turn,
          you,
          conjunction([
              costShift(
                allOf(and([isSpell, did(actor(yourOpponents), cast(which), thisObject)])),
                more(lit(1))),
              costShift(
                allOf(
                  and([
                      abilityHead(anyActivated),
                      did(actor(yourOpponents), activate(which), thisObject),
                      not(isManaAbility)])),
                more(lit(1)))]))),
      afterlife(lit(1))],
    power = lit(2),
    toughness = lit(1)})
