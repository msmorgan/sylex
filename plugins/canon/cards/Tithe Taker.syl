card singleFaced({
    name = "Tithe Taker",
    cost = [generic(1), pip(white)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      static(
        partScope(
          you,
          turn,
          conjunction([
              costShift(
                allOf(
                  nominal(
                    spell,
                    post = [did(actor(yourOpponents), cast(which), within = thisObject)])),
                more(1)),
              onlyUnless(
                costShift(
                  allOf(
                    nominal(
                      ability,
                      post = [did(actor(yourOpponents), activate(which), within = thisObject)])),
                  more(1)),
                is(them, noun(a(manaAbility))))]))),
      afterlife(1)],
    power = 2,
    toughness = 1})
