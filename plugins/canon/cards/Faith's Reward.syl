card singleFaced({
    name = "Faith's Reward",
    cost = [generic(3), pip(white)],
    types = [instant],
    text = [
      spell(
        returnToBattlefield(
          allOf(
            nominal(
              pre = [permanent],
              card,
              post = [
                in(yourGraveyard),
                was(
                  putInto(which, yourGraveyard, from = battlefield),
                  within = within(soFarThisTurn))]))))]})
