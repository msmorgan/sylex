card singleFaced({
    name = "Faith's Reward",
    cost = [generic(3), pip(white)],
    types = [instant],
    text = [
      spell(
        returnToBattlefield(
          allOf(
            and([
                isPermanentCard,
                in(yourGraveyard),
                was(
                  putInto(which, yourGraveyard, from = battlefield),
                  within(soFarThisTurn))]))))]})
