card singleFaced({
    name = "Soar",
    cost = [generic(1), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      asThoughFlashSacrificedAtCleanup,
      enchant(isCreature),
      static(
        conjunction([
