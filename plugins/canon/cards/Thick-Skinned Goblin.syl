card {
  name = "Thick-Skinned Goblin",
  cost = [1, red],
  types = [creature],
  subtypes = [goblin, shaman],
  text = [
    static(
      replace(
        would(
          actor(you),
          pay(anyCost, once, whose = allOf(and([isPermanent, youControl])), keyword = echo)),
        instead(may(pay(mana([0]), once))))),
    activated(mana([red]), gain(thisCreature, protection(hasColor(red)), untilEndOfTurn))],
  power = 2,
  toughness = 1
}
