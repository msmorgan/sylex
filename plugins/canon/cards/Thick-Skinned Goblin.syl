card singleFaced({
    name = "Thick-Skinned Goblin",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [goblin, shaman],
    text = [
      static(
        replace(
          would(
            actor(you),
            pay(
              whose = bare(nominal(permanent, post = [youControl])),
              keyword = echo,
              payment(anyCost),
              once)),
          instead(may(pay(payment(mana([generic(0)])), once))))),
      activated(
        mana([pip(red)]),
        gain(this(creature), [protection(hasColor(red))], duration = untilEndOfTurn))],
    power = 2,
    toughness = 1})
