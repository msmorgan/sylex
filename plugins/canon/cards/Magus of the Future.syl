card singleFaced({
    name = "Magus of the Future",
    cost = [generic(2), pip(blue), pip(blue), pip(blue)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      static(visibility(reveal, you, topOfLibrary)),
      static(
        conjunction([
            can(actor(you), play(bare(land), from = onTop)),
            can(actor(you), cast(bare(spell), from = onTop))]))],
    power = 2,
    toughness = 3})
