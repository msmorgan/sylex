card singleFaced({
    name = "Incinerate",
    cost = [generic(1), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially([
            instruct(this, dealDamage(amount = 3, recipient = target(anyTarget))),
            establishThroughout(
              cant(
