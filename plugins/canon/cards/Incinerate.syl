card singleFaced({
    name = "Incinerate",
    cost = [generic(1), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially(
          steps = [
            instruct(this, dealDamage(amount = 3, recipient = target(isAnyTarget))),
            establishThroughout(
              cant(
                any,
                regeneration(
                  a(and([isCreature, was(dealDamage(recipient = which), within = thisWay)])))),
              thisTurn)]))]})
