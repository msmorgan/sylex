card singleFaced({
    name = "Xenograft",
    cost = [generic(4), pip(blue)],
    types = [enchantment],
    text = [
      static(entersChoosing(thisEnchantment, subtype(creature))),
      static(
        qualityChange(
          allOf(nominal(creature, post = [youControl])),
          adds,
          chosenQuality(ofChosen(subtype(creature)))))]})
