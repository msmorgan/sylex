card singleFaced({
    name = "Oppressive Rays",
    cost = [pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(
        conjunction([
            gatedBy(actor(enchanted(creature)), attack, mana([generic(3)])),
            gatedBy(actor(enchanted(creature)), block, mana([generic(3)]))])),
      static(
        costShift(
          bare(nominal(abilityHead(anyActivated), post = [ofSource(enchanted(creature))])),
          more(3)))]})
