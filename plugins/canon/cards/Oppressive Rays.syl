card singleFaced({
    name = "Oppressive Rays",
    cost = [pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(
        conjunction([
            gatedBy(actor(enchanted(creature)), attack, mana([generic(3)])),
            gatedBy(actor(enchanted(creature)), block, mana([generic(3)]))])),
      static(
        costShift(
          allOf(and([abilityHead(anyActivated), abilityOf(enchanted(creature))])),
          more(3)))]})
