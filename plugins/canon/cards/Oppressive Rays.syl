card {
  name = "Oppressive Rays",
  cost = [pip(white)],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
          gatedBy(mana([generic(3)]), actor(enchanted(creature)), attack),
          gatedBy(mana([generic(3)]), actor(enchanted(creature)), block)])),
    static(
      costShift(
        allOf(and([abilityHead(anyActivated), abilityOf(enchanted(creature))])),
        more(lit(3))))]
}
