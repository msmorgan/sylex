card singleFaced({
    name = "Cheering Fanatic",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [goblin],
    text = [
      whenever(
        does(actor(thisCreature), attack),
        sequentially([
            choose(a(quality(cardName))),
            establishThroughout(
              costShift(allOf(and([isSpell, ofChosen(cardName)])), less(1)),
              thisTurn)]))],
    power = 2,
    toughness = 2})
