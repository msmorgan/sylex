card singleFaced({
    name = "Shining Shoal",
    cost = [variable, pip(white), pip(white)],
    types = [instant],
    subtypes = [arcane],
    text = [
      static(
        altCost(
          payingInstead(
            perform(
              exile(
                a(
                  nominal(
                    pre = [white],
                    card,
                    post = [hasManaValue(equal, letter(x)), in(yourHand)]))))),
          this(spell))),
      spell(
        establishThroughout(
          replace(
            would(
              actor(aYourChoice(source)),
              dealDamage(recipient = andOr([you, bare(nominal(creature, post = [youControl]))]))),
            instead(redirectDamage(theNext(letter(x)), target(anyTarget)))),
          thisTurn))]})
