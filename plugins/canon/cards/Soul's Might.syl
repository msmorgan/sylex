card singleFaced({
    name = "Soul's Might",
    cost = [generic(4), pip(green)],
    types = [sorcery],
    text = [
      spell(
        sequentially(
          steps = [
            putCounters(letter(x), printedKind(p1p1Counter), target(isCreature)),
            define(x, powerOf(that(creature)))]))]})
