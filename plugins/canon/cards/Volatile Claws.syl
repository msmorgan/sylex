card singleFaced({
    name = "Volatile Claws",
    cost = [generic(2), pip(red)],
    types = [instant],
    text = [
      spell(
        establishFor(
          allOf(and([isCreature, youControl])),
          [getsPt(them, up(2), up(0)), qualityChange(them, adds, everyTypeOf(creature))],
          untilEndOfTurn))]})
