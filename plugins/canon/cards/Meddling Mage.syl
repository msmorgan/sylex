card singleFaced({
    name = "Meddling Mage",
    cost = [pip(white), pip(blue)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      static(entersChoosingFrom(thisCreature, cardName, nameOfCard(non(isLand)))),
      static(cant(any, cast(bare(and([isSpell, named(chosenName)])))))],
    power = lit(2),
    toughness = lit(2)})
