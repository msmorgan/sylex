card singleFaced({
    name = "Meddling Mage",
    cost = [pip(white), pip(blue)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      static(entersChoosingFrom(this(creature), cardName, nameOfCard(non(hasType(land))))),
      static(cant(any, cast(bare(nominal(spell, post = [named(chosenName)])))))],
    power = 2,
    toughness = 2})
