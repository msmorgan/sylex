card singleFaced({
    name = "Sanctum Prelate",
    cost = [generic(1), pip(white), pip(white)],
    types = [creature],
    subtypes = [human, cleric],
    text = [
      static(entersChoosing(thisCreature, number)),
      static(
        cant(any, cast(bare(and([isSpell, non(isCreature), hasManaValue(equal, chosenNumber)])))))],
    power = lit(2),
    toughness = lit(2)})
