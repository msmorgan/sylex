card singleFaced({
    name = "Voracious Brood",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [alien, insect],
    text = [
      static(
        entersWithCounters(
          thisCreature,
          forEach(1, nominal(pre = [creature], card, post = [in(yourGraveyard)])),
          p1p1Counter)),
      whenever(
        does(any, putInto(counted(orMore(1), nominal(pre = [creature], card)), yourGraveyard)),
        putCounters(thatMany, printedKind(p1p1Counter), thisCreature))],
    power = 1,
    toughness = 1})
