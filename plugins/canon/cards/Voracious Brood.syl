card {
  name = "Voracious Brood",
  cost = [generic(2), pip(green)],
  types = [creature],
  subtypes = [alien, insect],
  text = [
    static(
      entersWithCounters(
        thisCreature,
        forEach(lit(1), and([isCreature, in(yourGraveyard)])),
        p1p1Counter)),
    whenever(
      does(
        any,
        putInto(counted(orMore(1), and([isCard, isCreature])), yourGraveyard, from = anywhere)),
      putCounters(groupSize, printedKind(p1p1Counter), thisCreature))],
  power = lit(1),
  toughness = lit(1)
}
