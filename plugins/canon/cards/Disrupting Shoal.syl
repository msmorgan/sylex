card {
  name = "Disrupting Shoal",
  cost = [variable, pip(blue), pip(blue)],
  types = [instant],
  subtypes = [arcane],
  text = [
    static(
      altCost(
        this,
        perform(exile(a(and([hasColor(blue), hasManaValue(equal, letter(x)), in(yourHand)])))))),
    spell(
      doOnlyIf(
        counter(target(isSpell)),
        compareAmt(statOf(stat(manaValue), it), equal, letter(x))))]
}
