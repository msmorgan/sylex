card singleFaced({
    name = "Disrupting Shoal",
    cost = [variable, pip(blue), pip(blue)],
    types = [instant],
    subtypes = [arcane],
    text = [
      static(
        altCost(
          payingInstead(
            perform(
              exile(
                a(
                  nominal(
                    pre = [blue],
                    card,
                    post = [hasManaValue(equal, letter(x)), in(yourHand)]))))),
          this)),
      spell(
        doOnlyIf(
          counter(target(spell)),
          compareAmt(statOf(stat(manaValue), it), equal, letter(x))))]})
