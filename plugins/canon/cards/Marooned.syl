card singleFaced({
    name = "Marooned",
    cost = [pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(or([hasType(artifact), hasType(creature)])),
      when(
        does(actor(this(aura)), enter),
        may(pay(payment(mana([generic(3)])), once), ifDid = tap(enchanted(permanent)))),
      static(
        conjunction(
          [doesntUntap(enchanted(permanent), controllerOf(it)), cant(any, beamUp(it))]))]})
