card singleFaced({
    name = "Snapcaster Mage",
    cost = [generic(1), pip(blue)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      flash,
      when(
        does(actor(thisCreature), enter),
        gain(
          target(nominal(pre = [or([instant, sorcery])], card, post = [in(yourGraveyard)])),
          [flashback(itsManaCost)],
          duration = untilEndOfTurn))],
    power = 2,
    toughness = 1})
