# Spell Swindle: "Counter target spell. Create X Treasure tokens, where X is that spell's mana
# value." The countered spell's mana value is its last known information [CR#608.2h].
card singleFaced({
    name = "Spell Swindle",
    cost = [generic(3), pip(blue), pip(blue)],
    types = [instant],
    text = [
      spell(
        sequentially(
          steps = [
            counter(target(isSpell)),
            create(letter(x), defined(treasureToken)),
            define(x, statOf(stat(manaValue), that(spell)))]))]})
