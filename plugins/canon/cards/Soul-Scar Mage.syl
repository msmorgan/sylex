card singleFaced({
    name = "Soul-Scar Mage",
    cost = [pip(red)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      prowess,
      static(
        replace(
          would(
            actor(a(nominal(source, post = [youControl]))),
            dealDamage(
              kind = noncombat,
              recipient = a(nominal(creature, post = [anOpponentControls])))),
          instead(putCounters(thatMuch, printedKind(m1m1Counter), that(creature)))))],
    power = 1,
    toughness = 2})
