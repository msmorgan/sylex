card {
  name = "Dryad of the Ilysian Grove",
  cost = [2, green],
  types = [enchantment, creature],
  subtypes = [nymph, dryad],
  text = [
    static(
      can(actor(you), play(counted(additional(exactly(1)), isLand)), timing = onEachOfYourTurns)),
    static(qualityChange(allOf(and([isLand, youControl])), adds, everyTypeOf(basicLand)))],
  power = 2,
  toughness = 4
}
