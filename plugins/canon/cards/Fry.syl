card singleFaced({
    name = "Fry",
    cost = [generic(1), pip(red)],
    types = [instant],
    text = [
      static(cant(any, counter(thisSpell))),
      spell(
        instruct(
          this,
          dealDamage(
            amount = 5,
            recipient = target(
              and([or([isCreature, isPlaneswalker]), or([hasColor(white), hasColor(blue)])])))))]})
