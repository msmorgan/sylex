card singleFaced({
    name = "Thranduil's Company",
    cost = [generic(2), pip(green), pip(blue)],
    types = [creature],
    subtypes = [elf, soldier],
    text = [
      static(
        asLongAs(
          exists(nominal(pre = [other], elf, post = [youControl])),
          can(actor(you), play(counted(additional(exactly(1)), land))))),
      landfall(
        whenever(
          does(actor(a(nominal(land, post = [youControl]))), enter),
          sequentially([
              putCounters(
                2,
                printedKind(p1p1Counter),
                target(nominal(creature, post = [youControl]))),
              gain(it, [vigilance], duration = untilEndOfTurn)])))],
    power = 3,
    toughness = 4})
