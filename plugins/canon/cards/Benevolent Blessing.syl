# Fragment: "already" in "Auras and Equipment you control that are already attached to it", those
# attached when the protection starts to apply [CR#702.16p], is missing until
# `syl-already-attached`.
card singleFaced({
    name = "Benevolent Blessing",
    cost = [generic(1), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      flash,
      enchant(isCreature),
      static(entersChoosing(thisAura, color)),
      static(
        conjunction([
            abilityGrant(enchanted(creature), protection(ofChosen(color))),
            doesnt(
              actor(thisEffect),
              remove(
                bare(
                  and([
                      or([hasSubtype(aura), hasSubtype(equipment)]),
                      youControl,
                      attachedTo(it)]))))]))]})
