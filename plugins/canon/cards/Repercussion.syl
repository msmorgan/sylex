card singleFaced({
    name = "Repercussion",
    cost = [generic(1), pip(red), pip(red)],
    types = [enchantment],
    text = [
      whenever(
        does(any, dealDamage(recipient = a(isCreature))),
        instruct(
          thisEnchantment,
          dealDamage(amount = thatMuch, recipient = controllerOf(that(creature)))))]})
