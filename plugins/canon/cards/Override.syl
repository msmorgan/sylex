card singleFaced({
    name = "Override",
    cost = [generic(2), pip(blue)],
    types = [instant],
    text = [
      spell(
        instruct(
          controllerOf(target(isSpell)),
          doUnless(
            instruct(you, counter(it)),
            scaledGenericMana(forEach(lit(1), and([isArtifact, youControl]))))))]})
