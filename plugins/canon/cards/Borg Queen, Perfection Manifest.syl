card singleFaced({
    name = "Borg Queen, Perfection Manifest",
    cost = [generic(4), pip(black), pip(black)],
    supertypes = [legendary],
    types = [artifact, creature],
    subtypes = [borg, noble],
    text = [
      static(getsPt(allOf(nominal(pre = [artifact], creature, post = [youControl])), up(2), up(0))),
      when(
        does(actor(this), enter),
        assimilate(target(nominal(pre = [creature], card, post = [in(graveyardOf(anOpponent))]))))],
    power = 1,
    toughness = 4})
