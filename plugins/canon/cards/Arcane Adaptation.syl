card singleFaced({
    name = "Arcane Adaptation",
    cost = [generic(2), pip(blue)],
    types = [enchantment],
    text = [
      static(entersChoosing(thisEnchantment, subtype(creature))),
      static(
        qualityChange(
          and([
              allOf(nominal(creature, post = [youControl])),
              allOf(nominal(pre = [creature], spell, post = [youControl])),
              allOf(nominal(pre = [creature], card, post = [youOwn, not(in(battlefield))]))]),
          adds,
          chosenQuality(ofChosen(subtype(creature)))))]})
