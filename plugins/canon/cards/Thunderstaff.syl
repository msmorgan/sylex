card singleFaced({
    name = "Thunderstaff",
    cost = [generic(3)],
    types = [artifact],
    text = [
      static(
        asLongAs(
          is(thisArtifact, untapped),
          replace(
            would(actor(a(creature)), dealDamage(kind = combat, recipient = you)),
            instead(preventDamage(ofThatDamage(1)))))),
      activated(
        compound([mana([generic(2)]), tapSymbol]),
        get(bare(nominal(pre = [attacking], creature)), up(1), up(0), duration = untilEndOfTurn))]})
