card singleFaced({
    name = "Thunderstaff",
    cost = [generic(3)],
    types = [artifact],
    text = [
      static(
        conditionFirstWhile(
          is(thisArtifact, isUntapped),
          replace(
            would(actor(a(isCreature)), dealDamage(recipient = you, kind = combat)),
            instead(preventDamage(ofThatDamage(lit(1))))))),
      activated(
        compound([mana([generic(2)]), tapSymbol]),
        get(allOf(and([isCreature, isAttacking])), up(lit(1)), up(lit(0)), untilEndOfTurn))]})
