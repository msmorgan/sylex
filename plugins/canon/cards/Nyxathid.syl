card singleFaced({
    name = "Nyxathid",
    cost = [generic(1), pip(black), pip(black)],
    types = [creature],
    subtypes = [elemental],
    text = [
      static(entersChoosingPlayer(thisCreature, anOpponent)),
      static(
        getsPt(
          thisCreature,
          down(countOf(cardIn(handOf(the(isChosenPlayer))))),
          down(countOf(cardIn(handOf(the(isChosenPlayer)))))))],
    power = lit(7),
    toughness = lit(7)})
