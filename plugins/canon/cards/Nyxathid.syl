card singleFaced({
    name = "Nyxathid",
    cost = [generic(1), pip(black), pip(black)],
    types = [creature],
    subtypes = [elemental],
    text = [
      static(entersChoosingPlayer(thisCreature, anOpponent)),
      static(getsBoth(thisCreature, down(countOf(cardIn(handOf(the(isChosenPlayer)))))))],
    power = 7,
