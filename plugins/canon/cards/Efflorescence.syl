card singleFaced({
    name = "Efflorescence",
    cost = [generic(2), pip(green)],
    types = [instant],
    text = [
      spell(putCounters(2, printedKind(p1p1Counter), target(isCreature))),
      infusion(
        spell(
          doIf(
            did(actor(you), gainLife(anyAmount), within(soFarThisTurn)),
            gain(that(creature), [trample, indestructible], untilEndOfTurn))))]})
