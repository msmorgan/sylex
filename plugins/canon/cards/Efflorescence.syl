card {
  name = "Efflorescence",
  cost = [generic(2), pip(green)],
  types = [instant],
  text = [
    spell(putCounters(lit(2), printedKind(p1p1Counter), target(isCreature))),
    infusion(
      spell(
        doIf(
          did(actor(you), gainLife(anyAmount), within(soFarThisTurn)),
          establishFor(
            that(creature),
            [abilityGrant(it, trample), abilityGrant(it, indestructible)],
            untilEndOfTurn))))]
}
