card singleFaced({
    name = "Glorious Enforcer",
    cost = [generic(5), pip(white), pip(white)],
    types = [creature],
    subtypes = [angel],
    text = [
      flying,
      lifelink,
      at(
        beginningOfEach(combat),
        gain(thisCreature, [doubleStrike], duration = untilEndOfTurn),
        if = compareAmt(lifeTotalOf(you), greater, lifeTotalOf(anOpponent)))],
    power = 5,
    toughness = 5})
