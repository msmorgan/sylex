card singleFaced({
    name = "Blazing Shoal",
    cost = [variable, pip(red), pip(red)],
    types = [instant],
    subtypes = [arcane],
    text = [
      static(
        altCost(
          payingInstead(
            perform(
              exile(
                a(
                  nominal(
                    pre = [red],
                    card,
                    post = [hasManaValue(equal, letter(x)), in(yourHand)]))))),
          this(spell))),
      spell(get(target(creature), up(letter(x)), up(0), duration = untilEndOfTurn))]})
