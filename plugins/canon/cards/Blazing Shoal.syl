card singleFaced({
    name = "Blazing Shoal",
    cost = [variable, pip(red), pip(red)],
    types = [instant],
    subtypes = [arcane],
    text = [
      static(
        altCost(
          payingInstead(
            perform(exile(a(and([hasColor(red), hasManaValue(equal, letter(x)), in(yourHand)]))))),
          this)),
      spell(get(target(isCreature), up(letter(x)), up(0), duration = untilEndOfTurn))]})
