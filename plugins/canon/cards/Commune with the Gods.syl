card singleFaced({
    name = "Commune with the Gods",
    cost = [generic(1), pip(green)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            reveal(topSlice(5)),
            may(
              putInto(
                fromAmong(exactly(1), nominal(pre = [or([creature, enchantment])], card), them),
                hand)),
            putInto(theRest, graveyard)]))]})
