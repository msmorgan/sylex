card singleFaced({
    name = "Loaming Shaman",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [centaur, shaman],
    text = [
      when(
        does(actor(thisCreature), enter),
        instruct(target(isPlayer), shuffleInto(targets(anyNumber, cardIn(graveyardOf(they))))))],
    power = 3,
    toughness = 2})
