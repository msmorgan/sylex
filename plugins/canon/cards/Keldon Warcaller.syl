card {
  name = "Keldon Warcaller",
  cost = [generic(1), pip(red)],
  types = [creature],
  subtypes = [human, warrior],
  text = [
    whenever(
      does(actor(thisCreature), attack),
      putCounters(lit(1), printedKind(loreCounter), target(and([hasSubtype(saga), youControl]))))],
  power = lit(2),
  toughness = lit(2)
}
