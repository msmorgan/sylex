card {
  name = "Spider Climb",
  cost = [pip(green)],
  types = [enchantment],
  subtypes = [aura],
  text = [
    asThoughFlashSacrificedAtCleanup,
    enchant(isCreature),
    static(
      conjunction([
          getsPt(enchanted(creature), up(lit(0)), up(lit(3))),
          abilityGrant(enchanted(creature), reach)],
        subject = enchanted(creature)))]
}
