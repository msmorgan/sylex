card singleFaced({
    name = "Spider Climb",
    cost = [pip(green)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      asThoughFlashSacrificedAtCleanup,
      enchant(isCreature),
      static(
        conjunction(
          [getsPt(enchanted(creature), up(0), up(3)), abilityGrant(enchanted(creature), reach)],
          subject = enchanted(creature)))]})
