card singleFaced({
    name = "New Perspectives",
    cost = [generic(5), pip(blue)],
    types = [enchantment],
    text = [
      when(does(actor(thisEnchantment), enter), draw(3)),
      static(
        asLongAs(
          compareAmt(countOf(cardIn(yourHand)), atLeast, 7),
          altCost(payingInstead(mana([generic(0)])), allOf(abilityHead(keyword(cycling))))))]})
