card singleFaced({
    name = "Plaza of Heroes",
    types = [land],
    text = [
      activated(tapSymbol, addMana(symbols([colorlessPip]))),
      activated(
        tapSymbol,
        addMana(
          counted(1, ofAnyColor(sameColor)),
          riders = [spendOnly([toCast(and([hasSupertype(legendary), isSpell]))])])),
      activated(
        tapSymbol,
        addMana(
          counted(
            1,
            ofAnyColorAmong(bare(nominal(pre = [legendary], permanent, post = [youControl])))))),
      activated(
        compound([mana([generic(3)]), tapSymbol, perform(exile(thisLand))]),
        gain(
          target(nominal(pre = [legendary], creature)),
          [hexproof, indestructible],
          duration = untilEndOfTurn))]})
