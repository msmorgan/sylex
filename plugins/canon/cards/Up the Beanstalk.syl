card singleFaced({
    name = "Up the Beanstalk",
    cost = [generic(1), pip(green)],
    types = [enchantment],
    text = [
      triggered(
        and([
            when(does(actor(this(enchantment)), enter)),
            whenever(
              does(actor(you), cast(a(nominal(spell, post = [hasManaValue(atLeast, 5)])))))]),
        draw(1))]})
