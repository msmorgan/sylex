card singleFaced({
    name = "Up the Beanstalk",
    cost = [generic(1), pip(green)],
    types = [enchantment],
    text = [
      triggered(
        and([
            when(does(actor(this), enter)),
            whenever(does(actor(you), cast(a(and([isSpell, hasManaValue(atLeast, 5)])))))]),
        action = draw(1))]})
