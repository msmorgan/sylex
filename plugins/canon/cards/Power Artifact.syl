card singleFaced({
    name = "Power Artifact",
    cost = [pip(blue), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(artifact)),
      static(
        costShift(
          allOf(nominal(abilityHead(anyActivated), post = [ofSource(enchanted(artifact))])),
          less(2, floor = 1)))]})
