card singleFaced({
    name = "Power Artifact",
    cost = [pip(blue), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isArtifact),
      static(
        costShift(
          allOf(and([abilityHead(anyActivated), abilityOf(enchanted(artifact))])),
          less(2, 1)))]})
