card singleFaced({
    name = "Kaervek's Purge",
    cost = [variable, pip(black), pip(red)],
    types = [sorcery],
    text = [
      spell(
        sequentially(
          steps = [
            destroy(target(and([isCreature, hasManaValue(equal, letter(x))]))),
            doIf(
              did(actor(that(creature)), die, thisWay),
              instruct(
                this,
                dealDamage(
                  amount = powerOf(that(creature)),
                  recipient = controllerOf(that(creature)))))]))]})
