card singleFaced({
    name = "Nightmarish End",
    cost = [generic(2), pip(black)],
    types = [instant],
    text = [
      spell(
        sequentially([
            get(target(isCreature), down(letter(x)), down(letter(x)), duration = untilEndOfTurn),
            define(x, countOf(cardIn(yourHand)))]))]})
