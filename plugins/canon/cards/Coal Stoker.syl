card {
  name = "Coal Stoker",
  cost = [3, red],
  types = [creature],
  subtypes = [elemental],
  text = [
    when(
      does(actor(thisCreature), enter),
      if = is(it, did(actor(you), cast(which, from = yourHand), thisObject)),
      action = addMana(1, manaOf([[of(red), of(red), of(red)]])))],
  power = 3,
  toughness = 3
}
