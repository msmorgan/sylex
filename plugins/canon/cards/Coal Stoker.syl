card singleFaced({
    name = "Coal Stoker",
    cost = [generic(3), pip(red)],
    types = [creature],
    subtypes = [elemental],
    text = [
      when(
        does(actor(thisCreature), enter),
        if = is(it, did(actor(you), cast(which, from = yourHand), thisObject)),
        action = addMana(1, manaOf([[colored(red), colored(red), colored(red)]])))],
    power = 3,
    toughness = 3})
