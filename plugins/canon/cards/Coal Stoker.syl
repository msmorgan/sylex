card singleFaced({
    name = "Coal Stoker",
    cost = [generic(3), pip(red)],
    types = [creature],
    subtypes = [elemental],
    text = [
      when(
        does(actor(thisCreature), enter),
        addMana(symbols([pip(red), pip(red), pip(red)])),
        if = is(it, did(actor(you), cast(which, from = yourHand), within = thisObject)))],
    power = 3,
    toughness = 3})
