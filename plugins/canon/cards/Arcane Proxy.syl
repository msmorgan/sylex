card prototype({
    name = "Arcane Proxy",
    cost = [generic(7)],
    types = [artifact, creature],
    subtypes = [wizard],
    text = [
      prototype,
      when(
        does(actor(thisCreature), enter),
        sequentially(
          steps = [
            exile(
              target(
                and([
                    isInstantOrSorcery,
                    isCard,
                    hasManaValue(atMost, powerOf(thisCreature)),
                    in(yourGraveyard)]))),
            copy(fromCardZone, that(card), 1, []),
            may(cast(that(copy), altCost = withoutPaying))]),
        if = is(it, did(actor(you), cast(which), within = thisObject)))],
    power = 4,
    toughness = 3},
  {cost = [generic(1), pip(blue), pip(blue)], power = 2, toughness = 1})
