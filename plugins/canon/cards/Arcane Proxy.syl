card prototype(
  inner = {
    name = "Arcane Proxy",
    cost = [generic(7)],
    types = [artifact, creature],
    subtypes = [wizard],
    text = [
      prototype,
      when(
        does(actor(thisCreature), enter),
        if = is(it, did(actor(you), cast(which), thisObject)),
        action = sequentially([
            exile(
              target(
                and([
                    isInstantOrSorcery,
                    isCard,
                    hasManaValue(atMost, powerOf(thisCreature)),
                    in(yourGraveyard)]))),
            copy(fromCardZone, that(card), lit(1), []),
            may(cast(that(copy), payment = withoutPaying))]))],
    power = lit(4),
    toughness = lit(3)},
  alternative = {cost = [generic(1), pip(blue), pip(blue)], power = lit(2), toughness = lit(1)})
