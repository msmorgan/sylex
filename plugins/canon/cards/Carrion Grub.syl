card singleFaced({
    name = "Carrion Grub",
    cost = [generic(3), pip(black)],
    types = [creature],
    subtypes = [insect],
    text = [
      static(
        conjunction([
            getsPt(thisCreature, up(letter(x)), up(0)),
            letterDefinition(
              x,
              aggregate(max, stat(power), and([isCreature, in(yourGraveyard)])))])),
      when(does(actor(thisCreature), enter), mill(4))],
    power = 0,
    toughness = 5})
