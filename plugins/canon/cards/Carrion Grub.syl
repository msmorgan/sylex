card {
  name = "Carrion Grub",
  cost = [generic(3), pip(black)],
  types = [creature],
  subtypes = [insect],
  text = [
    static(
      conjunction([
          getsPt(thisCreature, up(letter(x)), up(lit(0))),
          letterDefinition(x, aggregate(max, stat(power), and([isCreature, in(yourGraveyard)])))])),
    when(does(actor(thisCreature), enter), mill(lit(4)))],
  power = lit(0),
  toughness = lit(5)
}
