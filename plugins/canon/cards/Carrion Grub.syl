card singleFaced({
    name = "Carrion Grub",
    cost = [generic(3), pip(black)],
    types = [creature],
    subtypes = [insect],
    text = [
      static(
        conjunction([
            getsPt(this(creature), up(letter(x)), up(0)),
            letterDefinition(
              x,
              aggregateAll(
                max,
                stat(power),
                nominal(pre = [creature], card, post = [in(yourGraveyard)])))])),
      when(does(actor(this(creature)), enter), mill(4))],
    power = 0,
    toughness = 5})
