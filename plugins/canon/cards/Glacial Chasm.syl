card singleFaced({
    name = "Glacial Chasm",
    types = [land],
    text = [
      cumulativeUpkeep(perform(payLife(amount = 2))),
      when(does(actor(thisLand), enter), sacrifice(a(land))),
      static(cant(actor(allOf(nominal(creature, post = [youControl]))), attack)),
      static(replace(would(any, dealDamage(recipient = you)), instead(preventDamage(allDamage))))]})
