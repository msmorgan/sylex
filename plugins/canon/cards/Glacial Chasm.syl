card singleFaced({
    name = "Glacial Chasm",
    types = [land],
    text = [
      cumulativeUpkeep(perform(payLife(amount = 2))),
      when(does(actor(thisLand), enter), sacrifice(a(isLand))),
      static(cant(actor(allOf(and([isCreature, youControl]))), attack)),
      static(replace(would(any, dealDamage(recipient = you)), instead(preventDamage(allDamage))))]})
