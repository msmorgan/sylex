card singleFaced({
    name = "Dream Thief",
    cost = [generic(2), pip(blue)],
    types = [creature],
    subtypes = [faerie, rogue],
    text = [
      flying,
      when(
        does(actor(this(creature)), enter),
        doOnlyIf(
          draw(1),
          did(actor(you), cast(a(nominal(pre = [other, blue], spell))), within(soFarThisTurn))))],
    power = 2,
    toughness = 1})
