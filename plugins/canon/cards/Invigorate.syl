card singleFaced({
    name = "Invigorate",
    cost = [generic(2), pip(green)],
    types = [instant],
    text = [
      static(
        onlyWhile(
          altCost(this, perform(instruct(anOpponent, gainLife(3)))),
          exists(and([isLand, hasSubtype(forest), youControl])))),
      spell(get(target(isCreature), up(4), up(4), untilEndOfTurn))]})
