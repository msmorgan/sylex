card singleFaced({
    name = "Invigorate",
    cost = [generic(2), pip(green)],
    types = [instant],
    text = [
      static(
        if(
          exists(and([isLand, hasSubtype(forest), youControl])),
          ratherThanPay(this, payingInstead(perform(instruct(anOpponent, gainLife(3))))))),
      spell(get(target(isCreature), up(4), up(4), untilEndOfTurn))]})
