card singleFaced({
    name = "Invigorate",
    cost = [generic(2), pip(green)],
    types = [instant],
    text = [
      static(
        if(
          exists(nominal(forest, post = [youControl])),
          ratherThanPay(this(spell), payingInstead(perform(instruct(anOpponent, gainLife(3))))))),
      spell(get(target(creature), up(4), up(4), duration = untilEndOfTurn))]})
