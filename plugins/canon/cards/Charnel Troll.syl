card singleFaced({
    name = "Charnel Troll",
    cost = [generic(1), pip(black), pip(green)],
    types = [creature],
    subtypes = [troll],
    text = [
      trample,
      at(
        beginningOfYour(upkeep),
        doIfDone(
          exile(a(and([isCreature, in(yourGraveyard)]))),
          ifDid = putCounters(1, printedKind(p1p1Counter), thisCreature),
          ifNot = sacrifice(thisCreature))),
      activated(
        compound(
          costs = [
            mana([pip(black), pip(green)]),
            perform(discard(a(and([isCreature, in(yourHand)]))))]),
        putCounters(1, printedKind(p1p1Counter), thisCreature))],
    power = 4,
    toughness = 4})
