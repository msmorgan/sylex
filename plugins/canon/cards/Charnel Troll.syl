card {
  name = "Charnel Troll",
  cost = [1, black, green],
  types = [creature],
  subtypes = [troll],
  text = [
    trample,
    at(
      beginningOfYour(upkeep),
      doIfDone(
        exile(a(and([isCreature, in(yourGraveyard)]))),
        putCounters(1, printedKind(p1p1Counter), thisCreature),
        sacrifice(thisCreature))),
    activated(
      compound([mana([black, green]), perform(discard(a(and([isCreature, in(yourHand)]))))]),
      putCounters(1, printedKind(p1p1Counter), thisCreature))],
  power = 4,
  toughness = 4
}
