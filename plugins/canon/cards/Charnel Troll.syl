card singleFaced({
    name = "Charnel Troll",
    cost = [generic(1), pip(black), pip(green)],
    types = [creature],
    subtypes = [troll],
    text = [
      trample,
      at(
        beginningOfYour(upkeep),
        doIfDone(
          exile(a(and([isCreature, in(yourGraveyard)]))),
          putCounters(1, printedKind(p1p1Counter), thisCreature),
          sacrifice(thisCreature))),
      activated(
        compound(
          [mana([pip(black), pip(green)]), perform(discard(a(and([isCreature, in(yourHand)]))))]),
        putCounters(1, printedKind(p1p1Counter), thisCreature))],
    power = 4,
    toughness = 4})
