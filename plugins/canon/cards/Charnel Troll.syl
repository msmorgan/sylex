card singleFaced({
    name = "Charnel Troll",
    cost = [generic(1), pip(black), pip(green)],
    types = [creature],
    subtypes = [troll],
    text = [
      trample,
      at(
        beginningOfYour(upkeep),
        doIfDone(
          exile(a(nominal(pre = [creature], card, post = [in(yourGraveyard)]))),
          ifDid = putCounters(1, printedKind(p1p1Counter), this(creature)),
          ifNot = sacrifice(it))),
      activated(
        compound([
            mana([pip(black), pip(green)]),
            perform(discard(a(nominal(pre = [creature], card, post = [in(yourHand)]))))]),
        putCounters(1, printedKind(p1p1Counter), this(creature)))],
    power = 4,
    toughness = 4})
