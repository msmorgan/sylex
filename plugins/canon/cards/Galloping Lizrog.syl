card singleFaced({
    name = "Galloping Lizrog",
    cost = [generic(3), pip(green), pip(blue)],
    types = [creature],
    subtypes = [frog, lizard],
    text = [
      trample,
      when(
        does(actor(this(creature)), enter),
        may(
          removeCounters(
            anyNumber,
            printedKind(p1p1Counter),
            among(bare(nominal(creature, post = [youControl])))),
          ifDid = putCounters(times(2, thatMany), printedKind(p1p1Counter), this(creature))))],
    power = 3,
    toughness = 3})
