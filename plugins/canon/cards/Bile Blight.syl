card singleFaced({
    name = "Bile Blight",
    cost = [pip(black), pip(black)],
    types = [instant],
    text = [
      spell(
        get(
          and([
              target(creature),
              allOf(
                nominal(
                  pre = [other],
                  creature,
                  post = [shares(cardName, share, that(creature))]))]),
          down(3),
          down(3),
          duration = untilEndOfTurn))]})
