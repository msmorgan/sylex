card singleFaced({
    name = "Extra Arms",
    cost = [generic(4), pip(red)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      whenever(
        does(actor(enchanted(creature)), attack),
        instruct(it, dealDamage(amount = 2, recipient = target(anyTarget))))]})
