card singleFaced({
    name = "Scourge of Nel Toth",
    cost = [generic(5), pip(black), pip(black)],
    types = [creature],
    subtypes = [zombie, dragon],
    text = [
      flying,
      static(
        can(
          actor(you),
          cast(
            this,
            from = yourGraveyard,
            altCost = payingInstead(
              compound([
                  mana([pip(black), pip(black)]),
                  perform(sacrifice(counted(exactly(2), isCreature)))])))))],
    power = 6,
    toughness = 6})
