card singleFaced({
    name = "Malamet Battle Glyph",
    cost = [pip(green)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            choose(
              and([
                  target(nominal(creature, post = [youControl])),
                  target(nominal(creature, post = [youDontControl]))])),
            doIf(
              did(actor(the(nominal(creature, post = [youControl]))), enter, within(soFarThisTurn)),
              putCounters(1, printedKind(p1p1Counter), it)),
            fightEachOther(those(creature))]))]})
