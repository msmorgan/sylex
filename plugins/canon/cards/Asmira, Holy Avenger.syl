card singleFaced({
    name = "Asmira, Holy Avenger",
    cost = [generic(2), pip(green), pip(white)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, cleric],
    text = [
      flying,
      at(
        beginningOfPossessed(endStep, eachPlayer),
        putCounters(
          eventCount(putInto(a(isCreature), yourGraveyard, from = battlefield), any, soFarThisTurn),
          printedKind(p1p1Counter),
          thisCreature))],
    power = 2,
    toughness = 3})
