card singleFaced({
    name = "Flickering Ward",
    cost = [pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isCreature),
      static(entersChoosing(thisAura, color)),
      static(
        conjunction([
            abilityGrant(enchanted(creature), [protection(ofChosen(color))]),
            doesnt(actor(thisEffect), remove(thisAura))])),
      activated(mana([pip(white)]), returnToHand(thisAura))]})
