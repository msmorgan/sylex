card singleFaced({
    name = "Council's Judgment",
    cost = [generic(1), pip(white), pip(white)],
    types = [sorcery],
    text = [
      willOfTheCouncil(
        spell(
          sequentially([
              instruct(
                eachPlayer,
                voteStartingWith(
                  you,
                  byCandidate(a(nominal(pre = [non(land)], permanent, post = [youDontControl]))))),
              exile(allOf(nominal(permanent, post = [withMostVotes])))])))]})
