card {
  name = "Naban, Dean of Iteration",
  cost = [1, blue],
  supertypes = [legendary],
  types = [creature],
  subtypes = [human, wizard],
  text = [
    static(
      additionalTriggers(
        causes(
          byEvent(does(actor(a(and([hasSubtype(wizard), youControl]))), enter)),
          triggers(
            a(and([abilityHead(anyTriggered), abilityOf(a(and([isPermanent, youControl])))])))),
        exactly(1)))],
  power = 2,
  toughness = 1
}
