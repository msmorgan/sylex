card singleFaced({
    name = "Naban, Dean of Iteration",
    cost = [generic(1), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      static(
        additionalTriggers(
          causes(
            byEvent(does(actor(a(nominal(wizard, post = [youControl]))), enter)),
            triggers(
              a(
                nominal(
                  abilityHead(anyTriggered),
                  post = [of(a(nominal(permanent, post = [youControl])))])))),
          exactly(1)))],
    power = 2,
    toughness = 1})
