card singleFaced({
    name = "Phyrexian Rebirth",
    cost = [generic(4), pip(white), pip(white)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            destroy(allOf(creature)),
            create(
              1,
              written({
                  characteristics = {
                    types = [artifact, creature],
                    subtypes = [phyrexian, horror],
                    power = letter(x),
                    toughness = letter(x)}})),
            define(
              x,
              countOf(nominal(creature, post = [was(destroy(which), within = thisWay)])))]))]})
