card singleFaced({
    name = "Leyline of Vitality",
    cost = [generic(2), pip(green), pip(green)],
    types = [enchantment],
    text = [
      mayBeginOnBattlefield,
      static(getsPt(bare(nominal(creature, post = [youControl])), up(0), up(1))),
      whenever(does(actor(a(nominal(creature, post = [youControl]))), enter), may(gainLife(1)))]})
