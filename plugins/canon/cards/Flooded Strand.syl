card singleFaced({
    name = "Flooded Strand",
    types = [land],
    text = [
      activated(
        compound([tapSymbol, perform(payLife(amount = 1)), perform(sacrifice(thisLand))]),
        sequentially([
            search(
              yourLibrary,
              for = a(and([isCard, or([hasSubtype(plains), hasSubtype(island)])]))),
            putOntoBattlefield(it),
            shuffle]))]})
