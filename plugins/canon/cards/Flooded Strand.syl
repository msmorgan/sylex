card singleFaced({
    name = "Flooded Strand",
    types = [land],
    text = [
      activated(
        compound([tapSymbol, perform(payLife(amount = 1)), perform(sacrifice(this(land)))]),
        sequentially([
            search(yourLibrary, for = a(nominal(pre = [or([plains, island])], card))),
            putOntoBattlefield(it),
            shuffle]))]})
