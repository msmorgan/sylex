# Juxtapose: "You and target player exchange control of the creature you each control with the
# greatest mana value. Then exchange control of artifacts the same way. If two or more permanents
# a player controls are tied for greatest, their controller chooses one of them." "The same way"
# is written out as the second exchange.
card singleFaced({
    name = "Juxtapose",
    cost = [generic(3), pip(blue)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            exchangeControl(
              the(
                nominal(
                  creature,
                  post = [
                    controls(you),
                    superlative(max, stat(manaValue), nominal(creature, post = [controls(you)]))])),
              the(
                nominal(
                  creature,
                  post = [
                    controls(target(player)),
                    superlative(
                      max,
                      stat(manaValue),
                      nominal(creature, post = [controls(target(player))]))]))),
            exchangeControl(
              the(
                nominal(
                  artifact,
                  post = [
                    controls(you),
                    superlative(max, stat(manaValue), nominal(artifact, post = [controls(you)]))])),
              the(
                nominal(
                  artifact,
                  post = [
                    controls(that(player)),
                    superlative(
                      max,
                      stat(manaValue),
                      nominal(artifact, post = [controls(that(player))]))]))),
            doIf(
              thereAre(
                counted(
                  orMore(2),
                  nominal(
                    permanent,
                    post = [
                      controls(a(player)),
                      tiedFor(
                        max,
                        stat(manaValue),
                        nominal(permanent, post = [controls(that(player))]))]))),
              instruct(controllerOf(them), choose(partOf(exactly(1), them))))]))]})
