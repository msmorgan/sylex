card singleFaced({
    name = "Shah of Naar Isle",
    cost = [generic(3), pip(red)],
    types = [creature],
    subtypes = [efreet],
    text = [
      trample,
      echo(mana([generic(0)])),
      when(
        does(any, pay(anyCost, once, whose = thisCreature, keyword = echo)),
        instruct(eachOpponent, may(drawCount(upToOf(3)))))],
    power = 6,
    toughness = 6})
