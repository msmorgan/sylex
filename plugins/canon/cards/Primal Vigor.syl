card singleFaced({
    name = "Primal Vigor",
    cost = [generic(4), pip(green)],
    types = [enchantment],
    text = [
      static(
        replace(
          would(any, createObject(anyAmount, token(copyOf(counted(orMore(1), token)), []))),
          instead(create(times(2, thatMany), asThose)))),
      static(
        replace(
          would(any, putCounters(anyAmount, printedKind(p1p1Counter), a(creature))),
          instead(putCounters(times(2, thatMany), printedKind(p1p1Counter), that(creature)))))]})
