card {
  name = "Primal Vigor",
  cost = [generic(4), pip(green)],
  types = [enchantment],
  text = [
    static(
      replace(
        would(any, createObject(anyAmount, token(copyOf(counted(orMore(1), isToken)), []))),
        instead(create(times(lit(2), groupSize), asThose)))),
    static(
      replace(
        would(any, putCounters(anyAmount, printedKind(p1p1Counter), a(isCreature))),
        instead(putCounters(times(lit(2), thatMuch), printedKind(p1p1Counter), that(creature)))))]
}
