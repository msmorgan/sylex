card singleFaced({
    name = "Revoke Privileges",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(
        conjunction([
            cant(actor(enchanted(creature)), attack),
            cant(actor(enchanted(creature)), block),
            cant(actor(enchanted(creature)), crew(allOf(vehicle)))]))]})
