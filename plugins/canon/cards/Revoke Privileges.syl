card {
  name = "Revoke Privileges",
  cost = [2, white],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
          cant(actor(enchanted(creature)), attack),
          cant(actor(enchanted(creature)), block),
          cant(actor(enchanted(creature)), crew(allOf(hasSubtype(vehicle))))]))]
}
