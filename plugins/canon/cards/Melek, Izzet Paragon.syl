card singleFaced({
    name = "Melek, Izzet Paragon",
    cost = [generic(4), pip(blue), pip(red)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [weird, wizard],
    text = [
      static(visibility(reveal, you, topOfLibrary)),
      static(
        can(actor(you), cast(bare(nominal(pre = [or([instant, sorcery])], spell)), from = onTop))),
      whenever(
        does(
          actor(you),
          cast(a(nominal(pre = [or([instant, sorcery])], spell)), from = yourLibrary)),
        sequentially([copyOnStack(it), may(chooseNewTargets(that(copy)))]))],
    power = 2,
    toughness = 4})
