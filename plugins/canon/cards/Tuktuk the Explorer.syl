card singleFaced({
    name = "Tuktuk the Explorer",
    cost = [generic(2), pip(red)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [goblin],
    text = [
      haste,
      when(
        does(actor(thisCreature), die),
        create(
          1,
          written({
              characteristics = {
                name = "Tuktuk the Returned",
                supertypes = [legendary],
                types = [artifact, creature],
                subtypes = [goblin, golem],
                power = 5,
                toughness = 5}})))],
    power = 1,
    toughness = 1})
