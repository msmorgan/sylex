card singleFaced({
    name = "Pithing Needle",
    cost = [generic(1)],
    types = [artifact],
    text = [
      static(entersChoosing(thisArtifact, cardName)),
      static(
        cant(
          any,
          activate(
            allOf(
              nominal(
                abilityHead(anyActivated),
                post = [ofSource(allOf(nominal(source, post = [named(chosenName)])))]))),
          unless = is(them, noun(a(manaAbility)))))]})
