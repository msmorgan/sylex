card singleFaced({
    name = "Pithing Needle",
    cost = [generic(1)],
    types = [artifact],
    text = [
      static(entersChoosing(thisArtifact, cardName)),
      static(
        cant(
          any,
          activate(
            bare(
              nominal(
                abilityHead(anyActivated),
                post = [ofSource(bare(nominal(source, post = [named(chosenName)])))]))),
          unless = is(them, noun(plural(manaAbility)))))]})
