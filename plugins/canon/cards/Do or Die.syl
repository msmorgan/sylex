# Pins separating creatures into piles and destroying the creatures in the chosen
# pile. Each creature belongs to exactly one pile; the pile itself is not an Object
# [CR#700.3a,700.3b].
card singleFaced({
    name = "Do or Die",
    cost = [generic(1), pip(black)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            separateIntoPiles(allOf(nominal(creature, post = [controls(target(player))])), 2),
            doUnderProhibition(
              destroy(allOf(nominal(creature, post = [inPile(pileOfChoice(they))]))),
              regeneration(them))]))]})
