card singleFaced({
    name = "Colossal Grave-Reaver",
    cost = [generic(6), pip(black), pip(green)],
    types = [creature],
    subtypes = [dragon],
    text = [
      flying,
      whenever(
        or([does(actor(this(creature)), enter), does(actor(this(creature)), attack)]),
        mill(3)),
      whenever(
        does(
          any,
          putInto(
            counted(orMore(1), nominal(pre = [creature], card)),
            yourGraveyard,
            from = yourLibrary)),
        putOntoBattlefield(partOf(exactly(1), them)))],
    power = 7,
    toughness = 6})
