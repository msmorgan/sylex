card singleFaced({
    name = "Colossal Grave-Reaver",
    cost = [generic(6), pip(black), pip(green)],
    types = [creature],
    subtypes = [dragon],
    text = [
      flying,
      whenever(
        or([does(actor(thisCreature), enter), does(actor(thisCreature), attack)]),
        action = mill(3)),
      whenever(
        does(
          any,
          putInto(
            counted(orMore(1), and([isCard, isCreature])),
            yourGraveyard,
            from = yourLibrary)),
        putOntoBattlefield(someOf(exactly(1), them)))],
    power = 7,
    toughness = 6})
