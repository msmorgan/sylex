card singleFaced({
    name = "Celestial Convergence",
    cost = [generic(2), pip(white), pip(white)],
    types = [enchantment],
    text = [
      static(entersWithCounters(this(enchantment), 7, omenCounter)),
      at(
        beginningOfYour(upkeep),
        sequentially([
            removeCounters(exactly(1), printedKind(omenCounter), this(enchantment)),
            doIf(
              compareAmt(countersOn(omenCounter, this(enchantment)), atMost, 0),
              doIf(
                thereAre(
                  counted(
                    orMore(2),
                    nominal(player, post = [tiedFor(max, playerStat(lifeTotal), player)]))),
                drawGame,
                otherwise = instruct(
                  the(nominal(player, post = [superlative(max, playerStat(lifeTotal), player)])),
                  winGame)))]))]})
