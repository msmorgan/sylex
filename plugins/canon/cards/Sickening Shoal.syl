card singleFaced({
    name = "Sickening Shoal",
    cost = [variable, pip(black), pip(black)],
    types = [instant],
    subtypes = [arcane],
    text = [
      static(
        altCost(
          payingInstead(
            perform(
              exile(a(and([hasColor(black), hasManaValue(equal, letter(x)), in(yourHand)]))))),
          this)),
      spell(get(target(isCreature), down(letter(x)), down(letter(x)), duration = untilEndOfTurn))]})
