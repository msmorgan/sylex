card singleFaced({
    name = "Sickening Shoal",
    cost = [variable, pip(black), pip(black)],
    types = [instant],
    subtypes = [arcane],
    text = [
      static(
        altCost(
          payingInstead(
            perform(
              exile(
                a(
                  nominal(
                    pre = [black],
                    card,
                    post = [hasManaValue(equal, letter(x)), in(yourHand)]))))),
          this(spell))),
      spell(get(target(creature), down(letter(x)), down(letter(x)), duration = untilEndOfTurn))]})
