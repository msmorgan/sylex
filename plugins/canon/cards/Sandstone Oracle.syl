card singleFaced({
    name = "Sandstone Oracle",
    cost = [generic(7)],
    types = [artifact, creature],
    subtypes = [sphinx],
    text = [
      flying,
      when(
        does(actor(thisCreature), enter),
        sequentially(
          steps = [
            choose(anOpponent),
            doIf(
              compareAmt(countOf(cardIn(handOf(that(player)))), greater, countOf(cardIn(yourHand))),
              draw(theDifference))]))],
    power = 4,
    toughness = 4})
