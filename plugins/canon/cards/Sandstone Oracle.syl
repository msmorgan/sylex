card singleFaced({
    name = "Sandstone Oracle",
    cost = [generic(7)],
    types = [artifact, creature],
    subtypes = [sphinx],
    text = [
      flying,
      when(
        does(actor(thisCreature), enter),
        sequentially([
            choose(anOpponent),
            doIf(
              compareAmt(
                countOf(nominal(card, post = [in(handOf(that(player)))])),
                greater,
                countOf(nominal(card, post = [in(yourHand)]))),
              draw(theDifference))]))],
    power = 4,
    toughness = 4})
