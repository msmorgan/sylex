card singleFaced({
    name = "Menacing Ogre",
    cost = [generic(3), pip(red), pip(red)],
    types = [creature],
    subtypes = [ogre],
    text = [
      trample,
      haste,
      when(
        does(actor(thisCreature), enter),
        sequentially(
          steps = [
            instruct(eachPlayer, choose(a(quality(number)), disclosure = secretly)),
            revealChoices(numbers),
            instruct(each(and([isPlayer, choseExtreme(max)])), loseLife(thatMuch)),
            doIf(
              is(you, choseExtreme(max)),
              putCounters(2, printedKind(p1p1Counter), thisCreature))]))],
    power = 3,
    toughness = 3})
