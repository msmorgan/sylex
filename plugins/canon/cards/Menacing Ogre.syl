card singleFaced({
    name = "Menacing Ogre",
    cost = [generic(3), pip(red), pip(red)],
    types = [creature],
    subtypes = [ogre],
    text = [
      trample,
      haste,
      when(
        does(actor(thisCreature), enter),
        sequentially([
            instruct(eachPlayer, choose(disclosure = secretly, chosen = a(quality(number)))),
            revealChoices(numbers),
            instruct(each(and([isPlayer, choseExtreme(max)])), loseLife(thatMuch)),
            doIf(
              is(you, choseExtreme(max)),
              putCounters(lit(2), printedKind(p1p1Counter), thisCreature))]))],
    power = lit(3),
    toughness = lit(3)})
