card singleFaced({
    name = "Dazzling Reflection",
    cost = [generic(1), pip(white)],
    types = [instant],
    text = [
      spell(
        sequentially([
            gainLife(powerOf(target(creature))),
            establishThroughout(
              replace(
                would(actor(that(creature)), dealDamage),
                instead(preventDamage(allDamage)),
                use = nextTimeOnly),
              thisTurn)]))]})
