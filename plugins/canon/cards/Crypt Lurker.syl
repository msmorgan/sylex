card singleFaced({
    name = "Crypt Lurker",
    cost = [generic(3), pip(black)],
    types = [creature],
    subtypes = [horror],
    text = [
      when(
        does(actor(this(creature)), enter),
        may(
          chooseOne(
            sacrifice(a(creature)),
            discard(a(nominal(pre = [creature], card, post = [in(yourHand)])))),
          ifDid = draw(1)))],
    power = 3,
    toughness = 4})
