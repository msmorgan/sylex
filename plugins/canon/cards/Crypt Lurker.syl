card singleFaced({
    name = "Crypt Lurker",
    cost = [generic(3), pip(black)],
    types = [creature],
    subtypes = [horror],
    text = [
      when(
        does(actor(thisCreature), enter),
        may(
          chooseOne(sacrifice(a(isCreature)), discard(a(and([isCreature, in(yourHand)])))),
          draw(1)))],
    power = 3,
    toughness = 4})
