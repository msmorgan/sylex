card singleFaced({
    name = "Rafter Demon",
    cost = [generic(2), pip(black), pip(red)],
    types = [creature],
    subtypes = [demon],
    text = [
      spectacle(mana([generic(3), pip(black), pip(red)])),
      when(
        does(actor(this(creature)), enter),
        if = keywordCostPaid(it, spectacle),
        instruct(eachOpponent, discard(a(nominal(card, post = [in(hand)])))))],
    power = 4,
    toughness = 2})
