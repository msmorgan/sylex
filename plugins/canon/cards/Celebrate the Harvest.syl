card singleFaced({
    name = "Celebrate the Harvest",
    cost = [generic(3), pip(green)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            search(
              yourLibrary,
              for = counted(upToOf(letter(x)), nominal(pre = [basic, land], card))),
            define(x, distinctCount(value(power), allOf(nominal(creature, post = [youControl])))),
            putOntoBattlefieldTapped(those(card)),
            shuffle]))]})
