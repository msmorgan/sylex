card singleFaced({
    name = "Celebrate the Harvest",
    cost = [generic(3), pip(green)],
    types = [sorcery],
    text = [
      spell(
        sequentially(
          steps = [
            search(
              yourLibrary,
              for = counted(upToOf(letter(x)), and([isLand, hasSupertype(basic)]))),
            define(x, distinctCount(value(power), allOf(and([isCreature, youControl])))),
            putOntoBattlefieldTapped(those(card)),
            shuffle]))]})
