card singleFaced({
    name = "Mirrorwood Treefolk",
    cost = [generic(3), pip(green)],
    types = [creature],
    subtypes = [treefolk],
    text = [
      activated(
        mana([generic(2), pip(red), pip(white)]),
        establishThroughout(
          replace(
            would(any, dealDamage(recipient = thisCreature)),
            instead(redirectDamage(allDamage, target(isAnyTarget))),
            use = nextTimeOnly),
          thisTurn))],
    power = 2,
    toughness = 4})
