card singleFaced({
    name = "Sage of Fables",
    cost = [generic(2), pip(blue)],
    types = [creature],
    subtypes = [merfolk, wizard],
    text = [
      static(
        entersWithAdditionalCounters(
          each(nominal(pre = [other, wizard], creature, post = [youControl])),
          1,
          p1p1Counter)),
      activated(
        compound([
            mana([generic(2)]),
            perform(
              removeCounters(
                exactly(1),
                printedKind(p1p1Counter),
                a(nominal(creature, post = [youControl]))))]),
        draw(1))],
    power = 2,
    toughness = 2})
