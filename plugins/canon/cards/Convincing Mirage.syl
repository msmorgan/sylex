card singleFaced({
    name = "Convincing Mirage",
    cost = [generic(1), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(land)),
      static(entersChoosingFrom(thisAura, subtype(land), basicTypesOnly)),
      static(qualityChange(enchanted(land), sets, chosenQuality(ofChosen(subtype(land)))))]})
