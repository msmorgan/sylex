# Pins a continuous increase to the number of lands a Player may play during
# their turn [CR#305.2].
card singleFaced({
    name = "Exploration",
    cost = [pip(green)],
    types = [enchantment],
    text = [
      static(
        can(
          actor(you),
          play(counted(additional(exactly(1)), isLand)),
          timing = onEachOfYourTurns))]})
