card singleFaced({
    name = "Elspeth's Talent",
    cost = [generic(2), pip(white), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(planeswalker)),
      static(
        abilityGrant(
          enchanted(planeswalker),
          [
            activated(
              loyaltySymbol(up(1)),
              create(3, written(creatureToken(1, 1, [white], [soldier]))))])),
      whenever(
        does(
          actor(you),
          activate(a(nominal(abilityHead(loyalty), post = [ofSource(enchanted(planeswalker))])))),
        establishFor(
          allOf(nominal(creature, post = [youControl])),
          [getsPt(them, up(2), up(2)), abilityGrant(them, [vigilance])],
          duration = untilEndOfTurn))]})
