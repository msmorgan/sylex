card singleFaced({
    name = "Elspeth's Talent",
    cost = [generic(2), pip(white), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isPlaneswalker),
      static(
        abilityGrant(
          enchanted(planeswalker),
          activated(
            loyaltySymbol(up(lit(1))),
            create(lit(3), written(creatureToken(1, 1, [white], [soldier])))))),
      whenever(
        does(
          actor(you),
          activate(a(and([abilityHead(loyalty), abilityOf(enchanted(planeswalker))])))),
        establishFor(
          allOf(and([isCreature, youControl])),
          [getsPt(them, up(lit(2)), up(lit(2))), abilityGrant(them, vigilance)],
          untilEndOfTurn))]})
