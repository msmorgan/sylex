card singleFaced({
    name = "Hijack",
    cost = [generic(1), pip(red), pip(red)],
    types = [sorcery],
    text = [
      spell(
        sequentially(
          steps = [
            gainControl(target(or([isArtifact, isCreature])), duration = untilEndOfTurn),
            untap(it),
            gain(it, [haste], duration = untilEndOfTurn)]))]})
