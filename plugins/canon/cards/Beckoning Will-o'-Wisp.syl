card singleFaced({
    name = "Beckoning Will-o'-Wisp",
    cost = [generic(2), pip(white)],
    types = [creature],
    subtypes = [spirit],
    text = [
      flying,
      flavorWord("Lure the Unwary", at(beginningOfYour(combat), choose(anOpponent))),
      static(
        getsPt(
          allOf(and([isCreature, inCombat(attackerOf, the(isChosenPlayer))])),
          up(lit(1)),
          up(lit(0))))],
    power = lit(1),
    toughness = lit(3)})
