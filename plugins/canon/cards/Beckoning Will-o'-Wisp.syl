card singleFaced({
    name = "Beckoning Will-o'-Wisp",
    cost = [generic(2), pip(white)],
    types = [creature],
    subtypes = [spirit],
    text = [
      flying,
      flavorWord("Lure the Unwary", at(beginningOfYour(combat), choose(anOpponent))),
      static(
        getsPt(
          allOf(and([isCreature, inCombat(attackerOf, counterpart = the(isChosenPlayer))])),
          up(1),
          up(0)))],
    power = 1,
    toughness = 3})
