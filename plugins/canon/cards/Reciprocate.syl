card singleFaced({
    name = "Reciprocate",
    cost = [pip(white)],
    types = [instant],
    text = [
      spell(
        exile(
          target(
            and([
                isCreature,
                did(
                  actor(which),
                  dealDamage(recipient = you),
                  within = within(soFarThisTurn))]))))]})
