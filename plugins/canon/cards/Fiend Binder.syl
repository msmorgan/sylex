card singleFaced({
    name = "Fiend Binder",
    cost = [generic(3), pip(white)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      whenever(
        does(actor(thisCreature), attack),
        tap(target(and([isCreature, controlledBy(defendingPlayer)]))))],
    power = 3,
    toughness = 2})
