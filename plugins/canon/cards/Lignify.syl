card singleFaced({
    name = "Lignify",
    cost = [generic(1), pip(green)],
    types = [kindred, enchantment],
    subtypes = [treefolk, aura],
    text = [
      enchant(isCreature),
      static(
        conjunction([
            qualityChange(
              enchanted(creature),
              sets,
              bundle({characteristics = {subtypes = [treefolk]}})),
            getsBase(it, lit(0), lit(4)),
            allAbilityLoss(it)]))]})
