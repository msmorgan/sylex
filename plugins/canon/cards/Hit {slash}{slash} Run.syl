# Hit // Run. Run's affected creatures are fixed as its effect begins ([CR#611.2c]); its "for
# each other attacking creature" contrasts with each of them, the current member of the group its
# subject names, not with the group, so a lone attacker gets +0/+0.
card split({
    name = "Hit",
    cost = [generic(1), pip(black), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially([
            instruct(target(player), sacrifice(aTheirChoice(or([artifact, creature])))),
            instruct(
              this,
              dealDamage(
                amount = statOf(stat(manaValue), that(permanent)),
                recipient = that(player)))]))]},
  {
    name = "Run",
    cost = [generic(3), pip(red), pip(green)],
    types = [instant],
    text = [
      spell(
        get(
          bare(nominal(pre = [attacking], creature, post = [youControl])),
          up(forEach(1, nominal(pre = [other, attacking], creature))),
          up(0),
          duration = untilEndOfTurn))]})
