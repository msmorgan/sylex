card singleFaced({
    name = "Daughter of Autumn",
    cost = [generic(2), pip(green), pip(green)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [avatar],
    text = [
      activated(
        mana([pip(white)]),
        establishThroughout(
          replace(
            would(any, dealDamage(recipient = target(and([isCreature, hasColor(white)])))),
            instead(redirectDamage(theNext(1), thisCreature))),
          thisTurn))],
    power = 2,
    toughness = 4})
