card singleFaced({
    name = "Relentless Assault",
    cost = [generic(2), pip(red), pip(red)],
    types = [sorcery],
    text = [
      spell(
        sequentially(
          steps = [
            untap(
              allOf(and([isCreature, did(actor(which), attack, within = within(soFarThisTurn))]))),
            additionalPhase(combat, mainPhase, 1, followedBy = mainPhase)]))]})
