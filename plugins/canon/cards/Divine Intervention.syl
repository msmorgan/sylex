card singleFaced({
    name = "Divine Intervention",
    cost = [generic(6), pip(white), pip(white)],
    types = [enchantment],
    text = [
      static(entersWithCounters(thisEnchantment, lit(2), interventionCounter)),
      at(
        beginningOfYour(upkeep),
        removeCounters(exactly(1), printedKind(interventionCounter), thisEnchantment)),
      when(
        does(by(you), removeCounters(theLast, printedKind(interventionCounter), thisEnchantment)),
        drawGame)]})
