card singleFaced({
    name = "Divine Intervention",
    cost = [generic(6), pip(white), pip(white)],
    types = [enchantment],
    text = [
      static(entersWithCounters(this(enchantment), 2, interventionCounter)),
      at(
        beginningOfYour(upkeep),
        removeCounters(exactly(1), printedKind(interventionCounter), this(enchantment))),
      when(
        does(by(you), removeCounters(theLast, printedKind(interventionCounter), this(enchantment))),
        drawGame)]})
