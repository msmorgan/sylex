card singleFaced({
    name = "Triarch Stalker",
    cost = [generic(3), pip(black), pip(black)],
    types = [artifact, creature],
    subtypes = [necron],
    text = [
      flavorWord("Targeting Relay", at(beginningOfYour(combat), choose(anOpponent))),
      static(
        abilityGrant(
          allOf(and([isCreature, inCombat(attackerOf, counterpart = the(isChosenPlayer))])),
          [menace]))],
    power = 4,
    toughness = 5})
