card singleFaced({
    name = "Psychic Purge",
    cost = [pip(blue)],
    types = [sorcery],
    text = [
      spell(instruct(ownName, dealDamage(amount = 1, recipient = target(anyTarget)))),
      when(
        causes(
          bySource(a(nominal(or([spell, abilityHead(anyOnStack)]), post = [anOpponentControls]))),
          does(actor(you), discard(this))),
        instruct(that(player), loseLife(5)))]})
