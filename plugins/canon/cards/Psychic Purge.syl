card singleFaced({
    name = "Psychic Purge",
    cost = [pip(blue)],
    types = [sorcery],
    text = [
      spell(instruct(this, dealDamage(amount = 1, recipient = target(isAnyTarget)))),
      when(
        causes(
          bySource(a(and([or([isSpell, abilityHead(anyOnStack)]), anOpponentControls]))),
          does(actor(you), discard(this))),
        instruct(that(player), loseLife(5)))]})
