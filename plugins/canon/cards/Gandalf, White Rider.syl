card singleFaced({
    name = "Gandalf, White Rider",
    cost = [generic(3), pip(white)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [avatar, wizard],
    text = [
      vigilance,
      whenever(
        does(actor(you), cast(a(spell))),
        sequentially([
            get(
              each(nominal(creature, post = [youControl])),
              up(1),
              up(0),
              duration = untilEndOfTurn),
            scry(1)])),
      when(does(actor(shortenedName), die), may(putInto(it, fromTop(5, library))))],
    power = 3,
    toughness = 3})
