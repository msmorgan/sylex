card singleFaced({
    name = "Academy Journeymage",
    cost = [generic(4), pip(blue)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      static(
        onlyIfSo(costShift(this, less(lit(1))), exists(and([hasSubtype(wizard), youControl])))),
      when(
        does(actor(thisCreature), enter),
        returnToHand(target(and([isCreature, anOpponentControls]))))],
    power = lit(3),
    toughness = lit(2)})
