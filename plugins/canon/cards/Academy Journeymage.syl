card singleFaced({
    name = "Academy Journeymage",
    cost = [generic(4), pip(blue)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      static(onlyIf(costShift(this, less(1)), exists(nominal(wizard, post = [youControl])))),
      when(
        does(actor(this(creature)), enter),
        returnToHand(target(nominal(creature, post = [anOpponentControls]))))],
    power = 3,
    toughness = 2})
