card {
  name = "Saheeli, Filigree Master",
  cost = [generic(2), pip(blue), pip(red)],
  supertypes = [legendary],
  types = [planeswalker],
  subtypes = [saheeli],
  text = [
    activated(
      loyaltySymbol(up(lit(1))),
      sequentially(
        [scry(lit(1)), may(tap(a(and([isArtifact, isUntapped, youControl]))), draw(lit(1)))])),
    activated(
      loyaltySymbol(down(lit(2))),
      sequentially([
          create(
            lit(2),
            written({
                characteristics = {
                  types = [artifact, creature],
                  subtypes = [thopter],
                  text = [flying],
                  power = lit(1),
                  toughness = lit(1)}})),
          gainHaste(them, untilEndOfTurn)])),
    activated(
      loyaltySymbol(down(lit(4))),
      getEmblem([
          static(getsPt(allOf(and([isArtifact, isCreature, youControl])), up(lit(1)), up(lit(1)))),
          static(
            costShift(
              allOf(and([isArtifact, isSpell, did(actor(you), cast(which), thisObject)])),
              less(lit(1))))]))],
  loyalty = lit(3)
}
