card singleFaced({
    name = "Saheeli, Filigree Master",
    cost = [generic(2), pip(blue), pip(red)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [saheeli],
    text = [
      activated(
        loyaltySymbol(up(1)),
        sequentially(
          [scry(1), may(tap(a(and([isArtifact, isUntapped, youControl]))), ifDid = draw(1))])),
      activated(
        loyaltySymbol(down(2)),
        sequentially([
            create(
              2,
              written({
                  characteristics = {
                    types = [artifact, creature],
                    subtypes = [thopter],
                    text = [flying],
                    power = 1,
                    toughness = 1}})),
            gain(them, [haste], duration = untilEndOfTurn)])),
      activated(
        loyaltySymbol(down(4)),
        getEmblem([
            static(getsPt(allOf(and([isArtifact, isCreature, youControl])), up(1), up(1))),
            static(
              costShift(
                allOf(
                  and([isArtifact, isSpell, did(actor(you), cast(which), within = thisObject)])),
                less(1)))]))],
    loyalty = 3})
