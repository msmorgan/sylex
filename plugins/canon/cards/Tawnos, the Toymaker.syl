card singleFaced({
    name = "Tawnos, the Toymaker",
    cost = [generic(3), pip(green), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, artificer],
    text = [
      whenever(
        does(
          actor(you),
          cast(a(and([or([hasSubtype(beast), hasSubtype(bird)]), isCreature, isSpell])))),
        may(copyOnStack(it, exceptions = [isAlso([artifact])])))],
    power = 3,
    toughness = 5})
