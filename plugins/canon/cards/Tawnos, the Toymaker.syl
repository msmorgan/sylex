card singleFaced({
    name = "Tawnos, the Toymaker",
    cost = [generic(3), pip(green), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, artificer],
    text = [
      whenever(
        does(actor(you), cast(a(nominal(pre = [or([beast, bird]), creature], spell)))),
        may(copyOnStack(it, exceptions = [isAlso(types = [artifact])])))],
    power = 3,
    toughness = 5})
