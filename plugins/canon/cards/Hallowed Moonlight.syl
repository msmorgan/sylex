card singleFaced({
    name = "Hallowed Moonlight",
    cost = [generic(1), pip(white)],
    types = [instant],
    text = [
      spell(
        sequentially([
            replaceEvent(
              untilEndOfTurn,
              would(
                actor(a(nominal(creature, post = [not(was(cast(which), within = thisObject))]))),
                enter),
              instead(exile(it))),
            draw(1)]))]})
