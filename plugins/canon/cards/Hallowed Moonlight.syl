card {
  name = "Hallowed Moonlight",
  cost = [generic(1), pip(white)],
  types = [instant],
  text = [
    spell(
      sequentially([
          replaceEvent(
            would(actor(a(and([isCreature, not(did(any, cast(which), thisObject))]))), enter),
            instead(exile(it)),
            untilEndOfTurn),
          draw(lit(1))]))]
}
