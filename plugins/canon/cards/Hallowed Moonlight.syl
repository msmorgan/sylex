card singleFaced({
    name = "Hallowed Moonlight",
    cost = [generic(1), pip(white)],
    types = [instant],
    text = [
      spell(
        sequentially(
          steps = [
            replaceEvent(
              would(
                actor(a(and([isCreature, not(did(any, cast(which), within = thisObject))]))),
                enter),
              instead(exile(it)),
              untilEndOfTurn),
            draw(1)]))]})
