card singleFaced({
    name = "Stag Beetle",
    cost = [generic(3), pip(green), pip(green)],
    types = [creature],
    subtypes = [insect],
    text = [
      static(
        conjunction([
            entersWithCounters(this(creature), letter(x), p1p1Counter),
            letterDefinition(
              x,
              countOf(nominal(pre = [other], creature, post = [in(battlefield)])))]))],
    power = 0,
    toughness = 0})
