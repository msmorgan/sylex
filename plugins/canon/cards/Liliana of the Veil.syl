card singleFaced({
    name = "Liliana of the Veil",
    cost = [generic(1), pip(black), pip(black)],
    supertypes = [legendary],
    types = [planeswalker],
    subtypes = [liliana],
    text = [
      activated(
        loyaltySymbol(up(1)),
        instruct(eachPlayer, discard(a(nominal(card, post = [in(hand)]))))),
      activated(loyaltySymbol(down(2)), instruct(target(player), sacrifice(a(creature)))),
      activated(
        loyaltySymbol(down(6)),
        sequentially([
            separateIntoPiles(allOf(nominal(permanent, post = [controls(target(player))])), 2),
            instruct(
              they,
              sacrifice(allOf(nominal(permanent, post = [inPile(pileOfChoice(they))]))))]))],
    loyalty = 3})
