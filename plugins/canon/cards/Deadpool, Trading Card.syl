card singleFaced({
    name = "Deadpool, Trading Card",
    cost = [generic(2), pip(black), pip(red)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [mutant, mercenary, hero],
    text = [
      static(
        replace(
          would(actor(shortenedName), enter),
          alongside(may(exchangeTextBoxes(this(creature), a(nominal(pre = [other], creature))))))),
      at(beginningOfYour(upkeep), loseLife(3)),
      activated(
        compound([mana([generic(3)]), perform(sacrifice(this(creature)))]),
        instruct(each(nominal(pre = [other], player)), draw(1)))],
    power = 5,
    toughness = 3})
