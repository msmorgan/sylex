card {
  name = "Saw in Half",
  cost = [generic(2), pip(black)],
  types = [instant],
  text = [
    spell(
      sequentially([
          destroy(target(isCreature)),
          doIf(
            did(actor(that(creature)), die, thisWay),
            instruct(
              controllerOf(it),
              create(
                lit(2),
                copyOf(
                  that(creature),
                  copyCharacteristics({
                      power = half(up, powerOf(that(creature))),
                      toughness = half(up, toughnessOf(that(creature)))})))))]))]
}
