card singleFaced({
    name = "Saw in Half",
    cost = [generic(2), pip(black)],
    types = [instant],
    text = [
      spell(
        sequentially([
            destroy(target(isCreature)),
            doIf(
              did(actor(that(creature)), die, thisWay),
              instruct(
                controllerOf(it),
                create(
                  2,
                  copyOf(
                    that(creature),
                    [
                      characteristicEdits([
                          stat(power, set(half(up, powerOf(that(creature))))),
                          stat(toughness, set(half(up, toughnessOf(that(creature)))))])]))))]))]})
