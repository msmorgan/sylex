card singleFaced({
    name = "Ghalta, Primal Hunger",
    cost = [generic(10), pip(green), pip(green)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [elder, dinosaur],
    text = [
      static(
        conjunction([
            costShift(this(spell), less(letter(x))),
            letterDefinition(
              x,
              aggregateAll(sum, stat(power), nominal(creature, post = [youControl])))])),
      trample],
    power = 12,
    toughness = 12})
