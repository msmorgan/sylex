card singleFaced({
    name = "Rakshasa Vizier",
    cost = [generic(2), pip(black), pip(green), pip(blue)],
    types = [creature],
    subtypes = [demon],
    text = [
      whenever(
        does(
          any,
          putInto(
            counted(orMore(1), nominal(card, post = [in(yourGraveyard)])),
            exileZone,
            from = yourGraveyard)),
        putCounters(thatMany, printedKind(p1p1Counter), this(creature)))],
    power = 4,
    toughness = 4})
