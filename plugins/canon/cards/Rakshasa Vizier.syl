card {
  name = "Rakshasa Vizier",
  cost = [generic(2), pip(black), pip(green), pip(blue)],
  types = [creature],
  subtypes = [demon],
  text = [
    whenever(
      does(
        any,
        putInto(counted(orMore(1), cardIn(yourGraveyard)), exileZone, from = yourGraveyard)),
      putCounters(groupSize, printedKind(p1p1Counter), thisCreature))],
  power = lit(4),
  toughness = lit(4)
}
