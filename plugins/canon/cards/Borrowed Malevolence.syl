card {
  name = "Borrowed Malevolence",
  cost = [black],
  types = [instant],
  text = [
    escalate(mana([2])),
    spell(
      chooseModes(
        oneThrough(2),
        [
          mk(none, none, get(target(isCreature), up(1), up(1), untilEndOfTurn)),
          mk(none, none, get(target(isCreature), down(1), down(1), untilEndOfTurn))]))]
}
