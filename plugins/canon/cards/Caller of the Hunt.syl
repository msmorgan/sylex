card singleFaced({
    name = "Caller of the Hunt",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [human],
    text = [
      static(
        addedCost(this, mandatory, plusAdditional(perform(choose(a(quality(subtype(creature)))))))),
      static(definesPt(thisCreature, countOf(and([isCreature, ofChosen(subtype(creature))]))))]})
