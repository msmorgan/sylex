card singleFaced({
    name = "Caller of the Hunt",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [human],
    text = [
      static(
        addedCost(this, mandatory, plusAdditional(perform(choose(a(quality(subtype(creature)))))))),
      static(
        definesPt(
          thisCreature,
          countOf(nominal(creature, post = [ofChosen(subtype(creature)), in(battlefield)]))))]})
