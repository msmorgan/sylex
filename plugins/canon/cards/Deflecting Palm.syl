card {
  name = "Deflecting Palm",
  cost = [pip(red), pip(white)],
  types = [instant],
  text = [
    spell(
      establishThroughout(
        replace(
          would(actor(aYourChoice(isSource)), dealDamage(recipient = you)),
          instead(
            preventDamage(
              allDamage,
              also = instruct(this, dealDamage(thatMuch, controllerOf(thatSource))))),
          use = nextTimeOnly),
        thisTurn))]
}
