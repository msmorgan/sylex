card singleFaced({
    name = "Deflecting Palm",
    cost = [pip(red), pip(white)],
    types = [instant],
    text = [
      spell(
        establishThroughout(
          replace(
            would(actor(aYourChoice(isSource)), dealDamage(recipient = you)),
            instead(
              preventDamage(
                allDamage,
                also = instruct(
                  this,
                  dealDamage(amount = thatMuch, recipient = controllerOf(thatSource))))),
            use = nextTimeOnly),
          thisTurn))]})
