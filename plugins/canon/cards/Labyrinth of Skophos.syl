card singleFaced({
    name = "Labyrinth of Skophos",
    types = [land],
    text = [
      activated(tapSymbol, addMana(symbols([colorlessPip]))),
      activated(
        compound(costs = [mana([generic(4)]), tapSymbol]),
        removeFromCombat(target(and([isCreature, or([isAttacking, isBlocking])]))))]})
