card singleFaced({
    name = "Mercadian Bazaar",
    types = [land],
    text = [
      static(entersTapped(this(land))),
      activated(tapSymbol, putCounters(1, printedKind(storageCounter), this(land))),
      activated(
        compound(
          [tapSymbol, perform(removeCounters(anyNumber, printedKind(storageCounter), this(land)))]),
        addMana(counted(removedThisWay, symbols([pip(red)]))))]})
