card singleFaced({
    name = "Expel the Interlopers",
    cost = [generic(3), pip(white), pip(white)],
    types = [sorcery],
    text = [
      spell(
        sequentially(
          steps = [
            choose(a(qualityFrom(number, number(fromTo(0, 10))))),
            destroy(allOf(and([isCreature, hasPower(atLeast, chosenNumber)])))]))]})
