card singleFaced({
    name = "Wind Zendikon",
    cost = [pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isLand),
      static(
        qualityChange(
          enchanted(land),
          sets,
          bundle({
              characteristics = {
                colors = [blue],
                types = [creature],
                subtypes = [elemental],
                text = [flying],
                power = lit(2),
                toughness = lit(2)}},
            land))),
      when(does(actor(enchanted(land)), die), returnToHand(that(card)))]})
