card {
  name = "Wind Zendikon",
  cost = [blue],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isLand),
    static(
      qualityChange(
        enchanted(land),
        sets,
        bundle({
            characteristics = {
              colors = [blue],
              types = [creature],
              subtypes = [elemental],
              text = [flying],
              power = 2,
              toughness = 2}},
          land))),
    when(does(actor(enchanted(land)), die), returnToHand(that(card)))]
}
