# Pins winning a coin flip, which differs from merely obtaining heads or tails
# [CR#705.2], and the luck-counter threshold on its upkeep trigger.
card singleFaced({
    name = "Chance Encounter",
    cost = [generic(2), pip(red), pip(red)],
    types = [enchantment],
    text = [
      whenever(
        does(actor(you), flipCoins(call = wins)),
        putCounters(1, printedKind(luckCounter), thisEnchantment)),
      at(
        beginningOfYour(upkeep),
        if = compareAmt(countersOn(luckCounter, thisEnchantment), atLeast, 10),
        action = winGame)]})
