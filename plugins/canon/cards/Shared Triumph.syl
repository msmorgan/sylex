card singleFaced({
    name = "Shared Triumph",
    cost = [generic(1), pip(white)],
    types = [enchantment],
    text = [
      static(entersChoosing(thisEnchantment, subtype(creature))),
      static(
        getsPt(allOf(nominal(creature, post = [ofChosen(subtype(creature))])), up(1), up(1)))]})
