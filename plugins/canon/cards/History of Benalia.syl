card {
  name = "History of Benalia",
  cost = [generic(1), pip(white), pip(white)],
  types = [enchantment],
  subtypes = [saga],
  text = [
    when(
      chapterMark([1, 2]),
      create(
        lit(1),
        written({
            characteristics = {
              colors = [white],
              types = [creature],
              subtypes = [knight],
              text = [vigilance],
              power = lit(2),
              toughness = lit(2)}}))),
    when(
      chapterMark([3]),
      get(allOf(and([hasSubtype(knight), youControl])), up(lit(2)), up(lit(1)), untilEndOfTurn))]
}
