card singleFaced({
    name = "History of Benalia",
    cost = [generic(1), pip(white), pip(white)],
    types = [enchantment],
    subtypes = [saga],
    text = [
      when(
        chapterMark([1, 2]),
        create(
          1,
          written({
              characteristics = {
                colors = [white],
                types = [creature],
                subtypes = [knight],
                text = [vigilance],
                power = 2,
                toughness = 2}}))),
      when(
        chapterMark([3]),
        get(
          allOf(and([hasSubtype(knight), youControl])),
          up(2),
          up(1),
          duration = untilEndOfTurn))]})
