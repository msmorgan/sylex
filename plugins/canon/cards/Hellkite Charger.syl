card {
  name = "Hellkite Charger",
  cost = [4, red, red],
  types = [creature],
  subtypes = [dragon],
  text = [
    flying,
    haste,
    whenever(
      does(actor(thisCreature), attack),
      may(
        pay(mana([5, red, red]), once),
        sequentially(
          [untap(allOf(and([isCreature, isAttacking]))), additionalPhase(combat, none, 1)])))],
  power = 5,
  toughness = 5
}
