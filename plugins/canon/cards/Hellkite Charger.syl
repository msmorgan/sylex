card singleFaced({
    name = "Hellkite Charger",
    cost = [generic(4), pip(red), pip(red)],
    types = [creature],
    subtypes = [dragon],
    text = [
      flying,
      haste,
      whenever(
        does(actor(thisCreature), attack),
        may(
          pay(mana([generic(5), pip(red), pip(red)]), once),
          sequentially([
              untap(allOf(and([isCreature, isAttacking]))),
              additionalPhase(combat, none, lit(1))])))],
    power = lit(5),
    toughness = lit(5)})
