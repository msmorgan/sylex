card singleFaced({
    name = "Hellkite Charger",
    cost = [generic(4), pip(red), pip(red)],
    types = [creature],
    subtypes = [dragon],
    text = [
      flying,
      haste,
      whenever(
        does(actor(thisCreature), attack),
        may(
          pay(payment(mana([generic(5), pip(red), pip(red)])), once),
          ifDid = sequentially([
              untap(allOf(nominal(pre = [attacking], creature))),
              additionalPhase(combat, none, 1)])))],
    power = 5,
    toughness = 5})
