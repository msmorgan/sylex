card singleFaced({
    name = "Rooftop Storm",
    cost = [generic(5), pip(blue)],
    types = [enchantment],
    text = [
      static(
        altCost(
          payingInstead(mana([generic(0)])),
          allOf(
            and([
                hasSubtype(zombie),
                isCreature,
                isSpell,
                did(actor(you), cast(which), within = thisObject)]))))]})
