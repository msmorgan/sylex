card singleFaced({
    name = "Merfolk Falconer",
    cost = [generic(3), pip(blue), pip(blue)],
    types = [creature],
    subtypes = [merfolk, wizard],
    text = [
      flying,
      whenever(
        does(
          actor(you),
          cast(a(compareOver(isSpell, paidCostRead(byKeyword(kicker), none, it), atLeast, 1)))),
        scry(2))],
    power = 4,
    toughness = 4})
