card singleFaced({
    name = "Chromatic Armor",
    cost = [generic(1), pip(white), pip(blue)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(hasType(creature)),
      static(entersChoosing(this(aura), color)),
      static(entersWithCounters(this(aura), 1, sleightCounter)),
      static(
        replace(
          would(
            by(bare(nominal(source, post = [ofTheLastChosen(color)]))),
            dealDamage(recipient = enchanted(creature))),
          instead(preventDamage(allDamage)))),
      activated(
        mana([variable]),
        sequentially([
            putCounters(1, printedKind(sleightCounter), this(aura)),
            choose(a(quality(color))),
            define(x, countersOn(sleightCounter, this(aura)))]))]})
