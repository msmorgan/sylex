card singleFaced({
    name = "Tolaria",
    supertypes = [legendary],
    types = [land],
    text = [
      activated(tapSymbol, addMana(symbols([pip(blue)]))),
      activatedOnlyDuring(
        tapSymbol,
        establishThroughout(
          abilityLoss(
            target(creature),
            [written(banding), abilities(anyIn({word = bandsWithOther}))]),
          untilEndOfTurn),
        duringPart(upkeep))]})
