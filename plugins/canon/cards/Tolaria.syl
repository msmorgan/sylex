card singleFaced({
    name = "Tolaria",
    supertypes = [legendary],
    types = [land],
    text = [
      activated(tapSymbol, addMana(symbols([pip(blue)]))),
      activatedOnlyDuring(
        compound(costs = [tapSymbol]),
        establishThroughout(
          abilityLoss(
            target(isCreature),
            [written(banding), abilities(anyIn({word = bandsWithOther}))]),
          untilEndOfTurn),
        duringPart(upkeep))]})
