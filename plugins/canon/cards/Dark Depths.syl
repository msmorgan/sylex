card {
  name = "Dark Depths",
  supertypes = [legendary, snow],
  types = [land],
  text = [
    static(entersWithCounters(thisLand, lit(10), iceCounter)),
    activated(mana([generic(3)]), removeCounters(exactly(1), printedKind(iceCounter), thisLand)),
    when(
      stateHolds(not(is(thisLand, hasCounter(iceCounter)))),
      doIfDone(
        sacrifice(thisLand),
        create(
          lit(1),
          written({
              characteristics = {
                name = "Marit Lage",
                colors = [black],
                supertypes = [legendary],
                types = [creature],
                subtypes = [avatar],
                text = [flying, indestructible],
                power = lit(20),
                toughness = lit(20)}}))))]
}
