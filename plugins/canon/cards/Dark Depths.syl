card singleFaced({
    name = "Dark Depths",
    supertypes = [legendary, snow],
    types = [land],
    text = [
      static(entersWithCounters(ownName, 10, iceCounter)),
      activated(mana([generic(3)]), removeCounters(exactly(1), printedKind(iceCounter), ownName)),
      when(
        stateHolds(not(is(ownName, hasCounter(kind = iceCounter)))),
        doIfDone(
          sacrifice(it),
          ifDid = create(
            1,
            written({
                characteristics = {
                  name = "Marit Lage",
                  colors = [black],
                  supertypes = [legendary],
                  types = [creature],
                  subtypes = [avatar],
                  text = [flying, indestructible],
                  power = 20,
                  toughness = 20}}))))]})
