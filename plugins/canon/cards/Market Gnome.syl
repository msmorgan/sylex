card singleFaced({
    name = "Market Gnome",
    cost = [pip(white)],
    types = [artifact, creature],
    subtypes = [gnome],
    text = [
      when(does(actor(thisCreature), die), sequentially([gainLife(1), draw(1)])),
      when(
        timed(
          does(any, exile(thisCreature)),
          whileDoing(does(actor(you), activate(a(abilityHead(keyword(craft))))))),
        action = sequentially([gainLife(1), draw(1)]))],
    power = 0,
    toughness = 3})
