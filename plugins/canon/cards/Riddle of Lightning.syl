card singleFaced({
    name = "Riddle of Lightning",
    cost = [generic(3), pip(red), pip(red)],
    types = [instant],
    text = [
      spell(
        sequentially([
            choose(target(isAnyTarget)),
            scry(3),
            reveal(topSlice(1)),
            instruct(
              this,
              dealDamage(amount = statOf(stat(manaValue), that(card)), recipient = thatJoin))]))]})
