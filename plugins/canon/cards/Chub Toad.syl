card singleFaced({
    name = "Chub Toad",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [frog],
    text = [
      whenever(
        or([does(actor(thisCreature), block), does(any, becomeBlocked(thisCreature))]),
        action = get(it, up(2), up(2), untilEndOfTurn))],
    power = 1,
    toughness = 1})
