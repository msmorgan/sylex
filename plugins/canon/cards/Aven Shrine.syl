card singleFaced({
    name = "Aven Shrine",
    cost = [generic(1), pip(white), pip(white)],
    types = [enchantment],
    text = [
      whenever(
        does(actor(a(player)), cast(a(spell))),
        sequentially([
            instruct(they, gainLife(letter(x))),
            define(
              x,
              countOf(
                nominal(card, post = [in(graveyard), shares(cardName, share, that(spell))])))]))]})
