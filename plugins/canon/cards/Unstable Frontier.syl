card singleFaced({
    name = "Unstable Frontier",
    types = [land],
    text = [
      activated(tapSymbol, addMana(1, manaOf([[colorless]]))),
      activated(
        tapSymbol,
        establishThroughout(
          qualityChange(
            target(and([isLand, youControl])),
            sets,
            chosenQuality(ofYourChoice(subtype(land), basicTypesOnly))),
          untilEndOfTurn))]})
