card singleFaced({
    name = "Tyrant of Valakut",
    cost = [generic(5), pip(red), pip(red)],
    types = [creature],
    subtypes = [dragon],
    text = [
      surge(mana([generic(3), pip(red), pip(red)])),
      flying,
      when(
        does(actor(thisCreature), enter),
        if = keywordCostPaid(surge, thisCreature),
        instruct(thisCreature, dealDamage(amount = 3, recipient = target(isAnyTarget))))],
    power = 5,
    toughness = 4})
