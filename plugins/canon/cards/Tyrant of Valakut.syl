card singleFaced({
    name = "Tyrant of Valakut",
    cost = [generic(5), pip(red), pip(red)],
    types = [creature],
    subtypes = [dragon],
    text = [
      surge(mana([generic(3), pip(red), pip(red)])),
      flying,
      when(
        does(actor(this(creature)), enter),
        if = keywordCostPaid(it, surge),
        instruct(it, dealDamage(amount = 3, recipient = target(anyTarget))))],
    power = 5,
    toughness = 4})
