card {
  name = "Gideon, Ally of Zendikar",
  cost = [generic(2), pip(white), pip(white)],
  supertypes = [legendary],
  types = [planeswalker],
  subtypes = [gideon],
  text = [
    activated(
      loyaltySymbol(up(lit(1))),
      sequentially([
          establishThroughout(
            qualityChange(
              thisPlaneswalker,
              sets,
              bundle({
                  characteristics = {
                    types = [creature],
                    subtypes = [human, soldier, ally],
                    text = [indestructible],
                    power = lit(5),
                    toughness = lit(5)}},
                planeswalker)),
            untilEndOfTurn),
          preventAll(it, thisTurn)])),
    activated(
      loyaltySymbol(up(lit(0))),
      create(lit(1), written(creatureToken(2, 2, [white], [knight, ally])))),
    activated(
      loyaltySymbol(down(lit(4))),
      getEmblem([static(getsPt(allOf(and([isCreature, youControl])), up(lit(1)), up(lit(1))))]))],
  loyalty = lit(4)
}
