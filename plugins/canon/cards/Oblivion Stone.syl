card singleFaced({
    name = "Oblivion Stone",
    cost = [generic(3)],
    types = [artifact],
    text = [
      activated(
        compound([mana([generic(4)]), tapSymbol]),
        putCounters(1, printedKind(fateCounter), target(permanent))),
      activated(
        compound([mana([generic(5)]), tapSymbol, perform(sacrifice(this(artifact)))]),
        sequentially([
            destroy(
              each(
                nominal(
                  pre = [non(land)],
                  permanent,
                  post = [withoutCounter(kind = fateCounter)]))),
            removeAllCounters(printedKind(fateCounter), allOf(permanent))]))]})
