card singleFaced({
    name = "Oblivion Stone",
    cost = [generic(3)],
    types = [artifact],
    text = [
      activated(
        compound([mana([generic(4)]), tapSymbol]),
        putCounters(1, printedKind(fateCounter), target(isPermanent))),
      activated(
        compound([mana([generic(5)]), tapSymbol, perform(sacrifice(thisArtifact))]),
        sequentially([
            destroy(each(and([non(isLand), isPermanent, not(hasCounter(fateCounter))]))),
            removeAllCounters(printedKind(fateCounter), allOf(isPermanent))]))]})
