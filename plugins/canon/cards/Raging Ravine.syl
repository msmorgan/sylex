card singleFaced({
    name = "Raging Ravine",
    types = [land],
    text = [
      static(entersTapped(thisLand)),
      activated(tapSymbol, addMana(1, manaOf([[colored(red)], [colored(green)]]))),
      activated(
        mana([generic(2), pip(red), pip(green)]),
        establishThroughout(
          qualityChange(
            thisLand,
            sets,
            bundle({
                characteristics = {
                  colors = [red, green],
                  types = [creature],
                  subtypes = [elemental],
                  text = [
                    whenever(
                      does(actor(thisCreature), attack),
                      putCounters(1, printedKind(p1p1Counter), thisCreature))],
                  power = 3,
                  toughness = 3}},
              land)),
          untilEndOfTurn))]})
