card singleFaced({
    name = "Raging Ravine",
    types = [land],
    text = [
      static(entersTapped(this(land))),
      activated(tapSymbol, addMana(or([symbols([pip(red)]), symbols([pip(green)])]))),
      activated(
        mana([generic(2), pip(red), pip(green)]),
        establishThroughout(
          qualityChange(
            this(land),
            sets,
            bundle({
                characteristics = {
                  colors = [red, green],
                  types = [creature],
                  subtypes = [elemental],
                  text = [
                    whenever(
                      does(actor(this(creature)), attack),
                      putCounters(1, printedKind(p1p1Counter), it))],
                  power = 3,
                  toughness = 3}},
              retained = land)),
          untilEndOfTurn))]})
