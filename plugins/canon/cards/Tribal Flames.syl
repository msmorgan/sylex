# Pins domain counting basic land types [CR#205.3i]. The ability word itself
# has no rules meaning [CR#207.2c].
card singleFaced({
    name = "Tribal Flames",
    cost = [generic(1), pip(red)],
    types = [sorcery],
    text = [
      domain(
        spell(
          sequentially([
              instruct(this, dealDamage(amount = letter(x), recipient = target(isAnyTarget))),
              define(
                x,
                distinctCount(subtype(land, basicOnly), allOf(and([isLand, youControl]))))])))]})
