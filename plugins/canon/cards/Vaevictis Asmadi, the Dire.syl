card {
  name = "Vaevictis Asmadi, the Dire",
  cost = [generic(3), pip(black), pip(red), pip(green)],
  supertypes = [legendary],
  types = [creature],
  subtypes = [elder, dragon],
  text = [
    flying,
    whenever(
      does(actor(thisCreature), attack),
      sequentially([
          doForEach(eachPlayer, choose(target(and([isPermanent, controlledBy(they)])))),
          instruct(those(player), sacrifice(those(permanent))),
          doForEach(
            each(and([isPlayer, did(actor(which), sacrifice(a(isPermanent)), thisWay)])),
            sequentially([
                instruct(they, reveal(slice(top, lit(1), libraryOf(they)))),
                doIf(is(it, isPermanentCard), putOntoBattlefield(it))]))]))],
  power = lit(6),
  toughness = lit(6)
}
