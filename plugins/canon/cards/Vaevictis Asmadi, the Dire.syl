card singleFaced({
    name = "Vaevictis Asmadi, the Dire",
    cost = [generic(3), pip(black), pip(red), pip(green)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [elder, dragon],
    text = [
      flying,
      whenever(
        does(actor(thisCreature), attack),
        sequentially([
            doForEach(eachPlayer, choose(target(nominal(permanent, post = [controlledBy(they)])))),
            instruct(those(player), sacrifice(those(permanent))),
            doForEach(
              each(
                nominal(
                  player,
                  post = [did(actor(which), sacrifice(a(permanent)), within = thisWay)])),
              sequentially([
                  instruct(they, reveal(slice(top, 1, libraryOf(they)))),
                  doIf(
                    is(it, noun(a(nominal(pre = [permanent], card)))),
                    putOntoBattlefield(it))]))]))],
    power = 6,
    toughness = 6})
