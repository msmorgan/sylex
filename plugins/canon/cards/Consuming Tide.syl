card singleFaced({
    name = "Consuming Tide",
    cost = [generic(2), pip(blue), pip(blue)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            instruct(
              eachPlayer,
              choose(a(nominal(pre = [non(land)], permanent, post = [controlledBy(they)])))),
            returnToHand(allOf(nominal(pre = [non(land)], permanent, post = [notChosen]))),
            doForEach(
              each(
                compareOver(
                  opponent,
                  countOf(nominal(card, post = [in(handOf(they))])),
                  greater,
                  countOf(nominal(card, post = [in(yourHand)])))),
              draw(1))]))]})
