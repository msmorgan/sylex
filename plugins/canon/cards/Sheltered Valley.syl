card singleFaced({
    name = "Sheltered Valley",
    types = [land],
    text = [
      static(
        replace(
          would(actor(thisLand), enter),
          instead(
            sequentially(
              steps = [
                sacrifice(
                  each(
                    and(
                      [isPermanent, isOther, named(printedName("Sheltered Valley")), youControl]))),
                putOntoBattlefield(thisLand)])))),
      at(
        beginningOfYour(upkeep),
        if = compareAmt(countOf(and([isLand, youControl])), atMost, 3),
        gainLife(1)),
      activated(tapSymbol, addMana(symbols([colorlessPip])))]})
