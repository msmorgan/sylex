card singleFaced({
    name = "Sheltered Valley",
    types = [land],
    text = [
      static(
        replace(
          would(actor(thisLand), enter),
          instead(
            sequentially([
                sacrifice(
                  each(
                    nominal(
                      pre = [other],
                      permanent,
                      post = [named(printedName("Sheltered Valley")), youControl]))),
                putOntoBattlefield(thisLand)])))),
      at(
        beginningOfYour(upkeep),
        if = compareAmt(countOf(nominal(land, post = [youControl])), atMost, 3),
        gainLife(1)),
      activated(tapSymbol, addMana(symbols([colorlessPip])))]})
