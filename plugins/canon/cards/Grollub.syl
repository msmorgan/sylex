card singleFaced({
    name = "Grollub",
    cost = [generic(2), pip(black)],
    types = [creature],
    subtypes = [beast],
    text = [
      whenever(
        does(any, dealDamage(recipient = thisCreature)),
        instruct(eachOpponent, gainLife(thatMuch)))],
