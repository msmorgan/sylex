card {
  name = "Assemble the Players",
  cost = [1, white],
  types = [enchantment],
  text = [
    static(visibility(lookAt, you, topOfLibrary)),
    static(
      can(
        actor(you),
        cast(counted(exactly(1), and([isSpell, isCreature, hasPower(atMost, 2)])), from = onTop),
        timing = eachTurn))]
}
