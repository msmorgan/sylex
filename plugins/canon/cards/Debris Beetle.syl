card singleFaced({
    name = "Debris Beetle",
    cost = [generic(2), pip(black), pip(green)],
    types = [artifact],
    subtypes = [vehicle],
    text = [
      trample,
      when(
        does(actor(this(vehicle)), enter),
        sequentially([instruct(eachOpponent, loseLife(3)), gainLife(3)])),
      crew(2)],
    power = 6,
    toughness = 6})
