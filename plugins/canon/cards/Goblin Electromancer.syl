card singleFaced({
    name = "Goblin Electromancer",
    cost = [pip(blue), pip(red)],
    types = [creature],
    subtypes = [goblin, wizard],
    text = [
      static(
        costShift(
          allOf(and([isInstantOrSorcery, isSpell, did(actor(you), cast(which), thisObject)])),
          less(lit(1))))],
    power = lit(2),
    toughness = lit(2)})
