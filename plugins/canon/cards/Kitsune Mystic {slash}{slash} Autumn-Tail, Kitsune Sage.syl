card flip({
    name = "Kitsune Mystic",
    cost = [generic(3), pip(white)],
    types = [creature],
    subtypes = [fox, wizard],
    text = [
      at(
        beginningOfEach(endStep),
        if = is(this(creature), attachedBy(enchanted, counted(orMore(2), aura))),
        flip(it))],
    power = 2,
    toughness = 3},
  {
    name = "Autumn-Tail, Kitsune Sage",
    supertypes = [legendary],
    types = [creature],
    subtypes = [fox, wizard],
    text = [
      activated(
        mana([generic(1)]),
        attachTo(
          target(nominal(aura, post = [attachedTo(a(creature))])),
          a(nominal(pre = [other], creature))))],
    power = 4,
    toughness = 5})
