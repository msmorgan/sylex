card flip({
    name = "Kitsune Mystic",
    cost = [generic(3), pip(white)],
    types = [creature],
    subtypes = [fox, wizard],
    text = [
      at(
        beginningOfEach(endStep),
        if = is(thisCreature, attachedBy(enchanted, counted(orMore(2), hasSubtype(aura)))),
        flip(thisCreature))],
    power = 2,
    toughness = 3},
  {
    name = "Autumn-Tail, Kitsune Sage",
    supertypes = [legendary],
    types = [creature],
    subtypes = [fox, wizard],
    text = [
      activated(
        mana([generic(1)]),
        attachTo(
          target(and([hasSubtype(aura), attachedTo(a(isCreature))])),
          a(and([isCreature, isOther]))))],
    power = 4,
    toughness = 5})
