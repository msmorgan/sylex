card singleFaced({
    name = "Investigator's Journal",
    cost = [generic(2)],
    types = [artifact],
    subtypes = [book, clue],
    text = [
      static(
        entersWithCounters(
          this(artifact),
          aggregateOver(max, player, countOf(nominal(creature, post = [controls(they)]))),
          suspectCounter)),
      activated(
        compound([
            mana([generic(2)]),
            tapSymbol,
            perform(removeCounters(exactly(1), printedKind(suspectCounter), this(artifact)))]),
        draw(1)),
      activated(compound([mana([generic(2)]), perform(sacrifice(this(artifact)))]), draw(1))]})
