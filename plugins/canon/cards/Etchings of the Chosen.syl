card singleFaced({
    name = "Etchings of the Chosen",
    cost = [generic(1), pip(white), pip(black)],
    types = [enchantment],
    text = [
      static(entersChoosing(thisEnchantment, subtype(creature))),
      static(
        getsPt(
          bare(nominal(creature, post = [youControl, ofChosen(subtype(creature))])),
          up(1),
          up(1))),
      activated(
        compound([
            mana([generic(1)]),
            perform(sacrifice(a(nominal(creature, post = [ofChosen(subtype(creature))]))))]),
        gain(
          target(nominal(creature, post = [youControl])),
          [indestructible],
          duration = untilEndOfTurn))]})
