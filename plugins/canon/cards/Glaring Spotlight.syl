# Pins an as-though exception for targeting by your spells and abilities.
# The exception applies only to that act and does not remove hexproof [CR#609.4].
card singleFaced({
    name = "Glaring Spotlight",
    cost = [generic(1)],
    types = [artifact],
    text = [
      static(
        can(
          by(bare(nominal(or([spell, abilityHead(anyOnStack)]), post = [youControl]))),
          target(
            bare(nominal(creature, post = [opponentsControl, hasKeyword(theKeyword(hexproof))]))),
          asThough = holds(is(them, not(hasKeyword(theKeyword(hexproof))))))),
      activated(
        compound([mana([generic(3)]), perform(sacrifice(this(artifact)))]),
        sequentially([
            gain(
              bare(nominal(creature, post = [youControl])),
              [hexproof],
              duration = untilEndOfTurn),
            establishThroughout(
              cant(any, block(attacker = bare(nominal(creature, post = [youControl])))),
              thisTurn)]))]})
