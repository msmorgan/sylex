# Pins an as-though exception for targeting by your spells and abilities.
# The exception applies only to that act and does not remove hexproof [CR#609.4].
card singleFaced({
    name = "Glaring Spotlight",
    cost = [generic(1)],
    types = [artifact],
    text = [
      static(
        can(
          by(allOf(nominal(or([spell, abilityHead(anyOnStack)]), post = [youControl]))),
          target(
            allOf(nominal(creature, post = [opponentsControl, hasKeyword(theKeyword(hexproof))]))),
          asThough = holds(is(them, not(hasKeyword(theKeyword(hexproof))))))),
      activated(
        compound([mana([generic(3)]), perform(sacrifice(thisArtifact))]),
        sequentially([
            gain(
              allOf(nominal(creature, post = [youControl])),
              [hexproof],
              duration = untilEndOfTurn),
            establishThroughout(
              cant(any, block(attacker = allOf(nominal(creature, post = [youControl])))),
              thisTurn)]))]})
