card transforming({
    front = {
      name = "Harvest Hand",
      cost = [3],
      types = [artifact, creature],
      subtypes = [scarecrow],
      text = [when(does(actor(thisCreature), die), returnToBattlefieldTransformed(it, you))],
      power = 2,
      toughness = 2},
    back = {
      name = "Scrounged Scythe",
      types = [artifact],
      subtypes = [equipment],
      text = [
        static(getsPt(equipped(creature), up(1), up(1))),
        static(
          onlyWhile(
            abilityGrant(equipped(creature), menace),
            is(equipped(creature), hasSubtype(human)))),
        equip(mana([2]))]}})
