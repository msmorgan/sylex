card singleFaced({
    name = "Necromancy",
    cost = [generic(2), pip(black)],
    types = [enchantment],
    text = [
      asThoughFlashSacrificedAtCleanup,
      when(
        does(actor(thisEnchantment), enter),
        if = is(it, in(battlefield)),
        sequentially([
            establish(
              conjunction([
                  addSubtype(it, aura),
                  abilityGrant(
                    it,
                    [enchant(and([hasType(creature), did(by(this), putOntoBattlefield(which))]))])],
                subject = it)),
            putOntoBattlefieldUnderYourControl(
              target(nominal(pre = [creature], card, post = [in(graveyard)]))),
            attachTo(thisEnchantment, it),
            delay(
              does(actor(thisEnchantment), leave),
              instruct(controllerOf(that(creature)), sacrifice(it)))]))]})
