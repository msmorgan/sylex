card singleFaced({
    name = "Necromancy",
    cost = [generic(2), pip(black)],
    types = [enchantment],
    text = [
      asThoughFlashSacrificedAtCleanup,
      when(
        does(actor(this(enchantment)), enter),
        if = is(it, in(battlefield)),
        sequentially([
            establish(
              conjunction([
                  addSubtype(it, aura),
                  abilityGrant(
                    it,
                    [
                      enchant(
                        and([hasType(creature), did(by(ownName), putOntoBattlefield(which))]))])],
                subject = it)),
            putOntoBattlefieldUnderYourControl(
              target(nominal(pre = [creature], card, post = [in(graveyard)]))),
            attachTo(this(enchantment), it),
            delay(
              does(actor(this(enchantment)), leave),
              instruct(controllerOf(that(creature)), sacrifice(it)))]))]})
