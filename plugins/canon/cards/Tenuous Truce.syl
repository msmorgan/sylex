card singleFaced({
    name = "Tenuous Truce",
    cost = [generic(1), pip(white)],
    types = [enchantment],
    subtypes = [aura],
    text = [
      enchant(isOpponent),
      at(
        beginningOfPossessed(enchanted(opponent), endStep),
        instruct(eachOf(and([you, that(player)])), draw(1))),
      triggered(
        or([
            when(
              does(
                actor(you),
                attack(
                  defender = or(
                    [enchanted(opponent), a(nominal(planeswalker, post = [controls(they)]))])))),
            when(
              does(
                actor(they),
                attack(defender = or([you, a(nominal(planeswalker, post = [youControl]))]))))]),
        sacrifice(this(aura)))]})
