card singleFaced({
    name = "Energybending",
    cost = [generic(2)],
    types = [instant],
    subtypes = [lesson],
    text = [
      spell(
        sequentially(
          steps = [
            establishThroughout(
              qualityChange(allOf(and([isLand, youControl])), adds, everyTypeOf(basicLand)),
              untilEndOfTurn),
            draw(1)]))]})
