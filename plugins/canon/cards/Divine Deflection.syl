card singleFaced({
    name = "Divine Deflection",
    cost = [variable, pip(white)],
    types = [instant],
    text = [
      spell(
        establishThroughout(
          replace(
            would(
              any,
              dealDamage(recipient = andOr([you, allOf(nominal(permanent, post = [youControl]))]))),
            instead(
              preventDamage(
                theNext(letter(x)),
                also = instruct(
                  ownName,
                  dealDamage(amount = thatMuch, recipient = target(anyTarget)))))),
          thisTurn))]})
