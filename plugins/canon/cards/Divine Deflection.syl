card singleFaced({
    name = "Divine Deflection",
    cost = [variable, pip(white)],
    types = [instant],
    text = [
      spell(
        establishThroughout(
          replace(
            would(
              any,
              dealDamage(
                recipient = andOr(phrases = [you, allOf(and([isPermanent, youControl]))]))),
            instead(
              preventDamage(
                theNext(letter(x)),
                also = instruct(
                  this,
                  dealDamage(amount = thatMuch, recipient = target(isAnyTarget)))))),
          thisTurn))]})
