card singleFaced({
    name = "Heart of Yavimaya",
    types = [land],
    text = [
      static(
        replace(
          would(actor(this(land)), enter),
          instead(
            doIfDone(
              sacrifice(a(forest)),
              ifDid = putOntoBattlefield(this(land)),
              ifNot = putInto(it, graveyard))))),
      activated(tapSymbol, addMana(symbols([pip(green)]))),
      activated(tapSymbol, get(target(creature), up(1), up(1), duration = untilEndOfTurn))]})
