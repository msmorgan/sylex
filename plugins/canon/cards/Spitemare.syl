card singleFaced({
    name = "Spitemare",
    cost = [generic(2), hybridPip(red, white), hybridPip(red, white)],
    types = [creature],
    subtypes = [elemental],
    text = [
      whenever(
        does(any, dealDamage(recipient = thisCreature)),
        instruct(it, dealDamage(amount = thatMuch, recipient = target(isAnyTarget))))],
    power = 3,
    toughness = 3})
