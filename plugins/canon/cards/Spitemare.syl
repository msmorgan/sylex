card singleFaced({
    name = "Spitemare",
    cost = [generic(2), hybridPip(red, white), hybridPip(red, white)],
    types = [creature],
    subtypes = [elemental],
    text = [
      whenever(
        does(any, dealDamage(recipient = thisCreature)),
        instruct(it, dealDamage(thatMuch, target(isAnyTarget))))],
    power = lit(3),
    toughness = lit(3)})
