card singleFaced({
    name = "Exquisite Archangel",
    cost = [generic(5), pip(white), pip(white)],
    types = [creature],
    subtypes = [angel],
    text = [
      flying,
      static(
        replace(
          would(actor(you), loseGame),
          instead(
            sequentially(
              steps = [
                exile(thisCreature),
                setLife(statOf(playerStat(startingLifeTotal), you))]))))],
    power = 5,
    toughness = 5})
