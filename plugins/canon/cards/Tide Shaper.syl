card singleFaced({
    name = "Tide Shaper",
    cost = [pip(blue)],
    types = [creature],
    subtypes = [merfolk, wizard],
    text = [
      kicker(mana([generic(1)])),
      when(
        does(actor(thisCreature), enter),
        if = keywordCostPaid(it, kicker),
        establish(
          qualityChange(target(land), sets, bundle({characteristics = {subtypes = [island]}})),
          duration = forAsLongAs(is(thisCreature, in(battlefield))))),
      static(
        onlyWhile(
          getsPt(thisCreature, up(1), up(1)),
          exists(nominal(island, post = [opponentsControl]))))],
    power = 1,
    toughness = 1})
