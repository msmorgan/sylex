card singleFaced({
    name = "Tide Shaper",
    cost = [pip(blue)],
    types = [creature],
    subtypes = [merfolk, wizard],
    text = [
      kicker(mana([generic(1)])),
      when(
        does(actor(thisCreature), enter),
        establish(
          qualityChange(target(isLand), sets, bundle({characteristics = {subtypes = [island]}})),
          duration = forAsLongAs(is(thisCreature, in(battlefield)))),
        if = keywordCostPaid(kicker, thisCreature)),
      static(
        onlyWhile(
          getsPt(thisCreature, up(1), up(1)),
          exists(and([hasSubtype(island), opponentsControl]))))],
    power = 1,
    toughness = 1})
