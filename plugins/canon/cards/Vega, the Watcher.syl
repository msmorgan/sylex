card singleFaced({
    name = "Vega, the Watcher",
    cost = [generic(1), pip(white), pip(blue)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [bird, spirit],
    text = [
      flying,
      whenever(
        does(
          actor(you),
          cast(
            a(
              nominal(
                spell,
                post = [not(was(cast(which, from = yourHand), within = thisObject))])))),
        draw(1))],
    power = 2,
    toughness = 2})
