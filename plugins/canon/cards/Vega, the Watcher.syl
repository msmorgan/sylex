card {
  name = "Vega, the Watcher",
  cost = [generic(1), pip(white), pip(blue)],
  supertypes = [legendary],
  types = [creature],
  subtypes = [bird, spirit],
  text = [
    flying,
    whenever(
      does(
        actor(you),
        cast(a(and([isSpell, not(did(any, cast(which, from = yourHand), thisObject))])))),
      draw(lit(1)))],
  power = lit(2),
  toughness = lit(2)
}
