card singleFaced({
    name = "Gaea's Revenge",
    cost = [generic(5), pip(green), pip(green)],
    types = [creature],
    subtypes = [elemental],
    text = [
      static(cant(any, counter(this(spell)))),
      haste,
      static(
        cant(
          by(
            bare(
              or([
                  nominal(pre = [non(green)], spell),
                  nominal(
                    ability,
                    post = [fromSource(bare(nominal(pre = [non(green)], source)))])]))),
          target(this(creature))))],
    power = 8,
    toughness = 5})
