card singleFaced({
    name = "Gaea's Revenge",
    cost = [generic(5), pip(green), pip(green)],
    types = [creature],
    subtypes = [elemental],
    text = [
      static(cant(any, counter(thisSpell))),
      haste,
      static(
        cant(
          by(
            bare(
              or([
                  nominal(pre = [non(green)], spell),
                  abilityOf(bare(nominal(pre = [non(green)], source)))]))),
          target(thisCreature)))],
    power = 8,
    toughness = 5})
