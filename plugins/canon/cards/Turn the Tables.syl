card singleFaced({
    name = "Turn the Tables",
    cost = [generic(3), pip(white), pip(white)],
    types = [instant],
    text = [
      spell(
        establishThroughout(
          replace(
            would(any, dealDamage(kind = combat, recipient = you)),
            instead(redirectDamage(allDamage, target(nominal(pre = [attacking], creature))))),
          thisTurn))]})
