card singleFaced({
    name = "Tocasia's Welcome",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    text = [
      whenever(
        does(
          actor(counted(orMore(1), and([isCreature, youControl, hasManaValue(atMost, lit(3))]))),
          enter),
        draw(lit(1)),
        limit = oncePerTurn)]})
