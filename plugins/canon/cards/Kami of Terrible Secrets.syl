card {
  name = "Kami of Terrible Secrets",
  cost = [3, black],
  types = [creature],
  subtypes = [spirit],
  text = [
    when(
      does(actor(thisCreature), enter),
      if = and([exists(and([isArtifact, youControl])), exists(and([isEnchantment, youControl]))]),
      action = sequentially([draw(1), gainLife(1)]))],
  power = 3,
  toughness = 4
}
