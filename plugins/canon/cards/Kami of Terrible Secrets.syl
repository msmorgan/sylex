card singleFaced({
    name = "Kami of Terrible Secrets",
    cost = [generic(3), pip(black)],
    types = [creature],
    subtypes = [spirit],
    text = [
      when(
        does(actor(this(creature)), enter),
        if = controls(you, and([a(artifact), a(enchantment)])),
        sequentially([draw(1), gainLife(1)]))],
    power = 3,
    toughness = 4})
