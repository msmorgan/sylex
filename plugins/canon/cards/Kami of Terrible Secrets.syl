card {
  name = "Kami of Terrible Secrets",
  cost = [generic(3), pip(black)],
  types = [creature],
  subtypes = [spirit],
  text = [
    when(
      does(actor(thisCreature), enter),
      if = and([exists(and([isArtifact, youControl])), exists(and([isEnchantment, youControl]))]),
      action = sequentially([draw(lit(1)), gainLife(lit(1))]))],
  power = lit(3),
  toughness = lit(4)
}
