card singleFaced({
    name = "Kami of Terrible Secrets",
    cost = [generic(3), pip(black)],
    types = [creature],
    subtypes = [spirit],
    text = [
      when(
        does(actor(thisCreature), enter),
        sequentially(steps = [draw(1), gainLife(1)]),
        if = and(
          conjuncts = [
            exists(and([isArtifact, youControl])),
            exists(and([isEnchantment, youControl]))]))],
    power = 3,
    toughness = 4})
