card singleFaced({
    name = "Thunderwave",
    cost = [generic(2), pip(red), pip(red)],
    types = [sorcery],
    text = [
      spell(
        sequentially(
          steps = [
            rollDice(sides = sides(20)),
            applyResultsTable([
                rollRow(
                  oneThrough(9),
                  instruct(this, dealDamage(amount = 3, recipient = each(isCreature)))),
                rollRow(
                  fromTo(10, 19),
                  sequentially(
                    steps = [
                      may(choose(a(isCreature))),
                      instruct(
                        this,
                        dealDamage(amount = 3, recipient = each(and([isCreature, notChosen]))))])),
                rollRow(
                  exactly(20),
                  instruct(
                    this,
                    dealDamage(
                      amount = 6,
                      recipient = each(and([isCreature, opponentsControl])))))])]))]})
