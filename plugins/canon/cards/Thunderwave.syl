card singleFaced({
    name = "Thunderwave",
    cost = [generic(2), pip(red), pip(red)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            rollDice(sides = sides(20)),
            applyResultsTable([
                rollRow(
                  rollRange(1, 9),
                  instruct(this, dealDamage(amount = 3, recipient = each(creature)))),
                rollRow(
                  rollRange(10, 19),
                  sequentially([
                      may(choose(a(creature))),
                      instruct(
                        this,
                        dealDamage(
                          amount = 3,
                          recipient = each(nominal(creature, post = [notChosen]))))])),
                rollRow(
                  exactly(20),
                  instruct(
                    this,
                    dealDamage(
                      amount = 6,
                      recipient = each(nominal(creature, post = [opponentsControl])))))])]))]})
