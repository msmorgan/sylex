card singleFaced({
    name = "Mogg Salvage",
    cost = [generic(2), pip(red)],
    types = [instant],
    text = [
      static(
        onlyWhile(
          can(actor(you), cast(thisSpell, altCost = withoutPaying)),
          and([
              exists(and([isLand, hasSubtype(island), anOpponentControls])),
              exists(and([isLand, hasSubtype(mountain), youControl]))]))),
      spell(destroy(target(isArtifact)))]})
