card singleFaced({
    name = "Mogg Salvage",
    cost = [generic(2), pip(red)],
    types = [instant],
    text = [
      static(
        if(
          and([
              exists(nominal(island, post = [anOpponentControls])),
              exists(nominal(mountain, post = [youControl]))]),
          can(actor(you), cast(this(spell), altCost = withoutPaying)))),
      spell(destroy(target(artifact)))]})
