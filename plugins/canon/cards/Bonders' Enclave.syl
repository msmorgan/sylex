card singleFaced({
    name = "Bonders' Enclave",
    types = [land],
    text = [
      activated(tapSymbol, addMana(1, manaOf([[colorless]]))),
      activatedOnlyIf(
        compound([mana([generic(3)]), tapSymbol]),
        draw(1),
        exists(and([isCreature, youControl, hasPower(atLeast, 4)])))]})
