card singleFaced({
    name = "Bonders' Enclave",
    types = [land],
    text = [
      activated(tapSymbol, addMana(symbols([colorlessPip]))),
      activatedOnlyIf(
        compound(costs = [mana([generic(3)]), tapSymbol]),
        draw(1),
        exists(and([isCreature, youControl, hasPower(atLeast, 4)])))]})
