card singleFaced({
    name = "Phyrexian Revoker",
    cost = [generic(2)],
    types = [artifact, creature],
    subtypes = [phyrexian, horror],
    text = [
      static(entersChoosingFrom(this(creature), cardName, nameOfCard(non(hasType(land))))),
      static(
        cant(
          any,
          activate(
            bare(
              nominal(
                abilityHead(anyActivated),
                post = [of(bare(nominal(source, post = [named(chosenName)])))])))))],
    power = 2,
    toughness = 1})
