card singleFaced({
    name = "Mogg Maniac",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [goblin],
    text = [
      whenever(
        does(any, dealDamage(recipient = thisCreature)),
        instruct(
          it,
          dealDamage(amount = thatMuch, recipient = target(or([isPlaneswalker, isOpponent])))))],
    power = 1,
    toughness = 1})
