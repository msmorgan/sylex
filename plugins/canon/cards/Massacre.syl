card singleFaced({
    name = "Massacre",
    cost = [generic(2), pip(black), pip(black)],
    types = [sorcery],
    text = [
      static(
        if(
          and(
            conjuncts = [
              exists(and([isLand, hasSubtype(plains), anOpponentControls])),
              exists(and([isLand, hasSubtype(swamp), youControl]))]),
          can(actor(you), cast(thisSpell, altCost = withoutPaying)))),
      spell(get(allOf(isCreature), down(2), down(2), duration = untilEndOfTurn))]})
