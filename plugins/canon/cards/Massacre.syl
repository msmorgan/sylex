card singleFaced({
    name = "Massacre",
    cost = [generic(2), pip(black), pip(black)],
    types = [sorcery],
    text = [
      static(
        if(
          and([
              exists(nominal(plains, post = [anOpponentControls])),
              exists(nominal(swamp, post = [youControl]))]),
          can(actor(you), cast(thisSpell, altCost = withoutPaying)))),
      spell(get(allOf(creature), down(2), down(2), duration = untilEndOfTurn))]})
