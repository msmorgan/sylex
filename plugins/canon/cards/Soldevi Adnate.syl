card {
  name = "Soldevi Adnate",
  cost = [1, black],
  types = [creature],
  subtypes = [human, cleric],
  text = [
    activated(
      compound(
        [tapSymbol, perform(sacrifice(a(and([isCreature, or([hasColor(black), isArtifact])]))))]),
      addMana(
        statOf(stat(manaValue), the(and([was(sacrifice(which)), isCreature]))),
        manaOf([[of(black)]])))],
  power = 1,
  toughness = 2
}
