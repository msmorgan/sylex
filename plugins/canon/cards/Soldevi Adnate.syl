card singleFaced({
    name = "Soldevi Adnate",
    cost = [generic(1), pip(black)],
    types = [creature],
    subtypes = [human, cleric],
    text = [
      activated(
        compound(
          [tapSymbol, perform(sacrifice(a(nominal(pre = [or([black, artifact])], creature))))]),
        addMana(
          counted(
            statOf(stat(manaValue), the(nominal(pre = [was(sacrifice(which))], creature))),
            symbols([pip(black)]))))],
    power = 1,
    toughness = 2})
