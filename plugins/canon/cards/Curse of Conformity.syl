card singleFaced({
    name = "Curse of Conformity",
    cost = [generic(4), pip(white)],
    types = [enchantment],
    subtypes = [aura, curse],
    text = [
      enchant(isPlayer),
      static(
        conjunction([
            getsBase(
              allOf(
                and([isCreature, non(hasSupertype(legendary)), controlledBy(enchanted(player))])),
              lit(3),
              lit(3)),
            qualityChange(them, loses, everyTypeOf(creature))]))]})
