card singleFaced({
    name = "Curse of Conformity",
    cost = [generic(4), pip(white)],
    types = [enchantment],
    subtypes = [aura, curse],
    text = [
      enchant(isPlayer),
      static(
        conjunction([
            getsBase(
              allOf(
                nominal(
                  pre = [non(legendary)],
                  creature,
                  post = [controlledBy(enchanted(player))])),
              3,
              3),
            qualityChange(them, loses, everyTypeOf(creature))]))]})
