card singleFaced({
    name = "Drach'Nyen",
    cost = [generic(4), pip(black), pip(red)],
    supertypes = [legendary],
    types = [artifact],
    subtypes = [equipment],
    text = [
      when(does(actor(ownName), enter), exile(targets(upTo(1), creature))),
      static(
        conjunction([
            abilityGrant(equipped(creature), [menace]),
            getsPt(equipped(creature), up(letter(x)), up(0)),
            letterDefinition(x, powerOf(the(nominal(pre = [was(exile(which))], card))))])),
      equip(mana([generic(2)]))]})
