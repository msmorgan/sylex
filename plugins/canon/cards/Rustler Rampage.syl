card singleFaced({
    name = "Rustler Rampage",
    cost = [pip(white)],
    types = [instant],
    text = [
      spell(
        chooseSpree([
            plusMode(
              mana([generic(1)]),
              untap(allOf(nominal(creature, post = [controls(target(player))])))),
            plusMode(
              mana([generic(1)]),
              gain(target(creature), [doubleStrike], duration = untilEndOfTurn))]))]})
