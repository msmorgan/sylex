card singleFaced({
    name = "Rustler Rampage",
    cost = [pip(white)],
    types = [instant],
    text = [
      spell(
        chooseSpree([
            plusMode(
              mana([generic(1)]),
              untap(allOf(and([isCreature, controlledBy(target(isPlayer))])))),
            plusMode(
              mana([generic(1)]),
              gain(target(isCreature), [doubleStrike], duration = untilEndOfTurn))]))]})
