card singleFaced({
    name = "Arcum's Weathervane",
    cost = [generic(2)],
    types = [artifact],
    text = [
      activated(
        compound([mana([generic(2)]), tapSymbol]),
        establish(
          qualityChange(
            target(nominal(pre = [snow], land)),
            loses,
            bundle({characteristics = {supertypes = [snow]}})))),
      activated(
        compound([mana([generic(2)]), tapSymbol]),
        establish(
          qualityChange(
            target(nominal(pre = [non(snow), basic], land)),
            adds,
            bundle({characteristics = {supertypes = [snow]}}))))]})
