card singleFaced({
    name = "The Flux",
    cost = [generic(2), pip(red), pip(red)],
    types = [enchantment],
    subtypes = [saga],
    text = [
      when(
        chapterMark(chapters = [1]),
        instruct(
          this,
          dealDamage(amount = 4, recipient = target(and([isCreature, anOpponentControls]))))),
      when(
        chapterMark(chapters = [2, 3, 4, 5]),
        sequentially(
          steps = [
            exile(topSlice(1)),
            establishThroughout(can(actor(you), play(that(card))), thisTurn)])),
      when(chapterMark(chapters = [6]), addMana(counted(6, symbols([pip(red)]))))]})
