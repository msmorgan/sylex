card singleFaced({
    name = "Black Mana Battery",
    cost = [generic(4)],
    types = [artifact],
    text = [
      activated(
        compound([mana([generic(2)]), tapSymbol]),
        putCounters(1, printedKind(chargeCounter), thisArtifact)),
      activated(
        compound([
            tapSymbol,
            perform(removeCounters(anyNumber, printedKind(chargeCounter), thisArtifact))]),
        sequentially([
            addMana(symbols([pip(black)])),
            addMana(counted(removedThisWay, symbols([pip(black)])))]))]})
