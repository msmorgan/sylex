card singleFaced({
    name = "Skeleton Ship",
    cost = [generic(3), pip(blue), pip(black)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [skeleton],
    text = [
      when(
        stateHolds(not(exists(and([isLand, hasSubtype(island), youControl])))),
        sacrifice(thisCreature)),
      activated(tapSymbol, putCounters(1, printedKind(m1m1Counter), target(isCreature)))],
    power = 0,
    toughness = 3})
