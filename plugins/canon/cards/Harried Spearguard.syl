card singleFaced({
    name = "Harried Spearguard",
    cost = [pip(red)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      haste,
      when(
        does(actor(this(creature)), die),
        create(
          1,
          written({
              characteristics = {
                colors = [black],
                types = [creature],
                subtypes = [rat],
                text = [static(cant(actor(this(token)), block))],
                power = 1,
                toughness = 1}})))],
    power = 1,
    toughness = 1})
