card singleFaced({
    name = "Bleeding Effect",
    cost = [generic(2), pip(white), pip(black)],
    types = [enchantment],
    text = [
      alsoForKeywords(
        at(
          beginningOfYour(combat),
          doOnlyIf(
            establishThroughout(
              keywordGrant(
                bare(nominal(creature, post = [youControl])),
                thatKeyword,
                and([hasType(creature), in(yourGraveyard), hasKeyword(thatKeyword)])),
              untilEndOfTurn),
            exists(
              nominal(
                pre = [creature],
                card,
                post = [in(yourGraveyard), hasKeyword(thatKeyword)])))),
        [
          theKeyword(flying),
          theKeyword(firstStrike),
          theKeyword(doubleStrike),
          theKeyword(deathtouch),
          anyIn({word = hexproof}),
          theKeyword(indestructible),
          theKeyword(lifelink),
          theKeyword(menace),
          theKeyword(reach),
          theKeyword(trample),
          theKeyword(vigilance)])]})
