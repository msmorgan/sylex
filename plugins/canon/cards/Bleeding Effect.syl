card singleFaced({
    name = "Bleeding Effect",
    cost = [generic(2), pip(white), pip(black)],
    types = [enchantment],
    text = [
      alsoForKeywords(
        at(
          beginningOfYour(combat),
          doOnlyIf(
            establishThroughout(
              keywordGrant(
                allOf(and([isCreature, youControl])),
                thatKeyword,
                and([isCreature, in(yourGraveyard), hasKeyword(thatKeyword)])),
              untilEndOfTurn),
            exists(and([isCreature, in(yourGraveyard), hasKeyword(thatKeyword)])))),
        [
          theKeyword(flying),
          theKeyword(firstStrike),
          theKeyword(doubleStrike),
          theKeyword(deathtouch),
          anyIn({word = hexproof}),
          theKeyword(indestructible),
          theKeyword(lifelink),
          theKeyword(menace),
          theKeyword(reach),
          theKeyword(trample),
          theKeyword(vigilance)])]})
