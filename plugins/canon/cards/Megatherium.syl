card singleFaced({
    name = "Megatherium",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [beast],
    text = [
      trample,
      when(
        does(actor(thisCreature), enter),
        doUnless(sacrifice(thisCreature), scaledGenericMana(forEach(1, cardIn(yourHand)))))],
    power = 4,
    toughness = 4})
