card singleFaced({
    name = "Megatherium",
    cost = [generic(2), pip(green)],
    types = [creature],
    subtypes = [beast],
    text = [
      trample,
      when(
        does(actor(this(creature)), enter),
        doUnless(
          scaledGenericMana(forEach(1, nominal(card, post = [in(yourHand)]))),
          sacrifice(it)))],
    power = 4,
    toughness = 4})
