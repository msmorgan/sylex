card singleFaced({
    name = "Countersculpt",
    cost = [pip(blue), pip(blue)],
    types = [instant],
    text = [
      static(
        addedCost(
          this,
          mandatory,
          plusAdditional(or([perform(behold(hasSubtype(jace))), mana([generic(1)])])))),
      spell(sequentially([counter(target(isSpell)), empowerJace(1)]))]})
