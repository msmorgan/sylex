card singleFaced({
    name = "Heat Wave",
    cost = [generic(2), pip(red)],
    types = [enchantment],
    text = [
      cumulativeUpkeep(mana([pip(red)])),
      static(
        cant(
          actor(allOf(and([isCreature, hasColor(blue)]))),
          block(attacker = allOf(and([isCreature, youControl]))))),
      static(
        gatedBy(
          perform(payLife(amount = forEach(1, and([isCreature, isBlocking, controlledBy(they)])))),
          actor(allOf(and([isCreature, non(hasColor(blue))]))),
          block(attacker = allOf(and([isCreature, youControl])))))]})
