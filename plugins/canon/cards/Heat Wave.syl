card singleFaced({
    name = "Heat Wave",
    cost = [generic(2), pip(red)],
    types = [enchantment],
    text = [
      cumulativeUpkeep(mana([pip(red)])),
      static(
        cant(
          actor(bare(nominal(pre = [blue], creature))),
          block(attacker = bare(nominal(creature, post = [youControl]))))),
      static(
        gatedBy(
          actor(bare(nominal(pre = [non(blue)], creature))),
          block(attacker = bare(nominal(creature, post = [youControl]))),
          perform(
            payLife(
              amount = forEach(
                1,
                nominal(pre = [blocking], creature, post = [controlledBy(they)]))))))]})
