card singleFaced({
    name = "Veiling Oddity",
    cost = [generic(3), pip(blue)],
    types = [creature],
    subtypes = [illusion],
    text = [
      suspend(4, mana([generic(1), pip(blue)])),
      when(
        timed(
          does(any, removeCounters(theLast, printedKind(timeCounter), this)),
          whileTrue(is(this, cardIn(exileZone)))),
        establishThroughout(cant(any, block(attacker = allOf(isCreature))), thisTurn))],
    power = 2,
    toughness = 3})
