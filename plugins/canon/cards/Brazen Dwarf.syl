card {
  name = "Brazen Dwarf",
  cost = [generic(1), pip(red)],
  types = [creature],
  subtypes = [dwarf, shaman],
  text = [
    whenever(
      does(actor(you), rollDice(anyAmount, anyDie)),
      instruct(thisCreature, dealDamage(lit(1), eachOpponent)))],
  power = lit(1),
  toughness = lit(3)
}
