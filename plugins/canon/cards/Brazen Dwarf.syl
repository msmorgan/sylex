card singleFaced({
    name = "Brazen Dwarf",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [dwarf, shaman],
    text = [
      whenever(
        does(actor(you), rollDice(anyAmount, anyDie)),
        instruct(thisCreature, dealDamage(1, eachOpponent)))],
    power = 1,
    toughness = 3})
