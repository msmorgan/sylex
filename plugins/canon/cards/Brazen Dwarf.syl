card singleFaced({
    name = "Brazen Dwarf",
    cost = [generic(1), pip(red)],
    types = [creature],
    subtypes = [dwarf, shaman],
    text = [
      whenever(
        does(actor(you), rollDice(count = anyAmount, sides = anyDie)),
        instruct(thisCreature, dealDamage(amount = 1, recipient = eachOpponent)))],
    power = 1,
    toughness = 3})
