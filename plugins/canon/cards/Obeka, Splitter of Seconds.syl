card singleFaced({
    name = "Obeka, Splitter of Seconds",
    cost = [generic(1), pip(blue), pip(black), pip(red)],
    supertypes = [legendary],
    types = [creature],
    subtypes = [ogre, warlock],
    text = [
      menace,
      whenever(
        does(actor(shortenedName), dealDamage(kind = combat, recipient = a(player))),
        additionalStep(upkeep, none, thatMany))],
    power = 2,
    toughness = 5})
