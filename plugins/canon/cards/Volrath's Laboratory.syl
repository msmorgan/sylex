card singleFaced({
    name = "Volrath's Laboratory",
    cost = [generic(5)],
    types = [artifact],
    text = [
      static(
        conjunction(
          [entersChoosing(thisArtifact, color), entersChoosing(thisArtifact, subtype(creature))])),
      activated(
        compound(costs = [mana([generic(5)]), tapSymbol]),
        create(
          1,
          written({
              characteristics = {types = [creature], power = 2, toughness = 2},
              qualities = [
                withQuality(ofChosen(color)),
                withQuality(ofChosen(subtype(creature)))]})))]})
