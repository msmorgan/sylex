card singleFaced({
    name = "Martyrs of Korlis",
    cost = [generic(3), pip(white), pip(white)],
    types = [creature],
    subtypes = [human],
    text = [
      static(
        asLongAs(
          is(this(creature), untapped),
          replace(
            would(by(bare(artifact)), dealDamage(recipient = you)),
            instead(redirectDamage(allDamage, this(creature))))))],
    power = 1,
    toughness = 6})
