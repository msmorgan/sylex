card singleFaced({
    name = "Martyrs of Korlis",
    cost = [generic(3), pip(white), pip(white)],
    types = [creature],
    subtypes = [human],
    text = [
      static(
        onlyWhile(
          replace(
            would(by(allOf(isArtifact)), dealDamage(recipient = you)),
            instead(redirectDamage(allDamage, thisCreature))),
          is(thisCreature, isUntapped)))],
    power = lit(1),
    toughness = lit(6)})
