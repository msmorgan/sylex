card singleFaced({
    name = "Martyrs of Korlis",
    cost = [generic(3), pip(white), pip(white)],
    types = [creature],
    subtypes = [human],
    text = [
      static(
        asLongAs(
          is(thisCreature, untapped),
          replace(
            would(by(allOf(artifact)), dealDamage(recipient = you)),
            instead(redirectDamage(allDamage, thisCreature)))))],
    power = 1,
    toughness = 6})
