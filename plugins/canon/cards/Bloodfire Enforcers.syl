card singleFaced({
    name = "Bloodfire Enforcers",
    cost = [generic(3), pip(red)],
    types = [creature],
    subtypes = [human, monk],
    text = [
      static(
        onlyWhile(
          abilityGrant(thisCreature, [firstStrike, trample]),
          and([
              exists(and([isInstant, in(yourGraveyard)])),
              exists(and([isSorcery, in(yourGraveyard)]))])))],
    power = 5,
    toughness = 2})
