card singleFaced({
    name = "Bloodfire Enforcers",
    cost = [generic(3), pip(red)],
    types = [creature],
    subtypes = [human, monk],
    text = [
      static(
        onlyWhile(
          abilityGrant(this(creature), [firstStrike, trample]),
          is(
            and([a(nominal(pre = [instant], card)), a(nominal(pre = [sorcery], card))]),
            in(yourGraveyard))))],
    power = 5,
    toughness = 2})
