card singleFaced({
    name = "Bloodfire Enforcers",
    cost = [generic(3), pip(red)],
    types = [creature],
    subtypes = [human, monk],
    text = [
      static(
        onlyWhile(
          abilityGrant(thisCreature, [firstStrike, trample]),
          is(and([a(and([isInstant, isCard])), a(and([isSorcery, isCard]))]), in(yourGraveyard))))],
    power = 5,
    toughness = 2})
