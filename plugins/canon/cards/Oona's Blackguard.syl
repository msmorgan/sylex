card singleFaced({
    name = "Oona's Blackguard",
    cost = [generic(1), pip(black)],
    types = [creature],
    subtypes = [faerie, rogue],
    text = [
      flying,
      static(
        entersWithAdditionalCounters(
          each(nominal(pre = [other, rogue], creature, post = [youControl])),
          1,
          p1p1Counter)),
      whenever(
        does(
          actor(a(nominal(creature, post = [youControl, withCounter(kind = p1p1Counter)]))),
          dealDamage(kind = combat, recipient = a(player))),
        instruct(that(player), discard(a(nominal(card, post = [in(hand)])))))],
    power = 1,
    toughness = 1})
