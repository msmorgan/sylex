card singleFaced({
    name = "Celestial Judgment",
    cost = [generic(4), pip(white), pip(white)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            doForEachKind(
              value(power),
              domain = allOf(nominal(creature, post = [in(battlefield)])),
              number,
              choose(a(nominal(creature, post = [hasPower(equal, chosenNumber)])))),
            destroy(each(nominal(creature, post = [notChosen])))]))]})
