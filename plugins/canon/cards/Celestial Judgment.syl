card singleFaced({
    name = "Celestial Judgment",
    cost = [generic(4), pip(white), pip(white)],
    types = [sorcery],
    text = [
      spell(
        sequentially(
          steps = [
            doForEachKind(
              value(power),
              domain = allOf(isCreature),
              number,
              choose(a(and([isCreature, hasPower(equal, chosenNumber)])))),
            destroy(each(and([isCreature, notChosen])))]))]})
