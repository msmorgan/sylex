card singleFaced({
    name = "Promise of Bunrei",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    text = [
      when(
        does(actor(a(nominal(creature, post = [youControl]))), die),
        doIfDone(
          sacrifice(this(enchantment)),
          ifDid = create(4, written(creatureToken(1, 1, [], [spirit])))))]})
