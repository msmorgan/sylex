card flip(
  normal = {
    name = "Bushi Tenderfoot",
    cost = [pip(white)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      when(
        does(
          actor(
            a(
              and([
                  isCreature,
                  did(
                    actor(thisCreature),
                    dealDamage(recipient = which),
                    within(soFarThisTurn))]))),
          die),
        flip(thisCreature))],
    power = lit(1),
    toughness = lit(1)},
  alternative = {
    name = "Kenzo the Hardhearted",
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, samurai],
    text = [doubleStrike, bushido(lit(2))],
    power = lit(3),
    toughness = lit(4)})
