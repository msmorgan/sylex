card flip({
    name = "Bushi Tenderfoot",
    cost = [pip(white)],
    types = [creature],
    subtypes = [human, soldier],
    text = [
      when(
        does(
          actor(
            a(
              nominal(
                creature,
                post = [
                  did(
                    actor(this(creature)),
                    dealDamage(recipient = which),
                    within = within(soFarThisTurn))]))),
          die),
        flip(this(creature)))],
    power = 1,
    toughness = 1},
  {
    name = "Kenzo the Hardhearted",
    supertypes = [legendary],
    types = [creature],
    subtypes = [human, samurai],
    text = [doubleStrike, bushido(2)],
    power = 3,
    toughness = 4})
