card singleFaced({
    name = "Conqueror's Pledge",
    cost = [generic(2), pip(white), pip(white), pip(white)],
    types = [sorcery],
    text = [
      kicker(mana([generic(6)])),
      spell(
        replace(
          create(6, written(creatureToken(1, 1, [white], [kor, soldier]))),
          doIf(keywordCostPaid(kicker, this), instead(create(12, asThose)))))]})
