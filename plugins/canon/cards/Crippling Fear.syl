card {
  name = "Crippling Fear",
  cost = [generic(2), pip(black), pip(black)],
  types = [sorcery],
  text = [
    spell(
      sequentially([
          choose(a(quality(subtype(creature)))),
          get(
            allOf(and([isCreature, not(ofChosen(subtype(creature)))])),
            down(lit(3)),
            down(lit(3)),
            untilEndOfTurn)]))]
}
