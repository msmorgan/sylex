card singleFaced({
    name = "Crippling Fear",
    cost = [generic(2), pip(black), pip(black)],
    types = [sorcery],
    text = [
      spell(
        sequentially([
            choose(a(quality(subtype(creature)))),
            get(
              bare(nominal(creature, post = [thatIsnt(ofChosen(subtype(creature)))])),
              down(3),
              down(3),
              duration = untilEndOfTurn)]))]})
