card singleFaced({
    name = "Shrieking Affliction",
    cost = [pip(black)],
    types = [enchantment],
    text = [
      at(
        beginningOfPossessed(eachOpponent, upkeep),
        if = compareAmt(countOf(nominal(card, post = [in(handOf(that(player)))])), atMost, 1),
        instruct(they, loseLife(3)))]})
