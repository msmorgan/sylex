card singleFaced({
    name = "Shrieking Affliction",
    cost = [pip(black)],
    types = [enchantment],
    text = [
      at(
        beginningOfPossessed(eachOpponent, upkeep),
        if = compareAmt(countOf(cardIn(handOf(that(player)))), atMost, 1),
        action = instruct(they, loseLife(3)))]})
