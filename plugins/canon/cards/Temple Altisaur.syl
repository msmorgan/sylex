card singleFaced({
    name = "Temple Altisaur",
    cost = [generic(4), pip(white)],
    types = [creature],
    subtypes = [dinosaur],
    text = [
      static(
        replace(
          would(
            actor(a(source)),
            dealDamage(recipient = a(nominal(pre = [other], dinosaur, post = [youControl])))),
          instead(preventDamage(allBut(1)))))],
    power = 3,
    toughness = 4})
