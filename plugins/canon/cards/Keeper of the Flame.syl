card singleFaced({
    name = "Keeper of the Flame",
    cost = [pip(red), pip(red)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      activated(
        compound([mana([pip(red)]), tapSymbol]),
        sequentially([
            choose(
              target(
                nominal(
                  opponent,
                  post = [compare(greater, lifeTotalOf(you), [playerStat(lifeTotal)])])),
              when = whileDoing(does(actor(you), activate(this(ability))))),
            instruct(this(creature), dealDamage(amount = 2, recipient = that(player)))]))],
    power = 1,
    toughness = 2})
