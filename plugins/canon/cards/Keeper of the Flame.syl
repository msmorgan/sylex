card singleFaced({
    name = "Keeper of the Flame",
    cost = [pip(red), pip(red)],
    types = [creature],
    subtypes = [human, wizard],
    text = [
      activated(
        compound(costs = [mana([pip(red)]), tapSymbol]),
        sequentially(
          steps = [
            chooseWhile(
              target(
                and([
                    isOpponent,
                    compare(greater, lifeTotalOf(you), axes = [playerStat(lifeTotal)])])),
              whileDoing(does(actor(you), activate(thisAbility)))),
            instruct(thisCreature, dealDamage(amount = 2, recipient = that(player)))]))],
    power = 1,
    toughness = 2})
