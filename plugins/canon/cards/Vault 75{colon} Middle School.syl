card singleFaced({
    name = "Vault 75: Middle School",
    cost = [generic(2), pip(white), pip(white)],
    types = [enchantment],
    subtypes = [saga],
    text = [
      when(chapterMark(chapters = [1]), exile(allOf(and([isCreature, hasPower(atLeast, 4)])))),
      when(
        chapterMark(chapters = [2, 3]),
        putCounters(1, printedKind(p1p1Counter), each(and([isCreature, youControl]))))]})
