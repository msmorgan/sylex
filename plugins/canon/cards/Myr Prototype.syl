card {
  name = "Myr Prototype",
  cost = [generic(5)],
  types = [artifact, creature],
  subtypes = [myr],
  text = [
    at(beginningOfYour(upkeep), putCounters(lit(1), printedKind(p1p1Counter), thisCreature)),
    static(
      conjunction([
          gatedBy(
            scaledGenericMana(times(lit(1), countersOn(p1p1Counter, it))),
            actor(thisCreature),
            attack),
          gatedBy(
            scaledGenericMana(times(lit(1), countersOn(p1p1Counter, it))),
            actor(thisCreature),
            block)]))],
  power = lit(2),
  toughness = lit(2)
}
