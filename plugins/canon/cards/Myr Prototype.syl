card singleFaced({
    name = "Myr Prototype",
    cost = [generic(5)],
    types = [artifact, creature],
    subtypes = [myr],
    text = [
      at(beginningOfYour(upkeep), putCounters(1, printedKind(p1p1Counter), this(creature))),
      static(
        conjunction([
            gatedBy(
              actor(this(creature)),
              attack,
              scaledGenericMana(times(1, countersOn(p1p1Counter, it)))),
            gatedBy(
              actor(this(creature)),
              block,
              scaledGenericMana(times(1, countersOn(p1p1Counter, it))))]))],
    power = 2,
    toughness = 2})
