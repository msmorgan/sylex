card singleFaced({
    name = "Propaganda",
    cost = [generic(2), pip(blue)],
    types = [enchantment],
    text = [
      static(
        gatedBy(
          scaledGenericMana(
            forEach(
              2,
              and([isCreature, controlledBy(they), inCombat(attackerOf, counterpart = you)]))),
          actor(allOf(isCreature)),
          attack(defender = you)))]})
