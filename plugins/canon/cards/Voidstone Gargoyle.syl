card singleFaced({
    name = "Voidstone Gargoyle",
    cost = [generic(3), pip(white), pip(white)],
    types = [creature],
    subtypes = [gargoyle],
    text = [
      flying,
      static(entersChoosingFrom(thisCreature, cardName, nameOfCard(non(hasType(land))))),
      static(cant(any, cast(bare(nominal(spell, post = [named(chosenName)]))))),
      static(
        cant(
          any,
          activate(
            allOf(
              nominal(
                abilityHead(anyActivated),
                post = [ofSource(allOf(nominal(source, post = [named(chosenName)])))])))))],
    power = 3,
    toughness = 3})
