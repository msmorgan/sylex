card singleFaced({
    name = "Answered Prayers",
    cost = [generic(1), pip(white), pip(white)],
    types = [enchantment],
    text = [
      when(
        does(actor(a(nominal(creature, post = [youControl]))), enter),
        sequentially([
            gainLife(1),
            doIf(
              not(is(thisEnchantment, noun(a(creature)))),
              become(
                it,
                {
                  characteristics = {
                    types = [creature],
                    subtypes = [angel],
                    text = [flying],
                    power = 3,
                    toughness = 3}},
                duration = untilEndOfTurn))]))]})
