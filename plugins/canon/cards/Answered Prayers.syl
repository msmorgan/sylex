card {
  name = "Answered Prayers",
  cost = [generic(1), pip(white), pip(white)],
  types = [enchantment],
  text = [
    when(
      does(actor(a(and([isCreature, youControl]))), enter),
      sequentially([
          gainLife(lit(1)),
          doIf(
            not(is(thisEnchantment, isCreature)),
            become(
              thisEnchantment,
              {
                characteristics = {
                  types = [creature],
                  subtypes = [angel],
                  text = [flying],
                  power = lit(3),
                  toughness = lit(3)}},
              untilEndOfTurn))]))]
}
