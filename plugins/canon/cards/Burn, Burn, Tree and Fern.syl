card singleFaced({
    name = "Burn, Burn, Tree and Fern",
    cost = [generic(3), pip(red)],
    types = [enchantment],
    subtypes = [saga],
    text = [
      when(
        chapterMark([1]),
        instruct(
          this,
          dealDamage(
            amount = 6,
            recipient = target(nominal(creature, post = [anOpponentControls]))))),
      when(chapterMark([2]), destroy(target(nominal(artifact, post = [anOpponentControls])))),
      when(chapterMark([3, 4]), addMana(symbols([pip(red)])))]})
