card singleFaced({
    name = "Burn, Burn, Tree and Fern",
    cost = [generic(3), pip(red)],
    types = [enchantment],
    subtypes = [saga],
    text = [
      when(
        chapterMark(chapters = [1]),
        instruct(
          this,
          dealDamage(amount = 6, recipient = target(and([isCreature, anOpponentControls]))))),
      when(chapterMark(chapters = [2]), destroy(target(and([isArtifact, anOpponentControls])))),
      when(chapterMark(chapters = [3, 4]), addMana(symbols([pip(red)])))]})
