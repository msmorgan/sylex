card {
  name = "Archfiend's Vessel",
  cost = [pip(black)],
  types = [creature],
  subtypes = [human, cleric],
  text = [
    lifelink,
    when(
      does(actor(thisCreature), enter),
      if = or([
          did(actor(it), enter(from = yourGraveyard), triggering),
          is(it, did(actor(you), cast(which, from = yourGraveyard), thisObject))]),
      action = doIfDone(
        exile(it),
        create(
          lit(1),
          written({
              characteristics = {
                colors = [black],
                types = [creature],
                subtypes = [demon],
                text = [flying],
                power = lit(5),
                toughness = lit(5)}}))))],
  power = lit(1),
  toughness = lit(1)
}
