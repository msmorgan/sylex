card singleFaced({
    name = "Archfiend's Vessel",
    cost = [pip(black)],
    types = [creature],
    subtypes = [human, cleric],
    text = [
      lifelink,
      when(
        does(actor(thisCreature), enter),
        if = or([
            did(actor(it), enter(from = yourGraveyard), triggering),
            is(it, did(actor(you), cast(which, from = yourGraveyard), within = thisObject))]),
        doIfDone(
          exile(it),
          ifDid = create(
            1,
            written({
                characteristics = {
                  colors = [black],
                  types = [creature],
                  subtypes = [demon],
                  text = [flying],
                  power = 5,
                  toughness = 5}}))))],
    power = 1,
    toughness = 1})
