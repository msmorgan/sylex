card singleFaced({
    name = "Undercover Butler",
    cost = [generic(2), hybridPip(blue, black)],
    types = [creature],
    subtypes = [human, rogue],
    text = [
      whenever(
        does(
          actor(thisCreature),
          attack(defender = a(and([isPlayer, superlative(max, playerStat(lifeTotal), isPlayer)])))),
        establishThroughout(cant(any, block(attacker = it)), thisTurn))],
    power = 2,
    toughness = 3})
