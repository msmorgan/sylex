card singleFaced({
    name = "Undercover Butler",
    cost = [generic(2), hybridPip(blue, black)],
    types = [creature],
    subtypes = [human, rogue],
    text = [
      whenever(
        does(
          actor(thisCreature),
          attack(
            defender = a(
              nominal(player, post = [superlative(max, playerStat(lifeTotal), player)])))),
        establishThroughout(cant(any, block(attacker = it)), thisTurn))],
    power = 2,
    toughness = 3})
