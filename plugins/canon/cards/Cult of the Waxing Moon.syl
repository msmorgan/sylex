card singleFaced({
    name = "Cult of the Waxing Moon",
    cost = [generic(4), pip(green)],
    types = [creature],
    subtypes = [human, shaman],
    text = [
      whenever(
        does(
          any,
          transform(
            a(and([isPermanent, youControl])),
            into = and([isCreature, not(hasSubtype(human))]))),
        create(1, written(creatureToken(2, 2, [green], [wolf]))))],
    power = 5,
    toughness = 4})
