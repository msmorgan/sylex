card singleFaced({
    name = "Banishing Light",
    cost = [generic(2), pip(white)],
    types = [enchantment],
    text = [
      when(
        does(actor(this(enchantment)), enter),
        exileUntil(
          target(nominal(pre = [non(land)], permanent, post = [anOpponentControls])),
          does(actor(this(enchantment)), leave)))]})
