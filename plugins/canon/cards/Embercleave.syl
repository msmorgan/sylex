card singleFaced({
    name = "Embercleave",
    cost = [generic(4), pip(red), pip(red)],
    supertypes = [legendary],
    types = [artifact],
    subtypes = [equipment],
    text = [
      flash,
      static(
        costShift(
          this,
          less(forEach(1, nominal(pre = [attacking], creature, post = [youControl]))))),
      when(
        does(actor(ownName), enter),
        attachTo(it, target(nominal(creature, post = [youControl])))),
      static(
        conjunction([
            getsPt(equipped(creature), up(1), up(1)),
            abilityGrant(equipped(creature), [doubleStrike, trample])],
          subject = equipped(creature))),
      equip(mana([generic(3)]))]})
