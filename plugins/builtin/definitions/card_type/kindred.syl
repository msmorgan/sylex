# Kindred: neither a permanent type nor an instant or sorcery type. A kindred card always has
# another card type, and is cast and resolves by it [CR#308.1], so the other type settles
# whether it can be a permanent [CR#110.4].
#
# [CR#308.1] A kindred card is cast and resolves by its other card type, so kindred confers
# nothing of its own.
card_type kindred {
  lexical = {lemma = "kindred"},
  spelling = "kindred",
  name = "Kindred",
  permanentType = false
}
