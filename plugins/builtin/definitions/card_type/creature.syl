# Creature: a permanent type [CR#110.4], whose objects alone have power and toughness
# [CR#302.4].
#
# [CR#302.1] A creature card may be cast from its owner's hand as a sorcery; [CR#508.1a] a
# creature is a Combatant, a quality and not an ability [CR#113.12]; it can attack and block
# [CR#302.5], but neither attacks nor activates an ability with {T} or {Q} in its cost unless its
# controller has controlled it continuously since their most recent turn began [CR#302.6]; damage
# dealt to it is marked on it [CR#120.3e]; and the toughness and lethal-damage state-based actions
# apply to it [CR#704.5f,704.5g].
card_type creature {
  lexical = {lemma = "creature"},
  spelling = "creature",
  name = "Creature",
  permanentType = true,
  stats = [power, toughness],
  confers = [
    castableFrom(yourHand, asSorcery),
    property(combatant(this(creature))),
    property(can(actor(this(creature)), attack)),
    property(can(actor(this(creature)), block)),
    property(cant(actor(this(creature)), attack, unless = controlledSinceTheirTurnBegan(it))),
    property(
      cant(
        any,
        activate(
          possessive(
            this(creature),
            nominal(abilityHead(anyActivated), post = [tapOrUntapInCost]))),
        unless = controlledSinceTheirTurnBegan(this(creature)))),
    damageResult(creature, markDamage(amount = thatMuch, this(creature))),
    stateBased(compareAmt(toughnessOf(this(creature)), atMost, 0), putInto(it, graveyard)),
    stateBased(
      and([
          compareAmt(toughnessOf(this(creature)), greater, 0),
          compareAmt(statOf(markedDamage, it), greater, 0),
          compareAmt(statOf(markedDamage, it), atLeast, toughnessOf(it))]),
      destroy(this(creature)))]
}
