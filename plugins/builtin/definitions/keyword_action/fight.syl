# "<creature> fights <creature>" (`Definition`, [CR#701.14a]).
action fight(other: NounPhrase) {
  lexical = {verbs = [{lemma = "fight", past = "fought", frames = [Monotransitive, Intransitive]}]},
  permanent = performs,
  spelling = "fight <other>",
  body = doIf(
    and([is($other, isCreature), is(actor, isCreature)]),
    simultaneously([
        dealDamage(statOf(stat(power), actor), $other),
        instruct($other, dealDamage(statOf(stat(power), $other), actor))]))
}
