# "<creature> fights <creature>" (`Definition`, [CR#701.14a]).
action fight(other: NounPhrase) {
  lexical = {verbs = [{lemma = "fight", past = "fought", frames = [Monotransitive, Intransitive]}]},
  permanent = performs,
  spelling = "fight <other>",
  body = doIf(
    and(conjuncts = [is($other, isCreature), is(actor, isCreature)]),
    simultaneously(
      steps = [
        dealDamage(amount = statOf(stat(power), actor), recipient = $other),
        instruct($other, dealDamage(amount = statOf(stat(power), $other), recipient = actor))]))
}
