# Recruit: draw a card, then discard a card; if you discarded a nonland card, create a 1/1 white
# Human Soldier creature token. [CR#701.70a]
action recruit {
  lexical = {verbs = [{lemma = "recruit", frames = [Intransitive]}]},
  spelling = "recruit",
  body = sequentially([
      draw(1),
      discard(a(nominal(card, post = [in(handOf($actor))]))),
      doIf(
        not(is(the(nominal(card, post = [was(discard(which), within = thisWay)])), noun(a(land)))),
        create(1, written(creatureToken(1, 1, [white], [human, soldier]))))])
}
