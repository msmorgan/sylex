# "<performer> incubates N" (`Definition`, [CR#701.53a,701.53b]).
action incubate(amount: Amount) {
  lexical = {verbs = [{lemma = "incubate", frames = [Amount]}]},
  spelling = "incubate <amount>",
  body = create(
    1,
    defined(incubatorToken),
    riders = [withCounters($amount, printedKind(p1p1Counter), fresh)])
}
