# "<performer> incubates N" (`Definition`, [CR#701.53a,701.53b]).
action incubate(amount: Amount) {
  lexical = {verbs = [{lemma = "incubate", frames = [Amount]}]},
  spelling = "incubate <amount>",
  body = create(
    1,
    doubleFaced({
        characteristics = {
          types = [artifact],
          subtypes = [incubator],
          text = [activated(mana([generic(2)]), transform(this))]}},
      {
        characteristics = {
          name = "Phyrexian Token",
          types = [artifact, creature],
          subtypes = [phyrexian],
          power = 0,
          toughness = 0}}),
    [withCounters($amount, printedKind(p1p1Counter), fresh)])
}
