# "time travel" [CR#701.56a]: any number of permanents the performer controls with time counters
# and/or suspended cards they own in exile with time counters, a suspended card being one in exile
# that has suspend and a time counter [CR#702.62b]; for each, put or remove a time counter
# (`Definition`).
action timeTravel {
  lexical = {verbs = [{lemma = "time travel", frames = [Intransitive]}]},
  spelling = "time travel",
  body = sequentially([
      choose(
        counted(
          anyNumber,
          andOr([
              nominal(permanent, post = [actorControls, withCounter(kind = timeCounter)]),
              nominal(
                card,
                post = [
                  in(exileZone),
                  ownedBy($actor),
                  withKeyword(theKeyword(suspend)),
                  withCounter(kind = timeCounter)])]))),
      doForEach(
        eachOf(them),
        chooseOne(
          putCounters(1, printedKind(timeCounter), it),
          removeCounters(exactly(1), printedKind(timeCounter), it)))])
}
