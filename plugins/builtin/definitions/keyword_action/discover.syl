# "<performer> discovers N" (`Definition`, [CR#701.57a]).
action discover(amount: Amount) {
  lexical = {verbs = [{lemma = "discover", frames = [Amount, Intransitive]}]},
  spelling = "discover <amount>",
  body = sequentially(
    steps = [
      exile(
        run(
          top,
          and([non(isLand), compare(atMost, $amount, axes = [stat(manaValue)])]),
          libraryOf(actor))),
      withContinuation(
        optional,
        cast(
          that(card),
          resulting = compare(atMost, $amount, axes = [stat(manaValue)]),
          altCost = withoutPaying),
        ifNot = putInto(that(card), hand)),
      move(theRest, anywhere, onBottom, [inOrder(randomOrder)])])
}
