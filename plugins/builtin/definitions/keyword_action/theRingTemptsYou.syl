# "The Ring tempts you": the Ring emblem if you have none, then you choose a creature you
# control as your Ring-bearer (`Definition`, [CR#701.54a,701.54c]). The emblem's abilities count
# the times the Ring has tempted you by the deed's own steps, the choice and the designation.
action theRingTemptsYou {
  lexical = {verbs = [{lemma = "tempt", frames = [Monotransitive]}], nouns = ["Ring"]},
  spelling = "The Ring tempts you",
  body = sequentially(
    steps = [
      doIf(
        not(exists(and([isEmblem, named(printedName("The Ring")), ownedBy(actor)]))),
        getNamedEmblem(
          "The Ring",
          [
            static(
              characteristicChange(
                allOf(and([hasDesignation(ringBearer), youControl])),
                edits = [typeLine(adds, {supertypes = [legendary]})])),
            static(
              cant(
                by(
                  allOf(
                    and([
                        isCreature,
                        hasPower(
                          greater,
                          powerOf(a(and([hasDesignation(ringBearer), youControl]))))]))),
                block(attacker = allOf(and([hasDesignation(ringBearer), youControl]))))),
            static(
              asLongAs(
                compareAmt(
                  eventCount(
                    ownScope(
                      theRingTemptsYou,
                      sequentially(
                        steps = [
                          choose(a(and([isCreature, actorControls]))),
                          gainDesignation(that(creature), ringBearer)])),
                    actor(you),
                    thisGame),
                  atLeast,
                  2),
                abilityGrant(
                  this,
                  [
                    whenever(
                      does(actor(a(and([hasDesignation(ringBearer), youControl]))), attack),
                      sequentially(steps = [draw(1), discard(a(cardIn(hand)))]))]))),
            static(
              asLongAs(
                compareAmt(
                  eventCount(
                    ownScope(
                      theRingTemptsYou,
                      sequentially(
                        steps = [
                          choose(a(and([isCreature, actorControls]))),
                          gainDesignation(that(creature), ringBearer)])),
                    actor(you),
                    thisGame),
                  atLeast,
                  3),
                abilityGrant(
                  this,
                  [
                    whenever(
                      does(
                        by(a(isCreature)),
                        block(attacker = a(and([hasDesignation(ringBearer), youControl])))),
                      atNext(endOfCombat, controllerSacrifices(that(creature))))]))),
            static(
              asLongAs(
                compareAmt(
                  eventCount(
                    ownScope(
                      theRingTemptsYou,
                      sequentially(
                        steps = [
                          choose(a(and([isCreature, actorControls]))),
                          gainDesignation(that(creature), ringBearer)])),
                    actor(you),
                    thisGame),
                  atLeast,
                  4),
                abilityGrant(
                  this,
                  [
                    whenever(
                      does(
                        actor(a(and([hasDesignation(ringBearer), youControl]))),
                        dealDamage(recipient = a(isPlayer), kind = combat)),
                      instruct(eachOpponent, loseLife(3)))])))])),
      choose(a(and([isCreature, actorControls]))),
      gainDesignation(that(creature), ringBearer)])
}

# Temporary: this primitive builds `Action.ownScope`, which `.syl` may not write
# (`docs/decisions/syl.md` §4). Only this file may use it, through the validator's Ring exception
# (`crates/xtask/src/dsl_check/schema.rs`); `syl-ring-tempts-you-raw-scope` deletes it.
primitive ownScope(deed: Option(Deed), body: Action): Action = OwnScope
