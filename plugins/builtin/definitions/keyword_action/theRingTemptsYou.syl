# "The Ring tempts you": the Ring emblem if you have none, then you choose a creature you
# control as your Ring-bearer (`Definition`, [CR#701.54a,701.54c]). The emblem's abilities count
# the times the Ring has tempted you by the deed's own steps, the choice and the designation.
action theRingTemptsYou {
  lexical = {verbs = [{lemma = "tempt", frames = [Monotransitive]}], nouns = ["Ring"]},
  spelling = "The Ring tempts you",
  body = sequentially([
      doIf(
        not(exists(nominal(emblem, post = [named(printedName("The Ring")), ownedBy($actor)]))),
        getEmblem(
          name = "The Ring",
          [
            static(
              characteristicChange(
                allOf(nominal(permanent, post = [hasDesignation(ringBearer), youControl])),
                [typeLine(adds, {supertypes = [legendary]})])),
            static(
              cant(
                by(
                  bare(
                    nominal(
                      creature,
                      post = [
                        hasPower(
                          greater,
                          powerOf(
                            a(
                              nominal(
                                permanent,
                                post = [hasDesignation(ringBearer), youControl]))))]))),
                block(
                  attacker = allOf(
                    nominal(permanent, post = [hasDesignation(ringBearer), youControl]))))),
            static(
              asLongAs(
                compareAmt(
                  eventCount(
                    actor(you),
                    ownScope(
                      theRingTemptsYou,
                      sequentially([
                          choose(a(nominal(creature, post = [actorControls]))),
                          gainDesignation(that(creature), ringBearer)])),
                    thisGame),
                  atLeast,
                  2),
                abilityGrant(
                  it,
                  [
                    whenever(
                      does(
                        actor(
                          a(nominal(permanent, post = [hasDesignation(ringBearer), youControl]))),
                        attack),
                      sequentially([draw(1), discard(a(nominal(card, post = [in(hand)])))]))]))),
            static(
              asLongAs(
                compareAmt(
                  eventCount(
                    actor(you),
                    ownScope(
                      theRingTemptsYou,
                      sequentially([
                          choose(a(nominal(creature, post = [actorControls]))),
                          gainDesignation(that(creature), ringBearer)])),
                    thisGame),
                  atLeast,
                  3),
                abilityGrant(
                  it,
                  [
                    whenever(
                      does(
                        by(a(creature)),
                        block(
                          attacker = a(
                            nominal(permanent, post = [hasDesignation(ringBearer), youControl])))),
                      atNext(endOfCombat, controllerSacrifices(that(creature))))]))),
            static(
              asLongAs(
                compareAmt(
                  eventCount(
                    actor(you),
                    ownScope(
                      theRingTemptsYou,
                      sequentially([
                          choose(a(nominal(creature, post = [actorControls]))),
                          gainDesignation(that(creature), ringBearer)])),
                    thisGame),
                  atLeast,
                  4),
                abilityGrant(
                  it,
                  [
                    whenever(
                      does(
                        actor(
                          a(nominal(permanent, post = [hasDesignation(ringBearer), youControl]))),
                        dealDamage(kind = combat, recipient = a(player))),
                      instruct(eachOpponent, loseLife(3)))])))])),
      choose(a(nominal(creature, post = [actorControls]))),
      gainDesignation(that(creature), ringBearer)])
}

# Temporary: this primitive builds `VerbPhrase.ownScope`, which `.syl` may not write
# (`docs/design/syl.md` §4). Only this file may use it, through the validator's Ring exception
# (`crates/xtask/src/dsl_check/schema.rs`); `syl-ring-tempts-you-raw-scope` deletes it.
primitive ownScope(deed: Option(Deed), body: VerbPhrase): VerbPhrase = OwnScope
