# "Starting with <first>, vote for <ballot>" (`Definition`, [CR#701.38]).
action voteStartingWith(first: NounPhrase, disclosure: Disclosure = openly, ballot: Ballot) {
  lexical = {verbs = [{lemma = "vote", frames = [Prepositional(["for"]), Intransitive]}]},
  spelling = "starting with $first, <$disclosure >vote $ballot",
  deed = "vote",
  body = castVote($first, $disclosure, $ballot, none)
}
