# "<performer> explores" (`Definition`, [CR#701.44a]).
action explore {
  lexical = {verbs = [{lemma = "explore", frames = [Intransitive, Monotransitive]}]},
  permanent = performs,
  spelling = "explore",
  body = instruct(
    controllerOf(actor),
    sequentially([
        reveal(slice(top, 1, libraryOf(actor))),
        doIf(
          is(that(card), isLand),
          putInto(that(card), zone(hand, ownerOf(that(card)))),
          otherwise = sequentially([
              putCounters(1, printedKind(p1p1Counter), actor),
              may(putInto(that(card), graveyard))]))]))
}
