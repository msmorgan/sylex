# "assimilate <subject>": the performer gains control of a permanent and puts a +1/+1 counter on
# it, and it becomes a Borg artifact creature [CR#701.72a]; or the performer puts a permanent card
# from another zone onto the battlefield under their control with a +1/+1 counter on it, and it's
# a Borg artifact creature [CR#701.72b], which applies as it enters, not after [CR#611.2e]. A
# "Borg artifact creature" keeps its other card types and its subtypes other than creature types,
# while Borg replaces its creature types [CR#205.1b]: artifact and creature are added, and Borg is
# set as its creature type [CR#205.1a].
action assimilate(subject: NounPhrase) {
  lexical = {verbs = [{lemma = "assimilate", frames = [Monotransitive]}]},
  spelling = "assimilate <subject>",
  body = doIf(
    is($subject, in(battlefield)),
    sequentially([
        gainControl($subject),
        putCounters(1, printedKind(p1p1Counter), $subject),
        establish(
          characteristicChange(
            $subject,
            [
              typeLine(adds, {types = [artifact, creature]}),
              typeLine(sets, {subtypes = [borg]})]))]),
    otherwise = move(
      $subject,
      anywhere,
      battlefield,
      [
        under(actor),
        withCounters(1, printedKind(p1p1Counter), fresh),
        withCharacteristicEdits(
          [typeLine(adds, {types = [artifact, creature]}), typeLine(sets, {subtypes = [borg]})])]))
}
