# "transform <subject> [into <face>]" (`Definition`, [CR#701.27]): `into` is what a "transforms
# into" trigger watches, a characteristic the object has immediately after [CR#701.27f].
action transform(subject: NounPhrase, into: Option(Predicate) = none) {
  # TODO(spelling): Include or omit the clauses supplied by into.
  lexical = {
    verbs = [
      {lemma = "transform", frames = [Monotransitive, Intransitive, Prepositional(["into"])]}],
    adjectives = ["transformed"]},
  body = turnOver($subject, into = $into)
}
