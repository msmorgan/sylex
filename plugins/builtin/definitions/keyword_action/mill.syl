# "<performer> mills <amount> cards": from the performer's own library (`Definition`,
# [CR#701.17a]).
action mill(amount: Amount) {
  spelling = "mill <amount> cards",
  lexical = {verbs = [{lemma = "mill", frames = [Monotransitive]}]},
  body = move(slice(top, $amount, libraryOf(actor)), zone(library, none), graveyard, [])
}
