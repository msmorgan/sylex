# Bolster N: choose a creature you control with the least toughness among creatures you control
# and put N +1/+1 counters on it. [CR#701.39a]
action bolster(amount: Amount) {
  lexical = {verbs = [{lemma = "bolster", frames = [Amount]}]},
  spelling = "bolster $amount",
  body = sequentially([
      choose(
        a(
          nominal(
            creature,
            post = [
              actorControls,
              superlative(min, stat(toughness), nominal(creature, post = [actorControls]))]))),
      putCounters($amount, printedKind(p1p1Counter), that(creature))])
}
