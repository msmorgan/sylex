# "Airbend <subject>" (`Definition`, [CR#701.65a]): per-card `doForEach` loop over
# `allOf(nominal(card, post = [was(exile(which), within = thisWay)]))` where `it` resolves to the
# singular loop referent.
action airbend(subject: NounPhrase) {
  lexical = {
    verbs = [{lemma = "airbend", past = "airbent", frames = [Monotransitive, Intransitive]}]},
  spelling = "airbend $subject",
  body = sequentially([
      exile($subject),
      doForEach(
        allOf(nominal(card, post = [was(exile(which), within = thisWay)])),
        instruct(
          ownerOf(it),
          establish(
            can(
              actor(ownerOf(it)),
              cast(it, from = exileZone, altCost = payingInstead(mana([generic(2)])))),
            duration = forAsLongAs(is(it, in(exileZone))))))])
}
