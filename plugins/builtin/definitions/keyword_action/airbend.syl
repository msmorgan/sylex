# "Airbend <subject>" (`Definition`, [CR#701.65a]): exiles `subject`, then for each card exiled
# this way (`each(nominal(card, post = [was(exile(which), within = thisWay)]))`), its owner may
# cast it by paying {2} for as long as it remains exiled.
action airbend(subject: NounPhrase) {
  lexical = {
    verbs = [{lemma = "airbend", past = "airbent", frames = [Monotransitive, Intransitive]}]},
  spelling = "airbend $subject",
  body = sequentially([
      exile($subject),
      doForEach(
        each(nominal(card, post = [was(exile(which), within = thisWay)])),
        instruct(
          ownerOf(it),
          establish(
            can(
              actor(ownerOf(it)),
              cast(it, from = exileZone, altCost = payingInstead(mana([generic(2)])))),
            duration = forAsLongAs(is(it, in(exileZone))))))])
}
