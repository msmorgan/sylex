# Populate: choose a creature token you control and create a token that is a copy of it.
# [CR#701.36a]
action populate {
  lexical = {verbs = [{lemma = "populate", frames = [Intransitive]}]},
  spelling = "populate",
  body = sequentially([
      choose(a(and([isToken, isCreature, isPermanent, actorControls]))),
      create(1, copyOf(thatToken))])
}
