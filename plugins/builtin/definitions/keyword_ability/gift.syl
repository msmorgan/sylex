# Gift represents two abilities. The first is "As an additional cost to cast this spell, you may
# choose an opponent." [CR#702.174a] The second is "When this permanent enters, if its gift cost
# was paid, [effect]" on a permanent, and "If this spell’s gift cost was paid, [effect]" on an
# instant or sorcery spell. [CR#702.174b]
ability gift(promise: VerbPhrase) {
  lexical = {lemma = "gift", parameters = [[Quality(None)]], nouns = ["gift"]},
  # TODO(spelling): Naming the promised gift's noun phrase rather than its action clause waits on
  # `syl-dead-weight-sweep` (each gift phrasing currently has its own `gift*` Template).
  body = [
    static(addedCost(this(spell), optional, plusAdditional(perform(choose(anOpponent))))),
    ifPermanentType(
      when(
        does(actor(this(permanent)), enter),
        if = keywordCostPaid(it, gift),
        instruct(the(nominal(pre = [chosen], player)), $promise)),
      spell(
        doIf(
          keywordCostPaid(this(spell), gift),
          instruct(the(nominal(pre = [chosen], player)), $promise))))]
}
