# Ascend grants the city’s blessing for the rest of the game if you control ten or more permanents
# and do not already have it: a spell ability on an instant or sorcery spell [CR#702.131a], and a
# static ability on a permanent [CR#702.131b].
ability ascend {
  lexical = {lemma = "ascend"},
  spelling = "ascend",
  body = [
    ifPermanentType(
      static(
        whileHolds(
          and([
              compareAmt(countOf(and([isPermanent, youControl])), atLeast, lit(10)),
              not(is(you, hasDesignation(citysBlessing)))]),
          gainDesignation(you, citysBlessing, restOfGame))),
      spell(
        doIf(
          and([
              compareAmt(countOf(and([isPermanent, youControl])), atLeast, lit(10)),
              not(is(you, hasDesignation(citysBlessing)))]),
          gainDesignation(you, citysBlessing, restOfGame))))]
}
