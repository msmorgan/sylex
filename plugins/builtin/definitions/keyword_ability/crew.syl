# "Crew N" means "Tap any number of other untapped creatures you control with total power N or
# greater: This permanent becomes an artifact creature until end of turn." [CR#702.122a]
ability crew(amount: Amount) {
  lexical = {
    lemma = "crew",
    parameters = [[Amount]],
    verbs = [{lemma = "crew", frames = [Monotransitive]}]},
  spelling = "crew <amount>",
  body = [
    activated(
      perform(
        tap(
          withTotal(
            stat(power),
            atLeast,
            $amount,
            allOf(and([isUntapped, and([isCreature, youControl, isOther])]))))),
      establishThroughout(
        characteristicChange(thisPermanent, [typeLine(adds, {types = [artifact, creature]})]),
        untilEndOfTurn))]
}
