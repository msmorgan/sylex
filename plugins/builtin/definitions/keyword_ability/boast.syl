# "Boast — [Cost]: [Effect]" means "[Cost]: [Effect]. Activate only if this creature attacked this
# turn and only once each turn." [CR#702.142a]
ability boast(ability: Ability) {
  lexical = {
    lemma = "boast",
    parameters = [[DashAbility]],
    verbs = [{lemma = "boast", frames = [Intransitive]}]},
  spelling = "boast — <ability>",
  body = [
    qualified(
      $ability,
      limit = oncePerTurn,
      guard = is(thisCreature, did(actor(which), attack, within = within(soFarThisTurn))))]
}
