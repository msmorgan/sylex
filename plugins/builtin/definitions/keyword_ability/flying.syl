# "Flying" with its definition, a static ability: "This creature can't be blocked except by
# creatures with flying and/or reach." [CR#702.9b]
ability flying {
  lexical = {lemma = "flying"},
  spelling = "flying",
  body = [
    static(
      cant(
        any,
        block(attacker = thisCreature),
        except = byObjects(
          bare(
            nominal(
              creature,
              post = [andOr([hasKeyword(theKeyword(flying)), hasKeyword(theKeyword(reach))])])))))]
}
