# "Modular N" with its definition, a static ability and a triggered one [CR#702.43a].
ability modular(count: Amount) {
  lexical = {lemma = "modular", parameters = [[Amount], [DashKeyword]]},
  spelling = "modular $count",
  body = [
    static(entersWithCounters(this(permanent), $count, p1p1Counter)),
    when(
      does(actor(this(permanent)), die),
      may(
        putCounters(
          countersOn(p1p1Counter, this(permanent)),
          printedKind(p1p1Counter),
          target(nominal(pre = [artifact], creature)))))]
}
