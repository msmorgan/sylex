# "Battle cry" means "Whenever this creature attacks, each other attacking creature gets +1/+0
# until end of turn." [CR#702.91a]
ability battleCry {
  lexical = {lemma = "battle cry"},
  spelling = "battle cry",
  body = [
    whenever(
      does(actor(this(creature)), attack),
      establishThroughout(
        getsPt(each(nominal(pre = [other, attacking], creature)), up(1), up(0)),
        untilEndOfTurn))]
}
