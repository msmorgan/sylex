# "Flashback [cost]": "You may cast this card from your graveyard if the resulting spell is an
# instant or sorcery spell by paying [cost] rather than paying its mana cost" and "If the flashback
# cost was paid, exile this card instead of putting it anywhere else any time it would leave the
# stack" [CR#702.34a].
ability flashback(cost: Cost) {
  lexical = {lemma = "flashback", parameters = [[Cost]]},
  spelling = "flashback <cost>",
  body = [
    static(
      can(
        actor(you),
        cast(
          this,
          from = yourGraveyard,
          resulting = isInstantOrSorcery,
          altCost = payingInstead($cost)))),
    static(
      replace(
        would(actor(thisSpell), leave(from = stack)),
        doIf(keywordCostPaid(flashback, thisSpell), instead(exile(thisSpell)))))]
}
