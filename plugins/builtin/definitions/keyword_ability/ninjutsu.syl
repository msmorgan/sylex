# The Ninja enters attacking what the returned creature was attacking [CR#702.49c].
ability ninjutsu(cost: Cost) {
  lexical = {
    lemma = "ninjutsu",
    parameters = [[Cost]],
    variants = [{lemma = "commander ninjutsu", parameters = [[Cost]]}]},
  spelling = "ninjutsu $cost",
  body = [
    activated(
      compound([
          $cost,
          perform(reveal(this(card))),
          perform(
            returnToHand(
              a(nominal(pre = [unblocked, attacking], creature, post = [youControl]))))]),
      putOntoBattlefieldTappedAttacking(
        this(card),
        from = yourHand,
        defender = the(
          nominal(
            or([player, planeswalker, battle]),
            post = [
              inCombat(
                attackedBy,
                counterpart = the(nominal(pre = [was(returnToHand(which))], creature)))]))))]
}
