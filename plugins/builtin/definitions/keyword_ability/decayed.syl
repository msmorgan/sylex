# "Decayed" means "This creature can't block" and "When this creature attacks, sacrifice it at end
# of combat." [CR#702.147a]
ability decayed {
  lexical = {lemma = "decayed"},
  spelling = "decayed",
  body = [
    static(cant(actor(this(creature)), block)),
    when(does(actor(this(creature)), attack), atNext(endOfCombat, sacrifice(this(permanent))))]
}
