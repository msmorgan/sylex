# "Split second" means "As long as this spell is on the stack, players can't cast other spells or
# activate abilities that aren't mana abilities." [CR#702.61a]
ability splitSecond {
  lexical = {lemma = "split second"},
  spelling = "split second",
  body = [
    static(
      asLongAs(
        is(this(spell), in(stack)),
        conjunction([
            cant(actor(bare(player)), cast(bare(nominal(pre = [other], spell)))),
            cant(
              actor(bare(player)),
              activate(
                bare(
                  nominal(pre = [non(hasQuality(isManaAbility))], abilityHead(anyActivated)))))])))]
}
