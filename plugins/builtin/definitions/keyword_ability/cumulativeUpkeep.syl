# "Cumulative upkeep [cost]" with its reminder text [CR#702.24a].
ability cumulativeUpkeep(cost: Cost) {
  lexical = {
    lemma = "cumulative upkeep",
    parameters = [[Cost]],
    nouns = [{lemma = "cumulative upkeep", countability = [Mass]}]},
  spelling = "cumulative upkeep $cost",
  body = [
    at(
      beginningOfYour(upkeep),
      if = is(this(permanent), noun(a(permanent))),
      sequentially([
          putCounters(1, printedKind(ageCounter), this(permanent)),
          doUnlessKeywordCost(
            sacrifice(this(permanent)),
            this(permanent),
            cumulativeUpkeep,
            scaled($cost, times(1, countersOn(ageCounter, this(permanent)))))]))]
}
