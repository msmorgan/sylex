# "Cascade" with its reminder text [CR#702.85a].
ability cascade {
  lexical = {lemma = "cascade", verbs = [{lemma = "cascade", frames = [Intransitive]}]},
  spelling = "cascade",
  body = [
    when(
      does(actor(you), cast(thisSpell)),
      sequentially(
        steps = [
          exile(
            run(
              top,
              and([
                  non(isLand),
                  compare(less, statOf(stat(manaValue), thisSpell), axes = [stat(manaValue)])]),
              libraryOf(you))),
          may(
            cast(
              that(card),
              resulting = compare(
                less,
                statOf(stat(manaValue), thisSpell),
                axes = [stat(manaValue)]),
              altCost = withoutPaying)),
          move(
            allOf(
              and([
                  isCard,
                  was(exile(which), within = thisWay),
                  not(was(cast(which), within = thisWay))])),
            anywhere,
            onBottom,
            [inOrder(randomOrder)])]))]
}
