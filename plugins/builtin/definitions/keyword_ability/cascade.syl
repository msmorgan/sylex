# "Cascade" with its reminder text [CR#702.85a].
ability cascade {
  lexical = {lemma = "cascade", verbs = [{lemma = "cascade", frames = [Intransitive]}]},
  spelling = "cascade",
  body = [
    when(
      does(actor(you), cast(thisSpell)),
      sequentially([
          exile(
            run(
              top,
              nominal(
                pre = [non(land)],
                card,
                post = [compare(less, statOf(stat(manaValue), thisSpell), [stat(manaValue)])]),
              libraryOf(you))),
          may(
            cast(
              that(card),
              resulting = compare(less, statOf(stat(manaValue), thisSpell), [stat(manaValue)]),
              altCost = withoutPaying)),
          move(
            allOf(
              nominal(
                card,
                post = [
                  was(exile(which), within = thisWay),
                  not(was(cast(which), within = thisWay))])),
            anywhere,
            onBottom,
            [inOrder(randomOrder)])]))]
}
