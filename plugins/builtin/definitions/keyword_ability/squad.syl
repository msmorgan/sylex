# "Squad [cost]" means "As an additional cost to cast this spell, you may pay [cost] any number of
# times" and "When this creature enters, if its squad cost was paid, create a token that's a copy
# of it for each time its squad cost was paid." [CR#702.157a]
ability squad(cost: Cost) {
  lexical = {lemma = "squad", parameters = [[Cost]]},
  spelling = "squad $cost",
  body = [
    static(addedCost(this(spell), optional, plusAdditional($cost, times = anyNumberOfTimes))),
    when(
      does(actor(this(creature)), enter),
      if = keywordCostPaid(it, squad),
      create(timesPaid(it, byKeyword(squad)), copyOf(it)))]
}
