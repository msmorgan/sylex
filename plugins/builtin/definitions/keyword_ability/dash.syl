# [CR#702.109a] "Dash represents three abilities: two static abilities that function while the
# card with dash is on the stack, one of which may create a delayed triggered ability, and a
# static ability that functions while the object with dash is on the battlefield. 'Dash [cost]'
# means 'You may cast this card by paying [cost] rather than its mana cost,' 'If this spell's dash
# cost was paid, return the permanent this spell becomes to its owner's hand at the beginning of
# the next end step,' and 'As long as this permanent's dash cost was paid, it has haste.'" The
# second is a Resolution Delayed Trigger, as blitz's is [CR#608.3g,603.7d].
ability dash(cost: Cost) {
  lexical = {lemma = "dash", parameters = [[Cost]]},
  spelling = "dash <cost>",
  body = [
    static(can(actor(you), cast(thisCard, altCost = payingInstead($cost)))),
    static(
      resolutionDelayedTrigger(
        doIf(
          keywordCostPaid(dash, thisSpell),
          atNext(beginningOfNext(endStep), returnToHand(becomes(thisSpell)))))),
    static(
      conditionFirstWhile(
        keywordCostPaid(dash, thisPermanent),
        abilityGrant(thisPermanent, haste)))]
}
