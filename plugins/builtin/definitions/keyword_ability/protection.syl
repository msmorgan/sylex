# "Protection from [quality]". Targeting, enchanting and damage are a "permanent or player"'s
# [CR#702.16b,702.16c,702.16e], so those clauses are written over the holder (`this`); equipping
# and fortifying are a permanent's [CR#702.16d] and blocking a creature's [CR#702.16f].
ability protection(quality: Predicate) {
  lexical = {lemma = "protection", parameters = [[Quality(Some("from"))]]},
  spelling = "protection from $quality",
  body = [
    static(
      cant(
        by(
          allOf(
            or([
                nominal(pre = [hasQuality($quality)], spell),
                abilityOf(allOf(nominal(pre = [hasQuality($quality)], source)))]))),
        target(this))),
    static(cant(any, attachTo(allOf(nominal(pre = [hasQuality($quality)], aura)), this))),
    static(
      cant(
        any,
        attachTo(
          allOf(nominal(pre = [hasQuality($quality)], or([equipment, fortification]))),
          thisPermanent))),
    static(
      replace(
        would(
          by(allOf(nominal(pre = [hasQuality($quality)], source))),
          dealDamage(recipient = this)),
        instead(preventDamage(allDamage)))),
    static(
      cant(
        by(allOf(nominal(pre = [hasQuality($quality)], creature))),
        block(attacker = thisCreature)))]
}
