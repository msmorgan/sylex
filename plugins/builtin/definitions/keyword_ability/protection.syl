# "Protection from [quality]". Targeting, enchanting and damage are a "permanent or player"'s
# [CR#702.16b,702.16c,702.16e], so those clauses are written over the holder
# (`this(or([permanent, player]))`); equipping and fortifying are a permanent's
# [CR#702.16d] and blocking a creature's [CR#702.16f].
ability protection(quality: Predicate) {
  lexical = {lemma = "protection", parameters = [[Quality(Some("from"))]]},
  spelling = "protection from $quality",
  body = [
    static(
      cant(
        by(
          bare(
            or([
                nominal(pre = [hasQuality($quality)], spell),
                nominal(
                  ability,
                  post = [fromSource(bare(nominal(pre = [hasQuality($quality)], source)))])]))),
        target(this(or([permanent, player]))))),
    static(
      cantBeAttached(
        this(or([permanent, player])),
        enchanted,
        by = bare(nominal(pre = [hasQuality($quality)], aura)))),
    static(
      cantBeAttached(
        this(permanent),
        equipped,
        by = bare(nominal(pre = [hasQuality($quality)], equipment)))),
    static(
      cantBeAttached(
        this(permanent),
        fortified,
        by = bare(nominal(pre = [hasQuality($quality)], fortification)))),
    static(
      replace(
        would(
          by(bare(nominal(pre = [hasQuality($quality)], source))),
          dealDamage(recipient = this(or([permanent, player])))),
        instead(preventDamage(allDamage)))),
    static(
      cant(
        by(bare(nominal(pre = [hasQuality($quality)], creature))),
        block(attacker = this(creature))))]
}
