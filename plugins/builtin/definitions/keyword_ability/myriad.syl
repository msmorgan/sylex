# "Myriad" means "Whenever this creature attacks, for each opponent other than defending player,
# you may create a token that's a copy of this creature that's tapped and attacking that player or
# a planeswalker they control. If one or more tokens are created this way, exile the tokens at end
# of combat." [CR#702.116a]
ability myriad {
  lexical = {lemma = "myriad"},
  spelling = "myriad",
  body = [
    whenever(
      does(actor(thisCreature), attack),
      sequentially([
          doForEach(
            each(and([isOpponent, otherThan(defendingPlayer)])),
            may(
              create(
                1,
                copyOf(thisCreature),
                riders = [
                  entersAs(tapped),
                  entersAttacking(or([they, a(and([isPlaneswalker, controlledBy(they)]))]))]))),
          doIf(
            compareAmt(numberOf(thoseTokens), atLeast, 1),
            atNext(endOfCombat, exile(thoseTokens)))]))]
}
