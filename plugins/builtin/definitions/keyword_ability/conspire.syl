# "Conspire" means "As an additional cost to cast this spell, you may tap two untapped creatures you
# control that each share a color with it" and "When you cast this spell, if its conspire cost was
# paid, copy it. If the spell has any targets, you may choose new targets for the
# copy." [CR#702.78a]
ability conspire {
  lexical = {lemma = "conspire"},
  spelling = "conspire",
  body = [
    static(
      addedCost(
        this(spell),
        optional,
        plusAdditional(
          perform(
            tap(
              counted(
                exactly(2),
                nominal(
                  pre = [untapped],
                  creature,
                  post = [youControl, shares(color, share, it)]))))))),
    when(
      does(actor(you), cast(this(spell))),
      if = keywordCostPaid(it, conspire),
      sequentially([copyOnStack(it), may(chooseNewTargets(that(copy)))]))]
}
