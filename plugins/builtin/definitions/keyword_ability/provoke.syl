# "Provoke" means "Whenever this creature attacks, you may choose to have target creature
# defending player controls block this creature this combat if able. If you do, untap that
# creature." [CR#702.39a]
ability provoke {
  lexical = {lemma = "provoke"},
  spelling = "provoke",
  body = [
    whenever(
      does(actor(this(creature)), attack),
      may(
        establishThroughout(
          must(
            actor(target(nominal(creature, post = [controls(defendingPlayer)]))),
            block(attacker = this(creature))),
          untilEndOfCombat),
        ifDid = untap(that(creature))))]
}
