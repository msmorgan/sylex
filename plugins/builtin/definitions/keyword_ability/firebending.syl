# "Firebending N" means "Whenever this creature attacks, add N {R}. Until end of combat, you don't
# lose this mana as steps and phases end." [CR#702.189a]
ability firebending(amount: Amount) {
  lexical = {
    lemma = "firebending",
    parameters = [[Amount]],
    verbs = [{lemma = "firebend", past = "firebent", frames = [Intransitive]}]},
  spelling = "firebending <amount>",
  body = [
    whenever(
      does(actor(thisCreature), attack),
      sequentially([
          addMana(counted($amount, symbols([pip(red)]))),
          establishThroughout(manaRetention(you, thisMana), untilEndOfCombat)]))]
}
