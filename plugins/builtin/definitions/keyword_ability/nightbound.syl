# "Nightbound" means "As it becomes day, if this permanent is back face up, transform it" and
# "This permanent can't transform except due to its nightbound ability." [CR#702.145e]
ability nightbound {
  lexical = {lemma = "nightbound"},
  spelling = "nightbound",
  body = [
    static(
      asEvent(
        gameBecomes(day),
        doIf(is(this(permanent), transformed), transform(this(permanent))))),
    static(cant(any, transform(this(permanent)), except = byKeyword(nightbound)))]
}
