# "Intimidate": "This creature can't be blocked except by artifact creatures and/or creatures
# that share a color with it." [CR#702.13b]
ability intimidate {
  lexical = {lemma = "intimidate"},
  spelling = "intimidate",
  body = [
    static(
      cant(
        any,
        block(attacker = this(creature)),
        except = byObjects(
          bare(
            andOr([
                nominal(pre = [artifact], creature),
                nominal(creature, post = [shares(color, share, this(creature))])])))))]
}
