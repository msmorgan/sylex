# "Fear": "This creature can't be blocked except by artifact creatures and/or black
# creatures." [CR#702.36b]
ability fear {
  lexical = {lemma = "fear"},
  spelling = "fear",
  body = [
    static(
      cant(
        any,
        block(attacker = this(creature)),
        except = byObjects(
          bare(andOr([nominal(pre = [artifact], creature), nominal(pre = [black], creature)])))))]
}
