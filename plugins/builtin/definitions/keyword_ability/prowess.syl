# "Prowess" means "Whenever you cast a noncreature spell, this creature gets +1/+1 until end of
# turn." [CR#702.108a]
ability prowess {
  lexical = {lemma = "prowess"},
  spelling = "prowess",
  body = [
    whenever(
      does(actor(you), cast(a(nominal(pre = [non(creature)], spell)))),
      get(this(creature), up(1), up(1), duration = untilEndOfTurn))]
}
