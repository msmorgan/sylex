# "Prowl <cost>": cast for <cost> if a player was dealt combat damage this turn by a source
# you controlled that shared a creature type with this spell [CR#702.76a].
ability prowl(cost: Cost) {
  lexical = {lemma = "prowl", parameters = [[Cost]]},
  spelling = "prowl $cost",
  body = [
    static(
      onlyIf(
        altCost(payingInstead($cost), this(spell)),
        did(
          actor(
            a(nominal(source, post = [youControl, shares(subtype(creature), share, this(spell))]))),
          dealDamage(kind = combat, recipient = a(player)),
          within(soFarThisTurn))))]
}
