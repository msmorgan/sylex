# "A creature with skulk can't be blocked by creatures with greater power." [CR#702.118b]
ability skulk {
  lexical = {lemma = "skulk"},
  spelling = "skulk",
  body = [
    static(
      cant(
        by(bare(nominal(creature, post = [hasPower(greater, powerOf(this(creature)))]))),
        block(attacker = this(creature))))]
}
