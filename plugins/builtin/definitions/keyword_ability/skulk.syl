# "A creature with skulk can't be blocked by creatures with greater power." [CR#702.118b]
ability skulk {
  lexical = {lemma = "skulk"},
  spelling = "skulk",
  body = [
    static(
      cant(
        by(allOf(and([isCreature, hasPower(greater, powerOf(thisCreature))]))),
        block(attacker = thisCreature)))]
}
