# "Power-up — [Cost]: [Effect]" means "[Cost]: [Effect]. If this permanent entered this turn, this
# ability's cost is reduced by this permanent's mana cost. Activate this ability only once."
# [CR#702.193a] The reduction is by symbol: generic reduces generic, colored its own color, and excess
# generic reduces what remains [CR#702.193b].
ability powerUp(ability: Ability) {
  lexical = {lemma = "power-up", parameters = [[DashAbility]]},
  spelling = "power-up — <ability>",
  body = [
    qualified($ability, limit = oncePerObject),
    static(
      ifSo(
        did(actor(thisPermanent), enter, within(soFarThisTurn)),
        reducedBySymbols(thisAbility, manaCostOf(thisPermanent))))]
}
