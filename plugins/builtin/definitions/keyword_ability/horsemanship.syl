# "A creature with horsemanship can't be blocked by creatures without horsemanship."
# [CR#702.31b]
ability horsemanship {
  lexical = {lemma = "horsemanship"},
  spelling = "horsemanship",
  body = [
    static(
      cant(
        by(allOf(and([isCreature, not(hasKeyword(theKeyword(horsemanship)))]))),
        block(attacker = thisCreature)))]
}
