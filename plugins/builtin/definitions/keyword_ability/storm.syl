# "Storm": "When you cast this spell, copy it for each other spell that was cast before it this
# turn. If the spell has any targets, you may choose new targets for any of the
# copies." [CR#702.40a]
ability storm {
  lexical = {lemma = "storm"},
  spelling = "storm",
  body = [
    when(
      does(actor(you), cast(this(spell))),
      sequentially([
          copyOnStack(
            this(spell),
            times = eventCount(
              actor(a(player)),
              cast(a(nominal(pre = [other], spell))),
              earlierThisTurn)),
          may(chooseNewTargets(those(copy)))]))]
}
