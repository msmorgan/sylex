# "Read ahead" means "Chapter abilities of this Saga can't trigger the turn it entered the
# battlefield unless it has exactly the number of lore counters on it specified in the chapter
# symbol of that ability." [CR#702.155a]
ability readAhead {
  lexical = {lemma = "read ahead"},
  spelling = "read ahead",
  body = [
    static(
      onlyWhile(
        cant(
          actor(bare(nominal(abilityHead(chapter), post = [ofSource(this(saga))]))),
          trigger,
          unless = is(
            that(ability),
            compare(equal, countersOn(loreCounter, this(saga)), [chapter]))),
        did(actor(this(saga)), enter, within(soFarThisTurn))))]
}
