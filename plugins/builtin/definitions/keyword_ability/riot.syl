# "Riot" means "You may have this permanent enter with an additional +1/+1 counter on it. If you
# don't, it gains haste." [CR#702.136a]
ability riot {
  lexical = {lemma = "riot"},
  spelling = "riot",
  body = [
    static(
      mayHaveEnter(
        this(permanent),
        [withCounters(1, printedKind(p1p1Counter), additional)],
        otherwise = alongside(gain(it, [haste]))))]
}
