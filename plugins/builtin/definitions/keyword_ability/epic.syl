# "Epic" means "For the rest of the game, you can't cast spells," and "At the beginning of each of
# your upkeeps for the rest of the game, copy this spell except for its epic ability. If the spell
# has any targets, you may choose new targets for the copy." [CR#702.50a]
ability epic {
  lexical = {lemma = "epic"},
  spelling = "epic",
  body = [
    spell(establishThroughout(cant(actor(you), cast(any)), restOfGame)),
    spell(
      delayWithin(
        reached(beginningOfYour(upkeep)),
        restOfGame,
        sequentially([
            copy(
              fromStack,
              thisSpell,
              1,
              [characteristicEdits([removedAbilities(specified([abilities(theKeyword(epic))]))])]),
            may(chooseNewTargets(that(copy)))])))]
}
