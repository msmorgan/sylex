# "∞ — [Ability]" means "As long as this permanent is harnessed, it has [ability]." [CR#702.186b]
ability infinity(ability: Ability) {
  lexical = {lemma = "∞", parameters = [[DashAbility]]},
  spelling = "∞ — $ability",
  body = [
    static(
      asLongAs(
        is(this(permanent), hasDesignation(harnessed)),
        abilityGrant(this(permanent), [$ability])))]
}
