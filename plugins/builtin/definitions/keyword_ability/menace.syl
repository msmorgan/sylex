# "Menace": "This creature can't be blocked except by two or more creatures."
# [CR#702.111b]
ability menace {
  lexical = {lemma = "menace"},
  spelling = "menace",
  body = [
    static(
      cant(
        any,
        block(attacker = thisCreature),
        except = byObjects(counted(orMore(2), isCreature))))]
}
