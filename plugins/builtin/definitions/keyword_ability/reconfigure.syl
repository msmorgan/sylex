# Reconfigure [CR#702.151a]: attaching is the `attachTo` Definition; unattaching moves the
# Equipment away and is no attaching [CR#701.3d], so it is the bare attachment change and names no
# deed.
ability reconfigure(cost: Cost) {
  lexical = {lemma = "reconfigure", parameters = [[Cost]]},
  spelling = "reconfigure $cost",
  body = [
    activatedOnlyDuring(
      $cost,
      attachTo(this(permanent), target(nominal(pre = [other], creature, post = [youControl]))),
      asSorcery),
    activated(
      $cost,
      unattach(this(permanent)),
      timing = asSorcery,
      guard = is(this(permanent), attachment(attachment, counterpart = a(creature))))]
}
