# "Demonstrate" means "When you cast this spell, you may copy it and you may choose new targets
# for the copy. If you copy the spell, choose an opponent. That player copies the spell and may
# choose new targets for that copy." [CR#702.144a]
ability demonstrate {
  lexical = {lemma = "demonstrate"},
  spelling = "demonstrate",
  body = [
    when(
      does(actor(you), cast(this(spell))),
      may(
        sequentially([copyOnStack(this(spell)), may(chooseNewTargets(that(copy)))]),
        ifDid = sequentially([
            choose(anOpponent),
            instruct(the(nominal(pre = [chosen], player)), copyOnStack(this(spell))),
            instruct(the(nominal(pre = [chosen], player)), may(chooseNewTargets(that(copy))))])))]
}
