# "Warp [cost]" means "You may cast this card from your hand by paying [cost] rather than its mana
# cost" and the rest [CR#702.185a]; the rules already allow a cast from the hand [CR#601.3], so
# the permission grants none. "If this spell's warp cost was paid, exile the permanent this spell
# becomes at the beginning of the next end step. Its owner may cast this card after the current
# turn has ended for as long as it remains exiled" is a Resolution Delayed Trigger, as blitz's is
# [CR#608.3g,603.7d].
ability warp(cost: Cost) {
  lexical = {
    lemma = "warp",
    parameters = [[Cost]],
    verbs = [{lemma = "warp", frames = [Monotransitive]}]},
  spelling = "warp <cost>",
  body = [
    static(can(actor(you), cast(thisCard, from = yourHand, altCost = payingInstead($cost)))),
    static(
      resolutionDelayedTrigger(
        doIf(
          keywordCostPaid(warp, thisSpell),
          atNext(
            beginningOfNext(endStep),
            sequentially([
                exile(becomes(thisSpell)),
                establishThroughout(
                  can(actor(ownerOf(it)), cast(it, from = exileZone)),
                  onALaterTurn)])))))]
}
