# "Sneak [cost]" means "Any time you could cast an instant during your declare blockers step, you
# may cast this spell by paying [cost] and returning an unblocked creature you control to its
# owner's hand rather than paying this spell's mana cost." [CR#702.190a] A permanent spell whose
# sneak cost was paid enters tapped and attacking what the returned creature was attacking.
ability sneak(cost: Cost) {
  lexical = {lemma = "sneak", parameters = [[Cost]]},
  spelling = "sneak $cost",
  body = [
    static(
      can(
        actor(you),
        cast(
          thisSpell,
          altCost = payingInstead(
            compound([
                $cost,
                perform(
                  returnToHand(a(nominal(pre = [unblocked], creature, post = [youControl]))))]))),
        timing = and([asInstant, duringPart(whose = you, declareBlockers)]))),
    static(
      replace(
        would(actor(thisPermanent), enter),
        doIf(
          keywordCostPaid(thisPermanent, sneak),
          # It enters tapped and attacking what the returned creature was attacking [CR#702.190b].
          withRiders([
              entersAs(tapped),
              entersAttacking(
                the(
                  nominal(
                    or([player, planeswalker, battle]),
                    post = [
                      inCombat(
                        attackedBy,
                        counterpart = the(
                          nominal(pre = [was(returnToHand(which))], creature)))])))]))))]
}
