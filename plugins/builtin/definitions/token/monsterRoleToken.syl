# "A Monster Role token is a colorless Aura Role enchantment token named Monster with enchant
# creature and 'Enchanted creature gets +1/+1 and has trample.'" [CR#111.10k]
token monsterRoleToken {
  spelling = "Monster Role token",
  body = {
    characteristics = {
      name = "Monster",
      types = [enchantment],
      subtypes = [aura, role],
      text = [
        enchant(isCreature),
        static(
          conjunction([
              getsPt(enchanted(creature), up(1), up(1)),
              abilityGrant(enchanted(creature), trample)]))]}}
}
