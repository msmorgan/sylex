# "A Clue token is a colorless Clue artifact token with '{2}, Sacrifice this token: Draw a card.'"
# [CR#111.10f]
token clueToken {
  spelling = "Clue token",
  body = {
    characteristics = {
      types = [artifact],
      subtypes = [clue],
      text = [
        activated(compound(costs = [mana([generic(2)]), perform(sacrifice(thisToken))]), draw(1))]}}
}
