# "A Blood token is a colorless Blood artifact token with '{1}, {T}, Discard a card, Sacrifice this
# token: Draw a card.'" [CR#111.10g]
token bloodToken {
  spelling = "Blood token",
  body = {
    characteristics = {
      types = [artifact],
      subtypes = [blood],
      text = [
        activated(
          compound(
            costs = [
              mana([generic(1)]),
              tapSymbol,
              perform(discard(a(cardIn(yourHand)))),
              perform(sacrifice(thisToken))]),
          draw(1))]}}
}
