# "A Junk token is a colorless Junk artifact token with '{T}, Sacrifice this token: Exile the top
# card of your library. You may play that card this turn. Activate only as a sorcery.'"
# [CR#111.10t]
token junkToken {
  spelling = "Junk token",
  body = {
    characteristics = {
      types = [artifact],
      subtypes = [junk],
      text = [
        activatedOnlyDuring(
          compound(costs = [tapSymbol, perform(sacrifice(thisToken))]),
          sequentially(
            steps = [
              exile(topSlice(1)),
              establishThroughout(can(actor(you), play(that(card))), thisTurn)]),
          asSorcery)]}}
}
