# "A Lander token is a colorless Lander artifact token with '{2}, {T}, Sacrifice this token: Search
# your library for a basic land card, put it onto the battlefield tapped, then
# shuffle.'" [CR#111.10u]
token landerToken {
  spelling = "Lander token",
  body = {
    characteristics = {
      types = [artifact],
      subtypes = [lander],
      text = [
        activated(
          compound([mana([generic(2)]), tapSymbol, perform(sacrifice(this(token)))]),
          sequentially([
              search(yourLibrary, for = a(nominal(pre = [basic], land))),
              putOntoBattlefieldTapped(it),
              shuffle]))]}}
}
