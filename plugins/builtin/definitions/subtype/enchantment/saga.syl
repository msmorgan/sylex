# [CR#703.4f,714.3a,714.3c,714.4] A Saga enters with a lore counter unless it has read ahead, gets one
# as its controller's precombat main phase begins if it has one or more chapter abilities (a
# turn-based action, no effect [CR#703.1,609.1]), and is sacrificed once its lore counters reach its
# final chapter number, unless it is the source of a chapter ability that has triggered but not yet
# left the stack.
subtype saga {
  lexical = {lemma = "Saga"},
  spelling = "Saga",
  types = [enchantment],
  name = "Saga",
  confers = [
    ability(
      static(
        onlyUnless(
          entersWithCounters(thisSaga, 1, loreCounter),
          is(thisSaga, hasKeyword(theKeyword(readAhead)))))),
    turnBased(
      firstMain,
      doIf(
        compareAmt(finalChapterNumber(thisSaga), atLeast, 1),
        putCounters(1, printedKind(loreCounter), thisSaga))),
    stateBased(
      and([
          compareAmt(finalChapterNumber(thisSaga), atLeast, 1),
          compareAmt(countersOn(loreCounter, thisSaga), atLeast, finalChapterNumber(thisSaga)),
          not(exists(and([chapterAbilityOf(thisSaga), triggeredNotLeftStack])))]),
      sacrifice(thisSaga))]
}
