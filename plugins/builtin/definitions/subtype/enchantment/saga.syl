# [CR#703.4f,715.3a,715.3c,715.4] A Saga enters with a lore counter unless it has read ahead, gets one
# as its controller's precombat main phase begins if it has one or more chapter abilities (a
# turn-based action, no effect [CR#703.1,609.1]), and is sacrificed once its lore counters reach its
# final chapter number, unless it is the source of a chapter ability that has triggered but not yet
# left the stack.
subtype saga {
  lexical = {lemma = "Saga"},
  spelling = "Saga",
  types = [enchantment],
  name = "Saga",
  confers = [
    ability(
      static(
        onlyUnless(
          entersWithCounters(this(saga), 1, loreCounter),
          is(this(saga), hasKeyword(theKeyword(readAhead)))))),
    turnBased(
      firstMain,
      doIf(
        compareAmt(finalChapterNumber(this(saga)), atLeast, 1),
        putCounters(1, printedKind(loreCounter), this(saga)))),
    stateBased(
      and([
          compareAmt(finalChapterNumber(this(saga)), atLeast, 1),
          compareAmt(countersOn(loreCounter, this(saga)), atLeast, finalChapterNumber(this(saga))),
          not(
            exists(
              nominal(
                abilityHead(chapter),
                post = [ofSource(this(saga)), triggeredNotLeftStack])))]),
      sacrifice(this(saga)))]
}
