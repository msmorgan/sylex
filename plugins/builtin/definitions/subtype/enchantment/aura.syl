# [CR#704.5m] An Aura attached to an illegal object or player, or attached to nothing, is put into
# its owner's graveyard.
subtype aura {
  lexical = {lemma = "Aura"},
  spelling = "Aura",
  types = [enchantment],
  name = "Aura",
  confers = [stateBased(not(legallyAttached(this(aura))), putInto(this(aura), graveyard))]
}
