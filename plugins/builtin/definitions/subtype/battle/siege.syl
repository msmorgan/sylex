# [CR#310.12a,310.12b,704.5v] A Siege's protector is an opponent of its controller, it is
# exiled and may be cast transformed when its last defense counter is removed, and it is put into
# its owner's graveyard at defense 0 once no ability of it waits to leave the stack.
subtype siege {
  lexical = {lemma = "Siege"},
  spelling = "Siege",
  types = [battle],
  name = "Siege",
  confers = [
    property(entryChoice(this(siege), anOpponent)),
    ability(
      when(
        does(any, removeCounters(theLast, printedKind(defenseCounter), this(permanent))),
        sequentially(
          [exile(it), may(cast(it, resulting = isTransformed, altCost = withoutPaying))]))),
    stateBased(
      and([
          compareAmt(countersOn(defenseCounter, this(battle)), equal, 0),
          not(exists(nominal(ability, post = [ofSource(it), triggeredNotLeftStack])))]),
      putInto(it, graveyard))]
}
