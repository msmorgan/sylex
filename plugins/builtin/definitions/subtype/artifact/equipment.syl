# [CR#301.5,704.5n] An Equipment may be attached to a creature, and one attached to an illegal
# permanent or to a player becomes unattached.
subtype equipment {
  lexical = {lemma = "Equipment", plural = "Equipment"},
  spelling = "Equipment",
  types = [artifact],
  name = "Equipment",
  confers = [
    property(mayBeAttachedTo(this(equipment), allOf(creature))),
    stateBased(
      and([isAttached(this(equipment)), not(legallyAttached(this(equipment)))]),
      attachment(unattached, this(equipment)))]
}
