# [CR#301.6,704.5n] The Land twin of Equipment.
subtype fortification {
  lexical = {lemma = "Fortification"},
  spelling = "Fortification",
  types = [artifact],
  name = "Fortification",
  confers = [
    property(mayBeAttachedTo(thisFortification, allOf(land))),
    stateBased(
      and([isAttached(thisFortification), not(legallyAttached(thisFortification))]),
      attachment(unattached, thisFortification))]
}
