# [CR#301.6,704.5n] The Land twin of Equipment.
subtype fortification {
  lexical = {lemma = "Fortification"},
  spelling = "Fortification",
  types = [artifact],
  name = "Fortification",
  confers = [
    property(mayBeAttachedTo(this(fortification), allOf(land))),
    stateBased(
      and([isAttached(this(fortification)), not(legallyAttached(this(fortification)))]),
      attachment(unattached, this(fortification)))]
}
