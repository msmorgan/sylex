# [CR#301.6,704.5n] The Land twin of Equipment.
subtype fortification {
  lexical = {lemma = "Fortification"},
  spelling = "Fortification",
  types = [artifact],
  name = "Fortification",
  confers = [
    property(mayBeAttachedTo(thisFortification, allOf(isLand))),
    stateBased(not(isAttached(thisFortification)), attachment(unattached, thisFortification))]
}
