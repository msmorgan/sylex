# "<condition> or <condition>": a triggered ability with more than one trigger condition, which
# triggers when any of them is met [CR#603.1b,603.2]. Each condition prints its own trigger word
# ("When you attack enchanted opponent or a planeswalker they control or when they attack you or
# a planeswalker you control", *Tenuous Truce*). Most cards print "and" between them: `and`.
# TODO(spelling): Format and coordinate the conditions list entries with "or".
# [CR#603.1b,603.2]
primitive or(conditions: List(TriggerCondition)): TriggerCondition = Or
