# "<condition> or <condition>": a triggered ability with more than one trigger condition, which
# triggers when any of them is met [CR#603.1b,603.2]. Named for that disjunction, and spelled
# with "or" (*Tenuous Truce*: "When you attack enchanted opponent or a planeswalker they control
# or when they attack you or a planeswalker you control"); cards that print "and" between their
# trigger conditions write the Template `and` over this.
primitive or(conditions: List(TriggerCondition)): TriggerCondition = Or {
  spelling = "$conditions#<or>"
}
