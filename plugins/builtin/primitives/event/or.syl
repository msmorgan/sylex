# "<event> or <event>": met when any one of the events happens, so a trigger condition over it is
# met when a game event matches any of them [CR#603.2]. Several trigger conditions are the `or` at
# `TriggerCondition`.
# TODO(spelling): Format and coordinate the events list entries. Arms with one subject print it
# once ("attacks or blocks"), even when it stands in two roles ("blocks or becomes blocked",
# "dies or is exiled").
# [CR#603.2]
primitive or(events: List(GameEvent)): GameEvent = Or
