# The beginning of `part` in the `which` occurrence of `whose` turn (or any player's when `whose`
# is `none`) [CR#500.1,102.1]: a Turn Point, where abilities that trigger "at the beginning of"
# that part trigger [CR#603.2b].
primitive beginningOf(
  part: TurnPart,
  whose: Option(NounPhrase),
  which: TurnRef): TurnPoint = BeginningOf
