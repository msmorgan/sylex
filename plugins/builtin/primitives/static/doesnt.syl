# "<subj> doesn't <action>": a plain negative declarative, what the subject does not do. It is no
# deontic rule and takes no deontic modifiers. "This effect doesn't remove this Aura" is
# `doesnt(actor(thisEffect), remove(thisAura))`, its own sentence beside the effect it talks about
# [CR#702.16n].
# TODO(spelling): Agree "doesn't" with the subject's number ("don't" after a plural).
primitive doesnt(subj: Subject, action: Action): StaticSpec = Doesnt {
  spelling = "<subj> doesn't <action>"
}
