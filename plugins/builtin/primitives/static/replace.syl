# "If <event> would …, <replacement> instead", "<subject> enters tapped", "As <subject> enters,
# …": a replacement effect, `event` modified by `replacement` [CR#614.1a,614.1c,614.1d]. Several
# replacement and prevention effects modifying one event interact as [CR#616] orders them.
# TODO(spelling): Replacement clause wordings and the `would` operator wait on
# `syl-would-operator-and-replacement-clauses`.
primitive replace(
  event: WouldClause,
  replacement: Replacement,
  timing: Option(Timing) = none,
  use: ReplUse = repeatedly,
  limit: Option(UsageLimit) = none): StaticSpec = Replace
