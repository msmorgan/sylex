# "As an additional cost to cast <subject>, <cost>" [CR#118.8], `optional` ("you may <cost>") or
# `mandatory` ("<cost>") [CR#118.8b,118.8c].
# TODO(spelling): Spell `plusAdditional(<cost>)` here as "<cost>".
primitive addedCost(
  subject: NounPhrase,
  optionality: CostOptionality,
  cost: AddedCost): StaticSpec = AddedCost
