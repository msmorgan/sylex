# `action` done as part of the replaced event, which still happens: an action that is not an Entry
# Rider, such as putting a counter on a permanent as it turns face up [CR#614.1e,702.37b],
# exchanging text boxes as a permanent enters, or granting haste when Riot's counter is declined
# [CR#702.136a]. Counters put on an entering permanent are `withRiders([withCounters(…)])`
# [CR#614.1c].
primitive alongside(action: VerbPhrase): Replacement = Alongside
