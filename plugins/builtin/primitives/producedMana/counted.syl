# "<amount> <produced>", as "six {R}", "X {G}" and "two mana of any one color": the produced mana,
# amount times. Each counted mana is produced on its own, so every choice inside `produced` (an
# `or`, `ofAnyColor`, `ofAnyColorOf`, `ofColorProducibleBy`, `ofTypeProducedBy`) is made once per
# mana ("{B} or {G} for each permanent destroyed this way" chooses a color per mana), unless the
# inner term says the mana share a color (`ofAnyColor(sameColor)`: "two mana of any one color").
# An `or` of counts is chosen once ("X {G} or X {W}"). A written sequence is `symbols`, never a
# count: "{R}{R}{R}" and "three {R}" are two terms.
# TODO(spelling): A `forEach` amount's per of one prints nothing before mana symbols, and its "for
# each <p>" follows the mana ("{G} for each creature you control"); an amount that is neither a
# number nor a letter prints "an amount of <produced> equal to <amount>".
primitive counted(amount: Amount, produced: ProducedMana): ProducedMana = Counted {
  spelling = "<amount> <produced>"
}
