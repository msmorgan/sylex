# "mana of any color", "mana of any one color": with a count, the freedom says whether every
# counted mana takes the one color chosen.
# TODO(spelling): Selecting "mana of any color" vs "mana of any one color" from `freedom` waits on
# `syl-spelling-conventions`.
primitive ofAnyColor(freedom: ColorFreedom): ProducedMana = AnyColor
