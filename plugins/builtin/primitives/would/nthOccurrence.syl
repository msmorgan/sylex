# "the <ordinal> time <clause> [each <per>]": the replaced event's ordinal, as "The first time
# you would create one or more tokens each turn" [CR#614.1].
primitive nthOccurrence(
  ordinal: Ordinal,
  clause: WouldClause,
  per: Option(Period) = none): WouldClause = NthOccurrence {
  spelling = "the $ordinal time $clause< each $per>"
}
