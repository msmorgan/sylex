# "move <amount> [<kind>] counters from <source> onto <destination>": the all-or-nothing move
# (`VerbPhrase.moveCounters`), a removal from the source and a placement on the destination
# [CR#122.5]. With no kind written, what is put is counters of the kind removed (`those`).
primitive moveCounters(
  amount: Amount,
  source: NounPhrase,
  destination: NounPhrase,
  kind: Option(CounterKindSource) = none): VerbPhrase = MoveCounters {
  spelling = "move $amount< $kind> counters from $source onto $destination"
}
