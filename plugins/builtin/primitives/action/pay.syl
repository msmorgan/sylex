# "pay <cost>": the actor pays the given cost, carrying out its instructions [CR#118.1]. A cost
# that is itself one plain payment ("Pay 5 life", `payLife`) is paid by making that payment once
# (`payment`), not by paying a payment.
# TODO(spelling): Missing separate Templates for "pay $cost< $times>", "pay $whose's $keyword
# cost", and "don't pay $whose's $keyword" (*Heart of Bogardan*), since `whose`, `keyword`, and
# `outcome` replace `$cost` rather than adding an optional part (`docs/design/spelling.md` §4, §7).
primitive pay(
  outcome: PaymentOutcome = paid,
  whose: Option(NounPhrase) = none,
  keyword: Option(KeywordLabel) = none,
  cost: Cost,
  times: PayTimes): VerbPhrase = Pay
