# "Bands with other <quality>", a special form of banding [CR#702.22b]. It keeps its own label:
# the banding rules count a creature with it as one without banding [CR#702.22c], and only losing
# banding takes it too [CR#702.22b], so a card can name it apart from banding.
primitive bandsWithOther: KeywordLabel = BandsWithOther {
  lexical = {lemma = "bands with other", parameters = [[Quality(None)]]}
}
