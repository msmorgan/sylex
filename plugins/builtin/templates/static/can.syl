# "<subj> can <action>": a permission [CR#101.2], with `rider` the later text that modifies the
# act it permits [CR#608.2c] (`DeonticMods.rider`).
template can(
  subj: Subject,
  action: VerbPhrase,
  timing: Option(Timing) = none,
  asThough: Option(AsThough) = none,
  except: Option(DeonticExcept) = none,
  rider: Option(VerbPhrase) = none): StaticSpec {
  # TODO(spelling): Printing `rider` as a sentence after the clause waits on
  # `syl-spelling-forms-and-runs`.
  spelling = "$subj can $action< $timing>< $asThough>< $except>",
  body = staticSpecCan(
    $subj,
    $action,
    {timing = $timing, asThough = $asThough, except = $except, rider = $rider})
}
