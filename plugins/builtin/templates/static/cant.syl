# "<subj> can't <action>" [CR#101.2]. `causedBy` restricts the prohibition to an event that
# cause causes, as `causedBy` does a would-clause: "damage doesn't cause you to lose life" is
# `cant you (loseLife anyAmount) (causedBy := byEvent (does (a isSource) (dealDamage anyAmount you)))`
# [CR#120.3a]. `unless` is its printed "unless <condition>", read inside the prohibition
# (`docs/decisions/semantics.md` §4.7): "A player can't cast a legendary instant or sorcery spell
# unless that player controls …" [CR#205.4e].
# [CR#101.2]
# [CR#120.3a]
# [CR#205.4e]
template cant(
  subj: Subject,
  action: Action,
  timing: Option(Timing) = none,
  asThough: Option(AsThough) = none,
  except: Option(DeonticExcept) = none,
  causedBy: Option(Causing) = none,
  unless: Option(Condition) = none): StaticSpec {
  # TODO(spelling): Include or omit the clauses supplied by timing, asThough, except, causedBy,
  # unless.
  body = staticSpecCant(
    $subj,
    $action,
    {timing = $timing, asThough = $asThough, except = $except, cause = $causedBy, unless = $unless})
}
