# "a P/T <colors> <subtypes> artifact creature token [with <abilities>]":
# `creatureToken` with the artifact card type beside creature.
template artifactCreatureToken(
  powerValue: Int,
  toughnessValue: Int,
  colors: List(Color),
  subtypes: List(Subtype),
  abilities: List(Ability) = []): CharacteristicBundle {
  # TODO(spelling): Printing "colorless" for an empty `colors` list waits on
  # `syl-token-records-to-templates`.
  body = {
    characteristics = {
      colors = $colors,
      types = [artifact, creature],
      subtypes = $subtypes,
      text = $abilities,
      power = $powerValue,
      toughness = $toughnessValue}}
}
