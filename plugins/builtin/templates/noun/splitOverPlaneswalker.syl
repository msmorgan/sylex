# "that player or that planeswalker's controller": the player half of a "target player or
# planeswalker" split, or the controller of the planeswalker half (*Heart of Bogardan*).
template splitOverPlaneswalker: NounPhrase {
  spelling = "that player or that planeswalker's controller",
  body = or(
    [pro(unionHalf(player), one), possessorOf(controller, pro(unionHalf(planeswalker), one))])
}
