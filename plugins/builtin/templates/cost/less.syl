# "costs <amount> less[. This effect can't reduce the mana in that cost to less than <floor>
# mana]"
template less(amount: Amount, floor: Option(Amount) = none): CostShift {
  # TODO(spelling): Printing the `floor` sentence after the reduction clause waits on
  # `syl-spelling-forms-and-runs`.
  spelling = "costs $amount less",
  body = generic(down($amount), $floor)
}
