# "<subject> enters [from <from>]"
template enter(from: Location = anywhere, riders: List(MoveRider) = []): VerbPhrase {
  # TODO(spelling): Move riders are depictives, waiting on the depictives design
  # (`docs/design/semantics.md` §6 item 13).
  spelling = "enter< from $from>",
  body = move(subject, $from, zone(battlefield, none), $riders)
}
