# "flip <count> coins [and win/lose] [showing <outcome>]"
template flipCountedCoins(
  count: Amount = anyAmount,
  call: Option(FlipCall) = none,
  outcome: Option(CoinFace) = none): VerbPhrase {
  # TODO(spelling): Missing separate Templates for "win a coin flip" (*Chance Encounter*) vs "flip
  # $count coins" (`spelling.md` §4).
  body = flipCoins(count($count), call = $call, outcome = $outcome)
}
