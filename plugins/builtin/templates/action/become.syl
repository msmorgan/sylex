# "<subject> becomes <added> in addition to its other types [until …]"
template become(
  subject: NounPhrase,
  added: CharacteristicBundle,
  duration: Option(Duration) = none): VerbPhrase {
  # TODO(spelling): Replacing raw `CharacteristicBundle` records with printed nominals and
  # separating type-retaining forms wait on `syl-become-replaces-types`.
  body = establish(qualityChange($subject, adds, bundle($added)), duration = $duration)
}
