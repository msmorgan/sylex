# "flip a coin for each <each>"
template flipACoinForEach(
  each: NounPhrase,
  call: Option(FlipCall) = none,
  outcome: Option(CoinFace) = none): VerbPhrase {
  # TODO(spelling): Include or omit the clauses supplied by call, outcome.
  body = flipCoins(per($each), call = $call, outcome = $outcome)
}
