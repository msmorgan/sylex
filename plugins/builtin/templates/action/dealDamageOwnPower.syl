# "<source> deals damage equal to its power to <recipient>": a Handoff of the damage to
# `source` [CR#120.1], whose "its" is an ordinary possessive pronoun resolved to the clause
# subject, `source`.
template dealDamageOwnPower(source: NounPhrase, recipient: NounPhrase): VerbPhrase {
  spelling = "$source deal damage equal to its power to $recipient",
  body = instruct($source, dealDamage(amount = powerOf(it), recipient = $recipient))
}
