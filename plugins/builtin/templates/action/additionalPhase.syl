# "there is an additional <part> [after <anchor>] [, followed by an additional <next>]": phases
# added to the current turn [CR#500.8].
template additionalPhase(
  part: TurnPart,
  anchor: Option(TurnPart),
  count: Amount,
  followedBy: Option(TurnPart) = none): VerbPhrase {
  # TODO(spelling): Fronted vs trailing `anchor` clauses and phase-wording conventions wait on
  # `syl-spelling-conventions`.
  body = addTurnPart($part, $count, anchor = $anchor, followedBy = $followedBy)
}
