# "there is an additional <part> [after <anchor>] [, followed by an additional <next>]": phases
# added to the current turn [CR#500.8].
template additionalPhase(
  part: TurnPart,
  anchor: Option(TurnPart),
  count: Amount,
  followedBy: Option(TurnPart) = none): VerbPhrase {
  # TODO(spelling): Missing separate Templates for fronted "After this< $anchor>, there is an
  # additional $part< followed by an additional $followedBy>" (*Aggravated Assault*, *Hellkite
  # Charger*) vs trailing "there is an additional $part after this phase" (*Sphinx of the Second
  # Sun*), and `TurnPart` lacks "phase" on `combat` (`spelling.md` §4).
  body = addTurnPart($part, $count, anchor = $anchor, followedBy = $followedBy)
}
