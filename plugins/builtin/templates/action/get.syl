# "<subject> gets +P/+T [until …]" as an action.
template get(
  subject: NounPhrase,
  powerValue: Delta(Amount),
  toughnessValue: Delta(Amount),
  duration: Option(Duration) = none): VerbPhrase {
  spelling = "$subject get $powerValue/$toughnessValue< $duration>",
  body = establish(getsPt($subject, $powerValue, $toughnessValue), duration = $duration)
}
