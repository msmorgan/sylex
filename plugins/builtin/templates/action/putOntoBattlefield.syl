# "put <subject> [from <from>] onto the battlefield"
template putOntoBattlefield(
  subject: NounPhrase,
  from: Location = anywhere,
  riders: List(MoveRider) = []): VerbPhrase {
  # TODO(spelling): Move riders are depictives, waiting on the depictives design
  # (`docs/design/semantics.md` §6 item 13).
  spelling = "put $subject< from $from> onto the battlefield",
  body = zoneChange($subject, battlefield, $from, $riders)
}
