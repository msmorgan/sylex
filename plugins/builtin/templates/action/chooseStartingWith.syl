# "starting with <first>, [each player] [<disclosure>] chooses <chosen> [<when>]"
template chooseStartingWith(
  first: NounPhrase,
  disclosure: Disclosure = openly,
  chosen: NounPhrase,
  when: Option(Timing) = none): VerbPhrase {
  # TODO(spelling): "Starting with <first>," precedes the clause's subject; waits on
  # `syl-clause-and-imperative`.
  body = choose(first = $first, disclosure = $disclosure, $chosen, when = $when)
}
