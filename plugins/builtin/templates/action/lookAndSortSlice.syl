# "look at <slice>, put any number of them into <spill> [riders] and the rest on top of its
# owner's library in any order" (`Template` using `firstMention` / `laterMention` for `slice`).
template lookAndSortSlice(
  slice: NounPhrase,
  spill: Location,
  spillRiders: List(MoveRider) = []): VerbPhrase {
  # TODO(spelling): Move riders are depictives, waiting on the depictives design
  # (`docs/design/semantics.md` §6 item 13).
  body = sequentially([
      expose(lookAt, cards($slice)),
      move(partOf(anyNumber, $slice), anywhere, $spill, $spillRiders),
      move(theRest, anywhere, onTop, [inOrder(anyOrder)])])
}
