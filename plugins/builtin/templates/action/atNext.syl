# "At <point>, <action>": a delayed triggered ability [CR#603.7a], which triggers only the next
# time the point comes [CR#603.7b].
# TODO(spelling): The point is also printed after the action ("Put that card into your hand at the
# beginning of your next end step", Necropotence).
# [CR#603.7a,603.7b]
template atNext(point: TurnPoint, action: Action): Action {
  spelling = "At <point>, <action>.",
  body = delay(reached($point), $action)
}
