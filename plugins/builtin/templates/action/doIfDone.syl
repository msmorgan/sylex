# "<body>. [If you do, <ifDid>.] [If you can't, <ifNot>.]": the body is required.
template doIfDone(
  body: VerbPhrase,
  ifDid: Option(VerbPhrase) = none,
  ifNot: Option(VerbPhrase) = none): VerbPhrase {
  spelling = "$body<. If you do, $ifDid><. If you can't, $ifNot>",
  body = withContinuation(required, $body, ifDid = $ifDid, ifNot = $ifNot)
}
