# "<body>. [If you do, <ifDid>.] [If you can't, <ifNot>.]": the body is required.
template doIfDone(
  body: Action,
  ifDid: Option(Action) = none,
  ifNot: Option(Action) = none): Action {
  # TODO(spelling): Include or omit the clauses supplied by ifDid, ifNot.
  body = withContinuation(required, $body, ifDid = $ifDid, ifNot = $ifNot)
}
