# "Prevent the next N [<kind>] damage that would be dealt [to <to>] [by <source>] [<duration>]": a
# shield, used up as it prevents [CR#615.7].
template preventNext(
  amount: Amount,
  kind: Option(DamageKind) = none,
  to: NounPhrase = any,
  by: Subject = any,
  duration: Option(Duration) = none): VerbPhrase {
  spelling = "prevent the next $amount< $kind> damage that would be dealt< to $to>< $by>< $duration>",
  body = establish(
    replace(
      would($by, dealDamage(recipient = $to, kind = $kind)),
      instead(preventDamage(theNext($amount)))),
    duration = $duration)
}
