# "return <subject> [from <from>] to the battlefield [riders]"
template returnToBattlefield(
  subject: NounPhrase,
  riders: List(MoveRider) = [],
  from: Location = anywhere): VerbPhrase {
  # TODO(spelling): Move riders are depictives, waiting on the depictives design
  # (`docs/design/semantics.md` §6 item 13).
  spelling = "return $subject< from $from> to the battlefield",
  body = zoneChange($subject, battlefield, $from, $riders)
}
