# "you may <body>[. If you do, <ifDid>][. If you don't, <ifNot>]"
template may(
  body: VerbPhrase,
  ifDid: Option(VerbPhrase) = none,
  ifNot: Option(VerbPhrase) = none): VerbPhrase {
  spelling = "you may $body<. If you do, $ifDid><. If you don't, $ifNot>",
  body = withContinuation(optional, $body, ifDid = $ifDid, ifNot = $ifNot)
}
