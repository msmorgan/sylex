# "put <subject> into <destination> [from <from>] [<riders>]", as "in any order" or "under
# its owner's control". "Put into a graveyard from the battlefield" writes its origin as `from`.
template putInto(
  subject: NounPhrase,
  destination: Location,
  from: Location = anywhere,
  riders: List(MoveRider) = []): Action {
  # TODO(spelling): Omit the origin phrase when from is anywhere; otherwise print 'from' and that
  # location. Format and coordinate the riders list entries, including the empty case.
  body = zoneChange($subject, $destination, $from, $riders)
}
