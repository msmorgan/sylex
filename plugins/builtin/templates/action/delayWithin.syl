# "When <event> <duration>, <action>": a delayed trigger with a window.
template delayWithin(event: GameEvent, duration: Duration, action: VerbPhrase): VerbPhrase {
  # TODO(spelling): Separating fronted-duration "whenever"/"at" wordings from `delay` waits on
  # `syl-spelling-conventions`.
  body = delay($event, duration = $duration, $action)
}
