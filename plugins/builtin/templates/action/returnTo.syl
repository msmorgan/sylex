# "return <subject> to <zone>"
template returnTo(subject: NounPhrase, destination: Location, riders: List(MoveRider)): VerbPhrase {
  # TODO(spelling): Move riders are depictives, waiting on the depictives design
  # (`docs/design/semantics.md` §6 item 13).
  spelling = "return $subject to $destination",
  body = zoneChange($subject, $destination, anywhere, $riders)
}
