# "[<controller>] gain[s] control of <subject> [duration]": the performer by default, so "gain
# control of target creature" and "target player gains control of …" (`instruct`) read alike
# [CR#613.1b].
template gainControl(
  controller: NounPhrase = actor,
  subject: NounPhrase,
  duration: Option(Duration) = none): VerbPhrase {
  spelling = "<$controller >gain control of $subject< $duration>",
  body = establish(controlGrant($controller, $subject), duration = $duration)
}
