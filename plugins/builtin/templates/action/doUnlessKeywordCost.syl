# Rule helper for `cumulativeUpkeep` and `echo` [CR#702.24a,702.30a]: `doUnless` whose payment is
# of the keyword cost of `whose`, so a trigger on paying that cost and mana spendable only on it
# read this payment.
template doUnlessKeywordCost(
  action: VerbPhrase,
  whose: NounPhrase,
  keyword: KeywordLabel,
  cost: Cost): VerbPhrase {
  body = withContinuation(
    optional,
    pay(whose = $whose, keyword = $keyword, payment($cost), once),
    ifNot = $action)
}
