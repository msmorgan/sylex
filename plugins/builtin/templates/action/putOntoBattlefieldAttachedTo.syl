# "put <subject> [from <from>] onto the battlefield attached to <host>" [CR#303.4i]
template putOntoBattlefieldAttachedTo(
  subject: NounPhrase,
  host: NounPhrase,
  from: Location = anywhere): Action {
  # TODO(spelling): Omit the origin phrase when from is anywhere; otherwise print 'from' and that
  # location.
  body = zoneChange($subject, battlefield, $from, [attachedTo($host)])
}
