# "<agent> loses <amount> [<kind>] counters": losing counters is removal from the named player.
# "Loses all counters" is `loseAllCounters`.
template loseCounters(
  kind: Option(CounterKindSource),
  amount: Amount,
  agent: NounPhrase = you): VerbPhrase {
  spelling = "$agent lose $amount< $kind> counters",
  body = removeCounters(exactlyOf($amount), $kind, $agent)
}
