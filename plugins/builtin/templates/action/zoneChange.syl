# The Zone Change the put and return Templates write: `subject` moves from `from` to
# `destination` with `riders` [CR#400.7]. "Put" and "return" name no deed, so the two verbs expand
# to the same move; each Template keeps its own wording. A trigger on the move looks back in time
# when its written origin is the battlefield or a graveyard, or when an object all players can see
# is put into a hand or library [CR#603.10a]; "from anywhere" is not a leaves-the-battlefield
# trigger, even when the object comes from the battlefield [CR#603.6c].
# [CR#400.7]
# [CR#603.6c]
template zoneChange(
  subject: NounPhrase,
  destination: Location,
  from: Location,
  riders: List(MoveRider)): Action {
  # TODO(spelling): Format and coordinate the riders list entries, including the empty case.
  body = move($subject, $from, $destination, $riders)
}
