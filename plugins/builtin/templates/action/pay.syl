# "pay <cost>": paying a cost carries out its instructions [CR#118.1]. A cost that is itself one
# plain payment ("Pay 5 life", `payLife`) is paid by making that payment once, not by paying a
# payment (`Cost.payment`).
template pay(
  cost: Cost,
  times: PayTimes,
  outcome: PaymentOutcome = paid,
  whose: Option(NounPhrase) = none,
  keyword: Option(KeywordLabel) = none): Action {
  # TODO(spelling): Include or omit the clauses supplied by whose, keyword.
  body = actionPay(payment($cost), $times, $outcome, $whose, $keyword)
}
