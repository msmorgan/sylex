# "<first> or <second>": inline disjunction of two actions (*Crypt Lurker*'s "sacrifice a creature
# or discard a creature card"); bulleted "Choose one —" modal text is spelled by `chooseModes` over
# `mode`.
template chooseOne(first: VerbPhrase, second: VerbPhrase): VerbPhrase {
  spelling = "$first or $second",
  body = chooseModes(exactly(1), [mode($first), mode($second)])
}
