# "Prevent all [<kind>] damage that would be dealt [to <to>] [by <source>] [<duration>]": a
# prevention effect, a replacement of each such damage event by its prevention [CR#615.1].
template preventAll(
  kind: Option(DamageKind) = none,
  to: NounPhrase = any,
  by: Subject = any,
  duration: Option(Duration) = none): VerbPhrase {
  spelling = "prevent all< $kind> damage that would be dealt< to $to>< $by>< $duration>",
  body = establish(
    replace(
      would($by, dealDamage(recipient = $to, kind = $kind)),
      instead(preventDamage(allDamage))),
    duration = $duration)
}
