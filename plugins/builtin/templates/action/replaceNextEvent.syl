# "The next time <clause> would happen, <replacement> instead [duration]."
template replaceNextEvent(
  clause: WouldClause,
  replacement: Replacement,
  duration: Option(Duration)): VerbPhrase {
  # TODO(spelling): "The next time" replacement clauses wait on
  # `syl-would-operator-and-replacement-clauses`.
  body = establish(replace($clause, $replacement, use = nextTimeOnly), duration = $duration)
}
