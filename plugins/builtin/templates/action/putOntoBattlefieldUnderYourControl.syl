# "put <subject> [from <from>] onto the battlefield under your control"
template putOntoBattlefieldUnderYourControl(
  subject: NounPhrase,
  from: Location = anywhere): VerbPhrase {
  spelling = "put $subject< from $from> onto the battlefield under your control",
  body = zoneChange($subject, battlefield, $from, [underControlOf(you)])
}
