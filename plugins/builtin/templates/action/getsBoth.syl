# "<subject> gets +X/+X [<duration>]": the same delta to power and toughness,
# written once [CR#613.4c].
template getsBoth(
  subject: NounPhrase,
  delta: Delta(Amount),
  duration: Option(Duration) = none): VerbPhrase {
  # TODO(spelling): Retiring `getsBoth` for one PT-change sort waits on `syl-pt-change-sort`.
  body = get($subject, $delta, $delta, duration = $duration)
}
