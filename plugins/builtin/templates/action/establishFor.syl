# Several static clauses sharing one subject, as one action.
template establishFor(
  subject: NounPhrase,
  parts: List(StaticSpec),
  duration: Option(Duration) = none): VerbPhrase {
  # TODO(spelling): Sharing one subject across continuous effects waits on
  # `syl-continuous-effect-subject` and `syl-shared-phrase-written-once`.
  body = establish(conjunction($parts, subject = $subject), duration = $duration)
}
