# The bare plural, "<p>s" with no determiner. Its term says only what is printed; where it stands
# decides its reading (`docs/design/semantics.md` §2.4). A participant a rule or effect generalizes
# over is the universal over its description, as "all" is (*Glorious Anthem*'s "Creatures you
# control get +1/+1", *Leyline of Punishment*'s "Players can't gain life"). The copula's complement
# tests each member of its subject, as `a` tests one (*Pithing Needle*'s "unless they're mana
# abilities", `noun(bare(manaAbility))`). A participant of an action is a plural indefinite
# (*Aggressive Mining*'s "You can't play lands", *Grand Abolisher*'s "can't cast spells or activate
# abilities of artifacts, creatures, or enchantments").
template bare(p: Nominal): NounPhrase {
  spelling = "$p",
  body = described(bare, $p)
}
