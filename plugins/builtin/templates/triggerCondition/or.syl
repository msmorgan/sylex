# "<condition> or <condition>": several trigger conditions joined by "or" ("When you attack
# enchanted opponent or a planeswalker they control or when they attack you or a planeswalker you
# control", *Tenuous Truce*). The ability triggers when any of them is met [CR#603.1b,603.2], as
# with the printed coordinator "and", so the meaning is `and`'s.
# TODO(spelling): Format and coordinate the conditions list entries with "or".
template or(conditions: List(TriggerCondition)): TriggerCondition {
  body = and($conditions)
}
