# "<condition> and <condition>": several trigger conditions joined by "and" ("When this
# enchantment enters and whenever you cast a spell with mana value 5 or greater", *Up the
# Beanstalk*), each printing its own trigger word. The ability triggers when any of them is met
# [CR#603.1b,603.2], so the meaning is `or`'s.
template and(conditions: List(TriggerCondition)): TriggerCondition {
  spelling = "$conditions#<and>",
  body = or($conditions)
}
