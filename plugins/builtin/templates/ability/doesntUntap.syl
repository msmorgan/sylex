# "<subject> doesn't untap during [<whose>] untap step": the untap step's untapping is the
# `untap` Deed [CR#502.3,701.26b], so this forbids the same Deed a "can't untap" pattern names.
# Because the untap can't happen, a stun counter's replacement can't apply to it, so a tapped
# permanent with both keeps its stun counter [CR#122.1d,614.17c].
template doesntUntap(subject: NounPhrase, whose: Option(NounPhrase)): StaticSpec {
  # TODO(spelling): Include or omit the clauses supplied by whose.
  body = duringUntapStep($whose, cant(any, untap($subject)))
}
