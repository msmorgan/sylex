# "Whenever <event>, <action>"
template whenever(
  event: GameEvent,
  if: Option(Condition) = none,
  action: VerbPhrase,
  limit: Option(UsageLimit) = none): Ability {
  spelling = "Whenever $event, <if $if, >$action<. This ability triggers $limit.>",
  body = triggered(whenever($event), intervening = $if, $action, limit = $limit)
}
