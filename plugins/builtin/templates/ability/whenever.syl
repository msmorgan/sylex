# "Whenever <event>, <action>"
template whenever(
  event: GameEvent,
  action: Action,
  limit: Option(UsageLimit) = none,
  if: Option(Condition) = none): Ability {
  # TODO(spelling): Include or omit the clauses supplied by limit and if.
  body = triggered(whenever($event), intervening = $if, $action, limit = $limit)
}
