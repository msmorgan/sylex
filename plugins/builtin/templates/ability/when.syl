# "When <event>, <action>": a triggered ability with one trigger condition, the trigger word
# `when` [CR#603.1,113.3c]. Its optional parts are a usage limit and an intervening "if" clause
# [CR#603.4]; a concurrent condition or timing window ("while saddled", "during your turn")
# belongs to the event (`timed`). An ability with joined trigger conditions writes `triggered`
# over their `and` or `or`.
template when(
  event: GameEvent,
  if: Option(Condition) = none,
  action: Action,
  limit: Option(UsageLimit) = none): Ability {
  # TODO(spelling): Include or omit the clauses supplied by limit and if.
  body = triggered(when($event), intervening = $if, $action, limit = $limit)
}
