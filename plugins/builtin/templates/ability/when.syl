# "When <event>, <action>". The trigger words `when`, `whenever` and `at` expand to
# one triggered-ability constructor [CR#603.1,113.3c]. Its optional header parts are alternative
# events, joined headers, a concurrent condition, a timing window, a usage limit and an intervening
# "if" clause [CR#603.4].
# [CR#603.1,113.3c,603.4]
template when(
  event: GameEvent,
  action: Action,
  or: List(GameEvent) = [],
  joins: List(JoinedHeader) = [],
  while: Option(Timing) = none,
  during: Option(Timing) = none,
  limit: Option(UsageLimit) = none,
  if: Option(Condition) = none): Ability {
  # TODO(spelling): Include or omit the clauses supplied by while, during, limit, if. Format and
  # coordinate the or, joins list entries, including the empty case.
  body = triggered($event, $or, $while, $joins, $during, $limit, $if, $action)
}
