# What one +X/+Y counter confers [CR#122.1a]: "+X/+Y" to its bearer [CR#613.4c]. A counter
# definition's conferral is per counter (`counter` declarations' `confers`), so the deltas read
# no count.
template boost(powerValue: Delta(Amount), toughnessValue: Delta(Amount)): Conferral {
  body = property(
    characteristicChange(
      this(object),
      [stat(power, $powerValue), stat(toughness, $toughnessValue)]))
}
