# "<subject> gets +X/+X": the same delta to power and toughness, written once [CR#613.4c].
template getsBoth(subject: NounPhrase, delta: Delta(Amount)): StaticSpec {
  # TODO(spelling): Print the delta's sign and number on both sides of the slash and any
  # "for each" qualifier once, after both.
  body = getsPt($subject, $delta, $delta)
}
