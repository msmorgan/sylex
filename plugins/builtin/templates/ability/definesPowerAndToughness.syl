# "<subject>'s power is equal to <powerValue> and its toughness is equal to <toughnessValue>": one
# Characteristic-Defining Ability setting both, the toughness free to read the power's number
# back ("that number plus 1") [CR#604.3a,613.4a].
template definesPowerAndToughness(
  subject: NounPhrase,
  powerValue: Amount,
  toughnessValue: Amount): StaticSpec {
  spelling = "<subject>'s power is equal to <powerValue> and its toughness is equal to <toughnessValue>",
  body = characteristicDefining(
    $subject,
    [stat(power, set($powerValue)), stat(toughness, set($toughnessValue))])
}
