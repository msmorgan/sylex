# "[cost]: <action>. Activate <limit>[ and only if <guard>]."
template activatedOnlyOnce(
  cost: Cost,
  action: VerbPhrase,
  limit: UsageLimit,
  guard: Option(Condition) = none): Ability {
  spelling = "$cost: $action. Activate $limit< and only if $guard>.",
  body = activated($cost, $action, limit = $limit, guard = $guard)
}
