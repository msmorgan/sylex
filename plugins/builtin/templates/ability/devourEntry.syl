# Devour's definition over the permanents `quality` describes, counted by the variant's head
# noun `head`: "As this object enters, you may sacrifice any number of [quality] permanents. This
# permanent enters with N +1/+1 counters on it for each [head] sacrificed this way." Devour counts
# each creature [CR#702.82a], devour [quality] each permanent [CR#702.82c].
template devourEntry(quality: Predicate, head: Predicate, amount: Amount): Ability {
  spelling = "As this object enters, you may sacrifice any number of <quality> permanents. This permanent enters with <amount> +1/+1 counters on it for each <head> sacrificed this way.",
  body = static(
    replace(
      would(actor(thisPermanent), enter),
      before(
        may(devour(counted(anyNumber, and([$quality, in(battlefield)])))),
        body = alongside(
          putCounters(
            forEach($amount, and([$head, was(sacrifice(which), within = thisWay)])),
            printedKind(p1p1Counter),
            thisPermanent)))))
}
