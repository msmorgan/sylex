# "<subject> is <quality>" as a Characteristic-Defining Ability: "this creature is all
# colors", "this object is colorless", "this object is every creature type"
# [CR#604.3a,702.73a,702.114a].
template definesQuality(subject: NounPhrase, op: QualityOp, written: QualityPayload): StaticSpec {
  # TODO(spelling): Characteristic-setting complements wait on `syl-become-replaces-types`.
  body = characteristicDefining($subject, [payload($op, $written)])
}
