# "<subject> gets +P/+T [until …]": one change to both stats, the subject written once.
template getsPt(
  subject: NounPhrase,
  powerValue: Delta(Amount),
  toughnessValue: Delta(Amount)): StaticSpec {
  spelling = "<subject> gets <powerValue>/<toughnessValue>",
  body = characteristicChange(
    $subject,
    [stat(power, $powerValue), stat(toughness, $toughnessValue)])
}
