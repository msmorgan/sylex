# A quality change: `op` applied to `written` on `subject`'s characteristics.
template qualityChange(subject: NounPhrase, op: QualityOp, written: QualityPayload): StaticSpec {
  # TODO(spelling): Characteristic-setting complements wait on `syl-become-replaces-types`.
  body = characteristicChange($subject, [payload($op, $written)])
}
