# "You may have <subject> enter <riders>", a static ability: as `subject` would enter, you choose
# whether it enters with `riders` ("you may have this creature enter as a copy of any creature on
# the battlefield") [CR#614.1c,614.12a].
template mayHaveEnter(subject: NounPhrase, riders: List(MoveRider)): StaticSpec {
  spelling = "You may have <subject> enter <riders>",
  body = replace(would(actor($subject), enter), optionally(withRiders($riders)))
}
