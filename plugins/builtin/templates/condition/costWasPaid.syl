# "if <subject>'s <cost> was paid"
template costWasPaid(subject: NounPhrase, which: LinkSource, window: Option(Duration)): Condition {
  # TODO(spelling): Rule-level helper beneath `keywordCostPaid`; waits on
  # `syl-spelling-conventions` and `syl-dead-weight-sweep`.
  body = compareAmt(paidCostRead($subject, $which, $window), atLeast, 1)
}
