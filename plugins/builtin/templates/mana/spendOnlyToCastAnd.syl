# "Spend this mana only to cast <spell>, and <says>": the mana can be spent only to cast a spell
# `spell` describes, and has an additional effect on the spell it is spent on [CR#106.6].
# TODO(spelling): Retyping `spell` as a noun phrase so its article is written in the term
# ("Spend this mana only to cast $spell, and $says.", *Cavern of Souls*) waits on
# `syl-tocast-noun-phrase`.
template spendOnlyToCastAnd(spell: Predicate, says: VerbPhrase): List(ManaRider) {
  body = [spendOnly([toCast($spell)]), whenSpentOn(affectsIt, a($spell), $says)]
}
