# Rule-only helper inside keyword Definitions ("For each <pip> mana …, you may <action> rather
# than pay that mana", [CR#702.51a,702.66a,702.126a,701.67a]); no card term calls it
# (`docs/design/spelling.md` §7).
template substitute(action: VerbPhrase, pays: List(PipPaid)): ManaSubstitute {
  body = {action = $action, pays = $pays}
}
