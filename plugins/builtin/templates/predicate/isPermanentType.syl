# "has a permanent type": an artifact, battle, creature, enchantment, land, or planeswalker
# [CR#110.4]; read off the types, so it holds of a card or a token.
template isPermanentType: Predicate {
  # TODO(spelling): Permanent-type nominal premodifiers wait on `syl-nominal-descriptions`.
  body = or([
      hasType(artifact),
      hasType(battle),
      hasType(creature),
      hasType(enchantment),
      hasType(land),
      hasType(planeswalker)])
}
