# "enchanted by <by>", "equipped by <by>": the host of an attachment `by` names.
template attachedBy(word: Option(AttachWord), by: NounPhrase): Predicate {
  # TODO(spelling): Participial attachment postmodifiers ("enchanted by $by", *Kitsune Mystic*) wait
  # on `syl-nominal-descriptions`.
  body = attachment(host, counterpart = $by, word = $word)
}
