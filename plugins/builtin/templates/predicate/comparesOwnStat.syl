# "a <dom> with <stat> <r> <bound>": the stat of `member`, the member itself unless written.
template comparesOwnStat(
  domain: Predicate,
  stat: Stat,
  comparator: Comparator,
  bound: Amount,
  member: NounPhrase = ownMember): Predicate {
  # TODO(spelling): Nominal stat postmodifiers ("with $stat $comparator $bound", *Baird, Argivian
  # Recruiter*) wait on `syl-nominal-descriptions`.
  body = compareOver($domain, statOf(stat($stat), $member), $comparator, $bound)
}
