# "<subj> <action>ed [<within>]" as a description of the entity `which` stands for ("creatures
# that attacked this turn") or passive with an agent ("assimilated with this Saga"); the passive
# with no agent is `was`. With no span written, it is the attributive Participial Description ("the
# card you exiled" [CR#702.97a]), the only form that reaches a linked ability's objects
# [CR#607.2a]; `within = thisWay` reads only the enclosing ability's earlier text [CR#607.1,608.2c].
# An `ordinal` picks out the `ordinal`th matching event, counted within each `per` when one is
# written ("the second spell you cast each turn").
template did(
  subj: Subject,
  action: VerbPhrase,
  within: Option(LookbackSpan) = none,
  ordinal: Option(EventOrdinal) = none): Predicate {
  # TODO(spelling): Bare or participial lookbacks wait on `syl-lookback-operator-and-holds`.
  spelling = "that $subj $action< $within>",
  body = predicateDid({subj = $subj, action = $action, within = $within, ordinal = $ordinal})
}
