# "enchanted", "equipped", "fortified": the host of an attachment of that kind, or of any
# attachment when `word` is none.
template isAttached(word: Option(AttachWord) = none): Predicate {
  # TODO(spelling): Premodifier attachment words ("equipped", *Stone Haven Outfitter*) vs rule-only
  # unworded `isAttached()` wait on `syl-nominal-descriptions`.
  body = attachment(host, word = $word)
}
