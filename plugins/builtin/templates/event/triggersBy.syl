# "<ability> triggers by <cause>": `triggers` with what made the ability trigger, a cause
# [CR#603.2].
template triggersBy(ability: NounPhrase, cause: NounPhrase): GameEvent {
  # TODO(spelling): Unused declaration whose `bySource` trigger-cause wording no Vintage-legal card
  # prints (cards print `<event> causes <ability> to trigger` over `causes(byEvent(…), triggers(…))`,
  # as *Naban, Dean of Iteration* does); waits on `syl-dead-weight-sweep`.
  body = causes(bySource($cause), does(actor($ability), trigger))
}
