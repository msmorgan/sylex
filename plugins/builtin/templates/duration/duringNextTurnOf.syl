# "during <player>'s next turn" (`Template` reading `$player` once so `player` is not
# duplicated [CR#115.1,608.2c]).
template duringNextTurnOf(player: NounPhrase): Duration {
  spelling = "during $player's next turn",
  body = between(
    start = reached(beginningOf(turn, $player, nextTime)),
    end = endOf(turn, $player, nextTime))
}
