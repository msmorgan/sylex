# "that player or that permanent's controller": the player half of an "any target" split, or the
# controller of the permanent half (*Chain Lightning*, *Chain of Plasma*).
template splitOverPermanent: NounPhrase {
  spelling = "that player or that permanent's controller",
  body = or([pro(unionHalf(player), one), possessorOf(controller, pro(unionHalf(permanent), one))])
}
