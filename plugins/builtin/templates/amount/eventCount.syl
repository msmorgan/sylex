# The number of occurrences of a historical action clause.
template eventCount(
  action: VerbPhrase,
  subj: Subject,
  within: Duration,
  timing: Option(Timing) = none): Amount {
  # TODO(spelling): Tally wordings are not yet designed (`docs/specs/voice-and-object-phrases.md`
  # §11, `syl-lookback-operator-and-holds`).
  body = tally({subj = $subj, action = $action, within = within($within, timing = $timing)}, events)
}
