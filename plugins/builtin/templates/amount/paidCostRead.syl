# "<subject>'s <keyword> cost was paid", read back.
template paidCostRead(subject: NounPhrase, which: LinkSource, window: Option(Duration)): Amount {
  # TODO(spelling): Premodifier wordings such as "kicked" wait on `syl-nominal-descriptions` and
  # `syl-spelling-conventions`.
  body = paid($subject, readback($which, $window))
}
