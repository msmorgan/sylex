# How often, or how much, `subj` did `action` over `within`: a tally always reads a written
# span.
template eventTally(
  subj: Subject,
  action: VerbPhrase,
  within: LookbackSpan,
  mode: TallyMode): Amount {
  # TODO(spelling): Tally wordings are not yet designed (`docs/specs/voice-and-object-phrases.md`
  # §11, `syl-lookback-operator-and-holds`).
  body = tally({subj = $subj, action = $action, within = $within}, $mode)
}
