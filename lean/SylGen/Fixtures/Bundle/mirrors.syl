# A body-less primitive, with the constructor's field names.
primitive doForEachKind(axis: KindAxis, domain: Option(NounPhrase) = none, sort: QualitySort, body: Action): Action
primitive actionSearch(scope: Location, for_: NounPhrase): Action = .search
primitive actionPay(cost: Cost, times: PayTimes, outcome: PaymentOutcome, whose: Option(NounPhrase), keyword: Option(KeywordLabel)): Action = .pay

counter aegisCounter {
  lexical = { lemma = "aegis counter", variants = [in, from, by, or, this, exists, where, variable,] },
  spelling = "aegis counter",
  holder = object,
  confers = [],
}
relation haunting {}
subtype bear { kind = creature, name = "Bear", confers = [] }
template yourHand: Location { body = handOf(you) }
template libraryOf(player: NounPhrase): Location { body = zone(library, player) }
template thisCreature: NounPhrase { body = headed(type(creature), this) }
action fight(other: NounPhrase) {
  permanent = performs,
  body = doIf(and([is(other, isCreature), is(theActor, isCreature)]),
    simultaneously([
      dealDamage(statOf(stat(power), theActor), other),
      instruct(other, dealDamage(statOf(stat(power), other), theActor))
    ]))
}
ability flying {
  body = [static(cant(any, block(thisCreature),
    except = byObjects(bare(and([isCreature, andOr([hasKeyword(flying), hasKeyword(reach)])])))))]
}
ability_word threshold(ability: Ability) { label = "threshold", body = ability }
designation citysBlessing { scope = heldBy(player), sole = false, confers = [] }
