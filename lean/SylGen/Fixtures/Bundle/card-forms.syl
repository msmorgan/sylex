card modalDfc(
  front = { name = "Branchloft Pathway", types = [land], text = [activated(tapSymbol, addMana(lit(1), manaOf([[colored(green)]])))] },
  back = { name = "Boulderloft Pathway", types = [land], text = [activated(tapSymbol, addMana(lit(1), manaOf([[colored(white)]])))] }
)
card adventurer(
  normal = { name = "Merfolk Secretkeeper", cost = [pip(blue)], types = [creature], subtypes = [merfolk, wizard], power = lit(0), toughness = lit(4) },
  adventure = { name = "Venture Deeper", cost = [pip(blue)], types = [sorcery], subtypes = [adventure], text = [spell(instruct(target(isPlayer), mill(lit(4))))] }
)
card prototype(
  inner = { name = "Blitz Automaton", cost = [generic(7)], types = [artifact, creature], subtypes = [construct], text = [prototype, haste], power = lit(6), toughness = lit(4) },
  alternative = { cost = [generic(2), pip(red)], power = lit(3), toughness = lit(2) }
)
card leveler(
  inner = { name = "Student of Warfare", cost = [pip(white)], types = [creature], subtypes = [human, knight], text = [levelUp(mana([pip(white)]))], power = lit(1), toughness = lit(1) },
  bands = [
    { range = between(2, 6), power = lit(3), toughness = lit(3), text = [firstStrike] },
    { range = plus(7), power = lit(4), toughness = lit(4), text = [doubleStrike] }
  ]
)
card split(
  left = { name = "Profit", cost = [generic(1), pip(white)], types = [instant], text = [spell(get(allOf(and([isCreature, youControl])), up(lit(1)), up(lit(1)), untilEndOfTurn)), fuse] },
  right = { name = "Loss", cost = [generic(2), pip(black)], types = [instant], text = [spell(get(allOf(and([isCreature, opponentsControl])), down(lit(1)), down(lit(1)), untilEndOfTurn)), fuse] }
)
card sharedLineSplit(
  shared = { types = [enchantment], subtypes = [room] },
  left = { name = "Glassworks", cost = [generic(2), pip(red)], text = [when(does(actor(you), unlock(thisDoor)), instruct(thisRoom, dealDamage(lit(4), target(and([isCreature, anOpponentControls])))))] },
  right = { name = "Shattered Yard", cost = [generic(4), pip(red)], text = [at_(beginningOfYour(endStep), instruct(thisRoom, dealDamage(lit(1), eachOpponent)))] }
)
card transforming(
  front = { name = "Neglected Heirloom", cost = [generic(1)], types = [artifact], subtypes = [equipment], text = [
    static(getsPt(equipped(creature), up(lit(1)), up(lit(1)))),
    when(does(any, turnOver(equipped(creature))), transform(thisEquipment)), equip(mana([generic(1)]))
  ] },
  back = { name = "Ashmouth Blade", types = [artifact], subtypes = [equipment], text = [
    static(conjunction([getsPt(equipped(creature), up(lit(3)), up(lit(3))), abilityGrant(it, firstStrike)])), equip(mana([generic(3)]))
  ] }
)
card flip(
  normal = { name = "Bushi Tenderfoot", cost = [pip(white)], types = [creature], subtypes = [human, soldier],
    text = [when(does(actor(a(and([isCreature, did(actor(thisCreature), dealDamage(anyAmount, which), within(soFarThisTurn))]))), die), flip(thisCreature))], power = lit(1), toughness = lit(1) },
  alternative = { name = "Kenzo the Hardhearted", supertypes = [legendary], types = [creature], subtypes = [human, samurai], text = [doubleStrike, bushido(lit(2))], power = lit(3), toughness = lit(4) }
)
