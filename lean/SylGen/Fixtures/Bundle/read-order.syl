template conjunctionMentions(subject: NounPhrase): StaticSpec {
  body = conjunction([combatant($subject)], $subject)
}
template passiveMentions(subject: NounPhrase): GameEvent {
  body = does(by($subject), block($subject))
}
template fixtureActor: NounPhrase { identity = "actor", body = actor }
action fixtureActorHandoff {
  body = instruct(controllerOf(fixtureActor), instruct(actor, sacrifice(fixtureActor)))
}

template readOrderModifiers(subject: NounPhrase): DeonticMods {
  body = { timing = inPart(turn, $subject, current), cause = source($subject) }
}
template prohibitionMentions(subject: NounPhrase): StaticSpec {
  body = staticSpecCant(any, trigger, readOrderModifiers($subject))
}
template repeatedProhibitionMentions(subject: NounPhrase): StaticSpec {
  body = conjunction([prohibitionMentions($subject), prohibitionMentions($subject)])
}
