template drawTwice(amount: Amount): Action {
  body = sequentially([draw($amount), draw($amount)])
}
template forwardedSubject(subject: NounPhrase): NounPhrase {
  body = $subject
}
template subjectPower(subject: NounPhrase): Amount {
  body = statOf(stat(power), $subject)
}
template repeatedValueSum(amount: Amount): Amount {
  body = arith(plus, $amount, $amount)
}
template literalEcho(amount: Amount): Amount {
  body = $amount
}
template quantityFor(amount: Amount): Quantity {
  body = exactlyOf($amount)
}
template graveyardFor(owner: NounPhrase): Location {
  body = zone(graveyard, $owner)
}
template creatureCondition(subject: NounPhrase): Condition {
  body = matches($subject, isCreature)
}
template powerEquals(amount: Amount): Predicate {
  body = compare(eq, $amount, axes = [stat(power)])
}
template lifeCost(amount: Amount): Cost {
  body = perform(changeLife(down($amount)))
}
template powerBoost(subject: NounPhrase, amount: Amount): StaticSpec {
  body = modification($subject, power, up($amount))
}
template unusedSubject(_chosen: NounPhrase): Action {
  body = draw(1)
}
template secondSubject(_left: NounPhrase, right: NounPhrase): NounPhrase {
  body = $right
}
template moveSubject(subject: NounPhrase): Action {
  body = move($subject, anyLocation, graveyard, arrival, [])
}
template rereadDamage(amount: Amount): Action {
  body = sequentially([instruct(this, dealDamage($amount, you)), instruct(this, dealDamage($amount, you))])
}
template definedPower(subject: NounPhrase): StaticSpec {
  body = definesPower($subject, 1)
}
template eventWithSubject(subject: NounPhrase): GameEvent {
  body = does(actor($subject), dealDamage(anyAmount, you))
}
template playerIgnoringSubject(_subject: NounPhrase): NounPhrase {
  body = you
}
template nestedRereadDamage(amount: Amount): Action {
  body = sequentially([rereadDamage($amount), rereadDamage($amount)])
}
primitive dynamicActor: NounPhrase = .actor
action actorAcrossControllerHandoff {
  body = instruct(controllerOf(theActor), instruct(dynamicActor, sacrifice(theActor)))
}
