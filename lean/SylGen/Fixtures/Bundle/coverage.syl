# Comments and every direct literal sort, including escaped quotes and backslashes.
template textAtom: String { body = "quote: \" and slash: \\" }
template naturalAtom: Nat { body = 2 }
template integerAtom: Int { body = -1 }
template amountAtom: Amount { body = -1 }
template manaAtom: ManaSymbol { body = 2 }
template colorAtom: Color { body = red }
template colorlessAtom: ColorOrColorless { body = green }
template coloredManaAtom: ManaSymbol { body = blue }
template booleanAtom: Bool { body = true }
template falseAtom: Bool { body = false }
template absentAtom: Option(NounPhrase) { body = none }
template presentAtom: Option(NounPhrase) { body = thisCreature }
template optionalList: Option(List(Ability)) { body = [flying,] }
template sameOption(x: Option(NounPhrase)): Option(NounPhrase) { body = x }
template liftOption(x: NounPhrase): Option(NounPhrase) { body = x }
template defaultArgument(x: Int = -1): Int { body = x }
template omittedArgument: Int { body = defaultArgument }
template repeatedNoun(who: NounPhrase): Condition {
  body = and([is(who, isCreature), is(who, isCreature)])
}
template alternatives(who: NounPhrase): Predicate {
  body = or([controlledBy(who), controlledBy(who)])
}
template eachKind(who: NounPhrase): Action {
  body = doForEachKind(color, who, color, instruct(who, draw(1)))
}
card { name = "Forest", lexical = {}, spelling = "Forest", supertypes = [basic], types = [land], subtypes = [forest] }
card_type fixtureType { name = "Fixture", cardClass = permanentCard, stats = [] }
token fixtureToken { name = "Fixture", token = { characteristics = { name = "Fixture" } } }
sba fixtureSba { scope = isCreature, when = is(thisCreature, isCreature), then_ = draw(1) }
conferral fixtureConferral { scope = isCreature, confer = ability(flying) }
template dispatchAtom: Nat { body = 5 }
template dispatchAtom: Int { body = -5 }
template dispatchNatural: Nat { body = dispatchAtom }
template dispatchInteger: Int { body = dispatchAtom }
template exactOptional: Option(Int) { body = -2 }
template exactOptional: Int { body = -3 }
template exactOptionalUse: Option(Int) { body = exactOptional }
template innerOptional: Int { body = -4 }
template innerOptionalUse: Option(Int) { body = innerOptional }
template defaultsInOrder(x: Int = -1, y: Int = x): Int { body = y }
template defaultsInOrderUse: Int { body = defaultsInOrder }
template recordOrder(who: NounPhrase): DidClause {
  body = { action = instruct(who, draw(1)), within = none, subj = actor(who) }
}
ability_word alreadyWord(ability: Ability) {
  label = "outer",
  body = italicHead(abilityWord(named("inner")), ability)
}
ability_word repeatedAbilityWord(who: NounPhrase) {
  label = "repeated",
  body = spell(simultaneously([instruct(who, draw(1)), instruct(who, draw(1))]))
}
