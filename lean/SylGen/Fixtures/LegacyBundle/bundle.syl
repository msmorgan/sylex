primitive bundleAtom: Predicate = IsCard
action bundleDraw { body = draw(lit(1)) }
action bundleShared { body = bundleDraw }
ability bundleShared { body = [spell(bundleShared)] }
template bundleQuality: Predicate { body = bundleAtom }
card { name = "Bundle fixture", types = [sorcery], text = [spell(bundleDraw)] }
primitive isCard: Predicate = IsToken { lexical = { verbs = [aQuality] }, spelling = "aQuality" }
primitive isCreature: Predicate = IsPlayer
primitive this: NounPhrase = You { lexical = { nouns = [aSubject] } }
template aQuality: Predicate { body = and([isCard, isCreature]) }
template aSubject: NounPhrase { body = this }
ability bundleDevour { label = "bundle devour", body = [bundleDevourEntry] }
action bundleDevour(subject: NounPhrase) { ofAbility = bundleDevour, body = sacrifice($subject) }
template bundleDevourEntry: Ability { body = spell(bundleDevour(thisCreature)) }
subtype bundleBearer { name = "Bundle Bearer", kind = creature, confers = [bundleConferral] }
template bundleConferral: Conferral { body = property(can(any, sacrifice(a(hasSubtype(bundleBearer))))) }
template bundlePredicates: List(Predicate) { body = [hasSubtype(bundleBearer)] }
card { name = "Canon Witness", types = [sorcery], text = [spell(draw(lit(1)))] }
card { name = "Canon Witness: Split", types = [sorcery] }
