template white: Color { body = blue }
primitive colorWhite: Color = White
template declaredWhite: Color { body = white }
template constructorWhite: Color { body = colorWhite }
template optionalWhite: Option(Color) { body = white }

primitive actionSearch(for_: NounPhrase, scope: Location): Action = Search
template search: Action { body = sequentially([]) }
template declaredSearch: Action { body = search }
template constructorSearch(scope: Location, for_: NounPhrase): Action {
  body = actionSearch($for_, $scope)
}
