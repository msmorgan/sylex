# The Int declaration is ready before the Bool declaration despite its file name.
template shared: Int { body = -1 }
primitive true: Bool = True
template zz: Bool { body = true }
ability sourceAbility { body = [] }
action abilityDeed { ofAbility = sourceAbility, body = sequentially([]) }
primitive italicHead(word: ItalicWord, ability: Ability): Ability = ItalicHead
primitive italicAbilityWord(label: AbilityWordLabel): ItalicWord = AbilityWord
primitive labelled(name: String): AbilityWordLabel = Named
primitive spell(timing: Option(Timing), action: Action): Ability = Spell
template innerWord: Ability { body = italicHead(italicAbilityWord(labelled("inner")), spell(none, sequentially([]))) }
ability_word outerWord { label = "outer", body = innerWord }
template abilityWord(word: AbilityWordLabel, ability: Ability): Ability {
  body = italicHead(italicAbilityWord($word), $ability)
}
ability_word wrappedWord { label = "fresh", body = spell(none, sequentially([])) }
