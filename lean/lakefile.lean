/-
Semantics workbench ported from Idris.

  lake build                       -- the fast loop: syntax, checker, templates, builtin
                                   -- definitions and their `ok_` theorems
  lake build Semantics             -- syntax and checker only (checker work)
  lake build SemanticsCards        -- the canon card bench: generated card data and `ok_` proofs
  lake build SemanticsProofs       -- the pin suites (or open a proof in the editor)
  ./scripts/build                  -- the full gate: every library, warnings as errors
                                   -- (`cargo xtask lean check` runs it, plus the Lake regression)

The builtin and canon modules are generated by `sylGen` from `../plugins` into
`.lake/build/gen/`. Module input and discovery await generation before reading source.
-/
import Lake
open Lake DSL System

package mtg where
  -- Idris `%unbound_implicits off`: every implicit is written out.
  leanOptions := #[⟨`autoImplicit, false⟩]

def writeIfChanged (path : FilePath) (text : String) : IO Unit := do
  if ← path.pathExists then
    if (← IO.FS.readFile path) == text then return
  if let some dir := path.parent then IO.FS.createDirAll dir
  IO.FS.writeFile path text

/-- The printed names a proof module reads through `Semantics.Cards.«…»` or `Semantics.Cards.«ok_…»`. -/
def referencedCards (text : String) : List String :=
  (text.splitOn "Semantics.Cards.«").drop 1 |>.map fun rest =>
    let name := (rest.toSlice.takeWhile (· != '»')).toString
    if name.startsWith "ok_" then (name.drop 3).toString else name

def writeProofImports (root : FilePath) : IO Unit := do
  let mut names : List String := []
  for entry in ← (root / "Semantics/Proofs").readDir do
    if entry.path.extension == some "lean" then
      names := names ++ referencedCards (← IO.FS.readFile entry.path)
  let needles := names.eraseDups.map fun name =>
    " " ++ toString (Lean.Json.str (name ++ ".syl")) ++ "\n"
  let mut imports : Array String := #[]
  let generated := root / ".lake/build/gen/Generated"
  let canon ← IO.FS.readFile (generated / "Canon.lean")
  for line in canon.splitOn "\n" do
    if line.startsWith "import Generated." then
      let module := (line.drop "import Generated.".length).toString
      let text ← IO.FS.readFile (generated / (module ++ ".lean"))
      let registration := (text.splitOn "\nsyl_register \"card\" ").getLast!
      if needles.any (fun needle => registration.contains needle) then
        imports := imports.push s!"import Generated.{module}\n"
  writeIfChanged (root / ".lake/build/gen/Semantics/Cards/Data/Fixtures.lean")
    (String.join (imports.qsort (· < ·)).toList)

input_dir pluginCorpus where
  path := "../plugins"
  text := true

input_dir proofSources where
  path := "Semantics/Proofs"
  text := true

target genPlugins pkg : Unit := do
  let some executable := pkg.findLeanExe? `sylGen | error "missing sylGen executable"
  let some registration := pkg.findLeanLib? `SylRegistration | error "missing syl registration"
  let exe ← executable.exe.fetch
  let registration ← registration.leanArts.fetch
  let corpus ← pluginCorpus.fetch
  (exe.mix registration |>.mix corpus).mapM fun _ => do
    let exe ← exe.await
    let stamp := pkg.dir / ".lake/build/gen/plugins.stamp"
    buildUnlessUpToDate stamp (← getTrace) (pkg.dir / ".lake/build/gen/plugins.trace") do
      let result ← IO.Process.output {
        cmd := exe.toString
        env := #[("LEAN_PATH", some (pkg.dir / ".lake/build/lib/lean").toString)]
        args := #[(pkg.dir / "../plugins").toString,
          (pkg.dir / ".lake/build/gen").toString, "", "Generated"]
      }
      unless result.exitCode == 0 do error (result.stdout ++ result.stderr)
      IO.FS.writeFile stamp "generated\n"
    setTrace .nil

target genProofFixtures pkg : Unit := do
  let generated ← genPlugins.fetch
  let proofs ← proofSources.fetch
  let corpus ← pluginCorpus.fetch
  let some executable := pkg.findLeanExe? `sylGen | error "missing sylGen executable"
  let exe ← executable.exe.fetch
  (generated.mix proofs |>.mix corpus |>.mix exe).mapM fun _ => do
    let stamp := pkg.dir / ".lake/build/gen/proof-fixtures.stamp"
    buildUnlessUpToDate stamp (← getTrace) (pkg.dir / ".lake/build/gen/proof-fixtures.trace") do
      writeProofImports pkg.dir
      IO.FS.writeFile stamp "generated\n"
    setTrace .nil

/-- Lake's builtin `input` facet (`Module.recFetchInput`, `Lake/Build/Module.lean:30-42`), but
awaiting the library's `needs` first.

The builtin reads and hashes a module's source before anything awaits the library's `needs`
(`recFetchPreSetup` awaits them only afterwards, `Lake/Build/Module.lean:557-571`), so a
generated module would be traced from its old text and a stale `.olean` kept; on a clean tree
the build would fail on the missing file. Lake folds the package's facet declarations over its
builtin facets (`Lake/Load/Workspace.lean:39`), so this declaration replaces the builtin, and
`lake build`, `lake setup-file`, `lake lean` and transitive imports all read fresh source.
This depends on Lake's internal facet wiring: the regression in `cargo xtask lean check`
(`crates/xtask/src/lean.rs`) catches a toolchain that breaks it. -/
@[«module_facet»]
def awaitNeedsBeforeInput : ModuleFacetDecl :=
  .mk Module.inputFacet <| mkFacetJobConfig (buildable := false) fun mod => do
    (← mod.lib.extraDep.fetch).mapM fun _ => do
      let path := mod.leanFile
      let contents ← IO.FS.readFile path
      setTrace {caption := path.toString, mtime := ← getMTime path, hash := .ofText contents}
      let header ← Lean.parseImports' contents path.toString
      let imports ← header.imports.mapM fun imp => do
        return ⟨imp, (← findModule? imp.module)⟩
      return {path, header, imports, trace := ← getTrace}

/-! ## Libraries

Lake gives a module to the last-declared library whose roots prefix it, so the narrower
libraries follow `Semantics`, and `SemanticsCardsData` follows `SemanticsCards`. -/

/-- Syntax, checker, templates, and `check_canon_card` for the generated check modules. -/
@[default_target]
lean_lib Semantics where
  roots := #[`Semantics, `Semantics.Check, `Semantics.Primitives, `Semantics.CanonCheck]

/-- The builtin definitions. -/
@[default_target]
lean_lib SemanticsDefinitions where
  roots := #[`Semantics.Definitions]

/-- The builtin definitions' `ok_` theorems. -/
@[default_target]
lean_lib SemanticsCheckBuiltin where
  roots := #[`Semantics.Check.Builtin]

/-- The canon bench: `Semantics.Cards` over the generated check modules. -/
lean_lib SemanticsCards where
  roots := #[`Semantics.Cards]

/-- The generated canon card data. -/
lean_lib SemanticsCardsData where
  srcDir := ".lake/build/gen"
  needs := #[genProofFixtures]
  roots := #[`Semantics.Cards.Data.Fixtures]

lean_lib Generated where
  srcDir := ".lake/build/gen"
  needs := #[genPlugins]
  roots := #[`Generated]

/-- The pin suites; canon cards come from `Semantics.Cards.Data.Fixtures` only. -/
lean_lib SemanticsProofs where
  roots := #[`Semantics.Proofs]

lean_lib DumpValues where
  roots := #[`DumpValues.Sampling, `DumpValues.Compare]

/-- Opt-in elaborated values; excluded from the default build and the Lean check gate. -/
lean_exe dumpValues where
  root := `DumpValues.Main
  supportInterpreter := true

lean_lib DiscourseExport where
  roots := #[`DiscourseExport.Paths, `DiscourseExport.Bindings, `DiscourseExport.Fixtures]

/-- Opt-in discourse oracle for `discourse` (`DiscourseExport/README.md`); excluded from the
default build and the Lean check gate, and deleted with Lean (`lean-retirement`). -/
lean_exe discourseExport where
  root := `DiscourseExport.Main
  supportInterpreter := true

lean_lib SylGenerator where
  roots := #[`SylGen.Parser, `SylGen.Environment, `SylGen.Resolve, `SylGen.Emit]

lean_exe sylGen where
  root := `SylGen.Main
  supportInterpreter := true

/-- Dumps `SylGen.parse`'s declarations for `cargo xtask dsl differential`; outside the default
build and the Lean check gate. -/
lean_exe sylParseDump where
  root := `SylGen.ParseDump

lean_lib SylFixtureRegistry where
  roots := #[`SylGen.Tests.Registry]

input_dir sylCorpus where
  path := "SylGen/Fixtures"
  text := true

input_file sylNegativeTests where
  path := "SylGen/Tests/negative.sh"
  text := true

target genSyl pkg : Unit := do
  let some executable := pkg.findLeanExe? `sylGen | error "missing sylGen executable"
  let some library := pkg.findLeanLib? `SylFixtureRegistry | error "missing fixture registry"
  let some registration := pkg.findLeanLib? `SylRegistration | error "missing syl registration"
  let registration ← registration.leanArts.fetch
  let exe ← executable.exe.fetch
  let registry ← library.leanArts.fetch
  let corpus ← sylCorpus.fetch
  let tests ← sylNegativeTests.fetch
  (exe.mix registry |>.mix registration |>.mix corpus |>.mix tests).mapM fun _ => do
    let exe ← exe.await
    let stamp := pkg.dir / ".lake/build/gen/syl.stamp"
    buildUnlessUpToDate stamp (← getTrace) (pkg.dir / ".lake/build/gen/syl.trace") do
      for (fixture, corpus, root, modulePrefix) in #[
          (true, "Bundle", "SylFixture", "SylFixtures"),
          (false, "Normal", "NormalFixture", "NormalFixtures"),
          (true, "LegacyBundle", "LegacyFixture", "LegacyFixtures")] do
        let args := (if fixture then #["--fixture"] else #[]) ++
          #[(pkg.dir / "SylGen/Fixtures" / corpus).toString,
            (pkg.dir / ".lake/build/gen").toString, root, modulePrefix]
        let result ← IO.Process.output {
          cmd := exe.toString
          env := #[("LEAN_PATH", some (pkg.dir / ".lake/build/lib/lean").toString)]
          args
        }
        unless result.exitCode == 0 do error result.stderr
      let tests ← IO.Process.output {
        cmd := "sh"
        args := #[(pkg.dir / "SylGen/Tests/negative.sh").toString, exe.toString]
        env := #[("LEAN_PATH", some (pkg.dir / ".lake/build/lib/lean").toString)]
      }
      unless tests.exitCode == 0 do error (tests.stdout ++ tests.stderr)
      IO.FS.writeFile stamp "generated\n"
    setTrace .nil

@[«library_facet»]
def awaitNeedsBeforeModules : LibraryFacetDecl :=
  .mk LeanLib.modulesFacet <| mkFacetJobConfig (buildable := false) fun lib => do
    if lib.srcDir.toString.endsWith ".lake/build/gen" then
      discard <| (← lib.extraDep.fetch).await
    let some builtin := LeanLib.initFacetConfigs.get? LeanLib.modulesFacet
      | error "missing builtin modules facet"
    builtin.run lib

lean_lib SylFixtures where
  srcDir := ".lake/build/gen"
  roots := #[`SylFixtures]
  needs := #[genSyl]

lean_lib SylFixturePins where
  roots := #[`SylGen.Tests.Pins, `SylGen.Tests.ReadOrder]

lean_lib SylRegistration where
  roots := #[`SylGen.Registration, `SylGen.ReadOrder]

lean_lib NormalFixtures where
  srcDir := ".lake/build/gen"
  roots := #[`NormalFixtures]
  needs := #[genSyl]

lean_lib LegacyFixtures where
  srcDir := ".lake/build/gen"
  roots := #[`LegacyFixtures]
  needs := #[genSyl]
