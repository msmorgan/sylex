/-
Semantics workbench ported from Idris.

  lake build                       -- the fast loop: syntax, checker, templates, builtin
                                   -- definitions and their `ok_` theorems
  lake build Semantics             -- syntax and checker only (checker work)
  lake build SemanticsCards        -- the canon card bench: generated card data and `ok_` proofs
  lake build SemanticsProofs       -- the pin suites (or open a proof in the editor)
  ./scripts/build                  -- the full gate: every library, warnings as errors
                                   -- (`cargo xtask lean check` runs it, plus the Lake regression)

The canon bench is generated by `genCanon` below from `../plugins_v3/canon/cards/` into the
gitignored `Semantics/Cards/Data/` and `Semantics/Cards/Check/`. Every `lake build`,
`lake setup-file` (the language server) and `lake lean` regenerates it, so a card edit needs no
other step.
-/
import Lake
open Lake DSL System

package mtg where
  -- Idris `%unbound_implicits off`: every implicit is written out.
  leanOptions := #[⟨`autoImplicit, false⟩]

/-! ## Canon card generation -/

/-- Fixed shard count: Lake must know the module set before it builds, so a card edit never
changes it. -/
def canonShardCount : Nat := 16

def canonShardName (index : Nat) : String :=
  s!"Shard{if index < 10 then "0" else ""}{index}"

/-- The card file of a printed name: `card_filename` in `crates/deckmaste_core/src/plugin.rs`. -/
def canonCardFileName (name : String) : String :=
  name.foldl (init := "") (fun out c => out ++ match c with
    | '<' => "{less}" | '>' => "{greater}" | ':' => "{colon}" | '"' => "{quote}"
    | '/' => "{slash}" | '\\' => "{backslash}" | '|' => "{pipe}" | '?' => "{question}"
    | '*' => "{star}" | c => c.toString) ++ ".lean"

/-- 64-bit FNV-1a over the file name's UTF-8 bytes: stable across toolchains, so adding a card
moves no other card. -/
def fnv1a (text : String) : UInt64 :=
  text.toUTF8.foldl (fun hash byte => (hash ^^^ byte.toUInt64) * 1099511628211)
    14695981039346656037

/-- The printed names a proof module reads through `cardNamed "…"` or `cardNamedOk "…"`. -/
def cardNamedLiterals (text : String) : List String :=
  (text.splitOn "cardNamed").drop 1 |>.filterMap fun rest =>
    let rest := if rest.startsWith "Ok" then rest.drop 2 else rest.toSlice
    let rest := rest.trimAsciiStart
    if rest.startsWith "\"" then
      some ((rest.drop 1).takeWhile (· != '"')).toString
    else none

def writeIfChanged (path : FilePath) (text : String) : IO Unit := do
  if (← path.pathExists) then
    if (← IO.FS.readFile path) == text then return
  if let some dir := path.parent then IO.FS.createDirAll dir
  IO.FS.writeFile path text

def generatedNote : String :=
  "-- Generated by `genCanon` in lean/lakefile.lean from plugins_v3/canon/cards. Do not edit.\n"

/-- A data module: each card file's text verbatim, under its `-- source:` line. Data modules
never import `Semantics.Check`. -/
def canonDataModule (cards : Array (String × String)) : String := Id.run do
  let mut out := generatedNote ++ "import Semantics.Definitions\n\n" ++
    "open Semantics Semantics.Templates Semantics.Definitions\n\nnamespace Semantics.Cards\n"
  for (file, text) in cards do
    let text := if text.endsWith "\n" then text else text ++ "\n"
    out := out ++ s!"\ncanon_card \"{file}\"\n-- source: plugins_v3/canon/cards/{file}:1\n" ++
      text ++ "end_canon_card\n"
  return out ++ "\nend Semantics.Cards\n"

/-- A check module: the refusal report and kernel `decide` proof of each card in its data
module. -/
def canonCheckModule (data : String) (cards : Array (String × String)) : String := Id.run do
  let mut out := generatedNote ++ s!"import Semantics.Cards.Data.{data}\n" ++
    "import Semantics.CanonCheck\n\nnamespace Semantics.Cards\n"
  for (file, _) in cards do
    out := out ++ s!"\n-- source: plugins_v3/canon/cards/{file}:1\ncheck_canon_card \"{file}\"\n"
  return out ++ "\nend Semantics.Cards\n"

/-- Write `Semantics/Cards/{Data,Check}/{Fixtures,Shard00..15}.lean` from the card files.
`Fixtures` holds every card a module under `Semantics/Proofs/` names through `cardNamed`, so
proofs import it alone; the shards hold the rest, each card by the hash of its file name. -/
def generateCanon (root : FilePath) : IO Unit := do
  let cardsDir := root / ".." / "plugins_v3" / "canon" / "cards"
  let mut referenced : Std.HashSet String := {}
  for path in ← (root / "Semantics" / "Proofs").walkDir do
    if path.extension == some "lean" then
      for name in cardNamedLiterals (← IO.FS.readFile path) do
        referenced := referenced.insert (canonCardFileName name)
  let files := (← cardsDir.readDir).filterMap (fun entry =>
      if entry.fileName.endsWith ".lean" then some entry.fileName else none)
    |>.qsort (· < ·)
  let mut fixtures := #[]
  let mut shards := Array.replicate canonShardCount #[]
  for file in files do
    let card := (file, ← IO.FS.readFile (cardsDir / file))
    if referenced.contains file then fixtures := fixtures.push card
    else shards := shards.modify (fnv1a file % canonShardCount.toUInt64).toNat (·.push card)
  let modules := #[("Fixtures", fixtures)] ++
    (Array.range canonShardCount).map fun i => (canonShardName i, shards[i]!)
  let dir := root / "Semantics" / "Cards"
  for (name, cards) in modules do
    writeIfChanged (dir / "Data" / s!"{name}.lean") (canonDataModule cards)
    writeIfChanged (dir / "Check" / s!"{name}.lean") (canonCheckModule name cards)

/-- Regenerate the canon card modules, rewriting only files whose text changed. The trace is
`.nil`: `recFetchPreSetup` mixes a library's `needs` trace into every module's trace
(`Lake/Build/Module.lean:603`), so any other trace would rebuild every shard on any card edit.
Each module instead rebuilds exactly when its own generated text changes. -/
target genCanon pkg : Unit := Job.async do
  generateCanon pkg.dir
  setTrace .nil

/-- Lake's builtin `input` facet (`Module.recFetchInput`, `Lake/Build/Module.lean:30-42`), but
awaiting the library's `needs` first.

The builtin reads and hashes a module's source before anything awaits the library's `needs`
(`recFetchPreSetup` awaits them only afterwards, `Lake/Build/Module.lean:557-571`), so a
generated module would be traced from its old text and a stale `.olean` kept; on a clean tree
the build would fail on the missing file. Lake folds the package's facet declarations over its
builtin facets (`Lake/Load/Workspace.lean:39`), so this declaration replaces the builtin, and
`lake build`, `lake setup-file`, `lake lean` and transitive imports all read fresh source.
This depends on Lake's internal facet wiring: the regression in `cargo xtask lean check`
(`crates/xtask/src/lean.rs`) catches a toolchain that breaks it. -/
@[«module_facet»]
def awaitNeedsBeforeInput : ModuleFacetDecl :=
  .mk Module.inputFacet <| mkFacetJobConfig (buildable := false) fun mod => do
    (← mod.lib.extraDep.fetch).mapM fun _ => do
      let path := mod.leanFile
      let contents ← IO.FS.readFile path
      setTrace {caption := path.toString, mtime := ← getMTime path, hash := .ofText contents}
      let header ← Lean.parseImports' contents path.toString
      let imports ← header.imports.mapM fun imp => do
        return ⟨imp, (← findModule? imp.module)⟩
      return {path, header, imports, trace := ← getTrace}

/-! ## Libraries

Lake gives a module to the last-declared library whose roots prefix it, so the narrower
libraries follow `Semantics`, and `SemanticsCardsData` follows `SemanticsCards`. -/

input_dir builtinBundle where
  path := "../plugins_v3/builtin"
  text := true

/-- Syntax, checker, templates, and `check_canon_card` for the generated check modules. -/
@[default_target]
lean_lib Semantics where
  roots := #[`Semantics, `Semantics.Check, `Semantics.Primitives, `Semantics.CanonCheck]

/-- The builtin definitions. -/
@[default_target]
lean_lib SemanticsDefinitions where
  needs := #[builtinBundle]
  roots := #[`Semantics.Definitions]

/-- The builtin definitions' `ok_` theorems. -/
@[default_target]
lean_lib SemanticsCheckBuiltin where
  roots := #[`Semantics.Check.Builtin]

/-- The canon bench: `Semantics.Cards` over the generated check modules. -/
lean_lib SemanticsCards where
  needs := #[genCanon]
  roots := #[`Semantics.Cards]

/-- The generated canon card data. -/
lean_lib SemanticsCardsData where
  needs := #[genCanon]
  roots := #[`Semantics.Cards.Data.Fixtures] ++
    (Array.range canonShardCount).map fun i => `Semantics.Cards.Data ++ (canonShardName i).toName

/-- The pin suites; canon cards come from `Semantics.Cards.Data.Fixtures` only. -/
lean_lib SemanticsProofs where
  roots := #[`Semantics.Proofs]

lean_lib DumpValues where
  roots := #[`DumpValues.Sampling, `DumpValues.Compare]

/-- Opt-in elaborated values; excluded from the default build and the Lean check gate. -/
lean_exe dumpValues where
  root := `DumpValues.Main
  supportInterpreter := true
