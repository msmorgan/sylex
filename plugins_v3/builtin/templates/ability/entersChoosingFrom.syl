# "As <subject> enters, choose a <quality> from <domain>."
template entersChoosingFrom(
  subject: NounPhrase,
  sort: QualitySort,
  domain: ChoiceDomain): StaticSpec {
  spelling = "As <subject> enters, choose a <sort> from <domain>.",
  body = entryChoice(subject, a(qualityFrom(sort, domain)))
}
