# "<subject> has base power and toughness P/T"
template getsBase(subject: NounPhrase, powerValue: Amount, toughnessValue: Amount): StaticSpec {
  spelling = "<subject> has base power and toughness <powerValue>/<toughnessValue>",
  body = getsPt($subject, setTo($powerValue), setTo($toughnessValue))
}
