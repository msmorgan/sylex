# "<subject> has <term>", for a term a "the same is true for" list names. A keyword named bare is
# granted itself; a family term ("landwalk", "protection", "hexproof") grants each variant of it
# that the objects `holders` describes have, "the <term> abilities of those objects" [CR#702.1c].
# [CR#702.1c]
template keywordGrant(subject: NounPhrase, term: KeywordTerm, holders: Predicate): StaticSpec {
  # TODO(spelling): A bare term grants the keyword; a family term instead names the abilities of
  # holders.
  body = characteristicChange($subject, [addedKeywordTerm($term, $holders)])
}
