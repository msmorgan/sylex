# What one keyword counter confers [CR#122.1b]: its bearer gains the keyword [CR#613.1f], named
# by its ability declaration (`grants(flying)`).
# [CR#122.1b]
# [CR#613.1f]
template grants(keyword: Ability): Conferral {
  spelling = "<keyword>",
  body = property(characteristicChange(this, [addedAbilities([keyword])]))
}
