# A token's characteristics from the parts a creature token names, with the abilities it is
# created with ("… with flying") [CR#111.3].
template creatureTokenOf(
  powerValue: Amount,
  toughnessValue: Amount,
  colors: List(Color),
  subtypes: List(Subtype),
  abilities: List(Ability) = []): CharacteristicBundle {
  # TODO(spelling): Format and coordinate the colors, subtypes, abilities list entries, including
  # the empty case.
  body = {
    characteristics = {
      colors = colors,
      types = [creature],
      subtypes = subtypes,
      text = abilities,
      power = powerValue,
      toughness = toughnessValue}}
}
