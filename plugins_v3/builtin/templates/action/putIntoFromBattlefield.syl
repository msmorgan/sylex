# "put <subject> into <destination> from the battlefield": `putInto` from the battlefield, a move
# observed on its departure [CR#603.6c,603.10a].
# [CR#603.6c,603.10a]
template putIntoFromBattlefield(
  subject: NounPhrase,
  destination: Location,
  riders: List(MoveRider) = []): Action {
  # TODO(spelling): Format and coordinate the riders list entries, including the empty case.
  body = zoneChangeObservedOnDeparture($subject, $destination, battlefield, $riders)
}
