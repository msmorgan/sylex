# "put <subject> [from <from>] onto the battlefield under your control"
template putOntoBattlefieldUnderYourControl(
  subject: NounPhrase,
  from: Location = anywhere): Action {
  # TODO(spelling): Omit the origin phrase when from is anywhere; otherwise print 'from' and that
  # location.
  body = zoneChange($subject, battlefield, $from, [under(you)])
}
