# "there is an additional <part> [after <anchor>] [, followed by an additional <next>]": phases
# added to the current turn [CR#500.8].
# [CR#500.8]
template additionalPhase(
  part: TurnPart,
  anchor: Option(TurnPart),
  count: Amount,
  followedBy: Option(TurnPart) = none): Action {
  # TODO(spelling): Include or omit the clauses supplied by anchor, followedBy.
  body = addTurnPart($part, $count, $anchor, $followedBy)
}
