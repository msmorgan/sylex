# "Prevent the next N <kind> damage that would be dealt [to <to>] [duration]": a shield, used
# up as it prevents [CR#615.7].
# [CR#615.7]
template preventNext(
  to: NounPhrase,
  amount: Amount,
  duration: Option(Duration),
  kind: Option(DamageKind) = none): Action {
  # TODO(spelling): Include or omit the clauses supplied by duration, kind.
  body = establish(
    replace(
      would(any, dealDamage(recipient = to, kind = kind)),
      instead(preventDamage(theNext(amount)))),
    duration)
}
