# "return <subject> [from <from>] to the battlefield [riders]"
template returnToBattlefield(
  subject: NounPhrase,
  riders: List(MoveRider) = [],
  from: Location = anywhere): Action {
  # TODO(spelling): Omit the origin phrase when from_ is anywhere; otherwise print 'from' and that
  # location. Format and coordinate the riders list entries, including the empty case.
  body = zoneChange($subject, battlefield, $from, $riders)
}
