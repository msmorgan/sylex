# "<subject> enters [from <from>]"
template enter(from: Location = anywhere, riders: List(MoveRider) = []): Action {
  # TODO(spelling): Omit the origin phrase when from_ is anywhere; otherwise print 'from' and that
  # location. Format and coordinate the riders list entries, including the empty case.
  body = move(theActor, $from, zone(battlefield, none), arrival, $riders)
}
