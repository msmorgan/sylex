# "<subject> gets +X/+X [<duration>]": the same delta to power and toughness,
# written once [CR#613.4c].
template getsBoth(
  subject: NounPhrase,
  delta: Delta(Amount),
  duration: Option(Duration) = none): Action {
  # TODO(spelling): Include or omit the clauses supplied by duration.
  body = get(subject, delta, delta, duration)
}
