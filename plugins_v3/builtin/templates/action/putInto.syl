# "put <subject> into <destination> [from <from_>] [<riders>]", as "in any order" or "under
# its owner's control". From the battlefield it is `putIntoFromBattlefield`, observed on its
# departure.
template putInto(
  subject: NounPhrase,
  destination: Location,
  from: Location = wherever,
  riders: List(MoveRider) = []): Action {
  # TODO(spelling): Omit the origin phrase when from_ is wherever; otherwise print 'from' and that
  # location. Format and coordinate the riders list entries, including the empty case.
  body = zoneChange(subject, destination, from, riders)
}
