# As an Omen spell resolves, its controller shuffles it into its owner's library instead of
# putting it into that player's graveyard. [CR#720.3d]
#
# No supported Oracle rules-text or Comprehensive Rules plural is attested.
subtype omen {
  lexical = {lemma = "Omen"},
  spelling = "Omen",
  kind = spell,
  name = "Omen",
}
