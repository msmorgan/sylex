# Dungeon: a card type all the same, though a dungeon begins outside the game [CR#309.2] and is
# never a permanent or a spell [CR#309.2c].
#
# [CR#309.2c] "Dungeon cards are not permanents. They can't be cast."
card_type dungeon {
  lexical = {lemma = "dungeon"},
  spelling = "dungeon",
  name = "Dungeon",

  confers = []
}
