# "Scavenge [cost]" means "[Cost], Exile this card from your graveyard: Put a number of +1/+1
# counters equal to the power of the card you exiled on target creature. Activate only as a
# sorcery." [CR#702.97a]
ability scavenge(cost: Cost) {
  lexical = {lemma = "scavenge", parameters = [[Cost]]},
  spelling = "scavenge <cost>",
  body = [
    activatedOnlyDuring(
      compound([cost, perform(exileFrom(thisCard, yourGraveyard))]),
      putCounters(
        powerOf(the(and([isCard, did(actor(you), exile(which))]))),
        printedKind(p1p1Counter),
        target(isCreature)),
      asSorcery)]
}
