# "Protection from [quality]". Targeting, enchanting and damage are a "permanent or player"'s
# [CR#702.16b,702.16c,702.16e], so those clauses are written over the holder (`this_`); equipping
# and fortifying are a permanent's [CR#702.16d] and blocking a creature's [CR#702.16f].
ability protection(quality: Predicate) {
  lexical = {lemma = "protection", parameters = [[Quality(Some("from"))]]},
  spelling = "protection from <quality>",
  body = [
    static(
      cant(
        by(allOf(or([and([isSpell, $quality]), abilityOf(allOf(and([isSource, $quality])))]))),
        target(this))),
    static(cant(any, attachTo(allOf(and([hasSubtype(aura), $quality])), this))),
    static(
      cant(
        any,
        attachTo(
          allOf(and([or([hasSubtype(equipment), hasSubtype(fortification)]), $quality])),
          thisPermanent))),
    static(
      replace(
        would(by(allOf(and([isSource, $quality]))), dealDamage(recipient = this)),
        instead(preventDamage(allDamage)))),
    static(cant(by(allOf(and([isCreature, $quality]))), block(thisCreature)))]
}
