# The Ninja enters attacking what the returned creature was attacking [CR#702.49c].
ability ninjutsu(cost: Cost) {
  lexical = {
    lemma = "ninjutsu",
    parameters = [[Cost]],
    variants = [{lemma = "commander ninjutsu", parameters = [[Cost]]}]},
  spelling = "ninjutsu <cost>",
  body = [
    activated(
      compound([
          $cost,
          perform(reveal(this)),
          perform(returnToHand(a(and([isCreature, isAttacking, isUnblocked, youControl]))))]),
      putOntoBattlefieldTappedAttacking(
        this,
        yourHand,
        the(
          and([
              or([isPlayer, isPlaneswalker, isBattle]),
              inCombat(attackedBy, the(and([was(returnToHand(which)), isCreature])))]))))]
}
