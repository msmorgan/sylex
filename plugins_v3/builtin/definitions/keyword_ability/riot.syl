# "Riot" means "You may have this permanent enter with an additional +1/+1 counter on it. If you
# don't, it gains haste." [CR#702.136a]
ability riot {
  lexical = {lemma = "riot"},
  spelling = "riot",
  body = [
    static(
      replace(
        would(actor(thisPermanent), enter),
        alongside(
          mayOrElse(
            putCounters(1, printedKind(p1p1Counter), thisPermanent),
            gainHaste(thisPermanent)))))]
}
