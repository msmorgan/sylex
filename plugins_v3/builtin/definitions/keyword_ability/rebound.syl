# "Rebound" means "If this spell was cast from your hand, instead of putting it into your
# graveyard as it resolves, exile it and, at the beginning of your next upkeep, you may cast this
# card from exile without paying its mana cost." [CR#702.88a]
# Its static replacement creates the delayed trigger, whose source is this spell [CR#603.7f].
ability rebound {
  lexical = {lemma = "rebound"},
  spelling = "rebound",
  body = [
    static(
      replace(
        causedBy(
          byEvent(does(any, resolve(thisSpell))),
          would(any, putInto(thisSpell, graveyard, stack))),
        doIf(
          is(thisSpell, did(any, cast(which, yourHand), thisObject)),
          instead(
            sequentially([
              exile(thisSpell),
              delay(
                beginningOf(upkeep, you, nextTime),
                may(cast(this, payment = withoutPaying)))])))))]
}
