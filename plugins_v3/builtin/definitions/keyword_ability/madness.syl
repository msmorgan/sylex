# "Madness [cost]" means "If a player would discard this card, that player discards it, but exiles
# it instead of putting it into their graveyard" and "When this card is exiled this way, its owner
# may cast it by paying [cost] rather than paying its mana cost. If that player doesn't, they put
# this card into their graveyard." [CR#702.35a]
ability madness(cost: Cost) {
  lexical = {lemma = "madness", parameters = [[Cost]]},
  spelling = "madness <cost>",
  body = [
    static(
      replace(
        would(actor(a(isPlayer)), discard(thisCard)),
        instead(discard(thisCard, destination = exile)))),
    when(
      causes(byEvent(does(any, discard(thisCard))), does(any, exileFrom(thisCard, hand))),
      instruct(
        ownerOf(thisCard),
        mayOrElse(cast(thisCard, exileZone, payingInstead(cost)), putInto(thisCard, graveyard))))]
}
