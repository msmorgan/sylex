# "Evoke [cost]" means "You may cast this card by paying [cost] rather than paying its mana cost"
# and "When this permanent enters, if its evoke cost was paid, its controller sacrifices it."
# [CR#702.74a]
ability evoke(cost: Cost) {
  lexical = {lemma = "evoke", parameters = [[Cost]]},
  spelling = "evoke <cost>",
  body = [
    static(altCost(this, cost)),
    when(
      does(actor(thisPermanent), enter),
      if = keywordCostPaid(evoke, thisPermanent),
      action = instruct(controllerOf(thisPermanent), sacrifice(thisPermanent)))]
}
