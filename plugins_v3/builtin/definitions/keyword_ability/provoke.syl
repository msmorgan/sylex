# "Provoke" means "Whenever this creature attacks, you may choose to have target creature
# defending player controls block this creature this combat if able. If you do, untap that
# creature." [CR#702.39a]
ability provoke {
  lexical = {lemma = "provoke"},
  spelling = "provoke",
  body = [
    whenever(
      does(actor(thisCreature), attack),
      may(
        establishThroughout(
          must(
            actor(target(and([isCreature, controlledBy(defendingPlayer)]))),
            block(thisCreature)),
          untilEndOfCombat),
        untap(that(creature))))]
}
