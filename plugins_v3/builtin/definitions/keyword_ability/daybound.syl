# "Daybound" means "If it is night and this permanent is represented by a double-faced card, it
# enters transformed," "As it becomes night, if this permanent is front face up, transform it,"
# and "This permanent can't transform except due to its daybound ability." [CR#702.145b]
ability daybound {
  lexical = {lemma = "daybound"},
  spelling = "daybound",
  body = [
    static(
      replace(
        would(actor(thisPermanent), enter),
        doIf(gameIs(night), withRiders([entersTransformed])))),
    static(
      asEvent(
        gameBecomes(night),
        doIf(is(thisPermanent, currentFace(front)), transform(thisPermanent)))),
    static(cant(any, transform(thisPermanent), except = byKeyword(daybound)))]
}
