# "monstrosity N" with its reminder text (`Definition`, [CR#701.37a]): an instruction about
# "this permanent", the Source, that the ability's controller follows [CR#608.2c,701.37c].
action monstrosity(amount: Amount) {
  lexical = {
    nouns = [
      {lemma = "monstrosity", frames = [Complement(Amount)], parameters = [[Head, Slot(Amount)]]}]},
  spelling = "monstrosity <amount>",
  body = doIf(
    not(is(thisPermanent, hasDesignation(monstrous))),
    sequentially(
      [
        putCounters($amount, printedKind(p1p1Counter), thisPermanent),
        gainDesignation(thisPermanent, monstrous)]))
}
