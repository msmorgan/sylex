# "<performer> amasses <subtype> N" with its reminder text (`Definition`, [CR#701.47a]): the
# chosen Army is `that (.type .creature)` and `it`, resolved inside `ownScope`.
action amass(subtype: Subtype, count: Amount) {
  spelling = "amass <subtype> <count>",
  lexical = {verbs = [{lemma = "amass", frames = [TransitiveAmount, Monotransitive]}]},
  body = sequentially(
    [
      doIf(
        not(exists(and([hasSubtype(army), isCreature, actorControls]))),
        create(1, written(creatureToken(0, 0, [black], [subtype, army])))),
      choose(a(and([hasSubtype(army), isCreature, actorControls]))),
      putCounters(count, printedKind(p1p1Counter), that(type(creature))),
      doIf(
        not(is(it, hasSubtype(subtype))),
        become(it, {characteristics = {subtypes = [subtype]}}))])
}
