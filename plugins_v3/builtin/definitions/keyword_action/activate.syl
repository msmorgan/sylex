# "activate <subject> [from <from_>] [paying <payment>]" (`Definition`, [CR#701.2a]).
action activate(
  subject: NounPhrase,
  from: Option(Location) = none,
  payment: PlayPayment = itsOwnCost,
  resulting: Option(Predicate) = none) {
  # TODO(spelling): Include or omit the clauses supplied by from_, resulting.
  lexical = {verbs = [{lemma = "activate", frames = [Monotransitive, Intransitive]}]},
  body = procedure(activate, subject, payment, resulting, from)
}
