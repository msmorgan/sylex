# "Airbend <subject>" (`Definition`, [CR#701.65a]): per-card `doForEach` loop over
# `allOf(and([card, did(any, exile(which), thisWay)]))` where `it` resolves by `D′` to the
# singular loop referent.
action airbend(subject: NounPhrase) {
  lexical = {
    verbs = [{lemma = "airbend", past = "airbent", frames = [Monotransitive, Intransitive]}]},
  spelling = "airbend <subject>",
  body = sequentially(
    [
      exile($subject),
      doForEach(
        allOf(and([isCard, did(any, exile(which), within = thisWay)])),
        instruct(
          ownerOf(it),
          establish(
            can(actor(ownerOf(it)), cast(it, exileZone, payingInstead(mana([generic(2)])))),
            forAsLongAs(is(it, in(exileZone))))))])
}
