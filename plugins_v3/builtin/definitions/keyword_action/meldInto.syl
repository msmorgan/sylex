# "meld <subject> into <name>" (`Definition`, [CR#701.42,701.42a]).
action meldInto(subject: NounPhrase, into: String) {
  lexical = {verbs = [{lemma = "meld", frames = [TransitiveWithPP(["into"])]}]},
  deed = "meld",
  spelling = "meld <subject> into <into>",
  body = move($subject, anywhere, battlefield, arrival, [entersMelded($into)])
}
