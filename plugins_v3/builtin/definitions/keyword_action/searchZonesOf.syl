# "search <whose> graveyard, hand, and library for <for>", the owner written once
# (`Definition`, [CR#701.23]). The `for_` parameter is bound like any other (there is no opt-out).
action searchZonesOf(whose: NounPhrase, for: NounPhrase) {
  spelling = "search <whose>'s graveyard, hand, and library for <for>",
  lexical = {
    verbs = [
      {
        lemma = "search",
        frames = [TransitiveWithPP(["for"]), Monotransitive, Prepositional(["for"])]}]},
  deed = "search",
  body = actionSearch(and([zone(graveyard, whose), zone(hand, whose), zone(library, whose)]), for)
}
