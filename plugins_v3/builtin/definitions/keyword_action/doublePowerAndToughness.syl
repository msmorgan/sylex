# "double <subject>'s power and toughness": it gets +X/+Y, X its power and Y its toughness
# (`Definition`, [CR#701.10b,701.10c]).
action doublePowerAndToughness(subject: NounPhrase, duration: Option(Duration) = none) {
  # TODO(spelling): Include or omit the clauses supplied by duration.
  lexical = {verbs = [{lemma = "double", frames = [Monotransitive]}]},
  deed = "double",
  body = get(subject, up(powerOf(subject)), up(toughnessOf(subject)), duration)
}
