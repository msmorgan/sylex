# "empower Jace N" (`Definition`, [CR#701.71a]): "If you don't control a Jace planeswalker token,
# create a blue Jace planeswalker token with 0 loyalty, '[−1]: Surveil 1,' and '[−3]: Draw a card.'
# Choose a Jace planeswalker token you control. Put N loyalty counters on it."
action empowerJace(amount: Amount) {
  lexical = {
    verbs = [
      {
        lemma = "empower Jace",
        third_singular = "empowers Jace",
        past = "empowered Jace",
        gerund = "empowering Jace",
        frames = [Amount]}]},
  spelling = "empower Jace <amount>",
  body = sequentially(
    [
      doIf(
        not(exists(and([isToken, isPlaneswalker, hasSubtype(jace), actorControls]))),
        create(
          1,
          written(
            {
              characteristics = {
                colors = [blue],
                types = [planeswalker],
                subtypes = [jace],
                text = [
                  activated(loyaltySymbol(down(1)), surveil(1)),
                  activated(loyaltySymbol(down(3)), draw(1))],
                loyalty = 0}}))),
      choose(a(and([isToken, isPlaneswalker, hasSubtype(jace), actorControls]))),
      putCounters(amount, printedKind(loyaltyCounter), it)])
}
