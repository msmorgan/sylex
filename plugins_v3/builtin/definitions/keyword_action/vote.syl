# "vote for <ballot> [<times> times]" (`Definition`, [CR#701.38]).
action vote(
  disclosure: Disclosure = openly,
  ballot: Ballot = anyBallot,
  times: Option(Quantity) = none) {
  # TODO(spelling): Include or omit the clauses supplied by times.
  lexical = {verbs = [{lemma = "vote", frames = [Prepositional(["for"]), Intransitive]}]},
  body = actionVote(none, disclosure, ballot, times)
}
