card {
  name = "Shimmering Glasskite",
  cost = [3, blue],
  types = [creature],
  subtypes = [spirit],
  text = [
    flying,
    whenever(
      nthOccurrence(
        nth(1),
        does(actor(a(or([isSpell, abilityHead(anyOnStack)]))), target(thisCreature)),
        turn),
      counter(that(stack)))],
  power = 2,
  toughness = 3
}
