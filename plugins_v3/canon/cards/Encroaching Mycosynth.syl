card {
  name = "Encroaching Mycosynth",
  cost = [3, blue],
  types = [artifact],
  text = [
    static(
      qualityChange(
        and([
          allOf(and([isPermanent, non(isLand), youControl])),
          allOf(
            and([
              or([isArtifact, isBattle, isCreature, isEnchantment, isPlaneswalker]),
              isSpell,
              youControl])),
          allOf(and([isCard, isPermanentCard, non(isLand), youOwn, not(in(battlefield))]))]),
        adds,
        bundle({characteristics = {types = [artifact]}})))]
}
