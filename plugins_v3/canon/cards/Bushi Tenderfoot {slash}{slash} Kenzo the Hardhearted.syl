card flip(
  {
    normal = {
      name = "Bushi Tenderfoot",
      cost = [white],
      types = [creature],
      subtypes = [human, soldier],
      text = [
        when(
          does(
            actor(
              a(
                and(
                  [
                    isCreature,
                    did(
                      actor(thisCreature),
                      dealDamage(recipient = which),
                      within(soFarThisTurn))]))),
            die),
          flip(thisCreature))],
      power = 1,
      toughness = 1},
    alternative = {
      name = "Kenzo the Hardhearted",
      supertypes = [legendary],
      types = [creature],
      subtypes = [human, samurai],
      text = [doubleStrike, bushido(2)],
      power = 3,
      toughness = 4}})
