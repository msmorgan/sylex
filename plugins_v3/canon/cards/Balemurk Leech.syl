card {
  name = "Balemurk Leech",
  cost = [1, black],
  types = [creature],
  subtypes = [leech],
  text = [
    eerie(
      whenever(
        does(actor(a(and([isEnchantment, youControl]))), enter),
        joins = [joinedHead(does(actor(you), fullyUnlock(a(hasSubtype(room)))))],
        action = instruct(eachOpponent, loseLife(1))))],
  power = 2,
  toughness = 2
}
