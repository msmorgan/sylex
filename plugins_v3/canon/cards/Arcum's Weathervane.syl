card {
  name = "Arcum's Weathervane",
  cost = [2],
  types = [artifact],
  text = [
    activated(
      compound([mana([2]), tapSymbol]),
      establish(
        qualityChange(
          target(and([isLand, hasSupertype(snow)])),
          loses,
          bundle({characteristics = {supertypes = [snow]}})))),
    activated(
      compound([mana([2]), tapSymbol]),
      establish(
        qualityChange(
          target(and([isLand, hasSupertype(basic), not(hasSupertype(snow))])),
          adds,
          bundle({characteristics = {supertypes = [snow]}}))))]
}
