card {
  name = "Daru Warchief",
  cost = [2, white, white],
  types = [creature],
  subtypes = [human, soldier],
  text = [
    static(
      costShift(
        allOf(and([hasSubtype(soldier), isSpell, did(actor(you), cast(which), thisObject)])),
        less(1))),
    static(getsPt(allOf(and([hasSubtype(soldier), isCreature, youControl])), up(1), up(2)))],
  power = 1,
  toughness = 1
}
