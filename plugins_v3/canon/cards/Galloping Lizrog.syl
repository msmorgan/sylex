card {
  name = "Galloping Lizrog",
  cost = [3, green, blue],
  types = [creature],
  subtypes = [frog, lizard],
  text = [
    trample,
    when(
      does(actor(thisCreature), enter),
      may(
        removeCounters(
          anyNumber,
          printedKind(p1p1Counter),
          among(allOf(and([isCreature, youControl])))),
        putCounters(times(2, thatMuch), printedKind(p1p1Counter), thisCreature)))],
  power = 3,
  toughness = 3
}
