card {
  name = "Pithing Needle",
  cost = [1],
  types = [artifact],
  text = [
    static(entersChoosing(thisArtifact, cardName)),
    static(
      cant(
        any,
        activate(
          allOf(
            and([
              abilityHead(anyActivated),
              abilityOf(allOf(and([isSource, named(chosenName)]))),
              not(isManaAbility)])))))]
}
