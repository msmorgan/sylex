card {
  name = "Oppressive Rays",
  cost = [white],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
        gatedBy(mana([3]), actor(enchanted(creature)), attack),
        gatedBy(mana([3]), actor(enchanted(creature)), block)])),
    static(
      costShift(allOf(and([abilityHead(anyActivated), abilityOf(enchanted(creature))])), more(3)))]
}
