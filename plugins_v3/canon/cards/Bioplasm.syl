card {
  name = "Bioplasm",
  cost = [3, green, green],
  types = [creature],
  subtypes = [ooze],
  text = [
    whenever(
      does(actor(thisCreature), attack),
      sequentially([
        exile(topSlice(1)),
        doIf(
          is(it, and([isCard, isCreature])),
          get(
            thisCreature,
            up(powerOf(the(and([was(exile(which)), isCreature, isCard])))),
            up(toughnessOf(it)),
            thisTurn))]))],
  power = 4,
  toughness = 4
}
