card {
  name = "Arachnoform",
  cost = [1, green],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
          getsPt(enchanted(creature), up(2), up(2)),
          abilityGrant(enchanted(creature), reach),
          qualityChange(enchanted(creature), adds, everyTypeOf(creature))]))]
}
