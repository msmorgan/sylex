card {
  name = "Sugar Coat",
  cost = [2, blue],
  types = [enchantment],
  subtypes = [aura],
  text = [
    flash,
    enchant(or([isCreature, hasSubtype(food)])),
    static(
      conjunction(
        [
          qualityChange(
            enchanted(permanent),
            sets,
            bundle(
              {
                characteristics = {
                  types = [artifact],
                  subtypes = [food],
                  text = [
                    activated(
                      compound([mana([2]), tapSymbol, perform(sacrifice(thisArtifact))]),
                      gainLife(3))]}})),
          allAbilityLoss(it)]))]
}
