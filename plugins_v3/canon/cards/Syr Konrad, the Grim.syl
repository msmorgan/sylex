card {
  name = "Syr Konrad, the Grim",
  cost = [3, black, black],
  supertypes = [legendary],
  types = [creature],
  subtypes = [human, knight],
  text = [
    whenever(
      does(actor(a(and([isCreature, isOther]))), die),
      or = [
        does(any, putInto(a(and([isCard, isCreature])), graveyard, from = not(battlefield))),
        does(actor(a(and([isCreature, in(yourGraveyard)]))), leave(from = yourGraveyard))],
      action = instruct(this, dealDamage(1, eachOpponent))),
    activated(mana([1, black]), instruct(eachPlayer, mill(1)))],
  power = 5,
  toughness = 4
}
