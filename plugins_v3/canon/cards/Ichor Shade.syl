card {
  name = "Ichor Shade",
  cost = [2, black],
  types = [creature],
  subtypes = [phyrexian, shade],
  text = [
    at(
      beginningOfYour(endStep),
      if = was(
        putIntoFromBattlefield(a(or([isArtifact, isCreature])), graveyard),
        within(soFarThisTurn)),
      action = putCounters(1, printedKind(p1p1Counter), thisCreature))],
  power = 2,
  toughness = 3
}
