card {
  name = "Fiery Emancipation",
  cost = [3, red, red, red],
  types = [enchantment],
  text = [
    static(
      replace(
        would(
          actor(a(and([isSource, youControl]))),
          dealDamage(recipient = a(or([isPermanent, isPlayer])))),
        instead(instruct(it, dealDamage(times(3, thatMuch), thatJoin)))))]
}
