card {
  name = "Krosan Druid",
  cost = [2, green],
  types = [creature],
  subtypes = [centaur, druid],
  text = [
    kicker(mana([4, green])),
    when(
      does(actor(thisCreature), enter),
      if = keywordCostPaid(kicker, thisCreature),
      action = gainLife(10))],
  power = 2,
  toughness = 3
}
