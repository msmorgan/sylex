card {
  name = "Celebrate the Harvest",
  cost = [3, green],
  types = [sorcery],
  text = [
    spell(
      sequentially(
        [
          search(yourLibrary, counted(upToOf(letter(x)), and([isLand, hasSupertype(basic)]))),
          define(x, distinctCount(value(power), allOf(and([isCreature, youControl])))),
          putOntoBattlefieldTapped(those(card)),
          shuffle]))]
}
