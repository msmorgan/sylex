card {
  name = "Embercleave",
  cost = [4, red, red],
  supertypes = [legendary],
  types = [artifact],
  subtypes = [equipment],
  text = [
    flash,
    static(costShift(this, less(forEach(1, and([isCreature, isAttacking, youControl]))))),
    when(does(actor(thisEquipment), enter), attachTo(it, target(and([isCreature, youControl])))),
    static(
      conjunction([
          getsPt(equipped(creature), up(1), up(1)),
          abilityGrant(equipped(creature), doubleStrike),
          abilityGrant(equipped(creature), trample)],
        subject = equipped(creature))),
    equip(mana([3]))]
}
