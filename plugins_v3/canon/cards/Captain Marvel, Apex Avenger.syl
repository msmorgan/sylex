card {
  name = "Captain Marvel, Apex Avenger",
  cost = [5, red, white],
  supertypes = [legendary],
  types = [creature],
  subtypes = [human, kree, hero],
  text = [
    flying,
    doubleStrike,
    indestructible,
    whenever(
      does(by(you), putCounters(anyAmount, anyKind, a(and([isCreature, isOther])))),
      if = is(it, not(hasSubtype(kree))),
      action = may(putCounters(thatMuch, thoseCounters, this)))],
  power = 4,
  toughness = 4
}
