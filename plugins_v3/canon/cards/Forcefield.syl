card {
  name = "Forcefield",
  cost = [3],
  types = [artifact],
  text = [
    activated(
      mana([1]),
      establishThroughout(
        replace(
          would(
            actor(aYourChoice(and([isCreature, isUnblocked]))),
            dealDamage(recipient = you, kind = combat)),
          instead(preventDamage(allBut(1))),
          use = nextTimeOnly),
        thisTurn))]
}
