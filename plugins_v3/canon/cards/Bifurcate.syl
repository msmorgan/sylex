card {
  name = "Bifurcate",
  cost = [3, green],
  types = [sorcery],
  text = [
    spell(
      sequentially([
        search(
          yourLibrary,
          a(
            and(
              [isPermanentCard, shares(cardName, share, target(and([isCreature, isNontoken])))]))),
        putOntoBattlefield(that(card)),
        shuffle]))]
}
