card {
  name = "Lignify",
  cost = [1, green],
  types = [kindred, enchantment],
  subtypes = [treefolk, aura],
  text = [
    enchant(isCreature),
    static(
      conjunction(
        [
          qualityChange(
            enchanted(creature),
            sets,
            bundle({characteristics = {subtypes = [treefolk]}})),
          getsBase(it, 0, 4),
          allAbilityLoss(it)]))]
}
