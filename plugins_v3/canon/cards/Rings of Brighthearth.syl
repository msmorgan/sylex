card {
  name = "Rings of Brighthearth",
  cost = [3],
  types = [artifact],
  text = [
    whenever(
      does(actor(you), activate(a(abilityHead(anyActivated)))),
      if = not(is(that(ability), isManaAbility)),
      action = may(
        pay(mana([2]), once),
        sequentially([copyOnStack(that(ability)), may(chooseNewTargets(that(copied(ability))))])))]
}
