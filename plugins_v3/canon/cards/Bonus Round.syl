card {
  name = "Bonus Round",
  cost = [1, red, red],
  types = [sorcery],
  text = [
    spell(
      delayWithin(
        does(actor(a(isPlayer)), cast(a(and([isInstantOrSorcery, isSpell])))),
        untilEndOfTurn,
        sequentially([
          instruct(that(player), copyOnStack(it)),
          instruct(that(player), may(chooseNewTargets(that(copy))))])))]
}
