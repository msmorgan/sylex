card {
  name = "Academy Journeymage",
  cost = [4, blue],
  types = [creature],
  subtypes = [human, wizard],
  text = [
    static(onlyIfSo(costShift(this, less(1)), exists(and([hasSubtype(wizard), youControl])))),
    when(
      does(actor(thisCreature), enter),
      returnToHand(target(and([isCreature, anOpponentControls]))))],
  power = 3,
  toughness = 2
}
