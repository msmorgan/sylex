card {
  name = "Exquisite Archangel",
  cost = [5, white, white],
  types = [creature],
  subtypes = [angel],
  text = [
    flying,
    static(
      replace(
        would(actor(you), loseGame),
        instead(
          sequentially(
            [exile(thisCreature), setLife(statOf(playerStat(startingLifeTotal), you))]))))],
  power = 5,
  toughness = 5
}
