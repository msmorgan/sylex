card {
  name = "Yedora, Grave Gardener",
  cost = [4, green],
  supertypes = [legendary],
  types = [creature],
  subtypes = [treefolk, druid],
  text = [
    whenever(
      does(actor(a(and([isNontoken, and([isCreature, youControl]), isOther]))), die),
      may(
        sequentially([
          returnToBattlefield(
            it,
            [
              faceDownAs({characteristics = {types = [land], subtypes = [forest]}}),
              under(ownerOf(it))])])))],
  power = 5,
  toughness = 5
}
