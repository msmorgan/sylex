card {
  name = "Sonic Shrieker",
  cost = [2, red, white, black],
  types = [creature],
  subtypes = [dragon],
  text = [
    flying,
    when(
      does(actor(thisCreature), enter),
      sequentially(
        [
          instruct(it, dealDamage(2, target(isAnyTarget))),
          gainLife(2),
          doIf(
            was(dealDamage(recipient = a(isPlayer)), thisWay),
            instruct(they, discard(a(cardIn(hand)))))]))],
  power = 4,
  toughness = 4
}
