card {
  name = "Twinshot Sniper",
  cost = [3, red],
  types = [artifact, creature],
  subtypes = [goblin, archer],
  text = [
    reach,
    when(does(actor(thisCreature), enter), instruct(it, dealDamage(2, target(isAnyTarget)))),
    channel(
      activated(
        compound([mana([1, red]), perform(discard(this))]),
        instruct(it, dealDamage(2, target(isAnyTarget)))))],
  power = 2,
  toughness = 3
}
