card {
  name = "Awesome Presence",
  cost = [blue],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      gatedBy(
        scaledGenericMana(
          forEach(3, and([isCreature, controlledBy(they), inCombat(blockerOf, it)]))),
        any,
        block(enchanted(type(creature)))))]
}
