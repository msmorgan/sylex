card {
  name = "Stunning Shot",
  cost = [1, white],
  types = [sorcery],
  text = [
    spell(
      sequentially([
        putCounters(2, printedKind(p1p1Counter), targets(upTo(1), and([isCreature, youControl]))),
        tap(targets(upTo(1), and([isCreature, anOpponentControls]))),
        putCounters(1, printedKind(stunCounter), it)]))]
}
