card {
  name = "Fire Servant",
  cost = [3, red, red],
  types = [creature],
  subtypes = [elemental],
  text = [
    static(
      replace(
        would(actor(a(and([isInstantOrSorcery, hasColor(red), youControl]))), dealDamage),
        instead(instruct(it, dealDamage(times(2, thatMuch))))))],
  power = 4,
  toughness = 3
}
