card {
  name = "Collected Company",
  cost = [3, green],
  types = [instant],
  text = [
    spell(
      sequentially(
        [
          lookAt(topSlice(6)),
          putOntoBattlefield(fromAmong(upTo(2), and([isCreature, hasManaValue(atMost, 3)]), them)),
          putInto(theRest, onBottom, riders = [inOrder(anyOrder)])]))]
}
