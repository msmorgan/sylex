card {
  name = "Mishra's Factory",
  types = [land],
  text = [
    activated(tapSymbol, addMana(1, manaOf([[colorless]]))),
    activated(
      mana([1]),
      establishThroughout(
        qualityChange(
          thisLand,
          sets,
          bundle({
              characteristics = {
                types = [artifact, creature],
                subtypes = [assemblyWorker],
                power = 2,
                toughness = 2}},
            land)),
        untilEndOfTurn)),
    activated(
      tapSymbol,
      get(target(and([isCreature, hasSubtype(assemblyWorker)])), up(1), up(1), untilEndOfTurn))]
}
