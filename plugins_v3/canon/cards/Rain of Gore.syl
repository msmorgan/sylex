card {
  name = "Rain of Gore",
  cost = [black, red],
  types = [enchantment],
  text = [
    static(
      replace(
        causedBy(
          bySource(a(or([isSpell, abilityHead(anyOnStack)]))),
          would(actor(controllerOf(it)), gainLife(anyAmount))),
        instead(instruct(that(player), loseLife(thatMuch)))))]
}
