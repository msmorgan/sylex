card {
  name = "Infernal Vessel",
  cost = [2, black],
  types = [creature],
  subtypes = [human, cleric],
  text = [
    when(
      does(actor(thisCreature), die),
      if = not(is(it, hasSubtype(demon))),
      action = sequentially(
        [
          returnToBattlefieldWithCounters(it, ownerOf(it), 2, p1p1Counter),
          become(it, {characteristics = {subtypes = [demon]}})]))],
  power = 2,
  toughness = 1
}
