card {
  name = "Inferno Elemental",
  cost = [4, red, red],
  types = [creature],
  subtypes = [elemental],
  text = [
    whenever(
      does(actor(thisCreature), block(a(isCreature))),
      or = [does(by(a(isCreature)), block(thisCreature))],
      action = instruct(thisCreature, dealDamage(3, that(creature))))],
  power = 4,
  toughness = 4
}
