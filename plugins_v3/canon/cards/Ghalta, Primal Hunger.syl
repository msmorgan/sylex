card {
  name = "Ghalta, Primal Hunger",
  cost = [10, green, green],
  supertypes = [legendary],
  types = [creature],
  subtypes = [elder, dinosaur],
  text = [
    static(
      conjunction([
        costShift(this, less(letter(x))),
        letterDefinition(x, aggregate(sum, stat(power), and([isCreature, youControl])))])),
    trample],
  power = 12,
  toughness = 12
}
