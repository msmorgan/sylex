card {
  name = "Retro-Mutation",
  cost = [2, blue],
  types = [enchantment],
  subtypes = [aura],
  text = [
    flash,
    enchant(isCreature),
    static(
      conjunction(
        [
          qualityChange(
            enchanted(creature),
            sets,
            bundle({characteristics = {subtypes = [turtle]}})),
          getsBase(it, 0, 1),
          cant(actor(it), attack),
          allAbilityLoss(it)]))]
}
