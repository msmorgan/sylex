card {
  name = "Approach of the Second Sun",
  cost = [6, white],
  types = [sorcery],
  text = [
    spell(
      doIf(
        and([
            is(this, did(any, cast(which, from = yourHand), thisObject)),
            did(
              actor(you),
              cast(a(and([isSpell, isOther, named(printedName("Approach of the Second Sun"))]))),
              within(thisGame))]),
        winGame,
        sequentially([putInto(this, fromTop(7, library)), gainLife(7)])))]
}
