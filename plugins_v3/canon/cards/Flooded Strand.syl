card {
  name = "Flooded Strand",
  types = [land],
  text = [
    activated(
      compound([tapSymbol, perform(payLife(1)), perform(sacrifice(thisLand))]),
      sequentially([
          search(yourLibrary, a(and([isCard, or([hasSubtype(plains), hasSubtype(island)])]))),
          putOntoBattlefield(it),
          shuffle]))]
}
