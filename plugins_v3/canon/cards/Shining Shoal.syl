card {
  name = "Shining Shoal",
  cost = [variable, white, white],
  types = [instant],
  subtypes = [arcane],
  text = [
    static(
      altCost(
        this,
        perform(exile(a(and([hasColor(white), hasManaValue(eq, letter(x)), in(yourHand)])))))),
    spell(
      establishThroughout(
        replace(
          would(
            actor(aYourChoice(isSource)),
            dealDamage(recipient = andOr([you, allOf(and([isCreature, youControl]))]))),
          instead(redirectDamage(theNext(letter(x)), target(isAnyTarget)))),
        thisTurn))]
}
