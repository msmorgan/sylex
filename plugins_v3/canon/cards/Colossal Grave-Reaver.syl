card {
  name = "Colossal Grave-Reaver",
  cost = [6, black, green],
  types = [creature],
  subtypes = [dragon],
  text = [
    flying,
    whenever(
      does(actor(thisCreature), enter),
      or = [does(actor(thisCreature), attack)],
      action = mill(3)),
    whenever(
      does(
        any,
        putInto(counted(orMore(1), and([isCard, isCreature])), yourGraveyard, from = yourLibrary)),
      putOntoBattlefield(someOf(exactly(1), them)))],
  power = 7,
  toughness = 6
}
