card {
  name = "Talion, the Kindly Lord",
  cost = [2, blue, black],
  supertypes = [legendary],
  types = [creature],
  subtypes = [faerie, noble],
  text = [
    flying,
    static(entersChoosing(thisCreature, number)),
    whenever(
      does(
        actor(anOpponent),
        cast(
          a(
            and([
              isSpell,
              compare(
                eq,
                chosenNumber,
                axes = [stat(manaValue), stat(power), stat(toughness)])])))),
      sequentially([instruct(that(player), loseLife(2)), draw(1)]))],
  power = 3,
  toughness = 4
}
