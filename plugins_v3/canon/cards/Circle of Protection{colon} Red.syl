card {
  name = "Circle of Protection: Red",
  cost = [1, white],
  types = [enchantment],
  text = [
    activated(
      mana([1]),
      establishThroughout(
        replace(
          would(actor(aYourChoice(and([isSource, hasColor(red)]))), dealDamage(recipient = you)),
          instead(preventDamage(allDamage)),
          use = nextTimeOnly),
        thisTurn))]
}
