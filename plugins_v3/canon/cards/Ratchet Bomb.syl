card {
  name = "Ratchet Bomb",
  cost = [2],
  types = [artifact],
  text = [
    activated(tapSymbol, putCounters(1, printedKind(chargeCounter), thisArtifact)),
    activated(
      compound([tapSymbol, perform(sacrifice(thisArtifact))]),
      destroy(
        each(
          and(
            [
              non(isLand),
              isPermanent,
              hasManaValue(eq, countersOn(chargeCounter, thisArtifact))]))))]
}
