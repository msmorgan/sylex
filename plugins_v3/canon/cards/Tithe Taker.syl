card {
  name = "Tithe Taker",
  cost = [1, white],
  types = [creature],
  subtypes = [human, soldier],
  text = [
    static(
      partScope(
        turn,
        you,
        conjunction([
          costShift(
            allOf(and([isSpell, did(actor(yourOpponents), cast(which), thisObject)])),
            more(1)),
          costShift(
            allOf(
              and([
                abilityHead(anyActivated),
                did(actor(yourOpponents), activate(which), thisObject),
                not(isManaAbility)])),
            more(1))]))),
    afterlife(1)],
  power = 2,
  toughness = 1
}
