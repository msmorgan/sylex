# Jared Carthalion, True Heir: "You can't become the monarch this turn" is a prohibition over
# `gainDesignation`, an event head [CR#101.2,725.1].
card {
  name = "Jared Carthalion, True Heir",
  cost = [red, green, white],
  supertypes = [legendary],
  types = [creature],
  subtypes = [human, warrior],
  text = [
    when(
      does(actor(thisCreature), enter),
      sequentially([
        gainDesignation(target(isOpponent), monarch),
        establishThroughout(cant(actor(you), gainDesignation(you, monarch)), thisTurn)])),
    static(
      onlyWhile(
        replace(
          would(any, dealDamage(recipient = thisCreature)),
          instead(
            preventDamage(
              allDamage,
              also = putCounters(preventedThisWay, printedKind(p1p1Counter), thisCreature)))),
        is(you, hasDesignation(monarch))))],
  power = 3,
  toughness = 3
}
