card {
  name = "Danitha, New Benalia's Light",
  cost = [1, green, white],
  supertypes = [legendary],
  types = [creature],
  subtypes = [human, knight],
  text = [
    vigilance,
    trample,
    lifelink,
    static(
      can(
        actor(you),
        cast(
          counted(exactly(1), and([isSpell, or([hasSubtype(aura), hasSubtype(equipment)])])),
          from = yourGraveyard),
        timing = onEachOfYourTurns))],
  power = 2,
  toughness = 2
}
