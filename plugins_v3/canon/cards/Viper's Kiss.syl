card {
  name = "Viper's Kiss",
  cost = [black],
  types = [enchantment],
  subtypes = [aura],
  text = [
    enchant(isCreature),
    static(
      conjunction([
          getsPt(enchanted(creature), down(1), down(1)),
          cant(any, activate(allOf(and([abilityHead(anyActivated), abilityOf(it)]))))]))]
}
