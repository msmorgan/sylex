card {
  name = "Whirling Dervish",
  cost = [green, green],
  types = [creature],
  subtypes = [human, monk],
  text = [
    protection(hasColor(black)),
    at(
      beginningOfPossessed(endStep, eachPlayer),
      if = did(actor(thisCreature), dealDamage(recipient = anOpponent), within(soFarThisTurn)),
      action = putCounters(1, printedKind(p1p1Counter), it))],
  power = 1,
  toughness = 1
}
