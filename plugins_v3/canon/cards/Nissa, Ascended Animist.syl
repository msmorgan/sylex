card {
  name = "Nissa, Ascended Animist",
  cost = [3, green, green, phyrexianPip(green), phyrexianPip(green)],
  supertypes = [legendary],
  types = [planeswalker],
  subtypes = [nissa],
  text = [
    compleated,
    activated(
      loyaltySymbol(up(1)),
      sequentially(
        [
          create(1, written(creatureTokenOf(letter(x), letter(x), [green], [phyrexian, horror]))),
          define(x, statOf(stat(loyalty), thisPlaneswalker))])),
    activated(loyaltySymbol(down(1)), destroy(target(or([isArtifact, isEnchantment])))),
    activated(
      loyaltySymbol(down(7)),
      establishFor(
        allOf(and([isCreature, youControl])),
        [
          getsPt(
            them,
            up(forEach(1, and([hasSubtype(forest), youControl]))),
            up(forEach(1, and([hasSubtype(forest), youControl])))),
          abilityGrant(them, trample)],
        untilEndOfTurn))],
  loyalty = 7
}
