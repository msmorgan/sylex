card {
  name = "Answered Prayers",
  cost = [1, white, white],
  types = [enchantment],
  text = [
    when(
      does(actor(a(and([isCreature, youControl]))), enter),
      sequentially([
          gainLife(1),
          doIf(
            not(is(thisEnchantment, isCreature)),
            become(
              thisEnchantment,
              {
                characteristics = {
                  types = [creature],
                  subtypes = [angel],
                  text = [flying],
                  power = 3,
                  toughness = 3}},
              untilEndOfTurn))]))]
}
