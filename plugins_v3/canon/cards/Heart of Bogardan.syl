card {
  name = "Heart of Bogardan",
  cost = [2, red, red],
  types = [enchantment],
  text = [
    cumulativeUpkeep(mana([2])),
    when(
      does(actor(a(isPlayer)), pay(anyCost, once, unpaid, thisEnchantment, cumulativeUpkeep)),
      sequentially([
          simultaneously([
              instruct(this, dealDamage(letter(x), target(or([isPlaneswalker, isPlayer])))),
              instruct(
                this,
                dealDamage(
                  letter(x),
                  each(and([isCreature, controlledBy(splitOverPlaneswalker)]))))]),
          define(x, minus(times(2, countersOn(ageCounter, thisEnchantment)), 2))]))]
}
