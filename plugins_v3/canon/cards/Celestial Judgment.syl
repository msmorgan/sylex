card {
  name = "Celestial Judgment",
  cost = [4, white, white],
  types = [sorcery],
  text = [
    spell(
      sequentially([
        doForEachKind(
          value(power),
          allOf(isCreature),
          number,
          choose(a(and([isCreature, hasPower(eq, chosenNumber)])))),
        destroy(each(and([isCreature, notChosen])))]))]
}
