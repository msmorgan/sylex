card {
  name = "Blast of Genius",
  cost = [4, blue, red],
  types = [sorcery],
  text = [
    spell(
      sequentially([
        choose(target(isAnyTarget)),
        draw(3),
        discard(a(cardIn(yourHand))),
        instruct(
          this,
          dealDamage(
            statOf(stat(manaValue), the(and([was(discard(which)), isCard]))),
            thatJoin))]))]
}
