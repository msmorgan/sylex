card {
  name = "Disrupting Shoal",
  cost = [variable, blue, blue],
  types = [instant],
  subtypes = [arcane],
  text = [
    static(
      altCost(
        this,
        perform(exile(a(and([hasColor(blue), hasManaValue(eq, letter(x)), in(yourHand)])))))),
    spell(
      doOnlyIf(counter(target(isSpell)), compareAmt(statOf(stat(manaValue), it), eq, letter(x))))]
}
