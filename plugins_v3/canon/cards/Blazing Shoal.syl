card {
  name = "Blazing Shoal",
  cost = [variable, red, red],
  types = [instant],
  subtypes = [arcane],
  text = [
    static(
      altCost(
        this,
        perform(exile(a(and([hasColor(red), hasManaValue(eq, letter(x)), in(yourHand)])))))),
    spell(get(target(isCreature), up(letter(x)), up(0), untilEndOfTurn))]
}
