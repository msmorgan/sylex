card {
  name = "The Flux",
  cost = [2, red, red],
  types = [enchantment],
  subtypes = [saga],
  text = [
    when(
      chapterMark([1]),
      instruct(this, dealDamage(4, target(and([isCreature, anOpponentControls]))))),
    when(
      chapterMark([2, 3, 4, 5]),
      sequentially(
        [exile(topSlice(1)), establishThroughout(can(actor(you), play(that(card))), thisTurn)])),
    when(chapterMark([6]), addMana(6, manaOf([[of(red)]])))]
}
