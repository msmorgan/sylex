card {
  name = "Culling Scales",
  cost = [3],
  types = [artifact],
  text = [
    at(
      beginningOfYour(upkeep),
      destroy(
        target(
          and(
            [
              isPermanent,
              non(isLand),
              superlative(min, stat(manaValue), and([isPermanent, non(isLand)]))]))))]
}
