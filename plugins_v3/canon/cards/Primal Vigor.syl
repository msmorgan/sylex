card {
  name = "Primal Vigor",
  cost = [4, green],
  types = [enchantment],
  text = [
    static(
      replace(
        would(any, createObject(anyAmount, token(copyOf(counted(orMore(1), isToken)), []))),
        instead(create(times(2, groupSize), asThose)))),
    static(
      replace(
        would(any, putCounters(anyAmount, printedKind(p1p1Counter), a(isCreature))),
        instead(putCounters(times(2, thatMuch), printedKind(p1p1Counter), that(creature)))))]
}
