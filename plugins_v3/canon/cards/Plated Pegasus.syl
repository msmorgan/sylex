card {
  name = "Plated Pegasus",
  cost = [2, white],
  types = [creature],
  subtypes = [pegasus],
  text = [
    flash,
    flying,
    static(
      replace(
        would(actor(a(isSpell)), dealDamage(recipient = a(or([isPermanent, isPlayer])))),
        instead(preventDamage(ofThatDamage(1)))))],
  power = 1,
  toughness = 2
}
