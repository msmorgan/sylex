card {
  name = "Dazzling Reflection",
  cost = [1, white],
  types = [instant],
  text = [
    spell(
      sequentially([
        gainLife(powerOf(target(isCreature))),
        establishThroughout(
          replace(
            would(actor(that(creature)), dealDamage),
            instead(preventDamage(allDamage)),
            use = nextTimeOnly),
          thisTurn)]))]
}
