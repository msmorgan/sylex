card {
  name = "Unesh, Criosphinx Sovereign",
  cost = [4, blue, blue],
  supertypes = [legendary],
  types = [creature],
  subtypes = [sphinx],
  text = [
    flying,
    static(
      costShift(
        allOf(and([hasSubtype(sphinx), isSpell, did(actor(you), cast(which), thisObject)])),
        less(2))),
    whenever(
      does(actor(eitherOf(thisCreature, a(and([hasSubtype(sphinx), youControl, isOther])))), enter),
      sequentially([
        reveal(topSlice(4)),
        instruct(anOpponent, separateIntoPiles(them, 2)),
        putInto(onePile, hand),
        putInto(theOther, graveyard)]))],
  power = 4,
  toughness = 4
}
