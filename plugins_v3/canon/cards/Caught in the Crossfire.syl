card {
  name = "Caught in the Crossfire",
  cost = [red, red],
  types = [instant],
  text = [
    spell(
      chooseSpree([
        {
          cost = mana([1]),
          action = instruct(this, dealDamage(2, each(and([isCreature, isOutlaw]))))},
        {
          cost = mana([1]),
          action = instruct(this, dealDamage(2, each(and([isCreature, non(isOutlaw)]))))}]))]
}
