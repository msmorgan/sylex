card {
  name = "Commander's Insignia",
  cost = [2, white, white],
  types = [enchantment],
  text = [
    static(
      getsPt(
        allOf(and([isCreature, youControl])),
        up(
          eventCount(cast(headed(spell, yourCommander), from = commandZone), actor(you), thisGame)),
        up(
          eventCount(
            cast(headed(spell, yourCommander), from = commandZone),
            actor(you),
            thisGame))))]
}
