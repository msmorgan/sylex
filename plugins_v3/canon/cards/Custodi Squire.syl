card {
  name = "Custodi Squire",
  cost = [4, white],
  types = [creature],
  subtypes = [spirit, cleric],
  text = [
    flying,
    willOfTheCouncil(
      when(
        does(actor(thisCreature), enter),
        sequentially([
          instruct(
            eachPlayer,
            voteStartingWith(
              you,
              openly,
              byCandidate(
                a(and([or([isArtifact, isCreature, isEnchantment]), in(yourGraveyard)]))))),
          returnToHand(allOf(and([isCard, withMostVotes])))])))],
  power = 3,
  toughness = 3
}
