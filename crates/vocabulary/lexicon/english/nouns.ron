// Core common nouns. Catalog items (card types, subtypes, counter kinds,
// designations, phases and steps, tokens, keywords) live in catalogs/.
// A `PP(["of"])` frame marks an of-phrase that expresses a semantic argument of
// a relational noun (CGEL, Ch. 5, §14.1, pp. 440–442); an of-phrase that only
// describes ("a creature of your choice") is a modifier and gets no frame.
// `PPWith(["of"], NP)` is the same where the argument is an object or player,
// never an amount, gerund or bare nominal (*the mana value of instant and
// sorcery cards* never has *of instant*).
[
    (lemma: "bidding", countability: [Mass], bare_mass_modified: true),
    // Game nouns.
    // *activated abilities of creatures*: the of-phrase names the object that
    // has the ability, its source [CR#113.1a,113.7]: an entity involved in
    // what the noun denotes, as a natural source or an owner is (CGEL, Ch. 5,
    // §14.1, p. 442, [7v], [7vii]), and it alternates with a genitive (*a
    // creature's abilities*; §16.5.3, p. 475).
    (lemma: "ability", frames: [Complement(PP(["of"]))]),
    "activation",
    (lemma: "amount", distribution: HeadOnly, frames: [Complement(PP(["of"]))]),
    "attacker",
    // Pre-head dependent in "base power and toughness"; a noun, so that it
    // scopes over the coordination.
    "base",
    "battlefield",
    (lemma: "beginning", frames: [Complement(PP(["of"]))]),
    (lemma: "bid", frames: [Complement(PP(["of"]))]),
    "bidder",
    "blocker",
    "booster",
    "box",
    // *on the bottom of*; prenominal *bottom* is the adjective.
    (lemma: "bottom", distribution: HeadOnly, frames: [Complement(PP(["of"]))]),
    "card",
    "chapter",
    "characteristic",
    // The event of the keyword action [CR#701.30]: *Whenever you win a clash*.
    "clash",
    // *your choice of a flying counter or a first strike counter*; *your
    // choice of 5/1 or 1/5*.
    (lemma: "choice", frames: [Complement(PP(["of"])), Complement(PPWith(["of"], MeasureNP))]),
    "coin",
    "color",
    // "until end of combat" (mass); "attacks each combat" (count).
    // *each combat*
    (lemma: "combat", kind: Temporal, countability: [Count, Mass]),
    (lemma: "combination", frames: [Complement(PP(["of"]))]),
    (lemma: "control", countability: [Mass], bare_mass_modified: true, frames: [Complement(PP(["of"]))]),
    (lemma: "controller", frames: [Complement(PP(["of"]))]),
    (lemma: "copy", frames: [Complement(PP(["of"]))]),
    // "an additional cost to cast this spell"; "the mana cost for Rune spells".
    (lemma: "cost", frames: [Complement(PP(["for", "of"])), Complement(ToInf)]),
    // A counter on an object; Oracle never uses it attributively (*Counter
    // target spell* is the verb), unlike a counter kind (*+1/+1 counter*).
    (lemma: "counter", distribution: HeadOnly),
    "crime",
    (lemma: "d4", plural: "d4"),
    (lemma: "d6", plural: "d6"),
    (lemma: "d8", plural: "d8"),
    (lemma: "d10", plural: "d10"),
    (lemma: "d12", plural: "d12"),
    (lemma: "d20", plural: "d20"),
    (lemma: "damage", distribution: DirectMeasure, countability: [Mass]),
    "deck",
    (lemma: "devotion", countability: [Mass], bare_mass_modified: true, frames: [Complement(PP(["to"]))]),
    (lemma: "die", plural: "dice"),
    (lemma: "difference", frames: [Complement(PP(["between"]))]),
    // What a player faces by choosing modes for a spell or ability [CR#700.17]: *Whenever you
    // face a dilemma*.
    "dilemma",
    "direction",
    (lemma: "door", frames: [Complement(PP(["of"]))]),
    "draft",
    // "the game is a draw".
    (lemma: "draw", distribution: HeadOnly),
    "effect",
    "emblem",
    (lemma: "end", frames: [Complement(PP(["of"]))]),
    // "in excess of the number you control"; prenominal *excess* is the adjective.
    // The amount over a limit is a count noun (*the excess*). It is bare only as
    // the noun of the fossilized *in excess of* (CGEL, Ch. 7 §3.1, p. 618; §5.3,
    // p. 646), a bare count nominal after *in*; it is never a bare Noun Phrase
    // (Ch. 2 §5, p. 57), so it cannot head one across *excess damage*.
    (lemma: "excess", distribution: HeadOnly, frames: [Complement(PP(["of"]))]),
    "exchange",
    // The zone; the verb is a keyword action [CR#701.13].
    (lemma: "exile", countability: [Mass]),
    // A card's text cites an expansion by its Set Name, before the noun
    // [CR#206.3a..206.3c] (*the Antiquities expansion*).
    (lemma: "expansion", parameters: [[Slot(SetName), Head]]),
    "face",
    "flip",
    "foe",
    "friend",
    (lemma: "game", kind: Temporal),
    // Each player has their own library, hand and graveyard [CR#400.1]: the
    // of-phrase names the player whose zone it is (*the graveyard of the
    // player*), a term in that relation (CGEL, Ch. 5, §14.1, p. 442).
    (lemma: "graveyard", frames: [Complement(PPWith(["of"], NP))]),
    (lemma: "half", plural: "halves", frames: [Complement(PP(["of"]))]),
    // Bare after a preposition it omits *of X*, as *top* does (*cards in
    // hand*).
    (lemma: "hand", frames: [Complement(PPWith(["of"], NP)), Intransitive]),
    // The faces of a coin (*comes up heads*).
    (lemma: "heads", countability: [Mass]),
    (lemma: "tails", countability: [Mass]),
    (lemma: "instance", frames: [Complement(PP(["of"]))]),
    "item",
    (lemma: "kind", frames: [Complement(PP(["of"]))]),
    "label",
    "left",
    "legend",
    (lemma: "library", frames: [Complement(PPWith(["of"], NP))]),
    (lemma: "life", distribution: DirectMeasure, countability: [Mass]),
    // *has starting loyalty X*, as *power 3*; *having 0 loyalty*.
    (lemma: "loyalty", distribution: DirectMeasure, countability: [Mass], bare_mass_modified: true, frames: [Complement(Amount)]),
    (lemma: "mana", distribution: DirectMeasure, countability: [Mass]),
    // *to a maximum of 10*; the attributive *maximum* is the adjective's.
    (lemma: "maximum", distribution: HeadOnly, frames: [Complement(PP(["of"]))]),
    "mode",
    // A card's name [CR#201.1] and its bearer (*the name of a nonland card*;
    // CGEL, Ch. 5, §14.1, p. 442, [7i]). The Subject of a copy's exception
    // that gives a name (*except its name is Mishra's Warform*).
    (lemma: "name", classes: ["NameNoun"], frames: [Complement(PPWith(["of"], NP))]),
    // *a number 0 or greater*, as *a mana value 0 or greater*.
    (lemma: "number", distribution: Quantity, frames: [Complement(PP(["of"])), Complement(Amount)]),
    "offer",
    // *the opponent to your left*
    (lemma: "opponent", frames: [Complement(PP(["to"]))]),
    (lemma: "order", countability: [Count, Mass], bare_mass_modified: true),
    // A prefix joins it with a hyphen, as a subtype (*non-outlaw*).
    (lemma: "outlaw", prefix_hyphenation: Hyphenated),
    (lemma: "owner", frames: [Complement(PP(["of"]))]),
    "pack",
    (lemma: "pair", frames: [Complement(PP(["of"]))]),
    (lemma: "part", frames: [Complement(PP(["of"]))]),
    "party",
    "permanent",
    (lemma: "phase", kind: Temporal),
    "pile",
    // *the player to your right*
    (lemma: "player", frames: [Complement(PP(["to"]))]),
    // "each point of bushido it has".
    (lemma: "point", frames: [Complement(PP(["of"]))]),
    "pool",
    // Count across creatures (*different powers*) and mass as an unquantified
    // characteristic (*power and toughness*, *power 3 or less*, *power equal to …*).
    (lemma: "power", countability: [Count, Mass], bare_mass_modified: true, frames: [Complement(PP(["of"])), Complement(Amount)]),
    "process",
    "quality",
    (lemma: "radiation", countability: [Mass]),
    // Quantificational "the rest (of …)" has no plural.
    (lemma: "rest", countability: [Mass], bare_mass_modified: true, frames: [Complement(PP(["of"]))]),
    (lemma: "result", frames: [Complement(PP(["of"]))]),
    "right",
    // The result of rolling a die: *ignore the lower roll* (OSG §12,
    // Randomness, dice, coins, and voting).
    "roll",
    (lemma: "round", kind: Temporal),
    "rule",
    "size",
    "source",
    "speed",
    "spell",
    "stack",
    "stake",
    (lemma: "step", kind: Temporal),
    "symbol",
    // Not the Targeting Marker of "target creature", which has a Determinative Lexeme.
    // *the target of a spell or ability*: the spell or ability whose target
    // it is [CR#115.1], a term in the relation the noun denotes (CGEL, Ch. 5,
    // §14.1, pp. 441–442).
    (lemma: "target", distribution: HeadOnly, frames: [Complement(PPWith(["of"], NP))]),
    "team",
    "teammate",
    // A quoted ability follows *text* as its apposition (*has the text
    // "{2}: Discard a card."*; CGEL, Ch. 5 §14.3, p. 447).
    (lemma: "text", countability: [Mass], bare_mass_modified: true, frames: [Complement(PP(["of"])), Complement(QuotedAbility)]),
    "tie",
    (lemma: "time", kind: Temporal, distribution: Serial),
    // It heads the description of a token the text names (*create Angelo, a
    // legendary 1/1 green and white Dog creature token*).
    (lemma: "token", classes: ["TokenNoun"]),
    // *on top of*; prenominal *top* is the adjective. Bare after a
    // preposition it may omit *of X*, as *in front* does (*put that card on
    // top*; CGEL, Ch. 7 §3.1, p. 620), unlike *end* or *excess*.
    (lemma: "top", distribution: HeadOnly, frames: [Complement(PP(["of"])), Intransitive]),
    (lemma: "toughness", countability: [Count, Mass], bare_mass_modified: true, frames: [Complement(PP(["of"])), Complement(Amount)]),
    (lemma: "turn", kind: Temporal),
    "type",
    // "for the same value", "double the value of X".
    (lemma: "value", frames: [Complement(PP(["of"]))]),
    // *the total of those results*; the attributive word is the adjective.
    (lemma: "total", distribution: HeadOnly, frames: [Complement(PP(["of"]))]),
    "vote",
    "voter",
    (lemma: "way", kind: Manner),
    "word",
    "zone",

    // The five colors as nouns converted from the adjectives (CGEL, Ch. 19
    // §3.3, p. 1642): "devotion to blue", "a color other than white".
    // Prenominal and bare predicative *green* are the adjective.
    (lemma: "black", countability: [Mass], distribution: HeadOnly),
    (lemma: "blue", countability: [Mass], distribution: HeadOnly),
    (lemma: "green", countability: [Mass], distribution: HeadOnly),
    (lemma: "red", countability: [Mass], distribution: HeadOnly),
    (lemma: "white", countability: [Mass], distribution: HeadOnly),

    // Multiword rules terms, each one Lexeme.
    (lemma: "color identity", frames: [Complement(PP(["of"]))]),
    // *the combat damage of each creature attacking you*: the creature that
    // assigns it [CR#510.1a], its source (CGEL, Ch. 5, §14.1, p. 442, [7v]).
    (lemma: "combat damage", distribution: DirectMeasure, countability: [Mass], frames: [Complement(PPWith(["of"], NP))]),
    // A zone name [CR#408.1]; `command` occurs in no other sense.
    "command zone",
    // A player's life total [CR#119.1] and its bearer (*the life total of an
    // opponent*; CGEL, Ch. 5, §14.1, p. 442, [7i]).
    (lemma: "life total", frames: [Complement(PPWith(["of"], NP))]),
    // Where an object in none of the game's zones is [CR#400.11]: a count
    // conjunct beside zone nouns under their determiner, only in Invasion of
    // Arcavios and Turtles Forever (*search your library, graveyard, and/or
    // outside the game*). Elsewhere *outside* is the preposition (*from
    // outside the game*, *cards you own outside the game*).
    "outside the game",
    (lemma: "mana cost", countability: [Count, Mass], bare_mass_modified: true, frames: [Complement(PP(["for", "of"])), Complement(Cost)]),
    // An object's mana value [CR#202.3] and its bearer (*the mana value of the
    // exiled card*; CGEL, Ch. 5, §14.1, p. 442, [7i]), as *power* takes.
    (lemma: "mana value", countability: [Count, Mass], bare_mass_modified: true, frames: [Complement(PPWith(["of"], NP)), Complement(Amount)]),
    // [CR#103.6]; `opening` occurs in no other sense.
    "opening hand",
    // The mana cost of a locked half, paid to unlock it [CR#709.5e].
    "unlock cost",

    // Ordinary nouns that cards name as choice options (*chooses war or
    // peace*) or that their text also uses. A vote option is a Name in
    // `catalogs/vote_options.ron` [CR#701.38b].
    (lemma: "chaos", countability: [Mass]),
    (lemma: "evidence", countability: [Mass]),
    (lemma: "fame", countability: [Mass]),
    (lemma: "fortune", countability: [Count, Mass]),
    (lemma: "money", countability: [Mass]),
    (lemma: "peace", countability: [Mass]),
    "secret",
    (lemma: "silence", countability: [Mass]),
    "snitch",
    (lemma: "war", countability: [Count, Mass]),
    // A measure noun: *five {P} worth of modes* (CGEL Ch. 5, p. 470).
    (lemma: "worth", distribution: DirectMeasure, countability: [Mass], bare_mass_modified: true, frames: [Complement(PP(["of"]))]),
]
