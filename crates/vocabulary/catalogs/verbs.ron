// Catalog verbs shared across game phrases: neither ordinary English
// (`lexicon/english/verbs.ron`) nor owned by one keyword entry.
[
    // "Beam me up [cost]" [CR#702.196a] and "can't be beamed up" [CR#702.196b].
    (lemma: "beam", frames: [TransitiveWithPP(["up"])]),
    // "Faces a dilemma" [CR#700.17] and "faces a villainous choice" [CR#701.55a],
    // including "face that choice" [CR#701.55c] and the set-off option clause
    // (`docs/oracle-style-guide.md` §14, Keyword actions in sentences: *faces a
    // villainous choice — They discard their hand, or you draw three cards*).
    (lemma: "face", frames: [Monotransitive, TransitiveWithComplement(SetOffClause)]),
]
