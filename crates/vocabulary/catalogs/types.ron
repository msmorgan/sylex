// Card types and supertypes [CR#205.2a,205.4a].
// Out of scope: conspiracy, phenomenon, plane, scheme, vanguard (card types) and
// ongoing (a Scheme-only supertype).
(
    card_types: [
        "artifact",
        "battle",
        (lemma: "creature", relative_gender: Dual),
        "dungeon",
        "enchantment",
        "instant",
        "kindred",
        "land",
        (lemma: "planeswalker", relative_gender: Dual),
        "sorcery",
    ],
    supertypes: ["basic", "legendary", "snow", "world"],
)
