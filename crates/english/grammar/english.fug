// The Oracle English grammar data file. It names Categories, features,
// Schemas and core closed-class lexemes only: every other word, and every
// Subcategorization Frame, comes from the lexical environment it is bound to.
// Citations: `CGEL 15§3.6:1335` is The Cambridge Grammar of the English
// Language, Ch. 15 §3.6, p. 1335; `OSG` is `docs/oracle-style-guide.md`;
// `english.md` is `docs/design/english.md`.
root Document

// Whether a keyword phrase carries a Keyword Parameter (*protection from
// red*) or none (*flying*; a Keyword Mention, *with flashback*).
feature KeywordForm = Bare | Parametric
// `SetOff` kinds follow an em dash: a set-off cost ends in its own period,
// a set-off ability runs to the end of the line (OSG §3, Periods).
feature FinalParameter = Cost | SetOffCost | SetOffAbility
feature Number = Singular | Plural
// The Number of a noun's *of* oblique or a determinative's Complement (*all
// but one*).
feature ObliqueNumber = Singular | Plural
// `Equative` and `NonScalarInequality` are the comparisons a non-scalar
// governor marks: *as* (*same*), *than* (*different*, *other*; CGEL
// 13§1.1:1100). `Mixed` resolves coordinates of differing grades (*less than
// or equal to …*).
feature Grade = Plain | Comparative | Superlative | Equative | NonScalarInequality | Mixed
// Internal numeral–noun agreement survives external group respecification.
feature QuantityNumber = Singular | Plural
// The Number of each conjunct of an *and*-coordination of nominals; the
// coordination itself is plural.
feature ConjunctNumber = Singular | Plural
// The first conjunct's Number in an *and*-coordination of Noun Phrases;
// existential *be* may agree with it (CGEL 4§3.2.2:242 n. 21).
feature FirstConjunctNumber = Singular | Plural
// Oracle text has no first person.
feature Person = Second | Third
feature VerbForm = Plain | Finite | GerundParticiple | PastParticiple
// `To`: a clause whose Verb Phrase carries *to*, made only by ToInfinitival
// (CGEL 2§14:64–65).
feature ClauseMarking = Unmarked | To | Relative
feature Voice = Active | Passive
// Privative: a verb whose Adjectival Passive is a declared Adjective
// (*tapped*), and that Adjective. The grammar does not derive the Adjective
// from the verb's participle again, and the participle, not the Adjective,
// postmodifies with a Complement (*Aura attached to a creature*).
feature AdjectivalPassive = Lexical
// `Modal`: modal auxiliaries (*can*, *may*, *must*, *will*); `Auxiliary`:
// non-modal NICE verbs (*be*, *have*, *don't*); `Lexical`: all other verbs;
// `Mixed`: a coordination of unlike VerbKinds.
feature VerbKind = Lexical | Auxiliary | Modal | Mixed
// A Clause's or Verb Phrase's time, two privative features, each carried or
// not; the lexicon's tense gives them: a preterite carries `Past`, a present
// `NonPast`. A modal's preterite is ambiguous between past time and modal
// remoteness, remoteness being much the more common (CGEL 3§2.4:107), so the
// form fixes no time and carries neither; nor does a plain form or a
// participle, whose verb leaves its time open (CGEL 3§7:162), nor irrealis
// *were*. A phrase carries its head's time and its time-giving dependents'
// (TimeGiving), and a coordination every time any conjunct carries.
feature PastTime = Past
feature NonPastTime = NonPast
// A prefixed negative premodifier's (*nonland*, *nonattacking*, *non-Aura*):
// `Negative` on an Adjective Phrase, a participle or a noun premodifier under
// a negative prefix, and on an Attribute over one; otherwise unvalued. The
// lexicon also values it on an auxiliary's forms (*can*, *can't*); of the
// phrases a verb heads, only a Participle carries it.
feature Polarity = Affirmative | Negative
// The Slot Kind of the Complement a phrase's head selects (`Intransitive`:
// none), on a Preposition, Adjective or Determiner Phrase and a nominal. An
// Amount's names a comparative bound's Complement, and `Amount` on an
// Adjective Phrase marks a number with its comparative bound
// (ComparativeBoundedAlternative). `MeasureNP`: only *of*
// (*your choice of 5/1 or 1/5*) and *among* (*from among flying, ..., and
// +1/+1*). `QuotedAbility`: only Nominal-hosted
// *with* (*a token with "This token can't block."*; [CR#113.1a]). `Name`:
// only *among* (*from among Disenchant, ..., and Black Lotus*) and, under
// *meld*, *into* (*meld them into Brisela, Voice of Nightmares*).
feature ComplementKind =
    | NP | MeasureNP | PP | AdjP | AdvP | Nominal | Amount | FiniteClause | TemporalClause
    | ComparativeClause | ExpandableClause | SetOffClause | VerblessClause | AbsoluteClause | ToInf
    | Gerund | BareInf | KeywordPhrase | QuotedAbility | Mention | Cost | Intransitive | AmountOrNP
    | UnlikeObject | Name
// What an unlike coordination's conjunct is, which no other conjunct of it
// shares (`unlike: ConjunctKind`): the Category of its filler. A conjunct of
// a derived unlike Frame Slot takes the name of the Slot Kind its filler
// fills (`NP`, `MeasureNP`, `Amount`, `KeywordPhrase`, `QuotedAbility`), so
// the slot admits only conjuncts of the kinds its head selects (slots
// `AmountOrNP` and `UnlikeObject`). `NounPremodifier` and `Participial` name
// a noun premodifier and a participial Verb Phrase.
feature ConjunctKind =
    | NP | MeasureNP | PP | AdjP | AdvP | NounPremodifier | Amount | Participial | KeywordPhrase
    | QuotedAbility
// What a nominal's Premodifier is: an Adjective Phrase, a slash measure, a
// bare keyword or a participle. Before *counter* a measure or keyword may be
// its kind (KindPremodifier), and neither a keyword nor a participle
// premodifies a nominal that needs a determiner. An Attributes premodifier
// leaves it unvalued.
feature PremodifierKind = Adjectival | Measure | Keyword | Participial
// The Slot Kind of a determinative's Preposition Phrase's Complement: the
// values of ComplementKind, which it agrees with.
feature ObliqueKind =
    | NP | MeasureNP | PP | AdjP | AdvP | Nominal | Amount | FiniteClause | TemporalClause
    | ComparativeClause | ExpandableClause | SetOffClause | VerblessClause | AbsoluteClause | ToInf
    | Gerund | BareInf | KeywordPhrase | QuotedAbility | Mention | Cost | Intransitive | AmountOrNP
    | UnlikeObject | Name
// `Quantity`: only *number*, the number-transparent noun (*any number
// of target creatures*; CGEL 5§3.3:349–351). `Serial`: only *time*, a
// frequency or multiplier head (*three times*; CGEL 8§9:715).
feature NounDistribution = Ordinary | Quantity | DirectMeasure | HeadOnly | Serial
// Privative: a non-count noun whose bare nominal stands as a Noun Phrase only
// with a Complement, Modifier or shared coordination (*power 3*, *mana value
// less than X*, *control of target creature*, *turn order*, *power and
// toughness*), never as an unmodified single word.
feature BareMass = Modified
// Whether a `BareMass = Modified` Nominal is still a bare single-word head
// (`Unmodified`) or has a Complement or Modifier (`Expanded`), so
// `CoordinatedBareMass` admits a coordinated Nominal only when at least one
// conjunct could not stand as a `ModifiedBareMass` Noun Phrase on its own.
feature BareMassHead = Unmodified | Expanded
// `Quantity`: a fused-head quantity (*choose one*). `Manner`: only *way*,
// the one noun that is a Manner Adjunct without a preposition (*do it this
// way*; CGEL 8§2.1:671). `Resource`: a measured mass quantity or symbol
// sequence (*X damage*, *1 life*, *{R}*). `Quotation`: a quoted cost
// (QuotedCostHead), which coordinates with no nominal of another kind.
feature NounKind = Ordinary | Temporal | Manner | Numeric | Quantity | Resource | Quotation
// The NounKind of a head's *of* oblique.
feature ObliqueNounKind =
    | Ordinary | Temporal | Manner | Numeric | Quantity | Resource | Quotation
// Whether a Noun Phrase or Preposition Phrase has a determiner: `Mixed`
// resolves a coordination of differing conjuncts.
feature Determination = Bare | Mixed | Overt
// The Determination of a determinative's Complement (*than one*).
feature ObliqueDetermination = Bare | Mixed | Overt
// Privative: a nominal that stands in a Noun Phrase only under an overt
// determiner (*a natural 20*, *the first creature*), and an adjective or
// premodifier that passes that need to its nominal (*only*, an ordinal). A
// bare Noun Phrase excludes it.
feature DeterminerNeed = Required
// Privative: a Noun Phrase headed by a personal pronoun (CGEL 5§10.2:429–430)
// or serving as a proper name (5§2:328, 5§20.3–20.4:520–521), neither of
// which takes integrated nominal postmodifiers; a coordination carries it
// whenever any conjunct does, so no nominal postmodifier scopes over one
// (15§1.3.4:1286).
feature Postmodification = Closed
// Privative and local: a Noun Phrase with a dependent outside its own
// determiner, a predeterminer, a multiplier or a focusing adverb (*all three
// cards*, *half the creature*, *three times this creature*, *only this
// creature*). Being local it is the outermost such
// phrase's alone. HeadFinalPossessor excludes it.
feature Periphery = External { local }
// The DeterminativeDistribution of a determinative's Complement's
// Noun Phrase (*all but [the highest roll]*).
feature ObliqueDistribution =
    | Dependent | Independent | Numerical | IndefiniteArticle | Distributive | Deictic
    | SingularOrQuantified | FreeChoice | Multiplier | Targeting | Degree
feature AdjectivePosition = Attributive | Predicative
feature Sign = Negative | Zero | Positive
// `Existential`: only dummy *there* (CGEL 16§6.2:1394).
feature PronounKind = Personal | Existential | Relative
// `FreeChoice`: only *any*. Determined excludes it so *any* takes number
// transparency (FreeChoiceDetermined, TransparentQuantity,
// TemporalQuantity; never *any number of target creatures becomes*), and
// builds no second tree of an analysis FreeChoiceDetermined builds (the
// gate is Determined's).
// `IndefiniteArticle`: only *a*. `SingularOrQuantified`: only *another*,
// which also takes a quantified plural (*another three bodies*; CGEL
// 5§3.4:353) and determines a temporal location Noun Phrase (*another day*;
// 8§6.3:698). TemporalLocation refuses *a*, an admission gate.
// `Targeting`: only the Targeting Marker *target*. Kept apart from
// `Dependent` and `Degree`, which FusedDegreeDeterminer and DegreePartitive
// require: it never fuses or partitions (not *choose target*, *target of
// those*).
// `Degree`: a degree determinative (*that many*, *as much*) and what it
// determines, which a multiplier joins as a quantity, never as a Noun Phrase.
feature DeterminativeDistribution =
    | Dependent | Independent | Numerical | IndefiniteArticle | Distributive | Deictic
    | SingularOrQuantified | FreeChoice | Multiplier | Targeting | Degree
feature Case = Plain | Nominative | Accusative | Genitive
feature Countability = Count | Mass
// Where an Adverb Phrase stands, its head's position class (the lexicon's
// `AdverbPosition`): `Front`, `Central` and `End` in a clause; `Phrasal`
// inside a phrase it focuses (*only one target*); `Bounding` on a quantity's
// determinative or numeral (*at least two*); `Linking`, a connective initial
// in its Linked Conjunct; `Multiplying`, a multiplier (*twice the damage*),
// also a frequency adverb (*draw a card twice*), which modifies a Noun Phrase
// or measure, never a Preposition Phrase or temporal Noun Phrase (one tree,
// english.md §8).
feature AdjunctPosition = Front | Central | End | Phrasal | Multiplying | Bounding | Linking
// A Clause whose front position holds a comma-set dependent (*If you do,
// ...*). Dependents sharing one comma are siblings in one Production (*Then
// if ...*), so a comma-less front Adverb Phrase never also precedes such a
// Clause (english.md §8). A coordination takes it from its first conjunct:
// dependents sharing one comma are siblings whether they scope over that
// conjunct or the whole (*Once each turn, C1, and C2*), never split between
// the two.
feature FrontPosition = Occupied
// A Verb Phrase that begins with a central Adjunct (*also gains trample*).
// Before a bare imperative the adverb is the Clause's front Adjunct, never
// also this (english.md §8). A coordination begins where its first conjunct does.
feature CentralPosition = Occupied
// Privative: a Verb Phrase that is an auxiliary stranded before its
// Complement's ellipsis site (*than you do*, *if you can't*; the Code of the
// NICE properties, CGEL 3§2.1.4:99), and the Clause it heads. A coordination
// carries none: one stranded conjunct does not make *than [you lost life or
// did]* an elliptical clause.
feature Ellipsis = Code
// Privative and local: a Clause that is its Subject and its Verb Phrase and
// no more, so it opens with its Subject, as a bare relative's must (CGEL
// 12§3.5.5:1055). The Productions of a Subject and its predicate value it,
// and being local it is on no Clause built over one: none with a preposed or
// comma-set dependent, and no coordination. BareRelative, BarePredicativeRelative
// and AdverbialRelative carry it, an admission gate (english.md §6) that
// keeps *each turn, those coins come up heads* from an adverbial relative of
// *The first time you flip one or more coins* (Edgar, King of Figaro).
feature ClauseShape = SubjectInitial { local }
// Privative and local: a Nominal whose last postmodifier is a relative
// clause, or temporal Noun Phrases after one (*next time you cast a spell
// this turn*), and the relative clause as its Postmodifier.
// RelativePostmodifier values it, NominalPostmodifier takes it from the
// Postmodifier and TemporalPostmodifier keeps its head's; being local it is
// on no Nominal with any other postmodifier after the relative or a
// premodifier outside it, and on no coordination.
// RelativeTemporalLocation carries it, an admission gate (english.md §6): without
// the relative, every determined temporal nominal is a temporal Adjunct too
// (*End [the turn]*, Time Stop).
feature RelativeBound = Bound { local }
// Privative and local: a Noun Phrase whose comparative or equative
// determiner's Complement follows its head (*more lands than you*, *as many
// cards as they discarded*).
feature Comparison = Compared { local }
// Privative: an existential predicate with its locative or temporal
// Complement (LocatedExistentialBe), which alone takes a Preposition Phrase
// Adjunct after it: one right after the displaced subject is that Complement.
feature ExistentialLocation = Located
// A lexicon-declared fused-head adjective naming a Quality (*protection
// from multicolored*).
feature QualityHead = Fused
// A slash measure with `+` or `-` signs (*+2/+0*, *-1/-1*), as opposed to an
// unsigned power/toughness (*2/2*).
feature Adjustment = Signed
// A Determiner Phrase headed by `TargetingMarker` (*two target*, *up to one
// other target*), which determines a nominal and never nests inside another
// determiner, quantity or partitive.
feature TargetMarked = Marked
// A license feature (english.md §3), which the counter catalog declares:
// `Kind` on a counter's kind name (*charge*, *time*), which stands only as
// the kind of the noun *counter*, and on a keyword a keyword counter can be
// [CR#122.1b]; `Head` on *counter*, the one noun a kind premodifies. A kind
// word before *counter* keeps its other analyses only where the two straddle
// a constituent boundary (`head: Head`, docs/design/lexicon.md §5): *five or
// more [plot counters]* is no verb and its Object (Deadly Designs), while
// *the first time [counters have been put on that creature]* stands
// (Stalwart Successor).
feature KindLicense = Kind | Head { head: Head }
// A license feature (english.md §3), which a noun's parameter pattern
// declares: `Head` on a noun a Set Name premodifies (*expansion*), which
// takes no other premodifier there.
feature SetNameLicense = Head
feature Inflection =
    | Invariant | IndependentGenitive | Singular | Plural | Plain | Present | Preterite | Irrealis
    | GerundParticiple | PastParticiple

category Document
category Paragraphs
category ModalHeader
category ModalAbility
category SymbolCosts
category ActivationCost
category NonManaCost
category Mode
category ModeEffect
category Effect
category Pawprints
category TypeModifier
category Modes
category Ability
category TypeLine
category CardTypes
category Subtypes
category KeywordList
category Quality
// Privative: an Introduced Name named again, outside the positions that
// introduce one (*Ragavan enters tapped and attacking*).
feature NameMention = Repeated
// A name is number-neutral: the agreement its text shows fixes its Number
// (*When The Notary Hobbits enter*, *Mizzium Mortars deals*), and where the
// text shows none it stays unvalued. Never another card's name, which
// `Lex(Catalog)` does not admit.
category Name [Number, NameMention]
// The name a Complement of *named* introduces: a Name that stands nowhere
// else, so that no other position offers a title run as one.
category NewName : Name
// A card's name before *token*, the name of a token named for that card.
category TokenCardName : Name
// A name in a position that takes a card's name: after *named*, as the
// parameter of *Partner with* [CR#702.124j], as the complement of *among*
// after *from*, wherever that attaches, as in a choice (*choose a card name
// ... from among Disenchant, ..., and Black Lotus*), and as the complement of
// *into* after *meld* (*meld them into Brisela, Voice of Nightmares*). Only
// these admit another card's name, through `OtherCardName()`
// (`docs/design/lexicon.md` §6).
category NameComplement
category Condition
category Measure [Adjustment]
category Symbols
// An Arabic numeral named as a noun, without the numeral's Number.
category NumeralName
// A bracketed loyalty symbol: a cost, or a counted noun (*an
// additional [+1]*).
category LoyaltySymbol
category Header
category RowHeader
category Chapters
category IndexedNominal [Number]
// A Set Name, which a noun's parameter pattern takes before the noun (*the
// Antiquities expansion* [CR#206.3b]). It is no Name, so it stands nowhere
// else.
category SetName
category ChoiceQuantity [Number]
category Sentence
category Sentences
// Inflection is the finite verb's, so an independent clause can exclude
// irrealis *were*. Number and Person are the Subject's, which a
// SubjectRemnant recovers.
category Clause [
    Number, Person, VerbForm, ClauseMarking, Inflection, FrontPosition, PastTime, NonPastTime,
    Ellipsis, ClauseShape,
] { gap }
// Number: a subject relative agrees with its antecedent. NounKind: an
// adverbial relative modifies a temporal nominal.
category RelativeClause [Number, NounKind, ClauseMarking]
// A finite clause whose Subject is its Gap.
category SubjectGapClause : Clause [Number, Person, VerbForm, Inflection] { gap }
// A finite clause with an extracted Adjunct.
category AdjunctGapClause : Clause [VerbForm, ClauseShape] { gap }
// A participle premodifying a nominal (*attacking creature*).
category Participle : VerbPhrase [Inflection, Polarity]
category VerbPhrase [
    Number, Person, VerbForm, Voice, VerbKind, Inflection, AdjectivalPassive, CentralPosition,
    PastTime, NonPastTime, Ellipsis,
] { gap }
// A Linked Conjunct: a Clause or Verb Phrase opened by its linking
// connective (*Each player discards a card, [then draws a card]*), as *so*
// and *yet* are a coordination's sole linking item (CGEL 15§2.10:1320).
category LinkedClause : Clause [
    VerbForm, ClauseMarking, Inflection, FrontPosition, PastTime, NonPastTime,
] { gap }
category LinkedVerbPhrase : VerbPhrase [
    Number, Person, VerbForm, Voice, VerbKind, Inflection, AdjectivalPassive, CentralPosition,
    PastTime, NonPastTime,
] { gap }
// Existential *there*, and the predicate it is subject of.
category DummyPronoun : NounPhrase [Number, Person]
category ExistentialPredicate : VerbPhrase [
    Number, Person, VerbForm, Inflection, ExistentialLocation, PastTime, NonPastTime,
]
category DisplacedSubject : NounPhrase [Number, Case] { gap }
category FusedNounPhrase : NounPhrase [
    Number, Person, Case, Determination, NounKind, Countability, DeterminativeDistribution,
] { gap }
// A symbol sequence as a Noun Phrase, which a Preposition Phrase may
// postmodify (*{X} in its mana cost*).
category SymbolHead : NounPhrase [Number, Person, Case, Determination, NounKind, Countability]
// A determinative or quantity with its partitive oblique (*each of those
// cards that has suspend*); it carries its determinative's distribution.
category PartitiveHead : NounPhrase [
    Number, Person, Case, Determination, NounKind, Countability, DeterminativeDistribution,
] { gap }
// A slash measure as a Noun Phrase (*gets +2/+2*, *gets an additional
// +2/+2*), only where a head selects one or beside keyword phrases naming
// counter kinds; never a general Object.
category MeasureNounPhrase : NounPhrase
// A signed slash adjustment under an attributive premodifier (*additional
// +2/+2*), determined into MeasureNounPhrase.
category ModifiedAdjustment
// A compound locative determinative, which a Preposition Phrase may
// postmodify (*anywhere else*).
category LocativeHead : NounPhrase [Number, Person, Case, Determination, NounKind, Countability]
// DeterminativeDistribution is the determiner's, so an *and*-coordination
// of distributive ones is singular (CGEL 5§18.4:508). The Measure Gap is
// closed: only coordinated Nominals share a slash Measure (*base power and
// toughness 4/4*). NounDistribution is the head noun's, a coordination's
// its last conjunct's (NominalPredicative).
category NounPhrase [
    Periphery, Number, Person, Case, Determination, NounKind, Countability,
    DeterminativeDistribution, FirstConjunctNumber, NounDistribution, Postmodification,
    Comparison,
] { gap, closed_gaps: [Measure] }
// A temporal Adjunct of location (*this turn*; CGEL 8§6.3:698) or frequency
// (*three times*; 8§9:713–716).
category TemporalNounPhrase : NounPhrase [
    Number, Person, Case, Determination, NounKind, Countability,
]
category ComplementNounPhrase : NounPhrase [
    Number, Person, Case, Determination, NounKind, Countability, DeterminativeDistribution,
    Postmodification,
] { gap }
// A nominal's ComplementKind and ObliqueNumber are its head noun's
// Complement's.
category Nominal [
    Number, Countability, NounKind, DeterminerNeed, NounDistribution, ComplementKind,
    ObliqueNumber, ObliqueNounKind, ConjunctNumber, KindLicense, BareMass, BareMassHead,
    RelativeBound,
] { gap }
category QuantifiedNominal : Nominal [QuantityNumber, NounKind, DeterminerNeed, NounDistribution]
category ModifiedQuantifiedNominal : Nominal [
    QuantityNumber, NounKind, DeterminerNeed, NounDistribution,
]
category BareNominal : Nominal [
    Number, Countability, NounKind, DeterminerNeed, NounDistribution, ComplementKind,
    ObliqueNumber, ObliqueKind, ObliqueNounKind, KindLicense, SetNameLicense, BareMass,
] { gap }
// The singular count nominals that share a determiner before the
// final, determined conjunct of a SharedDeterminerCoordination.
category SharedNominals [Number, Countability]
category NounPremodifier : Nominal [Polarity]
// A counter's kind, or a coordination of kinds (*a +1/+1, first strike, or
// vigilance counter*).
category Kind
// A noun premodifier conjunct with an adjective or negative noun
// premodifier of its own (*artifact or [non-Aura enchantment] card*).
category NounPremodifierConjunct : Nominal
category PrepositionalNominal : Nominal [Number, Countability, NounDistribution]
// A number-transparent quantity's oblique determined by the Targeting
// Marker alone (*any number of target creatures*), and its Noun Phrase.
category TargetedOblique : PrepositionPhrase [Number, NounKind]
category TargetedNounPhrase : NounPhrase [Number, NounKind, Countability]
category BareNominalComplement : Nominal
// A genitive on each coordinated nominal (*that creature's or spell's
// controller*), and each genitive.
category GenitiveNominal : Nominal [Number, Countability, NounKind]
category GenitiveNominals : Nominal [Number, Countability, NounKind]
// A genitive's possessor: a Noun Phrase with the Number and Person the
// genitive keeps (HeadFinalPossessor, TransparentPossessor).
category Possessor : NounPhrase [Number, Person, Case]
category NumericalDeterminer : DeterminerPhrase [Number, Countability]
// An ordinal's position from an end (*third from the top*): where a card is
// put, never a nominal's modifier.
category PositionPhrase : AdjectivePhrase
// A determinative that can head a fused Noun Phrase alone (*choose one*),
// and a coordination of such (*one or more*).
category FusableDeterminer : DeterminerPhrase [Number, Countability, NounKind]
category FusedQuantity : DeterminerPhrase [Number, Countability]
// A determiner with its own premodifiers in a delayed right constituent
// coordination over one shared nominal (*[all black and all red] creature
// cards*, Balthor the Defiled; CGEL 5§14.4:449, 15§4.4(d):1344), the
// coordination, and one premodifier. Each Cluster's determiner and
// premodifiers bear their functions in the shared nominal's Noun Phrase
// (`cluster`). A Cluster's premodifier is a Premodifier, so no noun: an
// admission gate (english.md §6), which keeps *each blocking creature and
// each blocked creature* (Warpath) from *[each blocking creature and each
// blocked] creature* and *a creature card and/or a land card* (Green Sun's
// Twilight) from *[a creature card and/or a land] card*.
//
// Premodifier is the premodifier function of a nominal for every premodifier
// but a noun: an Adjective Phrase, a participle, coordinated or asyndetic
// Attributes, a slash measure or a bare keyword. A bare nominal and a
// determiner's Cluster take it alike. PremodifierKind names an Adjective
// Phrase, a measure, a keyword and a participle; DeterminerNeed is an
// adjective's.
category Premodifier [PremodifierKind, DeterminerNeed] { function }
category NominalCluster [
    Number, Countability, DeterminativeDistribution,
] { cluster }
category NominalClusters : NominalCluster [
    Number, ConjunctNumber, Countability, DeterminativeDistribution,
]
// A determinative's Complement has a Number of its own (*all but one*).
category DeterminerPhrase [
    Number, Countability, DeterminativeDistribution, NounKind, ComplementKind,
    ObliqueNumber, ObliqueKind, ObliqueDetermination, ObliqueDistribution, TargetMarked, Grade,
]
category Multiplier
// The Targeting Marker as an outer determiner's head or the determiner of
// TargetedNounPhrase, the word alone or after an adjective (*two target
// creatures*, *a second target creature*, *any number of other target
// creatures*).
category TargetingMarker : DeterminerPhrase [
    Countability, DeterminativeDistribution, NounKind, ComplementKind, ObliqueNumber, ObliqueKind,
    ObliqueDetermination, TargetMarked,
]
// A Preposition Phrase's Number and Determination are its Complement's
// (*up to two*, a determiner; *of them*, a partitive oblique), and so is its
// time (slot `TemporalClause`).
category PrepositionPhrase [
    ComplementKind, Number, Determination, Case, NounKind, Countability, DeterminativeDistribution,
    PastTime, NonPastTime,
] { gap }
// An Adjectival Passive is Passive; it is a predicative Complement
// only, never a depictive Adjunct or a premodifier.
category AdjectivePhrase [
    DeterminerNeed, AdjectivePosition, Voice, ComplementKind, Grade, Polarity, QualityHead,
    AdjectivalPassive,
] { gap }
category AdverbPhrase [AdjunctPosition]
// The predicative Complement function; its head bears it too, and a Gap
// passes through an adjectival predicative (*blocks or becomes blocked by
// a creature*, Dream Fighter; CGEL 15§4.4:1344).
category Predicative { gap, function }
// Unlike categories coordinated as a depictive Adjunct (*onto the
// battlefield tapped and attacking*; CGEL 15§3.2:1326–1329), and each
// conjunct.
category Depictive : Predicative [ConjunctKind] { function }
category DepictiveCoordination : Predicative [ConjunctKind] { function }
// Unlike categories coordinated as a predicate Adjunct (*only during your
// turn and only once each turn*), and each conjunct.
category PredicateAdjunct [ConjunctKind, PastTime, NonPastTime] { function }
// A verb's Complements, each with an optional Adjunct, coordinated after
// the shared verb (*put [one of them into your hand] and [the rest into
// your graveyard]*; CGEL 15§4.3:1341–1343).
category ComplementCluster [PastTime, NonPastTime]
category ClusterCoordination : ComplementCluster [PastTime, NonPastTime]
// A later Cluster's keyword parameters, the keyword elided (*gain
// protection from white if ..., [from blue] if ...*).
category ParameterRemnant
// Clusters of two Preposition Phrase Adjuncts after a head with no
// Complement (*enters [with a +1/+1 counter on it for each other red
// creature you control] and [a +1/+1 counter on it for each other green
// creature you control]*).
category AdjunctCluster [PastTime, NonPastTime]
category AdjunctClusterCoordination : AdjunctCluster [PastTime, NonPastTime]
// A later Adjunct Cluster's Complement, the preposition elided (*[a +1/+1
// counter on it] for each ...*, *with* elided).
category PrepositionRemnant
// A medial Verb Phrase conjunct's Predicative Complement, the copula elided
// (*is enchanted, [equipped], and has a counter on it*; CGEL
// 15§3.6:1335–1336).
category PredicativeRemnant [VerbKind]
// A medial Clause conjunct's finite Verb Phrase, the Subject elided (*you
// gain 4 life, [draw four cards], and he deals 4 damage*; CGEL
// 15§3.6:1335–1336).
category SubjectRemnant [Number, Person, VerbForm]
// *And [so on for double strike, ...]*, standing for further conjuncts of
// its coordination's kind.
category IdiomaticCoordinate
// Predicate Adjuncts that *but* or *and* adds to a whole Clause, and the
// fragment *only* or *not* focuses (*but only during their turn before the
// end step*; CGEL 15§4.5:1347–1348).
category ClauseFragment
category QualifyingFragment
// Unlike premodifiers coordinated, with a coordinator or asyndetically
// (*noncreature, nonland card*), and each premodifier.
category Attributes [ConjunctKind] { function }
// Unlike categories coordinated as an Object or a preposition's Complement
// where the head selects each of them there (*has base power and toughness
// 5/5 and vigilance*; slot `UnlikeObject`), and each conjunct.
category ObjectConjunct : NounPhrase [ConjunctKind] { function }
category ObjectCoordination : NounPhrase [ConjunctKind] { function }
// An Amount and a Noun Phrase coordinated where a head selects both (*equal
// to [2] or [the greatest power among Dinosaurs you control]*), and each
// conjunct.
category AmountOrNounConjunct : NounPhrase [ConjunctKind] { function }
category AmountOrNounPhrase : NounPhrase [ConjunctKind] { function }
// Unlike postmodifiers coordinated (*the player with the most life or tied
// for most life*), and each.
category PostmodifierConjunct : Postmodifier [ConjunctKind] { function }
category PostmodifierCoordination : Postmodifier [ConjunctKind] { function }
category Attribute : Attributes [ConjunctKind, Polarity] { function }
// The premodifiers of an asyndetic chain after its first.
category AttributeChain : Attributes [ConjunctKind] { function }
category AdjunctCoordination : PredicateAdjunct [ConjunctKind, PastTime, NonPastTime] {
    function,
}
// An Adverb Phrase or a frequency Noun Phrase as Complement (*more than
// twice*, *more than three times*).
category Adverbial { function }
// The Adjunct function before a selected Complement or shifted Object.
// NounKind is a Noun Phrase Adjunct's (InterleavedManner).
category Interleaved [PastTime, NonPastTime, NounKind] { function }
// The Adjunct function in central position between *be* or a copula and
// its Complement (*is still on top of your library*, *become no longer
// suspected*; english.md §3).
category CentralAdjunct { function }
// A relative clause before the Complement its noun selects (*Equip
// abilities [you activate] [of other Equipment]*; CGEL 5§15:454).
category InterleavedModifier [Number, NounKind] { function }
// An Object's Modifier postposed past the Complements that follow it or a
// Predicate Preposition Phrase Adjunct (CGEL 12§4:1066), with the Number
// its Object agrees in.
category PostposedModifier [Number] { function }
// An unmarked relative or bare passive past-participial Modifier postposed
// out of the Object past an AdjP-Complement Preposition Phrase Adjunct (*at
// random*).
category BarePostposedModifier : PostposedModifier [Number] { function }
// The Modifier function after a nominal head: a relative clause or a
// participial clause.
category Postmodifier [Number, NounKind, RelativeBound] { function }
// A relative phrase with genitive *whose*.
category RelativeNounPhrase : NounPhrase [Number]
// A preposition and its relative pronoun, fronted (*for which*).
category RelativePrepositionPhrase : PrepositionPhrase
category KeywordPhrase [KeywordForm, FinalParameter, KindLicense]
// A Keyword Phrase in quotation marks (*have "bands with other legendary
// creatures."*, *loses "enchant creature card in a graveyard"*), beside
// the quoted ability. It is lower case, as the phrase is printed bare
// (*has enchant creature and "…"*, The Rani), where a quoted ability opens
// with a capital, so no text is both.
category QuotedKeywordPhrase [KeywordForm, FinalParameter, KindLicense]
category KeywordLineItem [KeywordForm, FinalParameter]
category KeywordParameters [KeywordForm, FinalParameter, KindLicense]
category BoundKeyword [KeywordForm, FinalParameter]
// QuantityNumber agrees with a counted noun (*two cards*); as a Noun Phrase
// an Amount is singular (*X can't be 0*).
category Amount [QuantityNumber, Sign, ComplementKind]
category SignedAmount [Adjustment]
category Cost
// A preposition's or verb's finite Clause Complement. It carries its time,
// which a temporal preposition's phrase takes (slot `TemporalClause`).
category FiniteClause : Clause [PastTime, NonPastTime]
// The Complement of *than* or equative *as* (CGEL 13§2.1:1108).
category ComparativeClause : Clause
category ExpandableClause : Clause
// A dash-set Supplement giving a head's Complement its content
// (SetOffComplementClause).
category SetOffClause : Clause
category VerblessClause : Clause
category AbsoluteClause : Clause
// Subjectless non-finite Complements: a to-infinitival is a Clause, a bare
// infinitival, gerund-participial or past-participial its Verb Phrase. None
// passes up a predicative Gap (*can't be __*); one is shared only inside it
// (*can't be and become legendary*).
category ToInf : Clause { gap, closed_gaps: [Pred] }
// Its object Gap is filled by the Subject of the verb selecting it.
category HollowInf : Clause
category BareInf : VerbPhrase [Number, Person, VerbForm, Voice, PastTime, NonPastTime] {
    gap,
    closed_gaps: [Pred],
}
// An auxiliary's participial Complement: passive or progressive *be*'s (*is
// being __*) and perfect *have*'s (*have been __*).
category AuxiliaryComplement : VerbPhrase [VerbForm, Voice, VerbKind, PastTime, NonPastTime] {
    gap,
    closed_gaps: [Pred],
    function,
}
category Gerund : VerbPhrase [Number, Person, VerbForm, Voice] { gap }
category PastPart : VerbPhrase [VerbForm, Voice] {
    gap,
    closed_gaps: [Pred],
}
// A gerund-participial Clause with its Subject, in Oracle a Subject only.
category GerundClause : Clause
category QuotedAbility
// A word cited rather than used (*choose left or right*; CGEL 5§8.2:401).
// It fills only a slot a head's frame selects, never an ordinary Noun
// Phrase's.
category Mention
category MentionModifier
// A singular subtype name or coordination of them as the value of a
// specifying copular *be* (*the new creature type can't be Wall*, Artificial
// Evolution; CGEL 4§5.5:266–269). Distinct from Predicative so coordination
// does not mix bare subtype names with determined nominals (*that's a Demon,
// Horror, or Nightmare*, Ancient Cellarspawn), and distinct from Mention so
// bare color nouns, *day* or *night* after *be* get no cited-word twin.
category SpecifyingValue { function }
category QuotedCost
category InterrogativeClause : Clause
category InterrogativePhrase : NounPhrase [Number, Person]

// The words whose Complements introduce a name (`docs/design/lexicon.md`
// §6): the Complement of *named*, and a copy's exception under *except*.
word NameVerb = "verb:name"
word Except = "prep:except"
word By = "prep:by"
word Up = "prep:up"
word Of = "prep:of"
word Than = "prep:than"
word From = "prep:from"
word For = "prep:for"
word As = "prep:as"
// Exceptive *but* (*all but one*).
word ExceptiveBut = "prep:but"
word DegreeAs = "adv:as"
word Plus = "prep:plus"
word Minus = "prep:minus"
word The = "det:the"
word Genitive = "clitic:genitive"
word That = "det:that"
word ContentMarker = "sub:that"
word Any = "det:any"
word Or = "coord:or"
word And = "coord:and"
word AndOr = "coord:and/or"
word Nor = "coord:nor"
word But = "coord:but"
word Not = "adv:not"
word Those = "det:those"
word Both = "det:both"
word Either = "det:either"
word Neither = "det:neither"
word To = "sub:to"
word Each = "det:each"
word All = "det:all.count"
word Whichever = "det:whichever"
word Which = "det:which"
word Whether = "sub:whether"
word How = "adv:how"
word Target = "det:target"
word Most = "det:most"
word No = "det:no"
word Anywhere = "det:anywhere"

class Predeterminer = ["det:all.count", "det:all.mass", "det:both"]
class Coordinator = ["coord:and", "coord:or", "coord:and/or", "coord:nor"]
class Disjunctive = ["coord:or", "coord:and/or", "coord:nor"]
class Alternative = ["coord:or", "coord:nor"]
// They attach a new element to a whole Clause: *but* or *and*, never *or*
// (CGEL 15§4.5:1347).
class AddingCoordinator = ["coord:and", "coord:but"]
// They focus a qualifying added element (AddedElement).
class FocusingAdverb = ["adv:only", "adv:not"]
class BeVerb = ["verb:be", "verb:'re", "verb:aren't"]
class HaveVerb = ["verb:have", "verb:'ve", "verb:haven't"]
// Auxiliaries stranded before their Complement's ellipsis site (CGEL
// 17§7.1:1519–1523), by the omitted verb's form: plain after a modal, a
// past participle after *have*, either participle after *be*. Never a
// reduced clitic, which cannot stand in this stressed position. *Do* has
// its intransitive pro-form frame instead.
class StrandableModal = ["verb:can", "verb:can't", "verb:may", "verb:must", "verb:will"]
class StrandableHave = ["verb:have", "verb:haven't"]
class StrandableBe = ["verb:be", "verb:aren't"]
class StrandableDo = ["verb:do", "verb:don't"]
// They float as an Adjunct after a plural Subject or an auxiliary (CGEL
// 5§9.2:413). *All* floats after a personal pronoun only (FloatedAll).
class FloatingQuantifier = ["det:each", "det:both"]
class SuperlativeQuantifier = ["det:most", "det:least", "det:fewest"]
// The determinatives that modify a comparative of inequality (*no more
// than two spells*; CGEL 13§4.4.1:1131, [29i]): *no*, *any* and *much*, and
// *many*, the count form *much* has before a plural count head (13§4.1.2:1126,
// [16]), never another determinative (∗*each more than two creatures*).
class ComparativeDegreeModifier = ["det:no", "det:any", "det:much", "det:many"]
// The superlative determinative that fuses with its head, printed only
// after *tied for* (*tied for fewest*, Goblin Game). Never *most* or
// *least*: fused, they
// give *tied for most common* (Sulam Djinn) a second tree, *tied for [most]*
// with *common* a DepictiveAdjective Adjunct, and *at least* an *at*
// Preposition Phrase over a fused *least*.
class CountSuperlativeQuantifier = ["det:fewest"]
// They stand alone as a fused determiner-head (*replacing all instances of
// one color word with another*; CGEL 5§9.1:410). Fused *each* is an
// implicit partitive (CGEL 5§9.2:413), as in *each enters with ...*
// (Storyweave).
class FusedQuantifier = [
    "det:another", "det:both", "det:each", "det:more.count", "det:everything", "det:this",
    "det:none",
]
// They choose from a set in an implicit partitive (*If a player does
// either*; CGEL 5§9.2:413, which would put *each* here too but for its
// fixed uses such as *each to their own*). Their Noun Phrase is Ordinary,
// so NonNumericComplement's ban on fused *each* does not reach it.
class FusedChoice = ["det:either", "det:neither"]
class RelativeMarker = ["sub:that", "pronoun:which", "pronoun:who"]
// Only *other*, which heads a Noun Phrase with ordinary determination (*the
// other*; CGEL 5§9.1:410).
class FusedHeadAdjective { typed }
// Only *same*, whose fused Noun Phrase takes the definite article (CGEL
// 5§9.3:416).
class DefiniteFusedHeadAdjective { typed }
class SumAdjective { typed }
class PhrasalAdverb { typed }
class MultiplyingAdverb { typed }
class BoundingAdverb { typed }
class FrontAdverb { typed }
class CentralAdverb { typed }
class EndAdverb { typed }
class LinkingAdverb { typed }
class CoordinateAdverb { typed }
class CardType { typed }
class Supertype { typed }
class Subtype { typed }
class ParameterizedKeyword { typed }
class AbilityWord { typed }
class AnchorWord { typed }
// A verb whose Object is an object it brings into being, which the text may
// name: only *create* [CR#111.4].
class NamingVerb { typed }
// Only *token*, which heads a named token's description.
class TokenNoun { typed }
// Only *name*, the Subject of *its name is ...*.
class NameNoun { typed }
class BracedSymbol { typed }
class Variable { typed }
// Only `LEVEL`, the marker of a level symbol [CR#711.2a].
class RangeMarker { typed }
// Only `{P}` [CR#107.18].
class Pawprint { typed }

slot TypeModifier = TypeModifier
slot NonManaCost = NonManaCost
slot Quality = Quality
slot Name = NameComplement
slot Ability = Ability
slot Condition = Condition
slot Measure = Measure
slot NP = ComplementNounPhrase where slot.Case != Nominative
// A *with* or *without* phrase with an Absolute Clause is an Adjunct
// or a Modifier, never a selected Complement (CGEL 14§10(a):1267).
slot PP = PrepositionPhrase where slot.ComplementKind != AbsoluteClause
slot Pred = Predicative
slot AdjP = AdjectivePhrase
slot AdvP = Adverbial
slot LocativeNP = LocativeHead
slot Position = PositionPhrase
slot MeasureNP = MeasureNounPhrase
slot KeywordPhrase = KeywordPhrase
slot Nominal = BareNominalComplement
slot Amount = Amount
slot SetName = SetName
// Unlike slots. Where a head's frames select two or more of a slot's kinds
// in one position, that position also takes the slot's coordination,
// restricted to conjuncts of the kinds the head selects there: each conjunct
// fills the position alone (CGEL, Ch. 15 §3.1, p. 1323, rule [1]). A
// preposition's derived frame admits the Host Categories all of its frames
// do. *Equal to [2] or [the greatest power among ...]*; *has [flying] and
// ["{T}: Add {G}."]*, never *destroy [target creature] and [flying]*.
slot AmountOrNP = AmountOrNounPhrase { unlike: [NP, Amount] }
slot UnlikeObject = ObjectCoordination { unlike: [NP, KeywordPhrase, QuotedAbility, MeasureNP] }
// Mana-only. A final Keyword Parameter Cost is this slot after a space, or
// an em dash, a NonManaCost and a period, each with its own FinalParameter;
// the punctuation is the production's, not a Reading (OSG §3, Em dashes).
// The slot stays mana-only for DashCost (*Suspend 4—{1}{U}*), non-final
// keyword costs and keyword actions.
slot Cost = SymbolCosts
slot FiniteClause = FiniteClause
// A temporal preposition's phrase takes its Clause's time (*when*,
// *whenever*, *until*, *before*, *after*, *while*, *as*; CGEL 8§6:700); any
// other preposition's has none (a conditional clause is independent of its
// host in time, CGEL 8§14.1.2:743).
slot TemporalClause = FiniteClause
    where $.PastTime = slot.PastTime,
          $.NonPastTime = slot.NonPastTime
slot ComparativeClause = ComparativeClause
slot ExpandableClause = ExpandableClause
slot SetOffClause = SetOffClause
slot VerblessClause = VerblessClause
slot AbsoluteClause = AbsoluteClause
slot InterrogativeClause = InterrogativeClause
slot ToInf = ToInf
slot HollowToInf = HollowInf
slot BareInf = BareInf
slot Gerund = Gerund
slot PastPart = PastPart
slot QuotedAbility = QuotedAbility
slot Mention = Mention

// Complement Constraints, which a Preposition Frame of the lexicon names.
//
// A plural Complement, as *among* takes (CGEL 7§5.1(a):636): a coordination
// itself, with any coordinator (*among flying, first strike, lifelink, or
// vigilance*, Elspeth Resplendent; *among all permanents or a color tied for
// most common*, Tsabo's Assassin), or else a Noun Phrase that is not
// Singular (*among one or two targets*), which an open Number passes (*among
// any of the creatures blocking it*, Defensive Formation). A keyword phrase,
// slash measure or name has no Number, so only a coordination of it is
// plural; a singular Noun Phrase over a coordinated Nominal is not (*among a
// creature or planeswalker*).
constraint Plural {
    coordination: [NP, KeywordPhrase, MeasureNP, Name, UnlikeObject],
    otherwise: [NP -> [slot.Number = Plural]],
}
// A Complement taken only where a head's Frame Slot names its kind: a cited
// word after *for* (*do the same for Vampire*), never under a head that
// selects *for* alone, where it would be a second tree of the bare noun
// (*vote for blue*).
constraint KindSelected { kind_selected }

// A distributive adjunct (*for each …*) anchors to the outermost eligible
// clause, as a comma-set Supplement does (english.md §5, AttachmentClass).
high_attachment PrepositionPhrase where $.DeterminativeDistribution = Distributive

TextMode: Document -> Mode { capital: [head] }
TextModalHeader: Document -> ModalHeader { capital: [head] }
ModalAbility: ModalAbility -> header:ModalHeader '\n':Bound modes:Modes { capital: [modes] }
ModalTextAbility: Ability -> ModalAbility
ModalEffect: Effect -> ModalAbility
ActivatedModalHeader: Document -> cost:ActivationCost ':' ModalHeader { capital: [cost, head] }
ActivationPayment: ActivationCost -> Cost
SingleMode: Modes -> Mode
ModeSequence: Modes -> first:Mode '\n':Bound rest:Modes { capital: [rest] }
AbilityParagraph: Paragraphs -> Ability
HeaderParagraph: Paragraphs -> Header
AbilityParagraphSequence: Paragraphs -> first:Ability '\n':Bound rest:Paragraphs { capital: [rest] }
HeaderParagraphSequence: Paragraphs -> first:Header '\n':Bound rest:Paragraphs { capital: [rest] }

CardTypeModifier: TypeModifier -> Class(CardType) where head.Number = Singular
SupertypeModifier: TypeModifier -> Class(Supertype)
NegativeTypeModifier: TypeModifier -> prefix:Lex(Affix) TypeModifier
IndexedCostHeader: Header -> cost:Cost ':' IndexedNominal { capital: [head] }
    where head.Number = Singular
// A keyword premodifies only without its Keyword Parameters (*a disturb
// cost*), never with them (*[protection from each of the exiled card's]
// card types*, Mirror Golem). `=`, so a keyword coordination, which leaves
// KeywordForm unvalued, passes (*an eternalize or embalm ability*).
KeywordPremodifier: Premodifier -> KeywordPhrase { cost: 0 }
    where head.KeywordForm = Bare,
          $.PremodifierKind = Keyword
// Quoted wording mentioned as a term: a cited-word premodifier (*a "left"
// pile*), a cited word (*choose "left" or "right."*) or a singular nominal
// (*the "legend rule"*, [CR#704.5j]), with no period of its own. A quoted
// plural is a granted keyword's (*have "bands with other legendary
// creatures."*), never a term's. A quoted keyword premodifies as a
// keyword Premodifier (*all "bands with other" abilities*).
QuotedMentionPremodifier: BareNominal -> modifier:"Mention" BareNominal
QuotedMention: Mention -> "Mention"
QuotedNominal: BareNominal -> "BareNominal" where head.Number = Singular
// A quoted imperative naming a cost (*cost an additional "Sacrifice a land"
// to activate*, Brutal Suppression, Drought; [CR#118.8]): a singular count
// noun under a determiner. Any other quoted clause is a QuotedAbility.
QuotedCost: QuotedCost -> "Clause" { capital: [head] } where head.VerbForm := Plain
// Its NounKind is an admission gate (english.md §6): a Nominal's conjuncts
// share theirs, so a quoted ability is never a quoted cost conjoined in a
// Nominal (*a ... [token with flying] and ["Whenever Redwing attacks, surveil
// 1."]*, Falcon, Winged Wonder).
QuotedCostHead: BareNominal -> QuotedCost
    where $.Number = Singular,
          $.Countability = Count,
          $.NounKind = Quotation,
          $.NounDistribution = Ordinary

TextSymbols: Document -> Symbols { capital: [head] }
// A symbol sequence as a noun under a determiner (*each {B} in a cost*,
// *six {E}*).
SymbolNominal: BareNominal -> Symbols
    where $.DeterminerNeed = Required,
          $.NounKind = Ordinary,
          $.NounDistribution = Ordinary
// An Arabic numeral as a singular count noun under a determiner (*a natural
// 20*).
ArabicNumeralName: NumeralName -> Numeral(Arabic(false))
// A numeral with a comparative adjective it is the standard of (*whenever
// you roll a 4 or higher*), as ComparativeBoundedAmount.
ComparativeBoundedNumeralName: NumeralName ->
    first:Numeral(Arabic(false)) coordinator:Word(Or) last:AdjectivePhrase
    where last.Grade := Comparative,
          last.ComplementKind = Intransitive
NumeralNominal: BareNominal -> NumeralName
    where $.DeterminerNeed = Required,
          $.Number = Singular,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.NounDistribution = Ordinary
GroupedNumericAmount: Amount -> Numeral(Arabic(true)) where $.QuantityNumber = head.Number
// A multiplying or bounding adverb on a quantity (*up to twice X target
// cards*).
AdverbModifiedAmount: Amount -> modifier:AdverbPhrase Amount
    where modifier.AdjunctPosition != Central | End | Linking
// A sign is spoken, *plus* or *minus* (*a +1/+1 counter*), so its mark is
// a word to Adjacency Agreement; a range's dash (`RangeHeader`) is not.
UnsignedMeasureAmount: SignedAmount -> Amount where head.Sign != Negative
PositiveMeasureAmount: SignedAmount -> '+':Prefix:Spoken Amount where $.Adjustment = Signed
NegativeMeasureAmount: SignedAmount -> '-':Prefix:Spoken Amount where $.Adjustment = Signed

BoundKeywordItem: KeywordParameters -> BoundKeyword
// A comparative bound on a number is no Noun Phrase: predicated, it
// is the comparative adjective's (*Its power is less than 3*).
NumericNounPhrase: NounPhrase -> Amount
    where head.ComplementKind != PP | Amount,
          $.NounKind = Numeric,
          $.Number = Singular,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// No fused *each*: as a Complement it would let an *of* phrase right after
// it attach to another host, where it is *each*'s partitive oblique
// (*[lands on each] [of your turns]*, Fastbond). The ban is wider than that:
// it also refuses *one of each*, which QuantityPartitiveOfEach builds
// instead, and a fused *each* before a Nominal it could determine (*cast
// [for each] [1 life you gained]*, Licia, Sanguine Tribune).
NonNumericComplement: ComplementNounPhrase -> NounPhrase { transparent: [head] }
    where head.NounKind != Numeric,
          head.Case != Nominative | Genitive,
          !(head.DeterminativeDistribution = Distributive & head.NounKind = Quantity)
NumeralNominalPhrase: FusedNounPhrase -> ChoiceQuantity
    where $.NounKind = Quantity,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
CardinalChoice: ChoiceQuantity -> Numeral(Cardinal)
// *Those* as a fused head (*except those that share a creature type with
// ...*).
FusedDemonstrative: FusedNounPhrase -> Word(Those)
    where $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Number = Plural,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third
FusedQuantifierNominalPhrase: NounPhrase -> Class(FusedQuantifier)
    where $.NounKind = Quantity,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
FusedChoiceNominalPhrase: FusedNounPhrase -> Class(FusedChoice)
    where $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
CardinalDeterminer: NumericalDeterminer -> Numeral(Cardinal) where $.Countability = Count
VariableDeterminer: NumericalDeterminer -> Class(Variable) where $.Countability = Count
ArabicDeterminer: NumericalDeterminer -> Numeral(Arabic(false)) where $.Countability = Count
GroupedArabicDeterminer: NumericalDeterminer -> Numeral(Arabic(true)) where $.Countability = Count
NegativeAdjective: AdjectivePhrase -> prefix:Lex(Affix) AdjectivePhrase where $.Polarity = Negative
LabeledModalHeader: Document -> label:Class(AbilityWord) '—':Free ModalHeader { capital: [label, head] }
// A flavor word carries its own dash (*Trick Arrows — Whenever ..., choose
// one —*), as in FlavorLabeledAbility.
FlavorLabeledModalHeader: Document -> label:Lex(FlavorWord) ModalHeader { capital: [label, head] }
ChapterModalHeader: Document -> chapters:Chapters '—':Free ModalHeader { capital: [chapters, head] }

CompleteKeywordPhrase: KeywordPhrase -> KeywordParameters
CompleteKeywordItem: KeywordLineItem -> KeywordParameters
BareKeywordMention: KeywordPhrase -> Class(ParameterizedKeyword) where $.KeywordForm = Bare
// A Keyword Phrase in quotation marks stands wherever the bare phrase does.
QuotedKeyword: KeywordPhrase -> QuotedKeywordPhrase
QuotedKeywordPhrase: QuotedKeywordPhrase -> "KeywordPhrase"
// A granted ability quoted whole, its period inside the closing mark (*has
// "{T}: Add {G}."*; [CR#113.1a]).
QuotedAbility: QuotedAbility -> "Ability" { capital: [head] }
TextAbility: Document -> Ability { capital: [head] }
TextTypeLine: Document -> TypeLine { capital: [head] }
TextHeader: Document -> Header { capital: [head] }
HeaderSequence: Document -> first:Header '\n':Bound rest:Paragraphs { capital: [first, rest] }
TextSequence: Document -> first:Ability '\n':Bound rest:Paragraphs { capital: [first, rest] }
SentenceAbility: Ability -> Sentences
KeywordAbilityList: Ability -> KeywordList
SingleKeyword: KeywordList -> KeywordLineItem
CommaKeywords: KeywordList -> first:KeywordLineItem ',' rest:KeywordList
TypesOnly: TypeLine -> CardTypes
TypesWithSubtypes: TypeLine -> CardTypes '—':Free subtypes:Subtypes
SupertypePrefix: TypeLine -> modifier:Class(Supertype) TypeLine { capital: [modifier] }
SingleCardType: CardTypes -> Class(CardType) { capital: [head] } where head.Number = Singular
MultipleCardTypes: CardTypes -> first:Class(CardType) rest:CardTypes { capital: [first] } where first.Number = Singular
SingleSubtype: Subtypes -> Class(Subtype) { capital: [head] } where head.Number = Singular
MultipleSubtypes: Subtypes -> first:Class(Subtype) rest:Subtypes { capital: [first] } where first.Number = Singular
NumericAmount: Amount -> Numeral(Arabic(false)) where $.QuantityNumber = head.Number
VariableAmount: Amount -> Class(Variable) where $.QuantityNumber = head.Number
SingleSymbol: Symbols -> Class(BracedSymbol)
SymbolSequence: Symbols -> first:Class(BracedSymbol) rest:Attached(Symbols, Suffix)
SymbolCost: Cost -> SymbolCosts
SingleSymbolCost: SymbolCosts -> Symbols
CostSequence: SymbolCosts -> first:Symbols ',' rest:SymbolCosts
NegativeLoyaltySymbolCost: ActivationCost -> '−':Prefix:Spoken amount:Amount
PositiveLoyaltySymbolCost: ActivationCost -> '+':Prefix:Spoken amount:Amount
ZeroLoyaltySymbolCost: ActivationCost -> amount:Amount
LoyaltySymbol: LoyaltySymbol -> '[':Prefix amount:Amount ']'
UnicodeNegativeLoyaltySymbol: LoyaltySymbol -> '[':Prefix '−':Bound:Spoken amount:Amount ']'
PositiveLoyaltySymbol: LoyaltySymbol -> '[':Prefix '+':Bound:Spoken amount:Amount ']'
LoyaltyCost: ActivationCost -> LoyaltySymbol
LoyaltyNominal: BareNominal -> LoyaltySymbol
    where $.DeterminerNeed = Required,
          $.Number = Singular,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.NounDistribution = Ordinary
VerbalCost: NonManaCost -> VerbPhrase { capital: [head] } where head.VerbForm = Plain
CompositeNonManaCost: NonManaCost -> first:Symbols ',' rest:NonManaCost
NonManaCost: Cost -> NonManaCost
ActivatedAbility: Ability -> cost:ActivationCost ':' effect:Effect { capital: [effect] }
LabeledAbility: Ability -> label:Class(AbilityWord) '—':Free Ability { capital: [head] }
// *• Khans — ...*: an ability under an Anchor Word, after the ability
// offering the choice [CR#607.2m]; the bullet is part of it [CR#614.12c].
// Never a mode: no instruction to choose options precedes it [CR#700.2].
AnchoredAbility: Ability -> '•':Free label:Class(AnchorWord) '—':Free Ability { capital: [label, head] }
FlavorLabeledAbility: Ability -> label:Lex(FlavorWord) Ability { capital: [head] }
NominalMode: Mode -> '•':Free Nominal '.' { capital: [head] }
NounPhraseMode: Mode -> '•':Free NounPhrase '.' { capital: [head] }
// A keyword whose em-dash cost ends in its own period, then its instruction
// (*Equip— Sacrifice another nonland permanent. Activate only once each
// turn.*). No other keyword form is followed by a sentence on its line.
KeywordFollowedBySentences: Ability -> first:KeywordLineItem rest:Sentences
    where first.FinalParameter := SetOffCost
// *Expansion* takes its Set Name as its premodifier, and no Name: an
// admission gate (english.md §3, §6) that keeps a second tree, a card's own
// name premodifying *expansion*, off Golgothian Sylex's wording citing a set
// spelled like a card (*a name originally printed in the Time Spiral
// expansion*) in that card's own text (tests/set_names.rs).
NamePremodifier: BareNominal -> modifier:Name BareNominal
    where head.SetNameLicense != Head
// A token named for a card, in the Object of *create*: it has the
// characteristics of the card so named [CR#111.11] (*create a Tarmogoyf
// token*, *create a tapped Mutavault token*). A card name that a subtype or
// a predefined token's name also spells is that word (*create a Blood
// token*).
CardNamedToken: BareNominal -> modifier:TokenCardName Class(TokenNoun) { within: NamingVerb }
CardNameBeforeToken: TokenCardName -> DistinctOtherCardName()
ModeBullet: Mode -> '•':Free Ability { capital: [head] }
PlusCostedMode: Mode -> '+':Free:Spoken cost:Cost '—':Free ModeEffect { capital: [head] }
LabeledCostedMode: Mode -> '•':Free label:Lex(FlavorWord) cost:Cost '—':Free ModeEffect { capital: [label, head] }
PawprintMode: Mode -> quantity:Pawprints '—':Free ModeEffect { capital: [head] }
SinglePawprint: Pawprints -> Class(Pawprint)
PawprintSequence: Pawprints -> first:Class(Pawprint) rest:Attached(Pawprints, Suffix)
SingleSentence: Sentences -> Sentence
SentenceSequence: Sentences -> first:Sentence rest:Sentences
SentenceEffect: Effect -> Sentences
ModeInstruction: ModeEffect -> Effect
ModeMeasure: ModeEffect -> Measure '.'
// A count noun's singular nominal (*legendary creature*); a mass nominal is
// a Quality through its Noun Phrase.
SingularNominalQuality: Quality -> Nominal
    where head.Number = Singular,
          head.Countability := Count,
          head.NounDistribution != HeadOnly
NominalPhraseQuality: Quality -> NounPhrase
// Only a lexicon-declared Quality head (*protection from multicolored*;
// *protection from snow*, [CR#205.4a]). Never a color word, whose noun
// conversion is the Quality (*protection from red*; one tree, english.md §8).
AdjectivalQuality: Quality -> AdjectivePhrase where head.QualityHead := Fused
// A counter's kind name names nothing: an admission gate (english.md §3,
// §6) that keeps the kind name *dread* from a Name Complement of *manifest*
// in *Manifest dread* (Under the Skin).
NamedParameter: Name -> Lex(Catalog) where head.KindLicense != Kind
SetNameWord: SetName -> Lex(SetName)
// An Introduced Name named again: the Reading introduces it elsewhere
// (*create Ragavan, ... Ragavan enters tapped and attacking*; a token's own
// ability names the token, [CR#201.5]).
// It is never *create*'s Object, which offers the name for a new token (*if
// you don't control a creature named Mowu, create Mowu, a legendary 3/3
// green Dog creature token*).
RepeatedIntroducedName: Name -> RepeatedName() { not_complement_of: NamingVerb }
    where $.NameMention = Repeated
// The Complement of *named* introduces the name written there, the name of a
// token or of a permanent the text changes [CR#111.4]: no inventory lists
// it (*a 2/2 colorless Wizard Soldier creature token named Cadet*; *a
// creature you control named Vecna*).
NameAfterNamed: NewName -> IntroducedName() { within: NameVerb }
NewNameComplement: NameComplement -> NewName
// The name of a token as the Object of *create*, which only the description
// after its Clause introduces (`NamedTokenDescription`): *Create Angelo.*
// names nothing.
NamedTokenName: Name -> IntroducedName() { undescribed, complement_of: NamingVerb }
// After *named* a name its text introduces is introduced there too, never
// named again.
NameAsComplement: NameComplement -> Name { cost: 0 } where head.NameMention != Repeated
OtherCardNameComplement: NameComplement -> OtherCardName()
SlashMeasure: Measure -> first:SignedAmount '/':Bound second:SignedAmount
    where first.Adjustment = second.Adjustment,
          $.Adjustment = first.Adjustment
MeasureHeader: Header -> Measure
RangeHeader: Header -> marker:Class(RangeMarker) lower:Amount '-':Bound upper:Amount
OpenRangeHeader: Header -> marker:Class(RangeMarker) lower:Amount '+'
SingleChapter: Chapters -> Numeral(Roman)
ChapterSequence: Chapters -> first:Numeral(Roman) ',' rest:Chapters
ChapterAbility: Ability -> chapters:Chapters '—':Free Ability { capital: [head] }
// *When this creature enters, choose one —*.
ChoiceHeader: ModalHeader -> Clause '—':Free where head.Inflection != Irrealis
// A modal header as a reflexive trigger [CR#603.12], after the sentence it
// depends on (*You may pay {E}{E}. When you do, choose one —*). Right
// recursion gives one grouping, as SentenceSequence does.
SentencePrefixedModalHeader: ModalHeader -> first:Sentence ModalHeader { capital: [head] }

// An adverb before a bare imperative is its Clause's front Adjunct, never
// its Verb Phrase's central one (CentralPosition).
// An imperative is non-past: its verb is tenseless and its situation later
// than the utterance (CGEL 3§7:159). So no past temporal clause modifies it
// (TimeGiving: *Whenever an opponent gained life, put that many +1/+1
// counters on this creature*, from Kavu Predator), nor does one modify its
// Verb Phrase (*put ... whenever an opponent gained life*).
Imperative: Clause -> VerbPhrase { uncoordinated: [head] }
    where head.VerbForm = Plain,
          $.ClauseMarking = Unmarked,
          head.CentralPosition != Occupied,
          head.PastTime != Past,
          $.NonPastTime = NonPast
Declarative: Sentence -> clause:Clause '.' { capital: [clause] }
    where clause.ClauseMarking = Unmarked,
          clause.Inflection != Irrealis
SubjectRemnant: SubjectRemnant -> VerbPhrase
    where head.VerbForm = Finite,
          head.CentralPosition != Occupied
SubjectPredicate: Clause -> subject:NounPhrase Free(VerbPhrase) { transparent: [head] }
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          subject.Case != Accusative | Genitive,
          $.ClauseMarking = Unmarked,
          $.ClauseShape = SubjectInitial
// A specifying copular Verb Phrase, whose value is a singular subtype name
// or coordination of them (CGEL 4§5.5:266–269), for Artificial Evolution's
// *the new creature type can't be Wall*. `head.Number != Plural` is an
// admission gate (english.md §6) against plural-syncretic subtypes after a
// plural copula (*All Mountains are Plains*, Conversion), while
// CliticSubjectPredicate's `subject.Case = Nominative` keeps clitic *'s* off
// genitives (*an Urza's Power-Plant*, Urza's Tower).
SpecifyingBe: VerbPhrase -> Class(BeVerb) predicative_complement:SpecifyingValue
    where head.Number != Plural,
          $.Voice = Active
SubtypeSpecifyingValue: SpecifyingValue -> Class(Subtype) where head.Number = Singular
// A specifying copular Clause whose Subject is headed by *name* and whose
// value is the name the text gives, in a copy's exception (*except its name
// is Mishra's Warform*; CGEL 4§5.5:266–269).
NameSpecification: Clause -> subject:NounPhrase Class(BeVerb) predicative_complement:IntroducedName() {
    within: Except,
    headed_by: [subject -> NameNoun],
}
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          subject.Case != Accusative | Genitive,
          $.ClauseMarking = Unmarked
// A bound auxiliary clitic has a nominative pronoun host (*it's*, *you're*,
// *they've*).
CliticSubjectPredicate: Clause -> subject:NounPhrase Attached(VerbPhrase, Suffix) {
    transparent: [head],
}
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          subject.Case = Nominative,
          $.ClauseMarking = Unmarked,
          $.ClauseShape = SubjectInitial

// *Turning a face-down permanent face up causes ...*.
GerundSubject: Clause -> subject:Gerund VerbPhrase { transparent: [head] }
    where head.VerbForm = Finite,
          head.Number = Singular,
          head.Person = Third,
          $.ClauseMarking = Unmarked

// *A creature you control attacking causes ...* (CGEL 14§2.1:1188).
SubjectGerund: GerundClause -> subject:NounPhrase VerbPhrase { cost: 2 }
    where head.VerbForm = GerundParticiple,
          subject.Case != Nominative | Genitive
GerundClauseSubject: Clause -> subject:GerundClause VerbPhrase { transparent: [head] }
    where head.VerbForm = Finite,
          head.Number = Singular,
          head.Person = Third,
          $.ClauseMarking = Unmarked

// Dummy *there*, *be*, the displaced subject and an optional locative or
// temporal Complement (CGEL 16§6.2.1:1394). A Preposition Phrase right
// after the displaced subject is that Complement, never an Adjunct or the
// subject's postmodifier.
Existential: Clause -> subject:DummyPronoun ExistentialPredicate
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          $.ClauseMarking = Unmarked
ExistentialThere: DummyPronoun -> Lex(Pronoun) where head.PronounKind = Existential
ExistentialBe: ExistentialPredicate -> Class(BeVerb) displaced_subject:DisplacedSubject {
    unextended: [displaced_subject],
}
    where $.Number = displaced_subject.Number,
          displaced_subject.Case != Accusative
// The Complement is the one *be*'s prepositional frame selects.
LocatedExistentialBe: ExistentialPredicate ->
    Class(BeVerb) displaced_subject:DisplacedSubject
    complement:SelectedBy(PrepositionPhrase, BeVerb) {
    unextended: [displaced_subject],
}
    where $.Number = displaced_subject.Number,
          displaced_subject.Case != Accusative,
          $.ExistentialLocation = Located
// Existential *be* agrees with its displaced subject as a whole, or by
// proximity with a singular first conjunct of an *and*-coordination (*If
// there is an instant card and a sorcery card in your graveyard*, Flow
// State; CGEL 4§3.2.2:242 n. 21).
WholeDisplacedSubject: DisplacedSubject -> NounPhrase { transparent: [head] }
ProximateDisplacedSubject: DisplacedSubject -> NounPhrase { transparent: [head], unshared: [Number] }
    where $.Number = Singular,
          head.Number = Plural,
          head.FirstConjunctNumber := Singular

EndAdverb: AdverbPhrase -> Class(EndAdverb) where $.AdjunctPosition = End
CentralAdverb: AdverbPhrase -> Class(CentralAdverb) where $.AdjunctPosition = Central
FrontAdverb: AdverbPhrase -> Class(FrontAdverb) where $.AdjunctPosition = Front
LinkingAdverb: AdverbPhrase -> Class(LinkingAdverb) where $.AdjunctPosition = Linking
// *And so on*, alone or with a *for*-phrase (*and so on for double strike,
// deathtouch, ..., and partner*).
IdiomaticCoordinate: IdiomaticCoordinate -> Class(CoordinateAdverb)
IdiomaticCoordinateFor: IdiomaticCoordinate ->
    Class(CoordinateAdverb) adjunct:Selected(PrepositionPhrase, For)
// The linking connective is an Adjunct, never a Coordinator, whether sole
// (*Draw a card, then discard a card*) or after one (*and then discard a
// card*). It may scope over a Coordinator's coordination (*then [shuffle
// and put that card on top]*).
LinkedClause: LinkedClause -> adjunct:AdverbPhrase Clause { transparent: [head] }
    where adjunct.AdjunctPosition = Linking
LinkedVerbPhrase: LinkedVerbPhrase -> adjunct:AdverbPhrase VerbPhrase { transparent: [head] }
    where adjunct.AdjunctPosition = Linking
// *Once each turn, ...*.
FrontAdverbial: Clause -> adjunct:AdverbPhrase ',' Clause { cost: 2, transparent: [head] }
    where adjunct.AdjunctPosition = Front,
          $.FrontPosition = Occupied
// A comma-set passive participial Supplement (*..., followed by an
// additional main phase*; CGEL 14§9.1:1265). It supplements one conjunct,
// never a whole coordination (*X is …, rounded down, and Y is …, rounded
// up*), and like a comma-set post-adjunct it is outside any relative
// clause, so its head Clause passes up no Gap.
ParticipialSupplement: Clause -> Clause ',' supplement:VerbPhrase {
    cost: 3,
    heavy: [supplement],
    uncoordinated: [head],
}
    where supplement.VerbForm = PastParticiple,
          supplement.Voice = Passive
// The same with a gerund-participle (*Restart the game, leaving in exile
// all non-Aura permanent cards exiled with Karn*).
GerundParticipialSupplement: Clause -> Clause ',' supplement:VerbPhrase {
    cost: 3,
    heavy: [supplement],
    uncoordinated: [head],
}
    where supplement.VerbForm = GerundParticiple
// A trailing Noun Phrase Supplement, as for a named token's description;
// its anchor stays a constituent of the Clause, never part of a larger Noun
// Phrase (CGEL 15§5.1:1350–1351).
NounPhraseSupplement: Clause -> Clause ',' supplement:NounPhrase
// A named token's description introduces the name its anchor Clause ends
// in, the Object of *create* (*create Angelo, a legendary 1/1 green and
// white Dog creature token*; [CR#111.4]). The description is headed by
// *token*.
NamedTokenDescription: Clause -> Clause ',' supplement:NounPhrase {
    describes: head,
    headed_by: [supplement -> TokenNoun],
}
// *But* or *and* adds a fragment focused by *only* or *not* to the whole
// main Clause, with no comma (*Any player may activate this ability but
// only during their turn*; CGEL 15§4.5:1346–1347). A Clause ending in a
// coordinable Predicate Adjunct takes the fragment as that Adjunct's
// coordinate instead (*Activate [only as a sorcery and only once each
// turn]*).
AddedElement: Sentence ->
    clause:Clause coordinator:Class(AddingCoordinator) fragment:QualifyingFragment '.' {
    capital: [clause],
    cost: 2,
    unadjoined: [
        clause -> [PrepositionPhrase, AdjectivePhrase, TemporalNounPhrase, AdverbPhrase, AdjunctCoordination],
    ],
}
    where clause.ClauseMarking = Unmarked,
          clause.Inflection != Irrealis
// After its coordinator, a coordinate may open with a fronted Adjunct
// delimited on both sides (*except it's legendary ... and, if it's a
// creature, it enters with ...*).
DelimitedFrontConjunct: Clause -> first:Clause coordinator:Class(Coordinator) ',' last:Clause {
    cost: 2,
}
    where last.FrontPosition := Occupied,
          $.VerbForm = first.VerbForm,
          $.VerbForm = last.VerbForm,
          $.ClauseMarking = first.ClauseMarking,
          $.ClauseMarking = last.ClauseMarking,
          $.FrontPosition = first.FrontPosition
QualifyingFragment: QualifyingFragment -> modifier:Class(FocusingAdverb) ClauseFragment { cost: 0 }
AdjunctFragment: ClauseFragment -> PredicateAdjunct { cost: 0 }
ExtendedFragment: ClauseFragment -> ClauseFragment adjunct:PredicateAdjunct
// A temporal Noun Phrase after a final Adverb Phrase is a second Adjunct
// (TemporalAdjunct: *[[activate only once] each turn]*), never also the
// adverb's FrequencyInterval, which it is where no Verb Phrase follows
// (*Once each turn, ...*); the two sites differ in no meaning.
EndAdverbial: VerbPhrase -> VerbPhrase adjunct:AdverbPhrase {
    unadjoined: [adjunct -> [TemporalNounPhrase]],
    transparent: [head],
}
    where adjunct.AdjunctPosition = End
CentralAdverbial: VerbPhrase -> adjunct:AdverbPhrase VerbPhrase { transparent: [head] }
    where adjunct.AdjunctPosition = Central,
          $.CentralPosition = Occupied

// A Gap passes through an auxiliary's Complement.
AuxiliaryParticiple: AuxiliaryComplement -> VerbPhrase { transparent: [head] }
// A finite auxiliary stranded before its Complement's ellipsis site (*If
// you can't, ...*). Only a coordinator, punctuation or the head it is a
// dependent of may follow: a dependent there would be the Complement. Nor
// may one whose lexical head is spelled like a verb in the omitted form
// (*cards that weren't [cast this way]*), while *each opponent who can't
// [discards a card]* keeps its ellipsis.
StrandedModal: VerbPhrase -> Class(StrandableModal) { elliptical: [Plain] }
    where head.VerbForm = Finite,
          $.Voice = Active,
          $.Ellipsis = Code
StrandedPerfect: VerbPhrase -> Class(StrandableHave) { elliptical: [PastParticiple] }
    where head.VerbForm = Finite,
          $.Voice = Active,
          $.Ellipsis = Code
StrandedBe: VerbPhrase -> Class(StrandableBe) { elliptical: [GerundParticiple, PastParticiple] }
    where head.VerbForm = Finite,
          $.Voice = Active,
          $.Ellipsis = Code
// Supportive *do* stranded (*If you do, ...*; CGEL 17§7.2:1524) as in a
// comparative clause (*more life than they do*; 13§2.1:1110). The grammar
// reads bare *do* there as this alone, never also as an intransitive
// lexical verb: one tree (english.md §8).
StrandedDo: VerbPhrase -> Class(StrandableDo) { elliptical: [Plain] }
    where head.VerbForm = Finite,
          $.Voice = Active,
          $.Ellipsis = Code
Progressive: VerbPhrase -> Class(BeVerb) complement:AuxiliaryComplement {
    transparent: [complement],
}
    where complement.VerbForm = GerundParticiple,
          $.Voice = complement.Voice
// The perfect takes an active participle phrase or a passive one
// headed by *been*. Its Complement gives *have* no time (`exempt`): the
// perfect is itself a past tense (CGEL 3§5:139).
Perfect: VerbPhrase -> Class(HaveVerb) complement:AuxiliaryComplement {
    transparent: [complement],
    exempt: [complement -> [TimeGiving]],
}
    where complement.VerbForm = PastParticiple,
          complement.Voice := Active,
          $.Voice = Active
PassivePerfect: VerbPhrase -> Class(HaveVerb) complement:AuxiliaryComplement {
    transparent: [complement],
    exempt: [complement -> [TimeGiving]],
}
    where complement.VerbForm = PastParticiple,
          complement.Voice = Passive,
          complement.VerbKind := Auxiliary,
          $.Voice = Passive
// The passive auxiliary takes a lexical verb's passive participle phrase.
Passive: VerbPhrase -> Class(BeVerb) complement:AuxiliaryComplement { transparent: [complement] }
    where complement.VerbForm = PastParticiple,
          complement.Voice = Passive,
          complement.VerbKind != Auxiliary,
          $.Voice = Passive

ToInfinitival: Clause -> marker:Word(To) VerbPhrase { transparent: [head] }
    where head.VerbForm = Plain,
          $.ClauseMarking = To
ModifiedInfinitival: Clause -> adjunct:AdverbPhrase Clause { transparent: [head] }
    where adjunct.AdjunctPosition = Phrasal,
          head.ClauseMarking = To
InfinitivalComplement: ToInf -> Clause { transparent: [head] } where head.ClauseMarking = To
BareInfinitival: BareInf -> VerbPhrase { transparent: [head] } where head.VerbForm = Plain
GerundParticipial: Gerund -> VerbPhrase { transparent: [head] }
    where head.VerbForm = GerundParticiple
// A bare passive participle phrase, never headed by *been* (*can't have
// counters put on it*; CGEL 14§5.6.2:1245 [60ii]).
PastParticipial: PastPart -> VerbPhrase { transparent: [head] }
    where head.VerbForm = PastParticiple,
          head.Voice = Passive,
          head.VerbKind != Auxiliary
// *This spell costs {1} to cast* (CGEL 14§6.3(c):1250).
HollowInfinitival: HollowInf -> marker:Word(To) VerbPhrase
    where head.VerbForm = Plain,
          head.Gap = NP
// *Is still on top of your library*, *is no longer snow*, *become no longer
// suspected*.
CentralAdverbAdjunct: CentralAdjunct -> AdverbPhrase { cost: 0 } where head.AdjunctPosition = Central

MeasurePremodifier: Premodifier -> Measure { cost: 0 } where $.PremodifierKind = Measure
// A counter's kind premodifies the noun *counter*: a slash measure for a
// +X/+Y counter [CR#122.1a], a keyword for a keyword counter [CR#122.1b], or
// a kind name. Only *counter* takes it (`:= Head`), an admission gate
// (english.md §3, §6) that keeps the kind name *treasure* from premodifying
// *token* beside the subtype in *Create a Treasure token* (Craft with Pride).
KindPremodifier: BareNominal -> modifier:Kind BareNominal
    where head.KindLicense := Head
MeasureKind: Kind -> Measure
// A keyword kind is one bare keyword a keyword counter can be [CR#122.1b].
// Two admission gates (english.md §3, §6): `KindLicense := Kind` keeps
// *fuse*, a keyword no keyword counter is, from a second kind beside the
// kind name in *Put a fuse counter on target creature* (Bomb Squad), and
// `KeywordForm := Bare`, which a keyword coordination leaves unvalued, keeps
// *[reach, menace, trample, or haste]* from one kind beside the coordination
// of four kinds (Owen Grady, Raptor Trainer).
KeywordKind: Kind -> KeywordPhrase
    where head.KeywordForm := Bare,
          head.KindLicense := Kind
// *A charge counter*.
KindName: Kind -> Lex(Catalog)
// *five {P} worth of modes*.
PawprintPremodifier: BareNominal -> modifier:Pawprints BareNominal
// *its {1}{G} kicker*.
SymbolPremodifier: BareNominal -> modifier:Symbols BareNominal
// A bare slash measure (*gets +2/+2*, *your choice of 5/1 or 1/5*) or a
// determined, premodified signed adjustment (*gets an additional +2/+2*,
// Akawalli, the Seething Tower) is a MeasureNounPhrase, admitted only where
// a head selects one; an unsigned size (*2/2*) is no determined Noun Phrase
// (*Create [X 2/2]*, Germinate Recruits).
MeasureNounPhrase: MeasureNounPhrase -> Measure
PremodifiedAdjustment: ModifiedAdjustment -> modifier:AdjectivePhrase Measure { transparent: [head] }
    where head.Adjustment := Signed,
          modifier.ComplementKind = Intransitive,
          modifier.AdjectivePosition != Predicative
StackedAdjustmentPremodifier: ModifiedAdjustment ->
    modifier:AdjectivePhrase ModifiedAdjustment { transparent: [head] }
    where modifier.ComplementKind = Intransitive,
          modifier.AdjectivePosition != Predicative
DeterminedAdjustment: MeasureNounPhrase -> determiner:DeterminerPhrase ModifiedAdjustment {
    transparent: [head],
}
    where determiner.DeterminativeDistribution != Independent | FreeChoice,
          determiner.ComplementKind != PP,
          determiner.Countability = Count,
          determiner.Number = Singular
// *Gets twice -X/-X*.
AdverbModifiedMeasure: MeasureNounPhrase -> modifier:AdverbPhrase MeasureNounPhrase
    where modifier.AdjunctPosition = Phrasal
AdverbMultipliedMeasure: MeasureNounPhrase -> modifier:AdverbPhrase MeasureNounPhrase
    where modifier.AdjunctPosition = Multiplying
// *Except it's 4/3*, *base power and toughness become 4/2*.
MeasurePredicative: Predicative -> MeasureNounPhrase
// A bare ordinal is attributive (*the second spell*).
OrdinalAdjective: AdjectivePhrase -> Numeral(Ordinal)
    where $.AdjectivePosition = Attributive,
          $.DeterminerNeed = Required
// *Third from the top*.
OrdinalFromEnd: PositionPhrase -> Numeral(Ordinal) complement:Selected(PrepositionPhrase, From)
PositionDepictive: VerbPhrase -> VerbPhrase adjunct:PositionPhrase { cost: 2, transparent: [head] }
PositionAdjunct: PredicateAdjunct -> filler:PositionPhrase where $.ConjunctKind = AdjP
InterleavedRelative: InterleavedModifier -> RelativeClause { cost: 0 }
InterleavedPreposition: Interleaved -> PrepositionPhrase { cost: 0 }
InterleavedTemporal: Interleaved -> TemporalNounPhrase { cost: 0 }
// A manner Noun Phrase before a passive's Internalized Complement (*weren't
// chosen this way by any player*, Raiding Party). Before any later
// Complement, *this way* would also attach to the higher verb wherever an
// Object ends in a participle or relative clause: an Adjunct of *put*
// before *into your hand* instead of *revealed*'s (*Put all creature cards
// revealed this way into your hand*, Beast Hunt). The gate also refuses
// *deals 3 damage this way to any target*. The gate is the Verb Phrase
// valence's `interleaved_core`, an admission gate (english.md §6).
InterleavedManner: Interleaved -> NounPhrase { cost: 0 } where head.NounKind := Manner
// An end adverb before a later Complement (*divided evenly among*);
// InterleavedSupplement, a comma-set participial one (*deals half X damage,
// rounded down, to any target*).
InterleavedAdverb: Interleaved -> AdverbPhrase { cost: 0 } where head.AdjunctPosition = End
InterleavedSupplement: Interleaved -> ',' supplement:VerbPhrase ',' { cost: 3, heavy: [supplement] }
    where supplement.VerbForm = PastParticiple,
          supplement.Voice = Passive
InterleavedDepictive: Interleaved -> AdjectivePhrase { cost: 0 }
    where head.ComplementKind = Intransitive,
          head.Voice != Passive,
          head.AdjectivePosition != Attributive,
          head.Grade != Equative | Comparative | NonScalarInequality | Mixed
// *Onto the battlefield tapped and attacking and the rest on the bottom*.
// Intransitive only (*tapped*): excludes complemented adjectives such as
// *attached to it* from Depictive and PredicateAdjunct (*gets +2/+2 for
// each Aura and Equipment attached to it*, Strong Back).
InterleavedCoordinatedDepictive: Interleaved -> DepictiveCoordination { cost: 0 }
AdjectivalDepictive: Depictive -> filler:AdjectivePhrase
    where filler.Voice != Passive,
          filler.ComplementKind = Intransitive,
          filler.AdjectivePosition != Attributive,
          filler.Grade != Equative | Comparative | NonScalarInequality | Mixed,
          $.ConjunctKind = AdjP
GerundDepictive: Depictive -> filler:Gerund where $.ConjunctKind = Participial
// *A token that's tapped and attacking*.
CoordinatedPredicative: Predicative -> DepictiveCoordination
CoordinatedDepictive: VerbPhrase -> VerbPhrase adjunct:DepictiveCoordination {
    cost: 2,
    transparent: [head],
}
    where head.VerbKind != Auxiliary | Modal
PrepositionalAdjunct: PredicateAdjunct -> filler:Hosted(PrepositionPhrase, Predicate)
    where $.ConjunctKind = PP
DepictiveAdjunct: PredicateAdjunct -> filler:AdjectivePhrase
    where filler.Voice != Passive,
          filler.ComplementKind = Intransitive,
          filler.AdjectivePosition != Attributive,
          filler.Grade != Equative | Comparative | NonScalarInequality | Mixed,
          $.ConjunctKind = AdjP
// A trailing Preposition Phrase Adjunct scopes over every conjunct of a
// Clause coordination (*[untap target creature and gain control of it]
// until end of turn*; CGEL 15§1.3.4:1285–1286). Never the Verb Phrase
// coordination's: the Imperative heads none (english.md §8).
CoordinatedClauseAdjunct: Clause -> Clause adjunct:Hosted(PrepositionPhrase, Predicate) {
    coordinated: [head],
}
// *Flip a coin [that many times] or [until you lose a flip]*.
TemporalNounAdjunct: PredicateAdjunct -> filler:TemporalNounPhrase where $.ConjunctKind = NP
AdverbialAdjunct: PredicateAdjunct -> filler:AdverbPhrase
    where filler.AdjunctPosition = End,
          $.ConjunctKind = AdvP
CoordinatedAdjunct: VerbPhrase -> VerbPhrase adjunct:AdjunctCoordination {
    cost: 2,
    transparent: [head],
}
// Predicative adjuncts are a subset of predicative complements (CGEL
// 6§2.1:529; 4§5.3:261–263): comparative, inequality and equative relations
// (*less*, *different*, *equal to …*, *same as …*) denote no depictive or
// resultative state, and a coordination with such a coordinate fills no
// adjunct function its coordinates cannot each fill (CGEL 15§3.1:1323, rule
// [1]). Excludes *costs [{1}] [less] to activate* beside *[{1} less]*
// (Pteramander), *deals damage to target creature [equal to …]* beside
// PostposedAdjective (Skred), and *exile … [less than or equal to …]* as a
// depictive of *exile* (Sphere of Annihilation).
DepictiveAdjective: VerbPhrase -> VerbPhrase adjunct:AdjectivePhrase {
    cost: 2,
    transparent: [head],
}
    where adjunct.Voice != Passive,
          adjunct.ComplementKind != Amount,
          adjunct.AdjectivePosition != Attributive,
          adjunct.Grade != Equative | Comparative | NonScalarInequality | Mixed

PhrasalAdverb: AdverbPhrase -> Class(PhrasalAdverb) where $.AdjunctPosition = Phrasal
MultiplyingAdverb: AdverbPhrase -> Class(MultiplyingAdverb) where $.AdjunctPosition = Multiplying
BoundingAdverb: AdverbPhrase -> Class(BoundingAdverb) where $.AdjunctPosition = Bounding
DegreeDeterminer: DeterminerPhrase -> modifier:Word(That) Lex(Determinative)
    where head.DeterminativeDistribution := Degree,
          $.ComplementKind = Intransitive
// *As much*, *as many* (CGEL 13§4.3:1130). Degree *as* modifies the
// determinative, never a Noun Phrase.
EquativeDeterminer: DeterminerPhrase -> modifier:Word(DegreeAs) Lex(Determinative) {
    unshared: [Grade],
}
    where head.DeterminativeDistribution := Degree,
          $.ComplementKind = Intransitive,
          $.Grade = Equative
// *At least as many* (*at least as many lands as you do*, Land
// Equilibrium): the bound is the equative determinative's, as it is a
// numerical one's in AdverbModifiedDeterminerPhrase, never also the Noun
// Phrase's (BoundingNounPhrase; english.md §8).
BoundedEquativeDeterminer: DeterminerPhrase -> modifier:AdverbPhrase DeterminerPhrase
    where modifier.AdjunctPosition = Bounding,
          head.Grade := Equative
// A modified degree determinative as a fused head (*that many*, *tied for
// the most*); a coordination fuses only as a FusedQuantity. Count only:
// never *that much*.
FusedDegreeDeterminer: FusedNounPhrase -> DeterminerPhrase { heavy: [head], uncoordinated: [head] }
    where head.ComplementKind = Intransitive,
          head.TargetMarked != Marked,
          head.DeterminativeDistribution != Independent | Numerical | IndefiniteArticle | Distributive | Deictic | SingularOrQuantified | FreeChoice | Multiplier | Targeting,
          $.Countability = head.Countability,
          $.Countability = Count,
          $.NounKind = Quantity,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// A spelled cardinal is a Quantity (*one or more*); an Arabic numeral or
// variable is Numeric (*X is 5 or more*).
FusableCardinal: FusableDeterminer -> ChoiceQuantity
    where $.Countability = Count,
          $.NounKind = Quantity
FusableAmount: FusableDeterminer -> Amount
    where $.Number = head.QuantityNumber,
          $.Countability = Count,
          $.NounKind = Numeric
FusableQuantifier: FusableDeterminer -> Class(FusedQuantifier)
FusableChoice: FusableDeterminer -> Class(FusedChoice)
// *Choose one or more*, *if X is 5 or more*.
FusedQuantityCoordination: FusedNounPhrase -> FusedQuantity
    where $.NounKind = Quantity,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// A focusing adverb modifies a Noun Phrase (*only one target*), as a
// multiplier does in MultipliedNounPhrase; a bounding one, its quantity (*at
// least one creature*). A focusing modifier precedes a determined Noun Phrase
// (*exactly those colors*; CGEL 6§7.3.1:587); numerical determination is
// AdverbModifiedDeterminerPhrase's, and an equative determinative's bound
// BoundedEquativeDeterminer's.
BoundingNounPhrase: NounPhrase -> modifier:AdverbPhrase determiner:DeterminerPhrase Nominal
    where modifier.AdjunctPosition = Bounding,
          determiner.DeterminativeDistribution != Numerical | Independent | FreeChoice,
          determiner.Grade != Equative,
          determiner.ComplementKind != PP,
          $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
AdverbModifiedNounPhrase: NounPhrase -> modifier:AdverbPhrase NounPhrase
    where modifier.AdjunctPosition = Phrasal,
          $.Periphery = External
// *Both* floated after a plural Object (*put two cards from your hand both
// on top of your library or both on the bottom of your library*, Dream
// Cache), where the second *both* is the second Cluster's own Object. A
// Subject has FloatedEach.
FloatedObjectBoth: ComplementNounPhrase -> NounPhrase adjunct:Word(Both) { uncoordinated: [head] }
    where head.Number = Plural,
          head.NounKind != Numeric,
          head.Case != Nominative | Genitive
// *All* after an accusative personal pronoun (*remove them all*, *remove it
// all*; CGEL 5§10.1.1:427–428), never a full Noun Phrase.
FloatedObjectAll: ComplementNounPhrase -> NounPhrase adjunct:Word(All) { uncoordinated: [head] }
    where head.Case = Accusative
AdverbModifiedPrepositionPhrase: PrepositionPhrase -> modifier:AdverbPhrase PrepositionPhrase
    where modifier.AdjunctPosition = Phrasal
AdverbModifiedDeterminerPhrase: DeterminerPhrase -> modifier:AdverbPhrase DeterminerPhrase
    where modifier.AdjunctPosition = Bounding,
          head.DeterminativeDistribution = Numerical,
          head.TargetMarked != Marked
// *Attack only alone*.
AdverbModifiedAdjectivePhrase: AdjectivePhrase -> modifier:AdverbPhrase AdjectivePhrase
    where modifier.AdjunctPosition = Phrasal,
          $.AdjectivePosition = Predicative
// A phrasal adverb modifies a single adverb, inside any frequency interval
// (*[only once] each turn*).
AdverbModifiedAdverbPhrase: AdverbPhrase -> modifier:AdverbPhrase AdverbPhrase { light: [head] }
    where modifier.AdjunctPosition = Phrasal
PredeterminerCount: NounPhrase -> determiner:Class(Predeterminer) NounPhrase
    where head.Determination = Overt,
          head.Number = Plural,
          determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Periphery = External
// *All* before a fused cardinal (*if you've done all four*; CGEL 5§12:434).
AllFusedCardinal: NounPhrase -> determiner:Word(All) ChoiceQuantity
    where head.Number = Plural,
          $.Number = Plural,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
SingularQuantifier: DeterminerPhrase -> Word(Any) modifier:Numeral(Cardinal)
    where modifier.Number = Singular,
          $.Number = Singular,
          $.ComplementKind = Intransitive
// A temporal location or frequency Adjunct is a Noun Phrase (CGEL
// 8§6.3:698, 8§9:715), the one the Noun Phrase Productions build, and these
// take it whole. TemporalLocation: a period noun, which as such an Adjunct
// requires a dependent (*this turn*, *each combat*, *last turn*), *the* only
// with another one (*the following year*, never ∗*She resigned the day*;
// 8§6.3:698). Refusing the `Dependent` determinatives is an admission gate
// (english.md §6) that keeps *End [the turn]* (Time Stop) from a temporal
// Adjunct; refusing `IndefiniteArticle` and
// `Numerical` keeps *begin [an extra turn]* (Gerrard's Hourglass Pendant)
// and *its controller's next [two untap steps]* (Telekinesis) from one.
// SerialTemporal: a Noun Phrase headed by *time* (*three times*, *up to
// three times*, *every time*; 8§9:715), whatever its determiner.
// Both take a Noun Phrase that ends in its head (`head_final`), an admission
// gate: a relative clause bounds RelativeTemporalLocation's nominal, and a
// temporal Noun Phrase with *this* or *each* after the head is read as a
// second Adjunct (as *each year* probably is in *on three occasions each
// year*, 8§9:715; the clear postmodifiers there are *a* phrases, *twice a
// week*, which no card prints), which keeps *[the next time a
// source of your choice would deal damage to you this turn]* (Circle of
// Protection: Red) from a second tree beside RelativeTemporalLocation's and
// *[four or more [times this turn]]* (Dragon Whelp) from one beside two
// Adjuncts. Nor is TemporalLocation's Noun Phrase one with a dependent
// outside its determiner (`Periphery`), an admission gate: an adverb
// modifies the temporal Noun Phrase (AdverbModifiedTemporal), and *Activate
// no more than [twice [each turn]]* (Pit Imp) is no multiplied Adjunct.
TemporalLocation: TemporalNounPhrase -> NounPhrase { head_final: [head] }
    where head.NounKind := Temporal,
          head.NounDistribution != Serial,
          head.DeterminativeDistribution != Dependent | Numerical | IndefiniteArticle,
          head.Periphery != External,
          head.Determination := Overt,
          head.Case := Plain
SerialTemporal: TemporalNounPhrase -> NounPhrase { head_final: [head] }
    where head.NounDistribution := Serial,
          head.Determination := Overt,
          head.Case := Plain
// A comparative or equative count of *times* with its Complement after the
// head (*more times than ...*; *as many times as you choose*; CGEL
// 8§9:715): the Noun Phrase ComparativeDetermined or
// EquativeCountDetermined builds, as a frequency Adjunct.
ComparedFrequency: TemporalNounPhrase -> NounPhrase
    where head.NounDistribution := Serial,
          head.Comparison := Compared
// The same under a degree modifier (*Activate no more times each turn
// than the number of snow Swamps you control*, Withering Wisps), which no
// Noun Phrase Production builds.
ModifiedComparativeFrequency: TemporalNounPhrase ->
    modifier:Class(ComparativeDegreeModifier) determiner:Selecting(Determinative, Than) Nominal
    complement:Selected(PrepositionPhrase, Than)
    where head.NounDistribution = Serial,
          modifier.Countability = determiner.Countability,
          head.Number = Plural,
          determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Only any time they could cast a sorcery*.
AdverbModifiedTemporal: TemporalNounPhrase -> modifier:AdverbPhrase TemporalNounPhrase
    where modifier.AdjunctPosition = Phrasal
// A temporal nominal bounded by a relative clause (*next time you cast a
// spell*), then by temporal Noun Phrases only (RelativeBound).
RelativeTemporalLocation: TemporalNounPhrase -> determiner:DeterminerPhrase Nominal
    where head.RelativeBound := Bound,
          head.NounKind = Temporal,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *This turn, ...*; *The next time ..., ...*.
PreposedTemporalAdjunct: Clause -> adjunct:TemporalNounPhrase ',' Clause { transparent: [head] }
    where $.FrontPosition = Occupied
// A Preposition Phrase and a temporal Noun Phrase under one comma (*For one
// spell this turn, ...*). The Preposition Phrase has a Noun Phrase
// Complement: a Clause Complement keeps the temporal inside it (*When you
// next cast a spell this turn, ...*; [CR#603.1]). A temporal that can
// belong inside the phrase (*At the beginning of each combat this turn,
// ...*) ranks first there ([CR#603.1,603.7]; Attachment Class, english.md §5).
PreposedPrepositionAndTemporal: Clause ->
    adjunct:Hosted(PrepositionPhrase, Predicate) adjunct:TemporalNounPhrase ',' Clause {
    cost: 2,
    transparent: [head],
}
    where adjunct.ComplementKind = NP,
          $.FrontPosition = Occupied
// Two Preposition Phrases under one comma, a delayed trigger's timing and
// duration (*At the beginning of each of your upkeeps for the rest of the
// game, ...*; [CR#603.7]). Both have a Noun Phrase Complement: a Clause
// Complement keeps what follows it inside it (*If tapped for mana, ...*). A
// phrase that can belong inside the first ranks first there (*at the
// beginning of combat on your turn*): the second of two preposed dependents
// violates an Attachment Class (english.md §5).
PreposedPrepositionPair: Clause ->
    adjunct:Hosted(PrepositionPhrase, Predicate) adjunct:Hosted(PrepositionPhrase, Predicate) ','
    Clause { cost: 2, transparent: [head] }
    where adjunct.ComplementKind = NP,
          $.FrontPosition = Occupied
// *The first time each turn*.
TemporalPostmodifier: Nominal -> Nominal modifier:TemporalNounPhrase { cost: 2 }
    where head.NounKind = Temporal,
          $.RelativeBound = head.RelativeBound
TemporalAdjunct: VerbPhrase -> VerbPhrase adjunct:TemporalNounPhrase {
    cost: 2,
    transparent: [head],
}
MannerAdjunct: VerbPhrase -> VerbPhrase adjunct:NounPhrase { cost: 2, transparent: [head] }
    where adjunct.NounKind := Manner
FrequencyInterval: AdverbPhrase -> AdverbPhrase adjunct:TemporalNounPhrase
    where head.AdjunctPosition != Central | Phrasal | Multiplying | Linking
NumericCountPremodifier: QuantifiedNominal -> modifier:Amount BareNominal
    where $.QuantityNumber = head.Number,
          head.Countability = Count,
          modifier.QuantityNumber = head.Number
NumericMassPremodifier: QuantifiedNominal -> modifier:Amount BareNominal
    where $.QuantityNumber = head.Number,
          head.Countability = Mass,
          head.NounDistribution = DirectMeasure
CardinalCountPremodifier: QuantifiedNominal -> modifier:Numeral(Cardinal) BareNominal
    where $.QuantityNumber = head.Number,
          head.Countability = Count,
          modifier.Number = head.Number
CardinalMassPremodifier: QuantifiedNominal -> modifier:Numeral(Cardinal) BareNominal
    where $.QuantityNumber = head.Number,
          head.Countability = Mass,
          head.NounDistribution = DirectMeasure
ModifiedQuantity: ModifiedQuantifiedNominal -> modifier:AdjectivePhrase QuantifiedNominal
// Free-choice *any* with a cardinal is the determinative phrase *any one*
// (SingularQuantifier), so excluding `FreeChoice` is a gate (english.md §6, §8):
// without it *add three mana of any one color* (Lotus Vale) is also *any
// [one color]*, a second tree of FreeChoiceDetermined's. A multiplier with a
// number is MultipliedNumber's (*[half X] damage*, Banshee), never *half
// [X damage]*. The Targeting Marker determines a nominal, never a quantity,
// and excluding it is a gate: without it *deals X damage to target
// opponent or planeswalker and half X damage* (Eternal Flame) is also
// *target* over *[opponent or planeswalker and half] X damage*.
DeterminedQuantity: NounPhrase -> determiner:DeterminerPhrase QuantifiedNominal
    where determiner.DeterminativeDistribution != FreeChoice | Multiplier | Targeting,
          determiner.TargetMarked != Marked,
          determiner.Number = head.QuantityNumber,
          $.Number = head.QuantityNumber,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
DistributiveQuantity: NounPhrase -> determiner:DeterminerPhrase QuantifiedNominal
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.DeterminativeDistribution = Distributive,
          determiner.TargetMarked != Marked,
          $.Number = determiner.Number,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
// A singular determinative over a quantified plural, which *a* selects only
// with *further* or *additional* (*an additional two creatures*; CGEL
// 5§3.4:353). The determiner carries Singular: a number-neutral one (*the*)
// or a plural one is AgreeingModifiedQuantity's. A distributive one
// is DistributiveModifiedQuantity's, and an admission gate (english.md §6) keeps it
// out: without it *each five counters removed this way* (Sage of Hours) and
// *every five creature types among ...* (Sarek, Federation Ambassador) are
// also a DeterminedModifiedQuantity duplicate of their
// DistributiveModifiedQuantity.
DeterminedModifiedQuantity: NounPhrase -> determiner:DeterminerPhrase ModifiedQuantifiedNominal
    where determiner.Number := Singular,
          determiner.DeterminativeDistribution != Distributive,
          determiner.TargetMarked != Marked,
          head.QuantityNumber = Plural,
          $.Number = head.QuantityNumber,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
// Excluding `FreeChoice` is DeterminedQuantity's gate: without it *two mana
// of any one color they choose* (Stadium Vendors) is also *any [one color
// they choose]*.
AgreeingModifiedQuantity: NounPhrase -> determiner:DeterminerPhrase ModifiedQuantifiedNominal
    where determiner.Number = head.QuantityNumber,
          determiner.DeterminativeDistribution != Distributive | FreeChoice,
          determiner.TargetMarked != Marked,
          $.Number = head.QuantityNumber,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
DistributiveModifiedQuantity: NounPhrase -> determiner:DeterminerPhrase ModifiedQuantifiedNominal
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.DeterminativeDistribution = Distributive,
          determiner.TargetMarked != Marked,
          $.Number = determiner.Number,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
// A Preposition Phrase in Determiner function (*up to two target
// creatures*; CGEL 5§4:357). Its Complement is a bare quantity, never a
// determined Noun Phrase.
MaximumDetermination: NounPhrase -> determiner:Selected(PrepositionPhrase, Up) Nominal
    where determiner.Determination = Bare,
          determiner.Number = head.Number,
          head.Countability = Count,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Up to five {P} worth of modes* [CR#700.2i].
MaximumMeasuredMass: NounPhrase -> determiner:Selected(PrepositionPhrase, Up) Nominal {
    unshared: [NounKind],
}
    where determiner.Countability != Count,
          head.Countability = Mass,
          head.Number = Singular,
          $.NounKind = Resource,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// The fused head of its Noun Phrase (*choose up to one*).
FusedMaximum: NounPhrase -> Selected(PrepositionPhrase, Up)
    where head.ComplementKind = PP,
          $.NounKind = Quantity,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third
// *Costs {1} less to cast* (CGEL 13§4.4:1125–1126).
MeasuredComparativeHead: NounPhrase -> modifier:NounPhrase Selecting(Determinative, Than)
    where modifier.Case := Plain,
          modifier.Countability != Count,
          $.NounKind = Ordinary,
          $.Number = Singular,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// A determinative fused head and its *of* oblique (CGEL 5§9.1:411) are
// `valence PartitiveHead`'s. *Any* with a plural oblique leaves the Noun
// Phrase's Number open (*if any of those cards shares a card type*).
AnyPartitive: PartitiveHead -> Word(Any) complement:Selected(PrepositionPhrase, Of)
    where complement.Number = Plural,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
AnyMassPartitive: PartitiveHead -> Word(Any) complement:Selected(PrepositionPhrase, Of)
    where complement.Number = Singular,
          $.Number = Singular,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Up to two of them*; QuantityPartitive, *1 of that damage*.
MaximumPartitive: PartitiveHead ->
    Selected(PrepositionPhrase, Up) complement:Selected(PrepositionPhrase, Of)
    where $.NounKind = Quantity,
          $.Case = Plain,
          $.Person = Third
QuantityPartitive: PartitiveHead -> DeterminerPhrase complement:Selected(PrepositionPhrase, Of)
    where head.DeterminativeDistribution = Numerical,
          head.TargetMarked != Marked,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Create one of each* (Academy Manufactor), flat because fused *each* is
// no Complement (NonNumericComplement); fused at once, so no Preposition
// Phrase after it modifies it (*one of each of those kinds of counters* is
// the partitive of a partitive).
QuantityPartitiveOfEach: FusedNounPhrase -> DeterminerPhrase preposition:Word(Of) oblique:Word(Each)
    where head.DeterminativeDistribution = Numerical,
          head.TargetMarked != Marked,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A determinative with its own Complement heads a partitive, count over
// count and mass over mass: exceptive (*all but one of them*) or
// comparative with a bare standard (*more than one of the same mana
// symbol*). The Noun Phrase has the determiner's Number.
ComplementedPartitive: PartitiveHead -> DeterminerPhrase complement:Selected(PrepositionPhrase, Of)
    where head.ComplementKind = PP,
          head.Countability := Count,
          head.Countability = complement.Countability,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
ComplementedMassPartitive: PartitiveHead ->
    DeterminerPhrase complement:Selected(PrepositionPhrase, Of)
    where head.ComplementKind = PP,
          head.Countability := Mass,
          complement.Countability := Mass,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *That many of those tokens*; a bare degree determinative's partitive
// is `valence PartitiveHead`'s.
DegreePartitive: PartitiveHead -> DeterminerPhrase complement:Selected(PrepositionPhrase, Of) {
    heavy: [head],
}
    where head.ComplementKind = Intransitive,
          head.TargetMarked != Marked,
          head.DeterminativeDistribution != Independent | Numerical | IndefiniteArticle | Distributive | Deictic | SingularOrQuantified | FreeChoice | Multiplier | Targeting,
          head.Countability = complement.Countability,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A declared Adjectival Passive is no postmodifier: its verb's participial
// Verb Phrase is (ParticipialPostmodifier), which keeps *all other Auras
// attached to permanents you control* (Remove Enchantments) from a second,
// identical Reading through the Adjective *attached*.
PostpositiveAdjective: Nominal -> Nominal modifier:AdjectivePhrase {
    heavy: [modifier],
    uncoordinated: [head],
    unshared: [BareMassHead],
}
    where modifier.ComplementKind = PP,
          modifier.Voice != Passive,
          modifier.AdjectivalPassive != Lexical,
          $.BareMassHead = Expanded
PostpositiveCoordinationAdjective: Nominal -> Nominal modifier:AdjectivePhrase {
    coordinated: [head],
    heavy: [modifier],
}
    where modifier.ComplementKind = PP,
          modifier.Voice != Passive,
          modifier.AdjectivalPassive != Lexical
// *Creatures able to block it* (CGEL 5§14.2:445).
PostpositiveInfinitivalAdjective: Nominal -> Nominal modifier:AdjectivePhrase { heavy: [modifier] }
    where modifier.ComplementKind = ToInf,
          modifier.AdjectivePosition != Attributive,
          modifier.Voice != Passive
// A number, or a comparative adjective with that number as its standard
// (*power 3 or greater*). Its `Amount` ComplementKind keeps it out of
// depictives: never *[with power] [10 or greater]*.
ComparativeBoundedAlternative: AdjectivePhrase ->
    first:DeterminerPhrase coordinator:Word(Or) last:AdjectivePhrase
    where first.DeterminativeDistribution = Numerical,
          first.TargetMarked != Marked,
          $.Grade = last.Grade,
          $.AdjectivePosition = last.AdjectivePosition,
          $.Voice = last.Voice,
          $.ComplementKind = Amount,
          last.Grade := Comparative,
          last.ComplementKind = Intransitive
// The same as the value of a noun whose frame takes an Amount (*mana value
// X or greater*).
ComparativeBoundedAmount: Amount -> first:Amount coordinator:Word(Or) last:AdjectivePhrase
    where $.QuantityNumber = first.QuantityNumber,
          last.Grade := Comparative,
          last.ComplementKind = Intransitive,
          $.ComplementKind = Amount
// A comparative bound as the endpoint of a scalar change (*reduce it to
// less than 1*; CGEL 8§5.2:691–692).
ComparativeAmount: Amount ->
    Selecting(Determinative, Than) complement:Selected(PrepositionPhrase, Than)
    where head.Countability = Mass,
          complement.NounKind = Numeric,
          $.ComplementKind = PP
// A sum adjective after a determined Noun Phrase (*ten or more creature
// cards total*, Avatar of Woe), as *net* and *gross* follow specific sums
// (*fifty dollars net*; CGEL 5§14.2:445–446).
SumQualifiedNounPhrase: NounPhrase ->
    determiner:DeterminerPhrase Nominal modifier:Class(SumAdjective)
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third,
          determiner.ComplementKind != PP,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
// *For each card fewer than three in their hand*.
PostpositiveComparative: Nominal -> Nominal modifier:DeterminerPhrase { cost: 2, heavy: [modifier] }
    where head.Number = Singular,
          modifier.ComplementKind = PP,
          modifier.Countability = Count,
          modifier.ObliqueKind != AdvP
PostpositiveLocativeAdjective: LocativeHead -> LocativeHead modifier:AdjectivePhrase {
    heavy: [modifier],
}
// *2 greater* (CGEL 13§4.4:1125–1126). `Carry`, since a coordination, whose
// Grade is unshared, would pass a `Require`.
MeasuredComparative: AdjectivePhrase -> modifier:NounPhrase AdjectivePhrase
    where head.Grade := Comparative,
          head.ComplementKind = Intransitive,
          modifier.Determination = Bare,
          modifier.Case := Plain
// The same with a *than* Complement and a numeric measure (*at least 10
// greater than your starting life total*).
MeasuredStandardComparative: AdjectivePhrase -> modifier:NounPhrase AdjectivePhrase
    where head.Grade := Comparative,
          head.ComplementKind = PP,
          modifier.NounKind := Numeric,
          modifier.Case := Plain
// *The most creatures* (CGEL 5§6.1:393).
SuperlativeCountDeterminer: DeterminerPhrase -> marker:Word(The) Class(SuperlativeQuantifier)
    where $.Number = Plural,
          $.Countability = Count,
          $.ComplementKind = Intransitive
SuperlativeMassDeterminer: DeterminerPhrase -> marker:Word(The) Class(SuperlativeQuantifier)
    where $.Number = Singular,
          $.Countability = Mass,
          $.ComplementKind = Intransitive
// The *than* Complement after the head (*more lands than you*, *less life
// than an opponent*; CGEL 13§2.1:1104): a count determinative over a plural
// count head, a mass one over a singular mass head, as the determinative's
// own Number and Countability say (13§4.1.2:1126, [16]). The lexicon's
// *less* is mass only, so count *less* (*less cards*, 13§4.1.2:1127, [17vi])
// has no Reading.
ComparativeDetermined: NounPhrase ->
    determiner:Selecting(Determinative, Than) Nominal complement:Selected(PrepositionPhrase, Than)
    where determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Comparison = Compared,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// The comparative clause after an equative head (*draws as many cards as
// they discarded this way*, Forget; CGEL 13§2.1:1108).
EquativeCountDetermined: NounPhrase ->
    determiner:DeterminerPhrase Nominal complement:Selected(PrepositionPhrase, As)
    where determiner.Grade := Equative,
          complement.ComplementKind = ComparativeClause,
          $.Comparison = Compared,
          head.Number = Plural,
          head.Countability = Count,
          determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *No more than one*, *many more than two*: `valence DeterminerPhrase`'s
// comparative under a degree modifier, *many* only over count *more*
// (Countability) and *much* over mass. The phrase has no Grade of its own,
// so no second modifier takes it (∗*no no more than one*).
ModifiedComparativeDeterminer: DeterminerPhrase ->
    modifier:Class(ComparativeDegreeModifier) DeterminerPhrase { unshared: [Grade] }
    where head.Grade := Comparative,
          modifier.Countability = head.Countability
// *No more scream counters*: no *than* Complement.
DegreeModifiedComparativeDeterminer: DeterminerPhrase ->
    modifier:Class(ComparativeDegreeModifier) Selecting(Determinative, Than)
    where modifier.Countability = head.Countability,
          $.ComplementKind = Intransitive
// *Plus* and *minus* phrases modify a quantity (*2 plus the number of ...*,
// *that many plus one*).
AmountArithmetic: Amount -> Amount modifier:Selected(PrepositionPhrase, Plus, Minus)
    where modifier.ComplementKind = Amount
// *X minus one*.
AmountQuantityArithmetic: Amount -> Amount modifier:Selected(PrepositionPhrase, Plus, Minus)
    where modifier.ComplementKind = NP,
          modifier.Determination = Bare
// *X minus one 2/2 ... tokens*.
ArithmeticDeterminer: NumericalDeterminer ->
    NumericalDeterminer modifier:Selected(PrepositionPhrase, Plus, Minus)
    where modifier.ComplementKind = NP,
          modifier.Determination = Bare,
          modifier.Case != Genitive
// A fraction or multiplier before the quantity it multiplies: a multiplier
// determinative (*half*), a multiplying adverb (*twice*) or a cardinal and
// a serial noun (*three times*).
DeterminativeMultiplier: Multiplier -> DeterminerPhrase
    where head.DeterminativeDistribution := Multiplier,
          head.TargetMarked != Marked
AdverbMultiplier: Multiplier -> AdverbPhrase where head.AdjunctPosition := Multiplying
SerialMultiplier: Multiplier -> factor:Numeral(Cardinal) BareNominal
    where head.NounDistribution = Serial,
          head.Number = Plural
// A multiplier and a number form one number (*draw [half X] cards*, Hydroid
// Krasis; *[twice X] damage*, Stonesplitter Bolt; *[three times X] cards*).
MultipliedNumber: NumericalDeterminer -> multiplier:Multiplier NumericalDeterminer
// A multiplier and a degree determinative form one degree determinative
// (*create [twice that many] of those tokens*, Doubling Season).
MultipliedDegree: DeterminerPhrase -> multiplier:Multiplier DeterminerPhrase
    where head.DeterminativeDistribution := Degree,
          head.TargetMarked != Marked
// A multiplier before a Noun Phrase (*twice its power*, *half their life*,
// *three times this creature's power*). A head determined by a number or
// degree determinative is excluded: *twice X damage* (Stonesplitter Bolt) is
// MultipliedNumber's *[twice X] damage*, and *half that many +1/+1 counters*
// (Ochre Jelly) MultipliedDegree's *[half that many] +1/+1 counters*. The
// rest are admission gates. Multipliers occur only with definite Noun Phrases
// (CGEL 5§12:434), and a distributive head is no definite one, which keeps
// *This ability triggers only [twice [each turn]]* (Nadu, Winged Wisdom) from
// an Object of *triggers*. An overt, plain head keeps a genitive
// determiner from the multiplied phrase (*[twice [that card's]] power*,
// Amplifire), and so does a coordination of differing determination
// (*twice [the number of white] and/or [blue permanents]*, Chaotic Backlash).
MultipliedNounPhrase: NounPhrase -> multiplier:Multiplier NounPhrase
    where head.Determination = Overt,
          head.Case = Plain,
          head.DeterminativeDistribution != Numerical | Degree | Distributive,
          $.Periphery = External
// A multiplier before a symbol sequence, a bare quantity of mana (*unless its
// controller pays twice {X}*, Thassa's Intervention).
MultipliedSymbols: FusedNounPhrase -> multiplier:Multiplier Symbols
    where $.NounKind = Resource,
          $.Determination = Bare,
          $.Case = Plain,
          $.Number = Singular,
          $.Person = Third
NumericArithmetic: NounPhrase -> Amount modifier:Selected(PrepositionPhrase, Plus, Minus)
    where modifier.ComplementKind = NP,
          modifier.Determination = Overt,
          $.NounKind = Ordinary,
          $.Number = Singular,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
NounPhraseArithmetic: NounPhrase -> NounPhrase modifier:Selected(PrepositionPhrase, Plus, Minus)
    where head.NounKind != Numeric,
          head.Case := Plain
// *That many times plus an additional time*.
TemporalArithmetic: TemporalNounPhrase ->
    TemporalNounPhrase modifier:Selected(PrepositionPhrase, Plus, Minus)
    where modifier.NounKind = Temporal
// *Copy that spell once plus an additional time for each opponent*.
FrequencyAdverbArithmetic: AdverbPhrase ->
    AdverbPhrase modifier:Selected(PrepositionPhrase, Plus, Minus)
    where head.AdjunctPosition = End,
          modifier.NounKind = Temporal
// It adds a number, so its operand is a quantity (*one*), never an ordinary
// Noun Phrase: an admission gate (english.md §6) that keeps *[that many plus
// [one +1/+1]] counters*, a fused measure noun as the operand, off Hardened
// Scales.
DegreeArithmetic: DeterminerPhrase ->
    DeterminerPhrase modifier:Selected(PrepositionPhrase, Plus, Minus) { heavy: [head] }
    where head.ComplementKind = Intransitive,
          head.TargetMarked != Marked,
          modifier.NounKind != Ordinary | Temporal | Manner | Resource
AdverbAdverbial: Adverbial -> AdverbPhrase where head.AdjunctPosition = End
FrequencyAdverbial: Adverbial -> TemporalNounPhrase
// *Choose the same mode more than once*: the standard is a bounding
// frequency, so *more* is count (CGEL 13§4.1:1123).
ComparativeAdverb: AdverbPhrase ->
    Selecting(Determinative, Than) complement:Selected(PrepositionPhrase, Than)
    where complement.ComplementKind = AdvP,
          head.Countability = Count,
          $.AdjunctPosition = End
ModifiedComparativeAdverb: AdverbPhrase ->
    modifier:Class(ComparativeDegreeModifier) Selecting(Determinative, Than)
    complement:Selected(PrepositionPhrase, Than)
    where complement.ComplementKind = AdvP,
          head.Countability = Count,
          modifier.Countability = head.Countability,
          $.AdjunctPosition = End
// *Greater power than this creature* (CGEL 5§14.1:443).
ComparativeIndirectComplement: Nominal ->
    modifier:AdjectivePhrase Nominal complement:Selected(PrepositionPhrase, Than)
    where modifier.Grade := Comparative,
          modifier.AdjectivePosition != Predicative,
          modifier.DeterminerNeed = $.DeterminerNeed
// The same for a non-scalar governor of inequality (CGEL 13§5.4:1143–1145).
// English also has *from* and *to* here (*a different question from the one I
// asked*); Oracle prints only *than*.
NonScalarIndirectComplement: Nominal ->
    modifier:AdjectivePhrase Nominal complement:Selected(PrepositionPhrase, Than)
    where modifier.Grade := NonScalarInequality,
          modifier.AdjectivePosition != Predicative,
          modifier.DeterminerNeed = $.DeterminerNeed
EquativeIndirectComplement: Nominal ->
    modifier:AdjectivePhrase Nominal complement:Selected(PrepositionPhrase, As)
    where modifier.Grade := Equative,
          complement.ComplementKind = NP,
          modifier.DeterminerNeed = $.DeterminerNeed
// *Your most recent turn*: a plain adjective heads a superlative phrase.
DegreeModifiedAdjective: AdjectivePhrase -> modifier:Word(Most) AdjectivePhrase {
    unshared: [Grade],
}
    where $.AdjectivePosition = Attributive,
          head.Grade := Plain,
          $.Grade = Superlative
DegreeModifiedAdverb: AdverbPhrase -> modifier:Word(Most) AdverbPhrase
    where head.AdjunctPosition = Central
// *Ignore all but the highest roll* (CGEL 5§11(f):433): count *all*, plural
// whatever the exception's Number. Only a definite standard; a bare
// quantity is ComparativeFusedHead's. A fused quantifier gives the Noun
// Phrase no DeterminativeDistribution, so it is never a standard under a
// dependent determinative (ComparativeDeterminedStandard): that is unshared.
ExceptiveFusedHead: NounPhrase -> DeterminerPhrase { unshared: [DeterminativeDistribution] }
    where head.ComplementKind = PP,
          head.ObliqueKind = NP,
          head.ObliqueDetermination = Overt,
          head.ObliqueDistribution := Dependent,
          head.Countability := Count,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *By more than {5}*: a bare standard, whose Number the Noun Phrase takes.
// Scalar *less than* is the adjective's. DeterminativeDistribution is
// unshared, as in ExceptiveFusedHead.
ComparativeFusedHead: NounPhrase -> DeterminerPhrase {
    unshared: [Number, DeterminativeDistribution],
}
    where head.ComplementKind = PP,
          head.ObliqueKind != AdvP | ComparativeClause,
          head.ObliqueDetermination = Bare,
          head.Countability != Mass,
          $.Number = head.ObliqueNumber,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Can't be more than the total number of ...* (CGEL 13§4.5(a):1132): a
// standard under a dependent determinative. Never a quantified one (*more
// than two* determines *lands*). Predicative *less than* is the
// adjective's. DeterminativeDistribution is unshared, as in
// ExceptiveFusedHead.
ComparativeDeterminedStandard: NounPhrase ->
    Selecting(Determinative, Than) complement:Selected(PrepositionPhrase, Than) {
    unshared: [Number, DeterminativeDistribution],
}
    where complement.ComplementKind = NP,
          complement.Determination = Overt,
          complement.DeterminativeDistribution := Dependent,
          head.Countability != Mass,
          $.Number = complement.Number,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *A third of their life*.
FractionPartitive: PartitiveHead ->
    determiner:DeterminerPhrase Numeral(Ordinal) complement:Selected(PrepositionPhrase, Of)
    where $.Number = Singular,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *At least 7 life more than your starting life total*. The measure is
// numerically quantified: in *power less than this creature's power*,
// *power* has a postpositive comparative.
MeasuredComparativeStandard: NounPhrase ->
    modifier:NounPhrase Selecting(Determinative, Than) complement:Selected(PrepositionPhrase, Than)
    where modifier.Case := Plain,
          modifier.DeterminativeDistribution := Numerical,
          complement.ComplementKind != AdvP,
          $.NounKind = Ordinary,
          $.Number = Singular,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
MeasuredComparativeDetermined: NounPhrase ->
    modifier:DeterminerPhrase determiner:Selecting(Determinative, Than) Nominal
    complement:Selected(PrepositionPhrase, Than)
    where modifier.DeterminativeDistribution = Numerical,
          modifier.TargetMarked != Marked,
          head.Number = Plural,
          head.Countability = Count,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// Takes the measure's Number (*one more spell*, *one fewer revival
// counter*).
MeasuredComparativeDeterminer: DeterminerPhrase ->
    modifier:DeterminerPhrase Selecting(Determinative, Than) {
    unshared: [Number],
}
    where modifier.DeterminativeDistribution = Numerical,
          modifier.TargetMarked != Marked,
          $.Number = modifier.Number,
          $.Countability = Count,
          $.ComplementKind = Intransitive
// *Are each equal to ...*, *power and toughness each equal to ...*.
FloatedEachAdjective: AdjectivePhrase -> adjunct:Word(Each) AdjectivePhrase
    where head.ComplementKind = PP
// *Creature cards each with mana value 3 or less*.
FloatedEachPostmodifier: Nominal ->
    Nominal adjunct:Word(Each) modifier:Hosted(PrepositionPhrase, Nominal) { heavy: [modifier] }
    where head.Number = Plural
// Nominals under one determiner, then a Noun Phrase with its own (*their
// hand, graveyard, and all permanents they own*). The shared nominals are
// singular count, so none is a Noun Phrase alone and no serial Noun Phrase
// coordination brackets the same words.
SharedDeterminerCoordination: NounPhrase ->
    determiner:DeterminerPhrase SharedNominals ',' coordinator:Word(And) last:NounPhrase
    where last.Determination = Overt,
          determiner.DeterminativeDistribution != Independent,
          determiner.ComplementKind != PP,
          $.Number = Plural,
          $.Person = Third,
          $.Case = Plain,
          $.Determination = Overt
SharedNominalPair: SharedNominals -> first:Nominal ',' last:Nominal
    where first.Number = Singular,
          first.Countability = Count,
          last.Number = Singular,
          last.Countability = Count
SharedNominalSequence: SharedNominals -> first:Nominal ',' rest:SharedNominals
    where first.Number = Singular,
          first.Countability = Count
// The same over a Noun Phrase coordination (*up to one target instant card
// and/or up to one target sorcery card from your graveyard each with mana
// value X or less*). An uncoordinated plural one has
// FloatedEachPostmodifier's nominal site, and a singular coordination none
// (never *a creature or a land each with flying*).
FloatedEachCoordinationPostmodifier: NounPhrase ->
    NounPhrase adjunct:Word(Each) modifier:Hosted(PrepositionPhrase, Nominal) {
    heavy: [modifier],
    coordinated: [head],
}
    where head.Number != Singular
// A Preposition Phrase postmodifier over a whole coordination of Noun Phrases
// (*[up to one target instant card and/or up to one target sorcery card] from
// your graveyard*, Finale of Promise; *[Your opponents and permanents your
// opponents control] with hexproof*, Kaya, Bane of the Dead; CGEL
// 15§1.3.4:1285–1286). An uncoordinated Noun Phrase has its Nominal's site
// (`coordinated`), and an all-bare coordination (*[Artifact cards and red
// creature cards] in your hand*, Tannuk, Steadfast Second) has the Nominal
// coordination's (`head.Determination != Bare`; english.md §8). Excluding
// `Postmodification = Closed` is an admission gate (english.md §6): personal
// pronouns (CGEL 5§10.2:429–430) and proper names (5§20.3–20.4:520–521) take
// no integrated nominal postmodifiers, so none scopes over a coordination
// with one (*[you or a planeswalker you control] with at least one creature*,
// Trove of Temptation; *[Shadow the Hedgehog or another creature you control]
// with flash or haste*, Shadow the Hedgehog).
CoordinatedNounPhrasePostmodifier: NounPhrase ->
    NounPhrase modifier:Hosted(PrepositionPhrase, Nominal) {
    coordinated: [head],
}
    where head.Determination != Bare,
          head.Postmodification != Closed
// A relative or participial clause over a whole coordination of Noun Phrases
// (*a triggered ability of [a Shaman or another Wizard] you control*, Harmonic
// Prodigy; CGEL 15§1.3.4:1285–1286), with CoordinatedNounPhrasePostmodifier's
// sites: an all-bare coordination has the Nominal coordination's, so
// without `head.Determination != Bare` *[Angel spells and Human spells] you
// cast* has a second tree (Herald of War; english.md §8). So a participial
// clause (*[a legendary permanent or an artifact] entering or leaving the
// battlefield*, Gandalf the White). The clause's NounKind is the
// coordination's, as it is a nominal's in NominalPostmodifier. A subject
// relative agrees with the coordination's Number: singular after distributive
// conjuncts (*[each white creature and each player] who controls a white
// creature*, Disorder; 5§18.4:508), plural after other *and* ones, as a verb
// agrees with the coordination as its Subject.
// Excluding `Postmodification = Closed` is an admission gate (english.md §6),
// as it is there: without it *[you or a permanent] you control* reads
// (Leovold, Emissary of Trest), and *[Radagast or another nontoken creature]
// you control* (Radagast the Brown; a proper name takes no integrated
// relative, CGEL 12§4.1:1060).
CoordinatedNounPhraseClausePostmodifier: NounPhrase -> NounPhrase modifier:Postmodifier {
    coordinated: [head],
}
    where head.Determination != Bare,
          head.Postmodification != Closed,
          head.Number = modifier.Number,
          head.NounKind = modifier.NounKind
// *Any number of target players may each search ...*.
AuxiliaryFloatedEach: VerbPhrase -> adjunct:Class(FloatingQuantifier) VerbPhrase {
    cost: 2,
    transparent: [head],
}
    where head.VerbForm = Plain
// Two front dependents under one comma (*Then if ...*); the adverb is the
// Clause's Adjunct, not the Preposition Phrase's modifier.
PreposedAdverbAndPreposition: Clause ->
    adjunct:AdverbPhrase adjunct:Hosted(PrepositionPhrase, Predicate) ',' Clause {
    cost: 2,
    transparent: [head],
}
    where adjunct.AdjunctPosition = Front,
          $.FrontPosition = Occupied
// *Pay half your life, rounded up:*.
SupplementedVerbalCost: NonManaCost -> VerbPhrase ',' supplement:VerbPhrase {
    capital: [head],
    cost: 3,
    heavy: [supplement],
}
    where head.VerbForm = Plain,
          supplement.VerbForm = PastParticiple,
          supplement.Voice = Passive
NominalInstruction: Sentence -> IndexedNominal '.' { capital: [head] }
// *When this Class becomes level 2*.
IndexedNounPhrase: NounPhrase -> IndexedNominal
    where head.Number = Singular,
          $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// The count-noun pro-form *one* (*this one*, *the first one they draw*).
CardinalNominal: BareNominal -> Numeral(Cardinal)
    where $.DeterminerNeed = Required,
          $.Number = Singular,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.NounDistribution = Ordinary
// *for each target beyond the first*.
FusedOrdinalHead: NounPhrase -> determiner:DeterminerPhrase Numeral(Ordinal)
    where determiner.Countability = Count,
          determiner.Number = Singular,
          $.Number = Singular,
          $.Case = Plain,
          $.NounKind = Ordinary,
          $.Countability = Count,
          $.Determination = Overt,
          $.Person = Third
// Uninflected pro-nominal *other* is singular, its plural *others* (CGEL
// 5§10.2:429–430), and its determiner agrees: *among [the other]* is no
// Complement, so *cards exiled ...* is no relative clause on *spells from
// among the other* (Plargg and Nassari).
FusedAdjectiveHead: NounPhrase -> determiner:DeterminerPhrase Class(FusedHeadAdjective)
    where $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt,
          $.Countability = Count,
          determiner.Countability = $.Countability,
          $.Number = Singular,
          determiner.Number = $.Number,
          $.NounKind = Ordinary
// Anaphoric *the same* (*do the same for ...*; CGEL 17:1545); its head
// stays an adjective.
DefiniteFusedAdjectiveHead: NounPhrase -> determiner:Word(The) Class(DefiniteFusedHeadAdjective)
    where $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt,
          $.Countability = Count,
          $.NounKind = Ordinary
SingleRowHeader: RowHeader -> Amount
OpenRowHeader: RowHeader -> Amount '+'
UnicodeRangeRowHeader: RowHeader -> lower:Amount '—':Bound upper:Amount
TableRow: Ability -> header:RowHeader '|':Free Ability { capital: [head] }
SequentialVerbalCosts: NonManaCost -> first:VerbPhrase ',' rest:Cost { capital: [first] } where first.VerbForm = Plain
DeclarativeCost: NonManaCost -> Clause { capital: [head] }
    where head.VerbForm = Finite, head.Inflection != Irrealis
ClauseCondition: Condition -> Clause
KeywordInstruction: Sentence -> KeywordLineItem '.' { capital: [head] } where head.KeywordForm = Parametric
// A floating quantifier after a plural Subject (*they each*) or *you*,
// singular in Oracle but with plural verb forms (*You each lose life*).
// `!(adjunct.Number = Plural & subject.Number = Singular)`: an admission gate
// (english.md §6) against *both* floated after *you*, where it is the
// correlative of a coordination (*all enchantments you [both own and
// control]*, Remove Enchantments); *both* floats after a plural Subject, as
// FloatedObjectBoth's Object is plural.
FloatedEach: Clause -> subject:NounPhrase adjunct:Class(FloatingQuantifier) VerbPhrase {
    transparent: [head],
}
    where !(subject.Number = Singular & subject.Person = Third),
          !(adjunct.Number = Plural & subject.Number = Singular),
          subject.Case != Accusative,
          subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          $.ClauseMarking = Unmarked,
          $.ClauseShape = SubjectInitial
// *They all share a color*: after a personal pronoun Subject only.
FloatedAll: Clause -> subject:NounPhrase adjunct:Word(All) VerbPhrase { transparent: [head] }
    where subject.Number = Plural,
          subject.Case = Nominative,
          subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          $.ClauseMarking = Unmarked,
          $.ClauseShape = SubjectInitial
NumericalDetermination: DeterminerPhrase -> NumericalDeterminer
    where $.DeterminativeDistribution = Numerical,
          $.ComplementKind = Intransitive
MeasuredMass: NounPhrase -> determiner:DeterminerPhrase Nominal { unshared: [NounKind] }
    where determiner.DeterminativeDistribution = Numerical,
          determiner.TargetMarked != Marked,
          $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          head.NounDistribution = DirectMeasure,
          head.Countability = Mass,
          head.Number = Singular,
          $.NounKind = Resource,
          $.Case = Plain,
          $.Determination = Overt,
          $.Person = Third
// *For each mana spent*.
DistributiveMeasure: NounPhrase -> determiner:DeterminerPhrase Nominal { unshared: [NounKind] }
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.DeterminativeDistribution = Distributive,
          determiner.TargetMarked != Marked,
          head.NounDistribution = DirectMeasure,
          head.Countability = Mass,
          head.Number = Singular,
          determiner.NounKind = head.NounKind,
          $.NounKind = Resource,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
FusedPhrase: NounPhrase -> FusedNounPhrase { transparent: [head] }
LocativeFusedHead: FusedNounPhrase -> LocativeHead
PartitiveFusedHead: FusedNounPhrase -> PartitiveHead { transparent: [head] }
FusedLocative: LocativeHead -> Word(Anywhere)
    where $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// A cited noun (*choose land or nonland*): bare and singular, since it
// names the word.
WordMention: Mention -> FreeLex(Noun) where head.Inflection = Singular
NegativeMention: Mention -> prefix:Lex(Affix) Mention { light: [head], uncoordinated: [head] }
// A cited adjective that names a Quality (*choose odd or even*, Extinction
// Event), as AdjectivalQuality's does after *protection from*.
QualityMention: Mention -> AdjectivePhrase { uncoordinated: [head] }
    where head.QualityHead := Fused,
          head.ComplementKind = Intransitive
// A cited noun under an attributive adjective or a cited *non-* word
// (*non-Aura enchantment*), never under a cited noun (*choose target
// creature* is an ordinary Noun Phrase). The head is one word, so a longer
// term is left-branching, one tree.
CompoundMention: Mention -> modifier:MentionModifier Mention {
    light: [head],
    uncoordinated: [head],
}
AdjectiveMentionModifier: MentionModifier -> AdjectivePhrase { light: [head] }
    where head.ComplementKind = Intransitive,
          head.AdjectivePosition != Predicative
NegativeMentionModifier: MentionModifier -> prefix:Lex(Affix) Mention {
    light: [head],
    uncoordinated: [head],
}
// *Four or more nonlands*: one noun, never a compound under the prefix.
PrefixedNoun: BareNominal -> prefix:Lex(Affix) BareNominal { light: [head] }
    where head.Countability := Count
AttributiveNoun: NounPremodifier -> FreeLex(Noun)
    where head.Inflection = Singular,
          head.NounDistribution != HeadOnly
PrefixedNounPremodifier: NounPremodifier -> prefix:Lex(Affix) NounPremodifier
    where $.Polarity = Negative
// *Each differently named dungeon*: only a manner adverb, which a clause
// has in end position, expands an attributive participle (CGEL
// 14§1.1:1175).
AdverbModifiedParticiple: Participle -> modifier:AdverbPhrase Participle { cost: 0 }
    where modifier.AdjunctPosition = End
// *Nonattacking*.
PrefixedParticiple: Participle -> prefix:Lex(Affix) Participle { cost: 0 }
    where $.Polarity = Negative
NounConjunct: NounPremodifierConjunct -> NounPremodifier { cost: 0 }
// A noun premodifier sits inside determinative and adjectival ones,
// never outside them or on a determined symbol (*amount {G}*).
NounAttribute: Attribute -> filler:NounPremodifier
    where $.ConjunctKind = NounPremodifier,
          $.Polarity = filler.Polarity
// A gerund-participle as an unlike conjunct of an adjective (*tapped and
// attacking token*, Altaïr Ibn-La'Ahad). `Carry`, since a coordination of
// participles not all gerund-participles leaves Inflection unvalued and
// would pass a `Require`.
ParticipialAttribute: Attribute -> filler:Participle
    where filler.Inflection := GerundParticiple,
          $.ConjunctKind = Participial,
          $.Polarity = filler.Polarity
AdjectivalAttribute: Attribute -> filler:AdjectivePhrase
    where filler.ComplementKind = Intransitive,
          filler.AdjectivePosition != Predicative,
          $.ConjunctKind = AdjP,
          $.Polarity = filler.Polarity
// Oracle sets off with commas only independent negative modifiers of one
// head, so each premodifier of an asyndetic chain is `Polarity: Negative`
// (OSG §6, Determiners and modifier order). Any other comma is a serial
// coordination's (*a Swamp, Mountain, black permanent, or red permanent*).
// The `Polarity := Negative` carries here and in AttributeSequence and
// FinalAttribute are one admission gate (english.md §6), with no effect apart: they
// keep *Plains* from an asyndetic premodifier before the coordination
// *Island, Swamp, or Mountain* (*a Plains, Island, Swamp, or Mountain card*,
// Farseek).
AsyndeticAttributes: Attributes -> first:Attribute ',' rest:AttributeChain
    where first.Polarity := Negative
AttributeSequence: AttributeChain -> first:Attribute ',' rest:AttributeChain
    where first.Polarity := Negative
FinalAttribute: AttributeChain -> last:Attribute where last.Polarity := Negative
AttributedPremodifier: Premodifier -> Attributes { cost: 0 }
// *Counter* takes no noun premodifier but its kind: an admission gate
// (english.md §3, §6) that keeps the noun *loyalty* from premodifying
// *counter* beside the kind name in *Put a loyalty counter on target Gideon
// planeswalker* (Gideon's Company).
// Nor does *expansion* take a noun premodifier beside its Set Name: an
// admission gate that keeps the subtypes *Urza's* and *Saga* from
// premodifying it in Golgothian Sylex's wording citing Urza's Saga (*the
// Urza's Saga expansion*, tests/set_names.rs).
NominalPremodifier: BareNominal -> modifier:NounPremodifier BareNominal { transparent: [head] }
    where head.DeterminerNeed != Required,
          head.KindLicense != Head,
          head.SetNameLicense != Head
QuantifiedNominalPremodifier: QuantifiedNominal -> modifier:NounPremodifier QuantifiedNominal
// A bare count singular nominal that a preposition's frame selects (*until
// end of turn*).
BarePrepositionalNominal: BareNominalComplement -> PrepositionalNominal
    where head.Number = Singular,
          head.Countability := Count
// A superlative over a bare count singular nominal after *tied for*
// (*tied for lowest life total*, Loxodon Peacekeeper). CGEL requires a
// determiner with a count singular head, the superlative only making it
// definite (13§6.3.4:1169); Oracle's *tied for* drops it. The head carries
// Count itself: a noun that is also non-count drops the article as a bare
// non-count Noun Phrase (BareMass; *(the) greatest need*, 13§6.3.4:1168),
// the same analysis (*tied for greatest power*, Desecrator Hag; english.md §8).
SuperlativeBareNominal: BareNominalComplement -> modifier:AdjectivePhrase BareNominal
    where modifier.Grade := Superlative,
          modifier.ComplementKind = Intransitive,
          modifier.AdjectivePosition != Predicative,
          head.Number = Singular,
          head.Countability := Count
// *Tied for fewest* (Goblin Game). CGEL makes *the* obligatory with a fused
// determiner-head (*the most we can hope for*; 13§6.3.4:1168); Oracle's
// *tied for* drops it.
SuperlativeQuantifierFusedHead: BareNominalComplement -> Class(CountSuperlativeQuantifier)
// *Tied for most common* (Sulam Djinn, Zanam Djinn), *tied for greatest*:
// the superlative fuses with its head (CGEL 5§9.3(b):416), where CGEL's
// fused superlatives all have a determiner and Oracle's *tied for* has
// none. CGEL's nearest description is the preposition + adjective idiom
// (*at last*, *in brief*), which for want of *the* it does not analyze as a
// fused head (7§3.2(c):626).
SuperlativeFusedHead: BareNominalComplement -> AdjectivePhrase
    where head.Grade := Superlative,
          head.ComplementKind = Intransitive,
          head.AdjectivePosition != Predicative
// A bare Noun Phrase is never a coordination of Nominals (BarePlural too):
// the Noun Phrases coordinate (*creatures and lands*, *chaos and silence*),
// Nominals only under something shared (*all [creatures and lands]*, *[power
// and toughness] 0/2*, *[mana value, power, or toughness] equal to ...*;
// english.md §8). A `BareMass = Modified` noun (*mana value*, *power*,
// *toughness*, *control*, *loyalty*) takes `BareMass` only when a Complement,
// Modifier or coordinated Nominal expands it (`ModifiedBareMass`,
// `CoordinatedBareMass`), an admission gate (english.md §6) keeping *[a spell
// with mana value] [less than or equal to ...]* off Maralen, Fae Ascendant and
// Sphere of Annihilation, and *under [its owner's] [control tapped ...]* off
// Tawnos's Coffin.
BareMass: NounPhrase -> Nominal { transparent: [head], uncoordinated: [head] }
    where head.BareMass != Modified,
          $.Determination = Bare,
          head.DeterminerNeed != Required,
          $.Case = Plain,
          head.Countability = Mass,
          head.Number = Singular,
          $.Person = Third
ModifiedBareMass: NounPhrase -> Nominal { heavy: [head], transparent: [head], uncoordinated: [head] }
    where head.BareMass := Modified,
          $.Determination = Bare,
          head.DeterminerNeed != Required,
          $.Case = Plain,
          head.Countability = Mass,
          head.Number = Singular,
          $.Person = Third
// Coordinated `BareMass = Modified` nominals where at least one conjunct is
// itself unmodified (`BareMassHead = Unmodified`), so the conjuncts cannot
// coordinate as bare Noun Phrases (*power and toughness*, *mana value, power,
// or toughness equal to ...*, Talion, the Kindly Lord) without building a
// second tree where every conjunct is already modified (*base power 1 or base
// toughness 1*, Vhati il-Dal).
CoordinatedBareMass: NounPhrase -> Nominal { transparent: [head], coordinated: [head] }
    where head.BareMass := Modified,
          head.BareMassHead = Unmodified,
          $.Determination = Bare,
          head.DeterminerNeed != Required,
          $.Case = Plain,
          head.Countability = Mass,
          $.Person = Third
SymbolFusedHead: FusedNounPhrase -> SymbolHead
SymbolNominalPhrase: SymbolHead -> Symbols
    where $.NounKind = Resource,
          $.Determination = Bare,
          $.Case = Plain,
          $.Number = Singular,
          $.Person = Third
ProperName: NounPhrase -> Name
    where $.NounKind = Ordinary,
          $.Countability = Count,
          $.Determination = Bare,
          $.Postmodification = Closed,
          $.Case = Plain,
          $.Person = Third
// Excluding `FreeChoice` is an admission gate (english.md §6): it keeps *any number
// of Ally cards* (Munda, Ambush Leader) from a second tree with the singular
// head *number* beside TransparentQuantity's. *A* before *number of* is
// TransparentQuantity's for the same reason (*a number of Blood tokens*,
// Lacerate Flesh).
Determined: NounPhrase -> determiner:DeterminerPhrase Nominal { transparent: [head] }
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third,
          determiner.DeterminativeDistribution != Independent | FreeChoice,
          !(
              determiner.DeterminativeDistribution = IndefiniteArticle
              & head.NounDistribution = Quantity
              & head.ComplementKind = PP
          ),
          determiner.ComplementKind != PP,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
// Coordinated determiners each with its own premodifiers over one shared
// nominal (*[all black and all red] creature cards*; CGEL 5§14.4:449,
// 15§4.4(d):1344). Each Cluster agrees with the shared nominal through
// ConjunctNumber, while the Noun Phrase takes the coordination's resolved
// Number (*a black and a red creature* is plural; *each black and each red
// creature* is singular, CGEL 5§18.4:508).
SharedNominalDetermined: NounPhrase -> clusters:NominalClusters Nominal {
    transparent: [head],
    unshared: [Number],
}
    where $.DeterminativeDistribution = clusters.DeterminativeDistribution,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third,
          clusters.Countability = head.Countability,
          clusters.ConjunctNumber = head.Number,
          $.Number = clusters.Number
DeterminedCluster: NominalCluster ->
    determiner:DeterminerPhrase modifier:Premodifier
    where determiner.DeterminativeDistribution != Independent,
          determiner.ComplementKind != PP,
          $.Number = determiner.Number,
          $.Countability = determiner.Countability,
          $.DeterminativeDistribution = determiner.DeterminativeDistribution
// A comparative or exceptive quantity's Cluster, count or mass as
// ComparativeQuantityCountDetermined and ComparativeQuantityMassDetermined
// give the nominal its Number.
ComparativeCountCluster: NominalCluster ->
    determiner:DeterminerPhrase modifier:Premodifier
    where determiner.ComplementKind = PP,
          determiner.ObliqueKind != ComparativeClause,
          determiner.ObliqueDetermination = Bare,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Number = determiner.ObliqueNumber
ComparativeMassCluster: NominalCluster ->
    determiner:DeterminerPhrase modifier:Premodifier
    where determiner.ComplementKind = PP,
          determiner.ObliqueKind != ComparativeClause,
          determiner.ObliqueDetermination = Bare,
          determiner.Countability := Mass,
          $.Countability = Mass,
          $.Number = Singular
MaximumCluster: NominalCluster ->
    determiner:Selected(PrepositionPhrase, Up) modifier:Premodifier
    where determiner.Determination = Bare,
          $.Number = determiner.Number,
          $.Countability = Count
StackedCluster: NominalCluster ->
    cluster:NominalCluster modifier:Premodifier
    where $.Number = cluster.Number,
          $.Countability = cluster.Countability,
          $.DeterminativeDistribution = cluster.DeterminativeDistribution
// A distributive determiner over an *and*-coordination of singular nominals
// is singular (*each creature and planeswalker you control gets ...*), as a
// coordination of Noun Phrases each with *each* is (CGEL 5§18.4:508). Number
// is unshared: the Noun Phrase takes its determiner's, while the
// coordination is plural.
DistributiveCoordinationDetermined: NounPhrase -> determiner:DeterminerPhrase Nominal {
    transparent: [head],
    unshared: [Number],
}
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.DeterminativeDistribution = Distributive,
          head.ConjunctNumber := Singular,
          head.Number = Plural,
          $.Number = determiner.Number,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A singular determiner over an *and*-coordination of singular nominals,
// with joint reference: one entity each conjunct describes (*is also a
// Cleric, Rogue, Warrior, and Wizard*; CGEL 5§18.4:507–508). Number is
// unshared: the Noun Phrase is singular, the coordination plural. Refusing a
// temporal head is an admission gate (english.md §6): no one period is two,
// and it keeps *[This [turn and next turn]], creatures can't attack* (Peace
// Talks) from a jointly determined temporal Adjunct.
JointCoordinationDetermined: NounPhrase -> determiner:DeterminerPhrase Nominal {
    transparent: [head],
    unshared: [Number],
}
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.Number := Singular,
          determiner.DeterminativeDistribution != Distributive | Independent | FreeChoice,
          determiner.ComplementKind != PP,
          head.ConjunctNumber := Singular,
          head.NounKind != Temporal,
          head.Number = Plural,
          $.Number = Singular,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A comparative or exceptive quantity determines a count head agreeing with
// its Complement (*more than one creature*, *all but one +1/+1 counter*) or
// a singular mass head whatever its Complement's Number (*less than three
// mana*; CGEL 13§4.1.2:1126–1127, [16], [17i]), a measured mass as
// MeasuredMass's is; a noun both count and mass is no mass head. The mass
// Noun Phrase is `Resource` and the count one keeps its head's NounKind,
// which no equation values by Countability, so each is its own Production
// (as are their Clusters, whose Number is the standard's or Singular). Only
// a bare standard:
// *more than the total* determines nothing (CGEL 5§11(d):432), nor does a
// comparative clause (∗*more than you do creatures*).
ComparativeQuantityCountDetermined: NounPhrase -> determiner:DeterminerPhrase Nominal
    where determiner.ComplementKind = PP,
          determiner.ObliqueKind != ComparativeClause,
          determiner.ObliqueDetermination = Bare,
          head.Countability = Count,
          determiner.ObliqueNumber = head.Number,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
ComparativeQuantityMassDetermined: NounPhrase -> determiner:DeterminerPhrase Nominal {
    unshared: [NounKind],
}
    where determiner.ComplementKind = PP,
          determiner.ObliqueKind != ComparativeClause,
          determiner.ObliqueDetermination = Bare,
          head.Countability := Mass,
          head.Number = Singular,
          determiner.Countability = head.Countability,
          $.NounKind = Resource,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// Free-choice *any* determines a quantificational noun only without its
// oblique; with one, TransparentQuantity gives the oblique's Number (*any
// number of target creatures become ...*).
FreeChoiceDetermined: NounPhrase -> determiner:DeterminerPhrase Nominal
    where determiner.DeterminativeDistribution = FreeChoice,
          head.NounDistribution != Quantity,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
FreeChoiceQuantity: NounPhrase -> determiner:DeterminerPhrase Nominal
    where determiner.DeterminativeDistribution = FreeChoice,
          head.NounDistribution = Quantity,
          head.ComplementKind = Intransitive,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
// *Any number of target creatures*, *a number of Blood tokens*:
// number-transparent *number* heads the Noun Phrase, whose Number and
// NounKind are its oblique's (CGEL 5§3.3:349–350). Its determiner is the
// card text's *any* or *a* (CGEL also gives *this*), never *the*, with which
// *number* is a precise, singular number (5§3.3:350; Determined).
// Countability is unshared too: the transparent
// quantificational noun is non-count (5§3.3:349). The oblique carries
// `Plural`, since *number* takes only a plural oblique (5§3.3:350): a bare
// Nominal *of* Complement has no ObliqueNumber and fails it, which keeps Fire
// Covenant's *any number of target creatures* from *any number of [target]*,
// *target* a singular noun and *creatures* a separate Object, and Lacerate
// Flesh's *a number of Blood tokens equal to ...* from *a number of [Blood]*.
TransparentQuantity: NounPhrase -> determiner:DeterminerPhrase Nominal {
    unshared: [Number, NounKind, Countability],
}
    where determiner.DeterminativeDistribution
              != Dependent | Independent | Numerical | Distributive | Deictic
              | SingularOrQuantified | Multiplier | Targeting | Degree,
          head.NounDistribution = Quantity,
          head.ComplementKind = PP,
          head.ObliqueNumber := Plural,
          $.Number = head.ObliqueNumber,
          $.NounKind = head.ObliqueNounKind,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Any number of target creatures*, *any number of other target creatures*:
// on its own *target* determines a singular count noun, while without an outer
// determiner in *number of*'s oblique (TargetingMarker) it combines with the
// plural nominal directly as an Oracle exception, since the outer quantity
// counts the targets.
TargetedQuantity: BareNominal -> FreeLex(Noun) complement:TargetedOblique
    where head.NounDistribution = Quantity,
          $.ComplementKind = PP,
          $.ObliqueKind = NP,
          $.ObliqueNumber = complement.Number,
          $.ObliqueNounKind = complement.NounKind
TargetedOblique: TargetedOblique -> Word(Of) complement:TargetedNounPhrase
    where $.Number = complement.Number,
          $.NounKind = complement.NounKind
TargetedNounPhrase: TargetedNounPhrase -> determiner:TargetingMarker Nominal
    where head.Number = Plural,
          determiner.Countability = head.Countability
// *Pay {1}{G} any number of times*, *a number of times equal to the
// difference*: TransparentQuantity's Noun Phrase, a plural one headed by
// *number* with NounKind `Temporal` from its oblique, as a frequency Adjunct
// (CGEL 8§9:715 n. 19).
TemporalQuantity: TemporalNounPhrase -> NounPhrase
    where head.NounDistribution := Quantity,
          head.NounKind := Temporal,
          head.Number := Plural
// A plural count head, not just the plural of a coordination of singular
// count nominals: a shared determiner belongs outside that coordination and
// cannot be left behind when its tail becomes a Supplement (CGEL
// 5§8.5:409–410; OSG §7, Plurals and agreement; english.md §8). A mass
// nominal projects through `BareMass` / `CoordinatedBareMass` instead.
BarePlural: NounPhrase -> Nominal { uncoordinated: [head] }
    where $.Determination = Bare,
          head.DeterminerNeed != Required,
          $.Case = Plain,
          head.Number = Plural,
          $.Person = Third,
          !(head.Countability = Count & head.ConjunctNumber = Singular),
          !(head.Countability = Mass & head.BareMassHead = Expanded)
Pronoun: NounPhrase -> Lex(Pronoun)
    where $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Postmodification = Closed,
          head.Case != Genitive,
          head.PronounKind != Existential | Relative,
          head.Inflection = Invariant
// *Other than yours*: the independent genitive pronoun is a fused
// subject-determiner-head (CGEL 5§16.3:471). The Noun Phrase's Number is the
// understood head's, not the pronoun's (5§16.3:468), and its Person and Case
// are its own.
IndependentGenitive: NounPhrase -> Lex(Pronoun) { unshared: [Number, Person, Case] }
    where $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Postmodification = Closed,
          $.Case = Plain,
          head.Inflection = IndependentGenitive,
          $.Person = Third
// A genitive pronoun determines either Number (*your creature*, *your
// creatures*): Number is unshared.
PossessiveDeterminer: DeterminerPhrase -> Lex(Pronoun) { unshared: [Number] }
    where $.DeterminativeDistribution = Dependent,
          $.ComplementKind = Intransitive,
          head.Case := Genitive,
          head.Inflection = Invariant,
          head.PronounKind != Relative
// A possessor ends in its head noun, where the genitive marker stands
// (`head_final`): an admission gate (english.md §6) that keeps *[the top card
// of target player]'s library* from a possessor (Merfolk Observer); Oracle
// fronts the player noun "to avoid a dangling possessive" (OSG §6, Controller
// and owner). One genitive stands over coordinated nominals (*target artifact
// or creature's owner*), not over coordinated Noun Phrases (`uncoordinated`):
// an admission gate that keeps *[that player or that planeswalker]'s
// controller* off Blightning and *[the player's life total ..., the
// planeswalker's loyalty ..., or the creature]'s toughness* off Drain Life.
// Nor is a possessor a Noun Phrase with a dependent outside its determiner
// (`Periphery`): an admission gate that keeps *[half the creature]'s power*
// off Catacomb Dragon and *[Only this creature]'s owner* off Personal
// Incarnation, where the dependent stands outside the genitive's Noun Phrase.
HeadFinalPossessor: Possessor -> NounPhrase { head_final: [head], uncoordinated: [head] }
    where head.Periphery != External
// A number-transparent quantity's genitive marks its oblique, whose Number
// the quantity has (*any number of target players' graveyards*, Thraben
// Charm; TransparentQuantity). A plural Noun Phrase headed by *number* is
// such a quantity: the noun itself is singular. The oblique ends in its head
// in turn (`complement_final`), which keeps *[any number of target artifact
// cards from target player]'s graveyard* from a possessor (Drafna's
// Restoration).
TransparentPossessor: Possessor -> NounPhrase { complement_final: [head] }
    where head.NounDistribution := Quantity,
          head.Number := Plural
// The possessor is plain, the genitive Noun Phrase genitive: Case is
// unshared.
GenitivePossessor: NounPhrase -> Possessor marker:Word(Genitive) { unshared: [Case] }
    where $.Determination = Bare,
          $.Case = Genitive,
          head.Case := Plain
// A genitive with its head understood (*power less than Mirko's*; CGEL
// 5§16.3:467–468). A following temporal determinative (*during [its
// controller's] [last turn]*, Halls of Mist) builds an Adjunct beside it,
// while GenitiveDetermined ranks first. Number is the understood head's
// (5§16.3:468), and Person and Case are the Noun Phrase's own.
FusedSubjectDeterminerHead: NounPhrase -> Possessor marker:Word(Genitive) {
    unshared: [Number, Person, Case],
}
    where $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          head.Case := Plain,
          $.Person = Third
GenitiveDetermined: NounPhrase -> determiner:NounPhrase Nominal
    where $.Determination = Overt,
          $.Case = Plain,
          determiner.Case := Genitive,
          $.Person = Third
// *its controller's next two untap steps*.
GenitiveModifiedQuantity: NounPhrase -> determiner:NounPhrase ModifiedQuantifiedNominal
    where determiner.Case := Genitive,
          $.Number = head.QuantityNumber,
          $.Countability = Count,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
Unmodified: Nominal -> BareNominal { transparent: [head] }
    where head.BareMass != Modified,
          $.BareMassHead = Expanded,
          $.ConjunctNumber = $.Number
ExpandedBareMass: Nominal -> BareNominal { heavy: [head], transparent: [head] }
    where head.BareMass := Modified,
          $.BareMassHead = Expanded,
          $.ConjunctNumber = $.Number
UnmodifiedBareMass: Nominal -> BareNominal { light: [head], transparent: [head] }
    where head.BareMass := Modified,
          $.BareMassHead = Unmodified,
          $.ConjunctNumber = $.Number
// The Targeting Marker word alone is its determinative's own
// DeterminerPhrase (*target creature*). BareTargetingMarker builds the word,
// and ModifiedTargetingMarker the word after one adjective, as the head an
// outer determiner takes (MarkedDeterminer, *two other target creatures*;
// MarkedMaximum, *up to one other target creature*) or the determiner of
// TargetedNounPhrase (*any number of target creatures*, *any number of other
// target creatures*). Each takes the word, never a DeterminerPhrase, so a
// determined or modified Marker is no Marker again (not *two three target
// creatures*, *other other target creatures*), and an adjective stays inside
// the outer determiner, an external dependent (CGEL 5§2:330; not *other two
// target creatures*). The outer determiner ends in no Marker (not *target
// target creature*, *two target target creatures*).
BareTargetingMarker: TargetingMarker -> Lex(Determinative)
    where head.DeterminativeDistribution := Targeting,
          $.ComplementKind = Intransitive,
          $.TargetMarked = Marked
ModifiedTargetingMarker: TargetingMarker -> modifier:AdjectivePhrase Lex(Determinative)
    where head.DeterminativeDistribution := Targeting,
          $.ComplementKind = Intransitive,
          $.TargetMarked = Marked,
          modifier.ComplementKind = Intransitive,
          modifier.AdjectivePosition != Predicative
// The phrase takes the outer determiner's Countability, Number and
// DeterminativeDistribution, so a mass determinative is no determiner of a
// count noun through the Marker (*all target creature*).
MarkedDeterminer: DeterminerPhrase -> determiner:DeterminerPhrase TargetingMarker {
    unshared: [DeterminativeDistribution],
}
    where determiner.ComplementKind != PP,
          determiner.DeterminativeDistribution != Targeting,
          determiner.TargetMarked != Marked,
          $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.Countability = $.Countability,
          $.Number = determiner.Number
MarkedMaximum: DeterminerPhrase -> determiner:Selected(PrepositionPhrase, Up) TargetingMarker {
    uncoordinated: [determiner],
}
    where determiner.Determination = Bare,
          $.Number = determiner.Number
AdjectivalPremodifier: Premodifier -> AdjectivePhrase { cost: 0 }
    where head.ComplementKind = Intransitive,
          head.AdjectivePosition != Predicative,
          $.PremodifierKind = Adjectival
ParticipialPremodifier: Premodifier -> Participle { cost: 0 } where $.PremodifierKind = Participial
// An adjective that needs an overt determiner passes the need to its
// nominal (*the first creature*). Like an adjective, any premodifier stands
// on a conjunct whose Complement is shared (*the noted number and kind of
// counters*). Before *counter*, a measure or keyword is the counter's kind
// (KindPremodifier): an admission gate (english.md §3, §6), which keeps a
// second tree, the measure or keyword as a general premodifier of *counter*,
// off *Put a +1/+1 counter on each of up to two target creatures* (Travel
// Preparations) and *Put a double strike counter on Mai* (Mai, Jaded Edge).
// A keyword or participle premodifies no nominal that needs a determiner
// (NumeralNominal, SymbolNominal, LoyaltyNominal, CardinalNominal, or one an
// adjective passes the need to): an admission gate (english.md §6), which
// keeps a keyword or participle from premodifying its own Keyword Parameter,
// *devour* the nominal *2* in *a ... token with flying and devour 2* (Dragon
// Broodmother). An adjective still premodifies one (*a natural 20*, *an
// additional {G}*).
Premodifier: BareNominal -> modifier:Premodifier BareNominal { transparent: [head] }
    where modifier.DeterminerNeed = $.DeterminerNeed,
          !(modifier.PremodifierKind = Measure & head.KindLicense = Head),
          !(modifier.PremodifierKind = Keyword & head.KindLicense = Head),
          !(modifier.PremodifierKind = Keyword & head.DeterminerNeed = Required),
          !(modifier.PremodifierKind = Participial & head.DeterminerNeed = Required)
// An attributive adjective over a whole *and*-coordination of singular
// nominals, not only its first conjunct (*[total [power and toughness 5 or
// less]]*; CGEL 15§1.3.4:1285–1286). A nominal's Complement is inside its
// premodifiers, so a shared Amount is too.
CoordinationPremodifier: Nominal -> modifier:Premodifier Nominal
    where modifier.PremodifierKind := Adjectival,
          modifier.DeterminerNeed = $.DeterminerNeed,
          head.Number = Plural,
          head.ConjunctNumber := Singular
GenitiveConjunct: GenitiveNominal -> BareNominal marker:Word(Genitive)
MultipleGenitive: NounPhrase -> determiner:DeterminerPhrase GenitiveNominals
    where $.Determination = Bare,
          $.Case = Genitive,
          $.Person = Third,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
// A postmodifier agrees with each conjunct of an *and*-coordinated nominal
// (*each creature and planeswalker that is tapped*).
NominalPostmodifier: Nominal -> Nominal modifier:Postmodifier
    where head.ConjunctNumber = modifier.Number,
          head.NounKind = modifier.NounKind,
          $.RelativeBound = modifier.RelativeBound
// *The next 3 damage that would be dealt*.
QuantifiedPostmodifier: ModifiedQuantifiedNominal -> QuantifiedNominal modifier:Postmodifier
    where head.QuantityNumber = modifier.Number,
          head.NounKind = modifier.NounKind
ModifiedQuantifiedPostmodifier: ModifiedQuantifiedNominal ->
    ModifiedQuantifiedNominal modifier:Postmodifier
    where head.QuantityNumber = modifier.Number,
          head.NounKind = modifier.NounKind
// Only a marked relative follows a fused head (*one that hasn't been
// chosen*).
FusedPostmodifier: FusedNounPhrase -> FusedNounPhrase modifier:RelativeClause
    where modifier.ClauseMarking = Relative,
          head.Number = modifier.Number
// *One of them chosen at random*.
FusedParticipialPostmodifier: FusedNounPhrase -> FusedNounPhrase modifier:VerbPhrase {
    heavy: [modifier],
}
    where modifier.VerbForm = PastParticiple,
          modifier.Voice = Passive,
          modifier.VerbKind != Auxiliary
PrepositionalConjunct: PostmodifierConjunct -> filler:Hosted(PrepositionPhrase, Nominal)
    where $.ConjunctKind = PP
NominalObjectConjunct: ObjectConjunct -> filler:ComplementNounPhrase where $.ConjunctKind = NP
KeywordObjectConjunct: ObjectConjunct -> filler:KeywordPhrase where $.ConjunctKind = KeywordPhrase
// A slash measure is a conjunct only where the head selects a measure, as
// *among* does a +X/+Y counter's kind beside keyword counters' kinds
// [CR#122.1a,122.1b] (*a kind of counter ... from among flying, first
// strike, ..., and +1/+1*).
MeasureObjectConjunct: ObjectConjunct -> filler:MeasureNounPhrase where $.ConjunctKind = MeasureNP
// *Has reach and "…"*.
QuotedObjectConjunct: ObjectConjunct -> filler:QuotedAbility where $.ConjunctKind = QuotedAbility
AmountConjunct: AmountOrNounConjunct -> filler:Amount where $.ConjunctKind = Amount
NounPhraseConjunct: AmountOrNounConjunct -> filler:ComplementNounPhrase where $.ConjunctKind = NP
AdjectivalConjunct: PostmodifierConjunct -> filler:AdjectivePhrase { heavy: [filler] }
    where filler.Voice != Passive,
          $.ConjunctKind = AdjP
// A lexical passive participle clause, never one headed by *been*.
PastParticipialConjunct: PostmodifierConjunct -> filler:VerbPhrase { heavy: [filler] }
    where filler.VerbForm = PastParticiple,
          filler.Voice = Passive,
          filler.VerbKind != Auxiliary,
          $.ConjunctKind = Participial
GerundParticipialConjunct: PostmodifierConjunct -> filler:VerbPhrase { heavy: [filler] }
    where filler.VerbForm = GerundParticiple,
          $.ConjunctKind = Participial
CoordinatedPostmodifier: Nominal -> Nominal modifier:PostmodifierCoordination
RelativePostmodifier: Postmodifier -> RelativeClause where $.RelativeBound = Bound
// A participial clause with dependents (*each creature tapped this way*): a
// bare passive, never headed by *been*.
ParticipialPostmodifier: Postmodifier -> VerbPhrase { heavy: [head] }
    where head.VerbForm = PastParticiple,
          head.Voice = Passive,
          head.VerbKind != Auxiliary
GerundParticipialPostmodifier: Postmodifier -> VerbPhrase { heavy: [head] }
    where head.VerbForm = GerundParticiple
// A single participle, outside the premodifiers and inside any relative
// clause (*creatures entering*). It ranks behind ParticipialPostmodifier,
// and is never one whose Adjectival Passive is a declared Adjective: bare
// *tapped* is that Adjective.
SingleParticipialPostmodifier: Nominal -> BareNominal modifier:VerbPhrase {
    cost: 3,
    light: [modifier],
}
    where $.ConjunctNumber = $.Number,
          $.BareMassHead = Expanded,
          modifier.VerbForm = PastParticiple,
          modifier.Voice = Passive,
          modifier.AdjectivalPassive != Lexical,
          modifier.VerbKind != Auxiliary
SingleGerundParticipialPostmodifier: Nominal -> BareNominal modifier:VerbPhrase {
    cost: 3,
    light: [modifier],
}
    where $.ConjunctNumber = $.Number,
          $.BareMassHead = Expanded,
          modifier.VerbForm = GerundParticiple
// A bare relative: a finite clause with an object Gap. A marked one may
// also have a subject Gap, which agrees with the antecedent.
BareRelative: RelativeClause -> clause:Clause
    where $.ClauseMarking = Unmarked,
          clause.Gap = NP,
          clause.VerbForm = Finite,
          clause.ClauseShape := SubjectInitial
// A bare relative whose Gap is a predicative (*the permanent it becomes*;
// CGEL 12§3.3(c):1045).
BarePredicativeRelative: RelativeClause -> clause:Clause { cost: 3 }
    where $.ClauseMarking = Unmarked,
          $.NounKind = Ordinary,
          clause.Gap = Pred,
          clause.VerbForm = Finite,
          clause.ClauseShape := SubjectInitial
MarkedRelative: RelativeClause -> marker:Class(RelativeMarker) clause:Clause
    where $.ClauseMarking = Relative,
          clause.Gap = NP,
          clause.VerbForm = Finite,
          marker.Case != Nominative | Genitive
SubjectRelative: RelativeClause -> marker:Class(RelativeMarker) clause:SubjectGapClause
    where $.ClauseMarking = Relative,
          clause.Gap = NP,
          $.Number = clause.Number,
          marker.Number = clause.Number,
          marker.Case != Accusative | Genitive
SubjectGap: SubjectGapClause -> VerbPhrase
    where head.VerbForm = Finite,
          head.Person = Third,
          head.Inflection != Irrealis,
          $.Gap = NP
// The plural Requirement already keeps out irrealis *were*, so this needs
// no Exclude of SubjectGap's.
FloatedEachSubjectGap: SubjectGapClause -> adjunct:Class(FloatingQuantifier) VerbPhrase
    where head.VerbForm = Finite,
          head.Number = Plural,
          head.Person = Third,
          $.Gap = NP
// *whose*: the relative phrase is the Subject or fills an object Gap.
GenitiveRelativePhrase: RelativeNounPhrase -> determiner:Lex(Pronoun) Nominal
    where determiner.PronounKind = Relative,
          determiner.Case := Genitive
GenitiveSubjectRelative: RelativeClause -> marker:RelativeNounPhrase clause:SubjectGapClause
    where $.ClauseMarking = Relative,
          clause.Gap = NP,
          marker.Number = clause.Number
GenitiveRelative: RelativeClause -> marker:RelativeNounPhrase clause:Clause
    where $.ClauseMarking = Relative,
          clause.Gap = NP,
          clause.VerbForm = Finite
GenitivePredicativeRelative: RelativeClause -> marker:RelativeNounPhrase clause:Clause
    where $.ClauseMarking = Relative,
          clause.Gap = Pred,
          clause.VerbForm = Finite
// *For which*.
PrepositionRelativePhrase: RelativePrepositionPhrase -> Lex(Preposition) complement:Lex(Pronoun)
    where complement.PronounKind = Relative,
          complement.Case != Nominative | Genitive
PrepositionalRelative: RelativeClause -> marker:RelativePrepositionPhrase clause:AdjunctGapClause
    where $.ClauseMarking = Relative,
          clause.Gap = Adjunct
// A fused relative is a Noun Phrase (CGEL 12§6:1068).
FusedSubjectRelative: NounPhrase -> Word(Whichever) clause:SubjectGapClause
    where clause.Gap = NP,
          $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
FusedRelative: NounPhrase -> Word(Whichever) clause:Clause
    where clause.Gap = NP,
          clause.VerbForm = Finite,
          $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// Its Gap is a temporal Adjunct (*the next time you cast a spell*). It is
// bare, so its Clause opens with its Subject: *the first time [each turn,
// those coins come up heads]* is no adverbial relative.
AdverbialRelative: RelativeClause -> clause:AdjunctGapClause
    where $.ClauseMarking = Unmarked,
          clause.Gap = Adjunct,
          clause.ClauseShape := SubjectInitial,
          $.NounKind = Temporal
AdjunctGap: AdjunctGapClause -> Clause
    where head.VerbForm = Finite,
          $.Gap = Adjunct,
          $.ClauseShape = head.ClauseShape
// A marked relative postposed out of its Object (*Choose a card at random
// that was exiled with ...*; CGEL 12§4:1066). It ranks behind the relative
// clause in place.
PostposedRelative: PostposedModifier -> RelativeClause { cost: 5 }
    where head.ClauseMarking = Relative
// A bare relative postposed past *at random* (*choose a creature at random
// this Aura can enchant*, Infectious Rage; Volatile Chimera).
PostposedBareRelative: BarePostposedModifier -> RelativeClause { cost: 2, heavy: [head] }
    where head.ClauseMarking = Unmarked
// *Choose a card at random exiled with ...* (Gorex, the Tombshell; Omenpath
// Journey): a bare passive postposed past *at random*.
PostposedParticipialModifier: BarePostposedModifier -> VerbPhrase { cost: 2, heavy: [head] }
    where head.VerbForm = PastParticiple,
          head.Voice = Passive,
          head.VerbKind != Auxiliary
// An equative Adjective Phrase postposed out of its Object (*deals damage
// to any target equal to …*, *reveals a number of cards from their hand
// equal to …*). It ranks behind the Adjective Phrase in place.
PostposedAdjective: PostposedModifier -> AdjectivePhrase { cost: 5, heavy: [head] }
    where head.ComplementKind = PP,
          head.Grade := Equative,
          head.Voice != Passive

// A Preposition's Clause Complement: finite (*when this creature enters*)
// or verbless (*if able*). `unlinked`: a sole connective never links
// subordinate clauses, so never *until [they exile a nonland card, then you
// may cast it]*.
FiniteComplementClause: FiniteClause -> Clause { unlinked: [head] } where head.VerbForm = Finite
// A comparative clause has a gap where its comparative governor
// corresponds (CGEL 13§2.1:1108): a Gap (*as many cards as they discarded
// __ this way*, Forget), or, where an auxiliary or *do* is stranded, one
// in what is ellipted (*more cards in hand than you do*, Keeper of the
// Mind; 13§2.1:1109–1110). An admission gate (english.md §6): a complete
// Clause is no comparative clause, which keeps *than [you lost life this
// turn]* from *a player other than you lost life this turn* (Ludevic,
// Necro-Alchemist).
GappedComparativeClause: ComparativeClause -> Clause { unlinked: [head] }
    where head.VerbForm = Finite,
          head.Gap = NP
EllipticalComparativeClause: ComparativeClause -> Clause { unlinked: [head] }
    where head.VerbForm = Finite,
          head.Ellipsis := Code
// Content clauses that permit *that*; their governors select this Category
// (CGEL 11§4.8:971).
UnmarkedExpandableClause: ExpandableClause -> FiniteClause
MarkedExpandableClause: ExpandableClause -> marker:Word(ContentMarker) FiniteClause
// A dash-set Clause or Clause coordination giving the content of the Object
// before it: villainous choice options [CR#701.55a]. The sentence end
// absorbs the closing dash.
SetOffComplementClause: SetOffClause -> '—':Free Clause { unclosed, capital: [head] }
    where head.ClauseMarking = Unmarked,
          head.Inflection != Irrealis
VerblessComplementClause: VerblessClause -> Predicative
// A passive participle with a dependent of its own is verbal (*if tapped
// for mana*, Reality Twist, Naked Singularity), a bare one the Adjectival
// Passive (*if tapped*): one tree each. A coordination of participles and
// a participle under a central adverb are the Adjective Phrase's alone (*if
// tapped or blocked*, *if not tapped*). A verbless clause has no Adjunct of
// its own: in *attacks each combat if able unless ...*, *unless* belongs to
// the outer clause.
ParticipialVerblessClause: VerblessClause -> VerbPhrase { heavy: [head], uncoordinated: [head] }
    where head.VerbForm = PastParticiple,
          head.Voice = Passive,
          head.VerbKind != Auxiliary,
          head.CentralPosition != Occupied
// *With your hand revealed*: an overtly determined Subject, never nominative,
// and a past-participial predicate (CGEL 14§8.3:1262). Requiring
// `subject.Determination := Overt` is an admission gate (english.md §6):
// without it, bare nominals after *with* split into Subject and passive
// predicate (*with [mana value ... from among cards] [exiled with Maralen]*,
// Maralen, Fae Ascendant; *share a card type with [cards] [exiled with
// Cemetery Prowler]*, Cemetery Prowler).
PastParticipialAbsolute: AbsoluteClause -> subject:ComplementNounPhrase VerbPhrase
    where subject.Determination := Overt,
          head.VerbForm = PastParticiple,
          head.Voice = Passive,
          head.VerbKind != Auxiliary

// Content clauses: declarative (*choose that ...*), closed interrogative
// (*whether ...*), or open with an interrogative phrase as Subject (*which
// creatures attack*) or Gap filler (*which number you chose*), or an adverb
// (*how each player votes*).
DeclarativeContentClause: InterrogativeClause -> marker:Word(ContentMarker) clause:Clause
    where clause.VerbForm = Finite
ClosedInterrogative: InterrogativeClause -> marker:Word(Whether) clause:Clause
    where clause.VerbForm = Finite
ClosedInfinitivalInterrogative: InterrogativeClause -> marker:Word(Whether) clause:Clause
    where clause.ClauseMarking = To
InterrogativeDeterminer: InterrogativePhrase -> determiner:Word(Which) Nominal
    where $.Person = Third
// *Note how many cards you've drafted*.
DegreeInterrogativeDeterminer: InterrogativePhrase ->
    degree:Word(How) determiner:Lex(Determinative) Nominal
    where determiner.DeterminativeDistribution := Degree,
          determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Person = Third
SubjectInterrogative: InterrogativeClause -> subject:InterrogativePhrase VerbPhrase
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite
GapInterrogative: InterrogativeClause -> marker:InterrogativePhrase clause:Clause
    where clause.Gap = NP,
          clause.VerbForm = Finite
AdverbialInterrogative: InterrogativeClause -> marker:Word(How) clause:AdjunctGapClause
    where clause.Gap = Adjunct

// Never fused *each*: in *power and toughness are each equal to ...* (Eluge,
// the Shoreless Sea) *each* is floated (FloatedEachAdjective), never a
// Predicative *[are each]* with *equal to ...* a depictive. A bare mass
// Noun Phrase is a Predicative, but not one headed by a `HeadOnly` noun,
// whose modifying uses are an adjective's: a bare color word after a copula
// is the adjective (CGEL 19§3.3:1642).
NominalPredicative: Predicative -> NounPhrase
    where head.Case != Genitive,
          !(head.DeterminativeDistribution = Distributive & head.NounKind = Quantity),
          !(head.Determination = Bare & head.Countability = Mass & head.NounDistribution = HeadOnly)
// A predicative Preposition Phrase could also modify a nominal.
PrepositionalPredicative: Predicative -> Hosted(PrepositionPhrase, Nominal)
AdjectivalPredicative: Predicative -> AdjectivePhrase { transparent: [head] }
    where head.AdjectivePosition != Attributive

// A central Preposition Phrase adjunct (*may instead draw a card*). An
// imperative's front position is the Clause schema's.
adjunct PrepositionPhrase { host: BareInf, side: Before, host_kind: Predicate }
    where adjunct.ComplementKind = Intransitive
// The same in finite and participial Verb Phrases.
adjunct PrepositionPhrase { host: VerbPhrase, side: Before, host_kind: Predicate }
    where adjunct.ComplementKind = Intransitive,
          head.VerbForm != Plain
// A past participle spelled like a declared Adjective (*tapped*) has
// that Adjective as its Adjectival Passive, which premodifies in its
// place. The participle attaches as a Premodifier (ParticipialPremodifier).
premodification Participle {
    head: Verb,
    forms: [GerundParticiple, PastParticiple],
    equations: [PastParticiple -> [head.AdjectivalPassive != Lexical]],
}
parameters IndexedNominal { head: Noun, side: After }
parameters BareNominal { head: Noun, side: Before }
// A Keyword Parameter set off by an em dash opens with a capital
// (*Ward—Pay 2 life.*, *Modular—Sunburst*, *Companion — Each nonland card
// ...*).
parameters KeywordParameters {
    head: Keyword,
    binding: Free,
    coordinators: Coordinator,
    remnant: ParameterRemnant,
    capital_after: ['—'],
}
parameters BoundKeyword { head: Keyword, binding: Suffix }
// `passive`: *by* plus the active's Subject; a *by* gerund is a means
// Adjunct. An amount after *by* is also an extent (*reduced by {2}*): both
// Readings stand, and semantics rejects the agent one (english.md §4). An
// auxiliary has no prepositional or adjectival passive, nor has a verb with
// a declared Adjectival Passive (*tapped*) an adjectival one; an Adjectival
// Passive is predicative. A shifted heavy Object is determined (*chooses
// from among them [an artifact, a creature, …]*).
valence VerbPhrase {
    head: Verb,
    active: [$.Voice = Active],
    passive: By,
    verbal_passive: [$.Voice = Passive, $.VerbForm = PastParticiple],
    prepositional_passive: [
        $.Voice = Passive, $.VerbForm = PastParticiple, head.VerbKind != Auxiliary,
    ],
    internalized: [internalized.ComplementKind = NP],
    adjectival: AdjectivePhrase,
    adjectival_passive: [
        head.VerbForm = PastParticiple, $.AdjectivePosition = Predicative, $.Voice = Passive,
        head.AdjectivalPassive != Lexical, head.VerbKind != Auxiliary,
    ],
    interleaved: Interleaved,
    interleaved_core: [adjunct.NounKind != Manner],
    central: CentralAdjunct,
    central_heads: BeVerb,
    central_families: [Copular],
    heavy_shift,
    shifted_object: [object.Determination := Overt],
    // `object.Postmodification != Closed`: an admission gate (english.md §6)
    // against postposing a Modifier out of a personal pronoun or proper name,
    // which takes none in place (CGEL 5§10.2:429–430, 5§20.3–20.4:520–521;
    // *attack [you] unless … [that's attacking you]*, Propaganda; *divides
    // [them] into … [for whom …]*, Camouflage). `adjunct.ComplementKind =
    // AdjP`: an admission gate against a bare relative or passive participle
    // postposed onto the Object past any other Preposition Phrase (*Draw a
    // card for each Human [you control]*, Mass Appeal).
    postposed: [
        PostposedModifier -> [object.Postmodification != Closed],
        BarePostposedModifier -> [
            object.Postmodification != Closed,
            adjunct.ComplementKind = AdjP,
        ],
    ],
    clusters: {
        cluster: ComplementCluster,
        coordination: ClusterCoordination,
        adjunct: PredicateAdjunct,
        remnants: [KeywordPhrase -> ParameterRemnant],
        adjunct_clusters: {
            cluster: AdjunctCluster,
            coordination: AdjunctClusterCoordination,
            preposition: PrepositionPhrase,
            remnant: PrepositionRemnant,
        },
    },
    remnants: [Pred -> PredicativeRemnant],
}
// A Noun Phrase Complement alone is a later Adjunct Cluster's remnant.
// `closed_complement`: an admission gate (english.md §6) against spurious Right
// Node Raising out of a Complement (*less than [void counters on it] or
// equal to the number of [void counters on it]*, Sphere of Annihilation);
// only a stranded preposition's own Gap passes up.
valence PrepositionPhrase {
    head: Preposition,
    complement_kind: ComplementKind,
    closed_complement,
    agree: [
        Number -> Number, Number -> QuantityNumber, Determination -> Determination, Case -> Case,
        NounKind -> NounKind, Countability -> Countability,
        DeterminativeDistribution -> DeterminativeDistribution,
    ],
    remnants: [NP -> PrepositionRemnant],
}
// A temporal clause locates its host's situation at the time of its own
// (CGEL 8§6:700), so a dependent that gives a phrase its time never carries
// a time the phrase's head does not: no past clause under a non-past head
// (*Whenever you cast a spell, draw a card* and *..., you may draw a card*
// have no preterite *cast*) and no non-past one under a past head (in
// *you gain life equal to the life you lost when it entered*, Soulgorger
// Orgg, *when it entered* modifies *lost*, never *gain*). A side that carries
// neither agrees with either (*If you would draw a card while your library
// has no cards in it*, Laboratory Maniac). The phrase carries the
// dependent's time with its head's: a plain-form Verb Phrase takes the time
// of a temporal clause inside it (*draw a card whenever you cast a spell*),
// and a coordination carries every time of its conjuncts, so a dependent of
// one agrees with each conjunct, as a modifier of a coordination applies to
// each coordinate (CGEL 15§1.3.4:1286).
//
// The dependents that give time: a Preposition Phrase, which has its
// TemporalClause Complement's time and no other (a conditional clause is
// independent of its host in time, CGEL 8§14.1.2:743); the functions that
// carry one to its host, and a coordination of Clusters, which carries the
// times its Clusters' Adjuncts give them; a bare infinitival Complement, of a
// modal, whose situation is simultaneous with or later than the modal's
// time (CGEL 3§7:160), or of supportive *do*; and the Complement of passive
// *be*, which, like supportive *do*, is not temporally distinct from its
// Complement, or of progressive *be*, which is not either when it expresses
// progressive aspect (CGEL 14§4.2.2:1217; its futurate use, *At that time
// he was still arriving tomorrow*, is, and the grammar does not tell the two
// apart). Perfect
// *have*'s Complement gives none (Perfect and PassivePerfect exempt it): the
// perfect is itself a past tense (CGEL 3§5:139). A Nominal carries no time, so a temporal clause
// that modifies one is free (*the player's life total before the damage was
// dealt*, Soul Burn).
dependents TimeGiving = [
    PrepositionPhrase, PredicateAdjunct, AdjunctCoordination, Interleaved, ClusterCoordination,
    AdjunctClusterCoordination, BareInf, AuxiliaryComplement,
]
    where $.PastTime = dependent.PastTime,
          $.NonPastTime = dependent.NonPastTime,
          !(head.PastTime = Past & dependent.NonPastTime = NonPast),
          !(head.NonPastTime = NonPast & dependent.PastTime = Past)
// A property noun's comparative bound is the postpositive comparative
// adjective's (*mana value less than X*), never its Amount Complement, which
// is no ComparativeAmount (whose ComplementKind is `PP`): that is the
// endpoint of a scalar change only (*reduce it to less than 1*).
valence BareNominal {
    head: Noun,
    complement_kind: ComplementKind,
    slots: [Amount -> [slot.ComplementKind != PP]],
    interleaved: InterleavedModifier,
    agree: [ObliqueNumber -> Number, ObliqueKind -> ComplementKind, ObliqueNounKind -> NounKind],
}
// A bare noun in a fossilized Preposition Phrase keeps its Complement (*in
// excess of*): without it, a relational noun is no bare count nominal (*the
// amount of [excess] damage dealt*).
valence PrepositionalNominal { head: Noun, obligatory }
valence AdjectivePhrase { head: Adjective, complement_kind: ComplementKind }
// A determinative alone, or count or mass *all* with its exceptive
// Complement (*all but one*).
valence DeterminerPhrase {
    head: Determinative,
    complement_kind: ComplementKind,
    selects: [ExceptiveBut],
    agree: [
        ObliqueNumber -> Number, ObliqueKind -> ComplementKind, ObliqueDetermination -> Determination,
        ObliqueDistribution -> DeterminativeDistribution,
    ],
}
// A comparative determinative and its *than* Complement as siblings (*more
// than one*; CGEL 13§2.1:1104). The bare standard gives the phrase its
// Number (*more than two lands*), so Number is unshared. Its Grade is
// Comparative, which a degree modifier needs (ModifiedComparativeDeterminer).
// A determined standard is ComparativeDetermined's, a bounding frequency
// ComparativeAdverb's.
valence DeterminerPhrase {
    variant: Comparative,
    head: Determinative,
    complement_kind: ComplementKind,
    selects: [Than],
    complemented,
    unshared: [Number, Grade],
    active: [
        complement.Determination = Bare, complement.ComplementKind != AdvP, $.Grade = Comparative,
    ],
    agree: [
        Number -> Number, ObliqueNumber -> Number, ObliqueKind -> ComplementKind,
        ObliqueDetermination -> Determination,
    ],
}
// A determinative fused head and its *of* oblique (*most of those cards*;
// CGEL 5§9.1:411). Number is the oblique's.
valence PartitiveHead {
    head: Determinative,
    selects: [Of],
    complemented,
    active: [
        head.DeterminativeDistribution != Distributive,
        $.NounKind = Ordinary, $.Determination = Overt, $.Case = Plain, $.Person = Third,
    ],
    agree: [Number -> Number],
}
// The same over a plural oblique, with the head's own singular (*each of
// those creatures*).
valence PartitiveHead {
    variant: Distributive,
    head: Determinative,
    selects: [Of],
    complemented,
    active: [
        complement.Number = Plural,
        head.DeterminativeDistribution != Dependent | Independent,
        $.NounKind = Ordinary, $.Determination = Overt, $.Case = Plain, $.Person = Third,
    ],
}
// A later conjunct's own negative premodifier (*artifact or non-Aura
// enchantment card*). On the first conjunct it scopes over the whole
// coordination instead (*non-Lesson [instant and sorcery] card*).
adjunct NounPremodifier { host: NounPremodifierConjunct, side: Before, host_kind: Nominal }
    where modifier.Polarity := Negative
// *Knight, Aura, Equipment, or [legendary artifact] card*. As with
// AdjectivalAttribute, an attributive adjective without a post-head
// Complement.
adjunct AdjectivePhrase { host: NounPremodifierConjunct, side: Before, host_kind: Nominal }
    where modifier.ComplementKind = Intransitive,
          modifier.AdjectivePosition != Predicative
// A Preposition Phrase Adjunct costs the same on every host: Right
// Association in the Ranking Key, not a Production Cost, picks the host
// (english.md §5).
adjunct PrepositionPhrase { host: QuantifiedNominal, side: After, host_kind: Nominal }
adjunct PrepositionPhrase { host: LocativeHead, side: After, host_kind: Nominal }
adjunct PrepositionPhrase { host: PartitiveHead, side: After, host_kind: Nominal }
adjunct PrepositionPhrase { host: SymbolHead, side: After, host_kind: Nominal }
adjunct PrepositionPhrase { host: Nominal, side: After, host_kind: Nominal }
adjunct PrepositionPhrase { host: VerbPhrase, side: After, host_kind: Predicate }
adjunct PrepositionPhrase { host: ExistentialPredicate, side: After, host_kind: Predicate }
    where head.ExistentialLocation := Located
adjunct PrepositionPhrase { host: Clause, side: Before, host_kind: Predicate, delimiter: ',' }
    where $.FrontPosition = Occupied
// A front Adverb Phrase without a comma (*Then draw a card*). Before a
// comma-set front dependent it shares the comma instead (FrontAdverbial,
// PreposedAdverbAndPreposition), never also here.
adjunct AdverbPhrase { host: Clause, side: Before, host_kind: Predicate, cost: 2 }
    where adjunct.AdjunctPosition = Front,
          head.FrontPosition != Occupied
// An intransitive Preposition Phrase preposed without a comma (*If this
// spell was kicked, instead that creature gets ...*; OSG §13, Would and
// instead). Like a comma-fronted dependent it attaches outermost, outside a
// comma-set post-dependent (english.md §8).
adjunct PrepositionPhrase { host: Clause, side: Before, host_kind: Predicate }
    where adjunct.ComplementKind = Intransitive
// A comma-set post-adjunct (*, except it has flying*) or Supplement (*,
// where X is its power*) anchors to a finite Clause, never a Verb Phrase, a
// *to*-infinitival or a relative's Clause (CGEL 15§5.1:1351).
adjunct PrepositionPhrase { host: Clause, side: After, host_kind: Predicate, delimiter: ',' }
    where head.ClauseMarking = Unmarked
adjunct PrepositionPhrase {
    host: Clause,
    side: After,
    host_kind: Supplement,
    delimiter: ',',
    cost: 2,
}
    where head.ClauseMarking = Unmarked
// A comma-set Supplement on a nonfinal Verb Phrase conjunct, where no
// Clause ends to anchor it (*Each player searches their library for up to X
// basic land cards, where X is …, puts them onto the battlefield tapped,
// then shuffles*); after the last conjunct it is the Clause's.
adjunct PrepositionPhrase {
    host: VerbPhrase,
    side: After,
    host_kind: Supplement,
    delimiter: ',',
    cost: 2,
    nonfinal,
}
// A comma-set Supplement to a keyword line's item or an indexed
// instruction, never to a Keyword Phrase in a sentence (english.md §2).
adjunct PrepositionPhrase {
    host: KeywordLineItem,
    side: After,
    host_kind: Supplement,
    delimiter: ',',
    cost: 2,
}
adjunct PrepositionPhrase {
    host: IndexedNominal,
    side: After,
    host_kind: Supplement,
    delimiter: ',',
    cost: 2,
}
// *Starting with you, ...*.
adjunct Gerund { host: Clause, side: Before, host_kind: Predicate, delimiter: ',', cost: 2 }
    where $.FrontPosition = Occupied
// A depictive (*put it onto the battlefield attacking*), of a lexical verb
// only: after an auxiliary it is the progressive's (*the player it is
// attacking*).
adjunct Gerund { host: VerbPhrase, side: After, host_kind: Predicate, cost: 2 }
    where head.VerbKind != Auxiliary | Modal
// A purpose *to*-infinitival, unless the head's frame selects a
// *to*-infinitival Complement (*costs {2} less to activate*, Arm-Mounted
// Anchor).
adjunct ToInf { host: VerbPhrase, side: After, host_kind: Predicate, cost: 2 }
// A purpose *to*-infinitival whose object Gap a relative clause binds (*the
// first spell that mana from a Treasure was spent to cast*, Rain of Riches),
// unless the head's frame selects a *to*-infinitival Complement (*Equip
// abilities you activate ... cost {3} less to activate*, Strong Back).
adjunct ToInf { host: VerbPhrase, side: After, host_kind: Predicate, cost: 2 }
    where adjunct.Gap = NP
// Conjuncts share Voice and resolve VerbKind (*it has attacked or blocked* is
// no passive perfect). Disjunctive coordination excludes a modal catenative
// paired with a plain lexical finite VP (*can't attack or block* coordinates
// bare infinitives under the modal; CGEL 15§2.1(b):1290), while *and*/*but*
// (*has first strike and must be blocked*), *be* + modal (*is snow or could
// produce {C}*), and lexical + *be* (*controls the most creatures or is tied*)
// remain admitted. Only a medial conjunct may be a PredicativeRemnant, so
// Predicatives under one copula keep one tree (*is a creature, an artifact,
// and an enchantment*).
coordination VerbPhrase {
    coordinators: And,
    unshared: [Inflection, AdjectivalPassive, CentralPosition, Ellipsis],
    proximate: [VerbKind],
    remnant: PredicativeRemnant,
}
    where $.CentralPosition = first.CentralPosition
coordination VerbPhrase {
    coordinators: Disjunctive,
    unshared: [Inflection, AdjectivalPassive, CentralPosition, Ellipsis],
    resolve: [VerbKind -> Mixed],
    remnant: PredicativeRemnant,
}
    where $.CentralPosition = first.CentralPosition,
          !(first.VerbKind = Modal & last.VerbKind = Lexical),
          !(first.VerbKind = Lexical & last.VerbKind = Modal),
          !(first.VerbKind = Mixed & last.VerbKind = Lexical),
          !(first.VerbKind = Modal & last.VerbKind = Mixed)
// Active with passive (*enters or is put into a graveyard*), Voice and
// VerbKind unvalued. Never past participles, whose Voice selects them
// (*attacked or blocked by this creature*).
coordination VerbPhrase {
    coordinators: Coordinator,
    unshared: [VerbKind, Voice, Inflection, AdjectivalPassive, CentralPosition, Ellipsis],
    serial: true,
    unlike: Voice,
}
    where $.CentralPosition = first.CentralPosition,
          first.VerbForm != PastParticiple
// *Blocking or blocked by this creature*.
coordination VerbPhrase {
    coordinators: Coordinator,
    unshared: [Inflection, AdjectivalPassive, VerbForm, CentralPosition, Ellipsis],
    proximate: [VerbKind, Voice],
}
    where $.CentralPosition = first.CentralPosition,
          first.VerbForm = GerundParticiple,
          last.VerbForm = PastParticiple,
          $.VerbForm = PastParticiple
// *You control but don't own*.
coordination VerbPhrase {
    coordinators: But,
    unshared: [Inflection, AdjectivalPassive, CentralPosition, Ellipsis],
    proximate: [VerbKind],
}
    where $.CentralPosition = first.CentralPosition
// A Linked Coordination (*may search ..., put ..., then shuffle*), set off
// by the comma before its connective, which older text omits in a binary
// one; each Conjunct may open with the connective (*loses ..., then
// discards ..., then sacrifices ...*).
coordination VerbPhrase {
    link: LinkedVerbPhrase,
    unshared: [Inflection, AdjectivalPassive, CentralPosition, Ellipsis],
    proximate: [VerbKind],
    delimiter: ',',
}
    where $.CentralPosition = first.CentralPosition
coordination KeywordPhrase { coordinators: Coordinator, unshared: [KeywordForm, FinalParameter] }
// Categories whose conjuncts share every feature. QuotedAbility: *"A" and
// "B"*; *"A," "B," and "C."*. Mention: *left or right*; *artifact, creature,
// or land*. NameComplement: *named Crown of Empires and Scepter of Empires*;
// *from among Disenchant, Braingeyser, ..., and Black Lotus*.
// InterrogativeClause: *which creatures block and how those creatures
// block*. Kind: a counter's kinds, whatever each is (*a flying, lifelink, or
// +1/+1 counter*, Reluctant Role Model).
coordination over [
    QuotedAbility, Mention, SpecifyingValue, NameComplement, InterrogativeClause, AdverbPhrase,
    MeasureNounPhrase, Kind, SymbolCosts,
] { coordinators: Coordinator }
// Only a medial conjunct may be a SubjectRemnant, agreeing with the initial
// Clause's Subject (never *you gain 4 life, draws four cards, ...*); a
// subjectless last conjunct coordinates at the final conjunct's level (CGEL
// 15§3.6:1335–1336).
coordination Clause {
    coordinators: Coordinator,
    unshared: [Inflection, FrontPosition, Ellipsis],
    delimiter: ',',
    remnant: SubjectRemnant,
    recovered: [Number, Person],
}
    where $.FrontPosition = first.FrontPosition
// Mixed moods: an imperative, then a declarative (*tap that creature and it
// doesn't untap ...*), either mood between (CGEL 15§3.5:1332–1333). After
// an initial declarative, a subjectless conjunct is a SubjectRemnant, no
// imperative.
coordination Clause {
    coordinators: Coordinator,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition, Ellipsis],
    delimiter: ',',
    serial: true,
    unlike: VerbForm,
}
    where $.FrontPosition = first.FrontPosition,
          initial.VerbForm = Plain,
          last.VerbForm = Finite,
          $.VerbForm = Plain
// A declarative, then a comma and an imperative (*it doesn't untap ..., and
// at the beginning of each of your draw steps, put ...*).
coordination Clause {
    coordinators: Coordinator,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition, Ellipsis],
    delimiter: ',',
    delimited,
    serial: false,
}
    where $.FrontPosition = first.FrontPosition,
          first.VerbForm = Finite,
          last.VerbForm = Plain,
          $.VerbForm = Plain
// The same with no comma, as older text has it before an imperative opening
// with a fronted dependent, which no Verb Phrase coordinate could hold
// (*that creature can't be regenerated this turn and if it would die this
// turn, exile it instead*).
coordination Clause {
    coordinators: Coordinator,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition, Ellipsis],
    serial: false,
}
    where $.FrontPosition = first.FrontPosition,
          first.VerbForm = Finite,
          last.VerbForm = Plain,
          last.FrontPosition := Occupied,
          $.VerbForm = Plain
// *But*, binary, of like or mixed moods (*Discard it, but you may put it on
// top of your library*).
coordination Clause {
    coordinators: But,
    unshared: [Number, Person, Inflection, FrontPosition, Ellipsis],
    delimiter: ',',
    serial: false,
}
    where $.FrontPosition = first.FrontPosition
coordination Clause {
    coordinators: But,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition, Ellipsis],
    delimiter: ',',
    serial: false,
    unlike: VerbForm,
}
    where $.FrontPosition = first.FrontPosition,
          first.VerbForm = Plain,
          last.VerbForm = Finite,
          $.VerbForm = Plain
coordination Clause {
    coordinators: But,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition, Ellipsis],
    delimiter: ',',
    serial: false,
    unlike: VerbForm,
}
    where $.FrontPosition = first.FrontPosition,
          first.VerbForm = Finite,
          last.VerbForm = Plain,
          $.VerbForm = Plain
// Linked Coordinations of like or mixed moods (*Tap it, then you may
// sacrifice an artifact*). A stranded auxiliary never precedes a comma-less
// link whose verb could be its Complement (StrandedModal).
coordination Clause {
    link: LinkedClause,
    unshared: [Number, Person, Inflection, FrontPosition, Ellipsis],
    delimiter: ',',
}
    where $.FrontPosition = first.FrontPosition
// *Reveal cards ... until ..., Kaboom! deals damage ..., then you put the
// revealed cards ...*.
coordination Clause {
    link: LinkedClause,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition, Ellipsis],
    delimiter: ',',
    serial: true,
    unlike: VerbForm,
}
    where $.FrontPosition = first.FrontPosition,
          initial.VerbForm = Plain,
          last.VerbForm = Finite,
          $.VerbForm = Plain
coordination Clause {
    link: LinkedClause,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition, Ellipsis],
    delimiter: ',',
    delimited,
    serial: false,
}
    where $.FrontPosition = first.FrontPosition,
          first.VerbForm = Finite,
          last.VerbForm = Plain,
          $.VerbForm = Plain
// The last conjunct gives Case and Countability (*them and all other
// creatures*), and Determination is `Overt` when every conjunct is, `Bare`
// when every conjunct is, and `Mixed` when they differ, so *all artifacts and
// enchantments* has no predeterminer over coordinated bare Noun Phrases while
// a mixed coordination (*Your opponents and permanents your opponents control
// with hexproof*) keeps its own wide postmodifier site.
// *And* is plural, singular between distributive ones; *or* has its
// conjuncts' Number.
coordination NounPhrase {
    coordinators: And,
    unshared: [Number, Person, DeterminativeDistribution, FirstConjunctNumber],
    proximate: [Case, Countability, NounDistribution],
    resolve: [Determination -> Mixed],
}
    where $.Number = Plural,
          $.Person = Third,
          $.FirstConjunctNumber = first.Number,
          first.NounKind != Quantity,
          first.DeterminativeDistribution != Distributive
coordination NounPhrase {
    coordinators: And,
    unshared: [Number, Person, FirstConjunctNumber],
    proximate: [Case, Countability, NounDistribution],
    resolve: [Determination -> Mixed],
}
    where $.Number = Singular,
          $.Person = Third,
          first.DeterminativeDistribution := Distributive,
          last.DeterminativeDistribution := Distributive
// *And/or*: plural with a plural last conjunct, either Number with a
// singular one (*you and/or at least one permanent you control becomes*).
// A last conjunct with no Number (a card name) is the next schema's alone,
// which leaves Number open: one tree per analysis (english.md §8).
coordination NounPhrase {
    coordinators: AndOr,
    unshared: [Number, DeterminativeDistribution, FirstConjunctNumber],
    proximate: [Person, Case, Countability, NounDistribution],
    resolve: [Determination -> Mixed],
}
    where last.Number := Plural,
          $.Number = Plural
coordination NounPhrase {
    coordinators: AndOr,
    unshared: [Number, DeterminativeDistribution, FirstConjunctNumber],
    proximate: [Person, Case, Countability, NounDistribution],
    resolve: [Determination -> Mixed],
}
    where last.Number = Singular
// An admission gate (english.md §6): a Numeric Noun Phrase is no first conjunct,
// which keeps *lost [3] or [more life]* from a Noun Phrase coordination
// (Davros, Dalek Creator); numbers alone are an Amount coordination.
// `raising_delimiter`: commas may set off the final coordinate of Right
// Node Raising (*some amount of, or all of, the mana*, Illusionary Mask).
coordination NounPhrase {
    coordinators: Alternative,
    raising_delimiter: ',',
    unshared: [DeterminativeDistribution, FirstConjunctNumber],
    proximate: [Number, Person, Case, Countability, NounDistribution],
    resolve: [Determination -> Mixed],
}
    where first.NounKind != Numeric | Quantity,
          last.NounKind != Quantity
coordination Nominal {
    coordinators: And,
    unshared: [ObliqueNumber, ObliqueNounKind, ConjunctNumber],
    proximate: [NounDistribution, KindLicense, BareMass],
    resolve: [BareMassHead -> Unmodified],
}
    where $.Number = Plural,
          $.ConjunctNumber = first.Number
coordination Nominal {
    coordinators: Disjunctive,
    unshared: [ObliqueNumber, ObliqueNounKind, ConjunctNumber],
    proximate: [NounDistribution, KindLicense, BareMass],
    resolve: [BareMassHead -> Unmodified],
}
    where $.ConjunctNumber = $.Number
coordination GenitiveNominals {
    coordinators: Coordinator,
    proximate: [Number, Countability, NounKind],
    conjunct: GenitiveNominal,
}
// Marked or bare relative clauses (*tokens that are copies of it and that are
// tapped and attacking*, *permanent you own and an opponent controls*, *any
// time you could mulligan and this card is in your hand*).
coordination RelativeClause { coordinators: Coordinator }
coordination RelativeClause { coordinators: But }
coordination NounPremodifier {
    coordinators: Coordinator,
    unshared: [Polarity],
    conjunct: NounPremodifierConjunct,
}
// Conjuncts of one Inflection share it (*attacking or blocking creature*,
// Aethertow).
coordination Participle { coordinators: Coordinator, unshared: [Polarity] }
// Conjuncts not all of one Inflection leave it unvalued (*blocking or
// blocked*): this schema's alone, so one tree per analysis.
coordination Participle {
    coordinators: Coordinator,
    unshared: [Inflection, Polarity],
    serial: true,
    unlike: Inflection,
}
// Differing coordinate grades resolve to `Mixed` (*less than or equal to …*);
// coordinates with no lexical Grade (*tapped and transformed*) leave Grade
// unvalued, so a gate that needs a Grade writes `:=`. A coordination whose
// last coordinate is comparative is handled below: one tree per analysis.
coordination AdjectivePhrase {
    coordinators: Coordinator,
    unshared: [Polarity, AdjectivalPassive],
    resolve: [Grade -> Mixed],
}
    where last.Grade != Comparative
// A comparative final coordinate with a PP Complement (*equal to or greater
// than …*) resolves differing grades to `Mixed` like the schema above.
coordination AdjectivePhrase {
    coordinators: Coordinator,
    unshared: [Polarity, AdjectivalPassive],
    resolve: [Grade -> Mixed],
}
    where last.Grade := Comparative,
          last.ComplementKind := PP
// Oracle prints a bare comparative coordinated with a non-comparative before a
// *than* Complement only the last coordinate licenses (*equal or lesser mana
// value than that spell*, Saruman of Many Colors), which CGEL marks ?
// (CGEL 15§4.4:1343 n. 66).
coordination AdjectivePhrase {
    coordinators: Coordinator,
    unshared: [Grade, Polarity, AdjectivalPassive],
}
    where last.Grade := Comparative,
          last.ComplementKind != PP,
          $.Grade = Comparative
coordination PrepositionPhrase {
    coordinators: Coordinator,
    unshared: [DeterminativeDistribution],
    proximate: [ComplementKind, Number, Determination, Case, NounKind, Countability],
}
coordination DepictiveCoordination {
    coordinators: Coordinator,
    unshared: [ConjunctKind],
    conjunct: Depictive,
    unlike: ConjunctKind,
}
// *Attacking, blocking, or tapped creature*; *the basic, Sphere, and Locus
// lands*.
coordination Attributes {
    coordinators: Coordinator,
    unshared: [ConjunctKind],
    serial: true,
    conjunct: Attribute,
    unlike: ConjunctKind,
}
coordination PostmodifierCoordination {
    coordinators: Coordinator,
    unshared: [ConjunctKind],
    conjunct: PostmodifierConjunct,
    unlike: ConjunctKind,
}
// Its conjuncts' kinds are those the selecting head takes (slot
// `UnlikeObject`).
coordination ObjectCoordination {
    coordinators: And,
    unshared: [ConjunctKind],
    serial: true,
    conjunct: ObjectConjunct,
    unlike: ConjunctKind,
}
// A comma may set off a binary coordination's second Cluster (*deals half X
// damage, rounded down, to any target, and half X damage, rounded up, to
// you*).
coordination ClusterCoordination {
    coordinators: Coordinator,
    delimiter: ',',
    conjunct: ComplementCluster,
}
// `parallel`: every Cluster has the initial one's prepositions, the first
// overt or elided.
coordination AdjunctClusterCoordination {
    coordinators: Coordinator,
    delimiter: ',',
    conjunct: AdjunctCluster,
    parallel,
}
// A positive coordinate and a *not* one joined by *but* (*from your
// graveyard, but not from anywhere else*, Haakon, Stromgald Scourge; *equal
// to the damage dealt, but not more than the player's life total*, Drain
// Life; CGEL 15§2.6:1313).
coordination over [ComplementNounPhrase, PrepositionPhrase] {
    coordinators: But,
    negator: Not,
    unshared: [DeterminativeDistribution],
    proximate: [ComplementKind, Number, Determination, Case, NounKind, Countability],
    delimiter: ',',
}
// *Only during the declare blockers step, only if ..., and only once each
// turn*.
coordination AdjunctCoordination {
    coordinators: Coordinator,
    unshared: [ConjunctKind],
    serial: true,
    conjunct: PredicateAdjunct,
    unlike: ConjunctKind,
}
coordination AmountOrNounPhrase {
    coordinators: Coordinator,
    unshared: [ConjunctKind],
    conjunct: AmountOrNounConjunct,
    unlike: ConjunctKind,
}
coordination Amount { coordinators: Coordinator, proximate: [QuantityNumber, Sign] }
// It determines as its last conjunct does (*one or more cards*). No
// conjunct ends in the Targeting Marker: the determiners coordinate under
// the one Marker (*[one or two] target creatures*, not *one or [two
// target]*).
coordination DeterminerPhrase {
    coordinators: Coordinator,
    proximate: [Number, Countability, DeterminativeDistribution, NounKind],
}
    where first.DeterminativeDistribution != Targeting,
          last.DeterminativeDistribution != Targeting,
          first.TargetMarked != Marked,
          last.TargetMarked != Marked
coordination NominalClusters {
    coordinators: And,
    unshared: [ConjunctNumber, DeterminativeDistribution],
    conjunct: NominalCluster,
}
    where !(first.DeterminativeDistribution = Distributive & last.DeterminativeDistribution = Distributive),
          $.Number = Plural,
          $.ConjunctNumber = first.Number
coordination NominalClusters {
    coordinators: And,
    unshared: [ConjunctNumber],
    conjunct: NominalCluster,
}
    where first.DeterminativeDistribution := Distributive,
          last.DeterminativeDistribution := Distributive,
          $.ConjunctNumber = $.Number
coordination NominalClusters {
    coordinators: AndOr,
    unshared: [ConjunctNumber, DeterminativeDistribution],
    conjunct: NominalCluster,
}
    where $.ConjunctNumber = Plural,
          $.Number = Plural
coordination NominalClusters {
    coordinators: AndOr,
    unshared: [Number, ConjunctNumber, DeterminativeDistribution],
    conjunct: NominalCluster,
}
    where $.ConjunctNumber = Singular
coordination NominalClusters {
    coordinators: Alternative,
    unshared: [ConjunctNumber, DeterminativeDistribution],
    conjunct: NominalCluster,
}
    where $.ConjunctNumber = $.Number
// Numbers alone are an Amount coordination (*X is 2 or 3*), never also
// a fused quantity over them (english.md §8).
coordination FusedQuantity {
    coordinators: Disjunctive,
    proximate: [Number, Countability, NounKind],
    conjunct: FusableDeterminer,
}
    where !(first.NounKind = Numeric & last.NounKind = Numeric)

correlative Both = And
correlative Either = Or
correlative Neither = Nor

// *And so on* ends a coordination of any Category.
idiomatic_coordinate And = IdiomaticCoordinate
