// The Oracle English grammar data file. It names Categories, features,
// Schemas and core closed-class lexemes only: every other word, and every
// Subcategorization Frame, comes from the lexical environment it is bound to.
// Citations: `CGEL 15§3.6:1335` is The Cambridge Grammar of the English
// Language, Ch. 15 §3.6, p. 1335; `OSG` is `docs/oracle-style-guide.md`;
// `ADR` is `docs/decisions/english.md`.
root Document

// A keyword mention may omit parameters; a Keyword Line supplies them.
feature KeywordForm = Bare | Parametric
// `SetOff` kinds follow an em dash: a set-off cost ends in its own period,
// a set-off ability runs to the end of the line (OSG §3, Periods).
feature FinalParameter = Cost | SetOffCost | SetOffAbility
feature Number = Singular | Plural
// The Number of a noun's *of* oblique or a determinative's Complement (*all
// but one*).
feature ObliqueNumber = Singular | Plural
// `Equative` and `NonScalarInequality` are the comparisons a non-scalar
// governor marks: *as* (*same*), *than* (*different*, *other*; CGEL
// 13§1.1:1100).
feature Grade = Plain | Comparative | Superlative | Equative | NonScalarInequality
// Internal numeral–noun agreement survives external group respecification.
feature QuantityNumber = Singular | Plural
// The Number of each conjunct of an *and*-coordination of nominals; the
// coordination itself is plural.
feature ConjunctNumber = Singular | Plural
// The first conjunct's Number in an *and*-coordination of Noun Phrases;
// existential *be* may agree with it (CGEL 4§3.2.2:242 n. 21).
feature FirstConjunctNumber = Singular | Plural
// Oracle text has no first person.
feature Person = Second | Third
feature VerbForm = Plain | Finite | GerundParticiple | PastParticiple
// `To`: a clause whose Verb Phrase carries *to*, made only by ToInfinitival
// (CGEL 2§14:64–65).
feature ClauseMarking = Unmarked | To | Relative
feature Voice = Active | Passive
// Privative: a verb whose Adjectival Passive is a declared Adjective
// (*tapped*).
feature AdjectivalPassive = Lexical
// Privative: auxiliary verbs (CGEL's NICE verbs).
feature VerbKind = Auxiliary
// Of an auxiliary (*can*, *can't*). Of a premodifier: `Negative` for
// *non-*, otherwise unvalued.
feature Polarity = Affirmative | Negative
// A Preposition Phrase's Complement's Slot Kind. `MeasureNP`: only *of*
// (*your choice of 5/1 or 1/5*) and *among* (*from among flying, ..., and
// +1/+1*). `QuotedAbility`: only Nominal-hosted
// *with* (*a token with "This token can't block."*; [CR#113.1a]). `Name`:
// only *among* (*from among Disenchant, ..., and Black Lotus*).
feature ComplementKind =
    | NP | MeasureNP | PP | AdjP | AdvP | Nominal | Amount | FiniteClause | ExpandableClause
    | SetOffClause | VerblessClause | AbsoluteClause | ToInf | Gerund | BareInf | KeywordPhrase
    | QuotedAbility | Mention | FixedFrameNP | Cost | Intransitive | AmountOrNP | UnlikeObject
    | Name
// The Slot Kind of a determinative's Preposition Phrase's Complement: the
// values of ComplementKind, which it agrees with.
feature ObliqueKind =
    | NP | MeasureNP | PP | AdjP | AdvP | Nominal | Amount | FiniteClause | ExpandableClause
    | SetOffClause | VerblessClause | AbsoluteClause | ToInf | Gerund | BareInf | KeywordPhrase
    | QuotedAbility | Mention | FixedFrameNP | Cost | Intransitive | AmountOrNP | UnlikeObject
    | Name
// `Quantity`: only *number*, the number-transparent noun (*any number
// of target creatures*; CGEL 5§3.3:349–351). `Serial`: only *time*, a
// frequency or multiplier head (*three times*; CGEL 8§9:715).
feature NounDistribution = Ordinary | Quantity | DirectMeasure | HeadOnly | Serial | FixedFrame
// `Quantity`: a fused-head quantity (*choose one*). `Manner`: only *way*,
// the one noun that is a Manner Adjunct without a preposition (*do it this
// way*; CGEL 8§2.1:671).
feature NounKind = Ordinary | Temporal | Manner | Numeric | Quantity
// Only *type*: a noun whose values are cited names, the variable of a
// specifying copular clause (*the new creature type can't be Wall*; CGEL
// 4§5.5:266-269).
feature Variable = Cited
// The NounKind of a head's *of* oblique.
feature ObliqueNounKind = Ordinary | Temporal | Manner | Numeric | Quantity
feature Determination = Bare | Overt
// The Determination of a determinative's Complement (*than one*).
feature ObliqueDetermination = Bare | Overt
// The DeterminativeDistribution of a determinative's Complement's
// Noun Phrase (*all but [the highest roll]*).
feature ObliqueDistribution =
    | Dependent | Independent | Numerical | IndefiniteArticle | Distributive | Deictic
    | SingularOrQuantified | FreeChoice | Multiplier | Targeting
feature AdjectivePosition = Attributive | Predicative
feature Sign = Negative | Zero | Positive
// `Existential`: only dummy *there* (CGEL 16§6.2:1394).
feature PronounKind = Personal | Existential | Relative
// `FreeChoice`: only *any*. Determined excludes it so *any* takes number
// transparency (FreeChoiceDetermined, TransparentQuantity,
// TemporalQuantity; never *any number of target creatures becomes*), and
// builds no second tree of an analysis FreeChoiceDetermined builds (the
// gate is Determined's).
// `IndefiniteArticle`: only *a*. `SingularOrQuantified`: only *another*,
// which also takes a quantified plural (*another three bodies*; CGEL
// 5§3.4:353) and a temporal location (*another day*, never *a day*; a gate
// on TemporalLocation).
// `Targeting`: only the Targeting Marker *target*. Kept apart from
// `Dependent`, which FusedDegreeDeterminer and DegreePartitive require: it
// never fuses or partitions (not *choose target*, *target of those*).
feature DeterminativeDistribution =
    | Dependent | Independent | Numerical | IndefiniteArticle | Distributive | Deictic
    | SingularOrQuantified | FreeChoice | Multiplier | Targeting
feature Case = Plain | Nominative | Accusative | Genitive
feature Countability = Count | Mass
// `Linking`: a connective initial in its Linked Conjunct. `Multiplying`: a
// multiplier (*twice the damage*), also a frequency adverb (*draw a card
// twice*); it modifies a Noun Phrase or measure, never a Preposition Phrase
// or temporal Noun Phrase (one tree, ADR §8).
feature AdjunctPosition = Front | Central | End | Phrasal | Multiplying | Bounding | Linking
// A Clause whose front position holds a comma-set dependent (*If you do,
// ...*). Dependents sharing one comma are siblings in one Production (*Then
// if ...*), so a comma-less front Adverb Phrase never also precedes such a
// Clause (ADR §8). A coordination takes it from its first conjunct:
// dependents sharing one comma are siblings whether they scope over that
// conjunct or the whole (*Once each turn, C1, and C2*), never split between
// the two.
feature FrontPosition = Occupied
// A Verb Phrase that begins with a central Adjunct (*also gains trample*).
// Before a bare imperative the adverb is the Clause's front Adjunct, never
// also this (ADR §8). A coordination begins where its first conjunct does.
feature CentralPosition = Occupied
// A lexicon-declared fused-head adjective naming a Quality (*protection
// from multicolored*).
feature QualityHead = Fused
// In a Word-Part Coordination, a Compound Noun's first base alone, or the
// last Conjunct's `Whole` noun (CGEL 15§3.1(g):1325).
feature CompoundPart = Base | Whole
feature Inflection =
    | Invariant | IndependentGenitive | Singular | Plural | Plain | Present | Preterite | Irrealis
    | GerundParticiple | PastParticiple

category Document
category Paragraphs
category ModalHeader
category ModalAbility
category SymbolCosts
category ActivationCost
category NonManaCost
category Mode
category ModeEffect
category Effect
category Pawprints
category TypeModifier
category Modes
category Ability
category TypeLine
category CardTypes
category Subtypes
category KeywordList
category Quality
// A name is number-neutral: the agreement its text shows fixes its Number
// (*When The Notary Hobbits enter*, *Mizzium Mortars deals*), and where the
// text shows none it stays unvalued. Never another card's name, which
// `Lex(Catalog)` does not admit.
category Name [Number]
// A name cited as a name: after *named*, as the parameter of *Partner
// with* [CR#702.124j], and as the complement of *among* after *from*,
// wherever that attaches, as in a choice (*choose a card name ... from among
// Disenchant, ..., and Black Lotus*). Only these admit another card's name,
// through `OtherCardName()` (`docs/decisions/lexicon.md` §6).
category NameComplement
category Condition
category Measure
category Symbols
// An Arabic numeral named as a noun, without the numeral's Number.
category NumeralName
// A bracketed loyalty symbol: a cost, or a counted noun (*an
// additional [+1]*).
category LoyaltySymbol
category Header
category RowHeader
category Chapters
category IndexedNominal [Number]
category NominalModifier
category ChoiceQuantity [Number]
category Sentence
category Sentences
// Inflection is the finite verb's, so an independent clause can exclude
// irrealis *were*. Number and Person are the Subject's, which a
// SubjectRemnant recovers.
category Clause [Number, Person, VerbForm, ClauseMarking, Inflection, FrontPosition] { gap }
// Number: a subject relative agrees with its antecedent. NounKind: an
// adverbial relative modifies a temporal nominal.
category RelativeClause [Number, NounKind, ClauseMarking]
// A finite clause whose Subject is its Gap.
category SubjectGapClause : Clause [Number, Person, VerbForm, Inflection] { gap }
// A finite clause with an extracted Adjunct.
category AdjunctGapClause : Clause [VerbForm] { gap }
// A finite clause that opens with its Subject, as a bare relative's must
// (CGEL 12§3.5.5:1055). An admission gate (ADR §6): it restates the Clause
// Productions that open with the Subject, which keeps *each turn, those coins
// come up heads* from an adverbial relative of *The first time you flip one
// or more coins* (Edgar, King of Figaro).
category SubjectInitialClause : Clause [VerbForm, Inflection] { gap }
// A coordination of bare adverbial relatives' Clauses.
category SubjectInitialCoordination : Clause [VerbForm, Inflection] { gap }
// A participle premodifying a nominal (*attacking creature*).
category Participle : VerbPhrase [Inflection, Polarity]
category VerbPhrase [
    Number, Person, VerbForm, Voice, VerbKind, Inflection, AdjectivalPassive, CentralPosition,
] { gap }
// A Linked Conjunct: a Clause or Verb Phrase opened by its linking
// connective (*Each player discards a card, [then draws a card]*), as *so*
// and *yet* are a coordination's sole linking item (CGEL 15§2.10:1320).
category LinkedClause : Clause [VerbForm, ClauseMarking, Inflection, FrontPosition] { gap }
category LinkedVerbPhrase : VerbPhrase [
    Number, Person, VerbForm, Voice, VerbKind, Inflection, AdjectivalPassive, CentralPosition,
] { gap }
// Existential *there*, and the predicate it is subject of.
category DummyPronoun : NounPhrase [Number, Person]
category ExistentialPredicate : VerbPhrase [Number, Person, VerbForm, Inflection, ComplementKind]
category DisplacedSubject : NounPhrase [Number, Case] { gap }
category FusedNounPhrase : NounPhrase [
    Number, Person, Case, Determination, NounKind, Countability, DeterminativeDistribution,
] { gap }
// A symbol sequence as a Noun Phrase, which a Preposition Phrase may
// postmodify (*{X} in its mana cost*).
category SymbolHead : NounPhrase [Number, Person, Case, Determination, NounKind, Countability]
// A determinative or quantity with its partitive oblique (*each of those
// cards that has suspend*); it carries its determinative's distribution.
category PartitiveHead : NounPhrase [
    Number, Person, Case, Determination, NounKind, Countability, DeterminativeDistribution,
] { gap }
// A slash measure as a Noun Phrase (*gets +2/+2*), only where a head
// selects one or beside keyword phrases naming counter kinds; never a
// general Object.
category MeasureNounPhrase : NounPhrase
// A compound locative determinative, which a Preposition Phrase may
// postmodify (*anywhere else*).
category LocativeHead : NounPhrase [Number, Person, Case, Determination, NounKind, Countability]
// A bare Noun Phrase that only a preposition's fixed frame admits (*from
// outside the game*).
category FixedFrameNounPhrase : NounPhrase [
    Number, Person, Case, Determination, NounKind, Countability,
]
// DeterminativeDistribution is the determiner's, so an *and*-coordination
// of distributive ones is singular (CGEL 5§18.4:508). The Measure Gap is
// closed: only coordinated Nominals share a slash Measure (*base power and
// toughness 4/4*). NounDistribution is the head noun's, a coordination's
// its last conjunct's (NominalPredicative).
category NounPhrase [
    Variable, Number, Person, Case, Determination, NounKind, Countability,
    DeterminativeDistribution, FirstConjunctNumber, NounDistribution,
] { gap, closed_gaps: [Measure] }
// A temporal Adjunct of location (*this turn*; CGEL 8§6.3:698) or frequency
// (*three times*; 8§9:713–716).
category TemporalNounPhrase : NounPhrase [
    Number, Person, Case, Determination, NounKind, Countability,
]
category ComplementNounPhrase : NounPhrase [
    Number, Person, Case, Determination, NounKind, Countability, DeterminativeDistribution,
] { gap }
// A nominal's ComplementKind and ObliqueNumber are its head noun's
// Complement's.
category Nominal [
    Variable, Number, Countability, NounKind, Determination, NounDistribution, ComplementKind,
    ObliqueNumber, ObliqueNounKind, ConjunctNumber, CompoundPart,
] { gap }
category QuantifiedNominal : Nominal [QuantityNumber, NounKind, Determination, NounDistribution]
category ModifiedQuantifiedNominal : Nominal [
    QuantityNumber, NounKind, Determination, NounDistribution,
]
// A temporal nominal bounded by a relative clause (*next time you cast a
// spell*). An admission gate (ADR §6): RelativeTime and
// RelativeTimePostmodifier restate NominalPostmodifier and
// TemporalPostmodifier, so it takes a *when*-less adverbial relative, then
// only temporal bounds. What it gates is the relative it requires: without
// one, every determined temporal nominal is one too (*End [the turn]*, Time
// Stop, with *the turn* a temporal Adjunct).
category RelativeTemporalNominal : Nominal [
    Number, Countability, NounKind, Determination, NounDistribution,
]
category BareNominal : Nominal [
    Variable, Number, Countability, NounKind, Determination, NounDistribution, ComplementKind,
    ObliqueNumber, ObliqueKind, ObliqueNounKind, CompoundPart,
] { gap }
// The singular count nominals that share a determiner before the
// final, determined conjunct of a SharedDeterminerCoordination.
category SharedNominals [Number, Countability]
category NounPremodifier : Nominal [Polarity]
// A Word-Part Coordination of Compound Nouns sharing a head word (*a +1/+1,
// first strike, or vigilance counter*), and each Conjunct.
category CompoundCoordination : Nominal [Number, Countability, NounKind, NounDistribution]
category CompoundConjunct : Nominal [Number, Countability, NounKind, NounDistribution, CompoundPart]
// A noun premodifier conjunct with an adjective or negative noun
// premodifier of its own (*artifact or [non-Aura enchantment] card*).
category NounPremodifierConjunct : Nominal
category PrepositionalNominal : Nominal [Number, Countability, NounDistribution]
// A number-transparent quantity's oblique determined by the Targeting
// Marker alone (*any number of target creatures*), and its Noun Phrase.
category TargetedOblique : PrepositionPhrase [Number, NounKind]
category TargetedNounPhrase : NounPhrase [Number, NounKind, Countability]
category BareNominalComplement : Nominal
// A genitive's possessor, never postmodified: Oracle fronts the player noun
// "to avoid a dangling possessive" (OSG §6, Controller and owner). An
// admission gate (ADR §6): it restates the Noun Phrase Productions over
// BareNominal, which keeps *[the top card of target player]'s library* from
// a possessor (Merfolk Observer).
category Possessor : NounPhrase [Number, Person, Case]
// One genitive over coordinated nominals (*target artifact or creature's
// owner*).
category PossessorNominals : Nominal [Number, Countability, NounKind]
// A genitive on each coordinated nominal (*that creature's or spell's
// controller*), and each genitive.
category GenitiveNominal : Nominal [Number, Countability, NounKind]
category GenitiveNominals : Nominal [Number, Countability, NounKind]
category NumericalDeterminer : DeterminerPhrase [Number, Countability]
// An ordinal's position from an end (*third from the top*): where a card is
// put, never a nominal's modifier.
category PositionPhrase : AdjectivePhrase
// A determinative that can head a fused Noun Phrase alone (*choose one*),
// and a coordination of such (*one or more*).
category FusableDeterminer : DeterminerPhrase [Number, Countability, NounKind]
category FusedQuantity : DeterminerPhrase [Number, Countability]
// A determinative's Complement has a Number of its own (*all but one*).
category DeterminerPhrase [
    Number, Countability, DeterminativeDistribution, NounKind, ComplementKind,
    ObliqueNumber, ObliqueKind, ObliqueDetermination, ObliqueDistribution,
]
// A determiner ending in the Targeting Marker; an outer determiner or
// adjective gives it its Number (*two target creatures*, *other target
// creatures*).
category TargetingMarker : DeterminerPhrase [
    Countability, DeterminativeDistribution, NounKind, ComplementKind, ObliqueNumber, ObliqueKind,
    ObliqueDetermination,
]
// A Preposition Phrase's Number and Determination are its Complement's
// (*up to two*, a determiner; *of them*, a partitive oblique).
category PrepositionPhrase [
    ComplementKind, Number, Determination, Case, NounKind, Countability, DeterminativeDistribution,
] { gap }
// An Adjectival Passive is Passive; it is a predicative Complement
// only, never a depictive Adjunct or a premodifier.
category AdjectivePhrase [
    Determination, AdjectivePosition, Voice, ComplementKind, Grade, Polarity, QualityHead,
] { gap }
category AdverbPhrase [AdjunctPosition]
// The predicative Complement function; its head bears it too.
category Predicative { function }
// Unlike categories coordinated as a depictive Adjunct (*onto the
// battlefield tapped and attacking*; CGEL 15§3.2:1326–1329), and each
// conjunct.
category Depictive : Predicative [ComplementKind] { function }
category DepictiveCoordination : Predicative [ComplementKind] { function }
// Unlike categories coordinated as a predicate Adjunct (*only during your
// turn and only once each turn*), and each conjunct.
category PredicateAdjunct [ComplementKind] { function }
// A verb's Complements, each with an optional Adjunct, coordinated after
// the shared verb (*put [one of them into your hand] and [the rest into
// your graveyard]*; CGEL 15§4.3:1341–1343).
category ComplementCluster
category ClusterCoordination : ComplementCluster
// A later Cluster's keyword parameters, the keyword elided (*gain
// protection from white if ..., [from blue] if ...*).
category ParameterRemnant
// Clusters of two Preposition Phrase Adjuncts after a head with no
// Complement (*enters [with a +1/+1 counter on it for each other red
// creature you control] and [a +1/+1 counter on it for each other green
// creature you control]*).
category AdjunctCluster
category AdjunctClusterCoordination : AdjunctCluster
// A later Adjunct Cluster's Complement, the preposition elided (*[a +1/+1
// counter on it] for each ...*, *with* elided).
category PrepositionRemnant
// A medial Verb Phrase conjunct's Predicative Complement, the copula elided
// (*is enchanted, [equipped], and has a counter on it*; CGEL
// 15§3.6:1335–1336).
category PredicativeRemnant
// A medial Clause conjunct's finite Verb Phrase, the Subject elided (*you
// gain 4 life, [draw four cards], and he deals 4 damage*; CGEL
// 15§3.6:1335–1336).
category SubjectRemnant [Number, Person, VerbForm]
// *And [so on for double strike, ...]*, standing for further conjuncts of
// its coordination's kind.
category IdiomaticCoordinate
// Predicate Adjuncts that *but* or *and* adds to a whole Clause, and the
// fragment *only* or *not* focuses (*but only during their turn before the
// end step*; CGEL 15§4.5:1347–1348).
category ClauseFragment
category QualifyingFragment
// A positive and a *not* coordinate joined by *but* (*from your graveyard,
// but not from anywhere else*; CGEL 15§2.6:1313), and each coordinate.
category ContrastConjunct : NounPhrase [Polarity] { function }
category ContrastCoordination : NounPhrase [Polarity] { function }
category ContrastPrepositionConjunct : PrepositionPhrase [
    ComplementKind, Number, Determination, Case, NounKind, Countability, DeterminativeDistribution,
    Polarity,
] { function }
category ContrastPrepositionCoordination : PrepositionPhrase [
    ComplementKind, Number, Determination, Case, NounKind, Countability, DeterminativeDistribution,
    Polarity,
] { function }
// Unlike premodifiers coordinated, with a coordinator or asyndetically
// (*noncreature, nonland card*), and each premodifier.
category Attributes [ComplementKind] { function }
// Unlike categories coordinated as an Object or a preposition's Complement
// where the head selects each of them there (*has base power and toughness
// 5/5 and vigilance*; slot `UnlikeObject`), and each conjunct.
category ObjectConjunct : NounPhrase [ComplementKind] { function }
category ObjectCoordination : NounPhrase [ComplementKind] { function }
// An Amount and a Noun Phrase coordinated where a head selects both (*equal
// to [2] or [the greatest power among Dinosaurs you control]*), and each
// conjunct.
category AmountOrNounConjunct : NounPhrase [ComplementKind] { function }
category AmountOrNounPhrase : NounPhrase [ComplementKind] { function }
// Unlike postmodifiers coordinated (*the player with the most life or tied
// for most life*), and each.
category PostmodifierConjunct : Postmodifier [ComplementKind] { function }
category PostmodifierCoordination : Postmodifier [ComplementKind] { function }
category Attribute : Attributes [ComplementKind, Polarity] { function }
// The premodifiers of an asyndetic chain after its first.
category AttributeChain : Attributes [ComplementKind] { function }
category AdjunctCoordination : PredicateAdjunct [ComplementKind] { function }
// An Adverb Phrase or a frequency Noun Phrase as Complement (*more than
// twice*, *more than three times*).
category Adverbial { function }
// The Adjunct function before a selected Complement or shifted Object.
category Interleaved { function }
// The Adjunct function before a passive's Internalised Complement only, the
// *by* phrase (CGEL 4§3.2.1:241); an admission gate (ADR §6), see
// InterleavedManner.
category InternalisedInterleaved { function }
// The Adjunct function in central position between *be* or a copula and
// its Complement (*is still on top of your library*, *become no longer
// suspected*; ADR §3).
category CentralAdjunct { function }
// A relative clause before the Complement its noun selects (*Equip
// abilities [you activate] [of other Equipment]*; CGEL 5§15:454).
category InterleavedModifier [Number, NounKind] { function }
// An Object's Modifier postposed past the Complements that follow it (CGEL
// 12§4:1066), with the Case its Object agrees in.
category PostposedModifier [Case] { function }
// The Modifier function after a nominal head: a relative clause or a
// participial clause.
category Postmodifier [Number, NounKind] { function }
// A relative phrase with genitive *whose*.
category RelativeNounPhrase : NounPhrase [Number]
// A preposition and its relative pronoun, fronted (*for which*).
category RelativePrepositionPhrase : PrepositionPhrase
category KeywordPhrase [KeywordForm, FinalParameter]
category KeywordLineItem [KeywordForm, FinalParameter]
category KeywordParameters [KeywordForm, FinalParameter]
category BoundKeyword [KeywordForm, FinalParameter]
// QuantityNumber agrees with a counted noun (*two cards*); as a Noun Phrase
// an Amount is singular (*X can't be 0*).
category Amount [QuantityNumber, Sign, ComplementKind]
category SignedAmount
category Cost
category FiniteClause : Clause
category ExpandableClause : Clause
// A dash-set Supplement giving a head's Complement its content
// (SetOffComplementClause).
category SetOffClause : Clause
category VerblessClause : Clause
category AbsoluteClause : Clause
// Subjectless non-finite Complements: a to-infinitival is a Clause, a bare
// infinitival or gerund-participial its Verb Phrase. None passes up a
// predicative Gap (*can't be __*); one is shared only inside it (*can't be
// and become legendary*).
category ToInf : Clause { gap, closed_gaps: [Pred] }
// Its object Gap is filled by the Subject of the verb selecting it.
category HollowInf : Clause
category BareInf : VerbPhrase [Number, Person, VerbForm, Voice] { gap, closed_gaps: [Pred] }
// An auxiliary's participial Complement (*have been __*).
category AuxiliaryComplement : VerbPhrase [VerbForm, Voice, VerbKind] {
    gap,
    closed_gaps: [Pred],
    function,
}
category Gerund : VerbPhrase [Number, Person, VerbForm, Voice] { gap }
// A gerund-participial Clause with its Subject, in Oracle a Subject only.
category GerundClause : Clause
category QuotedAbility
// A word cited rather than used (*choose left or right*; CGEL 5§8.2:401).
// It fills only a slot a head's frame selects, never an ordinary Noun
// Phrase's.
category Mention
category MentionModifier
category QuotedCost
// A quoted cost and its premodifiers, kept out of Nominal coordination.
category QuotedCostNominal : Nominal [Number, Countability, NounKind, NounDistribution]
category InterrogativeClause : Clause
category InterrogativePhrase : NounPhrase [Number, Person]

word By = "prep:by"
word Up = "prep:up"
word Of = "prep:of"
word Than = "prep:than"
word From = "prep:from"
word For = "prep:for"
// `In` through `After`: the prepositions of an existential's extension
// (LocatedExistentialBe).
word In = "prep:in"
word On = "prep:on"
word Among = "prep:among"
word Under = "prep:under"
word Outside = "prep:outside"
word After = "prep:after"
word As = "prep:as"
word DegreeAs = "adv:as"
word Plus = "prep:plus"
word Minus = "prep:minus"
word The = "det:the"
word Genitive = "clitic:genitive"
word That = "det:that"
word ContentMarker = "sub:that"
word Any = "det:any"
word Or = "coord:or"
word And = "coord:and"
word AndOr = "coord:and/or"
word Nor = "coord:nor"
word But = "coord:but"
word Not = "adv:not"
word Those = "det:those"
word Both = "det:both"
word Either = "det:either"
word Neither = "det:neither"
word To = "sub:to"
word Each = "det:each"
word All = "det:all.count"
word Whichever = "det:whichever"
word Which = "det:which"
word Whether = "sub:whether"
word How = "adv:how"
word Target = "det:target"
word Most = "det:most"
word No = "det:no"
word Anywhere = "det:anywhere"

class Predeterminer = ["det:all.count", "det:all.mass", "det:both"]
class DegreeQuantifier = ["det:many", "det:much"]
class Coordinator = ["coord:and", "coord:or", "coord:and/or", "coord:nor"]
class Disjunctive = ["coord:or", "coord:and/or", "coord:nor"]
class Alternative = ["coord:or", "coord:nor"]
// They attach a new element to a whole Clause: *but* or *and*, never *or*
// (CGEL 15§4.5:1347).
class AddingCoordinator = ["coord:and", "coord:but"]
// They focus a qualifying added element (AddedElement).
class FocusingAdverb = ["adv:only", "adv:not"]
class BeVerb = ["verb:be", "verb:'re", "verb:aren't"]
class HaveVerb = ["verb:have", "verb:'ve", "verb:haven't"]
// Auxiliaries stranded before their Complement's ellipsis site (CGEL
// 17§7.1:1519–1523), by the omitted verb's form: plain after a modal, a
// past participle after *have*, either participle after *be*. Never a
// reduced clitic, which cannot stand in this stressed position. *Do* has
// its intransitive pro-form frame instead.
class StrandableModal = ["verb:can", "verb:can't", "verb:may", "verb:must", "verb:will"]
class StrandableHave = ["verb:have", "verb:haven't"]
class StrandableBe = ["verb:be", "verb:aren't"]
// They select a *than* Complement (*more than one*; CGEL 13§2.1:1104), and
// a measure phrase modifies them.
class ComparativeQuantifier = ["det:more.count", "det:more.mass", "det:less", "det:fewer"]
// They head a partitive with an *of* oblique (*each of those creatures*;
// CGEL 5§9.1:411). *Any* and a quantity have Productions of their own.
class PartitiveQuantifier = [
    "det:all.count", "det:all.mass", "det:another", "det:both", "det:each", "det:either",
    "det:fewer", "det:less", "det:many", "det:more.count", "det:more.mass", "det:most", "det:much",
    "det:neither", "det:none", "det:some",
]
// They float as an Adjunct after a plural Subject or an auxiliary (CGEL
// 5§9.2:413). *All* floats after a personal pronoun only (FloatedAll).
class FloatingQuantifier = ["det:each", "det:both"]
class SuperlativeQuantifier = ["det:most", "det:least", "det:fewest"]
// The superlative that fuses with its head (*tied for fewest*). Never
// *most* or *least*: they also modify an adjective (*most common*), which
// fusing would leave a depictive Adjunct.
class CountSuperlativeQuantifier = ["det:fewest"]
// They stand alone as a fused determiner-head (*replacing all instances of
// one color word with another*; CGEL 5§9.1:410). Fused *each* is an
// implicit partitive (CGEL 5§9.2:413), as in *each enters with ...*
// (Storyweave).
class FusedQuantifier = [
    "det:another", "det:both", "det:each", "det:more.count", "det:everything", "det:this",
    "det:none",
]
// They choose from a set in an implicit partitive (*If a player does
// either*; CGEL 5§9.2:413, which would put *each* here too but for its
// fixed uses such as *each to their own*). Their Noun Phrase is Ordinary,
// so NonNumericComplement's ban on fused *each* does not reach it.
class FusedChoice = ["det:either", "det:neither"]
class RelativeMarker = ["sub:that", "pronoun:which", "pronoun:who"]
// Only *other*, which heads a Noun Phrase with ordinary determination (*the
// other*; CGEL 5§9.1:410).
class FusedHeadAdjective { typed }
// Only *same*, whose fused Noun Phrase takes the definite article (CGEL
// 5§9.3:416).
class DefiniteFusedHeadAdjective { typed }
class SumAdjective { typed }
class PhrasalAdverb { typed }
class MultiplyingAdverb { typed }
class BoundingAdverb { typed }
class FrontAdverb { typed }
class CentralAdverb { typed }
class EndAdverb { typed }
class LinkingAdverb { typed }
class CoordinateAdverb { typed }
class CardType { typed }
class Supertype { typed }
class Subtype { typed }
class ParameterizedKeyword { typed }
class AbilityWord { typed }
class AnchorWord { typed }
class BracedSymbol { typed }
class Variable { typed }
// Only `LEVEL`, the marker of a level symbol [CR#711.2a].
class RangeMarker { typed }
// Only `{P}` [CR#107.18].
class Pawprint { typed }
// The Compound Nouns whose first base names their kind: the counters.
class SharedHeadCompound { typed }

slot TypeModifier = TypeModifier
slot NonManaCost = NonManaCost
slot Quality = Quality
slot Name = NameComplement
slot Ability = Ability
slot Condition = Condition
slot Measure = Measure
slot NP = ComplementNounPhrase where slot.Case != Nominative
// A *with* or *without* phrase with an Absolute Clause is an Adjunct
// or a Modifier, never a selected Complement (CGEL 14§10(a):1267).
slot PP = PrepositionPhrase where slot.ComplementKind != AbsoluteClause
slot Pred = Predicative
slot AdjP = AdjectivePhrase
slot AdvP = Adverbial
slot LocativeNP = LocativeHead
slot FixedFrameNP = FixedFrameNounPhrase
slot Position = PositionPhrase
slot MeasureNP = MeasureNounPhrase
slot KeywordPhrase = KeywordPhrase
slot Nominal = BareNominalComplement
slot Amount = Amount
// Unlike slots. Where a head's frames select two or more of a slot's kinds
// in one position, that position also takes the slot's coordination,
// restricted to conjuncts of the kinds the head selects there: each conjunct
// fills the position alone (CGEL, Ch. 15 §3.1, p. 1323, rule [1]). A
// preposition's derived frame admits the Host Categories all of its frames
// do. *Equal to [2] or [the greatest power among ...]*; *has [flying] and
// ["{T}: Add {G}."]*, never *destroy [target creature] and [flying]*.
slot AmountOrNP = AmountOrNounPhrase { unlike: [NP, Amount] }
slot UnlikeObject = ObjectCoordination { unlike: [NP, KeywordPhrase, QuotedAbility, MeasureNP] }
// Mana-only. A final Keyword Parameter Cost is this slot after a space, or
// an em dash, a NonManaCost and a period, each with its own FinalParameter;
// the punctuation is the production's, not a Reading (OSG §3, Em dashes).
// The slot stays mana-only for DashCost (*Suspend 4—{1}{U}*), non-final
// keyword costs and keyword actions.
slot Cost = SymbolCosts
slot FiniteClause = FiniteClause
slot ExpandableClause = ExpandableClause
slot SetOffClause = SetOffClause
slot VerblessClause = VerblessClause
slot AbsoluteClause = AbsoluteClause
slot InterrogativeClause = InterrogativeClause
slot ToInf = ToInf
slot HollowToInf = HollowInf
slot BareInf = BareInf
slot Gerund = Gerund
slot QuotedAbility = QuotedAbility
slot Mention = Mention

// A distributive adjunct (*for each …*) anchors to the outermost eligible
// clause, as a comma-set Supplement does (ADR §5, AttachmentClass).
high_attachment PrepositionPhrase where $.DeterminativeDistribution = Distributive

TextMode: Document -> Mode
TextModalHeader: Document -> ModalHeader
ModalAbility: ModalAbility -> header:ModalHeader '\n':Bound modes:Modes
ModalTextAbility: Ability -> ModalAbility
ModalEffect: Effect -> ModalAbility
ActivatedModalHeader: Document -> cost:ActivationCost ':' ModalHeader
ActivationPayment: ActivationCost -> Cost
SingleMode: Modes -> Mode
ModeSequence: Modes -> first:Mode '\n':Bound rest:Modes
AbilityParagraph: Paragraphs -> Ability
HeaderParagraph: Paragraphs -> Header
AbilityParagraphSequence: Paragraphs -> first:Ability '\n':Bound rest:Paragraphs
HeaderParagraphSequence: Paragraphs -> first:Header '\n':Bound rest:Paragraphs

CardTypeModifier: TypeModifier -> Class(CardType) where head.Number = Singular
SupertypeModifier: TypeModifier -> Class(Supertype)
NegativeTypeModifier: TypeModifier -> prefix:Lex(Affix) TypeModifier
IndexedCostHeader: Header -> cost:Cost ':' IndexedNominal where head.Number = Singular
// A keyword with an em-dash ability never premodifies (OSG §14, Keyword
// abilities); one ending in its Cost does so only without it (*a disturb
// cost*).
KeywordPremodifier: BareNominal -> modifier:KeywordPhrase BareNominal
    where modifier.FinalParameter != SetOffAbility | Cost
// Quoted wording mentioned as a term: a keyword or cited-word premodifier
// (*all "bands with other" abilities*, *a "left" pile*), a cited word
// (*choose "left" or "right."*) or a singular nominal (*the "legend rule"*,
// [CR#704.5j]), with no period of its own. A quoted plural is a granted
// ability's (*have "bands with other legendary creatures."*), never a
// term's.
QuotedKeywordPremodifier: BareNominal -> modifier:"KeywordPhrase" BareNominal
    where modifier.FinalParameter != SetOffAbility | Cost
QuotedMentionPremodifier: BareNominal -> modifier:"Mention" BareNominal
QuotedMention: Mention -> "Mention"
QuotedNominal: BareNominal -> "BareNominal" where head.Number = Singular
// A quoted imperative naming a cost (*cost an additional "Sacrifice a land"
// to activate*, Brutal Suppression, Drought; [CR#118.8]): a singular count
// noun under a determiner. Any other quoted clause is a QuotedAbility.
QuotedCost: QuotedCost -> "Clause" where head.VerbForm := Plain
QuotedCostHead: QuotedCostNominal -> QuotedCost
    where $.Number = Singular,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.NounDistribution = Ordinary
QuotedCostPremodifier: QuotedCostNominal -> modifier:AdjectivePhrase QuotedCostNominal
    where modifier.ComplementKind = Intransitive,
          modifier.AdjectivePosition != Predicative
// Twin: Determined. A QuotedCostNominal is no Nominal Conjunct, so a quoted
// ability is never a quoted cost conjoined in a Nominal (*a ... token with
// flying and "Whenever Redwing attacks, surveil 1."*, Falcon, Winged
// Wonder).
DeterminedQuotedCost: NounPhrase -> determiner:DeterminerPhrase QuotedCostNominal
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third,
          determiner.DeterminativeDistribution != Independent | FreeChoice,
          determiner.ComplementKind != PP,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number

TextSymbols: Document -> Symbols
// A symbol sequence as a noun under a determiner (*each {B} in a cost*,
// *six {E}*).
SymbolNominal: BareNominal -> Symbols
    where $.Determination = Overt,
          $.NounKind = Ordinary,
          $.NounDistribution = Ordinary
// An Arabic numeral as a singular count noun under a determiner (*a natural
// 20*).
ArabicNumeralName: NumeralName -> Numeral(Arabic(false))
// A numeral with a comparative adjective it is the standard of (*whenever
// you roll a 4 or higher*), as ComparativeBoundedAmount.
ComparativeBoundedNumeralName: NumeralName ->
    first:Numeral(Arabic(false)) coordinator:Word(Or) last:AdjectivePhrase
    where last.Grade := Comparative,
          last.ComplementKind = Intransitive
NumeralNominal: BareNominal -> NumeralName
    where $.Determination = Overt,
          $.Number = Singular,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.NounDistribution = Ordinary
GroupedNumericAmount: Amount -> Numeral(Arabic(true)) where $.QuantityNumber = head.Number
// A multiplying or bounding adverb on a quantity (*up to twice X target
// cards*).
AdverbModifiedAmount: Amount -> modifier:AdverbPhrase Amount
    where modifier.AdjunctPosition != Central | End | Linking
// A sign is spoken, *plus* or *minus* (*a +1/+1 counter*), so its mark is
// a word to Adjacency Agreement; a range's dash (`RangeHeader`) is not.
UnsignedMeasureAmount: SignedAmount -> Amount where head.Sign != Negative
PositiveMeasureAmount: SignedAmount -> '+':Prefix:Spoken Amount
NegativeMeasureAmount: SignedAmount -> '-':Prefix:Spoken Amount

BoundKeywordItem: KeywordParameters -> BoundKeyword
// A comparative bound on a number is no Noun Phrase: predicated, it
// is the comparative adjective's (*Its power is less than 3*).
NumericNounPhrase: NounPhrase -> Amount
    where head.ComplementKind != PP | Amount,
          $.NounKind = Numeric,
          $.Number = Singular,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// No fused *each*: as a Complement it would let an *of* phrase right after
// it attach to another host, where it is *each*'s partitive oblique
// (*[lands on each] [of your turns]*, Fastbond). The ban is wider than that:
// it also refuses *one of each*, which QuantityPartitiveOfEach builds
// instead, and a fused *each* before a Nominal it could determine (*cast
// [for each] [1 life you gained]*, Licia, Sanguine Tribune).
NonNumericComplement: ComplementNounPhrase -> NounPhrase { transparent: [head] }
    where head.NounKind != Numeric,
          head.Case != Nominative | Genitive,
          !(head.DeterminativeDistribution = Distributive & head.NounKind = Quantity)
NumeralNominalPhrase: FusedNounPhrase -> ChoiceQuantity
    where $.NounKind = Quantity,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
CardinalChoice: ChoiceQuantity -> Numeral(Cardinal)
// *Those* as a fused head (*except those that share a creature type with
// ...*).
FusedDemonstrative: FusedNounPhrase -> Word(Those)
    where $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Number = Plural,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third
FusedQuantifierNominalPhrase: NounPhrase -> Class(FusedQuantifier)
    where $.NounKind = Quantity,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
FusedChoiceNominalPhrase: FusedNounPhrase -> Class(FusedChoice)
    where $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
CardinalDeterminer: NumericalDeterminer -> Numeral(Cardinal) where $.Countability = Count
VariableDeterminer: NumericalDeterminer -> Class(Variable) where $.Countability = Count
ArabicDeterminer: NumericalDeterminer -> Numeral(Arabic(false)) where $.Countability = Count
GroupedArabicDeterminer: NumericalDeterminer -> Numeral(Arabic(true)) where $.Countability = Count
NegativeAdjective: AdjectivePhrase -> prefix:Lex(Affix) AdjectivePhrase where $.Polarity = Negative
LabelledModalHeader: Document -> label:Class(AbilityWord) '—':Free ModalHeader
// A flavor word carries its own dash (*Trick Arrows — Whenever ..., choose
// one —*), as in FlavorLabelledAbility.
FlavorLabelledModalHeader: Document -> label:Lex(FlavorWord) ModalHeader
ChapterModalHeader: Document -> chapters:Chapters '—':Free ModalHeader

CompleteKeywordPhrase: KeywordPhrase -> KeywordParameters
CompleteKeywordItem: KeywordLineItem -> KeywordParameters
BareKeywordMention: KeywordPhrase -> Class(ParameterizedKeyword)
// A granted ability quoted whole, its period inside the closing mark (*has
// "{T}: Add {G}."*; [CR#113.1a]).
QuotedAbility: QuotedAbility -> "Ability"
TextAbility: Document -> Ability
TextTypeLine: Document -> TypeLine
TextHeader: Document -> Header
HeaderSequence: Document -> first:Header '\n':Bound rest:Paragraphs
TextSequence: Document -> first:Ability '\n':Bound rest:Paragraphs
SentenceAbility: Ability -> Sentences
KeywordAbilityList: Ability -> KeywordList
SingleKeyword: KeywordList -> KeywordLineItem
CommaKeywords: KeywordList -> first:KeywordLineItem ',' rest:KeywordList
TypesOnly: TypeLine -> CardTypes
TypesWithSubtypes: TypeLine -> CardTypes '—':Free subtypes:Subtypes
SupertypePrefix: TypeLine -> modifier:Class(Supertype) TypeLine
SingleCardType: CardTypes -> Class(CardType) where head.Number = Singular
MultipleCardTypes: CardTypes -> first:Class(CardType) rest:CardTypes where first.Number = Singular
SingleSubtype: Subtypes -> Class(Subtype) where head.Number = Singular
MultipleSubtypes: Subtypes -> first:Class(Subtype) rest:Subtypes where first.Number = Singular
NumericAmount: Amount -> Numeral(Arabic(false)) where $.QuantityNumber = head.Number
VariableAmount: Amount -> Class(Variable) where $.QuantityNumber = head.Number
SingleSymbol: Symbols -> Class(BracedSymbol)
SymbolSequence: Symbols -> first:Class(BracedSymbol) rest:Attached(Symbols, Suffix)
SymbolCost: Cost -> SymbolCosts
SingleSymbolCost: SymbolCosts -> Symbols
CostSequence: SymbolCosts -> first:Symbols ',' rest:SymbolCosts
NegativeLoyaltySymbolCost: ActivationCost -> '−':Prefix:Spoken amount:Amount
PositiveLoyaltySymbolCost: ActivationCost -> '+':Prefix:Spoken amount:Amount
ZeroLoyaltySymbolCost: ActivationCost -> amount:Amount
LoyaltySymbol: LoyaltySymbol -> '[':Prefix amount:Amount ']'
UnicodeNegativeLoyaltySymbol: LoyaltySymbol -> '[':Prefix '−':Bound:Spoken amount:Amount ']'
PositiveLoyaltySymbol: LoyaltySymbol -> '[':Prefix '+':Bound:Spoken amount:Amount ']'
LoyaltyCost: ActivationCost -> LoyaltySymbol
LoyaltyNominal: BareNominal -> LoyaltySymbol
    where $.Determination = Overt,
          $.Number = Singular,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.NounDistribution = Ordinary
VerbalCost: NonManaCost -> VerbPhrase where head.VerbForm = Plain
CompositeNonManaCost: NonManaCost -> first:Symbols ',' rest:NonManaCost
NonManaCost: Cost -> NonManaCost
ActivatedAbility: Ability -> cost:ActivationCost ':' effect:Effect
LabelledAbility: Ability -> label:Class(AbilityWord) '—':Free Ability
// *• Khans — ...*: an ability under an Anchor Word, after the ability
// offering the choice [CR#607.2m]; the bullet is part of it [CR#614.12c].
// Never a mode: no instruction to choose options precedes it [CR#700.2].
AnchoredAbility: Ability -> '•':Free label:Class(AnchorWord) '—':Free Ability
FlavorLabelledAbility: Ability -> label:Lex(FlavorWord) Ability
NominalMode: Mode -> '•':Free Nominal '.'
NounPhraseMode: Mode -> '•':Free NounPhrase '.'
// A keyword whose em-dash cost ends in its own period, then its instruction
// (*Equip— Sacrifice another nonland permanent. Activate only once each
// turn.*). No other keyword form is followed by a sentence on its line.
KeywordFollowedBySentences: Ability -> first:KeywordLineItem rest:Sentences
    where first.FinalParameter := SetOffCost
NamePremodifier: BareNominal -> modifier:Name BareNominal
ModeBullet: Mode -> '•':Free Ability
PlusCostedMode: Mode -> '+':Free:Spoken cost:Cost '—':Free ModeEffect
LabelledCostedMode: Mode -> '•':Free label:Lex(FlavorWord) cost:Cost '—':Free ModeEffect
PawprintMode: Mode -> quantity:Pawprints '—':Free ModeEffect
SinglePawprint: Pawprints -> Class(Pawprint)
PawprintSequence: Pawprints -> first:Class(Pawprint) rest:Attached(Pawprints, Suffix)
SingleSentence: Sentences -> Sentence
SentenceSequence: Sentences -> first:Sentence rest:Sentences
SentenceEffect: Effect -> Sentences
ModeInstruction: ModeEffect -> Effect
ModeMeasure: ModeEffect -> Measure '.'
// A count noun's singular nominal (*legendary creature*); a mass nominal is
// a Quality through its Noun Phrase.
SingularNominalQuality: Quality -> Nominal
    where head.Number = Singular,
          head.Countability := Count,
          head.NounDistribution != HeadOnly
NominalPhraseQuality: Quality -> NounPhrase
// Only a lexicon-declared Quality head (*protection from multicolored*;
// *protection from snow*, [CR#205.4a]). Never a color word, whose noun
// conversion is the Quality (*protection from red*; one tree, ADR §8).
AdjectivalQuality: Quality -> AdjectivePhrase where head.QualityHead := Fused
NamedParameter: Name -> Lex(Catalog)
NameAsComplement: NameComplement -> Name { cost: 0 }
OtherCardNameComplement: NameComplement -> OtherCardName()
SlashMeasure: Measure -> first:SignedAmount '/':Bound second:SignedAmount
MeasureHeader: Header -> Measure
RangeHeader: Header -> marker:Class(RangeMarker) lower:Amount '-':Bound upper:Amount
OpenRangeHeader: Header -> marker:Class(RangeMarker) lower:Amount '+'
SingleChapter: Chapters -> Numeral(Roman)
ChapterSequence: Chapters -> first:Numeral(Roman) ',' rest:Chapters
ChapterAbility: Ability -> chapters:Chapters '—':Free Ability
// *When this creature enters, choose one —*.
ChoiceHeader: ModalHeader -> Clause '—':Free where head.Inflection != Irrealis
// A modal header as a reflexive trigger [CR#603.12], after the sentence it
// depends on (*You may pay {E}{E}. When you do, choose one —*). Right
// recursion gives one grouping, as SentenceSequence does.
SentencePrefixedModalHeader: ModalHeader -> first:Sentence ModalHeader

// An adverb before a bare imperative is its Clause's front Adjunct, never
// its Verb Phrase's central one (CentralPosition).
Imperative: Clause -> VerbPhrase { uncoordinated: [head] }
    where head.VerbForm = Plain,
          $.ClauseMarking = Unmarked,
          head.CentralPosition != Occupied
Declarative: Sentence -> clause:Clause '.'
    where clause.ClauseMarking = Unmarked,
          clause.Inflection != Irrealis
SubjectRemnant: SubjectRemnant -> VerbPhrase
    where head.VerbForm = Finite,
          head.CentralPosition != Occupied
// Twin: RelativeSubjectPredicate.
SubjectPredicate: Clause -> subject:NounPhrase Free(VerbPhrase) { transparent: [head] }
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          subject.Case != Accusative | Genitive,
          $.ClauseMarking = Unmarked
// *The new creature type can't be Wall*: only a Subject headed by a
// `Variable` noun takes a subtype name as its value, never a Noun Phrase
// after any copular verb.
SpecifyingClause: Clause -> subject:NounPhrase Class(BeVerb) value:Class(Subtype)
    where subject.Variable := Cited,
          value.Number = Singular,
          subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          subject.Case != Accusative | Genitive,
          $.ClauseMarking = Unmarked
SpecifyingModalClause: Clause ->
    subject:NounPhrase Class(StrandableModal) be:Class(BeVerb) value:Class(Subtype)
    where subject.Variable := Cited,
          value.Number = Singular,
          head.VerbForm = Finite,
          be.VerbForm = Plain,
          subject.Number = head.Number,
          subject.Person = head.Person,
          subject.Case != Accusative | Genitive,
          $.ClauseMarking = Unmarked
// A bound auxiliary clitic has a nominative pronoun host (*it's*, *you're*,
// *they've*).
// Twin: RelativeCliticSubjectPredicate.
CliticSubjectPredicate: Clause -> subject:NounPhrase Attached(VerbPhrase, Suffix) {
    transparent: [head],
}
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          subject.Case = Nominative,
          $.ClauseMarking = Unmarked

// *Turning a face-down permanent face up causes ...*.
GerundSubject: Clause -> subject:Gerund VerbPhrase { transparent: [head] }
    where head.VerbForm = Finite,
          head.Number = Singular,
          head.Person = Third,
          $.ClauseMarking = Unmarked

// *A creature you control attacking causes ...* (CGEL 14§2.1:1188).
SubjectGerund: GerundClause -> subject:NounPhrase VerbPhrase { cost: 2 }
    where head.VerbForm = GerundParticiple,
          subject.Case != Nominative | Genitive
GerundClauseSubject: Clause -> subject:GerundClause VerbPhrase { transparent: [head] }
    where head.VerbForm = Finite,
          head.Number = Singular,
          head.Person = Third,
          $.ClauseMarking = Unmarked

// Dummy *there*, *be*, the displaced subject and an optional locative or
// temporal Complement (CGEL 16§6.2.1:1394). A Preposition Phrase right
// after the displaced subject is that Complement, never an Adjunct or the
// subject's postmodifier.
Existential: Clause -> subject:DummyPronoun ExistentialPredicate
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          $.ClauseMarking = Unmarked
ExistentialThere: DummyPronoun -> Lex(Pronoun) where head.PronounKind = Existential
ExistentialBe: ExistentialPredicate -> Class(BeVerb) displaced_subject:DisplacedSubject {
    unextended: [displaced_subject],
}
    where $.Number = displaced_subject.Number,
          displaced_subject.Case != Accusative,
          $.ComplementKind = NP
// The prepositions are *be*'s prepositional frame's.
LocatedExistentialBe: ExistentialPredicate ->
    Class(BeVerb) displaced_subject:DisplacedSubject
    complement:Selected(PrepositionPhrase, In, On, Among, Under, Outside, After) {
    unextended: [displaced_subject],
}
    where $.Number = displaced_subject.Number,
          displaced_subject.Case != Accusative,
          $.ComplementKind = PP
// Existential *be* agrees with its displaced subject as a whole, or by
// proximity with a singular first conjunct of an *and*-coordination (*If
// there is an instant card and a sorcery card in your graveyard*, Flow
// State; CGEL 4§3.2.2:242 n. 21).
WholeDisplacedSubject: DisplacedSubject -> NounPhrase { transparent: [head] }
ProximateDisplacedSubject: DisplacedSubject -> NounPhrase { transparent: [head], unshared: [Number] }
    where $.Number = Singular,
          head.Number = Plural,
          head.FirstConjunctNumber := Singular

EndAdverb: AdverbPhrase -> Class(EndAdverb) where $.AdjunctPosition = End
CentralAdverb: AdverbPhrase -> Class(CentralAdverb) where $.AdjunctPosition = Central
FrontAdverb: AdverbPhrase -> Class(FrontAdverb) where $.AdjunctPosition = Front
LinkingAdverb: AdverbPhrase -> Class(LinkingAdverb) where $.AdjunctPosition = Linking
// *And so on*, alone or with a *for*-phrase (*and so on for double strike,
// deathtouch, ..., and partner*).
IdiomaticCoordinate: IdiomaticCoordinate -> Class(CoordinateAdverb)
IdiomaticCoordinateFor: IdiomaticCoordinate ->
    Class(CoordinateAdverb) adjunct:Selected(PrepositionPhrase, For)
// The linking connective is an Adjunct, never a Coordinator, whether sole
// (*Draw a card, then discard a card*) or after one (*and then discard a
// card*). It may scope over a Coordinator's coordination (*then [shuffle
// and put that card on top]*).
LinkedClause: LinkedClause -> adjunct:AdverbPhrase Clause { transparent: [head] }
    where adjunct.AdjunctPosition = Linking
LinkedVerbPhrase: LinkedVerbPhrase -> adjunct:AdverbPhrase VerbPhrase { transparent: [head] }
    where adjunct.AdjunctPosition = Linking
// *Once each turn, ...*.
FrontAdverbial: Clause -> adjunct:AdverbPhrase ',' Clause { cost: 2, transparent: [head] }
    where adjunct.AdjunctPosition = Front,
          $.FrontPosition = Occupied
// A comma-set passive participial Supplement (*..., followed by an
// additional main phase*; CGEL 14§9.1:1265). It supplements one conjunct,
// never a whole coordination (*X is …, rounded down, and Y is …, rounded
// up*), and like a comma-set post-adjunct it is outside any relative
// clause, so its head Clause passes up no Gap.
ParticipialSupplement: Clause -> Clause ',' supplement:VerbPhrase {
    cost: 3,
    heavy: [supplement],
    uncoordinated: [head],
}
    where supplement.VerbForm = PastParticiple,
          supplement.Voice = Passive
// The same with a gerund-participle (*Restart the game, leaving in exile
// all non-Aura permanent cards exiled with Karn*).
GerundParticipialSupplement: Clause -> Clause ',' supplement:VerbPhrase {
    cost: 3,
    heavy: [supplement],
    uncoordinated: [head],
}
    where supplement.VerbForm = GerundParticiple
// A trailing Noun Phrase Supplement, as for a named token's description;
// its anchor stays a constituent of the Clause, never part of a larger Noun
// Phrase (CGEL 15§5.1:1350–1351).
NounPhraseSupplement: Clause -> Clause ',' supplement:NounPhrase
// *But* or *and* adds a fragment focused by *only* or *not* to the whole
// main Clause, with no comma (*Any player may activate this ability but
// only during their turn*; CGEL 15§4.5:1346–1347). A Clause ending in a
// coordinable Predicate Adjunct takes the fragment as that Adjunct's
// coordinate instead (*Activate [only as a sorcery and only once each
// turn]*).
AddedElement: Sentence ->
    clause:Clause coordinator:Class(AddingCoordinator) fragment:QualifyingFragment '.' {
    cost: 2,
    unadjoined: [
        clause -> [PrepositionPhrase, AdjectivePhrase, TemporalNounPhrase, AdverbPhrase, AdjunctCoordination],
    ],
}
    where clause.ClauseMarking = Unmarked,
          clause.Inflection != Irrealis
// After its coordinator, a coordinate may open with a fronted Adjunct
// delimited on both sides (*except it's legendary ... and, if it's a
// creature, it enters with ...*).
DelimitedFrontConjunct: Clause -> first:Clause coordinator:Class(Coordinator) ',' last:Clause {
    cost: 2,
}
    where last.FrontPosition := Occupied,
          $.VerbForm = first.VerbForm,
          $.VerbForm = last.VerbForm,
          $.ClauseMarking = first.ClauseMarking,
          $.ClauseMarking = last.ClauseMarking,
          $.FrontPosition = first.FrontPosition
QualifyingFragment: QualifyingFragment -> modifier:Class(FocusingAdverb) ClauseFragment { cost: 0 }
AdjunctFragment: ClauseFragment -> PredicateAdjunct { cost: 0 }
ExtendedFragment: ClauseFragment -> ClauseFragment adjunct:PredicateAdjunct
// A temporal Noun Phrase after a final Adverb Phrase is a second Adjunct
// (TemporalAdjunct: *[[activate only once] each turn]*), never also the
// adverb's FrequencyInterval, which it is where no Verb Phrase follows
// (*Once each turn, ...*); the two sites differ in no meaning.
EndAdverbial: VerbPhrase -> VerbPhrase adjunct:AdverbPhrase {
    unadjoined: [adjunct -> [TemporalNounPhrase]],
    transparent: [head],
}
    where adjunct.AdjunctPosition = End
CentralAdverbial: VerbPhrase -> adjunct:AdverbPhrase VerbPhrase { transparent: [head] }
    where adjunct.AdjunctPosition = Central,
          $.CentralPosition = Occupied

// A Gap passes through an auxiliary's Complement.
AuxiliaryParticiple: AuxiliaryComplement -> VerbPhrase { transparent: [head] }
// A finite auxiliary stranded before its Complement's ellipsis site (*If
// you can't, ...*). Only a coordinator, punctuation or the head it is a
// dependent of may follow: a dependent there would be the Complement. Nor
// may one whose lexical head is spelled like a verb in the omitted form
// (*cards that weren't [cast this way]*), while *each opponent who can't
// [discards a card]* keeps its ellipsis.
StrandedModal: VerbPhrase -> Class(StrandableModal) { elliptical: [Plain] }
    where head.VerbForm = Finite,
          $.Voice = Active
StrandedPerfect: VerbPhrase -> Class(StrandableHave) { elliptical: [PastParticiple] }
    where head.VerbForm = Finite,
          $.Voice = Active
StrandedBe: VerbPhrase -> Class(StrandableBe) { elliptical: [GerundParticiple, PastParticiple] }
    where head.VerbForm = Finite,
          $.Voice = Active
Progressive: VerbPhrase -> Class(BeVerb) complement:AuxiliaryComplement {
    transparent: [complement],
}
    where complement.VerbForm = GerundParticiple,
          $.Voice = complement.Voice
// The perfect takes an active participle phrase or a passive one
// headed by *been*.
Perfect: VerbPhrase -> Class(HaveVerb) complement:AuxiliaryComplement { transparent: [complement] }
    where complement.VerbForm = PastParticiple,
          complement.Voice := Active,
          $.Voice = Active
PassivePerfect: VerbPhrase -> Class(HaveVerb) complement:AuxiliaryComplement {
    transparent: [complement],
}
    where complement.VerbForm = PastParticiple,
          complement.Voice = Passive,
          complement.VerbKind := Auxiliary,
          $.Voice = Passive
// The passive auxiliary takes a lexical verb's passive participle phrase.
Passive: VerbPhrase -> Class(BeVerb) complement:AuxiliaryComplement { transparent: [complement] }
    where complement.VerbForm = PastParticiple,
          complement.Voice = Passive,
          complement.VerbKind != Auxiliary,
          $.Voice = Passive

ToInfinitival: Clause -> marker:Word(To) VerbPhrase { transparent: [head] }
    where head.VerbForm = Plain,
          $.ClauseMarking = To
ModifiedInfinitival: Clause -> adjunct:AdverbPhrase Clause { transparent: [head] }
    where adjunct.AdjunctPosition = Phrasal,
          head.ClauseMarking = To
InfinitivalComplement: ToInf -> Clause { transparent: [head] } where head.ClauseMarking = To
BareInfinitival: BareInf -> VerbPhrase { transparent: [head] } where head.VerbForm = Plain
GerundParticipial: Gerund -> VerbPhrase { transparent: [head] }
    where head.VerbForm = GerundParticiple
// *This spell costs {1} to cast* (CGEL 14§6.3(c):1250).
HollowInfinitival: HollowInf -> marker:Word(To) VerbPhrase
    where head.VerbForm = Plain,
          head.Gap = NP
// A purpose adjunct whose object Gap a relative clause binds (*the
// first spell that mana from a Treasure was spent to cast*).
GappedPurpose: VerbPhrase -> VerbPhrase adjunct:ToInf { transparent: [adjunct] }
    where adjunct.Gap = NP
// *Is still on top of your library*, *is no longer snow*, *become no longer
// suspected*.
CentralAdverbAdjunct: CentralAdjunct -> AdverbPhrase { cost: 0 } where head.AdjunctPosition = Central

MeasurePremodifier: BareNominal -> modifier:Measure BareNominal
// *five {P} worth of modes*.
PawprintPremodifier: BareNominal -> modifier:Pawprints BareNominal
// *its {1}{G} kicker*.
SymbolPremodifier: BareNominal -> modifier:Symbols BareNominal
// A slash measure is a noun only under a determiner (*an additional
// +2/+2*); bare, it is a MeasureNounPhrase. A fused first base (*a 3/3*
// [creature]), so never a non-final Conjunct of a Nominal Coordination:
// there it is a Word-Part Coordination's base (*a +2/+0, +1/+1, or +0/+2
// counter*; ADR §8).
MeasureNominal: BareNominal -> Measure
    where $.CompoundPart = Base,
          $.Determination = Overt,
          $.Number = Singular,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.NounDistribution = Ordinary
MeasureNounPhrase: MeasureNounPhrase -> Measure
// A counter's first base is its name [CR#122.1]: a keyword, or a slash
// measure for a +X/+Y counter [CR#122.1a,122.1b].
WordPartCoordination: BareNominal -> CompoundCoordination
KeywordBase: CompoundConjunct -> modifier:KeywordPhrase
    where $.CompoundPart = Base,
          modifier.FinalParameter != SetOffAbility | Cost
MeasureBase: CompoundConjunct -> modifier:Measure where $.CompoundPart = Base
WholeCompound: CompoundConjunct -> Class(SharedHeadCompound) where $.CompoundPart = Whole
// *Gets twice -X/-X*.
AdverbModifiedMeasure: MeasureNounPhrase -> modifier:AdverbPhrase MeasureNounPhrase
    where modifier.AdjunctPosition = Phrasal
AdverbMultipliedMeasure: MeasureNounPhrase -> modifier:AdverbPhrase MeasureNounPhrase
    where modifier.AdjunctPosition = Multiplying
// *Except it's 4/3*, *base power and toughness become 4/2*.
MeasurePredicative: Predicative -> MeasureNounPhrase
// A bare ordinal is attributive (*the second spell*).
OrdinalAdjective: AdjectivePhrase -> Numeral(Ordinal)
    where $.AdjectivePosition = Attributive,
          $.Determination = Overt
// *Third from the top*.
OrdinalFromEnd: PositionPhrase -> Numeral(Ordinal) complement:Selected(PrepositionPhrase, From)
PositionDepictive: VerbPhrase -> VerbPhrase adjunct:PositionPhrase { cost: 2, transparent: [head] }
PositionAdjunct: PredicateAdjunct -> filler:PositionPhrase where $.ComplementKind = AdjP
InterleavedRelative: InterleavedModifier -> RelativeClause { cost: 0 }
InterleavedPreposition: Interleaved -> PrepositionPhrase { cost: 0 }
InterleavedTemporal: Interleaved -> TemporalNounPhrase { cost: 0 }
// A manner Noun Phrase before a passive's Internalised Complement (*weren't
// chosen this way by any player*, Raiding Party). Before any later
// Complement, *this way* would also attach to the higher verb wherever an
// Object ends in a participle or relative clause: an Adjunct of *put*
// before *into your hand* instead of *revealed*'s (*Put all creature cards
// revealed this way into your hand*, Beast Hunt). The gate also refuses
// *deals 3 damage this way to any target*.
InterleavedManner: InternalisedInterleaved -> NounPhrase { cost: 0 } where head.NounKind := Manner
// An end adverb before a later Complement (*divided evenly among*);
// InterleavedSupplement, a comma-set participial one (*deals half X damage,
// rounded down, to any target*).
InterleavedAdverb: Interleaved -> AdverbPhrase { cost: 0 } where head.AdjunctPosition = End
InterleavedSupplement: Interleaved -> ',' supplement:VerbPhrase ',' { cost: 3, heavy: [supplement] }
    where supplement.VerbForm = PastParticiple,
          supplement.Voice = Passive
InterleavedDepictive: Interleaved -> AdjectivePhrase { cost: 0 }
    where head.ComplementKind = Intransitive,
          head.Voice != Passive,
          head.AdjectivePosition != Attributive
// *Onto the battlefield tapped and attacking and the rest on the bottom*.
InterleavedCoordinatedDepictive: Interleaved -> DepictiveCoordination { cost: 0 }
AdjectivalDepictive: Depictive -> filler:AdjectivePhrase
    where filler.Voice != Passive,
          filler.ComplementKind != Amount,
          filler.AdjectivePosition != Attributive,
          $.ComplementKind = AdjP
GerundDepictive: Depictive -> filler:Gerund where $.ComplementKind = Gerund
// *A token that's tapped and attacking*.
CoordinatedPredicative: Predicative -> DepictiveCoordination
CoordinatedDepictive: VerbPhrase -> VerbPhrase adjunct:DepictiveCoordination {
    cost: 2,
    transparent: [head],
}
    where head.VerbKind != Auxiliary
PrepositionalAdjunct: PredicateAdjunct -> filler:Hosted(PrepositionPhrase, Predicate)
    where $.ComplementKind = PP
DepictiveAdjunct: PredicateAdjunct -> filler:AdjectivePhrase
    where filler.Voice != Passive,
          filler.ComplementKind != Amount,
          filler.AdjectivePosition != Attributive,
          $.ComplementKind = AdjP
// A trailing Preposition Phrase Adjunct scopes over every conjunct of a
// Clause coordination (*[untap target creature and gain control of it]
// until end of turn*; CGEL 15§1.3.4:1285–1286). Never the Verb Phrase
// coordination's: the Imperative heads none (ADR §8).
CoordinatedClauseAdjunct: Clause -> Clause adjunct:Hosted(PrepositionPhrase, Predicate) {
    coordinated: [head],
}
// *Flip a coin [that many times] or [until you lose a flip]*.
TemporalNounAdjunct: PredicateAdjunct -> filler:TemporalNounPhrase where $.ComplementKind = NP
AdverbialAdjunct: PredicateAdjunct -> filler:AdverbPhrase
    where filler.AdjunctPosition = End,
          $.ComplementKind = AdvP
CoordinatedAdjunct: VerbPhrase -> VerbPhrase adjunct:AdjunctCoordination {
    cost: 2,
    transparent: [head],
}
DepictiveAdjective: VerbPhrase -> VerbPhrase adjunct:AdjectivePhrase {
    cost: 2,
    transparent: [head],
}
    where adjunct.Voice != Passive,
          adjunct.ComplementKind != Amount,
          adjunct.AdjectivePosition != Attributive

PhrasalAdverb: AdverbPhrase -> Class(PhrasalAdverb) where $.AdjunctPosition = Phrasal
MultiplyingAdverb: AdverbPhrase -> Class(MultiplyingAdverb) where $.AdjunctPosition = Multiplying
BoundingAdverb: AdverbPhrase -> Class(BoundingAdverb) where $.AdjunctPosition = Bounding
DegreeDeterminer: DeterminerPhrase -> modifier:Word(That) Class(DegreeQuantifier)
    where $.ComplementKind = Intransitive
// *As much*, *as many* (CGEL 13§4.3:1130). Degree *as* modifies the
// determinative, never a Noun Phrase.
EquativeDeterminer: DeterminerPhrase -> modifier:Word(DegreeAs) Class(DegreeQuantifier)
    where $.ComplementKind = Intransitive
// A modified degree determinative as a fused head (*that many*, *tied for
// the most*); a coordination fuses only as a FusedQuantity. Count only:
// never *that much*.
FusedDegreeDeterminer: FusedNounPhrase -> DeterminerPhrase { heavy: [head], uncoordinated: [head] }
    where head.ComplementKind = Intransitive,
          head.DeterminativeDistribution = Dependent,
          $.Countability = head.Countability,
          $.Countability = Count,
          $.NounKind = Quantity,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// A spelled cardinal is a Quantity (*one or more*); an Arabic numeral or
// variable is Numeric (*X is 5 or more*).
FusableCardinal: FusableDeterminer -> ChoiceQuantity
    where $.Countability = Count,
          $.NounKind = Quantity
FusableAmount: FusableDeterminer -> Amount
    where $.Number = head.QuantityNumber,
          $.Countability = Count,
          $.NounKind = Numeric
FusableQuantifier: FusableDeterminer -> Class(FusedQuantifier)
FusableChoice: FusableDeterminer -> Class(FusedChoice)
// *Choose one or more*, *if X is 5 or more*.
FusedQuantityCoordination: FusedNounPhrase -> FusedQuantity
    where $.NounKind = Quantity,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// A focusing or multiplying adverb modifies a Noun Phrase (*only one
// target*, *twice X life*); a bounding one, its quantity (*at least one
// creature*). A focusing modifier precedes a determined Noun Phrase
// (*exactly those colors*; CGEL 6§7.3.1:587); numerical determination is
// AdverbModifiedDeterminerPhrase's.
BoundingNounPhrase: NounPhrase -> modifier:AdverbPhrase determiner:DeterminerPhrase Nominal
    where modifier.AdjunctPosition = Bounding,
          determiner.DeterminativeDistribution != Numerical | Independent | FreeChoice,
          determiner.ComplementKind != PP,
          $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
AdverbModifiedNounPhrase: NounPhrase -> modifier:AdverbPhrase NounPhrase
    where modifier.AdjunctPosition = Phrasal
AdverbMultipliedNounPhrase: NounPhrase -> modifier:AdverbPhrase NounPhrase
    where modifier.AdjunctPosition = Multiplying
// *Both* floated after a plural Object (*put two cards from your hand both
// on top of your library or both on the bottom of your library*, Dream
// Cache), where the second *both* is the second Cluster's own Object. A
// Subject has FloatedEach.
FloatedObjectBoth: ComplementNounPhrase -> NounPhrase adjunct:Word(Both) { uncoordinated: [head] }
    where head.Number = Plural,
          head.NounKind != Numeric,
          head.Case != Nominative | Genitive
// *All* after an accusative personal pronoun (*remove them all*; CGEL
// 5§10.1.1:427–428), never a full Noun Phrase.
FloatedObjectAll: ComplementNounPhrase -> NounPhrase adjunct:Word(All) { uncoordinated: [head] }
    where head.Number = Plural,
          head.Case = Accusative
AdverbModifiedPrepositionPhrase: PrepositionPhrase -> modifier:AdverbPhrase PrepositionPhrase
    where modifier.AdjunctPosition = Phrasal
AdverbModifiedDeterminerPhrase: DeterminerPhrase -> modifier:AdverbPhrase DeterminerPhrase
    where modifier.AdjunctPosition = Bounding,
          head.DeterminativeDistribution = Numerical
// *Attack only alone*.
AdverbModifiedAdjectivePhrase: AdjectivePhrase -> modifier:AdverbPhrase AdjectivePhrase
    where modifier.AdjunctPosition = Phrasal,
          $.AdjectivePosition = Predicative
// A phrasal adverb modifies a single adverb, inside any frequency interval
// (*[only once] each turn*).
AdverbModifiedAdverbPhrase: AdverbPhrase -> modifier:AdverbPhrase AdverbPhrase { light: [head] }
    where modifier.AdjunctPosition = Phrasal
PredeterminerCount: NounPhrase -> determiner:Class(Predeterminer) NounPhrase
    where head.Determination = Overt,
          head.Number = Plural,
          determiner.Number = head.Number,
          determiner.Countability = head.Countability
// *All* before a fused cardinal (*if you've done all four*; CGEL 5§12:434).
AllFusedCardinal: NounPhrase -> determiner:Word(All) ChoiceQuantity
    where head.Number = Plural,
          $.Number = Plural,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
SingularQuantifier: DeterminerPhrase -> Word(Any) modifier:Numeral(Cardinal)
    where modifier.Number = Singular,
          $.Number = Singular,
          $.ComplementKind = Intransitive
// A period noun with a deictic or distributive determinative (*this turn*,
// *each combat*), never an article, genitive or postmodifier (CGEL
// 8§6.3:698). SerialTemporal: *time* with any determinative (*three
// times*).
TemporalLocation: TemporalNounPhrase -> determiner:DeterminerPhrase BareNominal
    where head.NounKind = Temporal,
          head.NounDistribution != Serial,
          determiner.DeterminativeDistribution != Dependent | Numerical | IndefiniteArticle,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
SerialTemporal: TemporalNounPhrase -> determiner:DeterminerPhrase BareNominal
    where head.NounDistribution = Serial,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A comparative count of *times*, its *than* Complement after the head
// (*Activate no more times each turn than the number of snow Swamps you
// control*; CGEL 8§9:715).
ComparativeFrequency: TemporalNounPhrase ->
    determiner:Class(ComparativeQuantifier) Nominal complement:Selected(PrepositionPhrase, Than)
    where head.NounDistribution = Serial,
          head.Number = Plural,
          determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
ModifiedComparativeFrequency: TemporalNounPhrase ->
    modifier:Lex(Determinative) determiner:Class(ComparativeQuantifier) Nominal
    complement:Selected(PrepositionPhrase, Than)
    where head.NounDistribution = Serial,
          head.Number = Plural,
          determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *As many times as you choose*.
EquativeFrequency: TemporalNounPhrase ->
    modifier:Word(DegreeAs) determiner:Class(DegreeQuantifier) Nominal
    complement:Selected(PrepositionPhrase, As)
    where complement.ComplementKind = FiniteClause,
          head.NounDistribution = Serial,
          head.Number = Plural,
          determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Pay {G} up to three times*: the Preposition Phrase in Determiner
// function, as in MaximumDetermination.
MaximumSerialTemporal: TemporalNounPhrase -> determiner:Selected(PrepositionPhrase, Up) BareNominal
    where head.NounDistribution = Serial,
          determiner.Determination = Bare,
          determiner.Number = head.Number,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Only any time they could cast a sorcery*.
AdverbModifiedTemporal: TemporalNounPhrase -> modifier:AdverbPhrase TemporalNounPhrase
    where modifier.AdjunctPosition = Phrasal
RelativeTemporalLocation: TemporalNounPhrase -> determiner:DeterminerPhrase RelativeTemporalNominal
    where determiner.Countability = head.Countability,
          determiner.Number = head.Number,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
RelativeTime: RelativeTemporalNominal -> Nominal modifier:RelativeClause
    where head.NounKind = Temporal,
          head.Number = modifier.Number,
          head.NounKind = modifier.NounKind
RelativeTimePostmodifier: RelativeTemporalNominal ->
    RelativeTemporalNominal modifier:TemporalNounPhrase { cost: 2 }
// *This turn, ...*; *The next time ..., ...*.
PreposedTemporalAdjunct: Clause -> adjunct:TemporalNounPhrase ',' Clause { transparent: [head] }
    where $.FrontPosition = Occupied
// A Preposition Phrase and a temporal Noun Phrase under one comma (*For one
// spell this turn, ...*). The Preposition Phrase has a Noun Phrase
// Complement: a Clause Complement keeps the temporal inside it (*When you
// next cast a spell this turn, ...*; [CR#603.1]). A temporal that can
// belong inside the phrase (*At the beginning of each combat this turn,
// ...*) ranks first there ([CR#603.1,603.7]; Attachment Class, ADR §5).
PreposedPrepositionAndTemporal: Clause ->
    adjunct:Hosted(PrepositionPhrase, Predicate) adjunct:TemporalNounPhrase ',' Clause {
    cost: 2,
    transparent: [head],
}
    where adjunct.ComplementKind = NP,
          $.FrontPosition = Occupied
// Two Preposition Phrases under one comma, a delayed trigger's timing and
// duration (*At the beginning of each of your upkeeps for the rest of the
// game, ...*; [CR#603.7]). Both have a Noun Phrase Complement: a Clause
// Complement keeps what follows it inside it (*If tapped for mana, ...*). A
// phrase that can belong inside the first ranks first there (*at the
// beginning of combat on your turn*): the second of two preposed dependents
// violates an Attachment Class (ADR §5).
PreposedPrepositionPair: Clause ->
    adjunct:Hosted(PrepositionPhrase, Predicate) adjunct:Hosted(PrepositionPhrase, Predicate) ','
    Clause { cost: 2, transparent: [head] }
    where adjunct.ComplementKind = NP,
          $.FrontPosition = Occupied
// *The first time each turn*.
TemporalPostmodifier: Nominal -> Nominal modifier:TemporalNounPhrase { cost: 2 }
    where head.NounKind = Temporal
TemporalAdjunct: VerbPhrase -> VerbPhrase adjunct:TemporalNounPhrase {
    cost: 2,
    transparent: [head],
}
MannerAdjunct: VerbPhrase -> VerbPhrase adjunct:NounPhrase { cost: 2, transparent: [head] }
    where adjunct.NounKind := Manner
FrequencyInterval: AdverbPhrase -> AdverbPhrase adjunct:TemporalNounPhrase
    where head.AdjunctPosition != Central | Phrasal | Multiplying | Linking
NumericCountPremodifier: QuantifiedNominal -> modifier:Amount BareNominal
    where $.QuantityNumber = head.Number,
          head.Countability = Count,
          modifier.QuantityNumber = head.Number
NumericMassPremodifier: QuantifiedNominal -> modifier:Amount BareNominal
    where $.QuantityNumber = head.Number,
          head.Countability = Mass,
          head.NounDistribution = DirectMeasure
CardinalCountPremodifier: QuantifiedNominal -> modifier:Numeral(Cardinal) BareNominal
    where $.QuantityNumber = head.Number,
          head.Countability = Count,
          modifier.Number = head.Number
CardinalMassPremodifier: QuantifiedNominal -> modifier:Numeral(Cardinal) BareNominal
    where $.QuantityNumber = head.Number,
          head.Countability = Mass,
          head.NounDistribution = DirectMeasure
ModifiedQuantity: ModifiedQuantifiedNominal -> modifier:AdjectivePhrase QuantifiedNominal
DeterminedQuantity: NounPhrase -> determiner:DeterminerPhrase QuantifiedNominal
    where determiner.Number = head.QuantityNumber,
          $.Number = head.QuantityNumber,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
DistributiveQuantity: NounPhrase -> determiner:DeterminerPhrase QuantifiedNominal
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.DeterminativeDistribution = Distributive,
          $.Number = determiner.Number,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
// A singular determinative over a quantified plural, which *a* selects only
// with *further* or *additional* (*an additional two creatures*; CGEL
// 5§3.4:353). The determiner carries Singular: a number-neutral one (*the*,
// *any*) or a plural one is AgreeingModifiedQuantity's. A distributive one
// is DistributiveModifiedQuantity's, and an admission gate (ADR §6) keeps it
// out: without it *each five counters removed this way* (Sage of Hours) and
// *every five creature types among ...* (Sarek, Federation Ambassador) are
// also a DeterminedModifiedQuantity duplicate of their
// DistributiveModifiedQuantity.
DeterminedModifiedQuantity: NounPhrase -> determiner:DeterminerPhrase ModifiedQuantifiedNominal
    where determiner.Number := Singular,
          determiner.DeterminativeDistribution != Distributive,
          head.QuantityNumber = Plural,
          $.Number = head.QuantityNumber,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
AgreeingModifiedQuantity: NounPhrase -> determiner:DeterminerPhrase ModifiedQuantifiedNominal
    where determiner.Number = head.QuantityNumber,
          determiner.DeterminativeDistribution != Distributive,
          $.Number = head.QuantityNumber,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
DistributiveModifiedQuantity: NounPhrase -> determiner:DeterminerPhrase ModifiedQuantifiedNominal
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.DeterminativeDistribution = Distributive,
          $.Number = determiner.Number,
          determiner.Countability = Count,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
// A Preposition Phrase in Determiner function (*up to two target
// creatures*; CGEL 5§4:357). Its Complement is a bare quantity, never a
// determined Noun Phrase.
MaximumDetermination: NounPhrase -> determiner:Selected(PrepositionPhrase, Up) Nominal
    where determiner.Determination = Bare,
          determiner.Number = head.Number,
          head.Countability = Count,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Up to five {P} worth of modes* [CR#700.2i].
MaximumMeasuredMass: NounPhrase -> determiner:Selected(PrepositionPhrase, Up) Nominal
    where determiner.Countability != Count,
          head.Countability = Mass,
          head.Number = Singular,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// The fused head of its Noun Phrase (*choose up to one*).
FusedMaximum: NounPhrase -> Selected(PrepositionPhrase, Up)
    where head.ComplementKind = PP,
          $.NounKind = Quantity,
          $.Countability = Count,
          $.Case = Plain,
          $.Person = Third
// *Costs {1} less to cast* (CGEL 13§4.4:1125–1126).
MeasuredComparativeHead: NounPhrase -> modifier:NounPhrase Class(ComparativeQuantifier)
    where modifier.Case := Plain,
          modifier.Countability != Count,
          $.NounKind = Ordinary,
          $.Number = Singular,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// A determinative fused head and its *of* oblique (CGEL 5§9.1:411).
// Number is the oblique's, a distributive head's singular its own, and
// *any*'s open (*if any of those cards shares a card type*).
Partitive: PartitiveHead -> Class(PartitiveQuantifier) complement:Selected(PrepositionPhrase, Of) { transparent: [complement] }
    where head.DeterminativeDistribution != Distributive,
          $.Number = complement.Number,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
DistributivePartitive: PartitiveHead ->
    Class(PartitiveQuantifier) complement:Selected(PrepositionPhrase, Of)
    where complement.Number = Plural,
          head.DeterminativeDistribution != Dependent | Independent,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// Plural agreement by synesis (*Each of X target creatures you control
// connive*; CGEL 5§18.2:504).
SynesisDistributivePartitive: PartitiveHead ->
    quantifier:Word(Each) complement:Selected(PrepositionPhrase, Of) { cost: 3 }
    where complement.Number = Plural,
          complement.Case := Plain,
          $.Number = Plural,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Nominative,
          $.Person = Third
// *Any* with a plural oblique leaves the Noun Phrase's Number open.
AnyPartitive: PartitiveHead -> Word(Any) complement:Selected(PrepositionPhrase, Of)
    where complement.Number = Plural,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
AnyMassPartitive: PartitiveHead -> Word(Any) complement:Selected(PrepositionPhrase, Of)
    where complement.Number = Singular,
          $.Number = Singular,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Up to two of them*; QuantityPartitive, *1 of that damage*.
MaximumPartitive: PartitiveHead ->
    Selected(PrepositionPhrase, Up) complement:Selected(PrepositionPhrase, Of)
    where $.NounKind = Quantity,
          $.Case = Plain,
          $.Person = Third
QuantityPartitive: PartitiveHead -> DeterminerPhrase complement:Selected(PrepositionPhrase, Of)
    where head.DeterminativeDistribution = Numerical,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Create one of each* (Academy Manufactor), flat because fused *each* is
// no Complement (NonNumericComplement); fused at once, so no Preposition
// Phrase after it modifies it (*one of each of those kinds of counters* is
// the partitive of a partitive). It is Distributive, which its Numerical
// head is not, only so that DegreeArithmetic refuses it as an operand:
// otherwise *of those kinds of counters* is stranded after *each* in *[that
// many plus one of each] [of those kinds of counters]* (Winding Constrictor).
QuantityPartitiveOfEach: FusedNounPhrase -> DeterminerPhrase preposition:Word(Of) oblique:Word(Each) {
    unshared: [DeterminativeDistribution],
}
    where head.DeterminativeDistribution = Numerical,
          $.DeterminativeDistribution = Distributive,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A determinative with its own Complement heads a partitive, count over
// count and mass over mass: exceptive (*all but one of them*) or
// comparative with a bare standard (*more than one of the same mana
// symbol*). The Noun Phrase has the determiner's Number.
ComplementedPartitive: PartitiveHead -> DeterminerPhrase complement:Selected(PrepositionPhrase, Of)
    where head.ComplementKind = PP,
          head.Countability := Count,
          head.Countability = complement.Countability,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
ComplementedMassPartitive: PartitiveHead ->
    DeterminerPhrase complement:Selected(PrepositionPhrase, Of)
    where head.ComplementKind = PP,
          head.Countability := Mass,
          complement.Countability := Mass,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *That many of those tokens*; a bare degree determinative is a
// PartitiveQuantifier.
DegreePartitive: PartitiveHead -> DeterminerPhrase complement:Selected(PrepositionPhrase, Of) {
    heavy: [head],
}
    where head.ComplementKind = Intransitive,
          head.DeterminativeDistribution = Dependent,
          head.Countability = complement.Countability,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
PostpositiveAdjective: Nominal -> Nominal modifier:AdjectivePhrase { heavy: [modifier] }
    where modifier.ComplementKind = PP,
          modifier.Voice != Passive
// *Creatures able to block it* (CGEL 5§14.2:445).
PostpositiveInfinitivalAdjective: Nominal -> Nominal modifier:AdjectivePhrase { heavy: [modifier] }
    where modifier.ComplementKind = ToInf,
          modifier.AdjectivePosition != Attributive,
          modifier.Voice != Passive
// A number, or a comparative adjective with that number as its standard
// (*power 3 or greater*). Its `Amount` ComplementKind keeps it out of
// depictives: never *[with power] [10 or greater]*.
ComparativeBoundedAlternative: AdjectivePhrase ->
    first:DeterminerPhrase coordinator:Word(Or) last:AdjectivePhrase
    where first.DeterminativeDistribution = Numerical,
          $.Grade = last.Grade,
          $.AdjectivePosition = last.AdjectivePosition,
          $.Voice = last.Voice,
          $.ComplementKind = Amount,
          last.Grade := Comparative,
          last.ComplementKind = Intransitive
// The same as the value of a noun whose frame takes an Amount (*mana value
// X or greater*).
ComparativeBoundedAmount: Amount -> first:Amount coordinator:Word(Or) last:AdjectivePhrase
    where $.QuantityNumber = first.QuantityNumber,
          last.Grade := Comparative,
          last.ComplementKind = Intransitive,
          $.ComplementKind = Amount
// A comparative bound as the endpoint of a scalar change (*reduce it to
// less than 1*; CGEL 8§5.2:691–692).
ComparativeAmount: Amount ->
    quantifier:Class(ComparativeQuantifier) complement:Selected(PrepositionPhrase, Than)
    where quantifier.Countability = Mass,
          complement.NounKind = Numeric,
          $.ComplementKind = PP
// A sum adjective after a determined Noun Phrase (*ten or more creature
// cards total*, Avatar of Woe), as *net* and *gross* follow specific sums
// (*fifty dollars net*; CGEL 5§14.2:445–446).
SumQualifiedNounPhrase: NounPhrase ->
    determiner:DeterminerPhrase Nominal modifier:Class(SumAdjective)
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third,
          determiner.ComplementKind != PP,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
// *For each card fewer than three in their hand*.
PostpositiveComparative: Nominal -> Nominal modifier:DeterminerPhrase { cost: 2, heavy: [modifier] }
    where head.Number = Singular,
          modifier.ComplementKind = PP,
          modifier.Countability = Count,
          modifier.ObliqueKind != AdvP
PostpositiveLocativeAdjective: LocativeHead -> LocativeHead modifier:AdjectivePhrase {
    heavy: [modifier],
}
// *2 greater* (CGEL 13§4.4:1125–1126). `Carry`, since a coordination, whose
// Grade is unshared, would pass a `Require`.
MeasuredComparative: AdjectivePhrase -> modifier:NounPhrase AdjectivePhrase
    where head.Grade := Comparative,
          head.ComplementKind = Intransitive,
          modifier.Determination = Bare,
          modifier.Case := Plain
// The same with a *than* Complement and a numeric measure (*at least 10
// greater than your starting life total*).
MeasuredStandardComparative: AdjectivePhrase -> modifier:NounPhrase AdjectivePhrase
    where head.Grade := Comparative,
          head.ComplementKind = PP,
          modifier.NounKind := Numeric,
          modifier.Case := Plain
// *The most creatures* (CGEL 5§6.1:393).
SuperlativeCountDeterminer: DeterminerPhrase -> marker:Word(The) Class(SuperlativeQuantifier)
    where $.Number = Plural,
          $.Countability = Count,
          $.ComplementKind = Intransitive
SuperlativeMassDeterminer: DeterminerPhrase -> marker:Word(The) Class(SuperlativeQuantifier)
    where $.Number = Singular,
          $.Countability = Mass,
          $.ComplementKind = Intransitive
// The *than* Complement after the head (*more lands than you*, *less life
// than an opponent*; CGEL 13§2.1:1104).
ComparativeCountDetermined: NounPhrase ->
    determiner:Class(ComparativeQuantifier) Nominal complement:Selected(PrepositionPhrase, Than)
    where head.Number = Plural,
          head.Countability = Count,
          determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
ComparativeMassDetermined: NounPhrase ->
    determiner:Class(ComparativeQuantifier) Nominal complement:Selected(PrepositionPhrase, Than)
    where head.Number = Singular,
          head.Countability = Mass,
          determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// The comparative and its *than* Complement as siblings (*more than one*).
// The bare standard gives the phrase its Number (*more than two lands*), so
// the comparative is `quantifier`, not `head`. A determined standard is
// ComparativeCountDetermined's, a bounding frequency ComparativeAdverb's.
ComparativeDeterminer: DeterminerPhrase ->
    quantifier:Class(ComparativeQuantifier) complement:Selected(PrepositionPhrase, Than)
    where complement.Determination = Bare,
          complement.ComplementKind != AdvP,
          $.Number = complement.Number,
          $.Countability = quantifier.Countability,
          $.DeterminativeDistribution = quantifier.DeterminativeDistribution,
          $.ComplementKind = PP,
          $.ObliqueNumber = complement.Number,
          $.ObliqueKind = complement.ComplementKind,
          $.ObliqueDetermination = complement.Determination
// *No more than one*, *many more than two*.
ModifiedComparativeDeterminer: DeterminerPhrase ->
    modifier:Lex(Determinative) quantifier:Class(ComparativeQuantifier)
    complement:Selected(PrepositionPhrase, Than)
    where complement.Determination = Bare,
          complement.ComplementKind != AdvP,
          $.Number = complement.Number,
          $.Countability = quantifier.Countability,
          $.DeterminativeDistribution = quantifier.DeterminativeDistribution,
          $.ComplementKind = PP,
          $.ObliqueNumber = complement.Number,
          $.ObliqueKind = complement.ComplementKind,
          $.ObliqueDetermination = complement.Determination
// *No more scream counters*: no *than* Complement.
DegreeModifiedComparativeDeterminer: DeterminerPhrase ->
    modifier:Word(No) quantifier:Class(ComparativeQuantifier)
    where $.Number = quantifier.Number,
          $.Countability = quantifier.Countability,
          $.DeterminativeDistribution = quantifier.DeterminativeDistribution,
          $.ComplementKind = Intransitive
// *Plus* and *minus* phrases modify a quantity (*2 plus the number of ...*,
// *that many plus one*).
AmountArithmetic: Amount -> Amount modifier:Selected(PrepositionPhrase, Plus, Minus)
    where modifier.ComplementKind = Amount
// *X minus one*.
AmountQuantityArithmetic: Amount -> Amount modifier:Selected(PrepositionPhrase, Plus, Minus)
    where modifier.ComplementKind = NP,
          modifier.Determination = Bare
// *X minus one 2/2 ... tokens*.
ArithmeticDeterminer: NumericalDeterminer ->
    NumericalDeterminer modifier:Selected(PrepositionPhrase, Plus, Minus)
    where modifier.ComplementKind = NP,
          modifier.Determination = Bare,
          modifier.Case != Genitive
// *Three times X cards*.
MultipliedDeterminer: NumericalDeterminer ->
    factor:Numeral(Cardinal) multiplier:BareNominal NumericalDeterminer
    where multiplier.NounDistribution = Serial,
          multiplier.Number = Plural
// *three times this creature's power*.
MultipliedNounPhrase: NounPhrase -> factor:Numeral(Cardinal) multiplier:BareNominal NounPhrase
    where multiplier.NounDistribution = Serial,
          multiplier.Number = Plural,
          head.Determination = Overt
MultipliedAmount: Amount -> factor:Numeral(Cardinal) multiplier:BareNominal Amount
    where multiplier.Number = Plural
NumericArithmetic: NounPhrase -> Amount modifier:Selected(PrepositionPhrase, Plus, Minus)
    where modifier.ComplementKind = NP,
          modifier.Determination = Overt,
          $.NounKind = Ordinary,
          $.Number = Singular,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
NounPhraseArithmetic: NounPhrase -> NounPhrase modifier:Selected(PrepositionPhrase, Plus, Minus)
    where head.NounKind != Numeric,
          head.Case := Plain
// *That many times plus an additional time*.
TemporalArithmetic: TemporalNounPhrase ->
    TemporalNounPhrase modifier:Selected(PrepositionPhrase, Plus, Minus)
    where modifier.NounKind = Temporal
// *Copy that spell once plus an additional time for each opponent*.
FrequencyAdverbArithmetic: AdverbPhrase ->
    AdverbPhrase modifier:Selected(PrepositionPhrase, Plus, Minus)
    where head.AdjunctPosition = End,
          modifier.NounKind = Temporal
// Its operand is never QuantityPartitiveOfEach's *one of each*, which would
// strand the *of* phrase after *each* (*[that many plus one of each] [of
// those kinds of counters]*, Winding Constrictor).
DegreeArithmetic: DeterminerPhrase ->
    DeterminerPhrase modifier:Selected(PrepositionPhrase, Plus, Minus) { heavy: [head] }
    where head.ComplementKind = Intransitive,
          modifier.DeterminativeDistribution != Distributive
// *Half their life*, *double that damage*.
MultiplierPredetermination: NounPhrase -> determiner:DeterminerPhrase NounPhrase
    where determiner.DeterminativeDistribution = Multiplier,
          head.Determination = Overt
AdverbAdverbial: Adverbial -> AdverbPhrase where head.AdjunctPosition = End
FrequencyAdverbial: Adverbial -> TemporalNounPhrase
// *Choose the same mode more than once*: the standard is a bounding
// frequency, so *more* is count (CGEL 13§4.1:1123).
ComparativeAdverb: AdverbPhrase ->
    Class(ComparativeQuantifier) complement:Selected(PrepositionPhrase, Than)
    where complement.ComplementKind = AdvP,
          head.Countability = Count,
          $.AdjunctPosition = End
ModifiedComparativeAdverb: AdverbPhrase ->
    modifier:Lex(Determinative) Class(ComparativeQuantifier)
    complement:Selected(PrepositionPhrase, Than)
    where complement.ComplementKind = AdvP,
          head.Countability = Count,
          $.AdjunctPosition = End
// *Greater power than this creature* (CGEL 5§14.1:443).
ComparativeIndirectComplement: Nominal ->
    modifier:AdjectivePhrase Nominal complement:Selected(PrepositionPhrase, Than)
    where modifier.Grade := Comparative,
          modifier.AdjectivePosition != Predicative,
          modifier.Determination = $.Determination
// The same for a non-scalar governor of inequality (CGEL 13§5.4:1143–1145).
NonScalarIndirectComplement: Nominal ->
    modifier:AdjectivePhrase Nominal complement:Selected(PrepositionPhrase, Than)
    where modifier.Grade := NonScalarInequality,
          modifier.AdjectivePosition != Predicative,
          modifier.Determination = $.Determination
EquativeIndirectComplement: Nominal ->
    modifier:AdjectivePhrase Nominal complement:Selected(PrepositionPhrase, As)
    where modifier.Grade := Equative,
          complement.ComplementKind = NP,
          modifier.Determination = $.Determination
// *Your most recent turn*: a plain adjective heads a superlative phrase.
DegreeModifiedAdjective: AdjectivePhrase -> modifier:Word(Most) AdjectivePhrase {
    unshared: [Grade],
}
    where $.AdjectivePosition = Attributive,
          head.Grade := Plain,
          $.Grade = Superlative
DegreeModifiedAdverb: AdverbPhrase -> modifier:Word(Most) AdverbPhrase
    where head.AdjunctPosition = Central
// *Ignore all but the highest roll* (CGEL 5§11(f):433): count *all*, plural
// whatever the exception's Number. Only a definite standard; a bare
// quantity is ComparativeFusedHead's.
ExceptiveFusedHead: NounPhrase -> quantifier:DeterminerPhrase
    where quantifier.ComplementKind = PP,
          quantifier.ObliqueKind = NP,
          quantifier.ObliqueDetermination = Overt,
          quantifier.ObliqueDistribution := Dependent,
          quantifier.Countability := Count,
          $.Number = quantifier.Number,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *By more than {5}*: a bare standard, whose Number the Noun Phrase takes.
// Scalar *less than* is the adjective's.
ComparativeFusedHead: NounPhrase -> quantifier:DeterminerPhrase
    where quantifier.ComplementKind = PP,
          quantifier.ObliqueKind != AdvP | FiniteClause,
          quantifier.ObliqueDetermination = Bare,
          quantifier.Countability != Mass,
          $.Number = quantifier.ObliqueNumber,
          $.Countability = quantifier.Countability,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Can't be more than the total number of ...* (CGEL 13§4.5(a):1132): a
// standard under a dependent determinative. Never a quantified one (*more
// than two* determines *lands*). Predicative *less than* is the
// adjective's.
ComparativeDeterminedStandard: NounPhrase ->
    quantifier:Class(ComparativeQuantifier) complement:Selected(PrepositionPhrase, Than)
    where complement.ComplementKind = NP,
          complement.Determination = Overt,
          complement.DeterminativeDistribution := Dependent,
          quantifier.Countability != Mass,
          $.Countability = quantifier.Countability,
          $.Number = complement.Number,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *A third of their life*.
FractionPartitive: PartitiveHead ->
    determiner:DeterminerPhrase Numeral(Ordinal) complement:Selected(PrepositionPhrase, Of)
    where $.Number = Singular,
          $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *At least 7 life more than your starting life total*. The measure is
// numerically quantified: in *power less than this creature's power*,
// *power* has a postpositive comparative.
MeasuredComparativeStandard: NounPhrase ->
    modifier:NounPhrase Class(ComparativeQuantifier) complement:Selected(PrepositionPhrase, Than)
    where modifier.Case := Plain,
          modifier.DeterminativeDistribution := Numerical,
          complement.ComplementKind != AdvP,
          $.NounKind = Ordinary,
          $.Number = Singular,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
MeasuredComparativeDetermined: NounPhrase ->
    modifier:DeterminerPhrase determiner:Class(ComparativeQuantifier) Nominal
    complement:Selected(PrepositionPhrase, Than)
    where modifier.DeterminativeDistribution = Numerical,
          head.Number = Plural,
          head.Countability = Count,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// Takes the measure's Number (*one more spell*, *one fewer revival
// counter*).
MeasuredComparativeDeterminer: DeterminerPhrase ->
    modifier:DeterminerPhrase quantifier:Class(ComparativeQuantifier)
    where modifier.DeterminativeDistribution = Numerical,
          $.Number = modifier.Number,
          $.Countability = Count,
          quantifier.Countability = $.Countability,
          $.DeterminativeDistribution = Numerical,
          $.ComplementKind = Intransitive
// *Are each equal to ...*, *power and toughness each equal to ...*.
FloatedEachAdjective: AdjectivePhrase -> adjunct:Word(Each) AdjectivePhrase
    where head.ComplementKind = PP
// *Creature cards each with mana value 3 or less*.
FloatedEachPostmodifier: Nominal ->
    Nominal adjunct:Word(Each) modifier:Hosted(PrepositionPhrase, Nominal) { heavy: [modifier] }
    where head.Number = Plural
// Nominals under one determiner, then a Noun Phrase with its own (*their
// hand, graveyard, and all permanents they own*). The shared nominals are
// singular count, so none is a Noun Phrase alone and no serial Noun Phrase
// coordination brackets the same words.
SharedDeterminerCoordination: NounPhrase ->
    determiner:DeterminerPhrase SharedNominals ',' coordinator:Word(And) last:NounPhrase
    where last.Determination = Overt,
          determiner.DeterminativeDistribution != Independent,
          determiner.ComplementKind != PP,
          $.Number = Plural,
          $.Person = Third,
          $.Case = Plain,
          $.Determination = Overt
SharedNominalPair: SharedNominals -> first:Nominal ',' last:Nominal
    where first.Number = Singular,
          first.Countability = Count,
          last.Number = Singular,
          last.Countability = Count
SharedNominalSequence: SharedNominals -> first:Nominal ',' rest:SharedNominals
    where first.Number = Singular,
          first.Countability = Count
// The same over a Noun Phrase coordination (*up to one target instant card
// and/or up to one target sorcery card from your graveyard each with mana
// value X or less*). An uncoordinated plural one has
// FloatedEachPostmodifier's nominal site, and a singular coordination none
// (never *a creature or a land each with flying*).
FloatedEachCoordinationPostmodifier: NounPhrase ->
    NounPhrase adjunct:Word(Each) modifier:Hosted(PrepositionPhrase, Nominal) {
    heavy: [modifier],
    coordinated: [head],
}
    where head.Number != Singular
// *Any number of target players may each search ...*.
AuxiliaryFloatedEach: VerbPhrase -> adjunct:Class(FloatingQuantifier) VerbPhrase {
    cost: 2,
    transparent: [head],
}
    where head.VerbForm = Plain
// Two front dependents under one comma (*Then if ...*); the adverb is the
// Clause's Adjunct, not the Preposition Phrase's modifier.
PreposedAdverbAndPreposition: Clause ->
    adjunct:AdverbPhrase adjunct:Hosted(PrepositionPhrase, Predicate) ',' Clause {
    cost: 2,
    transparent: [head],
}
    where adjunct.AdjunctPosition = Front,
          $.FrontPosition = Occupied
// *Pay half your life, rounded up:*.
SupplementedVerbalCost: NonManaCost -> VerbPhrase ',' supplement:VerbPhrase {
    cost: 3,
    heavy: [supplement],
}
    where head.VerbForm = Plain,
          supplement.VerbForm = PastParticiple,
          supplement.Voice = Passive
NominalInstruction: Sentence -> IndexedNominal '.'
// *When this Class becomes level 2*.
IndexedNounPhrase: NounPhrase -> IndexedNominal
    where head.Number = Singular,
          $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// The count-noun pro-form *one* (*this one*, *the first one they draw*).
CardinalNominal: BareNominal -> Numeral(Cardinal)
    where $.Determination = Overt,
          $.Number = Singular,
          $.Countability = Count,
          $.NounKind = Ordinary,
          $.NounDistribution = Ordinary
// *for each target beyond the first*.
FusedOrdinalHead: NounPhrase -> determiner:DeterminerPhrase Numeral(Ordinal)
    where determiner.Countability = Count,
          determiner.Number = Singular,
          $.Number = Singular,
          $.Case = Plain,
          $.NounKind = Ordinary,
          $.Countability = Count,
          $.Determination = Overt,
          $.Person = Third
FusedAdjectiveHead: NounPhrase -> determiner:DeterminerPhrase Class(FusedHeadAdjective)
    where $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt,
          $.Countability = Count,
          determiner.Countability = $.Countability,
          $.NounKind = Ordinary
// Anaphoric *the same* (*do the same for ...*; CGEL 17:1545); its head
// stays an adjective.
DefiniteFusedAdjectiveHead: NounPhrase -> determiner:Word(The) Class(DefiniteFusedHeadAdjective)
    where $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt,
          $.Countability = Count,
          $.NounKind = Ordinary
SingleRowHeader: RowHeader -> Amount
OpenRowHeader: RowHeader -> Amount '+'
UnicodeRangeRowHeader: RowHeader -> lower:Amount '—':Bound upper:Amount
TableRow: Ability -> header:RowHeader '|':Free Ability
SequentialVerbalCosts: NonManaCost -> first:VerbPhrase ',' rest:Cost where first.VerbForm = Plain
DeclarativeCost: NonManaCost -> Clause where head.VerbForm = Finite, head.Inflection != Irrealis
ClauseCondition: Condition -> Clause
KeywordInstruction: Sentence -> KeywordLineItem '.' where head.KeywordForm = Parametric
// A floating quantifier after a plural Subject (*they each*) or *you*,
// singular in Oracle but with plural verb forms (*You each lose life*).
// Twin: RelativeFloatedEach.
FloatedEach: Clause -> subject:NounPhrase adjunct:Class(FloatingQuantifier) VerbPhrase {
    transparent: [head],
}
    where !(subject.Number = Singular & subject.Person = Third),
          subject.Case != Accusative,
          subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          $.ClauseMarking = Unmarked
// *They all share a color*: after a personal pronoun Subject only.
// Twin: RelativeFloatedAll.
FloatedAll: Clause -> subject:NounPhrase adjunct:Word(All) VerbPhrase { transparent: [head] }
    where subject.Number = Plural,
          subject.Case = Nominative,
          subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          $.ClauseMarking = Unmarked
NumericalDetermination: DeterminerPhrase -> NumericalDeterminer
    where $.DeterminativeDistribution = Numerical,
          $.ComplementKind = Intransitive
MeasuredMass: NounPhrase -> determiner:DeterminerPhrase Nominal
    where determiner.DeterminativeDistribution = Numerical,
          $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          head.NounDistribution = DirectMeasure,
          head.Countability = Mass,
          head.Number = Singular,
          $.Case = Plain,
          $.Determination = Overt,
          $.Person = Third
// *For each mana spent*.
DistributiveMeasure: NounPhrase -> determiner:DeterminerPhrase Nominal
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.DeterminativeDistribution = Distributive,
          head.NounDistribution = DirectMeasure,
          head.Countability = Mass,
          head.Number = Singular,
          determiner.NounKind = head.NounKind,
          $.Case = Plain,
          $.Person = Third,
          $.Determination = Overt
FusedPhrase: NounPhrase -> FusedNounPhrase { transparent: [head] }
LocativeFusedHead: FusedNounPhrase -> LocativeHead
PartitiveFusedHead: FusedNounPhrase -> PartitiveHead { transparent: [head] }
FusedLocative: LocativeHead -> Word(Anywhere)
    where $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// A cited noun (*choose land or nonland*): bare and singular, since it
// names the word.
WordMention: Mention -> FreeLex(Noun) where head.Inflection = Singular
NegativeMention: Mention -> prefix:Lex(Affix) Mention { light: [head], uncoordinated: [head] }
// A cited noun under an attributive adjective or a cited *non-* word
// (*non-Aura enchantment*), never under a cited noun (*choose target
// creature* is an ordinary Noun Phrase). The head is one word, so a longer
// term is left-branching, one tree.
CompoundMention: Mention -> modifier:MentionModifier Mention {
    light: [head],
    uncoordinated: [head],
}
AdjectiveMentionModifier: MentionModifier -> AdjectivePhrase { light: [head] }
    where head.ComplementKind = Intransitive,
          head.AdjectivePosition != Predicative
NegativeMentionModifier: MentionModifier -> prefix:Lex(Affix) Mention {
    light: [head],
    uncoordinated: [head],
}
// *Four or more nonlands*: one noun, never a compound under the prefix.
PrefixedNoun: BareNominal -> prefix:Lex(Affix) BareNominal { light: [head] }
    where head.Countability := Count
AttributiveNoun: NounPremodifier -> FreeLex(Noun)
    where head.Inflection = Singular,
          head.NounDistribution != HeadOnly
PrefixedNounPremodifier: NounPremodifier -> prefix:Lex(Affix) NounPremodifier
    where $.Polarity = Negative
// *Each differently named dungeon*: only a manner adverb, which a clause
// has in end position, expands an attributive participle (CGEL
// 14§1.1:1175).
AdverbModifiedParticiple: Participle -> modifier:AdverbPhrase Participle { cost: 0 }
    where modifier.AdjunctPosition = End
// *Nonattacking*.
PrefixedParticiple: Participle -> prefix:Lex(Affix) Participle { cost: 0 }
    where $.Polarity = Negative
NounConjunct: NounPremodifierConjunct -> NounPremodifier { cost: 0 }
// A noun premodifier sits inside determinative and adjectival ones,
// never outside them or on a determined symbol (*amount {G}*).
NounAttribute: Attribute -> filler:NounPremodifier
    where $.ComplementKind = Nominal,
          $.Polarity = filler.Polarity
// A gerund-participle as an unlike conjunct of an adjective (*tapped and
// attacking token*).
ParticipialAttribute: Attribute -> filler:Participle
    where filler.Inflection = GerundParticiple,
          $.ComplementKind = Gerund,
          $.Polarity = filler.Polarity
AdjectivalAttribute: Attribute -> filler:AdjectivePhrase
    where filler.ComplementKind = Intransitive,
          filler.AdjectivePosition != Predicative,
          $.ComplementKind = AdjP,
          $.Polarity = filler.Polarity
// Oracle sets off with commas only independent negative modifiers of one
// head, so each premodifier of an asyndetic chain is `Polarity: Negative`
// (OSG §6, Determiners and modifier order). Any other comma is a serial
// coordination's (*a Swamp, Mountain, black permanent, or red permanent*).
// The `Polarity := Negative` carries here and in AttributeSequence and
// FinalAttribute are one admission gate (ADR §6), with no effect apart: they
// keep *Plains* from an asyndetic premodifier before the coordination
// *Island, Swamp, or Mountain* (*a Plains, Island, Swamp, or Mountain card*,
// Farseek).
AsyndeticAttributes: Attributes -> first:Attribute ',' rest:AttributeChain
    where first.Polarity := Negative
AttributeSequence: AttributeChain -> first:Attribute ',' rest:AttributeChain
    where first.Polarity := Negative
FinalAttribute: AttributeChain -> last:Attribute where last.Polarity := Negative
AttributedNominal: BareNominal -> modifier:Attributes BareNominal
NominalPremodifier: BareNominal -> modifier:NounPremodifier BareNominal { transparent: [head] }
    where head.Determination != Overt
QuantifiedNominalPremodifier: QuantifiedNominal -> modifier:NounPremodifier QuantifiedNominal
BarePrepositionalNominal: BareNominalComplement -> PrepositionalNominal
    where head.Number = Singular,
          head.Countability = Count
// A superlative lets the article go unexpressed in a bare nominal
// Complement (*tied for lowest life total*; CGEL 13§6.3.4:1168–1169).
SuperlativeBareNominal: BareNominalComplement -> modifier:AdjectivePhrase BareNominal
    where modifier.Grade := Superlative,
          modifier.ComplementKind = Intransitive,
          modifier.AdjectivePosition != Predicative,
          head.Number = Singular,
          head.Countability = Count
// *Tied for fewest*.
SuperlativeQuantifierFusedHead: BareNominalComplement -> Class(CountSuperlativeQuantifier)
// *Tied for most common*: the superlative fuses with its head (CGEL
// 5§9.3(b):416).
SuperlativeFusedHead: BareNominalComplement -> modifier:AdjectivePhrase
    where modifier.Grade := Superlative,
          modifier.ComplementKind = Intransitive,
          modifier.AdjectivePosition != Predicative
// The frame, not the noun, licenses the missing determiner (*from outside
// the game*, never *if it's [outside the game]*).
FixedFrameBareNoun: FixedFrameNounPhrase -> Nominal
    where head.NounDistribution = FixedFrame,
          head.Number = Singular,
          head.Countability = Count,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// A bare Noun Phrase is never a coordination of Nominals (BarePlural too):
// the Noun Phrases coordinate (*creatures and lands*), Nominals only under
// something shared (*all [creatures and lands]*; ADR §8).
BareMass: NounPhrase -> Nominal { transparent: [head], uncoordinated: [head] }
    where $.Determination = Bare,
          $.Case = Plain,
          head.Countability = Mass,
          head.Number = Singular,
          $.Person = Third
SymbolFusedHead: FusedNounPhrase -> SymbolHead
SymbolNominalPhrase: SymbolHead -> Symbols
    where $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Case = Plain,
          $.Number = Singular,
          $.Person = Third
ProperName: NounPhrase -> Name
    where $.NounKind = Ordinary,
          $.Countability = Count,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// Excluding `FreeChoice` is an admission gate (ADR §6): it keeps *any number
// of Ally cards* (Munda, Ambush Leader) from a second tree with the singular
// head *number* beside TransparentQuantity's.
Determined: NounPhrase -> determiner:DeterminerPhrase Nominal { transparent: [head] }
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third,
          determiner.DeterminativeDistribution != Independent | FreeChoice,
          determiner.ComplementKind != PP,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
// A distributive determiner over an *and*-coordination of singular nominals
// is singular (*each creature and planeswalker you control gets ...*; CGEL
// 5§18.4:508). `nominal`, not `head`, keeps it out of head agreement: the
// Noun Phrase takes Number from its determiner while the coordination is
// plural, and Countability, Determination and NounKind are set here. It
// forgoes the head lexeme in Readings and the head line.
DistributiveCoordinationDetermined: NounPhrase -> determiner:DeterminerPhrase nominal:Nominal {
    transparent: [nominal],
}
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.DeterminativeDistribution = Distributive,
          nominal.ConjunctNumber := Singular,
          nominal.Number = Plural,
          $.Number = determiner.Number,
          determiner.Countability = nominal.Countability,
          $.NounKind = nominal.NounKind,
          $.Countability = nominal.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A singular determiner over an *and*-coordination of singular nominals,
// with joint reference: one entity each conjunct describes (*is also a
// Cleric, Rogue, Warrior, and Wizard*; CGEL 5§18.4:507–508). `nominal`, as
// in DistributiveCoordinationDetermined: the Noun Phrase is singular, the
// coordination plural.
JointCoordinationDetermined: NounPhrase -> determiner:DeterminerPhrase nominal:Nominal {
    transparent: [nominal],
}
    where $.DeterminativeDistribution = determiner.DeterminativeDistribution,
          determiner.Number := Singular,
          determiner.DeterminativeDistribution != Distributive | Independent | FreeChoice,
          determiner.ComplementKind != PP,
          nominal.ConjunctNumber := Singular,
          nominal.Number = Plural,
          $.Number = Singular,
          determiner.Countability = nominal.Countability,
          $.NounKind = nominal.NounKind,
          $.Countability = nominal.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A comparative or exceptive quantity determines a count head agreeing with
// its Complement (*more than one creature*) or a mass head (*less than
// three mana*); a noun both count and mass is no mass head. Only a bare
// standard: *more than the total* determines nothing (CGEL 5§11(d):432).
ComparativeQuantityCountDetermined: NounPhrase -> determiner:DeterminerPhrase Nominal
    where determiner.ComplementKind = PP,
          determiner.ObliqueDetermination = Bare,
          head.Countability = Count,
          determiner.ObliqueNumber = head.Number,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
ComparativeQuantityMassDetermined: NounPhrase -> determiner:DeterminerPhrase Nominal
    where determiner.ComplementKind = PP,
          determiner.ObliqueKind != FiniteClause,
          determiner.ObliqueDetermination = Bare,
          head.Countability := Mass,
          head.Number = Singular,
          determiner.Countability = head.Countability,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// Free-choice *any* determines a quantificational noun only without its
// oblique; with one, TransparentQuantity gives the oblique's Number (*any
// number of target creatures become ...*).
FreeChoiceDetermined: NounPhrase -> determiner:DeterminerPhrase Nominal
    where determiner.DeterminativeDistribution = FreeChoice,
          head.NounDistribution != Quantity,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
FreeChoiceQuantity: NounPhrase -> determiner:DeterminerPhrase Nominal
    where determiner.DeterminativeDistribution = FreeChoice,
          head.NounDistribution = Quantity,
          head.ComplementKind = Intransitive,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
// `quantity`, not `head`, keeps it out of head agreement: Number and
// NounKind are the oblique's (CGEL 5§3.3:349–351). It forgoes the head
// lexeme in Readings and the head line.
TransparentQuantity: NounPhrase -> determiner:DeterminerPhrase quantity:Nominal
    where determiner.DeterminativeDistribution = FreeChoice,
          quantity.NounDistribution = Quantity,
          quantity.ComplementKind = PP,
          quantity.ObliqueNumber = Plural,
          $.Number = quantity.ObliqueNumber,
          $.NounKind = quantity.ObliqueNounKind,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// *Any number of target creatures*: the Targeting Marker alone in the
// oblique takes the oblique's plural, since the quantity, not the Marker,
// counts the targets.
TargetedQuantity: BareNominal -> FreeLex(Noun) complement:TargetedOblique
    where head.NounDistribution = Quantity,
          $.ComplementKind = PP,
          $.ObliqueKind = NP,
          $.ObliqueNumber = complement.Number,
          $.ObliqueNounKind = complement.NounKind
TargetedOblique: TargetedOblique -> Word(Of) complement:TargetedNounPhrase
    where $.Number = complement.Number,
          $.NounKind = complement.NounKind
TargetedNounPhrase: TargetedNounPhrase -> determiner:DeterminerPhrase Nominal
    where determiner.DeterminativeDistribution := Targeting,
          determiner.Number := Singular,
          head.Number = Plural,
          head.Determination = Overt,
          determiner.Countability = head.Countability
// *Pay {1}{G} any number of times*. `quantity`, not `head`, as in
// TransparentQuantity: Number is the oblique's, and the head lexeme and
// head line are forgone.
TemporalQuantity: TemporalNounPhrase -> determiner:DeterminerPhrase quantity:Nominal
    where determiner.DeterminativeDistribution = FreeChoice,
          quantity.ComplementKind = PP,
          quantity.ObliqueNumber = Plural,
          quantity.ObliqueNounKind := Temporal,
          $.Number = quantity.ObliqueNumber,
          $.NounKind = Temporal,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A quantified *number of times*, postmodifiers included (CGEL 8§9:715 n.
// 19).
DeterminedTemporalQuantity: TemporalNounPhrase -> determiner:DeterminerPhrase quantity:Nominal
    where determiner.DeterminativeDistribution != FreeChoice,
          quantity.NounDistribution = Quantity,
          quantity.ComplementKind = PP,
          quantity.ObliqueNumber = Plural,
          quantity.ObliqueNounKind := Temporal,
          determiner.Number = quantity.Number,
          $.Number = quantity.ObliqueNumber,
          $.NounKind = Temporal,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A plural count head, not just the plural of a coordination of singular
// count nominals: a shared determiner belongs outside that coordination and
// cannot be left behind when its tail becomes a Supplement (CGEL
// 5§8.5:409–410; OSG §7, Plurals and agreement). Mass-noun coordinations
// remain bare.
BarePlural: NounPhrase -> Nominal { uncoordinated: [head] }
    where $.Determination = Bare,
          $.Case = Plain,
          head.Number = Plural,
          $.Person = Third,
          !(head.Countability = Count & head.ConjunctNumber = Singular)
Pronoun: NounPhrase -> Lex(Pronoun)
    where $.NounKind = Ordinary,
          $.Determination = Bare,
          head.Case != Genitive,
          head.PronounKind != Existential | Relative,
          head.Inflection = Invariant
IndependentGenitive: NounPhrase -> pronoun:Lex(Pronoun)
    where $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Case = Plain,
          pronoun.Inflection = IndependentGenitive,
          $.Person = Third
PossessiveDeterminer: DeterminerPhrase -> possessor:Lex(Pronoun)
    where $.DeterminativeDistribution = Dependent,
          $.ComplementKind = Intransitive,
          possessor.Case := Genitive,
          possessor.Inflection = Invariant,
          possessor.PronounKind != Relative
GenitivePossessor: NounPhrase -> possessor:Possessor marker:Word(Genitive)
    where $.Determination = Bare,
          $.Case = Genitive,
          possessor.Case := Plain,
          $.Number = possessor.Number,
          $.Person = possessor.Person
// A genitive with its head understood (*power less than Mirko's*; CGEL
// 5§16.3:467–468). A following nominal that can be the head ranks first
// (*during [its controller's next untap step]*).
FusedSubjectDeterminerHead: NounPhrase -> possessor:Possessor marker:Word(Genitive)
    where $.NounKind = Ordinary,
          $.Determination = Overt,
          $.Case = Plain,
          possessor.Case := Plain,
          $.Person = Third
GenitiveDetermined: NounPhrase -> determiner:NounPhrase Nominal
    where $.Determination = Overt,
          $.Case = Plain,
          determiner.Case := Genitive,
          $.Person = Third
// *its controller's next two untap steps*.
GenitiveModifiedQuantity: NounPhrase -> determiner:NounPhrase ModifiedQuantifiedNominal
    where determiner.Case := Genitive,
          $.Number = head.QuantityNumber,
          $.Countability = Count,
          $.Determination = Overt,
          $.Case = Plain,
          $.Person = Third
// A property noun's comparative bound is the postpositive
// comparative adjective's (*mana value less than X*), never its
// Amount Complement.
Unmodified: Nominal -> BareNominal { transparent: [head] }
    where $.ConjunctNumber = $.Number,
          !(head.ComplementKind = Amount & head.ObliqueKind = PP)
// The Targeting Marker alone (*target creature*); ModifiedTargetingMarker,
// after an adjective (*other target creatures*); MarkedDeterminer, under an
// outer determiner (*two target creatures*).
BareTargetingMarker: TargetingMarker -> DeterminerPhrase
    where head.DeterminativeDistribution := Targeting
ModifiedTargetingMarker: DeterminerPhrase -> modifier:AdjectivePhrase TargetingMarker
    where $.ComplementKind = Intransitive,
          modifier.ComplementKind = Intransitive,
          modifier.AdjectivePosition != Predicative
MarkedDeterminer: DeterminerPhrase -> determiner:DeterminerPhrase TargetingMarker
    where determiner.ComplementKind != PP,
          $.Number = determiner.Number
MarkedMaximum: DeterminerPhrase -> determiner:Selected(PrepositionPhrase, Up) TargetingMarker {
    uncoordinated: [determiner],
}
    where determiner.Determination = Bare,
          $.Number = determiner.Number
// An adjective that needs an overt determiner passes the need to its
// nominal (*the first creature*).
Premodifier: BareNominal -> modifier:AdjectivePhrase BareNominal { transparent: [head] }
    where modifier.ComplementKind = Intransitive,
          modifier.Determination = $.Determination,
          modifier.AdjectivePosition != Predicative
// An attributive adjective over a whole *and*-coordination of singular
// nominals, not only its first conjunct (*[total [power and toughness 5 or
// less]]*; CGEL 15§1.3.4:1285–1286). A nominal's Complement is inside its
// premodifiers, so a shared Amount is too.
CoordinationPremodifier: Nominal -> modifier:AdjectivePhrase Nominal
    where modifier.ComplementKind = Intransitive,
          modifier.Determination = $.Determination,
          modifier.AdjectivePosition != Predicative,
          head.Number = Plural,
          head.ConjunctNumber := Singular
DeterminedPossessor: Possessor -> determiner:DeterminerPhrase BareNominal
    where $.Case = Plain,
          $.Person = Third,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
CoordinatedPossessor: Possessor -> determiner:DeterminerPhrase PossessorNominals
    where $.Case = Plain,
          $.Person = Third,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
GenitiveConjunct: GenitiveNominal -> BareNominal marker:Word(Genitive)
MultipleGenitive: NounPhrase -> determiner:DeterminerPhrase GenitiveNominals
    where $.Determination = Bare,
          $.Case = Genitive,
          $.Person = Third,
          determiner.Countability = head.Countability,
          determiner.Number = head.Number
GenitiveDeterminedPossessor: Possessor -> determiner:NounPhrase BareNominal
    where determiner.Case := Genitive,
          $.Case = Plain,
          $.Person = Third
// *up to one target player's life total*.
MaximumPossessor: Possessor -> determiner:Selected(PrepositionPhrase, Up) BareNominal
    where determiner.Determination = Bare,
          determiner.Number = head.Number,
          head.Countability = Count,
          $.Case = Plain,
          $.Person = Third
PluralPossessor: Possessor -> BareNominal
    where $.Case = Plain,
          head.Number = Plural,
          $.Person = Third
ProperPossessor: Possessor -> Name where $.Case = Plain, $.Person = Third
// A postmodifier agrees with each conjunct of an *and*-coordinated nominal
// (*each creature and planeswalker that is tapped*).
NominalPostmodifier: Nominal -> Nominal modifier:Postmodifier
    where head.ConjunctNumber = modifier.Number,
          head.NounKind = modifier.NounKind
// *The next 3 damage that would be dealt*.
QuantifiedPostmodifier: ModifiedQuantifiedNominal -> QuantifiedNominal modifier:Postmodifier
    where head.QuantityNumber = modifier.Number,
          head.NounKind = modifier.NounKind
ModifiedQuantifiedPostmodifier: ModifiedQuantifiedNominal ->
    ModifiedQuantifiedNominal modifier:Postmodifier
    where head.QuantityNumber = modifier.Number,
          head.NounKind = modifier.NounKind
// Only a marked relative follows a fused head (*one that hasn't been
// chosen*).
FusedPostmodifier: FusedNounPhrase -> FusedNounPhrase modifier:RelativeClause
    where modifier.ClauseMarking = Relative,
          head.Number = modifier.Number
// *One of them chosen at random*.
FusedParticipialPostmodifier: FusedNounPhrase -> FusedNounPhrase modifier:VerbPhrase {
    heavy: [modifier],
}
    where modifier.VerbForm = PastParticiple,
          modifier.Voice = Passive,
          modifier.VerbKind != Auxiliary
PrepositionalConjunct: PostmodifierConjunct -> filler:Hosted(PrepositionPhrase, Nominal)
    where $.ComplementKind = PP
NominalObjectConjunct: ObjectConjunct -> filler:ComplementNounPhrase where $.ComplementKind = NP
KeywordObjectConjunct: ObjectConjunct -> filler:KeywordPhrase where $.ComplementKind = KeywordPhrase
// A slash measure is a conjunct only where the head selects a measure, as
// *among* does a +X/+Y counter's kind beside keyword counters' kinds
// [CR#122.1a,122.1b] (*a kind of counter ... from among flying, first
// strike, ..., and +1/+1*).
MeasureObjectConjunct: ObjectConjunct -> filler:MeasureNounPhrase where $.ComplementKind = MeasureNP
// *Has reach and "…"*.
QuotedObjectConjunct: ObjectConjunct -> filler:QuotedAbility where $.ComplementKind = QuotedAbility
AmountConjunct: AmountOrNounConjunct -> filler:Amount where $.ComplementKind = Amount
NounPhraseConjunct: AmountOrNounConjunct -> filler:ComplementNounPhrase where $.ComplementKind = NP
AffirmativeConjunct: ContrastConjunct -> filler:ComplementNounPhrase where $.Polarity = Affirmative
NegatedConjunct: ContrastConjunct -> modifier:Word(Not) filler:ComplementNounPhrase
    where $.Polarity = Negative
ContrastedComplement: ComplementNounPhrase -> filler:ContrastCoordination
AffirmativePrepositionConjunct: ContrastPrepositionConjunct -> PrepositionPhrase
    where $.Polarity = Affirmative
NegatedPrepositionConjunct: ContrastPrepositionConjunct -> modifier:Word(Not) PrepositionPhrase
    where $.Polarity = Negative
ContrastedPrepositionPhrase: PrepositionPhrase -> ContrastPrepositionCoordination
AdjectivalConjunct: PostmodifierConjunct -> filler:AdjectivePhrase { heavy: [filler] }
    where filler.Voice != Passive,
          $.ComplementKind = AdjP
// A lexical passive participle clause, never one headed by *been*.
PastParticipialConjunct: PostmodifierConjunct -> filler:VerbPhrase { heavy: [filler] }
    where filler.VerbForm = PastParticiple,
          filler.Voice = Passive,
          filler.VerbKind != Auxiliary,
          $.ComplementKind = Gerund
GerundParticipialConjunct: PostmodifierConjunct -> filler:VerbPhrase { heavy: [filler] }
    where filler.VerbForm = GerundParticiple,
          $.ComplementKind = Gerund
CoordinatedPostmodifier: Nominal -> Nominal modifier:PostmodifierCoordination
RelativePostmodifier: Postmodifier -> RelativeClause
// A participial clause with dependents (*each creature tapped this way*): a
// bare passive, never headed by *been*.
ParticipialPostmodifier: Postmodifier -> VerbPhrase { heavy: [head] }
    where head.VerbForm = PastParticiple,
          head.Voice = Passive,
          head.VerbKind != Auxiliary
GerundParticipialPostmodifier: Postmodifier -> VerbPhrase { heavy: [head] }
    where head.VerbForm = GerundParticiple
// A single participle, outside the premodifiers and inside any relative
// clause (*creatures entering*). It ranks behind ParticipialPostmodifier,
// and is never one whose Adjectival Passive is a declared Adjective: bare
// *tapped* is that Adjective.
SingleParticipialPostmodifier: Nominal -> BareNominal modifier:VerbPhrase {
    cost: 3,
    light: [modifier],
}
    where $.ConjunctNumber = $.Number,
          modifier.VerbForm = PastParticiple,
          modifier.Voice = Passive,
          modifier.AdjectivalPassive != Lexical,
          modifier.VerbKind != Auxiliary
SingleGerundParticipialPostmodifier: Nominal -> BareNominal modifier:VerbPhrase {
    cost: 3,
    light: [modifier],
}
    where $.ConjunctNumber = $.Number,
          modifier.VerbForm = GerundParticiple
// A bare relative: a finite clause with an object Gap. A marked one may
// also have a subject Gap, which agrees with the antecedent.
BareRelative: RelativeClause -> clause:SubjectInitialClause
    where $.ClauseMarking = Unmarked,
          clause.Gap = NP,
          clause.VerbForm = Finite
// A bare relative whose Gap is a predicative (*the permanent it becomes*;
// CGEL 12§3.3(c):1045).
BarePredicativeRelative: RelativeClause -> clause:SubjectInitialClause { cost: 3 }
    where $.ClauseMarking = Unmarked,
          $.NounKind = Ordinary,
          clause.Gap = Pred,
          clause.VerbForm = Finite
// A bare relative's Clause opens with its Subject, never a preposed adjunct
// (CGEL 12§3.5.5:1055). Twins minus `$.ClauseMarking`; change both:
// RelativeSubjectPredicate / SubjectPredicate,
// RelativeCliticSubjectPredicate / CliticSubjectPredicate,
// RelativeFloatedEach / FloatedEach, RelativeFloatedAll / FloatedAll.
RelativeSubjectPredicate: SubjectInitialClause -> subject:NounPhrase Free(VerbPhrase) {
    transparent: [head],
}
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          subject.Case != Accusative | Genitive
RelativeCliticSubjectPredicate: SubjectInitialClause ->
    subject:NounPhrase Attached(VerbPhrase, Suffix) { transparent: [head] }
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite,
          subject.Case = Nominative
RelativeFloatedEach: SubjectInitialClause ->
    subject:NounPhrase adjunct:Class(FloatingQuantifier) VerbPhrase { transparent: [head] }
    where !(subject.Number = Singular & subject.Person = Third),
          subject.Case != Accusative,
          subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite
RelativeFloatedAll: SubjectInitialClause -> subject:NounPhrase adjunct:Word(All) VerbPhrase {
    transparent: [head],
}
    where subject.Number = Plural,
          subject.Case = Nominative,
          subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite
MarkedRelative: RelativeClause -> marker:Class(RelativeMarker) clause:Clause
    where $.ClauseMarking = Relative,
          clause.Gap = NP,
          clause.VerbForm = Finite,
          marker.Case != Nominative | Genitive
SubjectRelative: RelativeClause -> marker:Class(RelativeMarker) clause:SubjectGapClause
    where $.ClauseMarking = Relative,
          clause.Gap = NP,
          $.Number = clause.Number,
          marker.Number = clause.Number,
          marker.Case != Accusative | Genitive
SubjectGap: SubjectGapClause -> VerbPhrase
    where head.VerbForm = Finite,
          head.Person = Third,
          head.Inflection != Irrealis,
          $.Gap = NP
// The plural Requirement already keeps out irrealis *were*, so this needs
// no Exclude of SubjectGap's.
FloatedEachSubjectGap: SubjectGapClause -> adjunct:Class(FloatingQuantifier) VerbPhrase
    where head.VerbForm = Finite,
          head.Number = Plural,
          head.Person = Third,
          $.Gap = NP
// *whose*: the relative phrase is the Subject or fills an object Gap.
GenitiveRelativePhrase: RelativeNounPhrase -> determiner:Lex(Pronoun) Nominal
    where determiner.PronounKind = Relative,
          determiner.Case := Genitive
GenitiveSubjectRelative: RelativeClause -> marker:RelativeNounPhrase clause:SubjectGapClause
    where $.ClauseMarking = Relative,
          clause.Gap = NP,
          marker.Number = clause.Number
GenitiveRelative: RelativeClause -> marker:RelativeNounPhrase clause:Clause
    where $.ClauseMarking = Relative,
          clause.Gap = NP,
          clause.VerbForm = Finite
GenitivePredicativeRelative: RelativeClause -> marker:RelativeNounPhrase clause:Clause
    where $.ClauseMarking = Relative,
          clause.Gap = Pred,
          clause.VerbForm = Finite
// *For which*.
PrepositionRelativePhrase: RelativePrepositionPhrase -> Lex(Preposition) complement:Lex(Pronoun)
    where complement.PronounKind = Relative,
          complement.Case != Nominative | Genitive
PrepositionalRelative: RelativeClause -> marker:RelativePrepositionPhrase clause:AdjunctGapClause
    where $.ClauseMarking = Relative,
          clause.Gap = Adjunct
// A fused relative is a Noun Phrase (CGEL 12§6:1068).
FusedSubjectRelative: NounPhrase -> Word(Whichever) clause:SubjectGapClause
    where clause.Gap = NP,
          $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
FusedRelative: NounPhrase -> Word(Whichever) clause:Clause
    where clause.Gap = NP,
          clause.VerbForm = Finite,
          $.NounKind = Ordinary,
          $.Determination = Bare,
          $.Case = Plain,
          $.Person = Third
// Its Gap is a temporal Adjunct (*the next time you cast a spell*). It is
// bare, so its Clause opens with its Subject: *the first time [each turn,
// those coins come up heads]* is no adverbial relative.
AdverbialRelative: RelativeClause -> clause:SubjectInitialClause
    where $.ClauseMarking = Unmarked,
          clause.Gap = Adjunct,
          $.NounKind = Temporal
CoordinatedAdverbialRelative: RelativeClause -> clause:SubjectInitialCoordination
    where $.ClauseMarking = Unmarked,
          clause.Gap = Adjunct,
          $.NounKind = Temporal
// Twin: AdjunctGap, over SubjectInitialClause.
RelativeAdjunctGap: SubjectInitialClause -> SubjectInitialClause where $.Gap = Adjunct
// Twin: RelativeAdjunctGap.
AdjunctGap: AdjunctGapClause -> Clause where head.VerbForm = Finite, $.Gap = Adjunct
// A marked relative postposed past a predicate adjunct (*Choose a card at
// random that was exiled with ...*; CGEL 12§4:1066). It ranks behind the
// relative clause in place.
PostposedRelative: VerbPhrase ->
    VerbPhrase object:ComplementNounPhrase adjunct:Hosted(PrepositionPhrase, Predicate)
    modifier:RelativeClause { cost: 5 }
    where head.Gap = NP,
          modifier.ClauseMarking = Relative,
          object.Number = modifier.Number
// A bare relative postposed past *at random* (*choose a creature at random
// this Aura can enchant*, Infectious Rage; Volatile Chimera).
// `adjunct.ComplementKind = AdjP`: an admission gate (ADR §6) against a
// relative postposed onto the Object past any other Preposition Phrase
// (*Draw a card for each Human [you control]*, Mass Appeal).
PostposedBareRelative: VerbPhrase ->
    VerbPhrase object:ComplementNounPhrase adjunct:Hosted(PrepositionPhrase, Predicate)
    modifier:RelativeClause { cost: 2, heavy: [modifier] }
    where head.Gap = NP,
          adjunct.ComplementKind = AdjP,
          modifier.ClauseMarking = Unmarked,
          object.Number = modifier.Number
// *Choose a card at random exiled with ...* (Gorex, the Tombshell; Omenpath
// Journey): a bare passive postposed past *at random*.
// `adjunct.ComplementKind = AdjP`: PostposedBareRelative's gate.
PostposedParticipialModifier: VerbPhrase ->
    VerbPhrase object:ComplementNounPhrase adjunct:Hosted(PrepositionPhrase, Predicate)
    modifier:VerbPhrase { cost: 2, heavy: [modifier] }
    where head.Gap = NP,
          adjunct.ComplementKind = AdjP,
          modifier.VerbForm = PastParticiple,
          modifier.Voice = Passive,
          modifier.VerbKind != Auxiliary
// An equative Adjective Phrase postposed out of its Object (*deals damage
// to any target equal to …*). The Object is in plain case: never a personal
// pronoun. It ranks behind the Adjective Phrase in place.
PostposedAdjective: PostposedModifier -> AdjectivePhrase { cost: 5, heavy: [head] }
    where head.ComplementKind = PP,
          head.Grade := Equative,
          head.Voice != Passive,
          $.Case = Plain

// A Preposition's Clause Complement: finite (*when this creature enters*)
// or verbless (*if able*). `unlinked`: a sole connective never links
// subordinate clauses, so never *until [they exile a nonland card, then you
// may cast it]*.
FiniteComplementClause: FiniteClause -> Clause { unlinked: [head] } where head.VerbForm = Finite
// Content clauses that permit *that*; their governors select this Category
// (CGEL 11§4.8:971).
UnmarkedExpandableClause: ExpandableClause -> FiniteClause
MarkedExpandableClause: ExpandableClause -> marker:Word(ContentMarker) FiniteClause
// A dash-set Clause or Clause coordination giving the content of the Object
// before it: villainous choice options [CR#701.55a]. The sentence end
// absorbs the closing dash.
SetOffComplementClause: SetOffClause -> '—':Free Clause { unclosed }
    where head.ClauseMarking = Unmarked,
          head.Inflection != Irrealis
VerblessComplementClause: VerblessClause -> Predicative
// A passive participle with a dependent of its own is verbal (*if tapped
// for mana*, Reality Twist, Naked Singularity), a bare one the Adjectival
// Passive (*if tapped*): one tree each. A coordination of participles and
// a participle under a central adverb are the Adjective Phrase's alone (*if
// tapped or blocked*, *if not tapped*). A verbless clause has no Adjunct of
// its own: in *attacks each combat if able unless ...*, *unless* belongs to
// the outer clause.
ParticipialVerblessClause: VerblessClause -> VerbPhrase { heavy: [head], uncoordinated: [head] }
    where head.VerbForm = PastParticiple,
          head.Voice = Passive,
          head.VerbKind != Auxiliary,
          head.CentralPosition != Occupied
// *With your hand revealed*: a Subject, never nominative, and a
// past-participial predicate (CGEL 14§8.3:1262).
PastParticipialAbsolute: AbsoluteClause -> subject:ComplementNounPhrase VerbPhrase
    where head.VerbForm = PastParticiple,
          head.Voice = Passive,
          head.VerbKind != Auxiliary

// Content clauses: declarative (*choose that ...*), closed interrogative
// (*whether ...*), or open with an interrogative phrase as Subject (*which
// creatures attack*) or Gap filler (*which number you chose*), or an adverb
// (*how each player votes*).
DeclarativeContentClause: InterrogativeClause -> marker:Word(ContentMarker) clause:Clause
    where clause.VerbForm = Finite
ClosedInterrogative: InterrogativeClause -> marker:Word(Whether) clause:Clause
    where clause.VerbForm = Finite
ClosedInfinitivalInterrogative: InterrogativeClause -> marker:Word(Whether) clause:Clause
    where clause.ClauseMarking = To
InterrogativeDeterminer: InterrogativePhrase -> determiner:Word(Which) Nominal
    where $.Person = Third
// *Note how many cards you've drafted*.
DegreeInterrogativeDeterminer: InterrogativePhrase ->
    degree:Word(How) determiner:Class(DegreeQuantifier) Nominal
    where determiner.Number = head.Number,
          determiner.Countability = head.Countability,
          $.Person = Third
SubjectInterrogative: InterrogativeClause -> subject:InterrogativePhrase VerbPhrase
    where subject.Number = head.Number,
          subject.Person = head.Person,
          head.VerbForm = Finite
GapInterrogative: InterrogativeClause -> marker:InterrogativePhrase clause:Clause
    where clause.Gap = NP,
          clause.VerbForm = Finite
AdverbialInterrogative: InterrogativeClause -> marker:Word(How) clause:AdjunctGapClause
    where clause.Gap = Adjunct

// Never fused *each*: in *power and toughness are each equal to ...* (Eluge,
// the Shoreless Sea) *each* is floated (FloatedEachAdjective), never a
// Predicative *[are each]* with *equal to ...* a depictive. A bare mass
// Noun Phrase is a Predicative, but not one headed by a `HeadOnly` noun,
// whose modifying uses are an adjective's: a bare color word after a copula
// is the adjective (CGEL 19§3.3:1642).
NominalPredicative: Predicative -> NounPhrase
    where head.Case != Genitive,
          !(head.DeterminativeDistribution = Distributive & head.NounKind = Quantity),
          !(head.Determination = Bare & head.Countability = Mass & head.NounDistribution = HeadOnly)
// A predicative Preposition Phrase could also modify a nominal.
PrepositionalPredicative: Predicative -> Hosted(PrepositionPhrase, Nominal)
AdjectivalPredicative: Predicative -> AdjectivePhrase where head.AdjectivePosition != Attributive

// A central Preposition Phrase adjunct (*may instead draw a card*). An
// imperative's front position is the Clause schema's.
adjunct PrepositionPhrase { host: BareInf, side: Before, host_kind: Predicate }
    where adjunct.ComplementKind = Intransitive
// The same in finite and participial Verb Phrases.
adjunct PrepositionPhrase { host: VerbPhrase, side: Before, host_kind: Predicate }
    where adjunct.ComplementKind = Intransitive,
          head.VerbForm != Plain
// A past participle spelled like a declared Adjective (*tapped*) has
// that Adjective as its Adjectival Passive, which premodifies in its
// place.
premodification Participle {
    head: Verb,
    host: BareNominal,
    forms: [GerundParticiple, PastParticiple],
    equations: [PastParticiple -> [head.AdjectivalPassive != Lexical]],
}
parameters IndexedNominal { head: Noun }
parameters KeywordParameters {
    head: Keyword,
    binding: Free,
    coordinators: Coordinator,
    remnant: ParameterRemnant,
}
parameters BoundKeyword { head: Keyword, binding: Suffix }
// `passive`: *by* plus the active's Subject; a *by* gerund is a means
// Adjunct. An amount after *by* is also an extent (*reduced by {2}*): both
// Readings stand, and semantics rejects the agent one (ADR §4). An
// auxiliary has no prepositional or adjectival passive, nor has a verb with
// a declared Adjectival Passive (*tapped*) an adjectival one; an Adjectival
// Passive is predicative. A shifted heavy Object is determined (*chooses
// from among them [an artifact, a creature, …]*).
valence VerbPhrase {
    head: Verb,
    active: [$.Voice = Active],
    passive: By,
    verbal_passive: [$.Voice = Passive, $.VerbForm = PastParticiple],
    prepositional_passive: [
        $.Voice = Passive, $.VerbForm = PastParticiple, head.VerbKind != Auxiliary,
    ],
    internalised: [internalised.ComplementKind = NP],
    adjectival: AdjectivePhrase,
    adjectival_passive: [
        head.VerbForm = PastParticiple, $.AdjectivePosition = Predicative, $.Voice = Passive,
        head.AdjectivalPassive != Lexical, head.VerbKind != Auxiliary,
    ],
    interleaved: Interleaved,
    interleaved_internalised: InternalisedInterleaved,
    central: CentralAdjunct,
    central_heads: BeVerb,
    central_families: [Copular],
    heavy_shift,
    shifted_object: [object.Determination := Overt],
    postposed: PostposedModifier,
    clusters: {
        cluster: ComplementCluster,
        coordination: ClusterCoordination,
        adjunct: PredicateAdjunct,
        remnants: [KeywordPhrase -> ParameterRemnant],
        adjunct_clusters: {
            cluster: AdjunctCluster,
            coordination: AdjunctClusterCoordination,
            preposition: PrepositionPhrase,
            remnant: PrepositionRemnant,
        },
    },
    remnants: [Pred -> PredicativeRemnant],
}
// A Noun Phrase Complement alone is a later Adjunct Cluster's remnant.
// `closed_complement`: an admission gate (ADR §6) against spurious Right
// Node Raising out of a Complement (*less than [void counters on it] or
// equal to the number of [void counters on it]*, Sphere of Annihilation);
// only a stranded preposition's own Gap passes up.
valence PrepositionPhrase {
    head: Preposition,
    complement_kind: ComplementKind,
    closed_complement,
    agree: [
        Number -> Number, Number -> QuantityNumber, Determination -> Determination, Case -> Case,
        NounKind -> NounKind, Countability -> Countability,
        DeterminativeDistribution -> DeterminativeDistribution,
    ],
    remnants: [NP -> PrepositionRemnant],
}
valence BareNominal {
    head: Noun,
    complement_kind: ComplementKind,
    interleaved: InterleavedModifier,
    agree: [ObliqueNumber -> Number, ObliqueKind -> ComplementKind, ObliqueNounKind -> NounKind],
}
// A bare noun in a fossilized Preposition Phrase keeps its Complement (*in
// excess of*): without it, a relational noun is no bare count nominal (*the
// amount of [excess] damage dealt*).
valence PrepositionalNominal { head: Noun, obligatory }
valence AdjectivePhrase { head: Adjective, complement_kind: ComplementKind }
valence DeterminerPhrase {
    head: Determinative,
    complement_kind: ComplementKind,
    agree: [
        ObliqueNumber -> Number, ObliqueKind -> ComplementKind, ObliqueDetermination -> Determination,
        ObliqueDistribution -> DeterminativeDistribution,
    ],
}
// A later conjunct's own negative premodifier (*artifact or non-Aura
// enchantment card*). On the first conjunct it scopes over the whole
// coordination instead (*non-Lesson [instant and sorcery] card*).
adjunct NounPremodifier { host: NounPremodifierConjunct, side: Before, host_kind: Nominal }
    where modifier.Polarity := Negative
// *Knight, Aura, Equipment, or [legendary artifact] card*. As with
// AdjectivalAttribute, an attributive adjective without a post-head
// Complement.
adjunct AdjectivePhrase { host: NounPremodifierConjunct, side: Before, host_kind: Nominal }
    where modifier.ComplementKind = Intransitive,
          modifier.AdjectivePosition != Predicative
// A Preposition Phrase Adjunct costs the same on every host: Right
// Association in the Ranking Key, not a Production Cost, picks the host
// (ADR §5).
adjunct PrepositionPhrase { host: QuantifiedNominal, side: After, host_kind: Nominal }
adjunct PrepositionPhrase { host: LocativeHead, side: After, host_kind: Nominal }
adjunct PrepositionPhrase { host: PartitiveHead, side: After, host_kind: Nominal }
adjunct PrepositionPhrase { host: SymbolHead, side: After, host_kind: Nominal }
adjunct PrepositionPhrase { host: Nominal, side: After, host_kind: Nominal }
adjunct PrepositionPhrase { host: VerbPhrase, side: After, host_kind: Predicate }
adjunct PrepositionPhrase { host: ExistentialPredicate, side: After, host_kind: Predicate }
    where head.ComplementKind != NP
adjunct PrepositionPhrase { host: Clause, side: Before, host_kind: Predicate, delimiter: ',' }
    where $.FrontPosition = Occupied
// A front Adverb Phrase without a comma (*Then draw a card*). Before a
// comma-set front dependent it shares the comma instead (FrontAdverbial,
// PreposedAdverbAndPreposition), never also here.
adjunct AdverbPhrase { host: Clause, side: Before, host_kind: Predicate, cost: 2 }
    where adjunct.AdjunctPosition = Front,
          head.FrontPosition != Occupied
// An intransitive Preposition Phrase preposed without a comma (*If this
// spell was kicked, instead that creature gets ...*; OSG §13, Would and
// instead). Like a comma-fronted dependent it attaches outermost, outside a
// comma-set post-dependent (ADR §8).
adjunct PrepositionPhrase { host: Clause, side: Before, host_kind: Predicate }
    where adjunct.ComplementKind = Intransitive
// A comma-set post-adjunct (*, except it has flying*) or Supplement (*,
// where X is its power*) anchors to a finite Clause, never a Verb Phrase, a
// *to*-infinitival or a relative's Clause (CGEL 15§5.1:1351).
adjunct PrepositionPhrase { host: Clause, side: After, host_kind: Predicate, delimiter: ',' }
    where head.ClauseMarking = Unmarked
adjunct PrepositionPhrase {
    host: Clause,
    side: After,
    host_kind: Supplement,
    delimiter: ',',
    cost: 2,
}
    where head.ClauseMarking = Unmarked
// A comma-set Supplement on a nonfinal Verb Phrase conjunct, where no
// Clause ends to anchor it (*Each player searches their library for up to X
// basic land cards, where X is …, puts them onto the battlefield tapped,
// then shuffles*); after the last conjunct it is the Clause's.
adjunct PrepositionPhrase {
    host: VerbPhrase,
    side: After,
    host_kind: Supplement,
    delimiter: ',',
    cost: 2,
    nonfinal,
}
// A comma-set Supplement to a keyword line's item or an indexed
// instruction, never to a Keyword Phrase in a sentence (ADR §2).
adjunct PrepositionPhrase {
    host: KeywordLineItem,
    side: After,
    host_kind: Supplement,
    delimiter: ',',
    cost: 2,
}
adjunct PrepositionPhrase {
    host: IndexedNominal,
    side: After,
    host_kind: Supplement,
    delimiter: ',',
    cost: 2,
}
// *Starting with you, ...*.
adjunct Gerund { host: Clause, side: Before, host_kind: Predicate, delimiter: ',', cost: 2 }
    where $.FrontPosition = Occupied
// A depictive (*put it onto the battlefield attacking*), of a lexical verb
// only: after an auxiliary it is the progressive's (*the player it is
// attacking*).
adjunct Gerund { host: VerbPhrase, side: After, host_kind: Predicate, cost: 2 }
    where head.VerbKind != Auxiliary
// A purpose *to*-infinitival, unless the head's frame selects one.
adjunct ToInf { host: VerbPhrase, side: After, host_kind: Predicate, cost: 2 }
// Conjuncts share Voice and VerbKind, so a selecting auxiliary sees a value
// (*it has attacked or blocked* is no passive perfect). Only a medial
// conjunct may be a PredicativeRemnant, so Predicatives under one copula
// keep one tree (*is a creature, an artifact, and an enchantment*).
coordination VerbPhrase {
    coordinators: Coordinator,
    unshared: [Inflection, AdjectivalPassive, CentralPosition],
    remnant: PredicativeRemnant,
}
    where $.CentralPosition = first.CentralPosition
// Active with passive (*enters or is put into a graveyard*), Voice and
// VerbKind unvalued. Never past participles, whose Voice selects them
// (*attacked or blocked by this creature*).
coordination VerbPhrase {
    coordinators: Coordinator,
    unshared: [VerbKind, Voice, Inflection, AdjectivalPassive, CentralPosition],
    serial: true,
    unlike: Voice,
}
    where $.CentralPosition = first.CentralPosition,
          first.VerbForm != PastParticiple
// *Blocking or blocked by this creature*.
coordination VerbPhrase {
    coordinators: Coordinator,
    unshared: [Inflection, AdjectivalPassive, VerbForm, CentralPosition],
    proximate: [VerbKind, Voice],
}
    where $.CentralPosition = first.CentralPosition,
          first.VerbForm = GerundParticiple,
          last.VerbForm = PastParticiple,
          $.VerbForm = PastParticiple
// *You control but don't own*.
coordination VerbPhrase {
    coordinators: But,
    unshared: [Inflection, AdjectivalPassive, CentralPosition],
}
    where $.CentralPosition = first.CentralPosition
// A Linked Coordination (*may search ..., put ..., then shuffle*), set off
// by the comma before its connective, which older text omits in a binary
// one; each Conjunct may open with the connective (*loses ..., then
// discards ..., then sacrifices ...*).
coordination VerbPhrase {
    link: LinkedVerbPhrase,
    unshared: [Inflection, AdjectivalPassive, CentralPosition],
    delimiter: ',',
}
    where $.CentralPosition = first.CentralPosition
coordination KeywordPhrase { coordinators: Coordinator, unshared: [KeywordForm, FinalParameter] }
// *"A" and "B"*; *"A," "B," and "C."*
coordination QuotedAbility { coordinators: Coordinator }
// *left or right*; *artifact, creature, or land*.
coordination Mention { coordinators: Coordinator }
// *named Crown of Empires and Scepter of Empires*; *from among Disenchant,
// Braingeyser, ..., and Black Lotus*.
coordination NameComplement { coordinators: Coordinator }
// Only a medial conjunct may be a SubjectRemnant, agreeing with the initial
// Clause's Subject (never *you gain 4 life, draws four cards, ...*); a
// subjectless last conjunct coordinates at the final conjunct's level (CGEL
// 15§3.6:1335–1336).
coordination Clause {
    coordinators: Coordinator,
    unshared: [Inflection, FrontPosition],
    delimiter: ',',
    remnant: SubjectRemnant,
    recovered: [Number, Person],
}
    where $.FrontPosition = first.FrontPosition
// Mixed moods: an imperative, then a declarative (*tap that creature and it
// doesn't untap ...*), either mood between (CGEL 15§3.5:1332–1333). After
// an initial declarative, a subjectless conjunct is a SubjectRemnant, no
// imperative.
coordination Clause {
    coordinators: Coordinator,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition],
    delimiter: ',',
    serial: true,
    unlike: VerbForm,
}
    where $.FrontPosition = first.FrontPosition,
          initial.VerbForm = Plain,
          last.VerbForm = Finite,
          $.VerbForm = Plain
// A declarative, then a comma and an imperative (*it doesn't untap ..., and
// at the beginning of each of your draw steps, put ...*).
coordination Clause {
    coordinators: Coordinator,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition],
    delimiter: ',',
    delimited,
    serial: false,
}
    where $.FrontPosition = first.FrontPosition,
          first.VerbForm = Finite,
          last.VerbForm = Plain,
          $.VerbForm = Plain
// The same with no comma, as older text has it before an imperative opening
// with a fronted dependent, which no Verb Phrase coordinate could hold
// (*that creature can't be regenerated this turn and if it would die this
// turn, exile it instead*).
coordination Clause {
    coordinators: Coordinator,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition],
    serial: false,
}
    where $.FrontPosition = first.FrontPosition,
          first.VerbForm = Finite,
          last.VerbForm = Plain,
          last.FrontPosition := Occupied,
          $.VerbForm = Plain
// *But*, binary, of like or mixed moods (*Discard it, but you may put it on
// top of your library*).
coordination Clause {
    coordinators: But,
    unshared: [Number, Person, Inflection, FrontPosition],
    delimiter: ',',
    serial: false,
}
    where $.FrontPosition = first.FrontPosition
coordination Clause {
    coordinators: But,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition],
    delimiter: ',',
    serial: false,
    unlike: VerbForm,
}
    where $.FrontPosition = first.FrontPosition,
          first.VerbForm = Plain,
          last.VerbForm = Finite,
          $.VerbForm = Plain
coordination Clause {
    coordinators: But,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition],
    delimiter: ',',
    serial: false,
    unlike: VerbForm,
}
    where $.FrontPosition = first.FrontPosition,
          first.VerbForm = Finite,
          last.VerbForm = Plain,
          $.VerbForm = Plain
// Linked Coordinations of like or mixed moods (*Tap it, then you may
// sacrifice an artifact*). A stranded auxiliary never precedes a comma-less
// link whose verb could be its Complement (StrandedModal).
coordination Clause {
    link: LinkedClause,
    unshared: [Number, Person, Inflection, FrontPosition],
    delimiter: ',',
}
    where $.FrontPosition = first.FrontPosition
// *Reveal cards ... until ..., Kaboom! deals damage ..., then you put the
// revealed cards ...*.
coordination Clause {
    link: LinkedClause,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition],
    delimiter: ',',
    serial: true,
    unlike: VerbForm,
}
    where $.FrontPosition = first.FrontPosition,
          initial.VerbForm = Plain,
          last.VerbForm = Finite,
          $.VerbForm = Plain
coordination Clause {
    link: LinkedClause,
    unshared: [Number, Person, Inflection, VerbForm, FrontPosition],
    delimiter: ',',
    delimited,
    serial: false,
}
    where $.FrontPosition = first.FrontPosition,
          first.VerbForm = Finite,
          last.VerbForm = Plain,
          $.VerbForm = Plain
// The last conjunct gives Case and Countability (*them and all other
// creatures*), and the coordination is determined only if it is, so *all
// artifacts and enchantments* has no predeterminer over coordinated bare
// Noun Phrases. After a determined Noun Phrase a bare mass one is no
// conjunct: the determiner scopes over both (*its power and toughness*).
// *And* is plural, singular between distributive ones; *or* has its
// conjuncts' Number.
coordination NounPhrase {
    coordinators: And,
    unshared: [Number, Person, DeterminativeDistribution, FirstConjunctNumber],
    proximate: [Case, NounKind, Countability, NounDistribution],
    resolve: [Determination -> Bare],
}
    where !(first.Determination = Overt & last.Determination = Bare & last.Countability = Mass),
          $.Number = Plural,
          $.Person = Third,
          $.FirstConjunctNumber = first.Number,
          first.NounKind != Quantity,
          first.DeterminativeDistribution != Distributive
coordination NounPhrase {
    coordinators: And,
    unshared: [Number, Person, FirstConjunctNumber],
    proximate: [Case, NounKind, Countability, NounDistribution],
    resolve: [Determination -> Bare],
}
    where $.Number = Singular,
          $.Person = Third,
          first.DeterminativeDistribution := Distributive,
          last.DeterminativeDistribution := Distributive
// *And/or*: plural with a plural last conjunct, either Number with a
// singular one (*you and/or at least one permanent you control becomes*).
coordination NounPhrase {
    coordinators: AndOr,
    unshared: [Number, DeterminativeDistribution, FirstConjunctNumber],
    proximate: [Person, Case, NounKind, Countability, NounDistribution],
    resolve: [Determination -> Bare],
}
    where !(first.Determination = Overt & last.Determination = Bare & last.Countability = Mass),
          last.Number = Plural,
          $.Number = Plural
coordination NounPhrase {
    coordinators: AndOr,
    unshared: [Number, DeterminativeDistribution, FirstConjunctNumber],
    proximate: [Person, Case, NounKind, Countability, NounDistribution],
    resolve: [Determination -> Bare],
}
    where !(first.Determination = Overt & last.Determination = Bare & last.Countability = Mass),
          last.Number = Singular
// An admission gate (ADR §6): a Numeric Noun Phrase is no first conjunct,
// which keeps *lost [3] or [more life]* from a Noun Phrase coordination
// (Davros, Dalek Creator); numbers alone are an Amount coordination.
// `raising_delimiter`: commas may set off the final coordinate of Right
// Node Raising (*some amount of, or all of, the mana*, Illusionary Mask).
coordination NounPhrase {
    coordinators: Alternative,
    raising_delimiter: ',',
    unshared: [DeterminativeDistribution, FirstConjunctNumber],
    proximate: [Number, Person, Case, NounKind, Countability, NounDistribution],
    resolve: [Determination -> Bare],
}
    where !(first.Determination = Overt & last.Determination = Bare & last.Countability = Mass),
          first.NounKind != Numeric | Quantity,
          last.NounKind != Quantity
coordination Nominal {
    coordinators: And,
    unshared: [ObliqueNumber, ObliqueNounKind, ConjunctNumber, CompoundPart],
    proximate: [NounDistribution],
}
    where first.CompoundPart != Base,
          $.Number = Plural,
          $.ConjunctNumber = first.Number
coordination Nominal {
    coordinators: Disjunctive,
    unshared: [ObliqueNumber, ObliqueNounKind, ConjunctNumber, CompoundPart],
    proximate: [NounDistribution],
}
    where first.CompoundPart != Base,
          $.ConjunctNumber = $.Number
coordination GenitiveNominals {
    coordinators: Coordinator,
    proximate: [Number, Countability, NounKind],
    conjunct: GenitiveNominal,
}
coordination PossessorNominals {
    coordinators: Coordinator,
    proximate: [Number, Countability, NounKind],
    conjunct: BareNominal,
}
// Each conjunct with its relative word (*tokens that are copies of it and
// that are tapped and attacking*).
coordination RelativeClause { coordinators: Coordinator } where last.ClauseMarking = Relative
coordination RelativeClause { coordinators: But }
// *Any time [you could mulligan and this card is in your hand]*. Its own
// Category, so RelativeAdjunctGap states the Gap once per conjunct and
// never over the coordination (ADR §8).
coordination SubjectInitialCoordination {
    coordinators: Coordinator,
    unshared: [Inflection],
    conjunct: SubjectInitialClause,
}
// *Which creatures block and how those creatures block*.
coordination InterrogativeClause { coordinators: Coordinator }
coordination NounPremodifier {
    coordinators: Coordinator,
    unshared: [Polarity],
    conjunct: NounPremodifierConjunct,
}
coordination CompoundCoordination {
    coordinators: Coordinator,
    unshared: [CompoundPart],
    proximate: [Number, Countability, NounKind, NounDistribution],
    conjunct: CompoundConjunct,
}
    where first.CompoundPart = Base,
          last.CompoundPart = Whole
coordination Participle { coordinators: Coordinator, unshared: [Inflection, Polarity] }
// This coordination leaves Grade unvalued, so a gate that needs a Grade
// writes `:=` (*red or green* is no comparative). A coordination whose last
// coordinate is comparative is the next schema's alone: one tree per
// analysis.
coordination AdjectivePhrase { coordinators: Coordinator, unshared: [Grade, Polarity] }
    where last.Grade != Comparative
// Oracle prints a comparative coordinated with a non-comparative before a
// *than* Complement only the last coordinate licenses (*equal or lesser mana
// value than that spell*, Saruman of Many Colors), which CGEL marks ?
// (CGEL 15§4.4:1343 n. 66).
coordination AdjectivePhrase { coordinators: Coordinator, unshared: [Grade, Polarity] }
    where last.Grade := Comparative,
          $.Grade = Comparative
coordination PrepositionPhrase {
    coordinators: Coordinator,
    unshared: [DeterminativeDistribution],
    proximate: [ComplementKind, Number, Determination, Case, NounKind, Countability],
}
coordination AdverbPhrase { coordinators: Coordinator }
coordination DepictiveCoordination {
    coordinators: Coordinator,
    unshared: [ComplementKind],
    conjunct: Depictive,
    unlike: ComplementKind,
}
// *Attacking, blocking, or tapped creature*; *the basic, Sphere, and Locus
// lands*.
coordination Attributes {
    coordinators: Coordinator,
    unshared: [ComplementKind],
    serial: true,
    conjunct: Attribute,
    unlike: ComplementKind,
}
coordination PostmodifierCoordination {
    coordinators: Coordinator,
    unshared: [ComplementKind],
    conjunct: PostmodifierConjunct,
    unlike: ComplementKind,
}
// Its conjuncts' kinds are those the selecting head takes (slot
// `UnlikeObject`).
coordination ObjectCoordination {
    coordinators: And,
    unshared: [ComplementKind],
    serial: true,
    conjunct: ObjectConjunct,
    unlike: ComplementKind,
}
// A comma may set off a binary coordination's second Cluster (*deals half X
// damage, rounded down, to any target, and half X damage, rounded up, to
// you*).
coordination ClusterCoordination {
    coordinators: Coordinator,
    delimiter: ',',
    conjunct: ComplementCluster,
}
// `parallel`: every Cluster has the initial one's prepositions, the first
// overt or elided.
coordination AdjunctClusterCoordination {
    coordinators: Coordinator,
    delimiter: ',',
    conjunct: AdjunctCluster,
    parallel,
}
coordination ContrastCoordination {
    coordinators: But,
    unshared: [Polarity],
    delimiter: ',',
    serial: false,
    conjunct: ContrastConjunct,
}
    where first.Polarity = Affirmative,
          last.Polarity = Negative
coordination ContrastPrepositionCoordination {
    coordinators: But,
    unshared: [Polarity, DeterminativeDistribution],
    proximate: [ComplementKind, Number, Determination, Case, NounKind, Countability],
    delimiter: ',',
    serial: false,
    conjunct: ContrastPrepositionConjunct,
}
    where first.Polarity = Affirmative,
          last.Polarity = Negative
// *Only during the declare blockers step, only if ..., and only once each
// turn*.
coordination AdjunctCoordination {
    coordinators: Coordinator,
    unshared: [ComplementKind],
    serial: true,
    conjunct: PredicateAdjunct,
    unlike: ComplementKind,
}
coordination AmountOrNounPhrase {
    coordinators: Coordinator,
    unshared: [ComplementKind],
    conjunct: AmountOrNounConjunct,
    unlike: ComplementKind,
}
coordination MeasureNounPhrase { coordinators: Coordinator }
coordination Amount { coordinators: Coordinator, proximate: [QuantityNumber, Sign] }
coordination SymbolCosts { coordinators: Coordinator }
// It determines as its last conjunct does (*one or more cards*).
coordination DeterminerPhrase {
    coordinators: Coordinator,
    proximate: [Number, Countability, DeterminativeDistribution, NounKind],
}
// Numbers alone are an Amount coordination (*X is 2 or 3*), never also
// a fused quantity over them (ADR §8).
coordination FusedQuantity {
    coordinators: Disjunctive,
    proximate: [Number, Countability, NounKind],
    conjunct: FusableDeterminer,
}
    where !(first.NounKind = Numeric & last.NounKind = Numeric)

correlative Both = And
correlative Either = Or
correlative Neither = Nor

// *And so on* ends a coordination of any Category.
idiomatic_coordinate And = IdiomaticCoordinate
